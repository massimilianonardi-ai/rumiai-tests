#!/bin/sh

LAUNCHER_STATUS_ERROR=3
LAUNCHER_HOLD_ON_EXIT=0

say() {
    printf '%s\n' "$*"
}

say_error() {
    printf 'rumiai-validate: %s\n' "$*" >&2
}

fatal() {
    say_error "$*"
    exit "$LAUNCHER_STATUS_ERROR"
}

launcher_detect_hold_on_exit() {
    LAUNCHER_HOLD_ON_EXIT=0

    [ -t 0 ] && [ -t 1 ] || return 0

    command -v uname >/dev/null 2>&1 || return 0
    [ "$(uname -s 2>/dev/null)" = Linux ] || return 0

    command -v ps >/dev/null 2>&1 || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }

    parent_pid_value=$(ps -o ppid= -p "$$" 2>/dev/null) || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    set -- $parent_pid_value
    [ "$#" -eq 1 ] || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    parent_pid=$1

    parent_command_value=$(ps -o comm= -p "$parent_pid" 2>/dev/null) || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    set -- $parent_command_value
    [ "$#" -eq 1 ] || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    parent_command=$1

    shell_path=${SHELL-}
    shell_name=${shell_path##*/}
    [ -n "$shell_name" ] && [ "$parent_command" = "$shell_name" ] || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }

    parent_pgid_value=$(ps -o pgid= -p "$parent_pid" 2>/dev/null) || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    set -- $parent_pgid_value
    [ "$#" -eq 1 ] || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    parent_pgid=$1

    self_pgid_value=$(ps -o pgid= -p "$$" 2>/dev/null) || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    set -- $self_pgid_value
    [ "$#" -eq 1 ] || {
        LAUNCHER_HOLD_ON_EXIT=1
        return 0
    }
    self_pgid=$1

    [ "$parent_pgid" != "$self_pgid" ] || LAUNCHER_HOLD_ON_EXIT=1
}

launcher_finish() {
    status=$1
    trap - 0

    if [ "$LAUNCHER_HOLD_ON_EXIT" -eq 1 ]; then
        printf '\nPress Enter to close...'
        IFS= read -r _ || :
        printf '\n'
    fi

    exit "$status"
}

resolve_self() {
    self=$0
    case $self in
        */*) : ;;
        *)
            self=$(command -v "$self" 2>/dev/null) || return 1
            ;;
    esac

    if command -v realpath >/dev/null 2>&1; then
        realpath "$self" 2>/dev/null
        return $?
    fi

    case $self in
        */*) self_dir=${self%/*}; self_base=${self##*/} ;;
        *) self_dir=.; self_base=$self ;;
    esac
    [ -n "$self_dir" ] || self_dir=/
    self_dir=$(CDPATH= cd "$self_dir" 2>/dev/null && pwd -P) || return 1
    printf '%s/%s\n' "$self_dir" "$self_base"
}

canonical_dir() {
    path=$1
    if command -v realpath >/dev/null 2>&1; then
        resolved=$(realpath "$path" 2>/dev/null) || return 1
        [ -d "$resolved" ] || return 1
        printf '%s\n' "$resolved"
        return 0
    fi
    (CDPATH= cd "$path" 2>/dev/null && pwd -P)
}

repo_require_no_tracked_changes() {
    repo_dir=$1
    label=$2
    status=$(git -C "$repo_dir" status --porcelain --untracked-files=no 2>/dev/null) ||
        fatal "cannot inspect $label tracked working tree"
    if [ -n "$status" ]; then
        say_error "$label has tracked working-tree changes; refusing automatic pull"
        printf '%s\n' "$status" >&2
        exit "$LAUNCHER_STATUS_ERROR"
    fi
}

main() {
    [ "$#" -eq 0 ] || fatal 'this launcher does not accept arguments; edit rumiai-validate.conf instead'
    command -v git >/dev/null 2>&1 || fatal 'git is required'

    self_path=$(resolve_self) || fatal 'cannot resolve launcher pathname'
    suite_root=${self_path%/*}
    [ -n "$suite_root" ] || suite_root=/
    suite_root=$(canonical_dir "$suite_root") || fatal 'cannot resolve rumiai-tests root'

    git_top=$(git -C "$suite_root" rev-parse --show-toplevel 2>/dev/null) ||
        fatal 'launcher must be inside a rumiai-tests Git working tree'
    git_top=$(canonical_dir "$git_top") || fatal 'cannot canonicalize rumiai-tests Git root'
    [ "$git_top" = "$suite_root" ] || fatal 'launcher must be located in the rumiai-tests repository root'

    cd "$suite_root" || fatal 'cannot enter rumiai-tests repository root'

    repo_require_no_tracked_changes "$suite_root" 'rumiai-tests'
    suite_head_before=$(git rev-parse HEAD 2>/dev/null) || fatal 'cannot read rumiai-tests HEAD'

    say 'Updating rumiai-tests...'
    git pull --ff-only || fatal 'cannot update rumiai-tests with fast-forward only'

    suite_head_after=$(git rev-parse HEAD 2>/dev/null) || fatal 'cannot read updated rumiai-tests HEAD'
    if [ "$suite_head_before" != "$suite_head_after" ]; then
        say 'rumiai-tests updated; restarting current launcher...'
        exec "$suite_root/rumiai-validate"
        fatal 'cannot restart updated launcher'
    fi

    implementation=$suite_root/lib/sh/rumiai-validate.lib.sh
    [ -r "$implementation" ] || fatal "validation launcher implementation not found: $implementation"
    . "$implementation"

    rumiai_validate_run
}

launcher_detect_hold_on_exit
trap 'launcher_finish "$?"' 0
main "$@"
