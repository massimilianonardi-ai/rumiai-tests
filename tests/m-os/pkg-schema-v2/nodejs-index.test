#!/bin/sh
test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 3
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || exit 3
. "$suite_root/lib/m-os-target.lib" || exit 3
target=$(rumiai_test_target_m_os_find)
target_status=$?
case "$target_status" in
  0) : ;;
  1)
    if [ -n "${RUMIAI_TEST_M_OS_ROOT-}" ]
    then
      printf '%s: ERROR: configured target unavailable\n' m-os/pkg-schema-v2/nodejs-index.test >&2
      exit 3
    fi
    exit 2
    ;;
  *)
    printf '%s: ERROR: invalid configured target (%s)\n' m-os/pkg-schema-v2/nodejs-index.test "$target_status" >&2
    exit 3
    ;;
esac
command -p -- sh -n "$target/lib/sys/sh/pkg/repository/pkg-repository-nodejs.lib.sh" || exit 1
if [ "${RUMIAI_TEST_M_OS_CHILD-}" != 1 ]; then
  RUMIAI_TEST_M_OS_CHILD=1
  export RUMIAI_TEST_M_OS_CHILD
  if "$target/m" sh "$0"
  then
    exit 0
  else
    child_status=$?
    case "$child_status" in
      1) exit 1 ;;
      *) printf 'nodejs-index.test: ERROR: target bootstrap/test status %s\n' "$child_status" >&2; exit 3 ;;
    esac
  fi
fi
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 3
loadsyslib "pkg/repository/pkg-repository-nodejs" || exit 3
records='s:v27.invalid
s:v26.13.0-rc.1
s:v26.12.1
s:v25.9.0
s:v26.11.9'
actual=$(_pkg_repository_nodejs_filter_versions 26 "$records") || exit 1
expected='v26.12.1
v26.11.9'
[ "$actual" = "$expected" ] || exit 1
if _pkg_repository_nodejs_filter_versions 26 's:v26.invalid' >/dev/null 2>&1; then
  exit 1
fi
exit 0
