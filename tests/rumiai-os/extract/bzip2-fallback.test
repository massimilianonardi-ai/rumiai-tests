#!/bin/sh

TEST_ID="rumiai-os/extract/bzip2-fallback.test"

fail()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 1
}

error()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 3
}

skip()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error "cannot resolve test directory"
group_dir=${test_dir%/*}
tests_dir=${group_dir%/*}
suite_root=${tests_dir%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error "cannot load target discovery helper"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip "rumiai-os target checkout not found";;
  2) fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_path="$root/bin/sys/extract"
[ -f "$command_path" ] && [ ! -L "$command_path" ] && [ -x "$command_path" ] || fail "bin/sys/extract is missing or invalid"

tmp="${TMPDIR:-/tmp}/rumiai-extract-bzip2-fallback-$$"
umask 077
command -p -- mkdir -- "$tmp" || error "cannot create temporary directory"
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

fakebin="$tmp/bin"
destination="$tmp/destination"
marker="$tmp/marker"
tar_args="$tmp/tar-args"
seven_args="$tmp/7z-args"
python_count="$tmp/python-count"
python_mode="$tmp/python-mode"
python_artifact="$tmp/python-artifact"
command -p -- mkdir -- "$fakebin" || error "cannot create fake backend directory"

export EXTRACT_MARKER="$marker"
export EXTRACT_TAR_ARGS="$tar_args"
export EXTRACT_7Z_ARGS="$seven_args"
export EXTRACT_PYTHON_COUNT="$python_count"
export EXTRACT_PYTHON_MODE="$python_mode"
export EXTRACT_PYTHON_ARTIFACT="$python_artifact"

cat > "$fakebin/tar" <<'EOF_TAR'
#!/bin/sh
printf -- '%s\n' tar >> "$EXTRACT_MARKER"
: > "$EXTRACT_TAR_ARGS"
for arg
do
  printf -- '%s\n' "$arg" >> "$EXTRACT_TAR_ARGS"
done
[ "${EXTRACT_TAR_FAIL-}" = 1 ] && exit 9
exit 0
EOF_TAR
command -p -- chmod 700 "$fakebin/tar" || error "cannot make fake tar executable"

cat > "$fakebin/bzip2" <<'EOF_BZIP2'
#!/bin/sh
printf -- '%s\n' bzip2 >> "$EXTRACT_MARKER"
[ "${EXTRACT_BZIP2_FAIL-}" = 1 ] && exit 9
printf -- '%s' decompressed-stream
EOF_BZIP2
command -p -- chmod 700 "$fakebin/bzip2" || error "cannot make fake bzip2 executable"

cat > "$fakebin/7zz" <<'EOF_7Z'
#!/bin/sh
printf -- '%s\n' 7zz >> "$EXTRACT_MARKER"
: > "$EXTRACT_7Z_ARGS"
for arg
do
  printf -- '%s\n' "$arg" >> "$EXTRACT_7Z_ARGS"
done
[ "${EXTRACT_7Z_FAIL-}" = 1 ] && exit 9
printf -- '%s' decompressed-stream
EOF_7Z
command -p -- chmod 700 "$fakebin/7zz" || error "cannot make fake 7-Zip executable"

cat > "$fakebin/python3" <<'EOF_PYTHON'
#!/bin/sh
printf -- '%s\n' python3 >> "$EXTRACT_MARKER"
printf -- '%s\n' "$#" > "$EXTRACT_PYTHON_COUNT"
printf -- '%s\n' "${1-}" > "$EXTRACT_PYTHON_MODE"
printf -- '%s\n' "${3-}" > "$EXTRACT_PYTHON_ARTIFACT"
[ "${EXTRACT_PYTHON_FAIL-}" = 1 ] && exit 9
printf -- '%s' decompressed-stream
EOF_PYTHON
command -p -- chmod 700 "$fakebin/python3" || error "cannot make fake python3 executable"

artifact="$tmp/archive.tar.bz2"
printf -- '%s' payload > "$artifact" || error "cannot create archive fixture"
single_stream="$tmp/payload.bz2"
printf -- '%s' payload > "$single_stream" || error "cannot create single-stream fixture"

runtime_path="$root/bin/sys:$fakebin"

reset_case()
{
  : > "$marker" || return 1
  : > "$tar_args" || return 1
  : > "$seven_args" || return 1
  : > "$python_count" || return 1
  : > "$python_mode" || return 1
  : > "$python_artifact" || return 1
  command -p -- rm -rf -- "$destination" || return 1
  command -p -- mkdir -- "$destination" || return 1
}

assert_tar_stream_args()
{
  expected='-xf
-'
  actual=$(cat "$tar_args") || error "cannot read tar arguments"
  [ "$actual" = "$expected" ] || fail "tar received unexpected decompressed-stream arguments: $actual"
}

assert_7z_stream_args()
{
  [ "$#" -eq 1 ] || error "assert_7z_stream_args requires artifact"
  expected="x
-so
--
$1"
  actual=$(cat "$seven_args") || error "cannot read 7-Zip arguments"
  [ "$actual" = "$expected" ] || fail "7-Zip received unexpected decompression arguments: $actual"
}

assert_python_stream_args()
{
  [ "$#" -eq 1 ] || error "assert_python_stream_args requires artifact"
  actual_count=$(cat "$python_count") || error "cannot read python3 argument count"
  actual_mode=$(cat "$python_mode") || error "cannot read python3 invocation mode"
  actual_artifact=$(cat "$python_artifact") || error "cannot read python3 artifact argument"
  [ "$actual_count" = 3 ] || fail "python3 received $actual_count arguments instead of 3"
  [ "$actual_mode" = -c ] || fail "python3 was invoked with '$actual_mode' instead of -c"
  [ "$actual_artifact" = "$1" ] || fail "python3 received artifact '$actual_artifact' instead of '$1'"
}

assert_single_stream_output()
{
  output="$destination/payload"
  [ -f "$output" ] && [ ! -L "$output" ] || fail "single-stream fallback did not create payload output"
  actual=$(cat "$output") || error "cannot read single-stream output"
  [ "$actual" = decompressed-stream ] || fail "single-stream fallback produced unexpected output: $actual"
}

reset_case || error "cannot reset preferred-path fixture"
PATH="$runtime_path" "$command_path" tar.bz2 "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err" || {
  command -p -- cat "$tmp/err" >&2
  fail "tar.bz2 failed with bzip2 available"
}
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read preferred-path marker"
[ "$actual" = "bzip2 tar" ] || fail "tar.bz2 selected '$actual' instead of 'bzip2 tar'"
assert_tar_stream_args
[ ! -s "$seven_args" ] || fail "preferred bzip2 path unexpectedly invoked 7-Zip"
[ ! -s "$python_count" ] || fail "preferred bzip2 path unexpectedly invoked python3"

reset_case || error "cannot reset bzip2-failure fixture"
EXTRACT_BZIP2_FAIL=1 PATH="$runtime_path" "$command_path" tar.bz2 "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "bzip2 operational failure returned status $status instead of 1"
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read bzip2-failure marker"
[ "$actual" = bzip2 ] || fail "extract retried after bzip2 operational failure: $actual"
grep -F -- 'decompression-failed' "$tmp/err" >/dev/null 2>&1 || fail "bzip2 operational failure lacked decompression-failed diagnostics"

command -p -- mv -- "$fakebin/bzip2" "$tmp/bzip2" || error "cannot remove bzip2 capability"

for format in tar.bz2 tar.bzip2 tbz tbz2
do
  reset_case || error "cannot reset $format 7-Zip fallback fixture"
  PATH="$runtime_path" "$command_path" "$format" "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err" || {
    command -p -- cat "$tmp/err" >&2
    fail "$format did not fall back to 7-Zip when bzip2 was unavailable"
  }
  actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read $format 7-Zip fallback marker"
  [ "$actual" = "7zz tar" ] || fail "$format selected '$actual' instead of '7zz tar'"
  assert_7z_stream_args "$artifact"
  assert_tar_stream_args
done

reset_case || error "cannot reset single-stream 7-Zip fixture"
PATH="$runtime_path" "$command_path" bzip2 "$single_stream" "$destination" >"$tmp/out" 2>"$tmp/err" || {
  command -p -- cat "$tmp/err" >&2
  fail "single-stream bzip2 did not fall back to 7-Zip"
}
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read single-stream 7-Zip marker"
[ "$actual" = 7zz ] || fail "single-stream bzip2 selected '$actual' instead of 7zz"
assert_7z_stream_args "$single_stream"
assert_single_stream_output

reset_case || error "cannot reset 7-Zip-failure fixture"
EXTRACT_7Z_FAIL=1 PATH="$runtime_path" "$command_path" tar.bz2 "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "7-Zip operational failure returned status $status instead of 1"
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read 7-Zip-failure marker"
[ "$actual" = 7zz ] || fail "7-Zip failure unexpectedly continued to another backend: $actual"
grep -F -- 'decompression-failed' "$tmp/err" >/dev/null 2>&1 || fail "7-Zip operational failure lacked decompression-failed diagnostics"

command -p -- mv -- "$fakebin/7zz" "$tmp/7zz" || error "cannot remove 7-Zip capability"

for format in tar.bz2 tar.bzip2 tbz tbz2
do
  reset_case || error "cannot reset $format python3 fallback fixture"
  PATH="$runtime_path" "$command_path" "$format" "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err" || {
    command -p -- cat "$tmp/err" >&2
    fail "$format did not fall back to python3 when bzip2 and 7-Zip were unavailable"
  }
  actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read $format python3 fallback marker"
  [ "$actual" = "python3 tar" ] || fail "$format selected '$actual' instead of 'python3 tar'"
  assert_python_stream_args "$artifact"
  assert_tar_stream_args
done

reset_case || error "cannot reset single-stream python3 fixture"
PATH="$runtime_path" "$command_path" bzip2 "$single_stream" "$destination" >"$tmp/out" 2>"$tmp/err" || {
  command -p -- cat "$tmp/err" >&2
  fail "single-stream bzip2 did not fall back to python3"
}
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read single-stream python3 marker"
[ "$actual" = python3 ] || fail "single-stream bzip2 selected '$actual' instead of python3"
assert_python_stream_args "$single_stream"
assert_single_stream_output

reset_case || error "cannot reset python3-failure fixture"
EXTRACT_PYTHON_FAIL=1 PATH="$runtime_path" "$command_path" tar.bz2 "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "python3 operational failure returned status $status instead of 1"
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//') || error "cannot read python3-failure marker"
[ "$actual" = python3 ] || fail "python3 failure unexpectedly continued to another backend: $actual"
grep -F -- 'decompression-failed' "$tmp/err" >/dev/null 2>&1 || fail "python3 operational failure lacked decompression-failed diagnostics"

command -p -- mv -- "$fakebin/python3" "$tmp/python3" || error "cannot remove python3 capability"

reset_case || error "cannot reset missing-backend tar fixture"
PATH="$runtime_path" "$command_path" tar.bz2 "$artifact" "$destination" >"$tmp/out" 2>"$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "tar.bz2 without bzip2, 7-Zip or python3 returned status $status instead of 1"
[ ! -s "$marker" ] || fail "missing-backend tar case unexpectedly invoked a backend"
grep -F -- 'command-not-found' "$tmp/err" >/dev/null 2>&1 || fail "missing python3 fallback lacked command-not-found diagnostics"
grep -F -- 'command=python3' "$tmp/err" >/dev/null 2>&1 || grep -F -- 'command python3' "$tmp/err" >/dev/null 2>&1 || fail "missing fallback diagnostics did not identify python3"

reset_case || error "cannot reset missing-backend single-stream fixture"
PATH="$runtime_path" "$command_path" bzip2 "$single_stream" "$destination" >"$tmp/out" 2>"$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "single-stream bzip2 without bzip2, 7-Zip or python3 returned status $status instead of 1"
[ ! -s "$marker" ] || fail "missing-backend single-stream case unexpectedly invoked a backend"
grep -F -- 'command-not-found' "$tmp/err" >/dev/null 2>&1 || fail "single-stream missing python3 fallback lacked command-not-found diagnostics"
grep -F -- 'command=python3' "$tmp/err" >/dev/null 2>&1 || grep -F -- 'command python3' "$tmp/err" >/dev/null 2>&1 || fail "single-stream missing fallback diagnostics did not identify python3"

exit 0