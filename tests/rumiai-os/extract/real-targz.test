#!/bin/sh

TEST_ID="rumiai-os/extract/real-targz.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) :;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1";;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="$tests_dir"

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") :;;
  "1") skip "rumiai-os target checkout not found";;
  "2") fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_path="$root/bin/sys/extract"
[ -f "$command_path" ] || fail "bin/sys/extract is missing"
[ -x "$command_path" ] || fail "bin/sys/extract is not executable"
command -v tar >/dev/null 2>&1 || skip "tar is not available"
command -v gzip >/dev/null 2>&1 || skip "gzip is not available"

tmp="${TMPDIR:-/tmp}/rumiai-extract-real-targz-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
mkdir "$tmp/source" "$tmp/destination" || error "cannot create fixture directories"
printf -- '%s\n' 'real tar gzip payload' > "$tmp/source/file.txt"
(
  cd "$tmp/source" || exit 1
  tar -cf - file.txt
) | gzip -c > "$tmp/archive.tar.gz" || error "cannot create tar.gz fixture"

PATH="$root/bin/sys:/usr/bin:/bin" "$command_path" tar.gz "$tmp/archive.tar.gz" "$tmp/destination" >/dev/null 2>"$tmp/stderr" || {
  cat "$tmp/stderr" >&2
  fail "real tar.gz extraction failed"
}
[ "$(cat "$tmp/destination/file.txt")" = "real tar gzip payload" ] || fail "real tar.gz payload is incorrect"

exit "0"
