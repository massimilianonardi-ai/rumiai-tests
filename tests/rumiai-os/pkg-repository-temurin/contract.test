#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-temurin/contract.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; suite_root=${rumiai_os_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-temurin.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Temurin repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Temurin repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-temurin-contract-$$"
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository_dir="$tmp/repository"
range_dir="$tmp/range"

write_valid_repository()
{
  rm -rf "$repository_dir"
  mkdir "$repository_dir" || error "cannot recreate repository descriptor"
  printf -- '%s\n' temurin > "$repository_dir/type"
  printf -- '%s\n' linux > "$repository_dir/os"
  printf -- '%s\n' x64 > "$repository_dir/architecture"
  printf -- '%s\n' 25 > "$repository_dir/feature_version"
}
write_valid_range()
{
  rm -rf "$range_dir"
  mkdir "$range_dir" || error "cannot recreate range descriptor"
  printf -- '%s\n' '^OpenJDK25U-jdk_x64_linux_hotspot_[A-Za-z0-9][A-Za-z0-9._+~-]*\.tar\.gz$' > "$range_dir/archive_regex"
  printf -- '%s\n' sha256 > "$range_dir/digest_type"
}

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
printf -- '%s\n' "$*" >> "$TEMURIN_HTTP_LOG"
for url do :; done
length=0
for arg do [ "$arg" = -l ] && length=1; done
case "$url" in
  'https://api.adoptium.net/v3/assets/feature_releases/25/ga?architecture=x64&heap_size=normal&image_type=jdk&jvm_impl=hotspot&os=linux&page=0&page_size=20&project=jdk&sort_method=DATE&sort_order=ASC&vendor=eclipse')
    case "${TEMURIN_LIST_MODE-ok}" in
      ok) printf '%s\n' '[{"release_name":"jdk-25+36"},{"release_name":"jdk-25.0.4+7"},{"release_name":"jdk-25.0.4.1+1"}]';;
      duplicate) printf '%s\n' '[{"release_name":"jdk-25.0.4+7"},{"release_name":"jdk-25.0.4+7"}]';;
      foreign) printf '%s\n' '[{"release_name":"jdk-24.0.2+12"}]';;
      malformed) printf '%s\n' '[{"release_name":25}]';;
    esac
    ;;
  'https://api.adoptium.net/v3/checksum/version/jdk-25.0.4%2B7/linux/x64/jdk/hotspot/normal/eclipse?project=jdk')
    case "${TEMURIN_CHECKSUM_MODE-ok}" in
      ok) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz';;
      wrong-name) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  other.tar.gz';;
      duplicate) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz';;
      bad-digest) printf '%s\n' 'aaaa  OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz';;
    esac
    ;;
  'https://api.adoptium.net/v3/binary/version/jdk-25.0.4%2B7/linux/x64/jdk/hotspot/normal/eclipse?project=jdk')
    [ "$length" -eq 1 ] || exit 89
    printf -- '%s\n' 2147483648
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
TEMURIN_HTTP_LOG="$tmp/http.log"; export TEMURIN_HTTP_LOG
TEMURIN_LIST_MODE=ok; export TEMURIN_LIST_MODE
TEMURIN_CHECKSUM_MODE=ok; export TEMURIN_CHECKSUM_MODE
. "$library" || error "cannot source Temurin repository adapter"

write_valid_repository
expected_versions='25+36
25.0.4+7
25.0.4.1+1'
[ "$(pkg_repository_list_versions "$repository_dir")" = "$expected_versions" ] || fail "list_versions did not preserve Adoptium release order"
[ "$(pkg_repository_resolve_version "$repository_dir")" = '25.0.4.1+1' ] || fail "latest resolution failed"
[ "$(pkg_repository_resolve_version "$repository_dir" '25.0.4+7')" = '25.0.4+7' ] || fail "exact resolution failed"
[ "$(pkg_repository_compare_versions "$repository_dir" '25+36' '25.0.4+7')" = -1 ] || fail "forward compare_versions is incorrect"
[ "$(pkg_repository_compare_versions "$repository_dir" '25.0.4+7' '25+36')" = 1 ] || fail "reverse compare_versions is incorrect"
[ "$(pkg_repository_compare_versions "$repository_dir" '25.0.4+7' '25.0.4+7')" = 0 ] || fail "equal compare_versions is incorrect"

for field_value in 'type other' 'os other' 'architecture other' 'feature_version 21'
do
  set -- $field_value
  write_valid_repository
  printf -- '%s\n' "$2" > "$repository_dir/$1"
  if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "invalid $1 was accepted"; fi
done
write_valid_repository
printf -- '%s\n' unexpected > "$repository_dir/extra"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unknown repository field was accepted"; fi
write_valid_repository
printf -- '%s\n' aarch64 > "$repository_dir/architecture"
printf -- '%s\n' windows > "$repository_dir/os"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unsupported windows/aarch64 target was accepted"; fi
write_valid_repository
printf -- '%s' linux > "$repository_dir/os"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unterminated repository scalar was accepted"; fi

write_valid_repository
for invalid_version in 'jdk-25.0.4+7' '25' '25.0.4' '24.0.2+12' '25.0.4+7-ea'
do
  if pkg_repository_resolve_version "$repository_dir" "$invalid_version" >/dev/null 2>&1; then fail "invalid RumiAI version $invalid_version was accepted"; fi
done
TEMURIN_LIST_MODE=duplicate; export TEMURIN_LIST_MODE
if pkg_repository_list_versions "$repository_dir" >/dev/null 2>&1; then fail "duplicate upstream release was accepted"; fi
TEMURIN_LIST_MODE=foreign; export TEMURIN_LIST_MODE
if pkg_repository_list_versions "$repository_dir" >/dev/null 2>&1; then fail "foreign feature release was accepted"; fi
TEMURIN_LIST_MODE=malformed; export TEMURIN_LIST_MODE
if pkg_repository_list_versions "$repository_dir" >/dev/null 2>&1; then fail "non-string release_name was accepted"; fi
TEMURIN_LIST_MODE=ok; export TEMURIN_LIST_MODE

write_valid_range
: > "$TEMURIN_HTTP_LOG"
out="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" '25.0.4+7')" || fail "valid artifact resolution failed"
expected_descriptor='name=OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz
url=https://api.adoptium.net/v3/binary/version/jdk-25.0.4%2B7/linux/x64/jdk/hotspot/normal/eclipse?project=jdk
size=2147483648
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
[ "$out" = "$expected_descriptor" ] || fail "artifact descriptor is incorrect"
grep -F -e 'checksum/version/jdk-25.0.4%2B7/linux/x64/jdk/hotspot/normal/eclipse?project=jdk' "$TEMURIN_HTTP_LOG" >/dev/null || fail "checksum URL did not encode plus"
grep -F -e '-l -- https://api.adoptium.net/v3/binary/version/jdk-25.0.4%2B7/linux/x64/jdk/hotspot/normal/eclipse?project=jdk' "$TEMURIN_HTTP_LOG" >/dev/null || fail "size did not use http-fetch -l on exact binary URL"

for mode in wrong-name duplicate bad-digest
do
  TEMURIN_CHECKSUM_MODE=$mode; export TEMURIN_CHECKSUM_MODE
  if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" '25.0.4+7' >/dev/null 2>&1; then fail "$mode checksum response was accepted"; fi
done
TEMURIN_CHECKSUM_MODE=ok; export TEMURIN_CHECKSUM_MODE
printf -- '%s\n' sha512 > "$range_dir/digest_type"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" '25.0.4+7' >/dev/null 2>&1; then fail "non-SHA-256 range was accepted"; fi
write_valid_range
printf -- '%s\n' '.*' > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" '25.0.4+7' >/dev/null 2>&1; then fail "digest_regex was accepted"; fi
write_valid_range
printf -- '%s\n' '^other\.tar\.gz$' > "$range_dir/archive_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" '25.0.4+7' >/dev/null 2>&1; then fail "non-matching archive_regex was accepted"; fi

exit 0
