#!/bin/sh

TEST_ID=rumiai-os/pkg-repository-gpgtools/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; suite_root=${rumiai_os_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac

library=$root/lib/sys/sh/pkg/repository/pkg-repository-gpgtools.lib.sh
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail 'GPGTools repository adapter missing'
command -p -- sh -n "$library" >/dev/null 2>&1 || fail 'GPGTools repository adapter syntax invalid'

tmp=${TMPDIR:-/tmp}/rumiai-gpgtools-repository-$$
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error 'cannot create fixture'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

repository=$tmp/repository
range=$tmp/range
printf '%s\n' gpgtools > "$repository/type"
printf '%s\n' '2026.1+3633n' > "$repository/version"
printf '%s\n' 'https://releases.gpgtools.com/nightlies/GPG_Suite-3633n.dmg' > "$repository/url"
printf '%s\n' '16fa6c1dfa6b440e900632618a6ebaac7d974c3faed3a0e14ce3d1ee6826c9c5' > "$repository/digest"
printf '%s\n' '^GPG_Suite-[0-9]+n\.dmg$' > "$range/archive_regex"
printf '%s\n' sha256 > "$range/digest_type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
[ "$1" = -l ] || exit 88
[ "$2" = -- ] || exit 88
[ "$3" = 'https://releases.gpgtools.com/nightlies/GPG_Suite-3633n.dmg' ] || exit 88
printf '%s\n' 67108864
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error 'cannot prepare fake http-fetch'

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
. "$library" || error 'cannot source GPGTools adapter'

[ "$(pkg_repository_list_versions "$repository")" = '2026.1+3633n' ] || fail 'version list incorrect'
[ "$(pkg_repository_compare_versions "$repository" '2026.1+3632n' '2026.1+3633n')" = -1 ] || fail 'build comparison incorrect'
[ "$(pkg_repository_compare_versions "$repository" '2025.9+9999n' '2026.1+1n')" = -1 ] || fail 'release comparison incorrect'
[ "$(pkg_repository_resolve_version "$repository")" = '2026.1+3633n' ] || fail 'latest resolution incorrect'
[ "$(pkg_repository_resolve_version "$repository" '2026.1+3633n')" = '2026.1+3633n' ] || fail 'exact resolution incorrect'
if pkg_repository_resolve_version "$repository" '2026.1+3632n' >/dev/null 2>&1; then fail 'unpinned release accepted'; fi

out=$(pkg_repository_resolve_artifact "$repository" "$range" '2026.1+3633n') || fail 'artifact resolution failed'
expected='name=GPG_Suite-3633n.dmg
url=https://releases.gpgtools.com/nightlies/GPG_Suite-3633n.dmg
size=67108864
digest=sha256:16fa6c1dfa6b440e900632618a6ebaac7d974c3faed3a0e14ce3d1ee6826c9c5'
[ "$out" = "$expected" ] || fail 'artifact descriptor incorrect'

printf '%s\n' md5 > "$range/digest_type"
if pkg_repository_resolve_artifact "$repository" "$range" '2026.1+3633n' >/dev/null 2>&1; then fail 'wrong digest type accepted'; fi
exit 0
