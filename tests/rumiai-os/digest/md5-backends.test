#!/bin/sh

TEST_ID="rumiai-os/digest/md5-backends.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=$tests_dir

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

command_path="$root/bin/sys/digest"
[ -f "$command_path" ] && [ -x "$command_path" ] || fail "bin/sys/digest is missing or not executable"

tmp="${TMPDIR:-/tmp}/rumiai-digest-md5-backends-$$"
umask 077
mkdir "$tmp" "$tmp/bin" || error "cannot create temporary directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fakebin="$tmp/bin"
marker="$tmp/marker"
export DIGEST_MARKER="$marker"

make_backend()
{
  name=$1
  value=$2
  cat > "$fakebin/$name" <<EOF_BACKEND
#!/bin/sh
printf -- '%s\n' '$name' >> "\$DIGEST_MARKER"
/bin/cat >/dev/null || exit 91
printf -- '%s\n' '$value'
EOF_BACKEND
  chmod 700 "$fakebin/$name" || error "cannot make fake $name executable"
}

run_digest()
{
  : > "$marker"
  PATH="$root/bin/sys:$fakebin" "$command_path" -a md5 </dev/null > "$tmp/out" 2> "$tmp/err"
}

make_backend cksum 'MD5 (-) = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
make_backend md5sum 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  -'
make_backend md5 'cccccccccccccccccccccccccccccccc'
make_backend openssl 'MD5(stdin)= dddddddddddddddddddddddddddddddd'

run_digest || fail "MD5 digest failed with cksum available"
[ "$(sort -u "$marker")" = cksum ] || fail "MD5 digest did not prefer cksum"

rm "$fakebin/cksum"
run_digest || fail "MD5 digest failed with md5sum fallback"
[ "$(cat "$marker")" = md5sum ] || fail "MD5 digest did not fall back to md5sum"

rm "$fakebin/md5sum"
run_digest || fail "MD5 digest failed with md5 fallback"
[ "$(cat "$marker")" = md5 ] || fail "MD5 digest did not fall back to md5"

rm "$fakebin/md5"
run_digest || fail "MD5 digest failed with openssl fallback"
[ "$(cat "$marker")" = openssl ] || fail "MD5 digest did not fall back to openssl"

rm "$fakebin/openssl"
PATH="$root/bin/sys:$fakebin" "$command_path" -a md5 </dev/null > "$tmp/out" 2> "$tmp/err"
status=$?
[ "$status" -eq 1 ] || fail "missing MD5 capability returned $status instead of 1"

exit 0
