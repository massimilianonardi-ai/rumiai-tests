#!/bin/sh

TEST_ID="rumiai-os/digest/cli.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) :;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1";;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") :;;
  "1") skip "rumiai-os target checkout not found";;
  "2") fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_path="$root/bin/sys/digest"
[ -f "$command_path" ] || fail "bin/sys/digest is missing"
[ -x "$command_path" ] || fail "bin/sys/digest is not executable"

tmp="${TMPDIR:-/tmp}/rumiai-digest-cli-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fakebin="$tmp/bin"
mkdir "$fakebin" || error "cannot create fake backend directory"

cat > "$fakebin/cksum" <<'EOF_BACKEND'
#!/bin/sh
[ "${1-}" = "-a" ] && [ "$#" -eq 2 ] || exit 90
cat >/dev/null || exit 91
case "$2" in
  sha256) printf -- '%s\n' 'SHA256 (-) = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA';;
  md5) printf -- '%s\n' 'MD5 (-) = BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB';;
  *) exit 90;;
esac
EOF_BACKEND
chmod "700" "$fakebin/cksum" || error "cannot make fake cksum executable"

runtime_path="$root/bin/sys:$fakebin:/usr/bin:/bin"
stdout="$tmp/stdout"
stderr="$tmp/stderr"
printf -- '%s' 'stdin-data' | PATH="$runtime_path" "$command_path" -a sha256 >"$stdout" 2>"$stderr" || {
  cat "$stderr" >&2
  fail "digest stdin invocation failed"
}
[ "$(cat "$stdout")" = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ] || fail "digest did not normalize SHA-256 output"

printf -- '%s' 'file-data' > "$tmp/input"
PATH="$runtime_path" "$command_path" -a sha256 -- "$tmp/input" >"$stdout" 2>"$stderr" || fail "digest SHA-256 file invocation failed"
[ "$(cat "$stdout")" = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ] || fail "digest SHA-256 file output is incorrect"

printf -- '%s' 'stdin-data' | PATH="$runtime_path" "$command_path" -a md5 >"$stdout" 2>"$stderr" || {
  cat "$stderr" >&2
  fail "digest MD5 stdin invocation failed"
}
[ "$(cat "$stdout")" = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ] || fail "digest did not normalize MD5 output"

PATH="$runtime_path" "$command_path" -a md5 -- "$tmp/input" >"$stdout" 2>"$stderr" || fail "digest MD5 file invocation failed"
[ "$(cat "$stdout")" = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ] || fail "digest MD5 file output is incorrect"

expect_invalid()
{
  m_LOG_LEVEL=trace PATH="$runtime_path" "$command_path" "$@" >"$stdout" 2>"$stderr"
  status="$?"
  [ "$status" -eq 2 ] || fail "invalid digest invocation returned $status instead of 2"
  [ -s "$stderr" ] || fail "invalid digest invocation produced no diagnostic"
}
expect_invalid
expect_invalid -a unknown
expect_invalid -a sha256 --
expect_invalid -a sha256 -- "$tmp/input" extra
expect_invalid -a sha256 -a sha256

exit "0"
