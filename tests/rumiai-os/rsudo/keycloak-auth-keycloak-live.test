#!/bin/sh
# K04 real-server boundary: official Keycloak 26.7.3 and 26.8.1, TLS,
# client-credentials and permission separation. External SSH/sudo is replaced.
# All server state/credentials/images are disposable and isolated.
TEST_ID=rumiai-os/rsudo/keycloak-auth-keycloak-live.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}
cid= image_tag= tmp= loopback_pid=
stop_keycloak()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  cid=
  [ -z "$image_tag" ] || docker image rm "$image_tag" >/dev/null 2>&1 || :
  image_tag=
}
cleanup()
{
  if [ -n "$loopback_pid" ]
  then
    kill "$loopback_pid" 2>/dev/null || :
    wait "$loopback_pid" 2>/dev/null || :
    loopback_pid=
  fi
  stop_keycloak
  [ -z "$tmp" ] || rm -rf "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unresolved'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'product checkout resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout not available' ;;
  2) fail 'selected product checkout invalid' ;;
  *) error 'product checkout discovery failed' ;;
esac
[ "$(uname -s)" = Linux ] || skip 'Linux/Docker real Keycloak boundary'
for cmd in docker curl jq openssl python3
do
  command -v "$cmd" >/dev/null 2>&1 || skip "$cmd required for live Keycloak test"
done

tmp=${TMPDIR:-/tmp}/keycloak-live-$$
umask 077
mkdir -p "$tmp/image" "$tmp/bin" || error 'fixture directory unavailable'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture path unavailable'
cat > "$tmp/openssl.cnf" <<'CERTCONF'
[req]
distinguished_name = dn
prompt = no
x509_extensions = ext
[dn]
CN = 127.0.0.1
[ext]
subjectAltName = IP:127.0.0.1
basicConstraints = critical,CA:TRUE
keyUsage = digitalSignature,keyCertSign
CERTCONF
openssl req -x509 -newkey rsa:2048 -nodes -config "$tmp/openssl.cnf" \
  -extensions ext -days 1 \
  -keyout "$tmp/image/server.key" -out "$tmp/image/server.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'test-only TLS issuer preparation failed'

# Independent mTLS CA and two distinct client identities. Server TLS CA
# and OAuth client authentication trust are intentionally separate.
openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
  -subj /CN=k04-mtls-ca -addext 'basicConstraints=critical,CA:TRUE' \
  -addext 'keyUsage=critical,keyCertSign,cRLSign' \
  -keyout "$tmp/mtls-ca.key" -out "$tmp/image/mtls-ca.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'mTLS trust anchor preparation failed'
cat > "$tmp/mtls-client.ext" <<'MTLS_EXT'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=clientAuth
MTLS_EXT
for identity in good wrong
do
  case "$identity" in
    good) subject=/CN=k04-mtls-client ;;
    wrong) subject=/CN=k04-mtls-other ;;
  esac
  openssl req -new -newkey rsa:2048 -nodes -subj "$subject" \
    -keyout "$tmp/mtls-$identity.key" -out "$tmp/mtls-$identity.csr" \
    >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
    error "mTLS $identity client key/CSR preparation failed"
  openssl x509 -req -in "$tmp/mtls-$identity.csr" \
    -CA "$tmp/image/mtls-ca.pem" -CAkey "$tmp/mtls-ca.key" \
    -CAcreateserial -days 1 -extfile "$tmp/mtls-client.ext" \
    -out "$tmp/mtls-$identity.pem" \
    >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
    error "mTLS $identity client certificate issuance failed"
  chmod 600 "$tmp/mtls-$identity.key" "$tmp/mtls-$identity.pem" ||
    error "mTLS $identity protected client credentials failed"
done

# RFC 8705 self-signed X509 client (never the PKI client-x509 trust
# anchor). Its registration material contains public JWK parameters only.
openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
  -subj /CN=k04-self-signed-client \
  -addext 'basicConstraints=critical,CA:FALSE' \
  -addext 'keyUsage=critical,digitalSignature' \
  -addext 'extendedKeyUsage=clientAuth' \
  -keyout "$tmp/self-signed.key" -out "$tmp/self-signed.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'self-signed RFC 8705 client certificate unavailable'
chmod 600 "$tmp/self-signed.key" "$tmp/self-signed.pem" ||
  error 'self-signed client files not protected'

# Independent synthetic issuer for federated client JWT assertions. Keycloak
# receives only the verifier public key through its own OIDC IdP registration.
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
  -out "$tmp/federated-issuer.key" >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'federated issuer signing key generation failed'
openssl pkey -in "$tmp/federated-issuer.key" -pubout \
  -out "$tmp/federated-issuer-public.pem" 2>"$tmp/openssl.err" ||
  error 'federated issuer public key generation failed'
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
  -out "$tmp/federated-untrusted.key" >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'untrusted federated signing key generation failed'
chmod 600 "$tmp/federated-issuer.key" "$tmp/federated-issuer-public.pem" \
  "$tmp/federated-untrusted.key" ||
  error 'federated test key protection failed'

openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=k04-private-jwt \
  -keyout "$tmp/private-client.key" -out "$tmp/private-client.pem" \
  >"$tmp/client-openssl.out" 2>"$tmp/client-openssl.err" ||
  error 'RSA private JWT keypair preparation failed'
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=k04-wrong-jwt \
  -keyout "$tmp/wrong-client.key" -out "$tmp/wrong-client.pem" \
  >"$tmp/client-openssl.out" 2>"$tmp/client-openssl.err" ||
  error 'RSA wrong client keypair preparation failed'
chmod 600 "$tmp/private-client.key" "$tmp/private-client.pem" \
  "$tmp/wrong-client.key" "$tmp/wrong-client.pem" ||
  error 'private client keypair permissions unavailable'

for curve_spec in ES256:prime256v1 ES384:secp384r1 ES512:secp521r1
do
  algorithm=${curve_spec%%:*}
  curve=${curve_spec#*:}
  openssl ecparam -name "$curve" -genkey -noout \
    -out "$tmp/private-$algorithm.key" ||
    error "$algorithm EC client key generation failed"
  openssl req -new -x509 -key "$tmp/private-$algorithm.key" \
    -days 1 -subj "/CN=k04-$algorithm" \
    -out "$tmp/private-$algorithm.pem" ||
    error "$algorithm EC client certificate generation failed"
  chmod 600 "$tmp/private-$algorithm.key" "$tmp/private-$algorithm.pem" ||
    error "$algorithm EC client certificate permissions unavailable"
done
# Keycloak Signed JWT also supports the EdDSA JOSE algorithm. The initial
# product subset selects Ed25519, not the separate Ed448 key type.
openssl genpkey -algorithm ED25519 -out "$tmp/private-eddsa.key" ||
  error 'Ed25519 private client key preparation failed'
openssl req -new -x509 -key "$tmp/private-eddsa.key" \
  -days 1 -subj /CN=k04-eddsa -out "$tmp/private-eddsa.pem" ||
  error 'Ed25519 public client certificate preparation failed'
chmod 600 "$tmp/private-eddsa.key" "$tmp/private-eddsa.pem" ||
  error 'Ed25519 client credential permissions unavailable'
openssl genpkey -algorithm ED25519 -out "$tmp/wrong-eddsa.key" ||
  error 'unregistered Ed25519 key preparation failed'
openssl req -new -x509 -key "$tmp/wrong-eddsa.key" \
  -days 1 -subj /CN=k04-unregistered-eddsa -out "$tmp/wrong-eddsa.pem" ||
  error 'unregistered Ed25519 public certificate preparation failed'
chmod 600 "$tmp/wrong-eddsa.key" "$tmp/wrong-eddsa.pem" ||
  error 'unregistered Ed25519 credential permissions unavailable'
openssl genpkey -algorithm ED448 -out "$tmp/private-ed448.key" ||
  error 'Ed448 negative client key preparation failed'
openssl req -new -x509 -key "$tmp/private-ed448.key" \
  -days 1 -subj /CN=k04-ed448 -out "$tmp/private-ed448.pem" ||
  error 'Ed448 negative client certificate preparation failed'
chmod 600 "$tmp/private-ed448.key" "$tmp/private-ed448.pem" ||
  error 'Ed448 negative client permissions unavailable'

# Independent, unregistered P-256 key tests Keycloak's public certificate trust.
openssl ecparam -name prime256v1 -genkey -noout \
  -out "$tmp/wrong-ES256.key" ||
  error 'unregistered ECDSA key generation failed'
openssl req -new -x509 -key "$tmp/wrong-ES256.key" -days 1 \
  -subj /CN=k04-wrong-ES256 -out "$tmp/wrong-ES256.pem" ||
  error 'unregistered ECDSA certificate generation failed'
chmod 600 "$tmp/wrong-ES256.key" "$tmp/wrong-ES256.pem" ||
  error 'unregistered ECDSA key permission setup failed'

# Test credentials are synthetic; bootstrap password is passed through a
# Docker env-file and curl form-file, never through its command argument value.
printf 'KC_BOOTSTRAP_ADMIN_USERNAME=k04admin\nKC_BOOTSTRAP_ADMIN_PASSWORD=k04-bootstrap-only\n' \
  > "$tmp/bootstrap.env"
printf 'k04-bootstrap-only' > "$tmp/bootstrap-password"
printf 'k04-protected-client-secret\n' > "$tmp/secret"

cat > "$tmp/image/Dockerfile" <<'DOCKERFILE'
ARG KC_VERSION
FROM quay.io/keycloak/keycloak:${KC_VERSION}
COPY --chown=1000:0 --chmod=600 server.key /opt/keycloak/conf/k04-server.key
COPY --chown=1000:0 --chmod=644 server.pem /opt/keycloak/conf/k04-server.pem
COPY --chown=1000:0 --chmod=644 mtls-ca.pem /opt/keycloak/conf/k04-mtls-ca.pem
DOCKERFILE
cat > "$tmp/client.json" <<'CLIENT_JSON'
{
  "clientId": "k04-service",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret",
  "secret": "k04-protected-client-secret"
}
CLIENT_JSON
cat > "$tmp/client-mtls.json" <<'CLIENT_MTLS_JSON'
{
  "clientId": "k04-mtls",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-x509",
  "attributes": {
    "x509.subjectdn": "CN=k04-mtls-client",
    "x509.casubjectdn": "CN=k04-mtls-ca",
    "tls.client.certificate.bound.access.tokens": "true"
  }
}
CLIENT_MTLS_JSON

# Registered external issuer is a separate synthetic trust identity; no
# remote network call is necessary when the public verifier is pinned.
federated_issuer=https://k04-external-issuer.invalid
jq -n --rawfile verification_key "$tmp/federated-issuer-public.pem" \
  --arg issuer "$federated_issuer" '{
    alias:"k04-external-idp", providerId:"oidc", enabled:true,
    config: {
      issuer:$issuer,
      clientId:"k04-external",
      authorizationUrl:($issuer + "/authorize"),
      tokenUrl:($issuer + "/token"),
      supportsClientAssertions:"true",
      validateSignature:"true",
      useJwksUrl:"false",
      publicKeySignatureVerifier:$verification_key
    }
  }' > "$tmp/federated-idp.json" ||
  error 'federated OIDC identity-provider registration data unavailable'
cat > "$tmp/client-federated.json" <<'CLIENT_FEDERATED'
{
  "clientId": "k04-federated",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "clientAuthenticatorType": "federated-jwt",
  "attributes": {
    "jwt.credential.issuer": "k04-external-idp",
    "jwt.credential.sub": "k04-external"
  },
  "protocolMappers": [{
    "name": "k04-federated-self-audience",
    "protocol": "openid-connect",
    "protocolMapper": "oidc-audience-mapper",
    "consentRequired": false,
    "config": {
      "included.custom.audience": "k04-federated",
      "access.token.claim": "true",
      "id.token.claim": "false"
    }
  }]
}
CLIENT_FEDERATED
# RFC 7523 JWT authorization grant is distinct from federated-jwt client
# authentication. Use a separate issuer, client and linked local user.
jag_issuer=https://k04-jag-issuer.invalid
jq -n --rawfile verification_key "$tmp/federated-issuer-public.pem" \
  --arg issuer "$jag_issuer" '{
    alias:"k04-jag-idp", providerId:"oidc", enabled:true,
    config: {
      issuer:$issuer,
      clientId:"k04-jag-external",
      authorizationUrl:($issuer + "/authorize"),
      tokenUrl:($issuer + "/token"),
      jwtAuthorizationGrantEnabled:"true",
      jwtAuthorizationGrantAssertionReuseAllowed:"false",
      useJwksUrl:"false",
      validateSignature:"true",
      publicKeySignatureVerifier:$verification_key
    }
  }' > "$tmp/jag-idp.json" ||
  error 'JWT authorization grant external IdP fixture unavailable'
cat > "$tmp/jag-client.json" <<'JAG_CLIENT'
{
  "clientId": "k04-jag-client",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "secret": "k04-protected-client-secret",
  "attributes": {
    "oauth2.jwt.authorization.grant.enabled": "true",
    "oauth2.jwt.authorization.grant.idp": "k04-jag-idp"
  }
}
JAG_CLIENT
cat > "$tmp/jag-denied-client.json" <<'JAG_DENIED_CLIENT'
{
  "clientId": "k04-jag-denied",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "secret": "k04-protected-client-secret"
}
JAG_DENIED_CLIENT
cat > "$tmp/jag-user.json" <<'JAG_USER'
{"username":"k04-jag-local-user","enabled":true}
JAG_USER
printf '%s' 'k04-protected-client-secret' > "$tmp/jag-secret" ||
  error 'JWT authorization grant private client secret unavailable'
# Separate standard Authorization Code client and normal end user.
# Neither uses a service account nor Direct Access Grant. PKCE S256 is
# configured as a server-side requirement, not a caller convention.
cat > "$tmp/code-client.json" <<'CODE_CLIENT'
{
  "clientId": "k04-code-client",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "secret": "k04-protected-client-secret",
  "redirectUris": ["https://k04-client.example.invalid/oidc/callback"],
  "attributes": {"pkce.code.challenge.method": "S256"}
}
CODE_CLIENT
cat > "$tmp/code-user.json" <<'CODE_USER'
{
  "username": "k04-code-user",
  "firstName": "Test",
  "lastName": "User",
  "email": "k04-code-user@example.invalid",
  "emailVerified": true,
  "enabled": true,
  "requiredActions": [],
  "credentials": [
    {"type": "password", "value": "k04-code-fixture-password", "temporary": false}
  ]
}
CODE_USER
printf '%s' 'k04-code-fixture-password' > "$tmp/code-user-password" ||
  error 'authorization-code test-only user password unavailable'
printf '%s' 'k04-protected-client-secret' > "$tmp/code-client-secret" ||
  error 'authorization-code test-only client secret unavailable'

# Browser-protocol fixture: follow real Keycloak auth/session forms over
# verified HTTPS with a per-attempt cookie jar. This is NOT a browser UI
# automation test or a replacement for the actual server.
cat > "$tmp/code-browser.py" <<'CODE_BROWSER_PY'
import base64
import hashlib
from html.parser import HTMLParser
import json
import secrets
import sys
from urllib.parse import parse_qs, urlsplit


class LoginForm(HTMLParser):
    def __init__(self):
        super().__init__()
        self.actions = []

    def handle_starttag(self, tag, attrs):
        if tag != "form":
            return
        props = dict(attrs)
        if props.get("id") == "kc-form-login":
            self.actions.append(props.get("action"))


def write(path, value):
    with open(path, "w", encoding="utf-8") as target:
        target.write(value)


def payload(token):
    segments = token.split(".")
    if len(segments) != 3:
        raise ValueError("OIDC token is not a compact JWT")
    encoded = segments[1]
    return json.loads(base64.urlsafe_b64decode(
        encoded + "=" * (-len(encoded) % 4)
    ))


mode = sys.argv[1]
if mode == "pkce":
    verifier = secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode("ascii")).digest()
    ).rstrip(b"=").decode("ascii")
    write(sys.argv[2], verifier)
    write(sys.argv[3], challenge)
elif mode == "form":
    source, config_path, issuer_base = sys.argv[2:]
    parser = LoginForm()
    with open(source, encoding="utf-8") as html:
        parser.feed(html.read())
    if len(parser.actions) != 1 or not parser.actions[0]:
        raise ValueError("Keycloak login form not found")
    action = parser.actions[0]
    url = urlsplit(action)
    base = urlsplit(issuer_base)
    if (url.scheme, url.netloc) != (base.scheme, base.netloc):
        raise ValueError("unexpected login form origin")
    if not url.path.startswith("/realms/master/login-actions/authenticate"):
        raise ValueError("unexpected login form path")
    if "\n" in action or "\r" in action:
        raise ValueError("invalid login form URL")
    # curl config keeps session_code, execution and auth-session selectors
    # out of the shell command argument vector.
    write(config_path, "url = " + json.dumps(action) + "\n")
elif mode == "redirect":
    headers_path, expected_url, expected_state, code_path = sys.argv[2:]
    with open(headers_path, encoding="iso-8859-1") as source:
        locations = [
            line.partition(":")[2].strip()
            for line in source
            if line.lower().startswith("location:")
        ]
    if len(locations) != 1:
        raise ValueError("authorization redirect missing or ambiguous")
    uri = urlsplit(locations[0])
    expected = urlsplit(expected_url)
    if (uri.scheme, uri.netloc, uri.path, uri.fragment) != (
        expected.scheme, expected.netloc, expected.path, ""
    ):
        raise ValueError("authorization callback origin/path mismatch")
    query = parse_qs(uri.query, keep_blank_values=True)
    if (query.get("state") != [expected_state] or
            len(query.get("code", [])) != 1 or
            not query["code"][0] or "error" in query):
        raise ValueError("authorization code/state not verified")
    write(code_path, query["code"][0])
elif mode == "deliver":
    # Navigate to a local callback without exposing the one-time code in argv.
    from urllib.request import build_opener, ProxyHandler
    headers_path, expected_url = sys.argv[2:]
    with open(headers_path, encoding="iso-8859-1") as source:
        locations = [
            line.partition(":")[2].strip()
            for line in source if line.lower().startswith("location:")
        ]
    if len(locations) != 1:
        raise ValueError("missing or ambiguous authorization redirect")
    uri, expected = urlsplit(locations[0]), urlsplit(expected_url)
    if (uri.scheme, uri.netloc, uri.path, uri.fragment) != (
        expected.scheme, expected.netloc, expected.path, ""
    ) or uri.scheme != "http" or uri.hostname != "127.0.0.1":
        raise ValueError("unexpected local callback origin or path")
    with build_opener(ProxyHandler({})).open(locations[0], timeout=5) as response:
        if response.status != 200:
            raise ValueError("loopback callback rejected navigation")
elif mode == "error-redirect":
    headers_path, expected_url, expected_state = sys.argv[2:]
    with open(headers_path, encoding="iso-8859-1") as source:
        locations = [
            line.partition(":")[2].strip()
            for line in source
            if line.lower().startswith("location:")
        ]
    if len(locations) != 1:
        raise ValueError("OAuth error redirect missing or ambiguous")
    uri = urlsplit(locations[0])
    expected = urlsplit(expected_url)
    if (uri.scheme, uri.netloc, uri.path, uri.fragment) != (
        expected.scheme, expected.netloc, expected.path, ""
    ):
        raise ValueError("OAuth error callback origin/path mismatch")
    query = parse_qs(uri.query, keep_blank_values=True)
    if (query.get("state") != [expected_state] or
            len(query.get("error", [])) != 1 or
            not query["error"][0] or "code" in query):
        raise ValueError("no valid OAuth error or code leaked to callback")
elif mode == "claims":
    token_path, expected_issuer, expected_client, expected_user, nonce = sys.argv[2:]
    with open(token_path, encoding="utf-8") as source:
        result = json.load(source)
    access = payload(result["access_token"])
    identity = payload(result["id_token"])
    if (access.get("iss") != expected_issuer or
            access.get("azp") != expected_client or
            access.get("sub") != expected_user or
            identity.get("iss") != expected_issuer or
            identity.get("sub") != expected_user or
            identity.get("nonce") != nonce):
        raise ValueError("OIDC issuer/client/subject/nonce mismatch")
else:
    raise ValueError("unknown auth-code test helper mode")
CODE_BROWSER_PY
# Disposable one-shot host callback. No publicly bound port or code log.
# This remains a test fixture, not a new product service.
cat > "$tmp/code-loopback.py" <<'CODE_LOOPBACK_PY'
import json
import os
from http.server import BaseHTTPRequestHandler
from socketserver import TCPServer
import sys
from urllib.parse import parse_qs, urlsplit

config_path, port_path, code_path = sys.argv[1:]
os.umask(0o077)
with open(config_path, encoding="utf-8") as source:
    expected = json.load(source)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass  # Request URL contains authorization code.

    def do_GET(self):
        uri = urlsplit(self.path)
        params = parse_qs(uri.query, keep_blank_values=True)
        valid = (uri.path == "/oidc/callback" and not uri.fragment and
                 params.get("state") == [expected["state"]] and
                 len(params.get("code", [])) == 1 and
                 bool(params["code"][0]) and "error" not in params and
                 params.get("iss", [expected["issuer"]]) == [expected["issuer"]])
        if not valid:
            self.send_response(400)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        try:
            flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            fd = os.open(code_path, flags, 0o600)
            try:
                os.write(fd, params["code"][0].encode("ascii"))
            finally:
                os.close(fd)
        except (OSError, UnicodeEncodeError):
            self.send_response(400)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.end_headers()
        self.wfile.write(b"Authorization response received.")

with TCPServer(("127.0.0.1", 0), Handler) as server:
    with open(port_path, "x", encoding="ascii") as target:
        target.write(str(server.server_address[1]))
    server.timeout = 80
    server.handle_request()
CODE_LOOPBACK_PY

cat > "$tmp/sign-federated-jwt.py" <<'PYFEDERATED'
import base64
import json
import subprocess
import sys
import time
import uuid

issuer, subject, audience, key_path, output_path = sys.argv[1:6]
expire_after = int(sys.argv[6]) if len(sys.argv) > 6 else 180
issued_at = int(time.time())


def urlsafe(value):
    return base64.urlsafe_b64encode(value).decode("ascii").rstrip("=")


header = urlsafe(json.dumps(
    {"alg": "RS256", "typ": "JWT"}, separators=(",", ":")
).encode("utf-8"))
payload = urlsafe(json.dumps({
    "iss": issuer,
    "sub": subject,
    "aud": audience,
    "iat": issued_at,
    "exp": issued_at + expire_after,
    "jti": str(uuid.uuid4()),
}, separators=(",", ":")).encode("utf-8"))
message = (header + "." + payload).encode("ascii")
signature = subprocess.run(
    ["openssl", "dgst", "-sha256", "-sign", key_path],
    input=message, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    check=True,
).stdout
with open(output_path, "w", encoding="ascii") as output:
    output.write(message.decode("ascii") + "." + urlsafe(signature))
PYFEDERATED
cat > "$tmp/client-oidc-registration-control.json" <<'OIDC_CONTROL'
{
  "client_name": "k04-standard-oidc-registration-control",
  "grant_types": ["client_credentials"],
  "token_endpoint_auth_method": "client_secret_basic"
}
OIDC_CONTROL
cat > "$tmp/self-signed-jwk.py" <<'PYJWK'
import base64
import json
import re
import subprocess
import sys

# Derive the public RSA JWK n/e from the actual certificate, not from
# private-key bytes. x5c holds the same certificate in DER-base64 form.
with open(sys.argv[1], encoding="ascii") as cert_file:
    pem = cert_file.read()
certificate = "".join(
    line.strip() for line in pem.splitlines() if not line.startswith("-----")
)
public_key = subprocess.run(
    ["openssl", "x509", "-in", sys.argv[1], "-pubkey", "-noout"],
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True
).stdout
details = subprocess.run(
    ["openssl", "rsa", "-pubin", "-modulus", "-text", "-noout"],
    input=public_key, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    check=True
).stdout.decode("ascii")
modulus = re.search(r"Modulus=([0-9A-Fa-f]+)", details)
exponent = re.search(r"Exponent:\s*(\d+)", details)
if modulus is None or exponent is None:
    raise ValueError("RSA public certificate parameters unavailable")

def enc(number):
    length = max(1, (number.bit_length() + 7) // 8)
    return base64.urlsafe_b64encode(number.to_bytes(length, "big")).rstrip(
        b"="
    ).decode("ascii")

with open(sys.argv[2], "w", encoding="utf-8") as output:
    json.dump({
        "client_name": "k04-self-signed-registration-probe",
        "grant_types": ["client_credentials"],
        "token_endpoint_auth_method": "self_signed_tls_client_auth",
        "jwks": {"keys": [{
            "kty": "RSA", "use": "sig", "kid": "k04-self-signed",
            "n": enc(int(modulus.group(1), 16)),
            "e": enc(int(exponent.group(1))),
            "x5c": [certificate]
        }]}
    }, output)
PYJWK
python3 "$tmp/self-signed-jwk.py" "$tmp/self-signed.pem" \
  "$tmp/client-self-signed-oidc.json" ||
  error 'self-signed public JWK client registration unavailable'
cat > "$tmp/client-jwt.json" <<'CLIENT_JWT_JSON'
{
  "clientId": "k04-signed",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret-jwt",
  "secret": "k04-protected-client-secret",
  "attributes": {
    "token.endpoint.auth.signing.alg": "HS256"
  }
}
CLIENT_JWT_JSON
cat > "$tmp/client-rsa-base.json" <<'CLIENT_RSA_JSON'
{
  "clientId": "k04-rs256",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-jwt",
  "attributes": {"token.endpoint.auth.signing.alg": "RS256"}
}
CLIENT_RSA_JSON
cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
  "$tmp/private-client.pem" | tr -d '\r\n') ||
  error 'RSA public certificate encoding unavailable'
[ -n "$cert_body" ] || error 'RSA public certificate empty'
jq --arg cert "$cert_body" \
  '.attributes["jwt.credential.certificate"] = $cert' \
  "$tmp/client-rsa-base.json" > "$tmp/client-rsa.json" ||
  error 'RSA client configuration preparation failed'
unset cert_body
for algorithm in ES256 ES384 ES512
do
  cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
    "$tmp/private-$algorithm.pem" | tr -d '\r\n') ||
    error "$algorithm certificate base64 extraction failed"
  [ -n "$cert_body" ] || error "$algorithm client certificate empty"
  jq --arg id "k04-$(printf '%s' "$algorithm" | tr '[:upper:]' '[:lower:]')" \
    --arg alg "$algorithm" --arg cert "$cert_body" \
    '.clientId = $id | .attributes["token.endpoint.auth.signing.alg"] = $alg |
     .attributes["jwt.credential.certificate"] = $cert' \
    "$tmp/client-rsa-base.json" > "$tmp/client-$algorithm.json" ||
    error "$algorithm Keycloak client configuration preparation failed"
done
unset cert_body
cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
  "$tmp/private-eddsa.pem" | tr -d '\r\n') ||
  error 'Ed25519 public client certificate encoding failed'
[ -n "$cert_body" ] || error 'Ed25519 client certificate empty'
jq --arg cert "$cert_body" \
  '.clientId = "k04-eddsa" |
   .attributes["token.endpoint.auth.signing.alg"] = "EdDSA" |
   .attributes["jwt.credential.certificate"] = $cert' \
  "$tmp/client-rsa-base.json" > "$tmp/client-eddsa.json" ||
  error 'EdDSA client configuration preparation failed'
unset cert_body

cat > "$tmp/bin/k04-keycloak-live-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 91
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 92
loadsyslib "rsudo/rsudo-mod-keycloak" || exit 93
rsudo()
{
  [ "$1" = -- ] || return 94
  shift
  "$@"
}
if [ "${1-}" = admin-probe ]
then
  shift
  _rsudo_mod_keycloak_admin_transport_probe "$@"
else
  rsudo_mod_keycloak_auth "$@"
fi
PROBE
chmod 700 "$tmp/bin/k04-keycloak-live-probe" ||
  error 'm test entrypoint unavailable'

probe()
{
  PATH="$tmp/bin:$PATH" "$root/m" k04-keycloak-live-probe "$@"
}
transport()
{
  curl -q --silent --show-error --noproxy '*' --proxy '' \
    --cacert "$tmp/image/server.pem" --proto '=https' \
    --max-redirs 0 --connect-timeout 3 --max-time 25 "$@"
}

# Assertion bytes are only read by curl from a private file; never argv/logs.
federated_token_request()
{
  transport --output "$2" --write-out '%{http_code}' \
    --data-urlencode grant_type=client_credentials \
    --data-urlencode "client_id=$4" \
    --data-urlencode \
      client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer \
    --data-urlencode "client_assertion@$1" \
    --url "$3/realms/master/protocol/openid-connect/token"
}

# Protected assertion and client-secret bytes are read by curl from
# private files. A grant assertion is not a client authentication assertion.
jag_token_request()
{
  transport --output "$2" --write-out '%{http_code}' \
    --data-urlencode 'grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer' \
    --data-urlencode "client_id=$4" \
    --data-urlencode "client_secret@$tmp/jag-secret" \
    --data-urlencode "assertion@$1" \
    --url "$3/realms/master/protocol/openid-connect/token"
}

# Full real Keycloak authorization endpoint → login form → redirect.
# All login sessions are independent; no callback listener, browser agent
# library, or application server is invented by this HTTP-level test.
code_authorize()
{
  code_label=$1
  code_redirect_uri=${2:-https://k04-client.example.invalid/oidc/callback}
  python3 "$tmp/code-browser.py" pkce \
    "$tmp/code-verifier-$version-$code_label" \
    "$tmp/code-challenge-$version-$code_label" ||
    error "Keycloak $version PKCE preparation failed"
  code_challenge=$(cat "$tmp/code-challenge-$version-$code_label") ||
    error "Keycloak $version PKCE challenge unavailable"
  code_state=k04-state-$version-$code_label
  code_nonce=k04-nonce-$version-$code_label
  code_http=$(transport --get \
    --output "$tmp/code-page-$version-$code_label" \
    --cookie-jar "$tmp/code-cookies-$version-$code_label" \
    --write-out '%{http_code}' \
    --data-urlencode 'response_type=code' \
    --data-urlencode 'scope=openid' \
    --data-urlencode 'client_id=k04-code-client' \
    --data-urlencode "redirect_uri=$code_redirect_uri" \
    --data-urlencode "state=$code_state" \
    --data-urlencode "nonce=$code_nonce" \
    --data-urlencode "code_challenge=$code_challenge" \
    --data-urlencode 'code_challenge_method=S256' \
    --url "$base/realms/master/protocol/openid-connect/auth") ||
    error "Keycloak $version authorization endpoint transport failed"
  [ "$code_http" = 200 ] ||
    fail "Keycloak $version authorization request did not open login ($code_http)"
  python3 "$tmp/code-browser.py" form \
    "$tmp/code-page-$version-$code_label" \
    "$tmp/code-action-$version-$code_label.conf" "$base" ||
    fail "Keycloak $version did not supply a same-origin login form"
  code_login_http=$(transport \
    --output "$tmp/code-login-page-$version-$code_label" \
    --dump-header "$tmp/code-login-headers-$version-$code_label" \
    --write-out '%{http_code}' \
    --cookie "$tmp/code-cookies-$version-$code_label" \
    --cookie-jar "$tmp/code-cookies-$version-$code_label" \
    --data-urlencode 'username=k04-code-user' \
    --data-urlencode "password@$tmp/code-user-password" \
    --config "$tmp/code-action-$version-$code_label.conf") ||
    error "Keycloak $version login form submission transport failed"
  case "$code_login_http" in 302|303) : ;; *)
    fail "Keycloak $version login form did not return authorization redirect ($code_login_http)" ;;
  esac
  if [ "$code_label" = loopback ]
  then
    python3 "$tmp/code-browser.py" deliver \
      "$tmp/code-login-headers-$version-$code_label" \
      "$code_redirect_uri" ||
      fail "Keycloak $version loopback callback navigation failed"
  else
    python3 "$tmp/code-browser.py" redirect \
      "$tmp/code-login-headers-$version-$code_label" \
      "$code_redirect_uri" "$code_state" \
      "$tmp/code-grant-$version-$code_label" ||
      fail "Keycloak $version authorization callback code/state not verified"
  fi
}

# Client credential and code are independent private form-file inputs.
code_exchange()
{
  code_label=$1
  code_verifier_path=$2
  code_redirect=$3
  code_result_path=$4
  transport --output "$code_result_path" --write-out '%{http_code}' \
    --data-urlencode 'grant_type=authorization_code' \
    --data-urlencode 'client_id=k04-code-client' \
    --data-urlencode "client_secret@$tmp/code-client-secret" \
    --data-urlencode "code@$tmp/code-grant-$version-$code_label" \
    --data-urlencode "code_verifier@$code_verifier_path" \
    --data-urlencode "redirect_uri=$code_redirect" \
    --url "$base/realms/master/protocol/openid-connect/token"
}

# A certificate-bound token's public confirmation claim must equal SHA-256
# over the DER client certificate (RFC 8705). The protected token is read
# from its file, never passed as an argv value or included in diagnostics.
cat > "$tmp/verify-mtls-token.py" <<'PYMTLS'
import base64
import hashlib
import json
import subprocess
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        token = json.load(source)["access_token"]
    segments = token.split(".")
    if len(segments) != 3:
        raise ValueError("JWT shape")
    part = segments[1]
    payload = json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    certificate = subprocess.run(
        ["openssl", "x509", "-in", sys.argv[2], "-outform", "DER"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    ).stdout
    expected = base64.urlsafe_b64encode(
        hashlib.sha256(certificate).digest()
    ).rstrip(b"=").decode("ascii")
    matched = payload.get("cnf", {}).get("x5t#S256") == expected
except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError):
    matched = False

sys.exit(0 if matched else 1)
PYMTLS

for version in 26.7.3 26.8.1
do
  image_tag=keycloak-k04-real-$version-$$
  docker build --quiet --build-arg "KC_VERSION=$version" \
    --tag "$image_tag" "$tmp/image" > "$tmp/image-id" ||
    error "official Keycloak $version test image unavailable"
  cid=$(docker run -d --memory 2g --network bridge \
    --publish 127.0.0.1::8443 \
    --env-file "$tmp/bootstrap.env" "$image_tag" \
    start-dev --http-enabled=false --hostname-strict=false \
    --https-certificate-file=/opt/keycloak/conf/k04-server.pem \
    --https-certificate-key-file=/opt/keycloak/conf/k04-server.key \
    --https-client-auth=request \
    --https-trust-store-file=/opt/keycloak/conf/k04-mtls-ca.pem \
    --features=client-auth-federated) ||
    error "Keycloak $version container could not start"

  [ -n "$cid" ] || error 'Keycloak container identity is empty'
  mapping=$(docker port "$cid" 8443/tcp) || error 'Keycloak HTTPS port missing'
  port=${mapping##*:}
  case "$port" in
    ''|*[!0-9]*) error 'Keycloak HTTPS port invalid' ;;
  esac
  base=https://127.0.0.1:$port

  tries=0
  until transport --output "$tmp/ready" --fail \
    --url "$base/realms/master/.well-known/openid-configuration" \
    >/dev/null 2>"$tmp/ready.err"
  do
    [ "$(docker inspect --format '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] || {
      docker logs --tail 18 "$cid" >&2
      error "Keycloak $version container exited"
    }
    tries=$((tries + 1))
    [ "$tries" -lt 150 ] || {
      docker logs --tail 18 "$cid" >&2
      error "Keycloak $version did not become HTTPS-ready"
    }
    sleep 1
  done

  jq -e --arg expected "$base/realms/master" '.issuer == $expected' \
    "$tmp/ready" >/dev/null ||
    fail "Keycloak $version returned unexpected issuer identity"

  # Discovery is provider metadata, not an execution test. In particular,
  # self_signed_tls_client_auth is distinct from the configured PKI client-x509.
  if jq -e '(.token_endpoint_auth_methods_supported // []) |
    index("self_signed_tls_client_auth") != null' "$tmp/ready" >/dev/null
  then
    self_signed_advertised=yes
  else
    self_signed_advertised=no
  fi
  printf '%s: Keycloak %s OIDC advertises self_signed_tls_client_auth=%s (not runtime validation)\n' \
    "$TEST_ID" "$version" "$self_signed_advertised"

  admin_code=$(transport --output "$tmp/admin-token" \
    --write-out '%{http_code}' \
    --data-urlencode grant_type=password \
    --data-urlencode client_id=admin-cli \
    --data-urlencode username=k04admin \
    --data-urlencode "password@$tmp/bootstrap-password" \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version initial admin OAuth request failed"
  [ "$admin_code" = 200 ] ||
    fail "Keycloak $version initial admin login returned HTTP $admin_code"
  admin_token=$(jq -er '.access_token' "$tmp/admin-token") ||
    error "Keycloak $version bootstrap token missing"
  printf 'Authorization: Bearer %s\n' "$admin_token" > "$tmp/bootstrap-header"
  unset admin_token

  create_code=$(transport --output "$tmp/create-response" \
    --write-out '%{http_code}' \
    --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version Admin REST bootstrap client request failed"
  [ "$create_code" = 201 ] ||
    fail "Keycloak $version rejected service account provisioning ($create_code)"

  # Cross-check the actual loaded client authenticator factories, rather
  # than infer the separate self-signed RFC 8705 mechanism from the PKI
  # authenticator or OIDC discovery alone.
  providers_http=$(transport --output "$tmp/auth-providers-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/authentication/client-authenticator-providers") ||
    error "Keycloak $version client authenticator provider inspection transport failed"
  [ "$providers_http" = 200 ] &&
    jq -e 'type == "array" and any(.[]; .id == "client-x509")' \
      "$tmp/auth-providers-$version" >/dev/null ||
    fail "Keycloak $version client authenticator registry unavailable ($providers_http)"
  jq -e 'any(.[]; .id == "federated-jwt")' \
    "$tmp/auth-providers-$version" >/dev/null ||
    fail "Keycloak $version feature-enabled federated client provider not loaded"
  if jq -e 'any(.[]; .id == "self_signed_tls_client_auth")' \
    "$tmp/auth-providers-$version" >/dev/null
  then
    self_signed_provider=present
  else
    self_signed_provider=absent
  fi
  printf '%s: Keycloak %s RFC 8705 self-signed client authenticator provider=%s\n' \
    "$TEST_ID" "$version" "$self_signed_provider"

  # Positive control for the same OIDC dynamic registration interface,
  # using an established client-secret method. Responses stay protected.
  register_base=$base/realms/master/clients-registrations/openid-connect
  register_control_http=$(transport --output "$tmp/registration-control-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-oidc-registration-control.json" \
    --url "$register_base") ||
    error "Keycloak $version OIDC registration positive-control transport failed"
  [ "$register_control_http" = 201 ] &&
    jq -e '.client_id | type == "string" and length > 0' \
      "$tmp/registration-control-$version" >/dev/null ||
    fail "Keycloak $version OIDC registration positive-control rejected ($register_control_http)"

  register_self_http=$(transport --output "$tmp/registration-self-signed-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-self-signed-oidc.json" \
    --url "$register_base") ||
    error "Keycloak $version RFC 8705 self-signed registration transport failed"
  printf '%s: Keycloak %s self-signed RFC 8705 OIDC registration HTTP=%s\n' \
    "$TEST_ID" "$version" "$register_self_http"
  # No self-signed provider is expected in the frozen target releases.
  # A newly loaded provider or accepted registration needs a separate
  # positive authentication test before claiming supported behavior.
  [ "$self_signed_provider" = absent ] &&
    [ "$register_self_http" = 400 ] ||
    fail "Keycloak $version self-signed mechanism changed; re-evaluate actual client authentication"
  jq -e '.error | type == "string" and length > 0' \
    "$tmp/registration-self-signed-$version" >/dev/null ||
    fail "Keycloak $version self-signed registration rejection lacks OAuth error"

  # Real provider test: establish external issuer trust and bind the local
  # confidential client to the issuer alias and external subject. This is a
  # Keycloak container with its actual verification/authorization flow.
  idp_http=$(transport --output "$tmp/federated-idp-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/federated-idp.json" \
    --url "$base/admin/realms/master/identity-provider/instances") ||
    error "Keycloak $version external OIDC assertion issuer registration failed"
  [ "$idp_http" = 201 ] ||
    fail "Keycloak $version external assertion issuer registration HTTP $idp_http"
  federated_client_http=$(transport \
    --output "$tmp/federated-client-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-federated.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version federated client registration transport failed"
  [ "$federated_client_http" = 201 ] ||
    fail "Keycloak $version federated client registration HTTP $federated_client_http"

  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-assertion-$version" ||
    error "Keycloak $version federated client assertion signing failed"
  federated_http=$(federated_token_request \
    "$tmp/federated-assertion-$version" "$tmp/federated-token-$version" "$base" k04-federated) ||
    error "Keycloak $version federated token request transport failed"
  [ "$federated_http" = 200 ] &&
    jq -e '.access_token | type == "string" and length > 0' \
      "$tmp/federated-token-$version" >/dev/null ||
    fail "Keycloak $version real federated client grant rejected ($federated_http)"

  # Replay of the same already used assertion must not authenticate a new
  # request under the identity provider's default one-use assertion policy.
  replay_http=$(federated_token_request \
    "$tmp/federated-assertion-$version" \
    "$tmp/federated-replay-response-$version" "$base" k04-federated) ||
    error "Keycloak $version federated assertion replay transport failed"
  case "$replay_http" in 400|401) : ;; *)
    fail "Keycloak $version accepted repeated federated assertion ($replay_http)" ;;
  esac
  jq -e '.error | type == "string" and length > 0' \
    "$tmp/federated-replay-response-$version" >/dev/null ||
    fail "Keycloak $version federated replay rejection lacked OAuth error"

  # An otherwise correctly signed assertion from the registered external
  # issuer must not authenticate after its expiration.
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-expired-$version" -30 ||
    error "Keycloak $version expired federated assertion construction failed"
  expired_http=$(federated_token_request \
    "$tmp/federated-expired-$version" \
    "$tmp/federated-expired-response-$version" "$base" k04-federated) ||
    error "Keycloak $version expired federated assertion transport failed"
  case "$expired_http" in 400|401) : ;; *)
    fail "Keycloak $version accepted expired federated assertion ($expired_http)" ;;
  esac
  jq -e '.error | type == "string" and length > 0' \
    "$tmp/federated-expired-response-$version" >/dev/null ||
    fail "Keycloak $version expired federated assertion rejection lacked OAuth error"

  # Check Keycloak's actual introspection and revocation client auth with
  # fresh external assertions; each JWT is unique and never appears in
  # request arguments, diagnostics or test stdout.
  jq -jr '.access_token' "$tmp/federated-token-$version" \
    > "$tmp/federated-access-$version" ||
    error "Keycloak $version protected federated access-token extraction failed"
  [ -s "$tmp/federated-access-$version" ] ||
    error "Keycloak $version extracted federated access-token empty"
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-introspection-assertion-$version" ||
    error "Keycloak $version federated introspection assertion creation failed"
  federation_introspect_http=$(transport \
    --output "$tmp/federated-introspection-response-$version" \
    --write-out '%{http_code}' \
    --data-urlencode 'client_id=k04-federated' \
    --data-urlencode \
      'client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer' \
    --data-urlencode "client_assertion@$tmp/federated-introspection-assertion-$version" \
    --data-urlencode "token@$tmp/federated-access-$version" \
    --data-urlencode 'token_type_hint=access_token' \
    --url "$base/realms/master/protocol/openid-connect/token/introspect") ||
    error "Keycloak $version federated introspection transport failed"
  # Keycloak 26.6+ audience validation requires the introspecting client
  # to be explicitly included in the token's audience. The fixture mapper
  # establishes this separate permission without disabling audience checks.
  [ "$federation_introspect_http" = 200 ] &&
    jq -e '.active == true' \
      "$tmp/federated-introspection-response-$version" >/dev/null ||
    fail "Keycloak $version audience-authorized federated introspection did not report active ($federation_introspect_http)"
  observed_active=$(jq -er '.active | tostring' \
    "$tmp/federated-introspection-response-$version") ||
    error "Keycloak $version federated introspection active flag unavailable"
  printf '%s: Keycloak %s federated introspection accepted with active=%s (server observation)\n' \
    "$TEST_ID" "$version" "$observed_active"

  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-revoke-assertion-$version" ||
    error "Keycloak $version federated revocation assertion creation failed"
  federation_revoke_http=$(transport \
    --output "$tmp/federated-revoke-response-$version" \
    --write-out '%{http_code}' \
    --data-urlencode 'client_id=k04-federated' \
    --data-urlencode \
      'client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer' \
    --data-urlencode "client_assertion@$tmp/federated-revoke-assertion-$version" \
    --data-urlencode "token@$tmp/federated-access-$version" \
    --data-urlencode 'token_type_hint=access_token' \
    --url "$base/realms/master/protocol/openid-connect/revoke") ||
    error "Keycloak $version federated revocation transport failed"
  [ "$federation_revoke_http" = 200 ] ||
    fail "Keycloak $version federated revocation refused new assertion ($federation_revoke_http)"
  printf '%s: Keycloak %s fresh federated client assertions support introspection/revocation; replay and expiry denied\n' \
    "$TEST_ID" "$version"

  # A different selected OAuth client must not inherit the authority
  # of the correctly signed assertion for the registered federated client.
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-mismatched-client-$version" ||
    error "Keycloak $version wrong-client assertion creation failed"
  mismatched_client_http=$(federated_token_request \
    "$tmp/federated-mismatched-client-$version" \
    "$tmp/federated-mismatched-client-response-$version" "$base" k04-service) ||
    error "Keycloak $version wrong-client assertion transport failed"
  case "$mismatched_client_http" in 400|401) : ;; *)
    fail "Keycloak $version accepted mismatched federated client identity ($mismatched_client_http)" ;;
  esac
  jq -e '.error | type == "string" and length > 0' \
    "$tmp/federated-mismatched-client-response-$version" >/dev/null ||
    fail "Keycloak $version mismatched federated client lacked OAuth error"

  # Independently signed but untrusted assertions and wrong audiences
  # must fail; never expose JWTs or tokens to the test result stream.
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-untrusted.key" "$tmp/federated-untrusted-$version" ||
    error "Keycloak $version untrusted assertion creation failed"
  untrusted_http=$(federated_token_request \
    "$tmp/federated-untrusted-$version" \
    "$tmp/federated-untrusted-response-$version" "$base" k04-federated) ||
    error "Keycloak $version untrusted assertion transport failed"
  case "$untrusted_http" in 400|401) : ;; *)
    fail "Keycloak $version accepted untrusted federated signature ($untrusted_http)" ;;
  esac
  jq -e '.error == "invalid_client"' \
    "$tmp/federated-untrusted-response-$version" >/dev/null ||
    fail "Keycloak $version untrusted federated assertion lacked invalid_client"

  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external https://k04-wrong-audience.invalid \
    "$tmp/federated-issuer.key" "$tmp/federated-wrong-audience-$version" ||
    error "Keycloak $version wrong-audience assertion creation failed"
  wrong_audience_http=$(federated_token_request \
    "$tmp/federated-wrong-audience-$version" \
    "$tmp/federated-wrong-audience-response-$version" "$base" k04-federated) ||
    error "Keycloak $version wrong-audience assertion transport failed"
  case "$wrong_audience_http" in 400|401) : ;; *)
    fail "Keycloak $version accepted wrong federated audience ($wrong_audience_http)" ;;
  esac
  jq -e '.error == "invalid_client"' \
    "$tmp/federated-wrong-audience-response-$version" >/dev/null ||
    fail "Keycloak $version wrong federated audience lacked invalid_client"
  printf '%s: Keycloak %s real federated issuer JWT grant and signature/audience rejection verified\n' \
    "$TEST_ID" "$version"

  # K04 pending grant: first prove real Keycloak authorization-code with
  # registered redirect, state and S256 through an actual login session.
  # This is independent server evidence, not an rsudo public-mode claim.
  jq -e '(.code_challenge_methods_supported // []) |
    index("S256") != null' "$tmp/ready" >/dev/null ||
    fail "Keycloak $version discovery does not advertise PKCE S256"
  # Bind before the authorization request; register only the selected
  # loopback port on this disposable confidential test client.
  jq -n --arg state "k04-state-$version-loopback" \
    --arg issuer "$base/realms/master" \
    '{state:$state,issuer:$issuer}' > "$tmp/code-loopback-config-$version.json" ||
    error "Keycloak $version loopback state unavailable"
  python3 "$tmp/code-loopback.py" \
    "$tmp/code-loopback-config-$version.json" \
    "$tmp/code-loopback-port-$version" \
    "$tmp/code-grant-$version-loopback" > "$tmp/code-loopback-output-$version" 2>&1 &
  loopback_pid=$!
  tries=0
  until [ -s "$tmp/code-loopback-port-$version" ]
  do
    kill -0 "$loopback_pid" 2>/dev/null ||
      error "Keycloak $version loopback listener exited before bind"
    tries=$((tries+1))
    [ "$tries" -lt 80 ] ||
      error "Keycloak $version loopback listener did not bind"
    sleep 0.1
  done
  loopback_port=$(cat "$tmp/code-loopback-port-$version") ||
    error "Keycloak $version loopback port read failed"
  case "$loopback_port" in
    ''|*[!0-9]*) error "Keycloak $version invalid loopback callback port" ;;
  esac
  loopback_uri=http://127.0.0.1:$loopback_port/oidc/callback
  jq --arg uri "$loopback_uri" '.redirectUris += [$uri]' \
    "$tmp/code-client.json" > "$tmp/code-client-active-$version.json" ||
    error "Keycloak $version exact loopback registration unavailable"
  code_client_http=$(transport --output "$tmp/code-client-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/code-client-active-$version.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version authorization-code client provisioning transport failed"
  [ "$code_client_http" = 201 ] ||
    fail "Keycloak $version authorization-code client not accepted ($code_client_http)"
  code_user_http=$(transport --output "$tmp/code-user-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/code-user.json" \
    --url "$base/admin/realms/master/users") ||
    error "Keycloak $version authorization-code user provisioning transport failed"
  [ "$code_user_http" = 201 ] ||
    fail "Keycloak $version authorization-code user not accepted ($code_user_http)"
  code_user_lookup_http=$(transport \
    --output "$tmp/code-users-$version" --write-out '%{http_code}' \
    --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/users?username=k04-code-user&exact=true") ||
    error "Keycloak $version authorization-code local user lookup failed"
  [ "$code_user_lookup_http" = 200 ] ||
    fail "Keycloak $version authorization-code user lookup HTTP $code_user_lookup_http"
  code_user_uuid=$(jq -er \
    '.[] | select(.username == "k04-code-user") | .id' \
    "$tmp/code-users-$version") ||
    fail "Keycloak $version authorization-code user UUID unavailable"

  code_authorize loopback "$loopback_uri"
  wait "$loopback_pid" ||
    fail "Keycloak $version loopback listener did not terminate"
  loopback_pid=
  loopback_http=$(code_exchange loopback \
    "$tmp/code-verifier-$version-loopback" "$loopback_uri" \
    "$tmp/code-loopback-token-$version") ||
    error "Keycloak $version loopback authorization code exchange failed"
  [ "$loopback_http" = 200 ] &&
    jq -e '(.access_token | type == "string" and length > 0) and
      (.id_token | type == "string" and length > 0)' \
      "$tmp/code-loopback-token-$version" >/dev/null &&
    python3 "$tmp/code-browser.py" claims "$tmp/code-loopback-token-$version" \
      "$base/realms/master" k04-code-client "$code_user_uuid" \
      "k04-nonce-$version-loopback" ||
    fail "Keycloak $version registered loopback callback/code exchange failed ($loopback_http)"
  printf '%s: Keycloak %s one-shot loopback OAuth callback and PKCE S256 exchange verified\n' \
    "$TEST_ID" "$version"

  code_authorize positive
  positive_http=$(code_exchange positive \
    "$tmp/code-verifier-$version-positive" \
    https://k04-client.example.invalid/oidc/callback \
    "$tmp/code-token-$version") ||
    error "Keycloak $version authorization-code exchange transport failed"
  [ "$positive_http" = 200 ] &&
    jq -e '(.access_token | type == "string" and length > 0) and
      (.id_token | type == "string" and length > 0) and
      (.refresh_token | type == "string" and length > 0)' \
      "$tmp/code-token-$version" >/dev/null ||
    fail "Keycloak $version authorization-code PKCE exchange denied ($positive_http)"
  python3 "$tmp/code-browser.py" claims "$tmp/code-token-$version" \
    "$base/realms/master" k04-code-client "$code_user_uuid" \
    "k04-nonce-$version-positive" ||
    fail "Keycloak $version authorization-code OIDC identity/nonce mismatch"

  # An authenticated normal user is not an administrator: the bearer
  # obtained from the code grant must not silently acquire Admin REST roles.
  jq -jr '.access_token' "$tmp/code-token-$version" \
    > "$tmp/code-bearer-$version" ||
    error "Keycloak $version protected authorization-code bearer unavailable"
  printf 'Authorization: Bearer %s\n' \
    "$(cat "$tmp/code-bearer-$version")" > "$tmp/code-admin-header-$version" ||
    error "Keycloak $version protected user bearer header unavailable"
  code_admin_http=$(transport --output "$tmp/code-admin-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/code-admin-header-$version" \
    --url "$base/admin/realms/master") ||
    error "Keycloak $version authorization-code Admin REST probe transport failed"
  [ "$code_admin_http" = 403 ] ||
    fail "Keycloak $version ordinary browser user crossed Admin REST boundary ($code_admin_http)"

  code_replay_http=$(code_exchange positive \
    "$tmp/code-verifier-$version-positive" \
    https://k04-client.example.invalid/oidc/callback \
    "$tmp/code-replay-response-$version") ||
    error "Keycloak $version authorization-code replay transport failed"
  [ "$code_replay_http" = 400 ] &&
    jq -e '.error == "invalid_grant"' \
      "$tmp/code-replay-response-$version" >/dev/null ||
    fail "Keycloak $version accepted an already redeemed authorization code ($code_replay_http)"

  # Each negative gets its own fresh authenticated browser session so that
  # rejected verifier/redirect checks are not conflated with replay.
  code_authorize wrong-verifier
  printf '%s' 'invalid-pkce-verifier-with-sufficient-length-0123456789' \
    > "$tmp/code-wrong-verifier-$version" ||
    error "Keycloak $version wrong-verifier fixture unavailable"
  code_wrong_verifier_http=$(code_exchange wrong-verifier \
    "$tmp/code-wrong-verifier-$version" \
    https://k04-client.example.invalid/oidc/callback \
    "$tmp/code-wrong-verifier-response-$version") ||
    error "Keycloak $version wrong PKCE verifier transport failed"
  [ "$code_wrong_verifier_http" = 400 ] &&
    jq -e '.error == "invalid_grant"' \
      "$tmp/code-wrong-verifier-response-$version" >/dev/null ||
    fail "Keycloak $version accepted wrong PKCE verifier ($code_wrong_verifier_http)"

  code_authorize wrong-redirect
  code_wrong_redirect_http=$(code_exchange wrong-redirect \
    "$tmp/code-verifier-$version-wrong-redirect" \
    https://k04-client.example.invalid/oidc/other \
    "$tmp/code-wrong-redirect-response-$version") ||
    error "Keycloak $version mismatched callback transport failed"
  [ "$code_wrong_redirect_http" = 400 ] &&
    jq -e '.error == "invalid_grant"' \
      "$tmp/code-wrong-redirect-response-$version" >/dev/null ||
    fail "Keycloak $version redeemed authorization code with other redirect ($code_wrong_redirect_http)"

  # The client's configured PKCE S256 policy must deny an authorization
  # request without its challenge before issuing any interactive login.
  code_missing_challenge_http=$(transport --get \
    --output "$tmp/code-missing-challenge-$version" \
    --dump-header "$tmp/code-missing-challenge-headers-$version" \
    --write-out '%{http_code}' \
    --data-urlencode 'response_type=code' \
    --data-urlencode 'scope=openid' \
    --data-urlencode 'client_id=k04-code-client' \
    --data-urlencode 'redirect_uri=https://k04-client.example.invalid/oidc/callback' \
    --data-urlencode 'state=k04-missing-challenge' \
    --url "$base/realms/master/protocol/openid-connect/auth") ||
    error "Keycloak $version PKCE omission transport failed"
  [ "$code_missing_challenge_http" = 302 ] &&
    python3 "$tmp/code-browser.py" error-redirect \
      "$tmp/code-missing-challenge-headers-$version" \
      https://k04-client.example.invalid/oidc/callback \
      k04-missing-challenge ||
    fail "Keycloak $version did not deny PKCE-less authorization with a code-free OAuth error redirect ($code_missing_challenge_http)"
  printf '%s: Keycloak %s real authorization-code browser session, state, S256, replay, redirect and user permission boundary verified\n' \
    "$TEST_ID" "$version"

  # RFC 7523 authorization grant: separate trust/client/linked-user path.
  # Do not credit federated client-authentication success to this grant.
  jag_idp_code=$(transport --output "$tmp/jag-idp-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-idp.json" \
    --url "$base/admin/realms/master/identity-provider/instances") ||
    error "Keycloak $version JWT grant IdP registration transport failed"
  [ "$jag_idp_code" = 201 ] ||
    fail "Keycloak $version JWT grant IdP registration HTTP $jag_idp_code"
  for jag_client in jag-client jag-denied-client
  do
    jag_client_code=$(transport \
      --output "$tmp/$jag_client-response-$version" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/$jag_client.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $jag_client registration transport failed"
    [ "$jag_client_code" = 201 ] ||
      fail "Keycloak $version $jag_client registration HTTP $jag_client_code"
  done
  jag_user_code=$(transport --output "$tmp/jag-user-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-user.json" \
    --url "$base/admin/realms/master/users") ||
    error "Keycloak $version JWT grant local user registration transport failed"
  [ "$jag_user_code" = 201 ] ||
    fail "Keycloak $version JWT grant local user registration HTTP $jag_user_code"
  jag_user_lookup=$(transport --output "$tmp/jag-users-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/users?username=k04-jag-local-user&exact=true") ||
    error "Keycloak $version JWT grant local user lookup transport failed"
  [ "$jag_user_lookup" = 200 ] ||
    fail "Keycloak $version JWT grant local user lookup HTTP $jag_user_lookup"
  jag_user_uuid=$(jq -er '.[] | select(.username == "k04-jag-local-user") | .id' \
    "$tmp/jag-users-$version") ||
    fail "Keycloak $version JWT grant local user UUID unavailable"
  jq -n '{identityProvider:"k04-jag-idp",userId:"k04-jag-external-user",userName:"k04-jag-external-user"}' \
    > "$tmp/jag-link.json" ||
    error "Keycloak $version JWT grant user link fixture unavailable"
  jag_link_code=$(transport --output "$tmp/jag-link-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-link.json" \
    --url "$base/admin/realms/master/users/$jag_user_uuid/federated-identity/k04-jag-idp") ||
    error "Keycloak $version JWT grant user federation link transport failed"
  [ "$jag_link_code" = 204 ] ||
    fail "Keycloak $version JWT grant external subject link HTTP $jag_link_code"

  python3 "$tmp/sign-federated-jwt.py" "$jag_issuer" \
    k04-jag-external-user "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/jag-valid-$version" ||
    error "Keycloak $version JWT authorization grant assertion signing failed"
  jag_grant_http=$(jag_token_request "$tmp/jag-valid-$version" \
    "$tmp/jag-token-$version" "$base" k04-jag-client) ||
    error "Keycloak $version JWT authorization grant token transport failed"
  [ "$jag_grant_http" = 200 ] &&
    jq -e '(.access_token | type == "string" and length > 0) and
      (has("refresh_token") | not)' "$tmp/jag-token-$version" >/dev/null ||
    fail "Keycloak $version linked-user RFC7523 grant unsuccessful ($jag_grant_http)"
  # The local token must identify the linked user, not silently grant an
  # administrative service-account principal.
  python3 - "$tmp/jag-token-$version" "$jag_user_uuid" <<'JAG_CLAIMS'
import base64
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    token = json.load(source)["access_token"]
part = token.split(".")[1]
claims = json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
if claims.get("sub") != sys.argv[2]:
    raise SystemExit("JWT grant returned wrong local user")
JAG_CLAIMS

  # Exercise the public K04 acquisition path against the same real,
  # independently enabled RFC 7523 grant. A newly signed assertion is used
  # because the earlier direct request already consumed its own assertion.
  python3 "$tmp/sign-federated-jwt.py" "$jag_issuer" \
    k04-jag-external-user "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/jag-rsudo-$version" ||
    error "Keycloak $version public JWT grant assertion signing failed"
  jag_rsudo=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode jwt-bearer --client-id k04-jag-client \
    --client-auth client-secret-post --client-secret-file "$tmp/secret" \
    --assertion-file "$tmp/jag-rsudo-$version" \
    --token-store "$tmp/token-jag-rsudo-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  jag_rsudo_status=$?
  [ "$jag_rsudo_status" -eq 0 ] &&
    printf '%s\n' "$jag_rsudo" | jq -e \
      '.stored == true and .grant == "urn:ietf:params:oauth:grant-type:jwt-bearer"' >/dev/null &&
    jq -e '(.access_token | type == "string" and length > 0) and
      (has("refresh_token") | not)' "$tmp/token-jag-rsudo-$version" >/dev/null ||
    fail "Keycloak $version public JWT authorization grant acquisition failed ($jag_rsudo_status)"
  result=$(probe status --token-file "$tmp/token-jag-rsudo-$version" 2>"$tmp/auth.err")
  [ "$?" -eq 0 ] && [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version RFC7523 protected store offline status failed"
  cp "$tmp/token-jag-rsudo-$version" "$tmp/jag-rsudo-before-replay-$version" ||
    error "Keycloak $version RFC7523 store snapshot failed"
  jag_repeat=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode jwt-bearer --client-id k04-jag-client \
    --client-auth client-secret-post --client-secret-file "$tmp/secret" \
    --assertion-file "$tmp/jag-rsudo-$version" \
    --token-store "$tmp/token-jag-replay-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  jag_repeat_status=$?
  [ "$jag_repeat_status" -eq 72 ] && [ -z "$jag_repeat" ] &&
    [ ! -e "$tmp/token-jag-replay-$version" ] &&
    cmp -s "$tmp/token-jag-rsudo-$version" "$tmp/jag-rsudo-before-replay-$version" ||
    fail "Keycloak $version public JWT grant replay was not rejected safely ($jag_repeat_status)"
  printf 'not-a-compact-jwt\n' > "$tmp/jag-malformed-$version"
  jag_malformed=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode jwt-bearer --client-id k04-jag-client \
    --client-auth client-secret-post --client-secret-file "$tmp/secret" \
    --assertion-file "$tmp/jag-malformed-$version" \
    --token-store "$tmp/token-jag-malformed-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  jag_malformed_status=$?
  [ "$jag_malformed_status" -eq 70 ] && [ -z "$jag_malformed" ] &&
    [ ! -e "$tmp/token-jag-malformed-$version" ] ||
    fail "Keycloak $version malformed JWT grant assertion was accepted ($jag_malformed_status)"
  jag_bad_user=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode jwt-bearer --client-id k04-jag-client \
    --client-auth client-secret-post --client-secret-file "$tmp/secret" \
    --username forbidden-user --assertion-file "$tmp/jag-rsudo-$version" \
    --token-store "$tmp/token-jag-bad-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  jag_bad_user_status=$?
  [ "$jag_bad_user_status" -eq 64 ] && [ -z "$jag_bad_user" ] &&
    [ ! -e "$tmp/token-jag-bad-user-$version" ] ||
    fail "Keycloak $version RFC7523 accepted a redundant local username ($jag_bad_user_status)"
  jag_bad_method=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode jwt-bearer --client-id k04-jag-client \
    --client-auth federated-jwt --assertion-file "$tmp/jag-rsudo-$version" \
    --token-store "$tmp/token-jag-bad-method-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  jag_bad_method_status=$?
  [ "$jag_bad_method_status" -eq 73 ] && [ -z "$jag_bad_method" ] &&
    [ ! -e "$tmp/token-jag-bad-method-$version" ] ||
    fail "Keycloak $version RFC7523 incorrectly reused the client assertion ($jag_bad_method_status)"
  for sensitive in k04-protected-client-secret k04-jag-external-user
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version JWT grant diagnostics disclosed protected material"
  done

  # A one-use assertion must not be accepted on replay.
  jag_replay_http=$(jag_token_request "$tmp/jag-valid-$version" \
    "$tmp/jag-replay-$version" "$base" k04-jag-client) ||
    error "Keycloak $version JWT grant replay transport failed"
  case "$jag_replay_http" in 400|401) : ;; *)
    fail "Keycloak $version JWT grant accepted replay ($jag_replay_http)" ;;
  esac
  # Client authorization is separate from validity of the signed grant.
  python3 "$tmp/sign-federated-jwt.py" "$jag_issuer" \
    k04-jag-external-user "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/jag-denied-$version" ||
    error "Keycloak $version unauthorized-client grant assertion unavailable"
  jag_denied_http=$(jag_token_request "$tmp/jag-denied-$version" \
    "$tmp/jag-denied-response-$version" "$base" k04-jag-denied) ||
    error "Keycloak $version JWT grant unauthorized-client transport failed"
  case "$jag_denied_http" in 400|401|403) : ;; *)
    fail "Keycloak $version unauthorized client received JWT grant ($jag_denied_http)" ;;
  esac
  for jag_negative in wrong-key wrong-audience expired unknown-subject
  do
    jag_key=$tmp/federated-issuer.key
    jag_audience=$base/realms/master
    jag_subject=k04-jag-external-user
    jag_expiry=180
    case "$jag_negative" in
      wrong-key) jag_key=$tmp/federated-untrusted.key ;;
      wrong-audience) jag_audience=https://unrelated-relying-party.invalid ;;
      expired) jag_expiry=-30 ;;
      unknown-subject) jag_subject=k04-jag-unlinked-user ;;
    esac
    python3 "$tmp/sign-federated-jwt.py" "$jag_issuer" \
      "$jag_subject" "$jag_audience" "$jag_key" \
      "$tmp/jag-$jag_negative-$version" "$jag_expiry" ||
      error "Keycloak $version JWT grant $jag_negative assertion unavailable"
    jag_negative_http=$(jag_token_request "$tmp/jag-$jag_negative-$version" \
      "$tmp/jag-$jag_negative-response-$version" "$base" k04-jag-client) ||
      error "Keycloak $version JWT grant $jag_negative transport failed"
    case "$jag_negative_http" in 400|401|403) : ;; *)
      fail "Keycloak $version accepted JWT grant $jag_negative ($jag_negative_http)" ;;
    esac
    jq -e '.error | type == "string" and length > 0' \
      "$tmp/jag-$jag_negative-response-$version" >/dev/null ||
      fail "Keycloak $version JWT grant $jag_negative omitted OAuth error"
  done
  printf '%s: Keycloak %s RFC7523 linked user grant, replay, audience, signature and client boundaries verified\n' \
    "$TEST_ID" "$version"

  # Exercise the actual public K04 module through the m/rsudo entrypoint
  # with a new, short-lived externally signed assertion in a private file.
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-rsudo-$version" ||
    error "Keycloak $version rsudo federated assertion creation failed"
  printf '\n' >> "$tmp/federated-rsudo-$version"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file "$tmp/federated-rsudo-$version" \
    --token-store "$tmp/token-federated-rsudo-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
    jq -e '.access_token | type == "string" and length > 0' \
      "$tmp/token-federated-rsudo-$version" >/dev/null ||
    fail "Keycloak $version public K04 federated acquisition failed ($status)"
  result=$(probe status --token-file "$tmp/token-federated-rsudo-$version" \
    2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version federated protected-store offline status failed ($status)"

  # Online lifecycle requires a distinct current assertion per request; the
  # module must neither reuse the acquisition assertion nor replace the store.
  cp "$tmp/token-federated-rsudo-$version" \
    "$tmp/federated-store-before-lifecycle-$version" ||
    error "Keycloak $version federated token store snapshot failed"
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-status-assertion-$version" ||
    error "Keycloak $version K04 federated status assertion creation failed"
  result=$(probe status --server "$base" --issuer-realm master \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file "$tmp/federated-status-assertion-$version" \
    --token-file "$tmp/token-federated-rsudo-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" | jq -e \
      '.stored == true and .server_validated == true and .active == true' \
      >/dev/null &&
    cmp -s "$tmp/token-federated-rsudo-$version" \
      "$tmp/federated-store-before-lifecycle-$version" ||
    fail "Keycloak $version K04 federated online status failed or changed store ($status)"

  # Explicit re-use is subject to Keycloak's default one-use server policy;
  # denial must not touch the existing protected token record.
  result=$(probe status --server "$base" --issuer-realm master \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file "$tmp/federated-status-assertion-$version" \
    --token-file "$tmp/token-federated-rsudo-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    cmp -s "$tmp/token-federated-rsudo-$version" \
      "$tmp/federated-store-before-lifecycle-$version" ||
    fail "Keycloak $version K04 federated status assertion replay accepted ($status)"

  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-issuer.key" "$tmp/federated-revoke-rsudo-$version" ||
    error "Keycloak $version K04 federated revocation assertion creation failed"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file "$tmp/federated-revoke-rsudo-$version" \
    --token-file "$tmp/token-federated-rsudo-$version" \
    --token-type-hint access_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] &&
    cmp -s "$tmp/token-federated-rsudo-$version" \
      "$tmp/federated-store-before-lifecycle-$version" ||
    fail "Keycloak $version K04 federated revoke failed or changed store ($status)"

  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-federated --client-auth federated-jwt \
    --token-file "$tmp/token-federated-rsudo-$version" \
    --token-type-hint access_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] &&
    cmp -s "$tmp/token-federated-rsudo-$version" \
      "$tmp/federated-store-before-lifecycle-$version" ||
    fail "Keycloak $version K04 federated revoke lacked mandatory fresh assertion ($status)"
  printf '%s: Keycloak %s K04 federated online introspection and explicit revocation with fresh assertion verified\n' \
    "$TEST_ID" "$version"

  printf 'not.a.valid.jwt\n' > "$tmp/federated-malformed-$version"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file "$tmp/federated-malformed-$version" \
    --token-store "$tmp/token-federated-malformed-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-federated-malformed-$version" ] ||
    fail "Keycloak $version malformed federated assertion accepted ($status)"

  cp "$tmp/federated-rsudo-$version" "$tmp/federated-insecure-$version" ||
    error "Keycloak $version cannot prepare insecure assertion fixture"
  chmod 644 "$tmp/federated-insecure-$version" ||
    error "Keycloak $version cannot mark assertion fixture insecure"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file "$tmp/federated-insecure-$version" \
    --token-store "$tmp/token-federated-insecure-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-federated-insecure-$version" ] ||
    fail "Keycloak $version insecure federated assertion accepted ($status)"

  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external "$base/realms/master" \
    "$tmp/federated-untrusted.key" "$tmp/federated-rsudo-untrusted-$version" ||
    error "Keycloak $version rsudo untrusted assertion creation failed"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file "$tmp/federated-rsudo-untrusted-$version" \
    --token-store "$tmp/token-federated-untrusted-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-federated-untrusted-$version" ] ||
    fail "Keycloak $version rsudo accepted untrusted federated issuer ($status)"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/bootstrap-password" \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file "$tmp/federated-rsudo-$version" \
    --token-store "$tmp/token-federated-password-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 73 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-federated-password-$version" ] ||
    fail "Keycloak $version unsupported federated password grant accepted ($status)"
  printf '%s: Keycloak %s rsudo protected federated client acquisition and local rejection verified\n' \
    "$TEST_ID" "$version"


  # The actual TLS handshake validates the certificate against Keycloak's
  # dedicated CA. The client-x509 authenticator then verifies the exact
  # client subject DN and configured trust-anchor CA subject DN.
  mtls_create_http=$(transport --output "$tmp/mtls-create-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-mtls.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version client-x509 registration transport failed"
  [ "$mtls_create_http" = 201 ] ||
    fail "Keycloak $version client-x509 registration failed ($mtls_create_http)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-mtls \
    --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --token-store "$tmp/token-mtls-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
    jq -e '.access_token | type == "string" and length > 0' \
      "$tmp/token-mtls-$version" >/dev/null ||
    fail "Keycloak $version certificate-authenticated grant failed ($status)"
  python3 "$tmp/verify-mtls-token.py" "$tmp/token-mtls-$version" \
    "$tmp/mtls-good.pem" ||
    fail "Keycloak $version service access token missing matching cnf.x5t#S256"
  result=$(probe status --server "$base" --issuer-realm master \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --token-file "$tmp/token-mtls-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version mTLS client introspection failed ($status)"
  # The private K04 fixed Admin GET uses the actual Keycloak TLS listener and
  # presents the same client certificate while preserving resource permission
  # separation. This service account has no Admin realm role: expect 403.
  result=$(probe admin-probe --server "$base" --issuer-realm master \
    --target-realm master --token-file "$tmp/token-mtls-$version" \
    --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 80 ] && [ -z "$result" ] ||
    fail "Keycloak $version fixed Admin mTLS GET did not preserve 403 ($status)"
  result=$(probe admin-probe --server "$base" --issuer-realm master \
    --target-realm master --token-file "$tmp/token-mtls-$version" \
    --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-wrong.pem" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] ||
    fail "Keycloak $version fixed Admin mTLS GET accepted mismatched key ($status)"
  # Same explicitly selected X509 client runs a user password grant,
  # refresh and explicit refresh-token revocation. No JWT/secret fallback.
  printf 'k04-bootstrap-only\n' > "$tmp/mtls-user-password"
  chmod 600 "$tmp/mtls-user-password" ||
    error 'mTLS user password fixture is insecure'
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/mtls-user-password" \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --token-store "$tmp/token-mtls-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] &&
    jq -e '.refresh_token | type == "string" and length > 0' \
      "$tmp/token-mtls-user-$version" >/dev/null ||
    fail "Keycloak $version mTLS user direct grant failed ($status)"
  python3 "$tmp/verify-mtls-token.py" "$tmp/token-mtls-user-$version" \
    "$tmp/mtls-good.pem" ||
    fail "Keycloak $version user access token missing matching cnf.x5t#S256"

  # This authenticated admin user's token is deliberately held constant for
  # all three requests; only the TLS client certificate changes. The results
  # are release-specific provider observations, NOT a K04 Admin REST
  # sender-constraint guarantee. Never print bearer headers or token bodies.
  jq -er '"Authorization: Bearer " + .access_token' \
    "$tmp/token-mtls-user-$version" > "$tmp/mtls-admin-header" ||
    error "Keycloak $version cannot prepare private admin-token header"
  matched_http=$(transport --cert "$tmp/mtls-good.pem" \
    --key "$tmp/mtls-good.key" --header "@$tmp/mtls-admin-header" \
    --output "$tmp/mtls-matched-admin-body" --write-out '%{http_code}' \
    --url "$base/admin/realms/master") ||
    error "Keycloak $version matched certificate Admin REST HTTP transport failed"
  [ "$matched_http" = 200 ] ||
    fail "Keycloak $version matched-certificate administrator GET denied ($matched_http)"
  absent_http=$(transport --header "@$tmp/mtls-admin-header" \
    --output "$tmp/mtls-absent-admin-body" --write-out '%{http_code}' \
    --url "$base/admin/realms/master") ||
    error "Keycloak $version absent certificate Admin REST HTTP transport failed"
  wrong_http=$(transport --cert "$tmp/mtls-wrong.pem" \
    --key "$tmp/mtls-wrong.key" --header "@$tmp/mtls-admin-header" \
    --output "$tmp/mtls-wrong-admin-body" --write-out '%{http_code}' \
    --url "$base/admin/realms/master") ||
    error "Keycloak $version wrong certificate Admin REST HTTP transport failed"
  printf '%s: Keycloak %s certificate-bound Admin REST observations: matching=%s absent=%s wrong=%s\n' \
    "$TEST_ID" "$version" "$matched_http" "$absent_http" "$wrong_http"
  case "$absent_http/$wrong_http" in
    200/200|200/401|200/403|401/200|403/200|401/401|401/403|403/401|403/403) : ;;
    *) fail "Keycloak $version unexpected Admin REST replay outcomes ($absent_http/$wrong_http)" ;;
  esac
  if [ "$absent_http" = 200 ] || [ "$wrong_http" = 200 ]
  then
    printf '%s: Keycloak %s Admin REST did not enforce the certificate-bound token on the observed request\n' \
      "$TEST_ID" "$version"
  fi

  # Keycloak documents mTLS holder-of-key checks for UserInfo. An OIDC
  # positive control needs an explicitly requested openid scope; K04 does
  # not yet provide the public scope selector. Make a separate, private
  # provider-level grant, preserving the prior identical-token Admin probe.
  userinfo_grant_code=$(transport --cert "$tmp/mtls-good.pem" \
    --key "$tmp/mtls-good.key" \
    --data-urlencode grant_type=password \
    --data-urlencode client_id=k04-mtls \
    --data-urlencode username=k04admin \
    --data-urlencode "password@$tmp/bootstrap-password" \
    --data-urlencode scope=openid \
    --output "$tmp/userinfo-grant-$version" --write-out '%{http_code}' \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version OIDC userinfo-control grant transport failed"
  [ "$userinfo_grant_code" = 200 ] ||
    fail "Keycloak $version OIDC userinfo-control grant denied ($userinfo_grant_code)"
  python3 "$tmp/verify-mtls-token.py" "$tmp/userinfo-grant-$version" \
    "$tmp/mtls-good.pem" ||
    fail "Keycloak $version OIDC UserInfo control token lacks matched cnf"
  jq -er '"Authorization: Bearer " + .access_token' \
    "$tmp/userinfo-grant-$version" > "$tmp/mtls-userinfo-header" ||
    error "Keycloak $version cannot prepare protected UserInfo header"
  userinfo_url=$base/realms/master/protocol/openid-connect/userinfo
  userinfo_matched=$(transport --cert "$tmp/mtls-good.pem" \
    --key "$tmp/mtls-good.key" --header "@$tmp/mtls-userinfo-header" \
    --output "$tmp/mtls-matched-userinfo" --write-out '%{http_code}' \
    --url "$userinfo_url") ||
    error "Keycloak $version matching-certificate UserInfo transport failed"
  userinfo_absent=$(transport --header "@$tmp/mtls-userinfo-header" \
    --output "$tmp/mtls-absent-userinfo" --write-out '%{http_code}' \
    --url "$userinfo_url") ||
    error "Keycloak $version missing-certificate UserInfo transport failed"
  userinfo_wrong=$(transport --cert "$tmp/mtls-wrong.pem" \
    --key "$tmp/mtls-wrong.key" --header "@$tmp/mtls-userinfo-header" \
    --output "$tmp/mtls-wrong-userinfo" --write-out '%{http_code}' \
    --url "$userinfo_url") ||
    error "Keycloak $version wrong-certificate UserInfo transport failed"
  printf '%s: Keycloak %s certificate-bound UserInfo observations: matching=%s absent=%s wrong=%s\n' \
    "$TEST_ID" "$version" "$userinfo_matched" "$userinfo_absent" "$userinfo_wrong"
  [ "$userinfo_matched" = 200 ] &&
    { [ "$userinfo_absent" = 401 ] || [ "$userinfo_absent" = 403 ]; } &&
    { [ "$userinfo_wrong" = 401 ] || [ "$userinfo_wrong" = 403 ]; } ||
    fail "Keycloak $version UserInfo holder-of-key enforcement absent or unexpected"

  # An incorrect but internally consistent client certificate must not
  # refresh the protected X509 session or replace its token store.
  cp "$tmp/token-mtls-user-$version" "$tmp/mtls-before-rejected-refresh-$version" ||
    error "Keycloak $version cannot snapshot X509 refresh store"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-wrong.key" \
    --certificate-file "$tmp/mtls-wrong.pem" \
    --token-file "$tmp/token-mtls-user-$version" \
    --token-store "$tmp/token-mtls-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    cmp -s "$tmp/token-mtls-user-$version" "$tmp/mtls-before-rejected-refresh-$version" &&
    [ ! -e "$tmp/token-mtls-user-$version.keycloak-refresh-lock" ] ||
    fail "Keycloak $version rejected X509 refresh changed store or status ($status)"

  # Independently verify that an uncredentialed direct token-endpoint
  # refresh cannot use this protected refresh token. Keep bytes off argv.
  jq -jr '.refresh_token' "$tmp/token-mtls-user-$version" \
    > "$tmp/mtls-refresh-value-$version" ||
    error "Keycloak $version protected refresh token unavailable"
  absent_refresh_http=$(transport \
    --data-urlencode grant_type=refresh_token \
    --data-urlencode client_id=k04-mtls \
    --data-urlencode "refresh_token@$tmp/mtls-refresh-value-$version" \
    --output "$tmp/mtls-absent-refresh-response-$version" \
    --write-out '%{http_code}' \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version direct missing-certificate refresh transport failed"
  case "$absent_refresh_http" in
    400|401) : ;;
    *) fail "Keycloak $version accepted unauthenticated bound-token refresh ($absent_refresh_http)" ;;
  esac
  jq -e '.error == "invalid_client"' \
    "$tmp/mtls-absent-refresh-response-$version" >/dev/null ||
    fail "Keycloak $version missing-certificate refresh did not reject client"

  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --token-file "$tmp/token-mtls-user-$version" \
    --token-store "$tmp/token-mtls-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version mTLS protected refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-good.pem" \
    --token-file "$tmp/token-mtls-user-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version mTLS protected revocation failed ($status)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-mtls \
    --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-wrong.key" \
    --certificate-file "$tmp/mtls-wrong.pem" \
    --token-store "$tmp/token-mtls-wrong-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-mtls-wrong-$version" ] ||
    fail "Keycloak $version accepted wrong mTLS client DN ($status)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-mtls \
    --client-auth tls-client-auth \
    --private-key-file "$tmp/mtls-good.key" \
    --certificate-file "$tmp/mtls-wrong.pem" \
    --token-store "$tmp/token-mtls-key-mismatch-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-mtls-key-mismatch-$version" ] ||
    fail "Keycloak $version accepted mismatched mTLS certificate/key ($status)"

  # Keycloak's Signed JWT client authenticator independently trusts the
  # public X509 cert configured for this one client. The signing key remains
  # a private file available only to the selected sudo test identity.
  rsa_client_http=$(transport --output "$tmp/rsa-client-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-rsa.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version private-key-jwt client provisioning failed"
  [ "$rsa_client_http" = 201 ] ||
    fail "Keycloak $version private-key-jwt client create HTTP $rsa_client_http"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-rs256 \
    --client-auth private-key-jwt --client-jwt-alg RS256 \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-store "$tmp/token-rsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version RS256 private-key acquire failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-rsa-$version" >/dev/null ||
    fail "Keycloak $version RS256 access token missing"
  result=$(probe status --token-file "$tmp/token-rsa-$version" \
    --server "$base" --issuer-realm master --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version RS256 introspection failed ($status)"
  # The RSA signing context is also used for explicit Direct Grant,
  # protected refresh and requested refresh-token revocation.
  printf 'k04-bootstrap-only\n' > "$tmp/rsa-password"
  chmod 600 "$tmp/rsa-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/rsa-password" --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-store "$tmp/rsa-password-store-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version private-key-jwt Direct Grant failed ($status)"
  jq -e '.refresh_token | type == "string" and length > 0' \
    "$tmp/rsa-password-store-$version" >/dev/null ||
    fail "Keycloak $version RSA direct token lacks refresh credentials"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-rs256 --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-file "$tmp/rsa-password-store-$version" \
    --token-store "$tmp/rsa-password-store-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version RSA signed refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-rs256 --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-file "$tmp/rsa-password-store-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version RSA signed revocation failed ($status)"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/wrong-client.key" \
    --certificate-file "$tmp/wrong-client.pem" \
    --token-store "$tmp/token-rsa-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-rsa-rejected-$version" ] ||
    fail "Keycloak $version unregistered RSA key was accepted ($status)"
  grep -F 'eyJhbGciOiJSUzI1Ni' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version RS256 client assertion exposed in diagnostics"

  # Keep the registered RSA certificate, but require the exact selected
  # RSA/PS signature algorithm. The two release targets independently verify the
  # signed assertions rather than trusting the local signature check alone.
  for algorithm in RS384 RS512 PS256 PS384 PS512
  do
    case "$algorithm" in
      RS384) rsa_id=k04-rs384 ;;
      RS512) rsa_id=k04-rs512 ;;
      PS256) rsa_id=k04-ps256 ;;
      PS384) rsa_id=k04-ps384 ;;
      PS512) rsa_id=k04-ps512 ;;
    esac
    jq --arg id "$rsa_id" --arg alg "$algorithm" \
      '.clientId = $id | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-rsa.json" > "$tmp/client-$algorithm.json" ||
      error "Keycloak $version cannot prepare $algorithm client"
    rsa_client_http=$(transport --output "$tmp/rsa-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm client provisioning transport failed"
    [ "$rsa_client_http" = 201 ] ||
      fail "Keycloak $version $algorithm client create HTTP $rsa_client_http"
    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --token-store "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
      jq -e '.access_token | type == "string" and length > 0' \
        "$tmp/token-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm private-key acquire failed ($status)"
    result=$(probe status --token-file "$tmp/token-$algorithm-$version" \
      --server "$base" --issuer-realm master --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version $algorithm introspection failed ($status)"
    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg RS256 \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --token-store "$tmp/token-wrong-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 71 ] && [ -z "$result" ] &&
      [ ! -e "$tmp/token-wrong-$algorithm-$version" ] ||
      fail "Keycloak $version $algorithm policy accepted wrong signature ($status)"

    if [ "$algorithm" = PS256 ]
    then
      # A PS-signed client must also work for authenticated direct grants,
      # protected refresh and explicit refresh-token revocation.
      result=$(probe acquire --server "$base" --issuer-realm master \
        --auth-mode password --username k04admin \
        --password-file "$tmp/rsa-password" --client-id "$rsa_id" \
        --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-store "$tmp/password-$algorithm-$version" \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] &&
        jq -e '.refresh_token | type == "string" and length > 0' \
          "$tmp/password-$algorithm-$version" >/dev/null ||
        fail "Keycloak $version $algorithm direct grant failed ($status)"
      result=$(probe refresh --server "$base" --issuer-realm master \
        --client-id "$rsa_id" --client-auth private-key-jwt \
        --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-file "$tmp/password-$algorithm-$version" \
        --token-store "$tmp/password-$algorithm-$version" \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
        fail "Keycloak $version $algorithm refresh failed ($status)"
      result=$(probe revoke --server "$base" --issuer-realm master \
        --client-id "$rsa_id" --client-auth private-key-jwt \
        --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-file "$tmp/password-$algorithm-$version" \
        --token-type-hint refresh_token \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
        fail "Keycloak $version $algorithm revocation failed ($status)"
    fi
  done

  # Keycloak verifies actual ECDSA JWS assertions and each registered
  # per-client certificate, independently of the local OpenSSL check.
  for algorithm in ES256 ES384 ES512
  do
    ec_id=k04-$(printf '%s' "$algorithm" | tr '[:upper:]' '[:lower:]')
    ec_client_http=$(transport --output "$tmp/ec-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm EC client registration transport failed"
    [ "$ec_client_http" = 201 ] ||
      fail "Keycloak $version $algorithm EC client registration rejected ($ec_client_http)"
    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$ec_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-$algorithm.key" \
      --certificate-file "$tmp/private-$algorithm.pem" \
      --token-store "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
      jq -e '.access_token | type == "string" and length > 0' \
        "$tmp/token-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm ECDSA acquire failed ($status)"
    result=$(probe status --server "$base" --issuer-realm master \
      --client-id "$ec_id" --client-auth private-key-jwt \
      --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-$algorithm.key" \
      --certificate-file "$tmp/private-$algorithm.pem" \
      --token-file "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version $algorithm ECDSA introspection failed ($status)"

    if [ "$algorithm" = ES256 ]
    then
      result=$(probe acquire --server "$base" --issuer-realm master \
        --auth-mode client-credentials --client-id "$ec_id" \
        --client-auth private-key-jwt --client-jwt-alg ES256 \
        --private-key-file "$tmp/wrong-ES256.key" \
        --certificate-file "$tmp/wrong-ES256.pem" \
        --token-store "$tmp/token-wrong-ec-$version" \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 71 ] && [ -z "$result" ] &&
        [ ! -e "$tmp/token-wrong-ec-$version" ] ||
        fail "Keycloak $version accepted unregistered ECDSA certificate ($status)"
    fi
  done

  # Register and authenticate the Ed25519 Signed JWT client using Keycloak's
  # actual EdDSA verifier, with no RSA/EC or secret-authenticator fallback.
  eddsa_code=$(transport --output "$tmp/eddsa-client-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-eddsa.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version EdDSA client registration transport failed"
  [ "$eddsa_code" = 201 ] ||
    fail "Keycloak $version EdDSA client registration rejected ($eddsa_code)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-eddsa \
    --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-store "$tmp/token-eddsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
    jq -e '.access_token | type == "string" and length > 0' \
      "$tmp/token-eddsa-$version" >/dev/null ||
    fail "Keycloak $version Ed25519 client acquisition failed ($status)"
  result=$(probe status --server "$base" --issuer-realm master \
    --client-id k04-eddsa --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-file "$tmp/token-eddsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version Ed25519 introspection failed ($status)"
  # Ed25519 is also used for an explicitly selected confidential user
  # grant and protected refresh/revocation lifecycle, not just acquisition.
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin --password-file "$tmp/rsa-password" \
    --client-id k04-eddsa --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-store "$tmp/password-eddsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] &&
    jq -e '.refresh_token | type == "string" and length > 0' \
      "$tmp/password-eddsa-$version" >/dev/null ||
    fail "Keycloak $version Ed25519 direct user grant failed ($status)"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-eddsa --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-file "$tmp/password-eddsa-$version" \
    --token-store "$tmp/password-eddsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version Ed25519 protected refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-eddsa --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-file "$tmp/password-eddsa-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version Ed25519 token revocation failed ($status)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-eddsa \
    --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/wrong-eddsa.key" \
    --certificate-file "$tmp/wrong-eddsa.pem" \
    --token-store "$tmp/token-unregistered-eddsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-unregistered-eddsa-$version" ] ||
    fail "Keycloak $version accepted unregistered Ed25519 certificate ($status)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-eddsa \
    --client-auth private-key-jwt --client-jwt-alg EdDSA \
    --private-key-file "$tmp/private-ed448.key" \
    --certificate-file "$tmp/private-ed448.pem" \
    --token-store "$tmp/token-ed448-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 73 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-ed448-rejected-$version" ] ||
    fail "Keycloak $version EdDSA selected an Ed448 key ($status)"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-eddsa \
    --client-auth private-key-jwt --client-jwt-alg RS256 \
    --private-key-file "$tmp/private-eddsa.key" \
    --certificate-file "$tmp/private-eddsa.pem" \
    --token-store "$tmp/token-eddsa-rsa-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 73 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-eddsa-rsa-rejected-$version" ] ||
    fail "Keycloak $version Ed25519 accepted RSA JOSE algorithm ($status)"

  # Signed JWT with confidential client secret is an independently selected
  # Keycloak authenticator, not a fallback from Basic or POST.
  jwt_client_http=$(transport --output "$tmp/jwt-client-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-jwt.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version client-secret-jwt client provisioning failed"
  [ "$jwt_client_http" = 201 ] ||
    fail "Keycloak $version client-secret-jwt client create HTTP $jwt_client_http"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-signed \
    --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-jwt-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version client-secret-jwt token acquisition failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-jwt-$version" >/dev/null ||
    fail "Keycloak $version HS256 session record missing access token"
  result=$(probe status --token-file "$tmp/token-jwt-$version" \
    --server "$base" --issuer-realm master --client-id k04-signed \
    --client-auth client-secret-jwt --client-secret-file "$tmp/secret" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version HS256 authenticated introspection failed ($status)"
  grep -F 'k04-protected-client-secret' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version HS256 secret leaked to diagnostics"

  # The selected algorithm must match each client's Keycloak signing policy.
  # This is a genuine Keycloak-client configuration test, not just an
  # independently generated JWT syntax test.
  for algorithm in HS384 HS512
  do
    case "$algorithm" in
      HS384) signed_id=k04-signed-hs384 ;;
      HS512) signed_id=k04-signed-hs512 ;;
    esac
    jq --arg cid "$signed_id" --arg alg "$algorithm" \
      '.clientId = $cid | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-jwt.json" > "$tmp/client-$algorithm.json" ||
      error "Keycloak $version cannot prepare $algorithm client fixture"
    http=$(transport --output "$tmp/create-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm client provision transport failed"
    [ "$http" = 201 ] ||
      fail "Keycloak $version $algorithm client provision rejected ($http)"

    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg "$algorithm" \
      --client-secret-file "$tmp/secret" \
      --token-store "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
      jq -e '.access_token | type == "string" and length > 0' \
        "$tmp/token-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm token acquire failed ($status)"

    result=$(probe status --token-file "$tmp/token-$algorithm-$version" \
      --server "$base" --issuer-realm master --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg "$algorithm" \
      --client-secret-file "$tmp/secret" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version $algorithm introspection failed ($status)"

    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg HS256 \
      --client-secret-file "$tmp/secret" \
      --token-store "$tmp/mismatch-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 71 ] && [ -z "$result" ] &&
      [ ! -e "$tmp/mismatch-$algorithm-$version" ] ||
      fail "Keycloak $version wrong $algorithm signing mode was accepted ($status)"
  done

  # The same HS256 authenticator must also handle a user Direct Grant,
  # protected refresh rotation and explicit refresh-token revocation.
  printf 'k04-bootstrap-only\n' > "$tmp/jwt-user-password"
  chmod 600 "$tmp/jwt-user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/jwt-user-password" \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/jwt-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version HS256 user Direct Grant failed ($status)"
  jq -e '(.refresh_token | type == "string" and length > 0)' \
    "$tmp/jwt-user-$version" >/dev/null ||
    fail "Keycloak $version HS256 Direct Grant refresh token absent"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/jwt-user-$version" \
    --token-store "$tmp/jwt-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version HS256 Direct Grant refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/jwt-user-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version HS256 refresh-token revoke failed ($status)"
  grep -F 'k04-protected-client-secret' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version HS256 lifecycle leaked secret in diagnostics"

  # A separate target realm gives a real master-issued, target-scoped
  # delegated authority test. Keycloak creates a target-realm management
  # client in master, rather than using realm-management for master itself.
  printf '%s\n' '{"realm":"k04-target","enabled":true}' > "$tmp/target-realm.json"
  new_realm_code=$(transport --output "$tmp/new-realm-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/target-realm.json" \
    --url "$base/admin/realms") ||
    error "Keycloak $version target realm creation failed"
  [ "$new_realm_code" = 201 ] ||
    fail "Keycloak $version target realm create HTTP $new_realm_code"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-basic-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  if [ "$status" -ne 0 ]
  then
    tail -n 7 "$tmp/auth.err" >&2
    fail "Keycloak $version Basic authentication failed ($status)"
  fi
  [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version Basic acquisition status malformed"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-basic-$version" >/dev/null ||
    fail "Keycloak $version Basic token store invalid"

  result=$(probe status --token-file "$tmp/token-basic-$version" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] && [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version token-store status did not retain non-introspection boundary"

  # Compare the public online status with an independent direct call to
  # the official introspection endpoint under the same client authority.
  # A compliant server can report active=false for policy/visibility reasons:
  # do not replace the actual server answer with an assumed true.
  jq -jr '.access_token' "$tmp/token-basic-$version" \
    > "$tmp/native-introspection-token" ||
    error "Keycloak $version native introspection input unavailable"
  native_basic=$(printf 'k04-service:k04-protected-client-secret' |
    base64 | tr -d '\r\n') ||
    error "Keycloak $version cannot create test-only Basic header"
  printf 'Authorization: Basic %s\n' "$native_basic" \
    > "$tmp/native-introspection-header"
  unset native_basic
  native_http=$(transport --output "$tmp/native-introspection-response" \
    --write-out '%{http_code}' \
    --header "@$tmp/native-introspection-header" \
    --data-urlencode "token@$tmp/native-introspection-token" \
    --data-urlencode 'token_type_hint=access_token' \
    --url "$base/realms/master/protocol/openid-connect/token/introspect") ||
    error "Keycloak $version native introspection transport failed"
  [ "$native_http" = 200 ] &&
    jq -e '(.active | type == "boolean")' \
      "$tmp/native-introspection-response" >/dev/null ||
    fail "Keycloak $version native introspection did not return active boolean"
  expected_active=$(jq -r '.active' "$tmp/native-introspection-response") ||
    error "Keycloak $version native active state unavailable"

  result=$(probe status --token-file "$tmp/token-basic-$version" \
    --server "$base" --issuer-realm master --client-id k04-service \
    --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = "{\"stored\":true,\"server_validated\":true,\"active\":$expected_active}" ] ||
    fail "Keycloak $version introspection differs from direct provider active=$expected_active ($status)"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-post-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] ||
    fail "Keycloak $version client secret POST authentication failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-post-$version" >/dev/null ||
    fail "Keycloak $version POST token store invalid"

  # Enabled confidential Direct Access Grant for the synthetic admin:
  # never pass the user password as an ordinary CLI operand.
  printf 'k04-bootstrap-only\n' > "$tmp/user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/user-password" --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version explicit confidential direct grant failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-user-$version" >/dev/null ||
    fail "Keycloak $version Direct Grant token missing"
  grep -F 'k04-bootstrap-only' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version user password leaked to diagnostics"

  printf 'k04-invalid-user-password\n' > "$tmp/user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/user-password" --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-user-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-user-rejected-$version" ] ||
    fail "Keycloak $version wrong Direct Grant password not rejected ($status)"

  # Authenticated OAuth client has no administrator role by default.
  # Access to global /admin/serverinfo must not be inferred from its token.
  client_token=$(jq -er '.access_token' "$tmp/token-basic-$version") ||
    error "Keycloak $version service token cannot be read by test"
  printf 'Authorization: Bearer %s\n' "$client_token" > "$tmp/client-header"
  unset client_token
  denied=$(transport --output "$tmp/forbidden-response" \
    --write-out '%{http_code}' --header "@$tmp/client-header" \
    --url "$base/admin/serverinfo") ||
    error "Keycloak $version admin permission boundary HTTP failed"
  [ "$denied" = 403 ] ||
    fail "Keycloak $version service account unexpectedly accessed serverinfo ($denied)"


  # Private K04 realm GET: an authenticated service account with no realm
  # management role must be denied, not misreported as success.
  admin_probe()
  {
    probe admin-probe --server "$base" --issuer-realm master \
      --target-realm "$2" --token-file "$1" \
      --ca-file "$tmp/image/server.pem"
  }
  result=$(admin_probe "$tmp/token-basic-$version" k04-target 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 80 ] && [ -z "$result" ] ||
    fail "Keycloak $version unauthorised service account Admin GET was not 403 ($status)"

  # Delegate only view-realm through Keycloak's actual Admin REST API.
  # The role belongs to realm-management's internal client UUID, not the
  # external clientId string and not an arbitrary assumed UUID.
  svc_clients_code=$(transport --output "$tmp/svc-clients" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients?clientId=k04-service") ||
    error "Keycloak $version service-client lookup failed"
  [ "$svc_clients_code" = 200 ] ||
    fail "Keycloak $version service-client lookup HTTP $svc_clients_code"
  svc_uuid=$(jq -er '.[] | select(.clientId == "k04-service") | .id' \
    "$tmp/svc-clients") ||
    fail "Keycloak $version service-client internal UUID not found"
  svc_user_code=$(transport --output "$tmp/svc-user" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients/$svc_uuid/service-account-user") ||
    error "Keycloak $version service-account user lookup failed"
  [ "$svc_user_code" = 200 ] ||
    fail "Keycloak $version service-account lookup HTTP $svc_user_code"
  svc_user=$(jq -er '.id' "$tmp/svc-user") ||
    fail "Keycloak $version service-account user UUID unavailable"
  management_code=$(transport --output "$tmp/mgmt-clients" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients?clientId=k04-target-realm") ||
    error "Keycloak $version realm-management lookup failed"
  [ "$management_code" = 200 ] ||
    fail "Keycloak $version realm-management lookup HTTP $management_code"
  mgmt_uuid=$(jq -er '.[] | select(.clientId == "k04-target-realm") | .id' \
    "$tmp/mgmt-clients") ||
    fail "Keycloak $version realm-management internal UUID unavailable"
  role_code=$(transport --output "$tmp/view-realm-role" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients/$mgmt_uuid/roles/view-realm") ||
    error "Keycloak $version view-realm lookup failed"
  [ "$role_code" = 200 ] ||
    fail "Keycloak $version view-realm lookup HTTP $role_code"
  jq -e -c '[.]' "$tmp/view-realm-role" > "$tmp/delegated-role" ||
    error "Keycloak $version cannot create delegated-role JSON"
  grant_code=$(transport --output "$tmp/role-grant-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/delegated-role" \
    --url "$base/admin/realms/master/users/$svc_user/role-mappings/clients/$mgmt_uuid") ||
    error "Keycloak $version role assignment request failed"
  [ "$grant_code" = 204 ] ||
    fail "Keycloak $version view-realm role grant rejected HTTP $grant_code"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-delegated-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] ||
    fail "Keycloak $version delegated-service token acquisition failed ($status)"
  result=$(admin_probe "$tmp/token-delegated-$version" k04-target 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"http_status":200,"authorized":true,"body_suppressed":true}' ] ||
    fail "Keycloak $version delegated view-realm Admin GET not authorized ($status)"

  # An opaque but syntactically valid rejected bearer must map to public 79,
  # not 403, and never trigger refresh or privilege escalation.
  printf '%s\n' '{"access_token":"K04-SYNTHETIC-INVALID-ACCESS-TOKEN"}' \
    > "$tmp/invalid-bearer-$version"
  chmod 600 "$tmp/invalid-bearer-$version"
  result=$(admin_probe "$tmp/invalid-bearer-$version" master 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 79 ] && [ -z "$result" ] ||
    fail "Keycloak $version invalid Admin bearer was not 401-class ($status)"
  for secret_marker in k04-protected-client-secret K04-SYNTHETIC-INVALID-ACCESS-TOKEN
  do
    grep -F "$secret_marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version private Admin Bearer diagnostic leaked credentials"
  done

  printf 'k04-incorrect-secret\n' > "$tmp/secret"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  if [ "$status" -ne 71 ]
  then
    # Diagnostic OAuth error *code only*, never raw token/error bodies:
    # determine the exact real provider classification before changing it.
    bad_basic=$(printf 'k04-service:k04-incorrect-secret' | base64 | tr -d '\r\n') ||
      error 'cannot encode synthetic negative client credentials'
    printf 'Authorization: Basic %s\n' "$bad_basic" > "$tmp/bad-basic-header"
    unset bad_basic
    bad_http=$(transport --output "$tmp/bad-json" \
      --write-out '%{http_code}' --header "@$tmp/bad-basic-header" \
      --data-urlencode grant_type=client_credentials \
      --url "$base/realms/master/protocol/openid-connect/token") ||
      error 'cannot inspect negative OAuth error'
    bad_error=$(jq -r '.error // "missing-error"' "$tmp/bad-json") ||
      error 'cannot parse negative OAuth error code'
    fail "Keycloak $version wrong-client-secret class=$status; HTTP=$bad_http; OAuth=$bad_error"
  fi
  [ ! -e "$tmp/token-rejected-$version" ] ||
    fail "Keycloak $version stored a token after rejecting credentials"
  printf 'k04-protected-client-secret\n' > "$tmp/secret"

  # K04 refresh through the real m invocation and official server.
  # The old store is copied for an exact no-change check on failures.
  # Keycloak can issue a refreshed token without requiring per-realm rotation
  # to be enabled: assert the protected replacement protocol, not an assumed
  # token-value difference across releases.
  refresh_store=$tmp/token-user-$version
  cp "$refresh_store" "$tmp/refresh-before-$version" ||
    error "Keycloak $version cannot snapshot private pre-refresh store"
  old_inode=$(ls -id "$refresh_store" | awk '{print $1}') ||
    error "Keycloak $version original refresh inode unavailable"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version real confidential refresh failed ($status)"
  jq -e '(.access_token | type == "string" and length > 0) and
    (.refresh_token | type == "string" and length > 0)' \
    "$refresh_store" >/dev/null ||
    fail "Keycloak $version refresh did not preserve usable token fields"
  mode=$(LC_ALL=C ls -ld "$refresh_store"); mode=${mode%% *}
  [ "$mode" = '-rw-------' ] ||
    fail "Keycloak $version refresh lost private mode"
  new_inode=$(ls -id "$refresh_store" | awk '{print $1}') ||
    error "Keycloak $version refreshed inode unavailable"
  [ "$new_inode" != "$old_inode" ] ||
    fail "Keycloak $version refresh did not replace the store atomically"
  [ ! -e "$refresh_store.keycloak-refresh-lock" ] ||
    fail "Keycloak $version successful refresh left lock behind"

  # Exercise POST client authentication on an already refreshed session.
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version client-secret-post refresh failed ($status)"

  # A held lock must fail without making a token HTTP request or rewriting
  # the existing record. This verifies cooperative serialization, not CAS
  # against arbitrary external writers.
  cp "$refresh_store" "$tmp/refresh-held-$version" ||
    error "Keycloak $version cannot snapshot locked store"
  mkdir "$refresh_store.keycloak-refresh-lock" ||
    error "Keycloak $version cannot create refresh contention fixture"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 87 ] && [ -z "$result" ] &&
    cmp -s "$refresh_store" "$tmp/refresh-held-$version" ||
    fail "Keycloak $version concurrent refresh bypassed exclusive lock ($status)"
  rmdir "$refresh_store.keycloak-refresh-lock" ||
    error "Keycloak $version cannot release test-owned lock"
  for sensitive in k04-protected-client-secret k04-bootstrap-only
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version refresh diagnostic leaked a secret"
  done

  # Real RFC 7009 revocation. A refresh token may also revoke this client's
  # consent. The store remains intact; HTTP 200 does NOT prove every already
  # issued JWT is unusable at all resource servers.
  jq -e '.refresh_token | type == "string" and length > 0' \
    "$tmp/token-user-$version" >/dev/null ||
    fail "Keycloak $version did not supply refresh token for Direct Grant"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/token-user-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version refresh revocation rejected ($status)"
  [ -f "$tmp/token-user-$version" ] ||
    fail "Keycloak $version revoke removed the protected source store"

  jq -jr '.refresh_token' "$tmp/token-user-$version" > "$tmp/refresh-probe" ||
    error "Keycloak $version test refresh extraction failed"
  client_basic=$(printf 'k04-service:k04-protected-client-secret' | base64 | tr -d '\r\n') ||
    error 'cannot create synthetic confidential test auth header'
  printf 'Authorization: Basic %s\n' "$client_basic" > "$tmp/refresh-client-header"
  unset client_basic
  refresh_code=$(transport --output "$tmp/refresh-response" \
    --write-out '%{http_code}' --header "@$tmp/refresh-client-header" \
    --data-urlencode grant_type=refresh_token \
    --data-urlencode "refresh_token@$tmp/refresh-probe" \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version refresh-after-revoke HTTP failed"
  [ "$refresh_code" = 400 ] &&
    jq -e '.error == "invalid_grant"' "$tmp/refresh-response" >/dev/null ||
    fail "Keycloak $version revoked refresh token unexpectedly accepted ($refresh_code)"

  # The public refresh call must classify revoked-token invalid_grant and
  # leave the protected session file byte-identical on failure.
  cp "$refresh_store" "$tmp/revoked-before-$version" ||
    error "Keycloak $version cannot snapshot revoked store"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] &&
    cmp -s "$refresh_store" "$tmp/revoked-before-$version" &&
    [ ! -e "$refresh_store.keycloak-refresh-lock" ] ||
    fail "Keycloak $version revoked refresh mutated store or had incorrect status ($status)"

  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/token-basic-$version" \
    --token-type-hint access_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version access revocation rejected ($status)"

  for sensitive in k04-protected-client-secret k04-bootstrap-only
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version revocation secret leaked to diagnostics"
  done

  printf '%s: verified real Keycloak %s OAuth basic/post and permission boundary\n' \
    "$TEST_ID" "$version"
  stop_keycloak
done
printf '%s\n' "$TEST_ID: PASS (two real Keycloak releases, HTTPS and OAuth; SSH replaced)"
