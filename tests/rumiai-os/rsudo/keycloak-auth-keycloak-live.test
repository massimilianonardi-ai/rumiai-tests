#!/bin/sh
# K04 real-server boundary: official Keycloak 26.7.3 and 26.8.1, TLS,
# client-credentials and permission separation. External SSH/sudo is replaced.
# All server state/credentials/images are disposable and isolated.
TEST_ID=rumiai-os/rsudo/keycloak-auth-keycloak-live.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}
cid= image_tag= tmp=
stop_keycloak()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  cid=
  [ -z "$image_tag" ] || docker image rm "$image_tag" >/dev/null 2>&1 || :
  image_tag=
}
cleanup()
{
  stop_keycloak
  [ -z "$tmp" ] || rm -rf "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unresolved'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'product checkout resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout not available' ;;
  2) fail 'selected product checkout invalid' ;;
  *) error 'product checkout discovery failed' ;;
esac
[ "$(uname -s)" = Linux ] || skip 'Linux/Docker real Keycloak boundary'
for cmd in docker curl jq openssl
do
  command -v "$cmd" >/dev/null 2>&1 || skip "$cmd required for live Keycloak test"
done

tmp=${TMPDIR:-/tmp}/keycloak-live-$$
umask 077
mkdir -p "$tmp/image" "$tmp/bin" || error 'fixture directory unavailable'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture path unavailable'
cat > "$tmp/openssl.cnf" <<'CERTCONF'
[req]
distinguished_name = dn
prompt = no
x509_extensions = ext
[dn]
CN = 127.0.0.1
[ext]
subjectAltName = IP:127.0.0.1
basicConstraints = critical,CA:TRUE
keyUsage = digitalSignature,keyCertSign
CERTCONF
openssl req -x509 -newkey rsa:2048 -nodes -config "$tmp/openssl.cnf" \
  -extensions ext -days 1 \
  -keyout "$tmp/image/server.key" -out "$tmp/image/server.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'test-only TLS issuer preparation failed'

openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=k04-private-jwt \
  -keyout "$tmp/private-client.key" -out "$tmp/private-client.pem" \
  >"$tmp/client-openssl.out" 2>"$tmp/client-openssl.err" ||
  error 'RSA private JWT keypair preparation failed'
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=k04-wrong-jwt \
  -keyout "$tmp/wrong-client.key" -out "$tmp/wrong-client.pem" \
  >"$tmp/client-openssl.out" 2>"$tmp/client-openssl.err" ||
  error 'RSA wrong client keypair preparation failed'
chmod 600 "$tmp/private-client.key" "$tmp/private-client.pem" \
  "$tmp/wrong-client.key" "$tmp/wrong-client.pem" ||
  error 'private client keypair permissions unavailable'

# Test credentials are synthetic; bootstrap password is passed through a
# Docker env-file and curl form-file, never through its command argument value.
printf 'KC_BOOTSTRAP_ADMIN_USERNAME=k04admin\nKC_BOOTSTRAP_ADMIN_PASSWORD=k04-bootstrap-only\n' \
  > "$tmp/bootstrap.env"
printf 'k04-bootstrap-only' > "$tmp/bootstrap-password"
printf 'k04-protected-client-secret\n' > "$tmp/secret"

cat > "$tmp/image/Dockerfile" <<'DOCKERFILE'
ARG KC_VERSION
FROM quay.io/keycloak/keycloak:${KC_VERSION}
COPY --chown=1000:0 --chmod=600 server.key /opt/keycloak/conf/k04-server.key
COPY --chown=1000:0 --chmod=644 server.pem /opt/keycloak/conf/k04-server.pem
DOCKERFILE
cat > "$tmp/client.json" <<'CLIENT_JSON'
{
  "clientId": "k04-service",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret",
  "secret": "k04-protected-client-secret"
}
CLIENT_JSON
cat > "$tmp/client-jwt.json" <<'CLIENT_JWT_JSON'
{
  "clientId": "k04-signed",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret-jwt",
  "secret": "k04-protected-client-secret",
  "attributes": {
    "token.endpoint.auth.signing.alg": "HS256"
  }
}
CLIENT_JWT_JSON
cat > "$tmp/client-rsa-base.json" <<'CLIENT_RSA_JSON'
{
  "clientId": "k04-rs256",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-jwt",
  "attributes": {"token.endpoint.auth.signing.alg": "RS256"}
}
CLIENT_RSA_JSON
cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
  "$tmp/private-client.pem" | tr -d '\r\n') ||
  error 'RSA public certificate encoding unavailable'
[ -n "$cert_body" ] || error 'RSA public certificate empty'
jq --arg cert "$cert_body" \
  '.attributes["jwt.credential.certificate"] = $cert' \
  "$tmp/client-rsa-base.json" > "$tmp/client-rsa.json" ||
  error 'RSA client configuration preparation failed'
unset cert_body

cat > "$tmp/bin/k04-keycloak-live-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 91
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 92
loadsyslib "rsudo/rsudo-mod-keycloak" || exit 93
rsudo()
{
  [ "$1" = -- ] || return 94
  shift
  "$@"
}
if [ "${1-}" = admin-probe ]
then
  shift
  _rsudo_mod_keycloak_admin_transport_probe "$@"
else
  rsudo_mod_keycloak_auth "$@"
fi
PROBE
chmod 700 "$tmp/bin/k04-keycloak-live-probe" ||
  error 'm test entrypoint unavailable'

probe()
{
  PATH="$tmp/bin:$PATH" "$root/m" k04-keycloak-live-probe "$@"
}
transport()
{
  curl -q --silent --show-error --noproxy '*' --proxy '' \
    --cacert "$tmp/image/server.pem" --proto '=https' \
    --max-redirs 0 --connect-timeout 3 --max-time 25 "$@"
}

for version in 26.7.3 26.8.1
do
  image_tag=keycloak-k04-real-$version-$$
  docker build --quiet --build-arg "KC_VERSION=$version" \
    --tag "$image_tag" "$tmp/image" > "$tmp/image-id" ||
    error "official Keycloak $version test image unavailable"
  cid=$(docker run -d --memory 2g --network bridge \
    --publish 127.0.0.1::8443 \
    --env-file "$tmp/bootstrap.env" "$image_tag" \
    start-dev --http-enabled=false --hostname-strict=false \
    --https-certificate-file=/opt/keycloak/conf/k04-server.pem \
    --https-certificate-key-file=/opt/keycloak/conf/k04-server.key) ||
    error "Keycloak $version container could not start"
  [ -n "$cid" ] || error 'Keycloak container identity is empty'
  mapping=$(docker port "$cid" 8443/tcp) || error 'Keycloak HTTPS port missing'
  port=${mapping##*:}
  case "$port" in
    ''|*[!0-9]*) error 'Keycloak HTTPS port invalid' ;;
  esac
  base=https://127.0.0.1:$port

  tries=0
  until transport --output "$tmp/ready" --fail \
    --url "$base/realms/master/.well-known/openid-configuration" \
    >/dev/null 2>"$tmp/ready.err"
  do
    [ "$(docker inspect --format '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] || {
      docker logs --tail 18 "$cid" >&2
      error "Keycloak $version container exited"
    }
    tries=$((tries + 1))
    [ "$tries" -lt 150 ] || {
      docker logs --tail 18 "$cid" >&2
      error "Keycloak $version did not become HTTPS-ready"
    }
    sleep 1
  done

  jq -e --arg expected "$base/realms/master" '.issuer == $expected' \
    "$tmp/ready" >/dev/null ||
    fail "Keycloak $version returned unexpected issuer identity"

  admin_code=$(transport --output "$tmp/admin-token" \
    --write-out '%{http_code}' \
    --data-urlencode grant_type=password \
    --data-urlencode client_id=admin-cli \
    --data-urlencode username=k04admin \
    --data-urlencode "password@$tmp/bootstrap-password" \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version initial admin OAuth request failed"
  [ "$admin_code" = 200 ] ||
    fail "Keycloak $version initial admin login returned HTTP $admin_code"
  admin_token=$(jq -er '.access_token' "$tmp/admin-token") ||
    error "Keycloak $version bootstrap token missing"
  printf 'Authorization: Bearer %s\n' "$admin_token" > "$tmp/bootstrap-header"
  unset admin_token

  create_code=$(transport --output "$tmp/create-response" \
    --write-out '%{http_code}' \
    --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version Admin REST bootstrap client request failed"
  [ "$create_code" = 201 ] ||
    fail "Keycloak $version rejected service account provisioning ($create_code)"

  # Keycloak's Signed JWT client authenticator independently trusts the
  # public X509 cert configured for this one client. The signing key remains
  # a private file available only to the selected sudo test identity.
  rsa_client_http=$(transport --output "$tmp/rsa-client-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-rsa.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version private-key-jwt client provisioning failed"
  [ "$rsa_client_http" = 201 ] ||
    fail "Keycloak $version private-key-jwt client create HTTP $rsa_client_http"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-rs256 \
    --client-auth private-key-jwt --client-jwt-alg RS256 \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-store "$tmp/token-rsa-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version RS256 private-key acquire failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-rsa-$version" >/dev/null ||
    fail "Keycloak $version RS256 access token missing"
  result=$(probe status --token-file "$tmp/token-rsa-$version" \
    --server "$base" --issuer-realm master --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version RS256 introspection failed ($status)"
  # The RSA signing context is also used for explicit Direct Grant,
  # protected refresh and requested refresh-token revocation.
  printf 'k04-bootstrap-only\n' > "$tmp/rsa-password"
  chmod 600 "$tmp/rsa-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/rsa-password" --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-store "$tmp/rsa-password-store-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version private-key-jwt Direct Grant failed ($status)"
  jq -e '.refresh_token | type == "string" and length > 0' \
    "$tmp/rsa-password-store-$version" >/dev/null ||
    fail "Keycloak $version RSA direct token lacks refresh credentials"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-rs256 --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-file "$tmp/rsa-password-store-$version" \
    --token-store "$tmp/rsa-password-store-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version RSA signed refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-rs256 --client-auth private-key-jwt \
    --private-key-file "$tmp/private-client.key" \
    --certificate-file "$tmp/private-client.pem" \
    --token-file "$tmp/rsa-password-store-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version RSA signed revocation failed ($status)"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file "$tmp/wrong-client.key" \
    --certificate-file "$tmp/wrong-client.pem" \
    --token-store "$tmp/token-rsa-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-rsa-rejected-$version" ] ||
    fail "Keycloak $version unregistered RSA key was accepted ($status)"
  grep -F 'eyJhbGciOiJSUzI1Ni' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version RS256 client assertion exposed in diagnostics"

  # Keep the registered RSA certificate, but require the exact selected
  # RSA/PS signature algorithm. The two release targets independently verify the
  # signed assertions rather than trusting the local signature check alone.
  for algorithm in RS384 RS512 PS256 PS384 PS512
  do
    case "$algorithm" in
      RS384) rsa_id=k04-rs384 ;;
      RS512) rsa_id=k04-rs512 ;;
      PS256) rsa_id=k04-ps256 ;;
      PS384) rsa_id=k04-ps384 ;;
      PS512) rsa_id=k04-ps512 ;;
    esac
    jq --arg id "$rsa_id" --arg alg "$algorithm" \
      '.clientId = $id | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-rsa.json" > "$tmp/client-$algorithm.json" ||
      error "Keycloak $version cannot prepare $algorithm client"
    rsa_client_http=$(transport --output "$tmp/rsa-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm client provisioning transport failed"
    [ "$rsa_client_http" = 201 ] ||
      fail "Keycloak $version $algorithm client create HTTP $rsa_client_http"
    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --token-store "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
      jq -e '.access_token | type == "string" and length > 0' \
        "$tmp/token-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm private-key acquire failed ($status)"
    result=$(probe status --token-file "$tmp/token-$algorithm-$version" \
      --server "$base" --issuer-realm master --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version $algorithm introspection failed ($status)"
    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg RS256 \
      --private-key-file "$tmp/private-client.key" \
      --certificate-file "$tmp/private-client.pem" \
      --token-store "$tmp/token-wrong-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 71 ] && [ -z "$result" ] &&
      [ ! -e "$tmp/token-wrong-$algorithm-$version" ] ||
      fail "Keycloak $version $algorithm policy accepted wrong signature ($status)"

    if [ "$algorithm" = PS256 ]
    then
      # A PS-signed client must also work for authenticated direct grants,
      # protected refresh and explicit refresh-token revocation.
      result=$(probe acquire --server "$base" --issuer-realm master \
        --auth-mode password --username k04admin \
        --password-file "$tmp/rsa-password" --client-id "$rsa_id" \
        --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-store "$tmp/password-$algorithm-$version" \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] &&
        jq -e '.refresh_token | type == "string" and length > 0' \
          "$tmp/password-$algorithm-$version" >/dev/null ||
        fail "Keycloak $version $algorithm direct grant failed ($status)"
      result=$(probe refresh --server "$base" --issuer-realm master \
        --client-id "$rsa_id" --client-auth private-key-jwt \
        --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-file "$tmp/password-$algorithm-$version" \
        --token-store "$tmp/password-$algorithm-$version" \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
        fail "Keycloak $version $algorithm refresh failed ($status)"
      result=$(probe revoke --server "$base" --issuer-realm master \
        --client-id "$rsa_id" --client-auth private-key-jwt \
        --client-jwt-alg "$algorithm" \
        --private-key-file "$tmp/private-client.key" \
        --certificate-file "$tmp/private-client.pem" \
        --token-file "$tmp/password-$algorithm-$version" \
        --token-type-hint refresh_token \
        --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
      status=$?
      [ "$status" -eq 0 ] &&
        [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
        fail "Keycloak $version $algorithm revocation failed ($status)"
    fi
  done

  # Signed JWT with confidential client secret is an independently selected
  # Keycloak authenticator, not a fallback from Basic or POST.
  jwt_client_http=$(transport --output "$tmp/jwt-client-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-jwt.json" \
    --url "$base/admin/realms/master/clients") ||
    error "Keycloak $version client-secret-jwt client provisioning failed"
  [ "$jwt_client_http" = 201 ] ||
    fail "Keycloak $version client-secret-jwt client create HTTP $jwt_client_http"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-signed \
    --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-jwt-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version client-secret-jwt token acquisition failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-jwt-$version" >/dev/null ||
    fail "Keycloak $version HS256 session record missing access token"
  result=$(probe status --token-file "$tmp/token-jwt-$version" \
    --server "$base" --issuer-realm master --client-id k04-signed \
    --client-auth client-secret-jwt --client-secret-file "$tmp/secret" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version HS256 authenticated introspection failed ($status)"
  grep -F 'k04-protected-client-secret' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version HS256 secret leaked to diagnostics"

  # The selected algorithm must match each client's Keycloak signing policy.
  # This is a genuine Keycloak-client configuration test, not just an
  # independently generated JWT syntax test.
  for algorithm in HS384 HS512
  do
    case "$algorithm" in
      HS384) signed_id=k04-signed-hs384 ;;
      HS512) signed_id=k04-signed-hs512 ;;
    esac
    jq --arg cid "$signed_id" --arg alg "$algorithm" \
      '.clientId = $cid | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-jwt.json" > "$tmp/client-$algorithm.json" ||
      error "Keycloak $version cannot prepare $algorithm client fixture"
    http=$(transport --output "$tmp/create-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm client provision transport failed"
    [ "$http" = 201 ] ||
      fail "Keycloak $version $algorithm client provision rejected ($http)"

    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg "$algorithm" \
      --client-secret-file "$tmp/secret" \
      --token-store "$tmp/token-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] &&
      jq -e '.access_token | type == "string" and length > 0' \
        "$tmp/token-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm token acquire failed ($status)"

    result=$(probe status --token-file "$tmp/token-$algorithm-$version" \
      --server "$base" --issuer-realm master --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg "$algorithm" \
      --client-secret-file "$tmp/secret" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version $algorithm introspection failed ($status)"

    result=$(probe acquire --server "$base" --issuer-realm master \
      --auth-mode client-credentials --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg HS256 \
      --client-secret-file "$tmp/secret" \
      --token-store "$tmp/mismatch-$algorithm-$version" \
      --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 71 ] && [ -z "$result" ] &&
      [ ! -e "$tmp/mismatch-$algorithm-$version" ] ||
      fail "Keycloak $version wrong $algorithm signing mode was accepted ($status)"
  done

  # The same HS256 authenticator must also handle a user Direct Grant,
  # protected refresh rotation and explicit refresh-token revocation.
  printf 'k04-bootstrap-only\n' > "$tmp/jwt-user-password"
  chmod 600 "$tmp/jwt-user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/jwt-user-password" \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/jwt-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version HS256 user Direct Grant failed ($status)"
  jq -e '(.refresh_token | type == "string" and length > 0)' \
    "$tmp/jwt-user-$version" >/dev/null ||
    fail "Keycloak $version HS256 Direct Grant refresh token absent"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/jwt-user-$version" \
    --token-store "$tmp/jwt-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version HS256 Direct Grant refresh failed ($status)"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/jwt-user-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version HS256 refresh-token revoke failed ($status)"
  grep -F 'k04-protected-client-secret' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version HS256 lifecycle leaked secret in diagnostics"

  # A separate target realm gives a real master-issued, target-scoped
  # delegated authority test. Keycloak creates a target-realm management
  # client in master, rather than using realm-management for master itself.
  printf '%s\n' '{"realm":"k04-target","enabled":true}' > "$tmp/target-realm.json"
  new_realm_code=$(transport --output "$tmp/new-realm-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/target-realm.json" \
    --url "$base/admin/realms") ||
    error "Keycloak $version target realm creation failed"
  [ "$new_realm_code" = 201 ] ||
    fail "Keycloak $version target realm create HTTP $new_realm_code"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-basic-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  if [ "$status" -ne 0 ]
  then
    tail -n 7 "$tmp/auth.err" >&2
    fail "Keycloak $version Basic authentication failed ($status)"
  fi
  [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version Basic acquisition status malformed"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-basic-$version" >/dev/null ||
    fail "Keycloak $version Basic token store invalid"

  result=$(probe status --token-file "$tmp/token-basic-$version" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] && [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version token-store status did not retain non-introspection boundary"

  # Compare the public online status with an independent direct call to
  # the official introspection endpoint under the same client authority.
  # A compliant server can report active=false for policy/visibility reasons:
  # do not replace the actual server answer with an assumed true.
  jq -jr '.access_token' "$tmp/token-basic-$version" \
    > "$tmp/native-introspection-token" ||
    error "Keycloak $version native introspection input unavailable"
  native_basic=$(printf 'k04-service:k04-protected-client-secret' |
    base64 | tr -d '\r\n') ||
    error "Keycloak $version cannot create test-only Basic header"
  printf 'Authorization: Basic %s\n' "$native_basic" \
    > "$tmp/native-introspection-header"
  unset native_basic
  native_http=$(transport --output "$tmp/native-introspection-response" \
    --write-out '%{http_code}' \
    --header "@$tmp/native-introspection-header" \
    --data-urlencode "token@$tmp/native-introspection-token" \
    --data-urlencode 'token_type_hint=access_token' \
    --url "$base/realms/master/protocol/openid-connect/token/introspect") ||
    error "Keycloak $version native introspection transport failed"
  [ "$native_http" = 200 ] &&
    jq -e '(.active | type == "boolean")' \
      "$tmp/native-introspection-response" >/dev/null ||
    fail "Keycloak $version native introspection did not return active boolean"
  expected_active=$(jq -r '.active' "$tmp/native-introspection-response") ||
    error "Keycloak $version native active state unavailable"

  result=$(probe status --token-file "$tmp/token-basic-$version" \
    --server "$base" --issuer-realm master --client-id k04-service \
    --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = "{\"stored\":true,\"server_validated\":true,\"active\":$expected_active}" ] ||
    fail "Keycloak $version introspection differs from direct provider active=$expected_active ($status)"

  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-post-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] ||
    fail "Keycloak $version client secret POST authentication failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-post-$version" >/dev/null ||
    fail "Keycloak $version POST token store invalid"

  # Enabled confidential Direct Access Grant for the synthetic admin:
  # never pass the user password as an ordinary CLI operand.
  printf 'k04-bootstrap-only\n' > "$tmp/user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/user-password" --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-user-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version explicit confidential direct grant failed ($status)"
  jq -e '.access_token | type == "string" and length > 0' \
    "$tmp/token-user-$version" >/dev/null ||
    fail "Keycloak $version Direct Grant token missing"
  grep -F 'k04-bootstrap-only' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version user password leaked to diagnostics"

  printf 'k04-invalid-user-password\n' > "$tmp/user-password"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode password --username k04admin \
    --password-file "$tmp/user-password" --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-user-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] &&
    [ ! -e "$tmp/token-user-rejected-$version" ] ||
    fail "Keycloak $version wrong Direct Grant password not rejected ($status)"

  # Authenticated OAuth client has no administrator role by default.
  # Access to global /admin/serverinfo must not be inferred from its token.
  client_token=$(jq -er '.access_token' "$tmp/token-basic-$version") ||
    error "Keycloak $version service token cannot be read by test"
  printf 'Authorization: Bearer %s\n' "$client_token" > "$tmp/client-header"
  unset client_token
  denied=$(transport --output "$tmp/forbidden-response" \
    --write-out '%{http_code}' --header "@$tmp/client-header" \
    --url "$base/admin/serverinfo") ||
    error "Keycloak $version admin permission boundary HTTP failed"
  [ "$denied" = 403 ] ||
    fail "Keycloak $version service account unexpectedly accessed serverinfo ($denied)"


  # Private K04 realm GET: an authenticated service account with no realm
  # management role must be denied, not misreported as success.
  admin_probe()
  {
    probe admin-probe --server "$base" --issuer-realm master \
      --target-realm "$2" --token-file "$1" \
      --ca-file "$tmp/image/server.pem"
  }
  result=$(admin_probe "$tmp/token-basic-$version" k04-target 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 80 ] && [ -z "$result" ] ||
    fail "Keycloak $version unauthorised service account Admin GET was not 403 ($status)"

  # Delegate only view-realm through Keycloak's actual Admin REST API.
  # The role belongs to realm-management's internal client UUID, not the
  # external clientId string and not an arbitrary assumed UUID.
  svc_clients_code=$(transport --output "$tmp/svc-clients" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients?clientId=k04-service") ||
    error "Keycloak $version service-client lookup failed"
  [ "$svc_clients_code" = 200 ] ||
    fail "Keycloak $version service-client lookup HTTP $svc_clients_code"
  svc_uuid=$(jq -er '.[] | select(.clientId == "k04-service") | .id' \
    "$tmp/svc-clients") ||
    fail "Keycloak $version service-client internal UUID not found"
  svc_user_code=$(transport --output "$tmp/svc-user" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients/$svc_uuid/service-account-user") ||
    error "Keycloak $version service-account user lookup failed"
  [ "$svc_user_code" = 200 ] ||
    fail "Keycloak $version service-account lookup HTTP $svc_user_code"
  svc_user=$(jq -er '.id' "$tmp/svc-user") ||
    fail "Keycloak $version service-account user UUID unavailable"
  management_code=$(transport --output "$tmp/mgmt-clients" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients?clientId=k04-target-realm") ||
    error "Keycloak $version realm-management lookup failed"
  [ "$management_code" = 200 ] ||
    fail "Keycloak $version realm-management lookup HTTP $management_code"
  mgmt_uuid=$(jq -er '.[] | select(.clientId == "k04-target-realm") | .id' \
    "$tmp/mgmt-clients") ||
    fail "Keycloak $version realm-management internal UUID unavailable"
  role_code=$(transport --output "$tmp/view-realm-role" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --url "$base/admin/realms/master/clients/$mgmt_uuid/roles/view-realm") ||
    error "Keycloak $version view-realm lookup failed"
  [ "$role_code" = 200 ] ||
    fail "Keycloak $version view-realm lookup HTTP $role_code"
  jq -e -c '[.]' "$tmp/view-realm-role" > "$tmp/delegated-role" ||
    error "Keycloak $version cannot create delegated-role JSON"
  grant_code=$(transport --output "$tmp/role-grant-response" \
    --write-out '%{http_code}' --header "@$tmp/bootstrap-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/delegated-role" \
    --url "$base/admin/realms/master/users/$svc_user/role-mappings/clients/$mgmt_uuid") ||
    error "Keycloak $version role assignment request failed"
  [ "$grant_code" = 204 ] ||
    fail "Keycloak $version view-realm role grant rejected HTTP $grant_code"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-delegated-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] ||
    fail "Keycloak $version delegated-service token acquisition failed ($status)"
  result=$(admin_probe "$tmp/token-delegated-$version" k04-target 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"http_status":200,"authorized":true,"body_suppressed":true}' ] ||
    fail "Keycloak $version delegated view-realm Admin GET not authorized ($status)"

  # An opaque but syntactically valid rejected bearer must map to public 79,
  # not 403, and never trigger refresh or privilege escalation.
  printf '%s\n' '{"access_token":"K04-SYNTHETIC-INVALID-ACCESS-TOKEN"}' \
    > "$tmp/invalid-bearer-$version"
  chmod 600 "$tmp/invalid-bearer-$version"
  result=$(admin_probe "$tmp/invalid-bearer-$version" master 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 79 ] && [ -z "$result" ] ||
    fail "Keycloak $version invalid Admin bearer was not 401-class ($status)"
  for secret_marker in k04-protected-client-secret K04-SYNTHETIC-INVALID-ACCESS-TOKEN
  do
    grep -F "$secret_marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version private Admin Bearer diagnostic leaked credentials"
  done

  printf 'k04-incorrect-secret\n' > "$tmp/secret"
  result=$(probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-store "$tmp/token-rejected-$version" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  if [ "$status" -ne 71 ]
  then
    # Diagnostic OAuth error *code only*, never raw token/error bodies:
    # determine the exact real provider classification before changing it.
    bad_basic=$(printf 'k04-service:k04-incorrect-secret' | base64 | tr -d '\r\n') ||
      error 'cannot encode synthetic negative client credentials'
    printf 'Authorization: Basic %s\n' "$bad_basic" > "$tmp/bad-basic-header"
    unset bad_basic
    bad_http=$(transport --output "$tmp/bad-json" \
      --write-out '%{http_code}' --header "@$tmp/bad-basic-header" \
      --data-urlencode grant_type=client_credentials \
      --url "$base/realms/master/protocol/openid-connect/token") ||
      error 'cannot inspect negative OAuth error'
    bad_error=$(jq -r '.error // "missing-error"' "$tmp/bad-json") ||
      error 'cannot parse negative OAuth error code'
    fail "Keycloak $version wrong-client-secret class=$status; HTTP=$bad_http; OAuth=$bad_error"
  fi
  [ ! -e "$tmp/token-rejected-$version" ] ||
    fail "Keycloak $version stored a token after rejecting credentials"
  printf 'k04-protected-client-secret\n' > "$tmp/secret"

  # K04 refresh through the real m invocation and official server.
  # The old store is copied for an exact no-change check on failures.
  # Keycloak can issue a refreshed token without requiring per-realm rotation
  # to be enabled: assert the protected replacement protocol, not an assumed
  # token-value difference across releases.
  refresh_store=$tmp/token-user-$version
  cp "$refresh_store" "$tmp/refresh-before-$version" ||
    error "Keycloak $version cannot snapshot private pre-refresh store"
  old_inode=$(ls -id "$refresh_store" | awk '{print $1}') ||
    error "Keycloak $version original refresh inode unavailable"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version real confidential refresh failed ($status)"
  jq -e '(.access_token | type == "string" and length > 0) and
    (.refresh_token | type == "string" and length > 0)' \
    "$refresh_store" >/dev/null ||
    fail "Keycloak $version refresh did not preserve usable token fields"
  mode=$(LC_ALL=C ls -ld "$refresh_store"); mode=${mode%% *}
  [ "$mode" = '-rw-------' ] ||
    fail "Keycloak $version refresh lost private mode"
  new_inode=$(ls -id "$refresh_store" | awk '{print $1}') ||
    error "Keycloak $version refreshed inode unavailable"
  [ "$new_inode" != "$old_inode" ] ||
    fail "Keycloak $version refresh did not replace the store atomically"
  [ ! -e "$refresh_store.keycloak-refresh-lock" ] ||
    fail "Keycloak $version successful refresh left lock behind"

  # Exercise POST client authentication on an already refreshed session.
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version client-secret-post refresh failed ($status)"

  # A held lock must fail without making a token HTTP request or rewriting
  # the existing record. This verifies cooperative serialization, not CAS
  # against arbitrary external writers.
  cp "$refresh_store" "$tmp/refresh-held-$version" ||
    error "Keycloak $version cannot snapshot locked store"
  mkdir "$refresh_store.keycloak-refresh-lock" ||
    error "Keycloak $version cannot create refresh contention fixture"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 87 ] && [ -z "$result" ] &&
    cmp -s "$refresh_store" "$tmp/refresh-held-$version" ||
    fail "Keycloak $version concurrent refresh bypassed exclusive lock ($status)"
  rmdir "$refresh_store.keycloak-refresh-lock" ||
    error "Keycloak $version cannot release test-owned lock"
  for sensitive in k04-protected-client-secret k04-bootstrap-only
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version refresh diagnostic leaked a secret"
  done

  # Real RFC 7009 revocation. A refresh token may also revoke this client's
  # consent. The store remains intact; HTTP 200 does NOT prove every already
  # issued JWT is unusable at all resource servers.
  jq -e '.refresh_token | type == "string" and length > 0' \
    "$tmp/token-user-$version" >/dev/null ||
    fail "Keycloak $version did not supply refresh token for Direct Grant"
  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/token-user-$version" \
    --token-type-hint refresh_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version refresh revocation rejected ($status)"
  [ -f "$tmp/token-user-$version" ] ||
    fail "Keycloak $version revoke removed the protected source store"

  jq -jr '.refresh_token' "$tmp/token-user-$version" > "$tmp/refresh-probe" ||
    error "Keycloak $version test refresh extraction failed"
  client_basic=$(printf 'k04-service:k04-protected-client-secret' | base64 | tr -d '\r\n') ||
    error 'cannot create synthetic confidential test auth header'
  printf 'Authorization: Basic %s\n' "$client_basic" > "$tmp/refresh-client-header"
  unset client_basic
  refresh_code=$(transport --output "$tmp/refresh-response" \
    --write-out '%{http_code}' --header "@$tmp/refresh-client-header" \
    --data-urlencode grant_type=refresh_token \
    --data-urlencode "refresh_token@$tmp/refresh-probe" \
    --url "$base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version refresh-after-revoke HTTP failed"
  [ "$refresh_code" = 400 ] &&
    jq -e '.error == "invalid_grant"' "$tmp/refresh-response" >/dev/null ||
    fail "Keycloak $version revoked refresh token unexpectedly accepted ($refresh_code)"

  # The public refresh call must classify revoked-token invalid_grant and
  # leave the protected session file byte-identical on failure.
  cp "$refresh_store" "$tmp/revoked-before-$version" ||
    error "Keycloak $version cannot snapshot revoked store"
  result=$(probe refresh --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$refresh_store" --token-store "$refresh_store" \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] &&
    cmp -s "$refresh_store" "$tmp/revoked-before-$version" &&
    [ ! -e "$refresh_store.keycloak-refresh-lock" ] ||
    fail "Keycloak $version revoked refresh mutated store or had incorrect status ($status)"

  result=$(probe revoke --server "$base" --issuer-realm master \
    --client-id k04-service --client-auth client-secret-post \
    --client-secret-file "$tmp/secret" \
    --token-file "$tmp/token-basic-$version" \
    --token-type-hint access_token \
    --ca-file "$tmp/image/server.pem" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version access revocation rejected ($status)"

  for sensitive in k04-protected-client-secret k04-bootstrap-only
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version revocation secret leaked to diagnostics"
  done

  printf '%s: verified real Keycloak %s OAuth basic/post and permission boundary\n' \
    "$TEST_ID" "$version"
  stop_keycloak
done
printf '%s\n' "$TEST_ID: PASS (two real Keycloak releases, HTTPS and OAuth; SSH replaced)"
