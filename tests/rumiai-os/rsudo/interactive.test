#!/bin/sh

# Protected current properties:
#   RSUDO-01  valid connection data executes the requested remote target under sudo.
#   RSUDO-03  target stdout/stderr remain observable to the caller.
#   RSUDO-04  resulting remote target status is propagated.
#   RSUDO-07  interactive mode executes the target through a terminal-capable remote path.
#   RSUDO-11  password data is not exposed as ordinary target input/output.
#
# The SSH and sudo programs below are external-boundary fixtures. They model a
# reachable remote host whose sudo policy requires a password. The test asserts
# only the observable interactive result, not rsudo's internal call sequence.

TEST_ID=rumiai-os/rsudo/interactive.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}

terminate()
{
    signal=$1
    trap - 0 "$signal"
    cleanup
    kill -s "$signal" "$$"
}

trap cleanup 0
trap 'terminate HUP' HUP
trap 'terminate INT' INT
trap 'terminate QUIT' QUIT
trap 'terminate TERM' TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
interactive_library=$suite_root/lib/interactive.lib

[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
[ -f "$interactive_library" ] || error 'interactive test helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'
. "$interactive_library" || error 'cannot source interactive test helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

rumiai_test_interactive_require
status=$?
case $status in
    0) : ;;
    2) skip 'interactive PTY driver is unavailable' ;;
    *) error 'cannot determine interactive PTY support' ;;
esac

rsudo_command=$root/bin/sys/rsudo
[ -x "$rsudo_command" ] ||
    fail 'rsudo command entrypoint is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-rsudo-interactive-$$
fakebin=$tmp/bin
runtime_tmp=$tmp/runtime
mkdir -p "$fakebin" "$runtime_tmp" ||
    error 'cannot create interactive external-boundary fixtures'

cat > "$fakebin/ssh" <<'EOF_SSH'
#!/bin/sh

if [ "${1-}" = -t ]
then
    shift
fi

login_user=
if [ "${1-}" = -l ]
then
    [ "$#" -ge 3 ] || exit 80
    login_user=$2
    shift 2
fi

[ "$#" -ge 2 ] || exit 81
host=$1
shift

[ "$login_user" = "$RSUDO_TEST_EXPECT_LOGIN_USER" ] || exit 82
[ "$host" = "$RSUDO_TEST_EXPECT_HOST" ] || exit 83

remote_command=$*
[ -n "$remote_command" ] || exit 84

RSUDO_TEST_REMOTE_LOGIN_USER=$login_user
export RSUDO_TEST_REMOTE_LOGIN_USER

PATH="$RSUDO_TEST_REMOTE_BIN:$PATH" sh -c "$remote_command"
EOF_SSH

cat > "$fakebin/sudo" <<'EOF_SUDO'
#!/bin/sh

validated=$RSUDO_TEST_SUDO_VALIDATED_FILE
expected_password=$RSUDO_TEST_EXPECT_PASSWORD

if [ "${1-}" = -K ]
then
    rm -f "$validated" || exit 90
    exit 0
fi

stdin_auth=0
noninteractive=0
validate_only=0
target_user=root

while [ "$#" -gt 0 ]
do
    case $1 in
        -S)
            stdin_auth=1
            shift
        ;;
        -n)
            noninteractive=1
            shift
        ;;
        -v)
            validate_only=1
            shift
        ;;
        --prompt=*|-p)
            if [ "$1" = -p ]; then [ "$#" -ge 2 ] || exit 91; shift 2; else shift; fi
        ;;
        --user|-u)
            [ "$#" -ge 2 ] || exit 92
            target_user=$2
            shift 2
        ;;
        --)
            shift
            break
        ;;
        -*)
            exit 93
        ;;
        *)
            break
        ;;
    esac
done

authenticate()
{
    [ -f "$validated" ] && return 0

    if [ "$stdin_auth" -eq 1 ]
    then
        IFS= read -r supplied || return 70
        [ "$supplied" = "$expected_password" ] || return 71
        : > "$validated" || return 72
        unset supplied
        return 0
    fi

    [ "$noninteractive" -eq 0 ] || return 73

    # An interactive sudo password prompt is intentionally outside this fixture.
    return 74
}

if [ "$validate_only" -eq 1 ]
then
    authenticate
    exit $?
fi

[ "$#" -gt 0 ] || exit 94

authenticate
auth_status=$?
[ "$auth_status" -eq 0 ] || exit "$auth_status"

RSUDO_TEST_EFFECTIVE_USER=$target_user
export RSUDO_TEST_EFFECTIVE_USER

exec "$@"
EOF_SUDO

cat > "$fakebin/rsudo-target-interactive" <<'EOF_TARGET'
#!/bin/sh
[ "${RSUDO_TEST_EFFECTIVE_USER-}" = root ] || exit 60
printf '%s\n' "INTERACTIVE-STDOUT:$RSUDO_TEST_CASE"
printf '%s\n' "INTERACTIVE-STDERR:$RSUDO_TEST_CASE" >&2
exit "$RSUDO_TEST_TARGET_STATUS"
EOF_TARGET

chmod +x "$fakebin/ssh" "$fakebin/sudo" "$fakebin/rsudo-target-interactive" ||
    error 'cannot make interactive external-boundary fixtures executable'

command -p sh -n "$fakebin/ssh" ||
    error 'ssh boundary fixture has invalid shell syntax'
command -p sh -n "$fakebin/sudo" ||
    error 'sudo boundary fixture has invalid shell syntax'
command -p sh -n "$fakebin/rsudo-target-interactive" ||
    error 'interactive target fixture has invalid shell syntax'

status_file=$tmp/status
dialogue=$tmp/dialogue
transcript=$tmp/transcript
wrapper=$tmp/run-rsudo
validated_file=$tmp/sudo.validated

: > "$dialogue"

cat > "$wrapper" <<'EOF_WRAPPER'
#!/bin/sh

"$RSUDO_TEST_M" "$RSUDO_TEST_RSUDO_COMMAND"     --interactive --no-preserve-quotes -- rsudo-target-interactive
status=$?

printf '%s\n' "$status" > "$RSUDO_TEST_STATUS_FILE"
exit 0
EOF_WRAPPER
chmod +x "$wrapper" || error 'cannot make interactive wrapper executable'

PATH="$fakebin:$PATH"
TMPDIR="$runtime_tmp"
RSUDO_HOST=example.invalid
RSUDO_USER=alice
RSUDO_PASSWORD=secret
RSUDO_TEST_M=$root/m
RSUDO_TEST_RSUDO_COMMAND=$rsudo_command
RSUDO_TEST_STATUS_FILE=$status_file
RSUDO_TEST_REMOTE_BIN=$fakebin
RSUDO_TEST_EXPECT_LOGIN_USER=alice
RSUDO_TEST_EXPECT_HOST=example.invalid
RSUDO_TEST_SUDO_VALIDATED_FILE=$validated_file
RSUDO_TEST_EXPECT_PASSWORD=secret
RSUDO_TEST_TARGET_STATUS=23
RSUDO_TEST_CASE=interactive

export     PATH TMPDIR     RSUDO_HOST RSUDO_USER RSUDO_PASSWORD     RSUDO_TEST_M RSUDO_TEST_RSUDO_COMMAND RSUDO_TEST_STATUS_FILE     RSUDO_TEST_REMOTE_BIN RSUDO_TEST_EXPECT_LOGIN_USER RSUDO_TEST_EXPECT_HOST     RSUDO_TEST_SUDO_VALIDATED_FILE RSUDO_TEST_EXPECT_PASSWORD     RSUDO_TEST_TARGET_STATUS RSUDO_TEST_CASE

rumiai_test_interactive_run "$dialogue" "$transcript" "$wrapper" ||
    error 'interactive PTY driver could not complete rsudo scenario'

[ -f "$status_file" ] ||
    error 'interactive rsudo wrapper did not record status'

status=$(cat "$status_file")
case $status in
    8[0-9]|9[0-9])
        cat "$transcript" >&2
        error "external-boundary fixture could not model interactive rsudo (status $status)"
    ;;
esac

[ "$status" -eq 23 ] || {
    cat "$transcript" >&2
    fail "interactive target status was $status instead of 23"
}

grep -F 'INTERACTIVE-STDOUT:interactive' "$transcript" >/dev/null 2>&1 ||
    fail 'interactive target stdout was not propagated'
grep -F 'INTERACTIVE-STDERR:interactive' "$transcript" >/dev/null 2>&1 ||
    fail 'interactive target stderr was not propagated'

if grep -F 'secret' "$transcript" >/dev/null 2>&1
then
    fail 'authentication data appeared as ordinary interactive output'
fi

exit 0
