#!/bin/sh
# Real official Apache APISIX process managed by real systemd in one disposable
# Linux Docker cgroup/PID namespace. Only rsudo's SSH/sudo transport is
# substituted; module, APISIX CLI, generated OpenResty config and systemd are
# real. No host ports, production network, credentials or API writes.
TEST_ID=rumiai-os/rsudo/apisix-systemd-apisix-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp=
cid=
image_tag=
cleanup()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  [ -z "$image_tag" ] || docker image rm "$image_tag" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver missing'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'explicit product checkout invalid' ;;
  *) error 'target resolver failed' ;;
esac
[ "$(uname -s)" = Linux ] || skip 'requires Linux systemd cgroups'
command -v docker >/dev/null 2>&1 || skip 'Docker unavailable'
image='apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'
docker image inspect "$image" >/dev/null 2>&1 ||
  skip 'pinned official APISIX 3.19 image unavailable'
[ -r /sys/fs/cgroup/cgroup.controllers ] ||
  skip 'Linux unified cgroup v2 unavailable'

umask 077
tmp=$(mktemp -d "${TMPDIR:-/tmp}/rsudo-apisix-service-live-XXXXXX") ||
  error 'cannot create disposable scenario directory'
mkdir -p "$tmp/bin" || error 'cannot create probe directory'
cat > "$tmp/config.yaml" <<'APISIX_STANDALONE'
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
APISIX_STANDALONE
# Deliberately retain a default file-driven source, but start the actual
# service through an independent named API-driven profile. The two modes
# disagree, so a successful PID/systemd observation cannot select a source.
cat > "$tmp/config-prod.yaml" <<'APISIX_API_PROFILE'
deployment:
  role: traditional
  role_traditional:
    config_provider: yaml
  admin:
    admin_key_required: true
    admin_key:
      - name: test-viewer
        key: rsudo-test-only-never-production
        role: viewer
    admin_listen:
      ip: 127.0.0.1
      port: 9180
APISIX_API_PROFILE
chmod 644 "$tmp/config.yaml" "$tmp/config-prod.yaml" ||
  error 'cannot make test configurations readable'

cat > "$tmp/Dockerfile" <<'DOCKERFILE'
FROM apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141
USER root
ENV container=docker
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd dbus && \
    rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/lib/systemd/systemd"]
CMD ["--unit=basic.target"]
DOCKERFILE
image_tag="rsudo-apisix-systemd-test-$$:local"
docker build --pull=false -q -t "$image_tag" -f "$tmp/Dockerfile" "$tmp" ||
  error 'cannot provision systemd with the pinned official APISIX filesystem'

# A private PID/cgroup namespace and no network make a disposable system
# manager with a real APISIX installation. Privilege is restricted to this
# dedicated hosted-runner test container, NEVER a deployment recommendation.
cid=$(docker run -d --privileged --cgroupns=private --network none \
  --tmpfs /run --tmpfs /run/lock \
  --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
  --mount "type=bind,src=$tmp/config-prod.yaml,dst=/usr/local/apisix/conf/config-prod.yaml,readonly" \
  -e APISIX_STAND_ALONE=true "$image_tag") ||
  error 'cannot start isolated real systemd manager'
[ -n "$cid" ] || error 'Docker returned no systemd container ID'

tries=0
while [ "$tries" -lt 30 ]
do
  if docker exec "$cid" sh -c '
    [ -d /run/systemd/system ] &&
    systemctl show --property=Id --value basic.target >/dev/null 2>&1
  '
  then
    break
  fi
  [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] || {
    docker logs "$cid" >&2 || :
    fail 'real systemd manager terminated'
  }
  tries=$((tries + 1))
  sleep 1
done
[ "$tries" -lt 30 ] || {
  docker logs "$cid" >&2 || :
  fail 'real systemd manager did not become operational'
}

# Initialize the actual pinned APISIX CLI's generated nginx.conf, then
# launch the actual installed APISIX daemon from a transient systemd service.
docker exec -e APISIX_PROFILE=prod -e APISIX_STAND_ALONE=true \
  "$cid" /usr/bin/apisix init ||
  error 'official APISIX CLI could not initialize the selected named profile'
# The official container image connects its log files to Docker stdout/stderr.
# Reopening those stream descriptors from a daemonized systemd unit fails with
# ENXIO. Supply ordinary log files only inside this disposable test container.
docker exec "$cid" sh -c '
  set -eu
  for name in error.log access.log
  do
    file=/usr/local/apisix/logs/$name
    [ ! -L "$file" ] || rm "$file"
    : > "$file"
  done
' || error 'cannot prepare real APISIX service log files'
unit="rsudo-apisix-$(printf '%s' "$$" | tr -cd '0-9').service"
docker exec "$cid" systemd-run --unit="${unit%.service}" \
  --setenv=APISIX_PROFILE=prod --setenv=APISIX_STAND_ALONE=true \
  --property=Type=forking \
  --property=PIDFile=/usr/local/apisix/logs/nginx.pid \
  -- /usr/bin/apisix start || {
  docker exec "$cid" systemctl status --no-pager "$unit" >&2 || :
  docker exec "$cid" journalctl --no-pager --unit "$unit" --lines 60 >&2 || :
  docker exec "$cid" sh -c 'ls -l /usr/local/apisix/logs/nginx.pid /usr/local/apisix/logs/error.log 2>&1 || :' >&2 || :
  docker logs "$cid" >&2 || :
  error 'cannot start official APISIX through real systemd service'
}

tries=0
while [ "$tries" -lt 30 ]
do
  if docker exec "$cid" sh -c '
    test -s /usr/local/apisix/logs/nginx.pid &&
    test -r /usr/local/apisix/conf/nginx.conf &&
    [ "$(systemctl show --property=ActiveState --value "$1")" = active ]
  ' sh "$unit"
  then
    break
  fi
  [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] || {
    docker logs "$cid" >&2 || :
    fail 'isolated systemd/APISIX instance exited'
  }
  tries=$((tries + 1))
  sleep 1
done
[ "$tries" -lt 30 ] || {
  docker exec "$cid" systemctl status --no-pager "$unit" >&2 || :
  fail 'real systemd-managed APISIX master did not become active'
}

pid=$(docker exec "$cid" cat /usr/local/apisix/logs/nginx.pid) ||
  error 'cannot observe APISIX master pidfile'
main_pid=$(docker exec "$cid" systemctl show --property=MainPID --value "$unit") ||
  error 'cannot read systemd MainPID'
[ "$pid" = "$main_pid" ] && [ "$pid" -ge 1 ] 2>/dev/null ||
  fail 'real systemd unit MainPID does not equal official APISIX master PID'
docker exec "$cid" sh -c '
  test -r "/proc/$1/cmdline" || exit 1
  title=$(LC_ALL=C tr "\\000" " " < "/proc/$1/cmdline") || exit 1
  case "$title" in
    "nginx: master process "*|"openresty: master process "*) : ;;
    *) exit 1 ;;
  esac
' sh "$pid" ||
  error 'official APISIX service does not own a live OpenResty master'

cat > "$tmp/bin/rsudo-apisix-systemd-apisix-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  docker exec -i "$APISIX_TEST_CONTAINER" "$@"
}
case "${APISIX_TEST_OPERATION:-runtime}" in
  runtime) rsudo_mod_apisix_runtime "$@" ;;
  mode) rsudo_mod_apisix_mode "$@" ;;
  *) exit 83 ;;
esac
PROBE
chmod 700 "$tmp/bin/rsudo-apisix-systemd-apisix-probe" ||
  error 'cannot execute product entrypoint probe'
probe()
{
  APISIX_TEST_CONTAINER="$cid" PATH="$tmp/bin:$PATH" \
    "$root/m" rsudo-apisix-systemd-apisix-probe "$@"
}

expected=$(printf '%s\n' \
  'runtime_evidence=pidfile-and-master-args' \
  "process_pid=$pid" \
  'service_manager_evidence=systemd-mainpid-and-cgroup' \
  "service_unit=$unit" \
  'runtime_identity=process-consistent-config-unverified' \
  'mutation_readiness=not-established')
result=$(probe /usr/local/apisix 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = "$expected" ] || {
  cat "$tmp/stderr" >&2
  docker exec "$cid" systemctl show \
    --property=Id,MainPID,ControlGroup,ActiveState "$unit" >&2 || :
  docker exec "$cid" cat "/proc/$pid/cgroup" >&2 || :
  fail 'real systemd-managed APISIX did not yield verified service evidence'
}

normal_expected=$(printf '%s\n' \
  'discovery_evidence=unique-conventional-candidate' \
  'discovered_scope=host' \
  "$expected")
result=$(probe 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = "$normal_expected" ] || {
  cat "$tmp/stderr" >&2
  fail 'automatic APISIX process discovery lost real systemd evidence'
}

# Mode inspection is intentionally an independent on-disk observation,
# not evidence that the active systemd service loaded that YAML snapshot.
disk_default=$(APISIX_TEST_OPERATION=mode probe /usr/local/apisix \
  /usr/local/apisix/conf/config.yaml 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$disk_default" = standalone-file-yaml ] || {
  cat "$tmp/stderr" >&2
  fail 'default source was not independently classified as file-driven'
}
disk_profile=$(APISIX_TEST_OPERATION=mode probe /usr/local/apisix \
  /usr/local/apisix/conf/config-prod.yaml 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$disk_profile" = standalone-api ] || {
  cat "$tmp/stderr" >&2
  fail 'named source was not independently classified as API-driven'
}
ambiguous=$(APISIX_TEST_OPERATION=mode probe /usr/local/apisix 2>"$tmp/stderr")
status=$?
[ "$status" -eq 10 ] && [ -z "$ambiguous" ] || {
  cat "$tmp/stderr" >&2
  fail 'implicit mode silently selected one of two conflicting profiles'
}

# Independent runtime capability observation: the selected service should
# respond with an authorized read-only APISIX Admin API /configs document.
# Fixed ephemeral test-only credential, no Admin API write or host port.
http_status=$(docker exec -i "$cid" /bin/bash -s <<'APISIX_TEST_HTTP'
exec 3<>/dev/tcp/127.0.0.1/9180 || exit 70
printf 'GET /apisix/admin/configs HTTP/1.1\r\nHost: localhost\r\nAccept: application/json\r\nX-API-KEY: rsudo-test-only-never-production\r\nConnection: close\r\n\r\n' >&3
IFS= read -r first <&3 || exit 71
set -- $first
[ "$1" = HTTP/1.1 ] || [ "$1" = HTTP/1.0 ] || exit 72
printf '%s\n' "$2"
APISIX_TEST_HTTP
)
status=$?
[ "$status" -eq 0 ] && [ "$http_status" = 200 ] || 
  fail "real APISIX Admin GET did not succeed (status $status, HTTP ${http_status:-none})"

# Linux kernel evidence independently relates the selected namespace's
# listening TCP socket inode to the *observed* nginx/OpenResty master PID.
# This is socket ownership, not by itself a generic proof of Admin provenance.
docker exec "$cid" sh -s -- "$pid" <<'APISIX_TEST_SOCKET'
pid=$1
[ -r /proc/net/tcp ] || exit 73
command -v awk >/dev/null 2>&1 || exit 74
command -v readlink >/dev/null 2>&1 || exit 75
socket_inode=$(awk '$2=="0100007F:23DC" && $4=="0A" {print $10}' /proc/net/tcp) || exit 76
case "$socket_inode" in
  ''|*[!0-9]*) exit 77 ;;
esac
found=0
for fd in "/proc/$pid/fd/"*
do
  target=$(readlink "$fd" 2>/dev/null) || continue
  if [ "$target" = "socket:[$socket_inode]" ]
  then
    found=1
    break
  fi
done
[ "$found" -eq 1 ] || exit 78
APISIX_TEST_SOCKET
status=$?
[ "$status" -eq 0 ] || fail "APISIX master lacks independently observed Admin TCP listener inode (status $status)"

printf '%s\n' "$TEST_ID: PASS (real APISIX/systemd PID, named profile drift, Admin read and kernel socket attribution)"
