#!/bin/sh
# Real m/product transport and actual curl against a local loopback HTTP server.
# The replaced boundary is only remote rsudo/SSH/sudo, not HTTP or curl.
# This does not validate a real APISIX gateway or remote sudo credentials.
TEST_ID=rumiai-os/rsudo/apisix-admin-transport.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

pid=
tmp=
cleanup()
{
  if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
  fi
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unresolved'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'product checkout resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'product checkout not found' ;;
  2) fail 'explicit selected product checkout invalid' ;;
  *) error 'product resolver failed' ;;
esac

command -v python3 >/dev/null 2>&1 || skip 'python3 loopback HTTP fixture unavailable'
command -v curl >/dev/null 2>&1 || skip 'curl transport dependency unavailable'
module=$root/lib/sys/sh/rsudo/rsudo-mod-apisix.lib.sh
manual=$root/res/sys/manual/rsudo-mod-apisix.lib.sh
[ -f "$module" ] && [ ! -x "$module" ] && [ -f "$manual" ] ||
  fail 'current APISIX module/manual missing or executable'
command -p sh -n "$module" || fail 'APISIX module invalid POSIX syntax'
grep -F 'rsudo_mod_apisix_admin_read' "$manual" >/dev/null ||
  fail 'new public transport missing from library manual'

tmp=${TMPDIR:-/tmp}/rsudo-apisix-admin-transport-$$
umask 077
mkdir -p -- "$tmp/bin" || error 'temporary fixture unavailable'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture absolute path unresolved'

cat > "$tmp/server.py" <<'PY_SERVER'
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
import sys

KEY = "test-secret-credential-never-in-process-argv"
class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass
    def do_GET(self):
        if self.headers.get("X-API-KEY") != KEY:
            code, body = 401, b'{"error":"unauthorized"}'
        elif self.path == "/apisix/admin/routes":
            code, body = 200, b'{"routes":[{"id":"test"}]}'
        elif self.path == "/apisix/admin/routes/test":
            code, body = 200, b'{"id":"test"}'
        elif self.path == "/apisix/admin/services":
            code, body = 200, b'{"services":[]}'
        elif self.path == "/apisix/admin/upstreams":
            code, body = 200, b'{"upstreams":[]}'
        elif self.path == "/apisix/admin/configs":
            code, body = 200, b'{"routes_conf_version":2,"routes":[{"id":"snap-a","uri":"/a"},{"id":"snap-b","uri":"/b"}],"services":[{"id":"snap-service"}],"upstreams":[{"id":"snap-upstream"}]}'
        else:
            code, body = 404, b'{"error":"missing"}'
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def do_POST(self):
        self.handle_mutation()
    def do_PUT(self):
        self.handle_mutation()
    def do_DELETE(self):
        self.handle_mutation()
    def handle_mutation(self):
        content_length = int(self.headers.get("Content-Length", "0"))
        request_body = self.rfile.read(content_length)
        Path(sys.argv[2]).write_bytes(
            self.command.encode() + b"\n" + self.path.encode() + b"\n" + request_body
        )
        if self.headers.get("X-API-KEY") != KEY:
            code, body = 401, b'{"error":"unauthorized"}'
        elif content_length > 0 and self.headers.get("Content-Type") != "application/json":
            code, body = 415, b'{"error":"content-type-required"}'
        elif b'"reject":true' in request_body:
            code, body = 400, b'{"error":"request-rejected"}'
        elif self.command == "POST" and self.path == "/apisix/admin/routes":
            code, body = 201, b'{"id":"created"}'
        elif self.command == "PUT" and self.path == "/apisix/admin/routes/test":
            code, body = 200, b'{"id":"test","updated":true}'
        elif self.command == "DELETE" and self.path == "/apisix/admin/routes/test":
            code, body = 200, b'{"deleted":"test"}'
        else:
            code, body = 404, b'{"error":"missing"}'
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

httpd = HTTPServer(("127.0.0.1", 0), Handler)
Path(sys.argv[1]).write_text(str(httpd.server_address[1]))
httpd.serve_forever()
PY_SERVER

cat > "$tmp/bin/rsudo-apisix-transport-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  "$@"
}
case "${APISIX_TEST_OPERATION:-admin-read}" in
  admin-read) rsudo_mod_apisix_admin_read "$@";;
  list) rsudo_mod_apisix_list "$@";;
  get) rsudo_mod_apisix_get "$@";;
  create) rsudo_mod_apisix_create "$@";;
  update) rsudo_mod_apisix_update "$@";;
  delete) rsudo_mod_apisix_delete "$@";;
  apply) rsudo_mod_apisix_apply "$@";;
  *) exit 83;;
esac
PROBE

# Make the real curl invocation's argv observable without logging the secret.
curl_binary=$(command -v curl)
cat > "$tmp/bin/curl" <<'CURL_WRAPPER'
#!/bin/sh
printf '%s\n' "$@" > "$APISIX_CURL_ARGV_LOG"
exec "$APISIX_CURL_BINARY" "$@"
CURL_WRAPPER
chmod 700 "$tmp/bin/rsudo-apisix-transport-probe" "$tmp/bin/curl" ||
  error 'probe/wrapper not executable'

printf 'X-API-KEY: %s\n' 'test-secret-credential-never-in-process-argv' > "$tmp/admin-header"
chmod 600 "$tmp/admin-header" || error 'protected remote header fixture unavailable'

python3 -u "$tmp/server.py" "$tmp/port" "$tmp/mutation-request" > "$tmp/server.out" 2>"$tmp/server.err" &
pid=$!
count=0
while [ ! -s "$tmp/port" ] && [ "$count" -lt 60 ]
do
  sleep 0.1
  count=$((count + 1))
done
[ -s "$tmp/port" ] || {
  cat "$tmp/server.err" >&2
  error 'HTTP fixture did not start'
}
port=$(cat "$tmp/port") || error 'cannot read fixture port'

probe()
{
  APISIX_CURL_ARGV_LOG="$tmp/argv" APISIX_CURL_BINARY="$curl_binary" \
    PATH="$tmp/bin:$PATH" "$root/m" rsudo-apisix-transport-probe "$@"
}

result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"routes":[{"id":"test"}]}' ] ||
  fail "legitimate route GET failed (status $status)"

result=$(APISIX_TEST_OPERATION=list RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"routes":[{"id":"test"}]}' ] ||
  fail "public REST list failed (status $status)"
result=$(APISIX_TEST_OPERATION=get RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes test 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"id":"test"}' ] ||
  fail "public REST get failed (status $status)"
result=$(APISIX_TEST_OPERATION=list RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://url-secret@127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes 2>"$tmp/stderr")
status=$?
[ "$status" -eq 5 ] && [ -z "$result" ] ||
  fail 'URL userinfo was not rejected locally'
grep -F 'url-secret' "$tmp/stderr" >/dev/null &&
  fail 'URL userinfo appeared in diagnostics'
printf '%s\n' '{"uri":"/created","plugins":{"key-auth":{"key":"body-secret-never-in-process-argv"}}}' > "$tmp/body.json"
chmod 600 "$tmp/body.json" || error 'protected body fixture unavailable'
result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/body.json" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"id":"created"}' ] ||
  fail "REST create did not POST the protected body (status $status)"
[ "$(sed -n '1p' "$tmp/mutation-request")" = POST ] || fail 'create method was not POST'
[ "$(sed -n '2p' "$tmp/mutation-request")" = /apisix/admin/routes ] || fail 'create path was not the resource collection'
grep -F 'body-secret-never-in-process-argv' "$tmp/mutation-request" >/dev/null || fail 'create body did not reach HTTP endpoint'
grep -F 'body-secret-never-in-process-argv' "$tmp/argv" >/dev/null && fail 'request body content was placed in curl argv'

result=$(APISIX_TEST_OPERATION=update RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes test "$tmp/body.json" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"id":"test","updated":true}' ] ||
  fail "REST update did not PUT the selected resource (status $status)"
[ "$(sed -n '1p' "$tmp/mutation-request")" = PUT ] || fail 'update method was not PUT'
[ "$(sed -n '2p' "$tmp/mutation-request")" = /apisix/admin/routes/test ] || fail 'update path did not include the selected ID'

result=$(APISIX_TEST_OPERATION=delete RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes test 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"deleted":"test"}' ] ||
  fail "REST delete did not DELETE the selected resource (status $status)"
[ "$(sed -n '1p' "$tmp/mutation-request")" = DELETE ] || fail 'delete method was not DELETE'
[ "$(sed -n '2p' "$tmp/mutation-request")" = /apisix/admin/routes/test ] || fail 'delete path did not include the selected ID'

printf '%s\n' '{"reject":true}' > "$tmp/reject.json"
chmod 600 "$tmp/reject.json" || error 'protected rejection body unavailable'
result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/reject.json" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 22 ] && [ -z "$result" ] || fail 'HTTP mutation failure status/body handling is incorrect'
grep -F 'request-rejected' "$tmp/stderr" >/dev/null && fail 'HTTP mutation error body leaked to diagnostics'

result=$(APISIX_TEST_OPERATION=delete RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes .. 2>"$tmp/stderr")
[ "$?" -eq 3 ] && [ -z "$result" ] || fail 'invalid mutation resource ID was accepted'

result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=standalone-api \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/body.json" 2>"$tmp/stderr")
[ "$?" -eq 5 ] && [ -z "$result" ] || fail 'snapshot create was not rejected without legacy fallback'

result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://url-secret@127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/body.json" 2>"$tmp/stderr")
[ "$?" -eq 8 ] && [ -z "$result" ] || fail 'mutation URL userinfo was not rejected locally'
grep -F 'url-secret' "$tmp/stderr" >/dev/null && fail 'mutation URL userinfo leaked to diagnostics'

result=$(APISIX_TEST_OPERATION=apply RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  probe routes 2>"$tmp/stderr")
[ "$?" -eq 1 ] && [ -z "$result" ] || fail 'unimplemented apply silently succeeded'

chmod 644 "$tmp/body.json"
result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/body.json" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 97 ] && [ -z "$result" ] || fail 'insecure REST body permissions were not rejected'
chmod 600 "$tmp/body.json"
ln -s "$tmp/body.json" "$tmp/body-link.json" || error 'body symlink fixture unavailable'
result=$(APISIX_TEST_OPERATION=create RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" \
  probe routes "$tmp/body-link.json" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 95 ] && [ -z "$result" ] || fail 'symlinked REST body file was not rejected'
result=$(APISIX_TEST_OPERATION=list RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=standalone-api \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" probe routes 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"id":"snap-a","uri":"/a"}
{"id":"snap-b","uri":"/b"}' ] ||
  fail "snapshot list did not filter the /configs resource (status $status)"
result=$(APISIX_TEST_OPERATION=get RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=standalone-api \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" probe routes snap-b 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"id":"snap-b","uri":"/b"}' ] ||
  fail "snapshot get did not select one ID (status $status)"
result=$(APISIX_TEST_OPERATION=get RSUDO_APISIX_SCOPE=host \
  RSUDO_APISIX_DEPLOYMENT=standalone-api \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" probe routes missing 2>"$tmp/stderr")
status=$?
[ "$status" -eq 13 ] && [ -z "$result" ] ||
  fail 'snapshot missing ID was not rejected distinctly'
cid=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
result=$(APISIX_TEST_OPERATION=list RSUDO_APISIX_SCOPE=docker \
  RSUDO_APISIX_CONTAINER_ID="$cid" \
  RSUDO_APISIX_DEPLOYMENT=traditional-admin \
  RSUDO_APISIX_ADMIN_URL="http://127.0.0.1:$port" \
  RSUDO_APISIX_HEADER_FILE="$tmp/admin-header" probe routes 2>"$tmp/stderr")
status=$?
[ "$status" -eq 4 ] && [ -z "$result" ] ||
  fail 'REST request ignored explicit container scope'


grep -F 'test-secret-credential-never-in-process-argv' "$tmp/argv" >/dev/null &&
  fail 'secret was placed in curl argv'
grep -F '@' "$tmp/argv" >/dev/null ||
  fail 'credential header not loaded from remote file'
grep -F 'test-secret-credential-never-in-process-argv' "$tmp/stderr" >/dev/null &&
  fail 'secret was leaked to diagnostics'

result=$(probe services "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"services":[]}' ] ||
  fail 'service GET failed'
result=$(probe upstreams "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"upstreams":[]}' ] ||
  fail 'upstream GET failed'

printf 'X-API-KEY: %s\n' incorrect-secret > "$tmp/admin-header"
result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 22 ] && [ -z "$result" ] ||
  fail 'HTTP 401 did not propagate curl failure without response-body leak'

chmod 644 "$tmp/admin-header"
result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 48 ] && [ -z "$result" ] ||
  fail 'group/world readable key file was not rejected'

chmod 600 "$tmp/admin-header"
printf '%s\n' 'Authorization: Bearer bad' > "$tmp/admin-header"
result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 49 ] && [ -z "$result" ] ||
  fail 'wrong header type was not rejected'

result=$(probe unknown "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 45 ] && [ -z "$result" ] ||
  fail 'unknown resource was not rejected'
result=$(probe routes "$tmp/admin-header" not-a-port 2>"$tmp/stderr")
status=$?
[ "$status" -eq 50 ] && [ -z "$result" ] ||
  fail 'invalid port was not rejected'
result=$(probe routes relative-header "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 46 ] && [ -z "$result" ] ||
  fail 'relative credential file was not rejected'

printf 'X-API-KEY: %s\n' restored > "$tmp/admin-header"
ln -s -- "$tmp/admin-header" "$tmp/symlink-header" ||
  error 'symlink case cannot be constructed'
result=$(probe routes "$tmp/symlink-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 47 ] && [ -z "$result" ] ||
  fail 'credential symlink was not rejected'

# A single newline is not sufficient when binary/control bytes are present.
# Some POSIX read implementations discard NUL; the production byte-count
# check must reject what curl would otherwise read from the header file.
printf 'X-API-KEY: correct\000\n' > "$tmp/admin-header"
result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 49 ] && [ -z "$result" ] ||
  fail 'credential file with embedded NUL was not rejected'

printf 'X-API-KEY: correct\nX-Extra: injected\n' > "$tmp/admin-header"
result=$(probe routes "$tmp/admin-header" "$port" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 49 ] && [ -z "$result" ] ||
  fail 'multi-line credential header was not rejected'

printf '%s\n' "$TEST_ID: PASS (real curl and m; read/write methods, protected body file, synthetic rsudo boundary)"
