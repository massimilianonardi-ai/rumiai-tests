#!/bin/sh
# Real m -> rsudo -> OpenSSH password auth -> remote sudo password -> sh
# -> curl GET with root-only header file -> first a synthetic HTTP server,
# then pinned official APISIX 3.16/3.19 sharing only the SSH network namespace.
# Disposable Ubuntu/OpenSSH and gateway containers; no site credentials.
TEST_ID=rumiai-os/rsudo/apisix-admin-rsudo-ssh-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

cid=
apisix_cid=
tmp=
cleanup()
{
  [ -z "$apisix_cid" ] || docker rm -f "$apisix_cid" >/dev/null 2>&1 || :
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'cannot resolve test directory'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'checkout resolver missing'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'explicit product checkout invalid' ;;
  *) error 'target checkout failed' ;;
esac

[ "$(uname -s)" = Linux ] || skip 'Linux Docker test only'
command -v docker >/dev/null 2>&1 || skip 'Docker unavailable'
command -v ssh >/dev/null 2>&1 || skip 'OpenSSH client unavailable'

# The workflow provisions digest-pinned releases; never silently substitute
# a tag or claim real APISIX coverage using the synthetic HTTP fixture.
images='apache/apisix@sha256:b921bdef3cfb2ca72e483d643f40e7843683ff8e188984489c2020f17654ee88
apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'
for image in $images
do
  docker image inspect "$image" >/dev/null 2>&1 ||
    skip "pinned APISIX image not provisioned: $image"
done

tmp=${TMPDIR:-/tmp}/rsudo-apisix-ssh-real-$$
umask 077
mkdir -p -- "$tmp/bin" "$tmp/image" || error 'fixture creation failed'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture absolute path missing'

# Build a *throwaway* SSH/sudo target; nothing is installed on the host.
# All passwords, host keys and Admin API credentials are synthetic.
cat > "$tmp/image/Dockerfile" <<'DOCKERFILE'
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server sudo curl python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/sh rsudoapitest \
    && echo 'rsudoapitest:rsudo-test-only-password' | chpasswd \
    && printf 'rsudoapitest ALL=(root) ALL\n' > /etc/sudoers.d/rsudoapitest \
    && chmod 440 /etc/sudoers.d/rsudoapitest \
    && mkdir -p /run/sshd \
    && ssh-keygen -A
COPY server.py /opt/server.py
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod 700 /opt/entrypoint.sh
EXPOSE 22
CMD ["/opt/entrypoint.sh"]
DOCKERFILE

cat > "$tmp/image/server.py" <<'PY_SERVER'
from http.server import HTTPServer, BaseHTTPRequestHandler
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass
    def do_GET(self):
        if self.path != '/apisix/admin/routes':
            status, body = 404, b'{"error":"not-found"}'
        elif self.headers.get('X-API-KEY') != 'synthetic-admin-key':
            status, body = 401, b'{"error":"denied"}'
        else:
            status, body = 200, b'{"routes":[{"id":"ssh-sudo-proof"}]}'
        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)
HTTPServer(('127.0.0.1', 9180), Handler).serve_forever()
PY_SERVER

cat > "$tmp/image/entrypoint.sh" <<'ENTRYPOINT'
#!/bin/sh
set -e
umask 077
printf '%s\n' 'X-API-KEY: synthetic-admin-key' > /root/rsudo-test-api-header
chmod 600 /root/rsudo-test-api-header
python3 /opt/server.py &
printf '%s\n' "$!" > /run/rsudo-test-http.pid
exec /usr/sbin/sshd -D -e -o PermitRootLogin=no \
  -o PasswordAuthentication=yes -o PubkeyAuthentication=no -o UsePAM=no
ENTRYPOINT

image_tag="rsudo-apix-test-ssh-local:$(date +%s)-$$"
docker build --quiet --tag "$image_tag" "$tmp/image" > "$tmp/image-id" ||
  error 'isolated SSH/sudo target image build failed'
cid=$(docker run -d --network bridge --publish 127.0.0.1::22 \
  --security-opt no-new-privileges=false "$image_tag") ||
  error 'isolated SSH/sudo container start failed'
[ -n "$cid" ] || error 'Docker returned empty container identity'

mapping=$(docker port "$cid" 22/tcp) || error 'SSH port mapping unavailable'
port=${mapping##*:}
case "$port" in
  ''|*[!0-9]*) error 'SSH assigned an invalid port' ;;
esac
hostkey=$(docker exec "$cid" cat /etc/ssh/ssh_host_ed25519_key.pub) ||
  error 'cannot read ephemeral test SSH host public key'
set -- $hostkey
[ "$1" = ssh-ed25519 ] && [ -n "$2" ] ||
  error 'ephemeral SSH host key malformed'
printf '%s %s %s\n' rsudo-apix-ephemeral "$1" "$2" > "$tmp/known_hosts" ||
  error 'cannot write pinned test host key'

cat > "$tmp/ssh_config" <<EOF_SSH_CONFIG
Host rsudo-apix-ephemeral
  HostName 127.0.0.1
  HostKeyAlias rsudo-apix-ephemeral
  Port $port
  UserKnownHostsFile $tmp/known_hosts
  StrictHostKeyChecking yes
  PreferredAuthentications password
  PasswordAuthentication yes
  PubkeyAuthentication no
  KbdInteractiveAuthentication no
  IdentitiesOnly yes
  ControlMaster no
  ControlPath none
  ConnectTimeout 4
EOF_SSH_CONFIG

ssh_bin=$(command -v ssh) || error 'OpenSSH client unavailable'
cat > "$tmp/bin/ssh" <<'SSH_WRAPPER'
#!/bin/sh
exec "$RSUDO_TEST_REAL_SSH" -F "$RSUDO_TEST_SSH_CONFIG" "$@"
SSH_WRAPPER
cat > "$tmp/bin/rsudo-apisix-ssh-live-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo" || exit 82
loadsyslib "rsudo/rsudo-mod-apisix" || exit 83

RSUDO_HOST=rsudo-apix-ephemeral
RSUDO_USER=rsudoapitest
RSUDO_PASSWORD=rsudo-test-only-password
RSUDO_INTERACTIVE=
RSUDO_ASKPASS=
case "${1:-routes}" in
  runtime) rsudo_mod_apisix_runtime /usr/local/apisix ;;
  routes|configs) rsudo_mod_apisix_admin_read "${1:-routes}" /root/rsudo-test-api-header 9180 ;;
  *) exit 84 ;;
esac
PROBE
chmod 700 -- "$tmp/bin/ssh" "$tmp/bin/rsudo-apisix-ssh-live-probe" ||
  error 'SSH wrapper or real-m probe not executable'

run_probe()
{
  RSUDO_TEST_REAL_SSH="$ssh_bin" RSUDO_TEST_SSH_CONFIG="$tmp/ssh_config" \
  PATH="$tmp/bin:$PATH" "$root/m" rsudo-apisix-ssh-live-probe "$@"
}

# Wait only for the ephemeral SSH daemon, not a production network service.
tries=0
until docker exec "$cid" sh -c 'test -e /run/sshd.pid' >/dev/null 2>&1
do
  [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] ||
    error 'SSH/sudo test container exited'
  tries=$((tries + 1))
  [ "$tries" -lt 50 ] || error 'SSH daemon did not start'
  sleep 0.1
done

result=$(run_probe 2>"$tmp/stderr")
status=$?
if [ "$status" -ne 0 ]
then
  # Synthetic test passwords only; don't print them in logs.
  tail -n 8 "$tmp/stderr" >&2
  fail "real rsudo SSH/sudo Admin GET failed with status $status"
fi
[ "$result" = '{"routes":[{"id":"ssh-sudo-proof"}]}' ] ||
  fail 'real rsudo SSH/sudo did not preserve remote curl JSON response'
grep -F 'synthetic-admin-key' "$tmp/stderr" >/dev/null &&
  fail 'Admin API credential leaked to diagnostics'
grep -F 'rsudo-test-only-password' "$tmp/stderr" >/dev/null &&
  fail 'test SSH/sudo password leaked to diagnostics'

# The remote file is owned by root. Success requires that the true sudo
# execution kept the caller's static heredoc stdin intact after auth.
docker exec "$cid" sh -c \
  'test "$(stat -c %U /root/rsudo-test-api-header)" = root &&
   test "$(stat -c %a /root/rsudo-test-api-header)" = 600' ||
  fail 'remote protected header-file boundary was invalid'

# Wrong key should be an actual HTTP response failure through both transports.
docker exec "$cid" sh -c \
  "printf '%s\\n' 'X-API-KEY: incorrect-test' > /root/rsudo-test-api-header" ||
  error 'cannot update synthetic remote test credential'
result=$(run_probe 2>"$tmp/stderr")
status=$?
[ "$status" -eq 22 ] && [ -z "$result" ] ||
  fail 'remote HTTP 401 did not propagate through real rsudo'

# The documented rsudo noninteractive path must also preserve stdin when the
# remote sudo does not ask for a password, despite SSH using password auth.
# No modifications escape this disposable container.
docker exec "$cid" sh -c \
  "printf 'rsudoapitest ALL=(root) NOPASSWD: ALL\n' > /etc/sudoers.d/rsudoapitest &&
   chmod 440 /etc/sudoers.d/rsudoapitest" ||
  error 'cannot configure isolated sudo NOPASSWD case'
docker exec "$cid" sh -c \
  "printf '%s\n' 'X-API-KEY: synthetic-admin-key' > /root/rsudo-test-api-header" ||
  error 'cannot restore synthetic remote API key'

result=$(run_probe 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = '{"routes":[{"id":"ssh-sudo-proof"}]}' ] ||
  fail 'rsudo lost remote command stdin with NOPASSWD sudo'
grep -F 'synthetic-admin-key' "$tmp/stderr" >/dev/null &&
  fail 'credential leaked during NOPASSWD rsudo'

# Stop only the synthetic HTTP fixture. Keep the same authenticated
# OpenSSH/sudo target alive and replace its loopback HTTP backend with a real
# pinned APISIX gateway in the *same network namespace*.
docker exec "$cid" sh -c 'kill -TERM "$(cat /run/rsudo-test-http.pid)"' ||
  error 'cannot stop disposable synthetic HTTP server'
tries=0
while docker exec "$cid" curl -q --silent --noproxy '*' --proxy '' \
  --connect-timeout 1 --max-time 2 \
  --url http://127.0.0.1:9180/apisix/admin/routes >/dev/null 2>&1
do
  tries=$((tries + 1))
  [ "$tries" -lt 20 ] ||
    fail 'synthetic HTTP listener remained bound before real gateway test'
  sleep 0.2
done

# The only network port published to the host is the ephemeral SSH port.
# A different container has the APISIX process/filesystem namespace, so
# successful remote curl cannot, by itself, establish APISIX runtime identity.
cat > "$tmp/config.yaml" <<'APISIX_CONFIG'
deployment:
  role: traditional
  role_traditional:
    config_provider: yaml
  admin:
    admin_key_required: true
    admin_key:
      - name: test-viewer
        key: synthetic-admin-key
        role: viewer
    admin_listen:
      ip: 127.0.0.1
      port: 9180
APISIX_CONFIG
chmod 644 "$tmp/config.yaml" || error 'real APISIX configuration fixture unreadable'

for image in $images
do
  # Exercise sudo both with a password and with NOPASSWD against the real
  # gateway, not just against the earlier synthetic HTTP server.
  docker exec "$cid" sh -c \
    "printf 'rsudoapitest ALL=(root) ALL\n' > /etc/sudoers.d/rsudoapitest &&
     chmod 440 /etc/sudoers.d/rsudoapitest" ||
    error 'cannot restore password-required sudo fixture'
  docker exec "$cid" sh -c \
    "printf '%s\n' 'X-API-KEY: synthetic-admin-key' > /root/rsudo-test-api-header" ||
    error 'cannot restore protected test Admin key'

  apisix_cid=$(docker run -d --network "container:$cid" \
    --cap-drop ALL --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    -e APISIX_STAND_ALONE=true "$image") ||
    error 'cannot start official APISIX sharing the SSH target network namespace'
  [ -n "$apisix_cid" ] || error 'official APISIX container ID missing'

  # Inspect the *actual* Linux namespace identities from both containers.
  # Docker's selected network mode is manager evidence, not proof of
  # process/filesystem ownership. Matching network inode with distinct
  # process and mount inodes confirms the boundary exercised below.
  manager_network_mode=$(docker inspect --format '{{.HostConfig.NetworkMode}}' "$apisix_cid") ||
    error 'cannot inspect selected gateway network mode'
  [ "$manager_network_mode" = "container:$cid" ] ||
    fail 'gateway did not retain the expected manager-selected network mode'

  ssh_netns=$(docker exec "$cid" readlink /proc/self/ns/net) ||
    error 'SSH target network namespace unobservable'
  apisix_netns=$(docker exec "$apisix_cid" readlink /proc/self/ns/net) ||
    error 'gateway network namespace unobservable'
  [ "$ssh_netns" = "$apisix_netns" ] ||
    fail 'gateway and SSH target do not share the expected network namespace'

  ssh_pidns=$(docker exec "$cid" readlink /proc/self/ns/pid) ||
    error 'SSH target process namespace unobservable'
  apisix_pidns=$(docker exec "$apisix_cid" readlink /proc/self/ns/pid) ||
    error 'gateway process namespace unobservable'
  [ "$ssh_pidns" != "$apisix_pidns" ] ||
    fail 'gateway unexpectedly shares the SSH target process namespace'

  ssh_mntns=$(docker exec "$cid" readlink /proc/self/ns/mnt) ||
    error 'SSH target mount namespace unobservable'
  apisix_mntns=$(docker exec "$apisix_cid" readlink /proc/self/ns/mnt) ||
    error 'gateway mount namespace unobservable'
  [ "$ssh_mntns" != "$apisix_mntns" ] ||
    fail 'gateway unexpectedly shares the SSH target mount namespace'
  unset ssh_netns apisix_netns ssh_pidns apisix_pidns ssh_mntns apisix_mntns manager_network_mode

  # Prove Docker still owns the selected config bind mount. The existence
  # of this mount does NOT prove the running gateway loaded its current bytes.
  config_mount=$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/usr/local/apisix/conf/config.yaml"}}{{.Type}}:{{.RW}}{{end}}{{end}}' "$apisix_cid") ||
    error 'cannot inspect selected gateway configuration mount'
  [ "$config_mount" = 'bind:false' ] ||
    fail 'selected gateway did not retain the read-only configuration bind mount'
  unset config_mount

  tries=0
  while [ "$tries" -lt 30 ]
  do
    if docker exec "$cid" curl -q --silent --fail --noproxy '*' --proxy '' \
      --connect-timeout 1 --max-time 2 \
      --header '@/root/rsudo-test-api-header' \
      --url http://127.0.0.1:9180/apisix/admin/configs >/dev/null 2>&1
    then
      break
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$apisix_cid" 2>/dev/null)" != true ]
    then
      docker logs "$apisix_cid" >&2 || :
      fail 'official APISIX exited before Admin API became ready'
    fi
    tries=$((tries + 1))
    sleep 1
  done
  [ "$tries" -lt 30 ] || {
    docker logs "$apisix_cid" >&2 || :
    fail 'official APISIX Admin API not ready in SSH network namespace'
  }

  # End-to-end composed path: real m -> OpenSSH -> sudo password -> curl
  # -> real APISIX. The API-driven /configs resource is not a fake /routes.
  result=$(run_probe configs 2>"$tmp/stderr")
  status=$?
  [ "$status" -eq 0 ] || fail "composed password sudo/real APISIX GET status $status"
  case "$result" in
    *'"routes_conf_version"'*) : ;;
    *) fail 'routes_conf_version absent: real APISIX snapshot was not returned through composed SSH/sudo' ;;
  esac
  case "$result" in
    *'"services_conf_version"'*) : ;;
    *) fail 'services_conf_version absent: real APISIX snapshot was not returned through composed SSH/sudo' ;;
  esac

  # The SSH target does not share the gateway process or mount namespace.
  # Runtime identity must fail closed despite successful loopback GET.
  result=$(run_probe runtime 2>"$tmp/stderr")
  status=$?
  [ "$status" -eq 32 ] && [ -z "$result" ] ||
    fail 'reachable Admin API was incorrectly treated as a local APISIX process'

  docker exec "$cid" sh -c \
    "printf '%s\n' 'X-API-KEY: incorrect-test' > /root/rsudo-test-api-header" ||
    error 'cannot set incorrect real APISIX key'
  result=$(run_probe configs 2>"$tmp/stderr")
  status=$?
  [ "$status" -eq 22 ] && [ -z "$result" ] ||
    fail 'real APISIX wrong-key error did not propagate through OpenSSH/sudo'

  docker exec "$cid" sh -c \
    "printf '%s\n' 'X-API-KEY: synthetic-admin-key' > /root/rsudo-test-api-header" ||
    error 'cannot restore real APISIX key'
  docker exec "$cid" sh -c \
    "printf 'rsudoapitest ALL=(root) NOPASSWD: ALL\n' > /etc/sudoers.d/rsudoapitest &&
     chmod 440 /etc/sudoers.d/rsudoapitest" ||
    error 'cannot configure real APISIX NOPASSWD sudo fixture'
  result=$(run_probe configs 2>"$tmp/stderr")
  status=$?
  [ "$status" -eq 0 ] || fail 'composed NOPASSWD/real APISIX GET failed'
  case "$result" in
    *'"routes_conf_version"'*) : ;;
    *) fail 'routes_conf_version absent: real APISIX snapshot was lost through NOPASSWD SSH/sudo' ;;
  esac
  case "$result" in
    *'"services_conf_version"'*) : ;;
    *) fail 'services_conf_version absent: real APISIX snapshot was lost through NOPASSWD SSH/sudo' ;;
  esac
  grep -F 'synthetic-admin-key' "$tmp/stderr" >/dev/null &&
    fail 'real APISIX credential exposed through remote diagnostics'
  grep -F 'rsudo-test-only-password' "$tmp/stderr" >/dev/null &&
    fail 'rsudo password exposed through remote diagnostics'

  docker rm -f "$apisix_cid" >/dev/null 2>&1 ||
    error 'cannot remove isolated real APISIX'
  apisix_cid=
done

printf '%s\n' "$TEST_ID: PASS (real OpenSSH/sudo -> synthetic HTTP and official APISIX 3.16/3.19)"
