#!/bin/sh
# Protects K03 sections 3/4/6/9 and K04's implemented client-credentials
# acquisition + protected remote token-store inspection through real m.
# Only external SSH/sudo is substituted; curl/TLS and OAuth fixture are real.
# This is NOT an actual Keycloak/remote SSH authentication test.
TEST_ID=rumiai-os/rsudo/keycloak-auth-transport.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp= pid=
cleanup()
{
  if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
  fi
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'own path unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver missing'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'selected product checkout invalid' ;;
  *) error 'product resolver failed' ;;
esac

for cmd in python3 curl jq openssl mktemp base64
do
  command -v "$cmd" >/dev/null 2>&1 || skip "$cmd prerequisite unavailable"
done
module=$root/lib/sys/sh/rsudo/rsudo-mod-keycloak.lib.sh
manual=$root/res/sys/manual/rsudo-mod-keycloak.lib.sh
[ -r "$module" ] && [ ! -x "$module" ] && [ -r "$manual" ] ||
  fail 'module/manual absent'
command -p sh -n "$module" || fail 'module POSIX syntax invalid'
grep -F 'rsudo_mod_keycloak_auth' "$manual" >/dev/null ||
  fail 'auth interface missing from module manual'

tmp=${TMPDIR:-/tmp}/keycloak-auth-test-$$
umask 077
mkdir -p -- "$tmp/bin" || error 'cannot create private fixture'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'cannot canonicalize fixture'

cat > "$tmp/openssl.cnf" <<'CERTCONF'
[req]
distinguished_name = dn
prompt = no
x509_extensions = ext
[dn]
CN = 127.0.0.1
[ext]
subjectAltName = IP:127.0.0.1
basicConstraints = critical,CA:TRUE
keyUsage = digitalSignature,keyCertSign
CERTCONF
openssl req -x509 -newkey rsa:2048 -nodes \
  -config "$tmp/openssl.cnf" -extensions ext -days 1 \
  -keyout "$tmp/server.key" -out "$tmp/server.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'TLS test certificate preparation failed'
chmod 600 "$tmp/server.key" "$tmp/server.pem" ||
  error 'TLS fixture permissions unavailable'

cat > "$tmp/server.py" <<'PYTHON'
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import parse_qs
import base64
import json
import ssl
import sys

class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def response(self, status, data):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not self.path.endswith("/.well-known/openid-configuration"):
            self.response(404, {"error": "not_found"})
            return
        root = "https://127.0.0.1:" + str(self.server.server_port)
        self.response(200, {
            "issuer": root + "/realms/master",
            "token_endpoint": root + "/realms/master/protocol/openid-connect/token"
        })

    def do_POST(self):
        if self.path != "/realms/master/protocol/openid-connect/token":
            self.response(404, {"error": "not_found"})
            return
        body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        args = parse_qs(body.decode("utf-8"))
        auth = self.headers.get("Authorization", "")
        basic = "Basic " + base64.b64encode(b"service:protected-k04-secret").decode()
        valid = args.get("grant_type") == ["client_credentials"] and (
            auth == basic or
            (args.get("client_id") == ["service"] and
             args.get("client_secret") == ["protected-k04-secret"])
        )
        if not valid:
            self.response(401, {"error": "invalid_client"})
            return
        self.response(200, {
            "access_token": "SENSITIVE-K04-ACCESS-TOKEN",
            "token_type": "Bearer",
            "expires_in": 60
        })

server = HTTPServer(("127.0.0.1", 0), Handler)
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain(sys.argv[2], sys.argv[3])
server.socket = context.wrap_socket(server.socket, server_side=True)
Path(sys.argv[1]).write_text(str(server.server_port))
server.serve_forever()
PYTHON

cat > "$tmp/bin/keycloak-auth-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 91
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 92
loadsyslib "rsudo/rsudo-mod-keycloak" || exit 93
rsudo()
{
  [ "$1" = -- ] || return 94
  shift
  "$@"
}
rsudo_mod_keycloak_auth "$@"
PROBE
real_curl=$(command -v curl)
cat > "$tmp/bin/curl" <<'WRAPPER'
#!/bin/sh
printf '%s\n' "$@" >> "$K04_CURL_ARGV_LOG"
exec "$K04_CURL_REAL" "$@"
WRAPPER
chmod 700 "$tmp/bin/keycloak-auth-probe" "$tmp/bin/curl" ||
  error 'probe setup failed'

python3 -u "$tmp/server.py" "$tmp/port" "$tmp/server.pem" "$tmp/server.key" \
  >"$tmp/server.out" 2>"$tmp/server.err" &
pid=$!
tries=0
while [ ! -s "$tmp/port" ] && [ "$tries" -lt 60 ]
do
  sleep 0.1
  tries=$((tries + 1))
done
[ -s "$tmp/port" ] || {
  cat "$tmp/server.err" >&2
  error 'HTTPS fixture failed to start'
}
port=$(cat "$tmp/port") || error 'HTTPS port unavailable'
base=https://127.0.0.1:$port
printf 'protected-k04-secret\n' > "$tmp/secret"
chmod 600 "$tmp/secret"

probe()
{
  K04_CURL_ARGV_LOG="$tmp/argv" K04_CURL_REAL="$real_curl" \
    PATH="$tmp/bin:$PATH" "$root/m" keycloak-auth-probe "$@"
}
acquire()
{
  probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id service \
    --client-auth "$1" --client-secret-file "$2" \
    --token-store "$3" --ca-file "$tmp/server.pem"
}

result=$(acquire client-secret-basic "$tmp/secret" "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] && [ "$result" = \
  '{"stored":true,"grant":"client_credentials","server_validated":false}' ] || {
  cat "$tmp/err" >&2
  fail "Basic client credentials did not store token ($status)"
}
[ "$(jq -r '.access_token' "$tmp/basic-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail 'Basic token store missing provider content'
[ ! -L "$tmp/basic-store" ] || fail 'token store created as symlink'
mode=$(LC_ALL=C ls -ld "$tmp/basic-store"); mode=${mode%% *}
[ "$mode" = '-rw-------' ] || fail 'token store not private'
grep -F 'protected-k04-secret' "$tmp/argv" >/dev/null &&
  fail 'client secret exposed in curl argv'
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/err" >/dev/null &&
  fail 'access token exposed in diagnostics'

result=$(probe status --token-file "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] && \
  [ "$result" = '{"stored":true,"server_validated":false}' ] ||
  fail 'protected token-store status failed'

result=$(acquire client-secret-post "$tmp/secret" "$tmp/post-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] || fail 'POST client credentials failed'
[ "$(jq -r '.access_token' "$tmp/post-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail 'POST flow response invalid'
grep -F 'protected-k04-secret' "$tmp/argv" >/dev/null &&
  fail 'POST secret exposed in curl argv'
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/err" >/dev/null &&
  fail 'POST access token exposed in diagnostics'

result=$(acquire client-secret-basic "$tmp/secret" "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 87 ] && [ -z "$result" ] ||
  fail 'existing token store was overwritten or accepted'

printf 'wrong-secret\n' > "$tmp/secret"
result=$(acquire client-secret-basic "$tmp/secret" "$tmp/denied-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 71 ] && [ -z "$result" ] && [ ! -e "$tmp/denied-store" ] ||
  fail 'bad Basic client secret was accepted or misclassified'

chmod 644 "$tmp/secret"
result=$(acquire client-secret-post "$tmp/secret" "$tmp/insecure-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] && [ ! -e "$tmp/insecure-store" ] ||
  fail 'world-readable secret not rejected'
chmod 600 "$tmp/secret"
printf 'protected-k04-secret\n' > "$tmp/secret"

# Reject untrusted TLS certificates without an explicit CA or system trust.
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/untrusted-tls" 2>"$tmp/err")
status=$?
[ "$status" -eq 75 ] && [ ! -e "$tmp/untrusted-tls" ] ||
  fail "TLS trust bypass or misclassified certificate error ($status)"

chmod 644 "$tmp/basic-store"
result=$(probe status --token-file "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail 'world-readable access token store was accepted'
chmod 600 "$tmp/basic-store"

ln -s "$tmp/basic-store" "$tmp/token-symlink" ||
  error 'cannot construct symlink case'
result=$(probe status --token-file "$tmp/token-symlink" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail 'token-store symlink was accepted'

result=$(probe acquire --server "$base" --issuer-realm other \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/bad-issuer-store" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 67 ] && [ ! -e "$tmp/bad-issuer-store" ] ||
  fail 'mismatched discovery issuer was accepted'

result=$(probe acquire --server "http://127.0.0.1:$port" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/insecure-http" 2>"$tmp/err")
status=$?
[ "$status" -eq 65 ] && [ -z "$result" ] ||
  fail 'non-HTTPS issuer was accepted'

result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode device --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/not-supported" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 73 ] && [ ! -e "$tmp/not-supported" ] ||
  fail 'unimplemented grant not rejected'

printf '%s\n' "$TEST_ID: PASS (real m, POSIX shell and HTTPS curl; SSH/sudo substituted)"
