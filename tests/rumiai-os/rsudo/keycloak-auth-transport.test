#!/bin/sh
# Protects K03 sections 3/4/6/9 and K04's implemented client-credentials
# acquisition + protected remote token-store inspection through real m.
# Only external SSH/sudo is substituted; curl/TLS and OAuth fixture are real.
# This is NOT an actual Keycloak/remote SSH authentication test.
TEST_ID=rumiai-os/rsudo/keycloak-auth-transport.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp= pid=
cleanup()
{
  if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
  fi
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'own path unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver missing'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'selected product checkout invalid' ;;
  *) error 'product resolver failed' ;;
esac

for cmd in python3 curl jq openssl mktemp base64
do
  command -v "$cmd" >/dev/null 2>&1 || skip "$cmd prerequisite unavailable"
done
module=$root/lib/sys/sh/rsudo/rsudo-mod-keycloak.lib.sh
manual=$root/res/sys/manual/rsudo-mod-keycloak.lib.sh
[ -r "$module" ] && [ ! -x "$module" ] && [ -r "$manual" ] ||
  fail 'module/manual absent'
command -p sh -n "$module" || fail 'module POSIX syntax invalid'
grep -F 'rsudo_mod_keycloak_auth' "$manual" >/dev/null ||
  fail 'auth interface missing from module manual'

tmp=${TMPDIR:-/tmp}/keycloak-auth-test-$$
umask 077
mkdir -p -- "$tmp/bin" || error 'cannot create private fixture'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'cannot canonicalize fixture'

cat > "$tmp/openssl.cnf" <<'CERTCONF'
[req]
distinguished_name = dn
prompt = no
x509_extensions = ext
[dn]
CN = 127.0.0.1
[ext]
subjectAltName = IP:127.0.0.1
basicConstraints = critical,CA:TRUE
keyUsage = digitalSignature,keyCertSign
CERTCONF
openssl req -x509 -newkey rsa:2048 -nodes \
  -config "$tmp/openssl.cnf" -extensions ext -days 1 \
  -keyout "$tmp/server.key" -out "$tmp/server.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'TLS test certificate preparation failed'
chmod 600 "$tmp/server.key" "$tmp/server.pem" ||
  error 'TLS fixture permissions unavailable'

cat > "$tmp/server.py" <<'PYTHON'
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import parse_qs
import base64
import json
import ssl
import sys

class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def response(self, status, data):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not self.path.endswith("/.well-known/openid-configuration"):
            self.response(404, {"error": "not_found"})
            return
        root = "https://127.0.0.1:" + str(self.server.server_port)
        self.response(200, {
            "issuer": root + "/realms/master",
            "token_endpoint": root + "/realms/master/protocol/openid-connect/token",
            "revocation_endpoint": root + "/realms/master/protocol/openid-connect/revoke"
        })

    def do_POST(self):
        if self.path not in (
                "/realms/master/protocol/openid-connect/token",
                "/realms/master/protocol/openid-connect/revoke"):
            self.response(404, {"error": "not_found"})
            return
        revoke = self.path.endswith("/revoke")
        body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        args = parse_qs(body.decode("utf-8"))
        auth = self.headers.get("Authorization", "")
        basic = "Basic " + base64.b64encode(b"service:protected-k04-secret").decode()
        client_valid = (
            auth == basic or
            (args.get("client_id") == ["service"] and
             args.get("client_secret") == ["protected-k04-secret"])
        )
        if not client_valid:
            # Exercise both Keycloak-observed 401 unauthorized_client (Basic)
            # and conventional invalid_client (form-client authentication).
            self.response(401, {
                "error": "unauthorized_client" if auth else "invalid_client"
            })
            return
        if revoke:
            if (args.get("token_type_hint") not in (
                    ["access_token"], ["refresh_token"]) or
                    args.get("token") not in (
                        ["SENSITIVE-K04-ACCESS-TOKEN"],
                        ["SENSITIVE-K04-REFRESH-TOKEN"],
                        ["SENSITIVE-K04-ROTATED-REFRESH-TOKEN"])):
                self.response(400, {"error": "invalid_request"})
                return
            self.response(200, {})
            return
        grant = args.get("grant_type")
        if grant == ["password"]:
            if (args.get("username") != ["k04tester"] or
                    args.get("password") != ["password with spaces"]):
                self.response(400, {"error": "invalid_grant"})
                return
        elif grant == ["refresh_token"]:
            if args.get("refresh_token") not in (
                    ["SENSITIVE-K04-REFRESH-TOKEN"],
                    ["SENSITIVE-K04-ROTATED-REFRESH-TOKEN"]):
                self.response(400, {"error": "invalid_grant"})
                return
            self.response(200, {
                "access_token": "SENSITIVE-K04-ROTATED-ACCESS-TOKEN",
                "refresh_token": "SENSITIVE-K04-ROTATED-REFRESH-TOKEN",
                "token_type": "Bearer",
                "expires_in": 60
            })
            return
        elif grant != ["client_credentials"]:
            self.response(400, {"error": "unsupported_grant_type"})
            return
        self.response(200, {
            "access_token": "SENSITIVE-K04-ACCESS-TOKEN",
            "refresh_token": "SENSITIVE-K04-REFRESH-TOKEN" if grant == ["password"] else None,
            "token_type": "Bearer",
            "expires_in": 60
        })

server = HTTPServer(("127.0.0.1", 0), Handler)
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain(sys.argv[2], sys.argv[3])
server.socket = context.wrap_socket(server.socket, server_side=True)
Path(sys.argv[1]).write_text(str(server.server_port))
server.serve_forever()
PYTHON

cat > "$tmp/bin/keycloak-auth-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 91
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 92
loadsyslib "rsudo/rsudo-mod-keycloak" || exit 93
rsudo()
{
  [ "$1" = -- ] || return 94
  shift
  "$@"
}
rsudo_mod_keycloak_auth "$@"
PROBE
real_curl=$(command -v curl)
cat > "$tmp/bin/curl" <<'WRAPPER'
#!/bin/sh
printf '%s\n' "$@" >> "$K04_CURL_ARGV_LOG"
exec "$K04_CURL_REAL" "$@"
WRAPPER
chmod 700 "$tmp/bin/keycloak-auth-probe" "$tmp/bin/curl" ||
  error 'probe setup failed'

python3 -u "$tmp/server.py" "$tmp/port" "$tmp/server.pem" "$tmp/server.key" \
  >"$tmp/server.out" 2>"$tmp/server.err" &
pid=$!
tries=0
while [ ! -s "$tmp/port" ] && [ "$tries" -lt 60 ]
do
  sleep 0.1
  tries=$((tries + 1))
done
[ -s "$tmp/port" ] || {
  cat "$tmp/server.err" >&2
  error 'HTTPS fixture failed to start'
}
port=$(cat "$tmp/port") || error 'HTTPS port unavailable'
base=https://127.0.0.1:$port
printf 'protected-k04-secret\n' > "$tmp/secret"
chmod 600 "$tmp/secret"

probe()
{
  K04_CURL_ARGV_LOG="$tmp/argv" K04_CURL_REAL="$real_curl" \
    PATH="$tmp/bin:$PATH" "$root/m" keycloak-auth-probe "$@"
}
acquire()
{
  probe acquire --server "$base" --issuer-realm master \
    --auth-mode client-credentials --client-id service \
    --client-auth "$1" --client-secret-file "$2" \
    --token-store "$3" --ca-file "$tmp/server.pem"
}

result=$(acquire client-secret-basic "$tmp/secret" "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] && [ "$result" = \
  '{"stored":true,"grant":"client_credentials","server_validated":false}' ] || {
  cat "$tmp/err" >&2
  fail "Basic client credentials did not store token ($status)"
}
[ "$(jq -r '.access_token' "$tmp/basic-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail 'Basic token store missing provider content'
[ ! -L "$tmp/basic-store" ] || fail 'token store created as symlink'
mode=$(LC_ALL=C ls -ld "$tmp/basic-store"); mode=${mode%% *}
[ "$mode" = '-rw-------' ] || fail 'token store not private'
grep -F 'protected-k04-secret' "$tmp/argv" >/dev/null &&
  fail 'client secret exposed in curl argv'
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/err" >/dev/null &&
  fail 'access token exposed in diagnostics'

result=$(probe status --token-file "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] && \
  [ "$result" = '{"stored":true,"server_validated":false}' ] ||
  fail 'protected token-store status failed'

# A safe basename is not enough: reject symlinks anywhere in the path,
# as well as dot segments that could disguise the actual credential source.
ln -s "$tmp" "$tmp/alias" || error 'credential ancestry fixture failed'
result=$(probe status --token-file "$tmp/alias/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail "symlinked token-store ancestor accepted ($status)"
result=$(probe status --token-file "$tmp/./basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail "dot segment in protected token path accepted ($status)"
result=$(acquire client-secret-basic "$tmp/alias/secret" "$tmp/alias-secret-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ ! -e "$tmp/alias-secret-store" ] ||
  fail "symlinked secret ancestor accepted ($status)"
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/alias/store" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 87 ] && [ ! -e "$tmp/store" ] ||
  fail "symlinked output-directory ancestor accepted ($status)"
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/unsafe-ca-store" --ca-file "$tmp/alias/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 75 ] && [ ! -e "$tmp/unsafe-ca-store" ] ||
  fail "symlinked CA ancestor accepted ($status)"

# Explicit user Direct Access Grant: password contains spaces but never
# enters a curl argument, log, or shell program. The OAuth server must have
# enabled the direct grant on this confidential client.
printf 'password with spaces\n' > "$tmp/user-password"
chmod 600 "$tmp/user-password"
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode password --username k04tester \
  --password-file "$tmp/user-password" --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/password-store" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] &&
  [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] &&
  [ "$(jq -r .access_token "$tmp/password-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail "explicit password grant via protected file failed ($status)"
grep -F 'password with spaces' "$tmp/argv" "$tmp/err" >/dev/null &&
  fail 'user password leaked through HTTP argv or diagnostics'
printf 'wrong password\n' > "$tmp/user-password"
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode password --username k04tester \
  --password-file "$tmp/user-password" --client-id service \
  --client-auth client-secret-post --client-secret-file "$tmp/secret" \
  --token-store "$tmp/password-rejected-store" \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 72 ] && [ -z "$result" ] &&
  [ ! -e "$tmp/password-rejected-store" ] ||
  fail "invalid user credentials not rejected as invalid_grant ($status)"
printf 'password with spaces\n' > "$tmp/user-password"

# Refresh must use only the protected store, replace atomically and preserve
# the existing private mode. Missing successor/refresh is not success.
refresh()
{
  probe refresh --server "$base" --issuer-realm master \
    --client-id service --client-auth client-secret-basic \
    --client-secret-file "$tmp/secret" \
    --token-file "$1" --token-store "$1" --ca-file "$tmp/server.pem"
}
result=$(refresh "$tmp/password-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] &&
  [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] &&
  [ "$(jq -r .refresh_token "$tmp/password-store")" = SENSITIVE-K04-ROTATED-REFRESH-TOKEN ] ||
  fail "protected token refresh/rotation failed ($status)"
mode=$(LC_ALL=C ls -ld "$tmp/password-store"); mode=${mode%% *}
[ "$mode" = '-rw-------' ] || fail 'refreshed store lost private permissions'
[ ! -e "$tmp/password-store.keycloak-refresh-lock" ] ||
  fail 'refresh lock leaked after success'
grep -F 'SENSITIVE-K04-REFRESH-TOKEN' "$tmp/argv" "$tmp/err" >/dev/null &&
  fail 'refresh token escaped into curl arguments/diagnostics'
result=$(refresh "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 73 ] &&
  [ "$(jq -r .access_token "$tmp/basic-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail "store without refresh token was changed or accepted ($status)"
mkdir "$tmp/password-store.keycloak-refresh-lock" ||
  error 'refresh contention fixture unavailable'
result=$(refresh "$tmp/password-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 87 ] && [ -z "$result" ] ||
  fail "busy refresh lock was ignored ($status)"
rmdir "$tmp/password-store.keycloak-refresh-lock"
result=$(probe refresh --server "$base" --issuer-realm master \
  --client-id service --client-auth client-secret-basic \
  --client-secret-file "$tmp/secret" \
  --token-file "$tmp/password-store" --token-store "$tmp/other-store" \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ ! -e "$tmp/other-store" ] ||
  fail 'refresh allowed non-atomic alternate output'

# Explicit OIDC revocation: only named token kind; the selected token and
# client secret may appear in protected files but never process arguments.
result=$(probe revoke --server "$base" --issuer-realm master \
  --client-id service --client-auth client-secret-post \
  --client-secret-file "$tmp/secret" \
  --token-file "$tmp/password-store" --token-type-hint refresh_token \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] &&
  [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
  fail "refresh-token revocation did not receive safe acknowledgement ($status)"
grep -F 'SENSITIVE-K04-REFRESH-TOKEN' "$tmp/argv" "$tmp/err" >/dev/null &&
  fail 'refresh token escaped into curl argv or diagnostics'
[ "$(jq -r '.refresh_token' "$tmp/password-store")" = SENSITIVE-K04-ROTATED-REFRESH-TOKEN ] ||
  fail 'revocation silently rewrote a stored token'

result=$(probe revoke --server "$base" --issuer-realm master \
  --client-id service --client-auth client-secret-basic \
  --client-secret-file "$tmp/secret" \
  --token-file "$tmp/basic-store" --token-type-hint refresh_token \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 73 ] && [ -z "$result" ] ||
  fail "missing refresh token was not rejected ($status)"

result=$(probe revoke --server "$base" --issuer-realm master \
  --client-id service --client-auth client-secret-basic \
  --client-secret-file "$tmp/secret" \
  --token-file "$tmp/basic-store" --token-type-hint access_token \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] &&
  [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] ||
  fail "access-token revocation failed ($status)"
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/argv" "$tmp/err" >/dev/null &&
  fail 'access token escaped into curl argv or diagnostics'

result=$(probe revoke --server "$base" --issuer-realm master \
  --client-id service --client-auth client-secret-basic \
  --client-secret-file "$tmp/secret" \
  --token-file "$tmp/password-store" --token-type-hint unknown \
  --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 64 ] && [ -z "$result" ] ||
  fail 'unknown revocation type was silently accepted'

# User-grant selectors must never be silently forwarded to client_credentials.
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode client-credentials --username k04tester \
  --password-file "$tmp/user-password" --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/unsafe-fallback" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 64 ] && [ ! -e "$tmp/unsafe-fallback" ] ||
  fail 'user auth selectors were accepted for service-account grant'

result=$(acquire client-secret-post "$tmp/secret" "$tmp/post-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 0 ] || fail 'POST client credentials failed'
[ "$(jq -r '.access_token' "$tmp/post-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail 'POST flow response invalid'
grep -F 'protected-k04-secret' "$tmp/argv" >/dev/null &&
  fail 'POST secret exposed in curl argv'
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/err" >/dev/null &&
  fail 'POST access token exposed in diagnostics'

result=$(acquire client-secret-basic "$tmp/secret" "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 87 ] && [ -z "$result" ] ||
  fail 'existing token store was overwritten or accepted'

printf 'wrong-secret\n' > "$tmp/secret"
result=$(acquire client-secret-basic "$tmp/secret" "$tmp/denied-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 71 ] && [ -z "$result" ] && [ ! -e "$tmp/denied-store" ] ||
  fail 'bad Basic client secret was accepted or misclassified'

result=$(acquire client-secret-post "$tmp/secret" "$tmp/denied-post-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 71 ] && [ ! -e "$tmp/denied-post-store" ] ||
  fail 'invalid_client form rejection was not classified as client auth'

chmod 644 "$tmp/secret"
result=$(acquire client-secret-post "$tmp/secret" "$tmp/insecure-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] && [ ! -e "$tmp/insecure-store" ] ||
  fail 'world-readable secret not rejected'
chmod 600 "$tmp/secret"
printf 'protected-k04-secret\n' > "$tmp/secret"

# Reject untrusted TLS certificates without an explicit CA or system trust.
result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/untrusted-tls" 2>"$tmp/err")
status=$?
[ "$status" -eq 75 ] && [ ! -e "$tmp/untrusted-tls" ] ||
  fail "TLS trust bypass or misclassified certificate error ($status)"

chmod 644 "$tmp/basic-store"
result=$(probe status --token-file "$tmp/basic-store" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail 'world-readable access token store was accepted'
chmod 600 "$tmp/basic-store"

ln -s "$tmp/basic-store" "$tmp/token-symlink" ||
  error 'cannot construct symlink case'
result=$(probe status --token-file "$tmp/token-symlink" 2>"$tmp/err")
status=$?
[ "$status" -eq 70 ] && [ -z "$result" ] ||
  fail 'token-store symlink was accepted'

# Concurrent writers must never replace one another. The loser may
# detect the existing file early or fail the final atomic no-replace link.
acquire client-secret-basic "$tmp/secret" "$tmp/race-store" \
  >"$tmp/race1.out" 2>"$tmp/race1.err" &
race1=$!
acquire client-secret-post "$tmp/secret" "$tmp/race-store" \
  >"$tmp/race2.out" 2>"$tmp/race2.err" &
race2=$!
wait "$race1"
status1=$?
wait "$race2"
status2=$?
if [ "$status1" -eq 0 ] && [ "$status2" -eq 87 ]
then
  [ ! -s "$tmp/race2.out" ] || fail 'loser emitted success data'
elif [ "$status1" -eq 87 ] && [ "$status2" -eq 0 ]
then
  [ ! -s "$tmp/race1.out" ] || fail 'loser emitted success data'
else
  fail "exclusive token-store concurrent publication failed ($status1/$status2)"
fi
[ "$(jq -r '.access_token' "$tmp/race-store")" = SENSITIVE-K04-ACCESS-TOKEN ] ||
  fail 'concurrent store was replaced or malformed'
mode=$(LC_ALL=C ls -ld "$tmp/race-store"); mode=${mode%% *}
[ "$mode" = '-rw-------' ] || fail 'concurrent store permissions are unsafe'
find "$tmp" -name '.keycloak-token.*' -print | grep . >/dev/null &&
  fail 'staging token file left behind after concurrent publication'
grep -F 'SENSITIVE-K04-ACCESS-TOKEN' "$tmp/race1.err" "$tmp/race2.err" >/dev/null &&
  fail 'concurrent path exposed a token in diagnostics'

result=$(probe acquire --server "$base" --issuer-realm other \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/bad-issuer-store" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 67 ] && [ ! -e "$tmp/bad-issuer-store" ] ||
  fail 'mismatched discovery issuer was accepted'

result=$(probe acquire --server "http://127.0.0.1:$port" --issuer-realm master \
  --auth-mode client-credentials --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/insecure-http" 2>"$tmp/err")
status=$?
[ "$status" -eq 65 ] && [ -z "$result" ] ||
  fail 'non-HTTPS issuer was accepted'

result=$(probe acquire --server "$base" --issuer-realm master \
  --auth-mode device --client-id service \
  --client-auth client-secret-basic --client-secret-file "$tmp/secret" \
  --token-store "$tmp/not-supported" --ca-file "$tmp/server.pem" 2>"$tmp/err")
status=$?
[ "$status" -eq 73 ] && [ ! -e "$tmp/not-supported" ] ||
  fail 'unimplemented grant not rejected'

printf '%s\n' "$TEST_ID: PASS (real m, POSIX shell and HTTPS curl; SSH/sudo substituted)"
