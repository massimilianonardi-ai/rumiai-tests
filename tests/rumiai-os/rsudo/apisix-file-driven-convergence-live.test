#!/bin/sh
# Isolated APISIX file-driven startup convergence diagnostic.
# The established file-driven test stays untouched. This test repeats the
# initial real gateway route observation and distinguishes /status/ready
# from actual route application. No production ports or credentials.
TEST_ID=rumiai-os/rsudo/apisix-file-driven-convergence-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self") || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp=
cid=
cleanup()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test pathname unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'product target resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'explicit product checkout invalid' ;;
  *) error 'product target resolution failed' ;;
esac

[ "$(uname -s)" = Linux ] || skip 'isolated Linux gateway diagnostic only'
command -v docker >/dev/null 2>&1 || skip 'Docker unavailable'
images='apache/apisix@sha256:b921bdef3cfb2ca72e483d643f40e7843683ff8e188984489c2020f17654ee88
apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'
for image in $images
do
  docker image inspect "$image" >/dev/null 2>&1 ||
    skip "official pinned APISIX image unavailable: $image"
done

umask 077
tmp=${TMPDIR:-/tmp}/rsudo-apisix-file-convergence-$$
mkdir -p -- "$tmp/bin" || error 'cannot create disposable fixture'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture pathname unavailable'

cat > "$tmp/apisix.yaml" <<'YAML'
routes:
  - id: rsudo-file-yaml-route
    uri: /rsudo-file-yaml
    plugins:
      uri-blocker:
        block_rules:
          - /rsudo-file-yaml
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:19877": 1
services:
  - id: rsudo-file-yaml-service
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:19877": 1
upstreams:
  - id: rsudo-file-yaml-upstream
    type: roundrobin
    nodes:
      "127.0.0.1:19877": 1
#END
YAML
cp "$tmp/apisix.yaml" "$tmp/initial.yaml" || error 'cannot preserve initial diagnostic source'
cat > "$tmp/apisix.json" <<'JSON'
{"routes":[{"id":"rsudo-file-json-route","uri":"/rsudo-file-json",
"plugins":{"uri-blocker":{"block_rules":["/rsudo-file-json"]}},
"upstream":{"type":"roundrobin","nodes":{"127.0.0.1:19877":1}}}]}
JSON
cp "$tmp/apisix.json" "$tmp/initial.json" || error 'cannot preserve initial JSON source'
chmod 644 "$tmp/apisix.yaml" "$tmp/apisix.json" ||
  error 'cannot expose disposable documents to gateway workers'

cat > "$tmp/bin/rsudo-apisix-file-convergence-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  docker exec -i "$APISIX_CONVERGENCE_TEST_CID" "$@"
}
case "${APISIX_CONVERGENCE_TEST_OPERATION:-mode}" in
  mode) rsudo_mod_apisix_mode "$@" ;;
  runtime) rsudo_mod_apisix_runtime "$@" ;;
  *) exit 83 ;;
esac
PROBE
chmod 700 "$tmp/bin/rsudo-apisix-file-convergence-probe" ||
  error 'cannot enable real m probe'

# Uses the official image's installed bash as a loopback HTTP client,
# not a synthetic gateway or a network port on the Docker host.
http_status()
{
  http_path=$1
  http_port=$2
  response=$(docker exec -i "$cid" /bin/bash -s -- "$http_path" "$http_port" <<'HTTP'
path=$1
port=$2
exec 3<>/dev/tcp/127.0.0.1/"$port" || exit 70
printf 'GET %s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' "$path" >&3
cat <&3
HTTP
  ) || return $?
  first=$(printf '%s\n' "$response" | sed -n '1p') || return 71
  case "$first" in
    HTTP/1.*)
      set -- $first
      printf '%s\n' "$2"
      ;;
    *) return 72 ;;
  esac
}

diagnostics()
{
  printf '%s\n' "$TEST_ID: diagnostic: $1" >&2
  docker exec "$cid" cat /usr/local/apisix/conf/config.yaml >&2 || :
  docker exec "$cid" cat /usr/local/apisix/conf/apisix.yaml >&2 || :
  docker exec "$cid" cat /usr/local/apisix/conf/apisix.json >&2 || :
  ready=$(http_status /status/ready 7085)
  ready_status=$?
  printf 'readiness transport=%s http=%s\n' "$ready_status" "$ready" >&2
  docker logs "$cid" >&2 || :
}

for image in $images
do
  case "$image" in
    *b921bdef*) release=3.16 ;;
    *9a7e45dc*) release=3.19 ;;
    *) error 'unknown pinned APISIX image in diagnostic fixture' ;;
  esac
  for status_mode in disabled enabled
  do
    for repetition in 1 2
    do
      if [ "$status_mode" = enabled ]
      then
        cat > "$tmp/config.yaml" <<'CONFIG'
apisix:
  enable_admin: false
  enable_control: true
  control:
    ip: 127.0.0.1
    port: 9090
  status:
    ip: 127.0.0.1
    port: 7085
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
CONFIG
      else
        cat > "$tmp/config.yaml" <<'CONFIG'
apisix:
  enable_admin: false
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
CONFIG
      fi
      chmod 644 "$tmp/config.yaml" ||
        error 'cannot make selected config readable'
      cp "$tmp/initial.yaml" "$tmp/apisix.yaml" ||
        error 'cannot reset selected YAML source before gateway start'

      cid=$(docker run -d --network none \
        --cap-drop ALL --security-opt no-new-privileges=true \
        --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
        --mount "type=bind,src=$tmp/apisix.yaml,dst=/usr/local/apisix/conf/apisix.yaml,readonly" \
        --mount "type=bind,src=$tmp/apisix.json,dst=/usr/local/apisix/conf/apisix.json,readonly" \
        "$image") || error "cannot start isolated $release $status_mode gateway"
      [ -n "$cid" ] || error 'Docker returned an empty gateway ID'

      observed=$(APISIX_CONVERGENCE_TEST_CID="$cid" PATH="$tmp/bin:$PATH" \
        "$root/m" rsudo-apisix-file-convergence-probe \
        /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/probe-stderr")
      status=$?
      [ "$status" -eq 0 ] && [ "$observed" = standalone-file-yaml ] || {
        cat "$tmp/probe-stderr" >&2 || :
        fail "$release $status_mode $repetition real m selected incorrect on-disk provider"
      }

      docker exec "$cid" cat /usr/local/apisix/conf/apisix.yaml \
        > "$tmp/visible.yaml" ||
        error "$release $status_mode $repetition cannot read mounted document"
      cmp -s "$tmp/visible.yaml" "$tmp/apisix.yaml" ||
        fail "$release $status_mode $repetition mounted bytes differed"

      tries=0
      last=
      while [ "$tries" -lt 30 ]
      do
        last=$(http_status /rsudo-file-yaml 9080)
        status=$?
        if [ "$status" -eq 0 ] && [ "$last" = 403 ]; then break; fi
        if [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" != true ]
        then
          diagnostics "$release $status_mode $repetition gateway exited"
          fail "$release $status_mode $repetition gateway exited during initial route observation"
        fi
        tries=$((tries + 1))
        sleep 1
      done
      if [ "$tries" -ge 30 ]
      then
        diagnostics "$release $status_mode $repetition no initial route (HTTP $last)"
        fail "$release $status_mode $repetition initial route never applied (HTTP $last)"
      fi

      other=$(http_status /rsudo-file-json 9080) ||
        fail "$release $status_mode $repetition unselected route probe unavailable"
      [ "$other" = 404 ] ||
        fail "$release $status_mode $repetition wrong provider route HTTP $other"

      if [ "$status_mode" = enabled ]
      then
        ready=$(http_status /status/ready 7085) ||
          fail "$release $status_mode $repetition readiness unavailable after route loaded"
        [ "$ready" = 200 ] ||
          fail "$release $status_mode $repetition readiness HTTP $ready after route loaded"
      fi
      if [ "$status_mode" = enabled ] && [ "$repetition" = 1 ]
      then
        # This is APISIX's built-in control router, not a test-side
        # reconstruction of the document on disk. Keep it loopback-only in
        # the isolated container: Control API responses can expose config.
        # Match the selected real product runtime observer's master PID to
        # the kernel-owned loopback TCP listener. The Control API itself is
        # not an authenticated Admin interface and is never exposed publicly.
        observed_runtime=$(APISIX_CONVERGENCE_TEST_CID="$cid" \
          APISIX_CONVERGENCE_TEST_OPERATION=runtime PATH="$tmp/bin:$PATH" \
          "$root/m" rsudo-apisix-file-convergence-probe \
          /usr/local/apisix 2>"$tmp/probe-stderr")
        runtime_status=$?
        master_pid=$(docker exec "$cid" cat /usr/local/apisix/logs/nginx.pid) ||
          error "$release cannot read master pidfile for Control API attribution"
        if [ "$runtime_status" -ne 0 ] ||
           ! printf '%s\n' "$observed_runtime" |
             grep -Fx "process_pid=$master_pid" >/dev/null
        then
          cat "$tmp/probe-stderr" >&2 || :
          fail "$release runtime observer and selected master do not match"
        fi
        case "$observed_runtime" in
          *'runtime_identity=process-consistent-config-unverified'*'mutation_readiness=not-established') : ;;
          *) fail "$release runtime incorrectly asserted loaded source or write readiness" ;;
        esac
        docker exec -i "$cid" sh -s -- "$master_pid" <<'CONTROL_SOCKET'
pid=$1
[ -r "/proc/$pid/net/tcp" ] || exit 71
command -v awk >/dev/null 2>&1 || exit 72
command -v readlink >/dev/null 2>&1 || exit 73
# 127.0.0.1:9090 = 0100007F:2382 in Linux /proc/net/tcp
inode=$(awk '$2=="0100007F:2382" && $4=="0A" {print $10}' \
  "/proc/$pid/net/tcp") || exit 74
case "$inode" in
  ''|*[!0-9]*) exit 75 ;;
esac
for fd in "/proc/$pid/fd/"*
do
  target=$(readlink "$fd" 2>/dev/null) || continue
  [ "$target" = "socket:[$inode]" ] && exit 0
done
exit 76
CONTROL_SOCKET
        socket_status=$?
        [ "$socket_status" -eq 0 ] ||
          fail "$release observed master does not own isolated Control API listener (status $socket_status)"
        printf '%s\n' "$TEST_ID: worker control $release socket=master-owned-loopback-9090"

        control_old=$(http_status /v1/route/rsudo-file-yaml-route 9090) ||
          error "$release cannot observe built-in worker route"
        control_new=$(http_status /v1/route/rsudo-file-yaml-reloaded-route 9090) ||
          error "$release cannot observe absent built-in worker route"
        [ "$control_old" = 200 ] && [ "$control_new" = 404 ] ||
          fail "$release initial control routes differ from active HTTP routes"

        # Only the disposable host-side file is edited. The container's
        # read-only bind mount retains the same inode; this models a
        # non-atomic external writer, never an authorized product writer.
        sed -e 's|/rsudo-file-yaml|/rsudo-file-yaml-reloaded|g' \
          -e 's|rsudo-file-yaml-route|rsudo-file-yaml-reloaded-route|g' \
          "$tmp/initial.yaml" > "$tmp/repaired.yaml" ||
          error 'cannot prepare changed full-document fixture'
        sed '/^#END$/d' "$tmp/repaired.yaml" > "$tmp/incomplete.yaml" ||
          error 'cannot prepare incomplete YAML fixture'

        # Release APISIX 3.16/3.19 polls file mtime, usually at one-second
        # granularity. Keep writes on distinct filesystem timestamps.
        sleep 2
        cat "$tmp/incomplete.yaml" > "$tmp/apisix.yaml" ||
          error "$release cannot publish incomplete test document"
        docker exec "$cid" cat /usr/local/apisix/conf/apisix.yaml \
          > "$tmp/visible.yaml" ||
          error "$release cannot read incomplete file across mount"
        cmp -s "$tmp/visible.yaml" "$tmp/incomplete.yaml" ||
          fail "$release incomplete source is not visible in gateway namespace"
        sleep 3
        old=$(http_status /rsudo-file-yaml 9080) ||
          fail "$release old route request failed after invalid file"
        new=$(http_status /rsudo-file-yaml-reloaded 9080) ||
          fail "$release new route request failed after invalid file"
        if [ "$old" != 403 ] || [ "$new" != 404 ]
        then
          diagnostics "$release invalid YAML rejected: expected old=403 new=404, observed old=$old new=$new"
          fail "$release invalid YAML replaced or disrupted last applied route"
        fi
        control_old=$(http_status /v1/route/rsudo-file-yaml-route 9090) ||
          error "$release worker control old route read failed after invalid source"
        control_new=$(http_status /v1/route/rsudo-file-yaml-reloaded-route 9090) ||
          error "$release worker control new route read failed after invalid source"
        [ "$control_old" = 200 ] && [ "$control_new" = 404 ] ||
          fail "$release worker control changed routes after invalid YAML"

        sleep 2
        cat "$tmp/repaired.yaml" > "$tmp/apisix.yaml" ||
          error "$release cannot restore valid changed document"
        docker exec "$cid" cat /usr/local/apisix/conf/apisix.yaml \
          > "$tmp/visible.yaml" ||
          error "$release cannot read repaired file across mount"
        cmp -s "$tmp/visible.yaml" "$tmp/repaired.yaml" ||
          fail "$release repaired source differs across mount"
        tries=0
        while [ "$tries" -lt 30 ]
        do
          new=$(http_status /rsudo-file-yaml-reloaded 9080)
          new_status=$?
          old=$(http_status /rsudo-file-yaml 9080)
          old_status=$?
          control_new=$(http_status /v1/route/rsudo-file-yaml-reloaded-route 9090)
          control_new_status=$?
          control_old=$(http_status /v1/route/rsudo-file-yaml-route 9090)
          control_old_status=$?
          if [ "$new_status" -eq 0 ] && [ "$old_status" -eq 0 ] &&
             [ "$control_new_status" -eq 0 ] && [ "$control_old_status" -eq 0 ] &&
             [ "$new" = 403 ] && [ "$old" = 404 ] &&
             [ "$control_new" = 200 ] && [ "$control_old" = 404 ]
          then
            break
          fi
          tries=$((tries + 1))
          sleep 1
        done
        if [ "$tries" -ge 30 ]
        then
          diagnostics "$release repaired YAML not applied: old=$old new=$new"
          fail "$release repaired document did not replace last applied route"
        fi
        printf '%s\n' "$TEST_ID: reload $release invalid=old-403,new-404 repaired=old-404,new-403"
        printf '%s\n' "$TEST_ID: worker control $release initial=old-200,new-404 invalid=old-200,new-404 repaired=old-404,new-200"

        # Change the selected *main* configuration on disk without
        # triggering a restart. An on-disk provider classifier must now
        # disagree with the already-applied worker control route.
        cat > "$tmp/config.yaml" <<'DRIFTED_CONFIG'
apisix:
  enable_admin: false
deployment:
  role: data_plane
  role_data_plane:
    config_provider: json
DRIFTED_CONFIG
        docker exec "$cid" cat /usr/local/apisix/conf/config.yaml \
          > "$tmp/visible-config.yaml" ||
          error "$release cannot observe changed selected config in gateway"
        cmp -s "$tmp/config.yaml" "$tmp/visible-config.yaml" ||
          fail "$release changed selected configuration not visible inside gateway"
        observed=$(APISIX_CONVERGENCE_TEST_CID="$cid" PATH="$tmp/bin:$PATH" \
          "$root/m" rsudo-apisix-file-convergence-probe \
          /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/probe-stderr")
        status=$?
        [ "$status" -eq 0 ] && [ "$observed" = standalone-file-json ] || {
          cat "$tmp/probe-stderr" >&2 || :
          fail "$release selected disk source drift was not independently classified"
        }
        control_new=$(http_status /v1/route/rsudo-file-yaml-reloaded-route 9090) ||
          error "$release cannot observe worker route after main source drift"
        still_loaded=$(http_status /rsudo-file-yaml-reloaded 9080) ||
          error "$release cannot observe HTTP route after main source drift"
        [ "$control_new" = 200 ] && [ "$still_loaded" = 403 ] ||
          fail "$release disk-only provider drift incorrectly changed active worker route"
        # APISIX readiness observes worker configuration receipt, not the
        # provenance of the currently mounted main config.yaml. A successful
        # readiness response must not upgrade source identity or write safety.
        ready_after_drift=$(http_status /status/ready 7085) ||
          fail "$release readiness transport failed after disk-only provider drift"
        [ "$ready_after_drift" = 200 ] ||
          fail "$release readiness changed unexpectedly after disk-only drift (HTTP $ready_after_drift)"
        printf '%s\n' "$TEST_ID: worker source drift $release readiness=200-but-source-unverified"
        printf '%s\n' "$TEST_ID: worker source drift $release disk=standalone-file-json control-yaml=200 http-yaml=403"
      fi

      printf '%s\n' "$TEST_ID: observed $release $status_mode repetition=$repetition selected=403 unselected=404"
      docker rm -f "$cid" >/dev/null 2>&1 ||
        error "cannot clean $release $status_mode gateway"
      cid=
    done
  done
done

# JSON has no YAML #END marker. Exercise an independently selected JSON
# provider, truncate the disposable mounted document, and then repair it.
# This checks real data-plane behavior, not an APISIX admin mutation API.
for image in $images
do
  case "$image" in
    *b921bdef*) release=3.16 ;;
    *9a7e45dc*) release=3.19 ;;
    *) error 'unknown pinned APISIX image in JSON fixture' ;;
  esac
  cat > "$tmp/config.yaml" <<'CONFIG'
apisix:
  enable_admin: false
deployment:
  role: data_plane
  role_data_plane:
    config_provider: json
CONFIG
  chmod 644 "$tmp/config.yaml" ||
    error 'cannot make JSON provider configuration readable'
  cp "$tmp/initial.yaml" "$tmp/apisix.yaml" ||
    error 'cannot reset nonselected YAML source'
  cp "$tmp/initial.json" "$tmp/apisix.json" ||
    error 'cannot reset JSON source'
  cid=$(docker run -d --network none \
    --cap-drop ALL --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    --mount "type=bind,src=$tmp/apisix.yaml,dst=/usr/local/apisix/conf/apisix.yaml,readonly" \
    --mount "type=bind,src=$tmp/apisix.json,dst=/usr/local/apisix/conf/apisix.json,readonly" \
    "$image") || error "cannot start isolated $release JSON gateway"
  [ -n "$cid" ] || error 'Docker returned no JSON gateway ID'

  observed=$(APISIX_CONVERGENCE_TEST_CID="$cid" PATH="$tmp/bin:$PATH" \
    "$root/m" rsudo-apisix-file-convergence-probe \
    /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/probe-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-file-json ] || {
    cat "$tmp/probe-stderr" >&2 || :
    fail "$release JSON mode not classified by real m/APISIX product"
  }
  docker exec "$cid" cat /usr/local/apisix/conf/apisix.json > "$tmp/visible.json" ||
    error "$release cannot read JSON source inside gateway namespace"
  cmp -s "$tmp/visible.json" "$tmp/initial.json" ||
    fail "$release JSON source differs across gateway namespace"

  tries=0
  while [ "$tries" -lt 30 ]
  do
    old=$(http_status /rsudo-file-json 9080)
    old_status=$?
    if [ "$old_status" -eq 0 ] && [ "$old" = 403 ]; then break; fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" != true ]
    then
      diagnostics "$release initial JSON gateway exited"
      fail "$release JSON gateway exited before initial route"
    fi
    tries=$((tries + 1))
    sleep 1
  done
  if [ "$tries" -ge 30 ]
  then
    diagnostics "$release initial JSON route stayed HTTP $old"
    fail "$release JSON gateway never applied its initial route"
  fi
  other=$(http_status /rsudo-file-yaml 9080) ||
    fail "$release unselected YAML route request failed"
  [ "$other" = 404 ] ||
    fail "$release JSON provider unexpectedly loaded YAML route HTTP $other"

  sed 's|/rsudo-file-json|/rsudo-file-json-reloaded|g' \
    "$tmp/initial.json" > "$tmp/repaired.json" ||
    error "$release cannot construct repaired JSON fixture"
  printf '%s\n' '{"routes": [' > "$tmp/incomplete.json" ||
    error "$release cannot construct truncated JSON fixture"

  # Distinct mtime for each write: these APISIX releases poll timestamp.
  sleep 2
  cat "$tmp/incomplete.json" > "$tmp/apisix.json" ||
    error "$release cannot publish truncated JSON test document"
  docker exec "$cid" cat /usr/local/apisix/conf/apisix.json \
    > "$tmp/visible.json" ||
    error "$release cannot read truncated JSON inside gateway"
  cmp -s "$tmp/visible.json" "$tmp/incomplete.json" ||
    fail "$release truncated JSON not visible in gateway namespace"
  sleep 3
  old=$(http_status /rsudo-file-json 9080) ||
    fail "$release existing route unavailable after truncated JSON"
  new=$(http_status /rsudo-file-json-reloaded 9080) ||
    fail "$release new route unavailable after truncated JSON"
  if [ "$old" != 403 ] || [ "$new" != 404 ]
  then
    diagnostics "$release invalid JSON observation old=$old new=$new"
    fail "$release invalid JSON replaced or disrupted last valid route"
  fi

  sleep 2
  cat "$tmp/repaired.json" > "$tmp/apisix.json" ||
    error "$release cannot publish repaired valid JSON test document"
  docker exec "$cid" cat /usr/local/apisix/conf/apisix.json \
    > "$tmp/visible.json" ||
    error "$release cannot read repaired JSON inside gateway"
  cmp -s "$tmp/visible.json" "$tmp/repaired.json" ||
    fail "$release repaired JSON differs across gateway namespace"
  tries=0
  while [ "$tries" -lt 30 ]
  do
    new=$(http_status /rsudo-file-json-reloaded 9080)
    new_status=$?
    old=$(http_status /rsudo-file-json 9080)
    old_status=$?
    if [ "$new_status" -eq 0 ] && [ "$old_status" -eq 0 ] &&
       [ "$new" = 403 ] && [ "$old" = 404 ]
    then
      break
    fi
    tries=$((tries + 1))
    sleep 1
  done
  if [ "$tries" -ge 30 ]
  then
    diagnostics "$release repaired JSON did not converge old=$old new=$new"
    fail "$release repaired JSON did not replace the initial route"
  fi
  printf '%s\n' "$TEST_ID: JSON reload $release invalid=old-403,new-404 repaired=old-404,new-403"

  docker rm -f "$cid" >/dev/null 2>&1 ||
    error "$release cannot remove isolated JSON gateway"
  cid=
done

printf '%s\n' "$TEST_ID: PASS (APISIX 3.16/3.19, isolated YAML and JSON invalid-source retention and reload)"
