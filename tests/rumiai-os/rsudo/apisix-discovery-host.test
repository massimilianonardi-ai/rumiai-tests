#!/bin/sh
# Real m/module plus read-only host/container inventory. Remote managers and
# ps are synthetic; this does not validate live Docker/Podman or APISIX.
TEST_ID=rumiai-os/rsudo/apisix-discovery-host.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }
test_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P) || error 'test path'
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error 'suite path'
. "$suite_root/lib/rumiai-os-target.lib" || error 'product resolver'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
case "$?" in 0) : ;; 1) skip 'no product checkout' ;; 2) fail 'invalid checkout' ;; *) error 'resolver' ;; esac
module=$root/lib/sys/sh/rsudo/rsudo-mod-apisix.lib.sh
manual=$root/res/sys/manual/rsudo-mod-apisix.lib.sh
[ -f "$module" ] && [ -f "$manual" ] || fail 'module/manual absent'
sh -n "$module" || fail 'invalid POSIX shell syntax'
grep -F rsudo_mod_apisix_discovery "$manual" >/dev/null || fail 'manual missing discovery'

tmp=/tmp/rsudo-apisix-discovery-$$
cleanup() { rm -rf -- "$tmp"; }
trap cleanup 0
umask 077
mkdir -p "$tmp/bin" "$tmp/tree/one/bin" "$tmp/tree/one/conf" \
  "$tmp/tree/two/conf" "$tmp/tree/other/conf" || error 'fixture directories'
: > "$tmp/tree/one/bin/apisix"
cat > "$tmp/tree/one/conf/config.yaml" <<'CONFIG'
deployment:
  admin:
    admin_listen:
      ip: 127.0.0.1
      port: 19180
CONFIG
: > "$tmp/tree/one/conf/config-stage.yaml"
: > "$tmp/tree/two/conf/nginx.conf"
cat > "$tmp/tree/two/conf/apisix.json" <<'JSON'
{"deployment":{"admin":{"admin_listen":{"ip":"127.0.0.1","port":19181}}}}
JSON
cat > "$tmp/tree/other/conf/apisix.json" <<'JSON'
{"routes":[]}
JSON
: > "$tmp/tree/other/conf/config.yaml"
cat > "$tmp/bin/ps" <<'PS'
#!/bin/sh
[ "$1" = -eo ] || exit 70
printf '4321 nginx: master process openresty -p %s\n' "$APISIX_DISCOVERY_FIXTURE_HOME"
printf '5555 nginx: master process unrelated app\n'
PS
cat > "$tmp/bin/docker" <<'DOCKER'
#!/bin/sh
case "$1:$2" in
  ps:-a)
    printf '%s\n' \
      'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd|apisix-live|running|apache/apisix:3.19' \
      'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee|apisix-stopped|exited|apache/apisix:3.16' \
      'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc|worker-old|exited|internal/worker:stable'
  ;;
  exec:-i)
    [ "$3" = dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd ] || exit 1
    cat >/dev/null
    if [ "$6" = -- ]
    then
      printf '%s\n' 'open|127.0.0.1|19180|127.0.0.1'
    else
      printf '%s\n' /usr/local/apisix/conf/config.yaml
    fi
  ;;
  inspect:--format)
    case "$4" in
      cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc)
        printf '%s\n' '/var/lib/worker-config|/usr/local/apisix/conf'
      ;;
      *) : ;;
    esac
  ;;
  *) exit 70 ;;
esac
DOCKER
cat > "$tmp/bin/podman" <<'PODMAN'
#!/bin/sh
case "$1:$2" in
  ps:-a)
    printf '%s\n' \
      'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff|edge-gateway|running|internal/gateway:stable'
  ;;
  exec:-i)
    [ "$3" = ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff ] || exit 1
    if [ "$6" = -- ]
    then
      exec sh -s -- "$APISIX_DISCOVERY_FIXTURE_PODMAN_JSON"
    else
      cat >/dev/null
      printf '%s\n' /srv/gateway/conf/apisix.json
    fi
  ;;
  *) exit 70 ;;
esac
PODMAN
cat > "$tmp/bin/systemctl" <<'SYSTEMCTL'
#!/bin/sh
case "$1" in
  list-units)
    printf '%s\n' \
      'apisix.service loaded active running Apache APISIX' \
      'apisix@blue.service loaded inactive dead Apache APISIX instance' \
      'unrelated.service loaded active running Unrelated'
  ;;
  list-unit-files)
    printf '%s\n' \
      'apisix.service enabled enabled' \
      'apisix@blue.service disabled enabled' \
      'unrelated.service enabled enabled'
  ;;
  show)
    case "$4" in
      apisix.service)
        printf '%s\n' 'Id=apisix.service' 'MainPID=4321' \
          'ControlGroup=/system.slice/apisix.service' 'ActiveState=active'
      ;;
      *)
        printf '%s\n' "Id=$4" 'MainPID=0' 'ControlGroup=' 'ActiveState=inactive'
      ;;
    esac
  ;;
  *) exit 70 ;;
esac
SYSTEMCTL
cat > "$tmp/bin/nc" <<'NC'
#!/bin/sh
[ "$1" = -z ] && [ "$2" = -w ] && [ "$3" = 1 ] || exit 70
[ "$4" = 127.0.0.1 ] && { [ "$5" = 19180 ] || [ "$5" = 19181 ]; }
NC
cat > "$tmp/bin/rsudo-apisix-discovery-probe" <<'PROBE'
#!/bin/sh
[ -n "$m_ROOT" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  if [ "${APISIX_DISCOVERY_NO_JSON-}" = 1 ]
  then PATH="$APISIX_DISCOVERY_NO_JSON_PATH" "$@"
  else "$@"
  fi
}
rsudo_mod_apisix_discovery "$@"
PROBE
chmod 700 "$tmp/bin/ps" "$tmp/bin/docker" "$tmp/bin/podman" \
  "$tmp/bin/systemctl" "$tmp/bin/nc" \
  "$tmp/bin/rsudo-apisix-discovery-probe" || error 'fixture permissions'
probe()
{
  APISIX_DISCOVERY_FIXTURE_HOME="$tmp/tree/one" \
  APISIX_DISCOVERY_FIXTURE_PODMAN_JSON="$tmp/tree/two/conf/apisix.json" \
    PATH="$tmp/bin:$root/bin/sys:$PATH" \
    "$root/m" rsudo-apisix-discovery-probe "$@"
}
output=$(probe "$tmp/tree" 2>"$tmp/stderr")
[ "$?" -eq 0 ] || { cat "$tmp/stderr" >&2; fail 'host discovery'; }
printf '%s\n' "$output" | grep -Fx "$(printf 'kind\tscope\tstate\tidentifier\tevidence')" >/dev/null ||
  fail 'stable output header missing'
printf '%s\n' "$output" | grep -F "$tmp/tree/one/conf/config.yaml" >/dev/null || fail 'first installation missing'
printf '%s\n' "$output" | grep -F "$tmp/tree/one/conf/config-stage.yaml" >/dev/null || fail 'profile missing'
printf '%s\n' "$output" | grep -F "$tmp/tree/two/conf/apisix.json" >/dev/null || fail 'second installation missing'
printf '%s\n' "$output" | grep -F "$tmp/tree/other/conf/config.yaml" >/dev/null && fail 'generic config false positive'
printf '%s\n' "$output" | grep -F "listener${tab}host${tab}parse-failed${tab}$tmp/tree/other/conf/apisix.json${tab}json-invalid-or-unsupported" >/dev/null &&
  fail 'valid snapshot without deployment settings reported as parse failure'
printf '%s\n' "$output" | grep -F 'find-and-ps-prefix' >/dev/null || fail 'ps evidence missing'
tab=$(printf '\t')
printf '%s\n' "$output" | grep -F "service${tab}host${tab}active${tab}apisix.service${tab}systemd-loaded-unit" >/dev/null ||
  fail 'active systemd service candidate missing'
printf '%s\n' "$output" | grep -F "service${tab}host${tab}inactive${tab}apisix@blue.service${tab}systemd-loaded-unit" >/dev/null ||
  fail 'inactive systemd service candidate missing'
printf '%s\n' "$output" | grep -F "service${tab}host${tab}active-mainpid-match${tab}apisix.service${tab}systemd-mainpid-and-ps-pid-4321" >/dev/null ||
  fail 'systemd MainPID/process correlation missing'
printf '%s\n' "$output" | grep -F "listener${tab}host${tab}open${tab}127.0.0.1:19180${tab}config-admin-listen-nc:$tmp/tree/one/conf/config.yaml" >/dev/null ||
  fail 'configured listener probe missing'
printf '%s\n' "$output" | grep -F "listener${tab}host${tab}open${tab}127.0.0.1:19181${tab}config-admin-listen-nc:$tmp/tree/two/conf/apisix.json" >/dev/null ||
  fail 'JSON listener query through RumiAI json command missing'
[ "$(printf '%s\n' "$output" | grep -c "^config${tab}host")" -eq 3 ] || fail 'multiple host candidates lost'
printf '%s\n' "$output" | grep -F "container${tab}docker${tab}exited${tab}eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee${tab}manager-image-name-candidate" >/dev/null ||
  fail 'stopped Docker candidate missing'
printf '%s\n' "$output" | grep -F "container${tab}docker${tab}exited${tab}cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc:/usr/local/apisix/conf${tab}manager-inspect-config-mount-candidate:source=/var/lib/worker-config" >/dev/null ||
  fail 'stopped custom-image mount candidate missing'
printf '%s\n' "$output" | grep -F 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd:/usr/local/apisix/conf/config.yaml' >/dev/null ||
  fail 'running Docker config missing'
printf '%s\n' "$output" | grep -F 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd:127.0.0.1:19180' >/dev/null ||
  fail 'Docker namespace listener probe missing'
printf '%s\n' "$output" | grep -F 'docker-container-admin-listen-bind-127.0.0.1-config:/usr/local/apisix/conf/config.yaml' >/dev/null ||
  fail 'Docker namespace listener probe missing'
printf '%s\n' "$output" | grep -F 'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff:/srv/gateway/conf/apisix.json' >/dev/null ||
  fail 'Podman config without APISIX image/name hint missing'
printf '%s\n' "$output" | grep -F 'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff:127.0.0.1:19181' >/dev/null ||
  fail 'Podman JSON namespace listener probe missing'
printf '%s\n' "$output" | grep -F 'podman-container-admin-listen-bind-127.0.0.1-config:/srv/gateway/conf/apisix.json' >/dev/null ||
  fail 'Podman JSON listener provenance missing'

# A remote target without RumiAI json reports uncertainty rather than copying
# file contents locally, silently skipping the file or failing the whole scan.
mkdir -p "$tmp/no-json-bin"
for command_name in ps docker podman systemctl nc
do ln -s "$tmp/bin/$command_name" "$tmp/no-json-bin/$command_name" || error 'no-json fixture links'; done
output=$(APISIX_DISCOVERY_FIXTURE_HOME="$tmp/tree/one" \
  APISIX_DISCOVERY_FIXTURE_PODMAN_JSON="$tmp/tree/two/conf/apisix.json" \
  APISIX_DISCOVERY_NO_JSON=1 APISIX_DISCOVERY_NO_JSON_PATH="$tmp/no-json-bin:/usr/bin:/bin" \
  PATH="$tmp/bin:$PATH" \
  "$root/m" rsudo-apisix-discovery-probe "$tmp/tree" 2>"$tmp/stderr")
[ "$?" -eq 0 ] || { cat "$tmp/stderr" >&2; fail 'discovery without remote json'; }
printf '%s\n' "$output" | grep -F "listener${tab}host${tab}parser-unavailable${tab}$tmp/tree/two/conf/apisix.json${tab}json-command-missing" >/dev/null ||
  fail 'missing remote json uncertainty missing'

# Malformed JSON is distinct from the valid standalone snapshot above.
printf '%s\n' '{"deployment":' > "$tmp/tree/two/conf/apisix.json"
output=$(probe "$tmp/tree" 2>"$tmp/stderr")
[ "$?" -eq 0 ] || { cat "$tmp/stderr" >&2; fail 'discovery with malformed JSON'; }
printf '%s\n' "$output" | grep -F "listener${tab}host${tab}parse-failed${tab}$tmp/tree/two/conf/apisix.json${tab}json-invalid-or-unsupported" >/dev/null ||
  fail 'malformed JSON uncertainty missing'

output=$(probe relative 2>"$tmp/stderr"); status=$?
[ "$status" -eq 2 ] && [ -z "$output" ] || fail 'relative root not rejected'
grep -F apisix.discovery-invalid-scan-root "$tmp/stderr" >/dev/null || fail 'diagnostic missing'
output=$(probe "$tmp/absent" 2>"$tmp/stderr"); status=$?
[ "$status" -eq 2 ] || fail 'missing root not rejected'
printf '%s\n' "$TEST_ID: PASS (real m/find/json, synthetic ps/managers/systemd/nc and rsudo boundary)"
