#!/bin/sh
# Real APISIX 3.19.0 LuaJIT/YAML/defaults boundary through the actual m
# entrypoint and product shell module. Only rsudo remote SSH/sudo is replaced
# by network-disabled Docker stdin execution; no live APISIX gateway is tested.

TEST_ID=rumiai-os/rsudo/apisix-parser-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self") || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

cleanup() { [ -z "${tmp-}" ] || rm -rf -- "$tmp"; }
trap cleanup 0

dir=$(resolve_test_dir) || error 'cannot resolve test directory'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'product checkout not found' ;;
  2) fail 'invalid explicit product checkout' ;;
  *) error 'target resolution failed' ;;
esac

command -v docker >/dev/null 2>&1 ||
  skip 'Docker unavailable: installed APISIX parser not exercised'

# Official Apache APISIX 3.19.0 Debian multiarch image index digest.
# The pinned image is provisioned by the workflow; an absent image is SKIP.
image='apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'
docker image inspect "$image" >/dev/null 2>&1 ||
  skip 'pinned APISIX image not locally provisioned'

tmp=${TMPDIR:-/tmp}/rsudo-apisix-parser-$$
umask 077
mkdir -p -- "$tmp/fixtures" "$tmp/bin" || error 'cannot create fixture directory'
chmod 755 -- "$tmp" "$tmp/fixtures" || error 'cannot set fixture permissions'

cat > "$tmp/bin/rsudo-apisix-parser-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82

# Docker is an external remote-execution boundary. The product's full
# heredoc shell script and arguments execute unchanged in the APISIX image.
rsudo()
{
  [ "$1" = sh ] || return 83
  shift
  docker run --rm --read-only --network none --cap-drop ALL -i \
    --mount "type=bind,src=$APISIX_PARSER_FIXTURES,dst=/mnt/rsudo-apisix-fixtures,readonly" \
    --entrypoint /bin/sh "$APISIX_PARSER_IMAGE" "$@"
}
rsudo_mod_apisix_mode /usr/local/apisix "$@"
PROBE
chmod 700 -- "$tmp/bin/rsudo-apisix-parser-probe" ||
  error 'cannot make probe executable'

docker run --rm --read-only --network none --cap-drop ALL \
  --entrypoint /bin/sh "$image" -c \
  'test -r /usr/local/apisix/conf/config.yaml &&
   test -r /usr/local/apisix/apisix/cli/config.lua &&
   command -v luajit >/dev/null 2>&1' ||
  error 'pinned image lacks expected APISIX installation'

write_case()
{
  printf '%s\n' "$2" > "$tmp/fixtures/$1" ||
    error "cannot write fixture $1"
  chmod 644 -- "$tmp/fixtures/$1" ||
    error "cannot make fixture readable $1"
}

run_mode()
{
  APISIX_PARSER_FIXTURES="$tmp/fixtures" APISIX_PARSER_IMAGE="$image" \
    PATH="$tmp/bin:$PATH" "$root/m" rsudo-apisix-parser-probe \
    "/mnt/rsudo-apisix-fixtures/$1"
}

expect_mode()
{
  result=$(run_mode "$1" 2>"$tmp/stderr")
  status=$?
  if [ "$status" -ne 0 ]; then
    cat "$tmp/stderr" >&2
    fail "$1: parser status $status"
  fi
  [ "$result" = "$2" ] || fail "$1: expected $2; got $result"
}
expect_failure()
{
  result=$(run_mode "$1" 2>"$tmp/stderr")
  status=$?
  [ "$status" -ne 0 ] || fail "$1: invalid mode was accepted"
  [ -z "$result" ] || fail "$1: invalid mode printed successful output"
}

write_case default '# empty: use APISIX defaults'
write_case traditional 'deployment:
  role: traditional
  role_traditional:
    config_provider: etcd'
write_case control 'deployment:
  role: control_plane'
write_case api 'deployment:
  role: traditional
  role_traditional:
    config_provider: yaml'
write_case file_yaml 'deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml'
write_case file_json 'deployment:
  role: data_plane
  role_data_plane:
    config_provider: json'
write_case data_etcd 'deployment:
  role: data_plane
  role_data_plane:
    config_provider: etcd'
write_case future 'deployment:
  role: traditional
  role_traditional:
    config_provider: future_provider'
write_case malformed 'deployment: ['
write_case structure 'deployment: string-instead-of-map'
write_case disabled 'apisix:
  enable_admin: false
deployment:
  role: traditional'
write_case unresolved 'deployment:
  role: traditional
  role_traditional:
    config_provider: ${{UNRESOLVED_PROVIDER}}'

expect_mode default traditional-admin
expect_mode traditional traditional-admin
expect_mode control traditional-admin
expect_mode api standalone-api
expect_mode file_yaml standalone-file-yaml
expect_mode file_json standalone-file-json
expect_mode data_etcd no-admin-data-plane
expect_failure future
expect_failure malformed
expect_failure structure
expect_failure disabled
expect_failure unresolved

printf '%s\n' "$TEST_ID: PASS (installed APISIX parser, no gateway process)"
