#!/bin/sh
# One composed K04 run: real m -> rsudo -> OpenSSH -> sudo -> curl/HTTPS
# -> OFFICIAL running Keycloak 26.7.3 and 26.8.1. The SSH target shares only
# a disposable network namespace with the isolated Keycloak container.
# No production credentials, services, hosts or SSH configuration are used.
TEST_ID=rumiai-os/rsudo/keycloak-auth-composed-live.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}
tmp= keycloak_container= ssh_container= keycloak_image= ssh_image=
stop_containers()
{
  [ -z "$ssh_container" ] || docker rm -f "$ssh_container" >/dev/null 2>&1 || :
  ssh_container=
  [ -z "$keycloak_container" ] || docker rm -f "$keycloak_container" >/dev/null 2>&1 || :
  keycloak_container=
  [ -z "$keycloak_image" ] || docker image rm "$keycloak_image" >/dev/null 2>&1 || :
  keycloak_image=
}
cleanup()
{
  stop_containers
  [ -z "$ssh_image" ] || docker image rm "$ssh_image" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'self path missing'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver not available'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
case "$?" in
  0) : ;;
  1) skip 'product checkout missing' ;;
  2) fail 'explicit product checkout invalid' ;;
  *) error 'product checkout lookup failed' ;;
esac
[ "$(uname -s)" = Linux ] || skip 'composed Docker/SSH test is Linux only'
for cmd in docker ssh curl jq openssl python3
do
  command -v "$cmd" >/dev/null 2>&1 || skip "$cmd unavailable"
done

tmp=${TMPDIR:-/tmp}/k04-composed-$$
umask 077
mkdir -p "$tmp/bin" "$tmp/keycloak" "$tmp/ssh" ||
  error 'isolated fixture directories unavailable'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture real path unavailable'
cat > "$tmp/openssl.cnf" <<'CERTCONF'
[req]
distinguished_name = dn
prompt = no
x509_extensions = ext
[dn]
CN = 127.0.0.1
[ext]
subjectAltName = IP:127.0.0.1
basicConstraints = critical,CA:TRUE
keyUsage = digitalSignature,keyCertSign
CERTCONF
openssl req -x509 -newkey rsa:2048 -nodes -config "$tmp/openssl.cnf" \
  -extensions ext -days 1 \
  -keyout "$tmp/keycloak/server.key" -out "$tmp/keycloak/server.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'disposable TLS certificate generation failed'
cp "$tmp/keycloak/server.pem" "$tmp/ssh/ca.pem" ||
  error 'disposable remote CA copy failed'
# Independently trusted mTLS CA; all TLS client credentials stay on the
# disposable sudo target once the composed SSH path is initialized.
openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
  -subj /CN=k04-mtls-ca -addext 'basicConstraints=critical,CA:TRUE' \
  -addext 'keyUsage=critical,keyCertSign,cRLSign' \
  -keyout "$tmp/mtls-ca.key" -out "$tmp/keycloak/mtls-ca.pem" \
  >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'composed mTLS CA generation failed'
cat > "$tmp/mtls-client.ext" <<'MTLS_EXT'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=clientAuth
MTLS_EXT
for identity in good wrong
do
  case "$identity" in
    good) subject=/CN=k04-mtls-client ;;
    wrong) subject=/CN=k04-mtls-other ;;
  esac
  openssl req -new -newkey rsa:2048 -nodes -subj "$subject" \
    -keyout "$tmp/mtls-$identity.key" -out "$tmp/mtls-$identity.csr" \
    >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
    error "composed mTLS $identity client key preparation failed"
  openssl x509 -req -in "$tmp/mtls-$identity.csr" \
    -CA "$tmp/keycloak/mtls-ca.pem" -CAkey "$tmp/mtls-ca.key" \
    -CAcreateserial -days 1 -extfile "$tmp/mtls-client.ext" \
    -out "$tmp/mtls-$identity.pem" \
    >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
    error "composed mTLS $identity certificate generation failed"
  chmod 600 "$tmp/mtls-$identity.key" "$tmp/mtls-$identity.pem" ||
    error "composed mTLS $identity credential permissions unavailable"
done

openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=k04-composed-rsa \
  -keyout "$tmp/client-rsa.key" -out "$tmp/client-rsa.pem" \
  > "$tmp/client-openssl.out" 2>"$tmp/client-openssl.err" ||
  error 'disposable RSA client keypair unavailable'
chmod 600 "$tmp/client-rsa.key" "$tmp/client-rsa.pem" ||
  error 'disposable RSA client keypair permissions unavailable'

for curve_spec in ES256:prime256v1 ES384:secp384r1 ES512:secp521r1
do
  algorithm=${curve_spec%%:*}
  curve=${curve_spec#*:}
  openssl ecparam -name "$curve" -genkey -noout \
    -out "$tmp/client-$algorithm.key" ||
    error "$algorithm EC private key generation failed"
  openssl req -new -x509 -key "$tmp/client-$algorithm.key" \
    -days 1 -subj "/CN=k04-composed-$algorithm" \
    -out "$tmp/client-$algorithm.pem" ||
    error "$algorithm EC certificate generation failed"
  chmod 600 "$tmp/client-$algorithm.key" "$tmp/client-$algorithm.pem" ||
    error "$algorithm EC client permissions unavailable"
done

openssl genpkey -algorithm ED25519 -out "$tmp/client-eddsa.key" ||
  error 'composed Ed25519 key preparation failed'
openssl req -new -x509 -key "$tmp/client-eddsa.key" \
  -days 1 -subj /CN=k04-composed-eddsa \
  -out "$tmp/client-eddsa.pem" ||
  error 'composed Ed25519 public certificate preparation failed'
chmod 600 "$tmp/client-eddsa.key" "$tmp/client-eddsa.pem" ||
  error 'composed Ed25519 key/certificate permissions unavailable'

printf 'KC_BOOTSTRAP_ADMIN_USERNAME=k04admin\nKC_BOOTSTRAP_ADMIN_PASSWORD=k04-only-bootstrap\n' \
  > "$tmp/bootstrap.env"
printf 'k04-only-bootstrap' > "$tmp/admin-password"
cat > "$tmp/client.json" <<'CLIENT_JSON'
{
  "clientId": "k04-service",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret",
  "secret": "k04-disposable-client-secret"
}
CLIENT_JSON
cat > "$tmp/client-mtls.json" <<'CLIENT_MTLS_JSON'
{
  "clientId": "k04-mtls",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-x509",
  "attributes": {
    "x509.subjectdn": "CN=k04-mtls-client",
    "x509.casubjectdn": "CN=k04-mtls-ca"
  }
}
CLIENT_MTLS_JSON
cat > "$tmp/client-jwt.json" <<'CLIENT_JWT_JSON'
{
  "clientId": "k04-signed",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "directAccessGrantsEnabled": true,
  "clientAuthenticatorType": "client-secret-jwt",
  "secret": "k04-disposable-client-secret",
  "attributes": {"token.endpoint.auth.signing.alg": "HS256"}
}
CLIENT_JWT_JSON
cat > "$tmp/client-rsa-base.json" <<'CLIENT_RSA_JSON'
{
  "clientId": "k04-rs256",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "serviceAccountsEnabled": true,
  "clientAuthenticatorType": "client-jwt",
  "attributes": {"token.endpoint.auth.signing.alg":"RS256"}
}
CLIENT_RSA_JSON
cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
  "$tmp/client-rsa.pem" | tr -d '\r\n') ||
  error 'RSA public certificate encoding failed'
[ -n "$cert_body" ] || error 'RSA client certificate empty'
jq --arg cert "$cert_body" \
  '.attributes["jwt.credential.certificate"] = $cert' \
  "$tmp/client-rsa-base.json" > "$tmp/client-rsa.json" ||
  error 'Keycloak RSA client fixture JSON failed'
unset cert_body
for algorithm in ES256 ES384 ES512
do
  cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
    "$tmp/client-$algorithm.pem" | tr -d '\r\n') ||
    error "$algorithm EC certificate extraction failed"
  [ -n "$cert_body" ] || error "$algorithm EC certificate empty"
  jq --arg id "k04-$(printf '%s' "$algorithm" | tr '[:upper:]' '[:lower:]')" \
    --arg alg "$algorithm" --arg cert "$cert_body" \
    '.clientId = $id | .attributes["token.endpoint.auth.signing.alg"] = $alg |
     .attributes["jwt.credential.certificate"] = $cert' \
    "$tmp/client-rsa-base.json" > "$tmp/client-$algorithm.json" ||
    error "$algorithm EC client config failed"
done
unset cert_body
cert_body=$(sed '/-----BEGIN CERTIFICATE-----/d; /-----END CERTIFICATE-----/d' \
  "$tmp/client-eddsa.pem" | tr -d '\r\n') ||
  error 'composed Ed25519 certificate extraction failed'
[ -n "$cert_body" ] || error 'composed Ed25519 certificate empty'
jq --arg cert "$cert_body" \
  '.clientId = "k04-eddsa" |
   .attributes["token.endpoint.auth.signing.alg"] = "EdDSA" |
   .attributes["jwt.credential.certificate"] = $cert' \
  "$tmp/client-rsa-base.json" > "$tmp/client-eddsa.json" ||
  error 'composed EdDSA Keycloak client configuration failed'
unset cert_body

# Disposable external identity provider signs independently of Keycloak.
# Only its public key is registered with the actual receiving Keycloak.
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
  -out "$tmp/federated-issuer.key" >"$tmp/openssl.out" 2>"$tmp/openssl.err" ||
  error 'composed external issuer signing key generation failed'
openssl pkey -in "$tmp/federated-issuer.key" -pubout \
  -out "$tmp/federated-issuer-public.pem" 2>"$tmp/openssl.err" ||
  error 'composed external issuer public key generation failed'
chmod 600 "$tmp/federated-issuer.key" "$tmp/federated-issuer-public.pem" ||
  error 'composed external issuer key permissions failed'
federated_issuer=https://k04-external-issuer.invalid
jq -n --rawfile verifier "$tmp/federated-issuer-public.pem" \
  --arg issuer "$federated_issuer" '{
    alias:"k04-external-idp", providerId:"oidc", enabled:true,
    config:{
      issuer:$issuer, clientId:"k04-external",
      authorizationUrl:($issuer + "/authorize"),
      tokenUrl:($issuer + "/token"),
      supportsClientAssertions:"true",
      validateSignature:"true",
      useJwksUrl:"false",
      publicKeySignatureVerifier:$verifier
    }
  }' > "$tmp/federated-idp.json" ||
  error 'composed external issuer registration fixture failed'
cat > "$tmp/federated-client.json" <<'FEDERATED_CLIENT'
{
  "clientId":"k04-federated",
  "enabled":true,
  "protocol":"openid-connect",
  "publicClient":false,
  "serviceAccountsEnabled":true,
  "clientAuthenticatorType":"federated-jwt",
  "attributes":{
    "jwt.credential.issuer":"k04-external-idp",
    "jwt.credential.sub":"k04-external"
  },
  "protocolMappers":[{
    "name":"k04-federated-self-audience",
    "protocol":"openid-connect",
    "protocolMapper":"oidc-audience-mapper",
    "consentRequired":false,
    "config":{
      "included.custom.audience":"k04-federated",
      "access.token.claim":"true",
      "id.token.claim":"false"
    }
  }]
}
FEDERATED_CLIENT
# A separate RFC 7523 authorization grant maps a signed external subject
# onto an explicitly prelinked local Keycloak user.
jag_issuer=https://k04-jag-issuer.invalid
jq -n --rawfile verifier "$tmp/federated-issuer-public.pem" \
  --arg issuer "$jag_issuer" '{
    alias:"k04-jag-idp", providerId:"oidc", enabled:true,
    config:{
      issuer:$issuer, clientId:"k04-jag-external",
      authorizationUrl:($issuer + "/authorize"),
      tokenUrl:($issuer + "/token"),
      jwtAuthorizationGrantEnabled:"true",
      jwtAuthorizationGrantAssertionReuseAllowed:"false",
      useJwksUrl:"false",
      validateSignature:"true",
      publicKeySignatureVerifier:$verifier
    }
  }' > "$tmp/jag-idp.json" ||
  error 'composed JWT grant external IdP fixture unavailable'
cat > "$tmp/jag-client.json" <<'JAG_CLIENT'
{
  "clientId":"k04-jag-client",
  "enabled":true,
  "protocol":"openid-connect",
  "publicClient":false,
  "secret":"k04-disposable-client-secret",
  "attributes":{
    "oauth2.jwt.authorization.grant.enabled":"true",
    "oauth2.jwt.authorization.grant.idp":"k04-jag-idp"
  }
}
JAG_CLIENT
cat > "$tmp/jag-user.json" <<'JAG_USER'
{"username":"k04-jag-local-user","enabled":true}
JAG_USER
cat > "$tmp/sign-federated-jwt.py" <<'FEDERATED_SIGNER'
import base64
import json
import subprocess
import sys
import time
import uuid

issuer, subject, audience, key_path, output_path = sys.argv[1:6]
issued_at = int(time.time())


def urlsafe(value):
    return base64.urlsafe_b64encode(value).decode("ascii").rstrip("=")


header = urlsafe(json.dumps(
    {"alg": "RS256", "typ": "JWT"}, separators=(",", ":")
).encode("utf-8"))
payload = urlsafe(json.dumps({
    "iss": issuer, "sub": subject, "aud": audience, "iat": issued_at,
    "exp": issued_at + 180, "jti": str(uuid.uuid4()),
}, separators=(",", ":")).encode("utf-8"))
message = (header + "." + payload).encode("ascii")
signature = subprocess.run(
    ["openssl", "dgst", "-sha256", "-sign", key_path],
    input=message, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    check=True,
).stdout
with open(output_path, "w", encoding="ascii") as output:
    output.write(message.decode("ascii") + "." + urlsafe(signature))
FEDERATED_SIGNER

cat > "$tmp/keycloak/Dockerfile" <<'KC_DOCKERFILE'
ARG KC_VERSION
FROM quay.io/keycloak/keycloak:${KC_VERSION}
COPY --chown=1000:0 --chmod=600 server.key /opt/keycloak/conf/k04-server.key
COPY --chown=1000:0 --chmod=644 server.pem /opt/keycloak/conf/k04-server.pem
COPY --chown=1000:0 --chmod=644 mtls-ca.pem /opt/keycloak/conf/k04-mtls-ca.pem
KC_DOCKERFILE

cat > "$tmp/ssh/Dockerfile" <<'SSH_DOCKERFILE'
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server sudo curl jq python3 openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/sh k04operator \
    && echo 'k04operator:k04-only-ssh-password' | chpasswd \
    && printf 'k04operator ALL=(root) ALL\n' > /etc/sudoers.d/k04operator \
    && chmod 440 /etc/sudoers.d/k04operator \
    && mkdir -p /run/sshd /root/keycloak \
    && chmod 700 /root/keycloak \
    && ssh-keygen -A
COPY --chmod=644 ca.pem /root/keycloak/ca.pem
COPY --chmod=700 entrypoint.sh /opt/k04-entrypoint.sh
CMD ["/opt/k04-entrypoint.sh"]
SSH_DOCKERFILE
cat > "$tmp/ssh/entrypoint.sh" <<'SSH_ENTRYPOINT'
#!/bin/sh
set -e
umask 077
printf 'k04-disposable-client-secret\n' > /root/keycloak/secret
printf 'k04-only-bootstrap\n' > /root/keycloak/user-password
chmod 600 /root/keycloak/secret /root/keycloak/user-password
exec /usr/sbin/sshd -D -e -o PermitRootLogin=no \
  -o PasswordAuthentication=yes -o PubkeyAuthentication=no -o UsePAM=no
SSH_ENTRYPOINT

ssh_image=k04-composed-ssh-$$
docker build --quiet --tag "$ssh_image" "$tmp/ssh" > "$tmp/ssh-image-id" ||
  error 'disposable SSH/sudo container build failed'

cat > "$tmp/bin/k04-composed-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 91
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 92
loadsyslib "rsudo/rsudo" || exit 93
loadsyslib "rsudo/rsudo-mod-keycloak" || exit 94
RSUDO_HOST=k04-composed-ephemeral
RSUDO_USER=k04operator
RSUDO_PASSWORD=k04-only-ssh-password
RSUDO_INTERACTIVE=
RSUDO_ASKPASS=
if [ "${1-}" = admin-probe ]
then
  shift
  _rsudo_mod_keycloak_admin_transport_probe "$@"
elif [ "${1-}" = code-stream-proof ]
then
  shift
  [ "$#" -eq 0 ] || exit 95
  # Exercise existing rsudo noninteractive stdin. The remote shell source is
  # constant and contains no code, verifier, assertion, or token bytes.
  rsudo -- sh -c '
    umask 077
    IFS= read -r authorization_code || exit 71
    [ -n "$authorization_code" ] || exit 72
    [ ! -e /root/keycloak/code-from-stdin ] || exit 73
    (set -C; printf "%s\n" "$authorization_code" > /root/keycloak/code-from-stdin) || exit 74
    unset authorization_code
    printf "{\"received\":true}\n"
  '
else
  rsudo_mod_keycloak_auth "$@"
fi
PROBE
cat > "$tmp/bin/ssh" <<'SSH_WRAPPER'
#!/bin/sh
exec "$K04_REAL_SSH" -F "$K04_SSH_CONFIG" "$@"
SSH_WRAPPER
chmod 700 "$tmp/bin/ssh" "$tmp/bin/k04-composed-probe" ||
  error 'composed m/SSH probe not executable'
ssh_bin=$(command -v ssh) || error 'OpenSSH unavailable'

probe()
{
  K04_REAL_SSH="$ssh_bin" K04_SSH_CONFIG="$tmp/ssh_config" \
    PATH="$tmp/bin:$PATH" "$root/m" k04-composed-probe "$@"
}
acquire()
{
  probe acquire --server https://127.0.0.1:8443 --issuer-realm master \
    --auth-mode client-credentials --client-id k04-service \
    --client-auth "$1" --client-secret-file /root/keycloak/secret \
    --token-store "/root/keycloak/$2" --ca-file /root/keycloak/ca.pem
}
host_https()
{
  curl -q --silent --show-error --noproxy '*' --proxy '' \
    --proto '=https' --max-redirs 0 \
    --cacert "$tmp/keycloak/server.pem" --connect-timeout 4 \
    --max-time 25 "$@"
}

for version in 26.7.3 26.8.1
do
  keycloak_image=k04-composed-keycloak-$version-$$
  docker build --quiet --build-arg "KC_VERSION=$version" \
    --tag "$keycloak_image" "$tmp/keycloak" > "$tmp/keycloak-image-id" ||
    error "official Keycloak $version image build failed"
  # Publishing SSH port on the Keycloak namespace enables real OpenSSH from
  # the host even though sshd runs in a separate disposable sidecar.
  keycloak_container=$(docker run -d --memory 2g --network bridge \
    --publish 127.0.0.1::8443 --publish 127.0.0.1::22 \
    --env-file "$tmp/bootstrap.env" "$keycloak_image" \
    start-dev --http-enabled=false --hostname=https://127.0.0.1:8443 \
    --https-certificate-file=/opt/keycloak/conf/k04-server.pem \
    --https-certificate-key-file=/opt/keycloak/conf/k04-server.key \
    --https-client-auth=request \
    --https-trust-store-file=/opt/keycloak/conf/k04-mtls-ca.pem \
    --features=client-auth-federated) ||
    error "official Keycloak $version did not launch"
  [ -n "$keycloak_container" ] || error 'Keycloak container identity missing'
  mapping=$(docker port "$keycloak_container" 8443/tcp) ||
    error 'mapped HTTPS port unavailable'
  https_port=${mapping##*:}
  mapping=$(docker port "$keycloak_container" 22/tcp) ||
    error 'mapped SSH port unavailable'
  ssh_port=${mapping##*:}
  case "$https_port:$ssh_port" in
    *[!0-9:]*|:*|*:) error 'invalid mapped test ports' ;;
  esac
  host_base=https://127.0.0.1:$https_port

  tries=0
  until host_https --fail --output "$tmp/ready" \
    --url "$host_base/realms/master/.well-known/openid-configuration" \
    >/dev/null 2>"$tmp/ready.err"
  do
    [ "$(docker inspect -f '{{.State.Running}}' "$keycloak_container" 2>/dev/null)" = true ] || {
      docker logs --tail 12 "$keycloak_container" >&2
      error "Keycloak $version exited before readiness"
    }
    tries=$((tries+1))
    [ "$tries" -lt 130 ] || {
      docker logs --tail 12 "$keycloak_container" >&2
      error "Keycloak $version HTTPS readiness timed out"
    }
    sleep 1
  done
  jq -e '.issuer == "https://127.0.0.1:8443/realms/master"' "$tmp/ready" \
    >/dev/null || fail "Keycloak $version issuer does not bind to SSH namespace"

  admin_http=$(host_https --output "$tmp/admin-token" \
    --write-out '%{http_code}' --data-urlencode grant_type=password \
    --data-urlencode client_id=admin-cli --data-urlencode username=k04admin \
    --data-urlencode "password@$tmp/admin-password" \
    --url "$host_base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version bootstrap grant HTTP failed"
  [ "$admin_http" = 200 ] ||
    fail "Keycloak $version bootstrap grant rejected ($admin_http)"
  admin_token=$(jq -er '.access_token' "$tmp/admin-token") ||
    error 'bootstrap token response unavailable'
  printf 'Authorization: Bearer %s\n' "$admin_token" > "$tmp/admin-header"
  unset admin_token
  server_http=$(host_https --output "$tmp/serverinfo" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --url "$host_base/admin/serverinfo") ||
    error "Keycloak $version version evidence HTTP failed"
  [ "$server_http" = 200 ] || fail "Keycloak $version serverinfo denied ($server_http)"
  jq -e --arg version "$version" '.systemInfo.version == $version' \
    "$tmp/serverinfo" >/dev/null ||
    fail "Keycloak $version serverinfo version mismatch"
  create_http=$(host_https --output "$tmp/create-response" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version client provisioning HTTP failed"
  [ "$create_http" = 201 ] ||
    fail "Keycloak $version service-client provisioning rejected ($create_http)"

  # The external verifier, client and feature gate are configured before
  # crossing the real SSH/sudo boundary. Never transfer its signing key.
  external_idp_http=$(host_https \
    --output "$tmp/federated-idp-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/federated-idp.json" \
    --url "$host_base/admin/realms/master/identity-provider/instances") ||
    error "Keycloak $version composed federated IdP registration transport failed"
  [ "$external_idp_http" = 201 ] ||
    fail "Keycloak $version composed federated IdP registration rejected ($external_idp_http)"
  federated_client_http=$(host_https \
    --output "$tmp/federated-client-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/federated-client.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version composed federated client registration transport failed"
  [ "$federated_client_http" = 201 ] ||
    fail "Keycloak $version composed federated client registration rejected ($federated_client_http)"

  jag_idp_http=$(host_https --output "$tmp/jag-idp-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-idp.json" \
    --url "$host_base/admin/realms/master/identity-provider/instances") ||
    error "Keycloak $version composed JWT authorization grant IdP transport failed"
  [ "$jag_idp_http" = 201 ] ||
    fail "Keycloak $version composed JWT grant IdP rejected ($jag_idp_http)"
  jag_client_http=$(host_https --output "$tmp/jag-client-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-client.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version composed JWT authorization client transport failed"
  [ "$jag_client_http" = 201 ] ||
    fail "Keycloak $version composed JWT authorization client rejected ($jag_client_http)"
  jag_user_http=$(host_https --output "$tmp/jag-user-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-user.json" \
    --url "$host_base/admin/realms/master/users") ||
    error "Keycloak $version composed JWT grant user creation transport failed"
  [ "$jag_user_http" = 201 ] ||
    fail "Keycloak $version composed JWT grant user creation rejected ($jag_user_http)"
  jag_lookup_http=$(host_https --output "$tmp/jag-users-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --url "$host_base/admin/realms/master/users?username=k04-jag-local-user&exact=true") ||
    error "Keycloak $version composed JWT user lookup transport failed"
  [ "$jag_lookup_http" = 200 ] ||
    fail "Keycloak $version composed JWT user lookup rejected ($jag_lookup_http)"
  jag_user_uuid=$(jq -er '.[] | select(.username == "k04-jag-local-user") | .id' \
    "$tmp/jag-users-$version") ||
    fail "Keycloak $version composed JWT grant local user UUID missing"
  jq -n '{identityProvider:"k04-jag-idp",userId:"k04-jag-external-user",userName:"k04-jag-external-user"}' \
    > "$tmp/jag-link.json" ||
    error "Keycloak $version composed JWT external-user link fixture failed"
  jag_link_http=$(host_https --output "$tmp/jag-link-response-$version" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/jag-link.json" \
    --url "$host_base/admin/realms/master/users/$jag_user_uuid/federated-identity/k04-jag-idp") ||
    error "Keycloak $version composed JWT user link transport failed"
  [ "$jag_link_http" = 204 ] ||
    fail "Keycloak $version composed JWT user link rejected ($jag_link_http)"

  mtls_client_http=$(host_https --output "$tmp/mtls-client-response" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-mtls.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version composed X509 client registration failed"
  [ "$mtls_client_http" = 201 ] ||
    fail "Keycloak $version composed X509 client create rejected ($mtls_client_http)"

  jwt_client_http=$(host_https --output "$tmp/jwt-client-response" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-jwt.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version SSH test JWT client provisioning HTTP failed"
  [ "$jwt_client_http" = 201 ] ||
    fail "Keycloak $version SSH test JWT client provisioning rejected ($jwt_client_http)"

  for algorithm in HS384 HS512
  do
    case "$algorithm" in
      HS384) signed_id=k04-signed-hs384 ;;
      HS512) signed_id=k04-signed-hs512 ;;
    esac
    jq --arg cid "$signed_id" --arg alg "$algorithm" \
      '.clientId = $cid | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-jwt.json" > "$tmp/client-$algorithm.json" ||
      error "Keycloak $version cannot build SSH $algorithm fixture"
    jwt_http=$(host_https --output "$tmp/create-$algorithm" \
      --write-out '%{http_code}' --header "@$tmp/admin-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$host_base/admin/realms/master/clients") ||
      error "Keycloak $version SSH $algorithm client create transport failed"
    [ "$jwt_http" = 201 ] ||
      fail "Keycloak $version SSH $algorithm client create failed ($jwt_http)"
  done

  rsa_client_http=$(host_https --output "$tmp/rsa-client-response" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-rsa.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version SSH test RSA JWT provisioning HTTP failed"
  [ "$rsa_client_http" = 201 ] ||
    fail "Keycloak $version SSH RSA JWT client create rejected ($rsa_client_http)"

  # Register separate clients with explicit RSA and RSA-PSS signing policies.
  for algorithm in RS384 RS512 PS256 PS384 PS512
  do
    case "$algorithm" in
      RS384) rsa_id=k04-rs384 ;;
      RS512) rsa_id=k04-rs512 ;;
      PS256) rsa_id=k04-ps256 ;;
      PS384) rsa_id=k04-ps384 ;;
      PS512) rsa_id=k04-ps512 ;;
    esac
    jq --arg id "$rsa_id" --arg alg "$algorithm" \
      '.clientId = $id | .attributes["token.endpoint.auth.signing.alg"] = $alg' \
      "$tmp/client-rsa.json" > "$tmp/rsa-$algorithm.json" ||
      error "Keycloak $version cannot build SSH $algorithm client"
    rsa_client_http=$(host_https --output "$tmp/rsa-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/admin-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/rsa-$algorithm.json" \
      --url "$host_base/admin/realms/master/clients") ||
      error "Keycloak $version SSH $algorithm client provisioning failed"
    [ "$rsa_client_http" = 201 ] ||
      fail "Keycloak $version SSH $algorithm client create rejected ($rsa_client_http)"
  done

  # Register clients with per-curve public certificates before exercising
  # the ECDSA assertions over the real composed remote path.
  for algorithm in ES256 ES384 ES512
  do
    ec_http=$(host_https --output "$tmp/ec-$algorithm-response" \
      --write-out '%{http_code}' --header "@$tmp/admin-header" \
      --header 'Content-Type: application/json' \
      --data-binary "@$tmp/client-$algorithm.json" \
      --url "$host_base/admin/realms/master/clients") ||
      error "Keycloak $version $algorithm EC client registration transport failed"
    [ "$ec_http" = 201 ] ||
      fail "Keycloak $version $algorithm EC registration rejected ($ec_http)"
  done

  eddsa_http=$(host_https --output "$tmp/eddsa-client-response" \
    --write-out '%{http_code}' --header "@$tmp/admin-header" \
    --header 'Content-Type: application/json' \
    --data-binary "@$tmp/client-eddsa.json" \
    --url "$host_base/admin/realms/master/clients") ||
    error "Keycloak $version EdDSA client registration transport failed"
  [ "$eddsa_http" = 201 ] ||
    fail "Keycloak $version EdDSA client registration rejected ($eddsa_http)"

  # Shared Docker network namespace makes the actual Keycloak listener
  # reachable as HTTPS 127.0.0.1:8443 from the real SSH/sudo target.
  ssh_container=$(docker run -d \
    --network "container:$keycloak_container" \
    --security-opt no-new-privileges=false "$ssh_image") ||
    error "Keycloak $version SSH/sudo sidecar did not launch"
  [ -n "$ssh_container" ] || error 'SSH sidecar identity missing'
  hostkey=$(docker exec "$ssh_container" cat /etc/ssh/ssh_host_ed25519_key.pub) ||
    error 'SSH sidecar host key unavailable'
  set -- $hostkey
  [ "$1" = ssh-ed25519 ] && [ -n "$2" ] || error 'SSH host key malformed'
  printf '%s %s %s\n' k04-composed-ephemeral "$1" "$2" > "$tmp/known_hosts" ||
    error 'pinned known_hosts unavailable'
  cat > "$tmp/ssh_config" <<EOF_SSH_CONFIG
Host k04-composed-ephemeral
  HostName 127.0.0.1
  HostKeyAlias k04-composed-ephemeral
  Port $ssh_port
  UserKnownHostsFile $tmp/known_hosts
  StrictHostKeyChecking yes
  PreferredAuthentications password
  PasswordAuthentication yes
  PubkeyAuthentication no
  KbdInteractiveAuthentication no
  IdentitiesOnly yes
  ControlMaster no
  ControlPath none
  ConnectTimeout 4
EOF_SSH_CONFIG
  tries=0
  until docker exec "$ssh_container" sh -c 'test -e /run/sshd.pid' >/dev/null 2>&1
  do
    [ "$(docker inspect -f '{{.State.Running}}' "$ssh_container" 2>/dev/null)" = true ] ||
      error "Keycloak $version SSH sidecar exited"
    tries=$((tries+1))
    [ "$tries" -lt 60 ] || error "Keycloak $version SSH daemon not ready"
    sleep 0.1
  done

  # Private key and public X509 certificate are disposable and are staged
  # as protected files owned by the remote sudo identity; no private bytes
  # traverse the m/rsudo argument vector or the host shell script.
  docker cp "$tmp/client-rsa.key" "$ssh_container:/root/keycloak/client-rsa.key" ||
    error "Keycloak $version remote RSA private key fixture copy failed"
  docker cp "$tmp/client-rsa.pem" "$ssh_container:/root/keycloak/client-rsa.pem" ||
    error "Keycloak $version remote RSA certificate fixture copy failed"
  docker exec "$ssh_container" sh -c \
    'chown 0:0 /root/keycloak/client-rsa.key /root/keycloak/client-rsa.pem &&
     chmod 600 /root/keycloak/client-rsa.key /root/keycloak/client-rsa.pem' ||
    error "Keycloak $version remote RSA key/cert permissions unavailable"
  for algorithm in ES256 ES384 ES512
  do
    docker cp "$tmp/client-$algorithm.key" \
      "$ssh_container:/root/keycloak/client-$algorithm.key" ||
      error "Keycloak $version $algorithm remote EC key copy failed"
    docker cp "$tmp/client-$algorithm.pem" \
      "$ssh_container:/root/keycloak/client-$algorithm.pem" ||
      error "Keycloak $version $algorithm remote EC cert copy failed"
    docker exec "$ssh_container" sh -c \
      "chown 0:0 /root/keycloak/client-$algorithm.key /root/keycloak/client-$algorithm.pem &&
       chmod 600 /root/keycloak/client-$algorithm.key /root/keycloak/client-$algorithm.pem" ||
      error "Keycloak $version $algorithm remote EC permissions failed"
  done
  docker cp "$tmp/client-eddsa.key" "$ssh_container:/root/keycloak/client-eddsa.key" ||
    error "Keycloak $version Ed25519 remote key staging failed"
  docker cp "$tmp/client-eddsa.pem" "$ssh_container:/root/keycloak/client-eddsa.pem" ||
    error "Keycloak $version Ed25519 remote certificate staging failed"
  docker exec "$ssh_container" sh -c \
    'chown 0:0 /root/keycloak/client-eddsa.key /root/keycloak/client-eddsa.pem &&
     chmod 600 /root/keycloak/client-eddsa.key /root/keycloak/client-eddsa.pem' ||
    error "Keycloak $version Ed25519 remote credential permissions unavailable"

  for identity in good wrong
  do
    docker cp "$tmp/mtls-$identity.key" \
      "$ssh_container:/root/keycloak/mtls-$identity.key" ||
      error "Keycloak $version remote mTLS $identity key staging failed"
    docker cp "$tmp/mtls-$identity.pem" \
      "$ssh_container:/root/keycloak/mtls-$identity.pem" ||
      error "Keycloak $version remote mTLS $identity cert staging failed"
    docker exec "$ssh_container" sh -c \
      "chown 0:0 /root/keycloak/mtls-$identity.key /root/keycloak/mtls-$identity.pem &&
       chmod 600 /root/keycloak/mtls-$identity.key /root/keycloak/mtls-$identity.pem" ||
      error "Keycloak $version remote mTLS $identity credentials insecure"
  done

  # Prove the only existing viable code-transfer boundary before adding a
  # public human browser grant: local secret bytes travel over rsudo stdin
  # after SSH/sudo authentication, not as command argv or shell source.
  printf 'k04-synthetic-auth-code-%s\n' "$version" \
    > "$tmp/expected-code-$version" ||
    error "Keycloak $version synthetic callback code unavailable"
  docker cp "$tmp/expected-code-$version" \
    "$ssh_container:/root/keycloak/expected-code" ||
    error "Keycloak $version remote comparison fixture unavailable"
  docker exec "$ssh_container" chmod 600 /root/keycloak/expected-code ||
    error "Keycloak $version protected synthetic comparison file unavailable"
  code_stream_result=$(cat "$tmp/expected-code-$version" |
    probe code-stream-proof 2>"$tmp/code-stream.err")
  code_stream_status=$?
  [ "$code_stream_status" -eq 0 ] &&
    [ "$code_stream_result" = '{"received":true}' ] &&
    docker exec "$ssh_container" cmp -s /root/keycloak/expected-code \
      /root/keycloak/code-from-stdin &&
    [ "$(docker exec "$ssh_container" stat -c %a /root/keycloak/code-from-stdin)" = 600 ] ||
    fail "Keycloak $version SSH/sudo stdin authorization-code transfer failed ($code_stream_status)"
  if grep -F "k04-synthetic-auth-code-$version" "$tmp/code-stream.err" >/dev/null
  then
    fail "Keycloak $version leaked one-time code via rsudo diagnostics"
  fi
  printf '%s: Keycloak %s existing rsudo stdin delivered protected code without argv/log disclosure\n' \
    "$TEST_ID" "$version"

  # The grant JWT is signed outside the SSH target; only the compact
  # assertion is staged as root-owned 0600 data. Distinct from client JWT.
  python3 "$tmp/sign-federated-jwt.py" "$jag_issuer" \
    k04-jag-external-user https://127.0.0.1:8443/realms/master \
    "$tmp/federated-issuer.key" "$tmp/jag-assertion-$version" ||
    error "Keycloak $version composed RFC7523 grant assertion signing failed"
  docker cp "$tmp/jag-assertion-$version" \
    "$ssh_container:/root/keycloak/jag-assertion" ||
    error "Keycloak $version composed RFC7523 grant assertion staging failed"
  docker exec "$ssh_container" sh -c \
    'chown 0:0 /root/keycloak/jag-assertion &&
     chmod 600 /root/keycloak/jag-assertion' ||
    error "Keycloak $version composed RFC7523 assertion protection failed"
  jag_result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode jwt-bearer \
    --client-id k04-jag-client --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --assertion-file /root/keycloak/jag-assertion \
    --token-store "/root/keycloak/jag-token-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  jag_status=$?
  [ "$jag_status" -eq 0 ] &&
    printf '%s\n' "$jag_result" | jq -e \
      '.stored == true and .grant == "urn:ietf:params:oauth:grant-type:jwt-bearer"' >/dev/null &&
    docker exec "$ssh_container" jq -e \
      '(.access_token | type == "string" and length > 0) and
       (has("refresh_token") | not)' "/root/keycloak/jag-token-$version" >/dev/null ||
    fail "Keycloak $version composed RFC7523 user grant failed ($jag_status)"
  # Incorrectly mixing an explicit local username with an externally
  # linked user grant is rejected before SSH, without creating a store.
  jag_bad_user=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode jwt-bearer \
    --client-id k04-jag-client --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --username forbidden-user --assertion-file /root/keycloak/jag-assertion \
    --token-store "/root/keycloak/jag-bad-user-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  jag_bad_user_status=$?
  [ "$jag_bad_user_status" -eq 64 ] && [ -z "$jag_bad_user" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/jag-bad-user-$version" ||
    fail "Keycloak $version composed RFC7523 accepted local user selector ($jag_bad_user_status)"
  jag_repeat=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode jwt-bearer \
    --client-id k04-jag-client --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --assertion-file /root/keycloak/jag-assertion \
    --token-store "/root/keycloak/jag-replay-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  jag_repeat_status=$?
  [ "$jag_repeat_status" -eq 72 ] && [ -z "$jag_repeat" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/jag-replay-$version" ||
    fail "Keycloak $version composed RFC7523 replay was accepted ($jag_repeat_status)"
  for marker in '"access_token"' '"refresh_token"' 'eyJhbGciOiJSUzI1Ni'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version composed JWT grant leaked protected material"
  done
  printf '%s: Keycloak %s RFC7523 grant through composed SSH/sudo verified\n' \
    "$TEST_ID" "$version"

  # Only the signed compact assertion is provisioned in the isolated
  # SSH/sudo host. Its external issuer private key stays outside the target.
  python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
    k04-external https://127.0.0.1:8443/realms/master \
    "$tmp/federated-issuer.key" "$tmp/federated-assertion-$version" ||
    error "Keycloak $version composed assertion signing failed"
  docker cp "$tmp/federated-assertion-$version" \
    "$ssh_container:/root/keycloak/federated-assertion" ||
    error "Keycloak $version composed assertion staging failed"
  docker exec "$ssh_container" sh -c \
    'chown 0:0 /root/keycloak/federated-assertion &&
     chmod 600 /root/keycloak/federated-assertion' ||
    error "Keycloak $version composed assertion protection failed"
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file /root/keycloak/federated-assertion \
    --token-store "/root/keycloak/federated-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version composed federated JWT acquisition failed ($status)"
  docker exec "$ssh_container" jq -e \
    '.access_token | type == "string" and length > 0' \
    "/root/keycloak/federated-$version" >/dev/null ||
    fail "Keycloak $version composed federated store unavailable"
  result=$(probe status --token-file "/root/keycloak/federated-$version" \
    2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version composed federated offline status failed ($status)"

  # Each online lifecycle action obtains a separate externally signed JWT,
  # staging only the compact assertion on the real SSH/sudo target.
  docker exec "$ssh_container" cp "/root/keycloak/federated-$version" \
    "/root/keycloak/federated-before-lifecycle-$version" ||
    error "Keycloak $version composed federated token snapshot failed"
  for lifecycle in status revoke
  do
    python3 "$tmp/sign-federated-jwt.py" "$federated_issuer" \
      k04-external https://127.0.0.1:8443/realms/master \
      "$tmp/federated-issuer.key" "$tmp/federated-$lifecycle-$version" ||
      error "Keycloak $version composed $lifecycle assertion signing failed"
    docker cp "$tmp/federated-$lifecycle-$version" \
      "$ssh_container:/root/keycloak/federated-$lifecycle-assertion" ||
      error "Keycloak $version composed $lifecycle assertion copy failed"
    docker exec "$ssh_container" sh -c \
      "chown 0:0 /root/keycloak/federated-$lifecycle-assertion &&
       chmod 600 /root/keycloak/federated-$lifecycle-assertion" ||
      error "Keycloak $version composed $lifecycle assertion protection failed"
  done
  result=$(probe status --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file /root/keycloak/federated-status-assertion \
    --token-file "/root/keycloak/federated-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  # Introspection audience enforcement remains enabled: this client
  # is an explicit access-token audience in the test's OIDC protocol mapper.
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        .active == true' >/dev/null ||
    fail "Keycloak $version composed federated audience-qualified status failed ($status)"
  result=$(probe revoke --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-federated \
    --client-auth federated-jwt \
    --assertion-file /root/keycloak/federated-revoke-assertion \
    --token-file "/root/keycloak/federated-$version" \
    --token-type-hint access_token \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] &&
    docker exec "$ssh_container" cmp -s \
      "/root/keycloak/federated-$version" \
      "/root/keycloak/federated-before-lifecycle-$version" ||
    fail "Keycloak $version composed federated revoke failed or changed store ($status)"
  printf '%s: Keycloak %s federated introspection/revocation through composed SSH/sudo with distinct assertions verified\n' \
    "$TEST_ID" "$version"

  printf 'not-a-jwt\n' > "$tmp/federated-malformed-$version"
  docker cp "$tmp/federated-malformed-$version" \
    "$ssh_container:/root/keycloak/federated-malformed" ||
    error "Keycloak $version composed malformed assertion staging failed"
  docker exec "$ssh_container" sh -c \
    'chown 0:0 /root/keycloak/federated-malformed &&
     chmod 600 /root/keycloak/federated-malformed' ||
    error "Keycloak $version composed malformed assertion protection failed"
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-federated --client-auth federated-jwt \
    --assertion-file /root/keycloak/federated-malformed \
    --token-store "/root/keycloak/federated-rejected-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/federated-rejected-$version" ||
    fail "Keycloak $version composed malformed federated assertion accepted ($status)"
  for marker in '"access_token"' '"refresh_token"' 'eyJhbGciOiJSUzI1Ni'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version composed federated assertion or token leaked"
  done
  printf '%s: Keycloak %s federated JWT acquired through real SSH/sudo with protected remote assertion\n' \
    "$TEST_ID" "$version"

  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-rs256 --client-auth private-key-jwt \
    --private-key-file /root/keycloak/client-rsa.key \
    --certificate-file /root/keycloak/client-rsa.pem \
    --token-store "/root/keycloak/rsa-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version composed RSA signed client grant failed ($status)"
  docker exec "$ssh_container" jq -e \
    '.access_token | type == "string" and length > 0' \
    "/root/keycloak/rsa-$version" >/dev/null ||
    fail "Keycloak $version RSA token not stored on sudo target"
  result=$(probe status --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-rs256 \
    --client-auth private-key-jwt \
    --private-key-file /root/keycloak/client-rsa.key \
    --certificate-file /root/keycloak/client-rsa.pem \
    --token-file "/root/keycloak/rsa-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version composed RSA signed introspection failed ($status)"
  # Exercise each selected RSA/PS algorithm through the real SSH/sudo target and
  # the same protected certificate/key already staged for RS256.
  for algorithm in RS384 RS512 PS256 PS384 PS512
  do
    case "$algorithm" in
      RS384) rsa_id=k04-rs384 ;;
      RS512) rsa_id=k04-rs512 ;;
      PS256) rsa_id=k04-ps256 ;;
      PS384) rsa_id=k04-ps384 ;;
      PS512) rsa_id=k04-ps512 ;;
    esac
    result=$(probe acquire --server https://127.0.0.1:8443 \
      --issuer-realm master --auth-mode client-credentials \
      --client-id "$rsa_id" --client-auth private-key-jwt \
      --client-jwt-alg "$algorithm" \
      --private-key-file /root/keycloak/client-rsa.key \
      --certificate-file /root/keycloak/client-rsa.pem \
      --token-store "/root/keycloak/$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
      fail "Keycloak $version composed $algorithm grant failed ($status)"
    docker exec "$ssh_container" jq -e \
      '.access_token | type == "string" and length > 0' \
      "/root/keycloak/$algorithm-$version" >/dev/null ||
      fail "Keycloak $version composed $algorithm token not private on target"
    result=$(probe status --server https://127.0.0.1:8443 \
      --issuer-realm master --client-id "$rsa_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file /root/keycloak/client-rsa.key \
      --certificate-file /root/keycloak/client-rsa.pem \
      --token-file "/root/keycloak/$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version composed $algorithm introspection failed ($status)"
  done
  grep -E 'eyJhbGciOiJ(SUz|QUz)' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version RSA/PS assertion leaked to diagnostics"

  for algorithm in ES256 ES384 ES512
  do
    ec_id=k04-$(printf '%s' "$algorithm" | tr '[:upper:]' '[:lower:]')
    result=$(probe acquire --server https://127.0.0.1:8443 \
      --issuer-realm master --auth-mode client-credentials \
      --client-id "$ec_id" --client-auth private-key-jwt \
      --client-jwt-alg "$algorithm" \
      --private-key-file "/root/keycloak/client-$algorithm.key" \
      --certificate-file "/root/keycloak/client-$algorithm.pem" \
      --token-store "/root/keycloak/$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
      fail "Keycloak $version composed $algorithm ECDSA acquisition failed ($status)"
    docker exec "$ssh_container" jq -e \
      '.access_token | type == "string" and length > 0' \
      "/root/keycloak/$algorithm-$version" >/dev/null ||
      fail "Keycloak $version $algorithm ECDSA token absent on sudo target"
    result=$(probe status --server https://127.0.0.1:8443 \
      --issuer-realm master --client-id "$ec_id" \
      --client-auth private-key-jwt --client-jwt-alg "$algorithm" \
      --private-key-file "/root/keycloak/client-$algorithm.key" \
      --certificate-file "/root/keycloak/client-$algorithm.pem" \
      --token-file "/root/keycloak/$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version composed $algorithm ECDSA introspection failed ($status)"
  done
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-es256 --client-auth private-key-jwt --client-jwt-alg ES256 \
    --private-key-file /root/keycloak/client-ES384.key \
    --certificate-file /root/keycloak/client-ES384.pem \
    --token-store "/root/keycloak/wrong-ec-curve-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 73 ] && [ -z "$result" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/wrong-ec-curve-$version" ||
    fail "Keycloak $version composed ES256 accepted P-384 key ($status)"
  grep -F 'eyJhbGciOiJFUz' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version EC JWT assertion leaked into diagnostics"

  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-eddsa --client-auth private-key-jwt \
    --client-jwt-alg EdDSA \
    --private-key-file /root/keycloak/client-eddsa.key \
    --certificate-file /root/keycloak/client-eddsa.pem \
    --token-store "/root/keycloak/eddsa-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version composed Ed25519 signed client acquisition failed ($status)"
  docker exec "$ssh_container" jq -e \
    '.access_token | type == "string" and length > 0' \
    "/root/keycloak/eddsa-$version" >/dev/null ||
    fail "Keycloak $version Ed25519 private token store missing on sudo target"
  result=$(probe status --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-eddsa --client-auth private-key-jwt \
    --client-jwt-alg EdDSA \
    --private-key-file /root/keycloak/client-eddsa.key \
    --certificate-file /root/keycloak/client-eddsa.pem \
    --token-file "/root/keycloak/eddsa-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version composed Ed25519 introspection failed ($status)"
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-eddsa --client-auth private-key-jwt \
    --client-jwt-alg RS256 \
    --private-key-file /root/keycloak/client-eddsa.key \
    --certificate-file /root/keycloak/client-eddsa.pem \
    --token-store "/root/keycloak/eddsa-rsa-rejected-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 73 ] && [ -z "$result" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/eddsa-rsa-rejected-$version" ||
    fail "Keycloak $version composed Ed25519 key accepted RS256 ($status)"

  # The same client certificate is presented by remote curl for discovery,
  # token and introspection. Keycloak independently validates the chain and
  # exact registered client/CA distinguished names.
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file /root/keycloak/mtls-good.key \
    --certificate-file /root/keycloak/mtls-good.pem \
    --token-store "/root/keycloak/mtls-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version composed mTLS acquisition rejected ($status)"
  docker exec "$ssh_container" jq -e \
    '.access_token | type == "string" and length > 0' \
    "/root/keycloak/mtls-$version" >/dev/null ||
    fail "Keycloak $version composed mTLS remote protected token missing"
  result=$(probe status --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file /root/keycloak/mtls-good.key \
    --certificate-file /root/keycloak/mtls-good.pem \
    --token-file "/root/keycloak/mtls-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version composed mTLS introspection failed ($status)"
  # The fixed K04 protected Admin GET reuses the same certificate at the
  # actual remote sudo target. A valid service-account token without a realm
  # admin role must still be denied by the real Keycloak Admin REST API.
  result=$(probe admin-probe --server https://127.0.0.1:8443 \
    --issuer-realm master --target-realm master \
    --token-file "/root/keycloak/mtls-$version" \
    --client-auth tls-client-auth \
    --private-key-file /root/keycloak/mtls-good.key \
    --certificate-file /root/keycloak/mtls-good.pem \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 80 ] && [ -z "$result" ] ||
    fail "Keycloak $version composed Admin mTLS GET did not preserve 403 ($status)"
  result=$(probe admin-probe --server https://127.0.0.1:8443 \
    --issuer-realm master --target-realm master \
    --token-file "/root/keycloak/mtls-$version" \
    --client-auth tls-client-auth \
    --private-key-file /root/keycloak/mtls-good.key \
    --certificate-file /root/keycloak/mtls-wrong.pem \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 70 ] && [ -z "$result" ] ||
    fail "Keycloak $version composed Admin mTLS GET accepted mismatched key ($status)"
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-mtls --client-auth tls-client-auth \
    --private-key-file /root/keycloak/mtls-wrong.key \
    --certificate-file /root/keycloak/mtls-wrong.pem \
    --token-store "/root/keycloak/mtls-denied-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 71 ] && [ -z "$result" ] &&
    ! docker exec "$ssh_container" test -e "/root/keycloak/mtls-denied-$version" ||
    fail "Keycloak $version composed X509 accepted wrong subject DN ($status)"

  # Signed assertion is created and sent on the real remote sudo target.
  # SSH shell arguments contain selectors and protected file paths only.
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode client-credentials \
    --client-id k04-signed --client-auth client-secret-jwt \
    --client-secret-file /root/keycloak/secret \
    --token-store "/root/keycloak/signed-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version composed SSH HS256 client-secret-jwt failed ($status)"
  docker exec "$ssh_container" sh -c \
    "test \"\$(stat -c %a /root/keycloak/signed-$version)\" = 600 &&
     jq -e '.access_token | type == \"string\" and length > 0' /root/keycloak/signed-$version >/dev/null" ||
    fail "Keycloak $version composed HS256 token was not stored privately"
  result=$(probe status --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-signed \
    --client-auth client-secret-jwt \
    --client-secret-file /root/keycloak/secret \
    --token-file "/root/keycloak/signed-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    printf '%s\n' "$result" |
      jq -e '.stored == true and .server_validated == true and
        (.active | type == "boolean")' >/dev/null ||
    fail "Keycloak $version composed HS256 introspection failed ($status)"
  for sensitive in k04-disposable-client-secret '"access_token"' 'eyJhbGciOiJIUzI1Ni'
  do
    grep -F "$sensitive" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version composed JWT assertions/secrets leaked to diagnostics"
  done

  # Both stronger HMAC algorithms must be selected explicitly and signed
  # on the actual remote sudo host, never in the local m caller.
  for algorithm in HS384 HS512
  do
    case "$algorithm" in
      HS384) signed_id=k04-signed-hs384 ;;
      HS512) signed_id=k04-signed-hs512 ;;
    esac
    result=$(probe acquire --server https://127.0.0.1:8443 \
      --issuer-realm master --auth-mode client-credentials \
      --client-id "$signed_id" --client-auth client-secret-jwt \
      --client-jwt-alg "$algorithm" \
      --client-secret-file /root/keycloak/secret \
      --token-store "/root/keycloak/signed-$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
      fail "Keycloak $version composed SSH $algorithm acquisition failed ($status)"
    docker exec "$ssh_container" jq -e \
      '.access_token | type == "string" and length > 0' \
      "/root/keycloak/signed-$algorithm-$version" >/dev/null ||
      fail "Keycloak $version SSH $algorithm private token missing"
    result=$(probe status --server https://127.0.0.1:8443 \
      --issuer-realm master --client-id "$signed_id" \
      --client-auth client-secret-jwt --client-jwt-alg "$algorithm" \
      --client-secret-file /root/keycloak/secret \
      --token-file "/root/keycloak/signed-$algorithm-$version" \
      --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
    status=$?
    [ "$status" -eq 0 ] &&
      printf '%s\n' "$result" |
        jq -e '.stored == true and .server_validated == true and
          (.active | type == "boolean")' >/dev/null ||
      fail "Keycloak $version composed SSH $algorithm introspection failed ($status)"
    grep -F 'k04-disposable-client-secret' "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version $algorithm signing leaked secret to diagnostics"
  done

  result=$(acquire client-secret-basic "basic-$version" 2>"$tmp/auth.err")
  status=$?
  if [ "$status" -ne 0 ]
  then
    tail -n 7 "$tmp/auth.err" >&2
    fail "Keycloak $version real SSH/password-sudo/Basic failed ($status)"
  fi
  [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version unexpected successful token status"
  docker exec "$ssh_container" sh -c \
    "test \"\$(stat -c %a /root/keycloak/basic-$version)\" = 600 &&
     jq -e '.access_token|type==\"string\" and length>0' /root/keycloak/basic-$version >/dev/null" ||
    fail "Keycloak $version sudo target did not create a private token"
  result=$(probe status --token-file "/root/keycloak/basic-$version" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] && [ "$result" = '{"stored":true,"server_validated":false}' ] ||
    fail "Keycloak $version SSH/password-sudo token status failed"

  # Online status must introspect through the same authenticated remote
  # SSH/sudo boundary; no token or provider claims enter caller stdout.
  result=$(probe status --token-file "/root/keycloak/basic-$version" \
    --server https://127.0.0.1:8443 --issuer-realm master \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file /root/keycloak/secret \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] ||
    fail "Keycloak $version composed SSH introspection transport failed ($status)"
  case "$result" in
    '{"stored":true,"server_validated":true,"active":true}'|'{"stored":true,"server_validated":true,"active":false}') : ;;
    *) fail "Keycloak $version composed SSH introspection returned an unsafe/nonboolean status" ;;
  esac
  for marker in k04-disposable-client-secret k04-only-ssh-password '"access_token"'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version introspection leaked sensitive data"
  done


  # K04 internal realm read across the full real SSH/sudo boundary:
  # a service account without view-realm must get HTTP 403 (exit 80).
  result=$(probe admin-probe --server https://127.0.0.1:8443 \
    --issuer-realm master --target-realm master \
    --token-file "/root/keycloak/basic-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 80 ] && [ -z "$result" ] ||
    fail "Keycloak $version composed unprivileged Admin Bearer read was not forbidden ($status)"

  # A separately authorized administrative token is staged into a protected
  # file in the disposable SSH sidecar. This is *not* a production credential
  # transfer mechanism or a public caller token-import feature.
  docker cp "$tmp/admin-token" "$ssh_container:/root/keycloak/admin-$version" ||
    error "Keycloak $version cannot stage isolated admin token"
  docker exec "$ssh_container" sh -c     "chown 0:0 /root/keycloak/admin-$version &&
     chmod 600 /root/keycloak/admin-$version" ||
    error "Keycloak $version cannot protect synthetic admin token"
  result=$(probe admin-probe --server https://127.0.0.1:8443 \
    --issuer-realm master --target-realm master \
    --token-file "/root/keycloak/admin-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"http_status":200,"authorized":true,"body_suppressed":true}' ] ||
    fail "Keycloak $version composed authenticated Admin Bearer read failed ($status)"

  # Even a syntactically valid expired/rejected token must fail 401-class,
  # not silently refresh or fall back to privileged credentials.
  docker exec "$ssh_container" sh -c \
    'printf "%s\n" "{\"access_token\":\"K04-SYNTHETIC-EXPIRED\"}" > /root/keycloak/rejected-bearer &&
     chmod 600 /root/keycloak/rejected-bearer' ||
    error "Keycloak $version cannot create synthetic expired-token source"
  result=$(probe admin-probe --server https://127.0.0.1:8443 \
    --issuer-realm master --target-realm master \
    --token-file /root/keycloak/rejected-bearer \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 79 ] && [ -z "$result" ] ||
    fail "Keycloak $version composed rejected Bearer did not fail 401-class ($status)"
  grep -F 'K04-SYNTHETIC-EXPIRED' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version composed Admin Bearer diagnostic leaked credentials"

  # A valid client token is not an administrative authorization. Keep the
  # bearer only in a protected header file inside the isolated SSH sidecar.
  docker exec "$ssh_container" sh -c \
    "jq -r '.access_token' /root/keycloak/basic-$version |
     { IFS= read -r token; printf 'Authorization: Bearer %s\\n' \"\$token\"; } > /root/keycloak/bearer-header &&
     chmod 600 /root/keycloak/bearer-header &&
     curl -q --silent --noproxy '*' --proxy '' --proto '=https' \
       --cacert /root/keycloak/ca.pem --output /root/keycloak/admin-result \
       --write-out '%{http_code}' --header @/root/keycloak/bearer-header \
       --url https://127.0.0.1:8443/admin/serverinfo" \
    >"$tmp/denied-http" ||
    error "Keycloak $version SSH namespace Admin HTTP probe failed"
  [ "$(cat "$tmp/denied-http")" = 403 ] ||
    fail "Keycloak $version service account unexpectedly had Admin REST rights"

  docker exec "$ssh_container" sh -c \
    "printf 'k04operator ALL=(root) NOPASSWD: ALL\\n' > /etc/sudoers.d/k04operator &&
     chmod 440 /etc/sudoers.d/k04operator" ||
    error "Keycloak $version sudo NOPASSWD switch failed"
  result=$(acquire client-secret-post "post-$version" 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] && [ "$result" = '{"stored":true,"grant":"client_credentials","server_validated":false}' ] ||
    fail "Keycloak $version real SSH/NOPASSWD sudo/POST failed ($status)"
  docker exec "$ssh_container" jq -e '.access_token | type == "string" and length > 0' \
    "/root/keycloak/post-$version" >/dev/null ||
    fail "Keycloak $version NOPASSWD sudo token invalid"
  for marker in k04-disposable-client-secret k04-only-ssh-password '"access_token"'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version secrets leaked through real SSH/sudo diagnostics"
  done

  # Human Direct Access Grant is explicit: no fallback or password in argv.
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode password --username k04admin \
    --password-file /root/keycloak/user-password \
    --client-id k04-service --client-auth client-secret-basic \
    --client-secret-file /root/keycloak/secret \
    --token-store "/root/keycloak/user-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"grant":"password","server_validated":false}' ] ||
    fail "Keycloak $version composed SSH/Direct Grant failed ($status)"
  docker exec "$ssh_container" sh -c \
    "test \"\$(stat -c %a /root/keycloak/user-$version)\" = 600 &&
     jq -e '.access_token | type == \"string\" and length > 0' /root/keycloak/user-$version >/dev/null" ||
    fail "Keycloak $version user password grant stored insecure token"
  grep -F 'k04-only-bootstrap' "$tmp/auth.err" >/dev/null &&
    fail "Keycloak $version user password leaked in SSH diagnostics"
  docker exec "$ssh_container" sh -c \
    "printf 'k04-invalid-user-password\\n' > /root/keycloak/user-password" ||
    error 'cannot stage synthetic invalid user password'
  result=$(probe acquire --server https://127.0.0.1:8443 \
    --issuer-realm master --auth-mode password --username k04admin \
    --password-file /root/keycloak/user-password \
    --client-id k04-service --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --token-store "/root/keycloak/user-rejected-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] ||
    fail "Keycloak $version invalid user password not rejected ($status)"

  # Refresh the user session through the composed m/rsudo/SSH/sudo path.
  # Credentials and token bytes stay in protected files on the SSH target.
  result=$(probe refresh --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --token-file "/root/keycloak/user-$version" \
    --token-store "/root/keycloak/user-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"stored":true,"refreshed":true,"server_validated":false}' ] ||
    fail "Keycloak $version composed SSH refresh failed ($status)"
  docker exec "$ssh_container" sh -c \
    "test \"\$(stat -c %a /root/keycloak/user-$version)\" = 600 &&
     jq -e '.refresh_token | type == \"string\" and length > 0' /root/keycloak/user-$version >/dev/null &&
     test ! -e /root/keycloak/user-$version.keycloak-refresh-lock" ||
    fail "Keycloak $version composed refresh store/lock unsafe"
  for marker in k04-disposable-client-secret k04-only-ssh-password '"access_token"'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version composed refresh leaked confidential data"
  done

  # The new K04 revocation operation must cross the same real SSH/sudo
  # boundary; the protected refresh token is read only on the remote host.
  result=$(probe revoke --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-service \
    --client-auth client-secret-post \
    --client-secret-file /root/keycloak/secret \
    --token-file "/root/keycloak/user-$version" \
    --token-type-hint refresh_token \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"refresh_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version composed refresh revocation failed ($status)"

  docker exec "$ssh_container" jq -jr '.refresh_token' \
    "/root/keycloak/user-$version" > "$tmp/revoked-refresh" ||
    error "Keycloak $version remote refresh-token fixture read failed"
  [ -s "$tmp/revoked-refresh" ] ||
    fail "Keycloak $version Direct Grant did not return refresh_token"
  basic_auth=$(printf 'k04-service:k04-disposable-client-secret' | base64 | tr -d '\r\n') ||
    error 'cannot construct synthetic client authentication for refresh check'
  printf 'Authorization: Basic %s\n' "$basic_auth" > "$tmp/revoked-refresh-header"
  unset basic_auth
  refresh_http=$(host_https --output "$tmp/revoked-refresh-response" \
    --write-out '%{http_code}' --header "@$tmp/revoked-refresh-header" \
    --data-urlencode grant_type=refresh_token \
    --data-urlencode "refresh_token@$tmp/revoked-refresh" \
    --url "$host_base/realms/master/protocol/openid-connect/token") ||
    error "Keycloak $version composed refresh-after-revoke HTTP failed"
  [ "$refresh_http" = 400 ] &&
    jq -e '.error == "invalid_grant"' "$tmp/revoked-refresh-response" >/dev/null ||
    fail "Keycloak $version revoked remote refresh token remained refreshable ($refresh_http)"

  result=$(probe refresh --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file /root/keycloak/secret \
    --token-file "/root/keycloak/user-$version" \
    --token-store "/root/keycloak/user-$version" \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 72 ] && [ -z "$result" ] ||
    fail "Keycloak $version composed revoked refresh did not fail closed ($status)"

  result=$(probe revoke --server https://127.0.0.1:8443 \
    --issuer-realm master --client-id k04-service \
    --client-auth client-secret-basic \
    --client-secret-file /root/keycloak/secret \
    --token-file "/root/keycloak/basic-$version" \
    --token-type-hint access_token \
    --ca-file /root/keycloak/ca.pem 2>"$tmp/auth.err")
  status=$?
  [ "$status" -eq 0 ] &&
    [ "$result" = '{"revocation_requested":true,"token_type_hint":"access_token","invalidity_verified":false}' ] ||
    fail "Keycloak $version composed access token revocation failed ($status)"

  for marker in k04-disposable-client-secret k04-only-bootstrap '"access_token"' '"refresh_token"'
  do
    grep -F "$marker" "$tmp/auth.err" >/dev/null &&
      fail "Keycloak $version revocation leaked protected data through SSH/sudo"
  done

  printf '%s: Keycloak %s verified across composed SSH+sudo+HTTPS boundary\n' \
    "$TEST_ID" "$version"
  stop_containers
done

printf '%s\n' "$TEST_ID: PASS (real SSH/sudo to real Keycloak, both releases)"
