#!/bin/sh
# APISIX Admin API HTTP read-only provider capability proof.
# Isolated, network-disabled official 3.16/3.19 running gateways, no host
# ports, and a fixed TEST-ONLY key in an ephemeral standalone API profile.
# Uses real m/product resolver for drift and APISIX_PROFILE source ambiguity.
TEST_ID=rumiai-os/rsudo/apisix-admin-read-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp=
cid=
cleanup()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'invalid selected product checkout' ;;
  *) error 'target resolution failed' ;;
esac

command -v docker >/dev/null 2>&1 || skip 'Docker unavailable'
images='apache/apisix@sha256:b921bdef3cfb2ca72e483d643f40e7843683ff8e188984489c2020f17654ee88
apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'

tmp=${TMPDIR:-/tmp}/rsudo-apisix-admin-read-$$
umask 077
mkdir -p -- "$tmp/bin" || error 'cannot create fixture'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture path unavailable'

write_admin_config()
{
  cat > "$tmp/config.yaml" <<'ADMIN_CONFIG'
deployment:
  role: traditional
  role_traditional:
    config_provider: yaml
  admin:
    admin_key_required: true
    admin_key:
      - name: test-viewer
        key: rsudo-test-only-never-production
        role: viewer
      - name: test-admin
        key: rsudo-admin-test-only-never-production
        role: admin
    admin_listen:
      ip: 127.0.0.1
      port: 9180
ADMIN_CONFIG
  chmod 644 "$tmp/config.yaml" || error 'cannot set fixture permissions'
}

cat > "$tmp/bin/rsudo-apisix-admin-mode-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  docker exec -i "$APISIX_TEST_CONTAINER" "$@"
}
case "${APISIX_TEST_OPERATION:-mode}" in
  mode) rsudo_mod_apisix_mode "$@" ;;
  runtime) rsudo_mod_apisix_runtime "$@" ;;
  *) exit 83 ;;
esac
PROBE
chmod 700 "$tmp/bin/rsudo-apisix-admin-mode-probe" ||
  error 'cannot make product probe executable'

mode_on_disk()
{
  APISIX_TEST_CONTAINER="$cid" PATH="$tmp/bin:$PATH" \
    "$root/m" rsudo-apisix-admin-mode-probe "$@"
}

# Bash is installed by the official image entrypoint. This local HTTP
# client runs in the gateway's network namespace. No port leaves Docker.
# The TEST-ONLY credential is delivered via stdin, not an argv argument.
http_read()
{
  docker exec -i "$cid" /bin/bash -s -- "$1" "$2" "${3:-GET}" <<'BASH_HTTP'
path=$1
credential_case=$2
method=$3
case "$method" in GET|HEAD) : ;; *) exit 74 ;; esac
exec 3<>/dev/tcp/127.0.0.1/9180 || exit 70
printf '%s %s HTTP/1.1\r\nHost: localhost\r\nAccept: application/json\r\nConnection: close\r\n' "$method" "$path" >&3
case "$credential_case" in
  correct) printf 'X-API-KEY: rsudo-test-only-never-production\r\n' >&3 ;;
  admin) printf 'X-API-KEY: rsudo-admin-test-only-never-production\r\n' >&3 ;;
  incorrect) printf 'X-API-KEY: wrong-test-only-credential\r\n' >&3 ;;
  absent) : ;;
  *) exit 71 ;;
esac
printf '\r\n' >&3
cat <&3
BASH_HTTP
}

http_status()
{
  response=$(http_read "$1" "$2" "${3:-GET}" 2>"$tmp/http-stderr")
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  case "$response" in
    HTTP/1.*) : ;;
    *) return 72 ;;
  esac
  first=${response%%'
'*}
  case "$first" in
    HTTP/1.*)
      set -- $first
      printf '%s\n' "$2"
    ;;
    *) return 73 ;;
  esac
}

# Both scenarios must prove the same live Admin API read path before
# inspecting source-selection evidence; keep startup observation shared.
wait_for_admin()
{
  label=$1
  tries=0
  while [ "$tries" -lt 30 ]
  do
    code=$(http_status /apisix/admin/configs correct)
    status=$?
    if [ "$status" -eq 0 ] && [ "$code" = 200 ]
    then
      return 0
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" != true ]
    then
      docker logs "$cid" >&2 || :
      fail "$label gateway exited before Admin API became ready"
    fi
    tries=$((tries + 1))
    sleep 1
  done
  docker logs "$cid" >&2 || :
  fail "$label GET /configs did not become ready"
}

for image in $images
do
  docker image inspect "$image" >/dev/null 2>&1 ||
    skip "pinned APISIX image not provisioned: $image"
  write_admin_config
  # Preserve the original API-driven source as a named profile. In the
  # second scenario, the default source will deliberately disagree.
  cp "$tmp/config.yaml" "$tmp/config-prod.yaml" ||
    error 'cannot prepare independent named profile'
  # The gateway worker may run as a different UID than the test runner.
  # Only disposable test credentials are present in this fixture.
  chmod 644 "$tmp/config-prod.yaml" ||
    error 'cannot make named profile readable to APISIX'

  cid=$(docker run -d --network none --cap-drop ALL \
    --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    -e APISIX_STAND_ALONE=true "$image") ||
    error 'cannot launch standalone API-driven APISIX'
  [ -n "$cid" ] || error 'Docker returned no container ID'

  wait_for_admin 'default standalone API'

  observed=$(mode_on_disk /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-api ] ||
    fail 'on-disk traditional/yaml was not classified standalone-api'

  # A standalone API-driven router exposes full-document /configs only,
  # not traditional Admin API's per-resource read endpoints.
  for resource in routes services upstreams
  do
    code=$(http_status "/apisix/admin/$resource" correct) ||
      fail "resource $resource check could not complete"
    [ "$code" = 404 ] ||
      fail "standalone API exposed $resource resource read: HTTP $code"
  done

  # APISIX viewer role grants GET but explicitly denies HEAD.
  code=$(http_status /apisix/admin/configs correct HEAD) ||
    fail 'viewer HEAD /configs request failed'
  [ "$code" = 401 ] ||
    fail "viewer unexpectedly authorized for HEAD /configs: HTTP $code"

  code=$(http_status /apisix/admin/configs admin HEAD) ||
    fail 'admin HEAD /configs request failed'
  [ "$code" = 200 ] ||
    fail "admin HEAD /configs returned HTTP $code"

  response=$(http_read /apisix/admin/configs correct) ||
    fail 'standalone GET /configs payload request failed'
  case "$response" in
    *'"routes_conf_version"'*) : ;;
    *) fail 'standalone config payload lacks routes_conf_version' ;;
  esac
  case "$response" in
    *'"services_conf_version"'*) : ;;
    *) fail 'standalone config payload lacks services_conf_version' ;;
  esac

  code=$(http_status /apisix/admin/configs incorrect) ||
    fail 'incorrect-key request could not complete'
  case "$code" in
    401|403) : ;;
    *) fail "wrong test API key was not rejected (HTTP $code)" ;;
  esac

  # Change the synthetic disk config after init WITHOUT reloading APISIX.
  # This demonstrates a real provider mismatch that neither on-disk mode
  # nor a consistent PID/master can treat as verified active provenance.
  cat > "$tmp/config.yaml" <<'DRIFTED_CONFIG'
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
DRIFTED_CONFIG
  observed=$(mode_on_disk /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-file-yaml ] ||
    fail 'changed disk config was not recognized as file-driven'

  code=$(http_status /apisix/admin/configs correct) ||
    fail 'active provider check failed after disk-only edit'
  [ "$code" = 200 ] ||
    fail 'active standalone API disappeared when only disk source changed'

  docker rm -f "$cid" >/dev/null 2>&1 ||
    error 'cannot remove isolated APISIX'
  cid=

  # Start a fresh gateway using the named APISIX_PROFILE source. The
  # default config.yaml is deliberately file-driven from the previous
  # drift scenario, while config-prod.yaml is standalone API-driven.
  # No production file or running gateway is changed.
  cid=$(docker run -d --network none --cap-drop ALL \
    --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    --mount "type=bind,src=$tmp/config-prod.yaml,dst=/usr/local/apisix/conf/config-prod.yaml,readonly" \
    -e APISIX_PROFILE=prod -e APISIX_STAND_ALONE=true "$image") ||
    error 'cannot launch isolated named-profile APISIX'
  [ -n "$cid" ] || error 'Docker returned no named-profile container ID'

  wait_for_admin 'named-profile'

  # Read only Docker's manager metadata for this exact selected container.
  # A declared profile and a bind mount are startup-selection evidence,
  # never a guarantee that the current file matches the loaded snapshot.
  manager_profile=$(docker inspect --format \
    '{{range .Config.Env}}{{if eq . "APISIX_PROFILE=prod"}}selected{{end}}{{end}}' "$cid") ||
    error 'cannot inspect selected gateway profile'
  [ "$manager_profile" = selected ] ||
    fail 'manager did not retain named APISIX_PROFILE selector'
  manager_mount=$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/usr/local/apisix/conf/config-prod.yaml"}}{{.Type}}:{{.RW}}{{end}}{{end}}' "$cid") ||
    error 'cannot inspect selected profile configuration mount'
  [ "$manager_mount" = 'bind:false' ] ||
    fail 'manager did not retain read-only named profile bind mount'
  unset manager_profile manager_mount

  # A missing explicit selector must fail, even when the profile happens
  # to be present in the current container environment: a different
  # sudo/service invocation might select a different environment.
  observed=$(mode_on_disk /usr/local/apisix 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 10 ] && [ -z "$observed" ] ||
    fail 'named profile was silently chosen from an ambiguous installation'

  observed=$(mode_on_disk /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-file-yaml ] ||
    fail 'default on-disk source was not classified independently'

  observed=$(mode_on_disk /usr/local/apisix /usr/local/apisix/conf/config-prod.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-api ] ||
    fail 'explicit named profile was not classified independently'

  # Even a real matched master does not establish which source file it
  # loaded. The live Admin API response is additional but separate
  # evidence and does not authorize mutation.
  observed=$(APISIX_TEST_OPERATION=runtime mode_on_disk /usr/local/apisix 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] || fail 'named-profile master process is unobservable'
  case "$observed" in
    *'runtime_identity=process-consistent-config-unverified'*'mutation_readiness=not-established') : ;;
    *) fail 'named-profile master was mistaken for verified source identity' ;;
  esac

  docker rm -f "$cid" >/dev/null 2>&1 ||
    error 'cannot remove named-profile APISIX'
  cid=

  # The APISIX CLI's -c selector is different from APISIX_PROFILE:
  # startup may consume a custom YAML outside conf/ while OpenResty's master
  # still exposes only the generated nginx.conf in its process title.
  # Use a real CLI launch, not the stock Docker entrypoint. The container
  # remains isolated and the only Admin key is disposable test material.
  cid=$(docker run -d --network none --cap-drop ALL \
    --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    --mount "type=bind,src=$tmp/config-prod.yaml,dst=/mnt/rsudo-apisix-custom.yaml,readonly" \
    -e APISIX_STAND_ALONE=true --entrypoint /bin/sh "$image" -c '
      cd /usr/local/apisix || exit 70
      /usr/local/openresty/luajit/bin/luajit \
        /usr/local/apisix/apisix/cli/apisix.lua start \
        -c /mnt/rsudo-apisix-custom.yaml || exit 71
      while :; do sleep 60; done
    ') || error 'cannot launch isolated APISIX custom -c CLI'
  [ -n "$cid" ] || error 'Docker returned no custom -c container ID'

  wait_for_admin 'custom -c'

  # The CLI uses a source different from OpenResty's generated nginx.conf.
  # Confirm Docker retained the actual launch command and the explicit
  # custom-source mount, then compare against the separately observed API.
  manager_entrypoint=$(docker inspect --format '{{.Path}}' "$cid") ||
    error 'cannot inspect custom CLI entrypoint'
  [ "$manager_entrypoint" = /bin/sh ] ||
    fail 'custom -c gateway did not use the expected entrypoint'
  manager_script=$(docker inspect --format '{{index .Args 1}}' "$cid") ||
    error 'cannot inspect custom CLI start argument'
  case "$manager_script" in
    *'/mnt/rsudo-apisix-custom.yaml'*) : ;;
    *) fail 'Docker launch command does not retain the -c source path' ;;
  esac
  manager_mount=$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/mnt/rsudo-apisix-custom.yaml"}}{{.Type}}:{{.RW}}{{end}}{{end}}' "$cid") ||
    error 'cannot inspect custom CLI configuration mount'
  [ "$manager_mount" = 'bind:false' ] ||
    fail 'custom -c source mount was not read-only'
  unset manager_entrypoint manager_script manager_mount

  observed=$(mode_on_disk /usr/local/apisix /usr/local/apisix/conf/config.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-file-yaml ] ||
    fail 'custom -c default source was not independently classified'

  observed=$(mode_on_disk /usr/local/apisix /mnt/rsudo-apisix-custom.yaml 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-api ] ||
    fail 'custom -c source was not independently classified'

  observed=$(APISIX_TEST_OPERATION=runtime mode_on_disk /usr/local/apisix 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] || fail 'custom -c master process is unobservable'
  case "$observed" in
    *'runtime_identity=process-consistent-config-unverified'*'mutation_readiness=not-established') : ;;
    *) fail 'custom -c source was inferred solely from process arguments' ;;
  esac

  # Source-drift counterexample at the exact explicit -c file, not merely
  # at the independent default config. The mounted file changes in place;
  # the running worker does not receive an APISIX reload or restart.
  # Neither a matching master nor a successful Admin read attests that
  # this newly visible YAML is the loaded startup configuration.
  pid=$(docker exec "$cid" cat /usr/local/apisix/logs/nginx.pid) ||
    error 'cannot read master PID before custom-source drift'
  printf '%s\n' "$observed" | grep -Fx "process_pid=$pid" >/dev/null ||
    fail 'observed master PID does not match custom-source drift fixture'
  cat > "$tmp/config-prod.yaml" <<'DRIFTED_CUSTOM_SOURCE'
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
DRIFTED_CUSTOM_SOURCE
  docker exec "$cid" cat /mnt/rsudo-apisix-custom.yaml \
    > "$tmp/mounted-custom-read" ||
    error 'cannot observe edited custom source inside gateway namespace'
  cmp -s "$tmp/config-prod.yaml" "$tmp/mounted-custom-read" ||
    fail 'edited custom source is not visible inside gateway namespace'
  observed_disk=$(mode_on_disk /usr/local/apisix /mnt/rsudo-apisix-custom.yaml \
    2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed_disk" = standalone-file-yaml ] ||
    fail 'edited -c file did not classify as standalone-file-yaml on disk'
  observed_after=$(APISIX_TEST_OPERATION=runtime mode_on_disk /usr/local/apisix \
    2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] ||
    fail 'master observation failed after custom-source-only drift'
  printf '%s\n' "$observed_after" | grep -Fx "process_pid=$pid" >/dev/null ||
    fail 'source-only drift changed the observed APISIX master'
  case "$observed_after" in
    *'runtime_identity=process-consistent-config-unverified'*'mutation_readiness=not-established') : ;;
    *) fail 'drifted source was misreported as effective configuration' ;;
  esac

  code=$(http_status /apisix/admin/configs correct) ||
    fail 'Admin HTTP GET unavailable after selected -c file-only drift'
  [ "$code" = 200 ] ||
    fail "Admin HTTP GET changed after selected -c disk-only drift (HTTP $code)"
  code=$(http_status /apisix/admin/configs incorrect) ||
    fail 'wrong-key Admin read unavailable after selected -c file drift'
  case "$code" in
    401|403) : ;;
    *) fail "wrong key unexpectedly accepted after -c file drift (HTTP $code)" ;;
  esac
  printf '%s\n' "$TEST_ID: -c disk drift: on-disk=standalone-file-yaml running-admin=200 master-stable=yes"

  # Bind the observed HTTP listener causally to the disposable Nginx master:
  # terminate that exact PID and require subsequent *new* HTTP connections
  # to stop returning successful Admin API responses. This proves a local
  # live association only, not generic host or controller ownership.
  pid=$(docker exec "$cid" cat /usr/local/apisix/logs/nginx.pid) ||
    error 'cannot read custom -c master PID'
  printf '%s\n' "$observed" | grep -Fx "process_pid=$pid" >/dev/null ||
    fail 'runtime observation PID differs from custom -c master PID'
  docker exec "$cid" sh -c 'kill -TERM "$1"' sh "$pid" ||
    error 'cannot terminate disposable custom -c master'
  tries=0
  while [ "$tries" -lt 15 ]
  do
    # A removed listener causes the /dev/tcp connect to fail with status 70;
    # do not accept arbitrary HTTP 4xx/5xx or test-driver failures as proof.
    code=$(http_status /apisix/admin/configs correct)
    status=$?
    if [ "$status" -eq 70 ]
    then
      [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] ||
        error 'container stopped before listener observation completed'
      break
    fi
    [ "$status" -eq 0 ] ||
      error "post-termination HTTP fixture returned unexpected status $status"
    tries=$((tries + 1))
    sleep 1
  done
  [ "$tries" -lt 15 ] ||
    fail 'Admin listener accepted connections after its observed master terminated'

  docker rm -f "$cid" >/dev/null 2>&1 ||
    error 'cannot remove custom -c APISIX'
  cid=
done

printf '%s\n' "$TEST_ID: PASS (two live releases, profile/-c drift and isolated listener causality)"
