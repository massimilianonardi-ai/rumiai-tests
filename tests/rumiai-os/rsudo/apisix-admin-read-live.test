#!/bin/sh
# APISIX Admin API HTTP read-only provider capability proof.
# Isolated, network-disabled official 3.16/3.19 running gateways, no host
# ports, and a fixed TEST-ONLY key in an ephemeral standalone API profile.
# Uses real m/product mode resolver for the disk-versus-live drift assertion.
TEST_ID=rumiai-os/rsudo/apisix-admin-read-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

tmp=
cid=
cleanup()
{
  [ -z "$cid" ] || docker rm -f "$cid" >/dev/null 2>&1 || :
  [ -z "$tmp" ] || rm -rf -- "$tmp"
}
trap cleanup 0

dir=$(resolve_test_dir) || error 'test path unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'invalid selected product checkout' ;;
  *) error 'target resolution failed' ;;
esac

command -v docker >/dev/null 2>&1 || skip 'Docker unavailable'
images='apache/apisix@sha256:b921bdef3cfb2ca72e483d643f40e7843683ff8e188984489c2020f17654ee88
apache/apisix@sha256:9a7e45dc943fbf10ec916d1232bae4cda9302ae28a4696cfb83c2da01d261141'

tmp=${TMPDIR:-/tmp}/rsudo-apisix-admin-read-$$
umask 077
mkdir -p -- "$tmp/bin" || error 'cannot create fixture'
tmp=$(CDPATH= cd -- "$tmp" && pwd -P) || error 'fixture path unavailable'

write_admin_config()
{
  cat > "$tmp/config.yaml" <<'ADMIN_CONFIG'
deployment:
  role: traditional
  role_traditional:
    config_provider: yaml
  admin:
    admin_key_required: true
    admin_key:
      - name: test-viewer
        key: rsudo-test-only-never-production
        role: viewer
    admin_listen:
      ip: 127.0.0.1
      port: 9180
ADMIN_CONFIG
  chmod 644 -- "$tmp/config.yaml" || error 'cannot set fixture permissions'
}

cat > "$tmp/bin/rsudo-apisix-admin-mode-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  docker exec -i "$APISIX_TEST_CONTAINER" "$@"
}
rsudo_mod_apisix_mode /usr/local/apisix /usr/local/apisix/conf/config.yaml
PROBE
chmod 700 -- "$tmp/bin/rsudo-apisix-admin-mode-probe" ||
  error 'cannot make product probe executable'

mode_on_disk()
{
  APISIX_TEST_CONTAINER="$cid" PATH="$tmp/bin:$PATH" \
    "$root/m" rsudo-apisix-admin-mode-probe
}

# Bash is installed by the official image entrypoint. This local HTTP
# client runs in the gateway's network namespace. No port leaves Docker.
# The TEST-ONLY credential is delivered via stdin, not an argv argument.
http_read()
{
  docker exec -i "$cid" /bin/bash -s -- "$1" "$2" "${3:-GET}" <<'BASH_HTTP'
path=$1
credential_case=$2
method=$3
case "$method" in GET|HEAD) : ;; *) exit 74 ;; esac
exec 3<>/dev/tcp/127.0.0.1/9180 || exit 70
printf '%s %s HTTP/1.1\r\nHost: localhost\r\nAccept: application/json\r\nConnection: close\r\n' "$method" "$path" >&3
case "$credential_case" in
  correct) printf 'X-API-KEY: rsudo-test-only-never-production\r\n' >&3 ;;
  incorrect) printf 'X-API-KEY: wrong-test-only-credential\r\n' >&3 ;;
  absent) : ;;
  *) exit 71 ;;
esac
printf '\r\n' >&3
cat <&3
BASH_HTTP
}

http_status()
{
  response=$(http_read "$1" "$2" "${3:-GET}" 2>"$tmp/http-stderr")
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  case "$response" in
    HTTP/1.*) : ;;
    *) return 72 ;;
  esac
  first=${response%%'
'*}
  case "$first" in
    HTTP/1.*)
      set -- $first
      printf '%s\n' "$2"
    ;;
    *) return 73 ;;
  esac
}

for image in $images
do
  docker image inspect "$image" >/dev/null 2>&1 ||
    skip "pinned APISIX image not provisioned: $image"
  write_admin_config

  cid=$(docker run -d --network none --cap-drop ALL \
    --security-opt no-new-privileges=true \
    --mount "type=bind,src=$tmp/config.yaml,dst=/usr/local/apisix/conf/config.yaml,readonly" \
    -e APISIX_STAND_ALONE=true "$image") ||
    error 'cannot launch standalone API-driven APISIX'
  [ -n "$cid" ] || error 'Docker returned no container ID'

  tries=0
  while [ "$tries" -lt 30 ]
  do
    code=$(http_status /apisix/admin/configs correct)
    status=$?
    if [ "$status" -eq 0 ] && [ "$code" = 200 ]
    then
      break
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" != true ]
    then
      docker logs "$cid" >&2 || :
      fail 'standalone API gateway exited before Admin API became ready'
    fi
    tries=$((tries + 1))
    sleep 1
  done
  [ "$tries" -lt 30 ] || {
    docker logs "$cid" >&2 || :
    fail 'standalone GET /configs did not become ready'
  }

  observed=$(mode_on_disk 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-api ] ||
    fail 'on-disk traditional/yaml was not classified standalone-api'

  # A standalone API-driven router exposes full-document /configs only,
  # not traditional Admin API's per-resource read endpoints.
  for resource in routes services upstreams
  do
    code=$(http_status "/apisix/admin/$resource" correct) ||
      fail "resource $resource check could not complete"
    [ "$code" = 404 ] ||
      fail "standalone API exposed $resource resource read: HTTP $code"
  done

  code=$(http_status /apisix/admin/configs correct HEAD) ||
    fail 'standalone HEAD /configs request failed'
  [ "$code" = 200 ] ||
    fail "standalone HEAD /configs returned HTTP $code"

  response=$(http_read /apisix/admin/configs correct) ||
    fail 'standalone GET /configs payload request failed'
  case "$response" in
    *'"routes_conf_version"'*'"services_conf_version"'*) : ;;
    *) fail 'standalone config payload lacks versioned resource envelope' ;;
  esac

  code=$(http_status /apisix/admin/configs incorrect) ||
    fail 'incorrect-key request could not complete'
  case "$code" in
    401|403) : ;;
    *) fail "wrong test API key was not rejected (HTTP $code)" ;;
  esac

  # Change the synthetic disk config after init WITHOUT reloading APISIX.
  # This demonstrates a real provider mismatch that neither on-disk mode
  # nor a consistent PID/master can treat as verified active provenance.
  cat > "$tmp/config.yaml" <<'DRIFTED_CONFIG'
deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml
DRIFTED_CONFIG
  observed=$(mode_on_disk 2>"$tmp/mode-stderr")
  status=$?
  [ "$status" -eq 0 ] && [ "$observed" = standalone-file-yaml ] ||
    fail 'changed disk config was not recognized as file-driven'

  code=$(http_status /apisix/admin/configs correct) ||
    fail 'active provider check failed after disk-only edit'
  [ "$code" = 200 ] ||
    fail 'active standalone API disappeared when only disk source changed'

  docker rm -f "$cid" >/dev/null 2>&1 ||
    error 'cannot remove isolated APISIX'
  cid=
done

printf '%s\n' "$TEST_ID: PASS (two live Admin APIs, authentication and disk/runtime drift)"
