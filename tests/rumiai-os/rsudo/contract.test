#!/bin/sh

# Protected current properties:
#   LIB-07    rsudo.lib.sh documents its complete public function surface.
#   RSUDO-01  valid connection data executes the requested remote target under sudo.
#   RSUDO-02  target stdin is preserved and does not receive authentication data.
#   RSUDO-03  target stdout/stderr remain observable to the caller.
#   RSUDO-04  resulting remote target status is propagated.
#   RSUDO-05  password-required sudo is supported.
#   RSUDO-06  passwordless sudo/root operation is supported without contaminating target stdin.
#   RSUDO-08  --user selects the requested sudo target user.
#   RSUDO-09  required password acquisition failure prevents remote execution.
#   RSUDO-11  password data is not exposed as ordinary target input/output.
#
# The SSH and sudo programs below are external-boundary fixtures. They model
# remote-system characteristics, not the internal sequence rsudo must use.
# Unsupported fixture interactions are ERROR, not product FAIL.

TEST_ID=rumiai-os/rsudo/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}

terminate()
{
    signal=$1
    trap - 0 "$signal"
    cleanup
    kill -s "$signal" "$$"
}

trap cleanup 0
trap 'terminate HUP' HUP
trap 'terminate INT' INT
trap 'terminate QUIT' QUIT
trap 'terminate TERM' TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

rsudo_library=$root/lib/sys/sh/rsudo/rsudo.lib.sh
rsudo_command=$root/bin/sys/rsudo
rsudo_manual=$root/res/sys/manual/rsudo.lib.sh

[ -f "$rsudo_library" ] && [ ! -L "$rsudo_library" ] ||
    fail 'rsudo.lib.sh is missing or is not a regular library file'
[ ! -x "$rsudo_library" ] ||
    fail 'rsudo.lib.sh is executable'

IFS= read -r first_line < "$rsudo_library" || error 'cannot read rsudo.lib.sh'
case "$first_line" in
    '#!'*) fail 'rsudo.lib.sh has a shebang' ;;
esac

command -p sh -n "$rsudo_library" ||
    fail 'rsudo.lib.sh is not valid host POSIX-sh syntax'

[ -f "$rsudo_manual" ] && [ ! -L "$rsudo_manual" ] ||
    fail 'rsudo.lib.sh operational manual is missing'

for public_function in rsudo rsudo_core
do
    grep -F "$public_function" "$rsudo_manual" >/dev/null 2>&1 ||
        fail "rsudo manual omits public function $public_function"
done

if grep -E '(^|[^[:alnum:]_])_rsudo_[[:alnum:]_][[:alnum:]_]*' "$rsudo_manual" >/dev/null 2>&1
then
    fail 'rsudo manual exposes an internal function identifier'
fi

[ -f "$rsudo_command" ] && [ -x "$rsudo_command" ] ||
    fail 'rsudo command entrypoint is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-rsudo-contract-$$
fakebin=$tmp/bin
mkdir -p "$fakebin" || error 'cannot create external-boundary fixtures'

cat > "$fakebin/ssh" <<'EOF_SSH'
#!/bin/sh

# Minimal external SSH boundary: resolve the destination and execute the remote
# command in the modeled remote environment. Authentication itself is assumed
# successful; this test is about rsudo behavior after a reachable SSH boundary.

if [ "${1-}" = -t ]
then
    shift
fi

login_user=
if [ "${1-}" = -l ]
then
    [ "$#" -ge 3 ] || exit 80
    login_user=$2
    shift 2
fi

[ "$#" -ge 2 ] || exit 81
host=$1
shift

[ "$login_user" = "$RSUDO_TEST_EXPECT_LOGIN_USER" ] || exit 82
[ "$host" = "$RSUDO_TEST_EXPECT_HOST" ] || exit 83

remote_command=$*
[ -n "$remote_command" ] || exit 84

RSUDO_TEST_REMOTE_LOGIN_USER=$login_user
export RSUDO_TEST_REMOTE_LOGIN_USER

PATH="$RSUDO_TEST_REMOTE_BIN:$PATH" sh -c "$remote_command"
EOF_SSH

cat > "$fakebin/sudo" <<'EOF_SUDO'
#!/bin/sh

# External sudo boundary with three modeled systems:
#   required     password authentication is required
#   passwordless sudo never needs a password
#   root         already privileged login
#
# It accepts several legitimate sudo authentication sequences so the product
# test does not prescribe which one rsudo must choose.

validated=$RSUDO_TEST_SUDO_VALIDATED_FILE
mode=$RSUDO_TEST_SUDO_MODE
expected_password=$RSUDO_TEST_EXPECT_PASSWORD

case $mode in
    required|passwordless|root) : ;;
    *) exit 90 ;;
esac

if [ "${1-}" = -K ]
then
    rm -f "$validated" || exit 91
    exit 0
fi

stdin_auth=0
noninteractive=0
validate_only=0
target_user=root

while [ "$#" -gt 0 ]
do
    case $1 in
        -S)
            stdin_auth=1
            shift
        ;;
        -n)
            noninteractive=1
            shift
        ;;
        -v)
            validate_only=1
            shift
        ;;
        --prompt=*|-p)
            if [ "$1" = -p ]; then [ "$#" -ge 2 ] || exit 92; shift 2; else shift; fi
        ;;
        --user|-u)
            [ "$#" -ge 2 ] || exit 93
            target_user=$2
            shift 2
        ;;
        --)
            shift
            break
        ;;
        -*)
            # Fixture cannot safely model an unknown sudo option.
            exit 94
        ;;
        *)
            break
        ;;
    esac
done

needs_auth=0
if [ "$mode" = required ] && [ "${RSUDO_TEST_REMOTE_LOGIN_USER-}" != root ]
then
    needs_auth=1
fi

authenticate()
{
    [ "$needs_auth" -eq 1 ] || return 0
    [ -f "$validated" ] && return 0

    if [ "$stdin_auth" -eq 1 ]
    then
        IFS= read -r supplied || return 70
        [ "$supplied" = "$expected_password" ] || return 71
        : > "$validated" || return 72
        unset supplied
        return 0
    fi

    [ "$noninteractive" -eq 0 ] || return 73

    # This fixture deliberately does not emulate an interactive sudo prompt.
    return 74
}

if [ "$validate_only" -eq 1 ]
then
    authenticate
    exit $?
fi

[ "$#" -gt 0 ] || exit 95

authenticate
auth_status=$?
[ "$auth_status" -eq 0 ] || exit "$auth_status"

RSUDO_TEST_EFFECTIVE_USER=$target_user
export RSUDO_TEST_EFFECTIVE_USER

exec "$@"
EOF_SUDO

cat > "$fakebin/rsudo-target" <<'EOF_TARGET'
#!/bin/sh

cat > "$RSUDO_TEST_TARGET_STDIN_FILE" || exit 60
printf '%s\n' "${RSUDO_TEST_EFFECTIVE_USER-unprivileged}" > "$RSUDO_TEST_TARGET_USER_FILE" || exit 61
printf 'TARGET-STDOUT:%s\n' "$RSUDO_TEST_CASE"
printf 'TARGET-STDERR:%s\n' "$RSUDO_TEST_CASE" >&2
exit "$RSUDO_TEST_TARGET_STATUS"
EOF_TARGET

chmod +x "$fakebin/ssh" "$fakebin/sudo" "$fakebin/rsudo-target" ||
    error 'cannot make external-boundary fixtures executable'

command -p sh -n "$fakebin/ssh" ||
    error 'ssh boundary fixture has invalid shell syntax'
command -p sh -n "$fakebin/sudo" ||
    error 'sudo boundary fixture has invalid shell syntax'
command -p sh -n "$fakebin/rsudo-target" ||
    error 'target fixture has invalid shell syntax'

run_case()
{
    case_name=$1
    sudo_mode=$2
    login_user=$3
    password_source=$4
    sudo_user=$5
    expected_user=$6

    case_dir=$tmp/$case_name
    mkdir "$case_dir" || error "cannot create case directory: $case_name"

    target_stdin=$case_dir/target.stdin
    target_user=$case_dir/target.user
    stdout_file=$case_dir/stdout
    stderr_file=$case_dir/stderr
    validated_file=$case_dir/sudo.validated
    payload="payload-$case_name"

    (
        PATH="$fakebin:$PATH"
        RSUDO_HOST=example.invalid
        RSUDO_USER=$login_user
        RSUDO_TEST_EXPECT_LOGIN_USER=$login_user
        RSUDO_TEST_EXPECT_HOST=example.invalid
        RSUDO_TEST_REMOTE_BIN=$fakebin
        RSUDO_TEST_SUDO_MODE=$sudo_mode
        RSUDO_TEST_SUDO_VALIDATED_FILE=$validated_file
        RSUDO_TEST_EXPECT_PASSWORD=secret
        RSUDO_TEST_TARGET_STDIN_FILE=$target_stdin
        RSUDO_TEST_TARGET_USER_FILE=$target_user
        RSUDO_TEST_TARGET_STATUS=37
        RSUDO_TEST_CASE=$case_name

        export             PATH RSUDO_HOST RSUDO_USER             RSUDO_TEST_EXPECT_LOGIN_USER RSUDO_TEST_EXPECT_HOST             RSUDO_TEST_REMOTE_BIN RSUDO_TEST_SUDO_MODE             RSUDO_TEST_SUDO_VALIDATED_FILE RSUDO_TEST_EXPECT_PASSWORD             RSUDO_TEST_TARGET_STDIN_FILE RSUDO_TEST_TARGET_USER_FILE             RSUDO_TEST_TARGET_STATUS RSUDO_TEST_CASE

        if [ "$password_source" = stdin ]
        then
            unset RSUDO_PASSWORD
            if [ -n "$sudo_user" ]
            then
                printf 'secret\n%s\n' "$payload" |
                    "$root/m" "$rsudo_command" --askpass --no-preserve-quotes                         --user "$sudo_user" -- rsudo-target
            else
                printf 'secret\n%s\n' "$payload" |
                    "$root/m" "$rsudo_command" --askpass --no-preserve-quotes                         -- rsudo-target
            fi
        else
            RSUDO_PASSWORD=secret
            export RSUDO_PASSWORD

            if [ -n "$sudo_user" ]
            then
                printf '%s\n' "$payload" |
                    "$root/m" "$rsudo_command" --no-preserve-quotes                         --user "$sudo_user" -- rsudo-target
            else
                printf '%s\n' "$payload" |
                    "$root/m" "$rsudo_command" --no-preserve-quotes                         -- rsudo-target
            fi
        fi
    ) > "$stdout_file" 2> "$stderr_file"

    status=$?
    case $status in
        8[0-9]|9[0-9])
            cat "$stderr_file" >&2
            error "external-boundary fixture could not model case $case_name (status $status)"
        ;;
    esac

    [ "$status" -eq 37 ] || {
        cat "$stderr_file" >&2
        fail "$case_name: remote target status was $status instead of 37"
    }

    [ -f "$target_stdin" ] ||
        fail "$case_name: remote target did not execute"
    [ "$(cat "$target_stdin")" = "$payload" ] ||
        fail "$case_name: target stdin was not preserved"

    [ -f "$target_user" ] ||
        fail "$case_name: target user observation is missing"
    [ "$(cat "$target_user")" = "$expected_user" ] ||
        fail "$case_name: target ran as $(cat "$target_user") instead of $expected_user"

    grep -F "TARGET-STDOUT:$case_name" "$stdout_file" >/dev/null 2>&1 ||
        fail "$case_name: target stdout was not propagated"
    grep -F "TARGET-STDERR:$case_name" "$stderr_file" >/dev/null 2>&1 ||
        fail "$case_name: target stderr was not propagated"

    if grep -F 'secret' "$target_stdin" "$stdout_file" "$stderr_file" >/dev/null 2>&1
    then
        fail "$case_name: authentication data became target input/output"
    fi
}

# Password-required sudo.
run_case password-required required alice env '' root

# Passwordless sudo must not leak an unused password record into target stdin.
run_case passwordless passwordless alice env '' root

# Already privileged remote login must preserve the same target behavior.
run_case root-login root root env '' root

# --user is observable target behavior, not an implementation detail.
run_case target-user required alice env daemon daemon

# --askpass consumes its password record and forwards only the remaining input.
run_case stdin-password required alice stdin '' root

# A required --askpass password record must exist before remote execution.
(
    RSUDO_HOST=example.invalid
    RSUDO_USER=alice
    unset RSUDO_PASSWORD
    export RSUDO_HOST RSUDO_USER

    : | "$root/m" "$rsudo_command" --askpass --no-preserve-quotes -- rsudo-target         >/dev/null 2>&1
)
status=$?
[ "$status" -eq 12 ] ||
    fail "missing --askpass password returned $status instead of 12"

# Invalid local invocation is rejected before any remote execution.
RSUDO_HOST=example.invalid
RSUDO_USER=alice
RSUDO_PASSWORD=secret
export RSUDO_HOST RSUDO_USER RSUDO_PASSWORD
"$root/m" "$rsudo_command" --invalid-rsudo-option >/dev/null 2>&1
status=$?
[ "$status" -eq 9 ] ||
    fail "unknown option returned $status instead of 9"

exit 0
