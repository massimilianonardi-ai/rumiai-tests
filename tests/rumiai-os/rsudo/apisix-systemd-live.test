#!/bin/sh
# Real Linux systemd unit and real nginx master process on a disposable host.
# Proves generic service-manager correlation, not APISIX source or listener.
# Real m/module; only rsudo SSH is replaced by local passwordless sudo.
TEST_ID=rumiai-os/rsudo/apisix-systemd-live.test
fail() { printf '%s\n' "$TEST_ID: FAIL: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: ERROR: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: SKIP: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

dir=$(resolve_test_dir) || error 'test directory unavailable'
suite_root=${dir%/*/*/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'product resolver unavailable'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'product checkout unavailable' ;;
  2) fail 'explicit product checkout invalid' ;;
  *) error 'product resolver failed' ;;
esac

[ "$(uname -s)" = Linux ] || skip 'systemd test requires Linux'
for tool in systemd-run systemctl nginx sudo
do
  command -v "$tool" >/dev/null 2>&1 || skip "missing prerequisite: $tool"
done
[ -d /run/systemd/system ] || skip 'system service manager not running'
sudo -n true >/dev/null 2>&1 || skip 'passwordless sudo unavailable'

tmp=
unit=
cleanup()
{
  if [ -n "$unit" ]
  then
    sudo -n systemctl stop "$unit" >/dev/null 2>&1 || :
    sudo -n systemctl reset-failed "$unit" >/dev/null 2>&1 || :
  fi
  [ -z "$tmp" ] || sudo -n rm -rf -- "$tmp" >/dev/null 2>&1 || :
}
trap cleanup 0

umask 077
tmp=$(mktemp -d "${TMPDIR:-/tmp}/rsudo-apisix-systemd-XXXXXX") ||
  error 'cannot prepare isolated systemd test directory'
mkdir -p "$tmp/bin" "$tmp/conf" "$tmp/logs" ||
  error 'cannot prepare nginx test prefix'
cat > "$tmp/conf/nginx.conf" <<'NGINX_CONFIG'
pid logs/nginx.pid;
error_log logs/error.log;
worker_processes 1;
events { worker_connections 64; }
NGINX_CONFIG
unit="rsudo-apisix-observe-$$.service"
cat > "$tmp/bin/rsudo-apisix-systemd-probe" <<'PROBE'
#!/bin/sh
[ -n "${m_ROOT:-}" ] || exit 80
. "$m_LIB_DIR/sys/sh/core.lib.sh" || exit 81
loadsyslib "rsudo/rsudo-mod-apisix" || exit 82
rsudo()
{
  sudo -n "$@"
}
rsudo_mod_apisix_runtime "$@"
PROBE
chmod 700 "$tmp/bin/rsudo-apisix-systemd-probe" ||
  error 'probe cannot be executed'

# Type=forking + PIDFile let systemd track the real nginx master process.
sudo -n systemd-run --unit="${unit%.service}" \
  --property=Type=forking \
  --property="PIDFile=$tmp/logs/nginx.pid" \
  -- /usr/sbin/nginx -p "$tmp" -c "$tmp/conf/nginx.conf" ||
  error 'cannot start isolated real systemd/nginx service'

tries=0
while [ "$tries" -lt 20 ]
do
  if sudo -n test -s "$tmp/logs/nginx.pid" &&
     [ "$(sudo -n systemctl show --property=ActiveState --value "$unit")" = active ]
  then
    break
  fi
  tries=$((tries + 1))
  sleep 1
done
[ "$tries" -lt 20 ] || {
  sudo -n systemctl status --no-pager "$unit" >&2 || :
  fail 'real systemd service did not reach active state'
}

pid=$(sudo -n cat "$tmp/logs/nginx.pid") ||
  error 'cannot read systemd-managed nginx PID'
expected=$(printf '%s\n' \
  'runtime_evidence=pidfile-and-master-args' \
  "process_pid=$pid" \
  'service_manager_evidence=systemd-mainpid-and-cgroup' \
  "service_unit=$unit" \
  'runtime_identity=process-consistent-config-unverified' \
  'mutation_readiness=not-established')
result=$(PATH="$tmp/bin:$PATH" "$root/m" rsudo-apisix-systemd-probe "$tmp" 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = "$expected" ] || {
  cat "$tmp/stderr" >&2
  sudo -n systemctl show --no-pager \
    --property=Id,MainPID,ControlGroup,ActiveState "$unit" >&2 || :
  fail 'public rsudo APISIX runtime did not match real systemd unit'
}

# The ordinary zero-operand path must discover the same service without
# requiring the operator to know the transient unit name or root prefix.
normal_expected=$(printf '%s\n' \
  'discovery_evidence=unique-process-prefix-candidate' \
  'discovered_scope=host' \
  "installation_root=$tmp" \
  "$expected")
result=$(PATH="$tmp/bin:$PATH" "$root/m" rsudo-apisix-systemd-probe 2>"$tmp/stderr")
status=$?
[ "$status" -eq 0 ] && [ "$result" = "$normal_expected" ] || {
  cat "$tmp/stderr" >&2
  fail 'zero-operand APISIX runtime did not discover systemd-managed master'
}

printf '%s\n' "$TEST_ID: PASS (real systemd-managed nginx process; APISIX source not claimed)"
