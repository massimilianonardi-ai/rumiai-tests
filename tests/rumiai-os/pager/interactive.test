#!/bin/sh

TEST_ID=rumiai-os/pager/interactive.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pager_group=${test_dir%/*}
rumiai_os_group=${pager_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

pager=$root/bin/sys/pager
[ -x "$pager" ] || fail 'pager command is unavailable'

[ "$(uname -s 2>/dev/null)" = Linux ] || skip 'interactive backend preservation test currently targets Linux less policy'
command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput cols >/dev/null 2>&1 || skip 'xterm-256color terminfo entry is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-pager-interactive-$$
umask 077
mkdir -p "$tmp/bin" || error 'cannot create temporary pager backend directory'

marker=$tmp/backend.marker
args_file=$tmp/backend.args
env_file=$tmp/backend.env
fake_less=$tmp/bin/less

cat > "$fake_less" <<'EOF_LESS'
#!/bin/sh
: > "$RUMIAI_PAGER_TEST_MARKER"
printf '%s\n' "$#" > "$RUMIAI_PAGER_TEST_ARGS"
for arg
do
    printf '%s\n' "$arg" >> "$RUMIAI_PAGER_TEST_ARGS"
done
{
    printf 'LESS=%s\n' "${LESS-}"
    printf 'LESSOPEN=%s\n' "${LESSOPEN-}"
    printf 'LESSCLOSE=%s\n' "${LESSCLOSE-}"
} > "$RUMIAI_PAGER_TEST_ENV"

if [ "$#" -eq 0 ]
then
    command -p cat
else
    command -p cat "$@"
fi
EOF_LESS
chmod +x "$fake_less" || error 'cannot make fake less executable'

printf '%s\n' 'file payload' > "$tmp/file payload" || error 'cannot create interactive file fixture'

PATH="$tmp/bin:$PATH" \
LESS='FRX' \
LESSOPEN='open-policy' \
LESSCLOSE='close-policy' \
RUMIAI_PAGER_TEST_MARKER="$marker" \
RUMIAI_PAGER_TEST_ARGS="$args_file" \
RUMIAI_PAGER_TEST_ENV="$env_file" \
TERM=xterm-256color \
python3 - "$root/m" "$pager" "$tmp/file payload" <<'PY_PAGER'
import fcntl
import os
import pty
import select
import struct
import sys
import termios
import time

m_command, pager_command, file_path = sys.argv[1:4]
env = os.environ.copy()


def run_case(args, stdin_payload):
    input_r, input_w = os.pipe()
    pid, master = pty.fork()

    if pid == 0:
        os.dup2(input_r, 0)
        os.close(input_r)
        os.close(input_w)
        fcntl.ioctl(1, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 100, 0, 0))
        os.execve(m_command, [m_command, pager_command, *args], env)

    os.close(input_r)
    if stdin_payload is not None:
        os.write(input_w, stdin_payload)
    os.close(input_w)

    output = bytearray()
    status = None
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master], [], [], 0.05)
        if ready:
            try:
                chunk = os.read(master, 65536)
            except OSError:
                chunk = b""
            if chunk:
                output.extend(chunk)

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = os.waitstatus_to_exitcode(wait_status)
            break

    if status is None:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError(("pager timed out", bytes(output)))

    try:
        os.close(master)
    except OSError:
        pass

    assert status == 0, (status, bytes(output))
    return bytes(output)


stdin_output = run_case([], b"stdin interactive payload\n")
assert b"stdin interactive payload" in stdin_output, stdin_output

file_output = run_case([file_path], None)
assert b"file payload" in file_output, file_output
PY_PAGER
status=$?
[ "$status" -eq 0 ] || fail 'interactive pager backend scenarios failed'

[ -f "$marker" ] || fail 'Linux pager did not invoke less backend'
[ "$(sed -n '1p' "$args_file")" -eq 1 ] || fail 'file-mode less backend did not receive one file operand'
grep -F "$tmp/file payload" "$args_file" >/dev/null 2>&1 ||
    fail 'pager did not pass resolved file operand to less backend'
grep -F 'LESS=FRX' "$env_file" >/dev/null 2>&1 ||
    fail 'pager did not preserve LESS'
grep -F 'LESSOPEN=open-policy' "$env_file" >/dev/null 2>&1 ||
    fail 'pager did not preserve LESSOPEN'
grep -F 'LESSCLOSE=close-policy' "$env_file" >/dev/null 2>&1 ||
    fail 'pager did not preserve LESSCLOSE'

exit 0
