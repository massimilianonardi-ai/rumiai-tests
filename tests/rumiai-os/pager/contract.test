#!/bin/sh

TEST_ID=rumiai-os/pager/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pager_group=${test_dir%/*}
rumiai_os_group=${pager_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

pager=$root/bin/sys/pager
manual=$root/res/sys/manual/pager
manual_command=$root/bin/sys/manual

[ -f "$pager" ] && [ -x "$pager" ] || fail 'pager is missing or not executable'
[ "$(sed -n '1p' "$pager")" = '#!/bin/sh' ] || fail 'pager is not standalone POSIX sh'
command -p sh -n "$pager" || fail 'pager is not valid POSIX-shell syntax'
[ -f "$manual" ] && [ ! -L "$manual" ] || fail 'pager operational manual is missing'
[ -x "$manual_command" ] || fail 'manual command is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-pager-contract-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

printf '%s\n' 'stdin payload' |
    TERM=dumb LESS= LESSOPEN= LESSCLOSE= "$pager" > "$tmp/stdin.out" ||
    fail 'pager stdin delegation failed'
printf '%s\n' 'stdin payload' > "$tmp/stdin.expected" || error 'cannot create stdin expectation'
cmp "$tmp/stdin.expected" "$tmp/stdin.out" >/dev/null 2>&1 ||
    fail 'selected pager backend changed simple stdin content'

printf '%s\n' 'file payload' > "$tmp/file payload" || error 'cannot create pager file fixture'
TERM=dumb LESS= LESSOPEN= LESSCLOSE= "$pager" "$tmp/file payload" > "$tmp/file.out" ||
    fail 'pager file delegation failed'
cmp "$tmp/file payload" "$tmp/file.out" >/dev/null 2>&1 ||
    fail 'selected pager backend changed simple file content'

manual_text=$("$root/m" "$manual_command" --no-pager pager) ||
    fail 'manual pager lookup failed'
printf '%s\n' "$manual_text" | grep -F 'pager [file ...]' >/dev/null 2>&1 ||
    fail 'manual pager does not document zero-or-more file operands'
printf '%s\n' "$manual_text" | grep -F 'passes the operands unchanged' >/dev/null 2>&1 ||
    fail 'manual pager does not document transparent file delegation'
printf '%s\n' "$manual_text" | grep -F 'does not inspect terminal state' >/dev/null 2>&1 ||
    fail 'manual pager still documents terminal-state policy'

exit 0
