#!/bin/sh

TEST_ID=rumiai-os/pager/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_status()
{
    "$@" >/dev/null 2>&1
    RUN_STATUS=$?
}

expect_status()
{
    expected=$1
    shift
    run_status "$@"
    [ "$RUN_STATUS" -eq "$expected" ] || fail "expected status $expected, got $RUN_STATUS from $*"
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pager_group=${test_dir%/*}
rumiai_os_group=${pager_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

pager=$root/bin/sys/pager
manual=$root/res/sys/manual/pager
manual_command=$root/bin/sys/manual

[ -f "$pager" ] && [ -x "$pager" ] || fail 'pager is missing or not executable'
[ "$(sed -n '1p' "$pager")" = '#!/usr/bin/env m' ] || fail 'pager has the wrong interpreter header'
command -p sh -n "$pager" || fail 'pager is not valid POSIX-shell syntax'
[ -f "$manual" ] && [ ! -L "$manual" ] || fail 'pager operational manual is missing'
[ -x "$manual_command" ] || fail 'manual command is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-pager-contract-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

printf '%s\n' 'stdin payload' |
    "$root/m" "$pager" > "$tmp/stdin.out" ||
    fail 'pager stdin pass-through failed'
printf '%s\n' 'stdin payload' > "$tmp/stdin.expected" || error 'cannot create stdin expectation'
cmp "$tmp/stdin.expected" "$tmp/stdin.out" >/dev/null 2>&1 ||
    fail 'pager stdin pass-through changed content'

printf '%s\n' 'file one' > "$tmp/file one" || error 'cannot create first pager fixture'
printf '%s\n' 'file two' > "$tmp/file-two" || error 'cannot create second pager fixture'
cat "$tmp/file one" "$tmp/file-two" > "$tmp/files.expected" || error 'cannot create files expectation'
"$root/m" "$pager" "$tmp/file one" "$tmp/file-two" > "$tmp/files.out" ||
    fail 'pager multiple-file pass-through failed'
cmp "$tmp/files.expected" "$tmp/files.out" >/dev/null 2>&1 ||
    fail 'pager multiple-file pass-through changed content'

expect_status 1 "$root/m" "$pager" "$tmp/missing"
mkdir "$tmp/directory" || error 'cannot create directory fixture'
expect_status 1 "$root/m" "$pager" "$tmp/directory"

manual_text=$("$root/m" "$manual_command" --no-pager pager) ||
    fail 'manual pager lookup failed'
printf '%s\n' "$manual_text" | grep -F 'pager [file ...]' >/dev/null 2>&1 ||
    fail 'manual pager does not document zero-or-more file operands'
printf '%s\n' "$manual_text" | grep -F 'With no file operands, pager reads standard input.' >/dev/null 2>&1 ||
    fail 'manual pager does not document stdin mode'

exit 0
