#!/bin/sh

TEST_ID="rumiai-os/http-fetch/progress.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) :;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1";;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="$tests_dir"

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") :;;
  "1") skip "rumiai-os target checkout not found";;
  "2") fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_path="$root/bin/sys/http-fetch"
[ -f "$command_path" ] || fail "bin/sys/http-fetch is missing"
[ -x "$command_path" ] || fail "bin/sys/http-fetch is not executable"

tmp="${TMPDIR:-/tmp}/rumiai-http-fetch-progress-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

fakebin="$tmp/bin"
mkdir "$fakebin" || error "cannot create fake backend directory"

cat > "$fakebin/curl" <<'EOF_CURL'
#!/bin/sh
if [ "${1-}" = "--version" ]
then
  [ "${HTTP_FETCH_FORCE_WGET-0}" = "1" ] && exit 127
  printf -- '%s\n' 'curl 99.0'
  exit 0
fi

: > "$HTTP_FETCH_CURL_ARGS" || exit 90
silent=0
output=
while [ "$#" -gt 0 ]
do
  printf -- '%s\n' "$1" >> "$HTTP_FETCH_CURL_ARGS" || exit 90
  case "$1" in
    --silent)
      silent=1
      ;;
    --output)
      shift
      [ "$#" -gt 0 ] || exit 91
      printf -- '%s\n' "$1" >> "$HTTP_FETCH_CURL_ARGS" || exit 90
      output=$1
      ;;
  esac
  shift
done

if [ -n "$output" ]
then
  printf -- '%s\n' 'body-from-curl' > "$output" || exit 92
else
  printf -- '%s\n' 'body-from-curl'
fi

[ "$silent" -eq 1 ] || printf -- '%s\n' 'curl-progress' >&2
EOF_CURL
chmod "700" "$fakebin/curl" || error "cannot make fake curl executable"

cat > "$fakebin/wget" <<'EOF_WGET'
#!/bin/sh
if [ "${1-}" = "--version" ]
then
  printf -- '%s\n' 'GNU Wget 1.21.4'
  exit 0
fi

: > "$HTTP_FETCH_WGET_ARGS" || exit 90
no_verbose=0
output=
while [ "$#" -gt 0 ]
do
  printf -- '%s\n' "$1" >> "$HTTP_FETCH_WGET_ARGS" || exit 90
  case "$1" in
    --no-verbose)
      no_verbose=1
      ;;
    --output-document=*)
      output=${1#--output-document=}
      ;;
  esac
  shift
done

if [ "$output" = "-" ] || [ -z "$output" ]
then
  printf -- '%s\n' 'body-from-wget'
else
  printf -- '%s\n' 'body-from-wget' > "$output" || exit 92
fi

[ "$no_verbose" -eq 1 ] || printf -- '%s\n' 'wget-progress' >&2
EOF_WGET
chmod "700" "$fakebin/wget" || error "cannot make fake wget executable"

runtime_path="$root/bin/sys:$fakebin:/usr/bin:/bin"
export HTTP_FETCH_CURL_ARGS="$tmp/curl.args"
export HTTP_FETCH_WGET_ARGS="$tmp/wget.args"

system="$(command -p -- uname -s 2>/dev/null)" || error "cannot determine host system"

case "$system" in
  Linux)
    command -v python3 >/dev/null 2>&1 ||
      skip "python3 is unavailable for Linux PTY test support"

    python3 - "$command_path" "$runtime_path" "$tmp" <<'PY'
import errno
import os
import pty
import subprocess
import sys

command_path, runtime_path, base = sys.argv[1:4]
base_env = os.environ.copy()
base_env["PATH"] = runtime_path


def run(args, env_update=None):
    env = base_env.copy()
    if env_update:
        env.update(env_update)

    master, slave = pty.openpty()
    try:
        completed = subprocess.run(
            [command_path] + args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=slave,
            env=env,
            timeout=5,
            check=False,
        )
    finally:
        os.close(slave)

    stderr = bytearray()
    while True:
        try:
            chunk = os.read(master, 4096)
        except OSError as exc:
            if exc.errno == errno.EIO:
                break
            raise
        if not chunk:
            break
        stderr.extend(chunk)
    os.close(master)
    return completed.returncode, completed.stdout, bytes(stderr)


def arg_lines(name):
    with open(os.path.join(base, name), "r", encoding="utf-8") as handle:
        return [line.rstrip("\n") for line in handle]


curl_output = os.path.join(base, "curl-output")
status, stdout, stderr = run(["-o", curl_output, "--", "https://example.test/file"])
assert status == 0, (status, stdout, stderr)
assert stdout == b"", (status, stdout, stderr)
assert b"curl-progress" in stderr, stderr
with open(curl_output, "rb") as handle:
    assert handle.read() == b"body-from-curl\n"
args = arg_lines("curl.args")
assert "--silent" not in args, args
assert "--show-error" in args, args

status, stdout, stderr = run(["--", "https://example.test/body"])
assert status == 0, (status, stdout, stderr)
assert stdout == b"body-from-curl\n", (status, stdout, stderr)
assert b"curl-progress" not in stderr, stderr
args = arg_lines("curl.args")
assert "--silent" in args, args

wget_output = os.path.join(base, "wget-output")
status, stdout, stderr = run(
    ["-o", wget_output, "--", "https://example.test/file"],
    {"HTTP_FETCH_FORCE_WGET": "1"},
)
assert status == 0, (status, stdout, stderr)
assert stdout == b"", (status, stdout, stderr)
assert b"wget-progress" in stderr, stderr
with open(wget_output, "rb") as handle:
    assert handle.read() == b"body-from-wget\n"
args = arg_lines("wget.args")
assert "--no-verbose" not in args, args

status, stdout, stderr = run(
    ["--", "https://example.test/body"],
    {"HTTP_FETCH_FORCE_WGET": "1"},
)
assert status == 0, (status, stdout, stderr)
assert stdout == b"body-from-wget\n", (status, stdout, stderr)
assert b"wget-progress" not in stderr, stderr
args = arg_lines("wget.args")
assert "--no-verbose" in args, args
PY
    status="$?"
    [ "$status" -eq 0 ] || fail "Linux PTY progress behavior validation failed"
    ;;

  Darwin)
    command -v expect >/dev/null 2>&1 ||
      skip "expect is unavailable for Darwin PTY test support"

    PATH="$runtime_path"
    export PATH

    runner="$tmp/progress-runner"
    cat > "$runner" <<'EOF_RUNNER'
#!/bin/sh
case "${HTTP_FETCH_TEST_CASE-}" in
  curl-output)
    exec "$HTTP_FETCH_TEST_COMMAND" -o "$HTTP_FETCH_TEST_OUTPUT" -- "https://example.test/file" > "$HTTP_FETCH_TEST_STDOUT"
    ;;
  curl-body)
    exec "$HTTP_FETCH_TEST_COMMAND" -- "https://example.test/body" > "$HTTP_FETCH_TEST_STDOUT"
    ;;
  wget-output)
    HTTP_FETCH_FORCE_WGET=1
    export HTTP_FETCH_FORCE_WGET
    exec "$HTTP_FETCH_TEST_COMMAND" -o "$HTTP_FETCH_TEST_OUTPUT" -- "https://example.test/file" > "$HTTP_FETCH_TEST_STDOUT"
    ;;
  wget-body)
    HTTP_FETCH_FORCE_WGET=1
    export HTTP_FETCH_FORCE_WGET
    exec "$HTTP_FETCH_TEST_COMMAND" -- "https://example.test/body" > "$HTTP_FETCH_TEST_STDOUT"
    ;;
  *)
    exit 93
    ;;
esac
EOF_RUNNER
    chmod "700" "$runner" || error "cannot create Darwin progress runner"

    expect_driver="$tmp/progress.expect"
    cat > "$expect_driver" <<'EOF_EXPECT'
set timeout 10
log_user 0
log_file -a -noappend $env(HTTP_FETCH_TEST_TRANSCRIPT)

spawn -noecho $env(HTTP_FETCH_TEST_RUNNER)
expect {
    eof {}
    timeout {
        puts stderr "timeout waiting for http-fetch"
        exit 124
    }
}

set result [wait]
log_file
set os_error [lindex $result 2]
set status [lindex $result 3]

if {$os_error != 0} {
    puts stderr "http-fetch wait error: $result"
    exit 125
}

exit $status
EOF_EXPECT

    run_darwin_case()
    {
      HTTP_FETCH_TEST_CASE="$1"
      HTTP_FETCH_TEST_OUTPUT="$2"
      HTTP_FETCH_TEST_STDOUT="$3"
      HTTP_FETCH_TEST_TRANSCRIPT="$4"
      HTTP_FETCH_TEST_COMMAND="$command_path"
      HTTP_FETCH_TEST_RUNNER="$runner"
      export HTTP_FETCH_TEST_CASE HTTP_FETCH_TEST_OUTPUT HTTP_FETCH_TEST_STDOUT         HTTP_FETCH_TEST_TRANSCRIPT HTTP_FETCH_TEST_COMMAND HTTP_FETCH_TEST_RUNNER

      : > "$HTTP_FETCH_TEST_STDOUT" || return 1
      : > "$HTTP_FETCH_TEST_TRANSCRIPT" || return 1
      expect -f "$expect_driver"
    }

    curl_output="$tmp/curl-output"
    curl_stdout="$tmp/curl.stdout"
    curl_transcript="$tmp/curl.transcript"
    run_darwin_case curl-output "$curl_output" "$curl_stdout" "$curl_transcript" || {
      cat "$curl_transcript" >&2 2>/dev/null || :
      fail "Darwin curl -o progress case failed"
    }
    [ ! -s "$curl_stdout" ] || fail "Darwin curl -o produced unexpected stdout"
    grep -F -- "curl-progress" "$curl_transcript" >/dev/null 2>&1 ||
      fail "Darwin curl -o did not expose backend progress on terminal stderr"
    [ "$(cat "$curl_output")" = "body-from-curl" ] ||
      fail "Darwin curl -o produced unexpected body"
    if grep -F -x -- "--silent" "$HTTP_FETCH_CURL_ARGS" >/dev/null 2>&1
    then
      fail "Darwin curl -o unexpectedly enabled --silent"
    fi
    grep -F -x -- "--show-error" "$HTTP_FETCH_CURL_ARGS" >/dev/null 2>&1 ||
      fail "Darwin curl -o omitted --show-error"

    curl_body_stdout="$tmp/curl-body.stdout"
    curl_body_transcript="$tmp/curl-body.transcript"
    run_darwin_case curl-body "" "$curl_body_stdout" "$curl_body_transcript" || {
      cat "$curl_body_transcript" >&2 2>/dev/null || :
      fail "Darwin curl body case failed"
    }
    [ "$(cat "$curl_body_stdout")" = "body-from-curl" ] ||
      fail "Darwin curl body case produced unexpected body"
    if grep -F -- "curl-progress" "$curl_body_transcript" >/dev/null 2>&1
    then
      fail "Darwin curl body case exposed progress"
    fi
    grep -F -x -- "--silent" "$HTTP_FETCH_CURL_ARGS" >/dev/null 2>&1 ||
      fail "Darwin curl body case omitted --silent"

    wget_output="$tmp/wget-output"
    wget_stdout="$tmp/wget.stdout"
    wget_transcript="$tmp/wget.transcript"
    run_darwin_case wget-output "$wget_output" "$wget_stdout" "$wget_transcript" || {
      cat "$wget_transcript" >&2 2>/dev/null || :
      fail "Darwin wget -o progress case failed"
    }
    [ ! -s "$wget_stdout" ] || fail "Darwin wget -o produced unexpected stdout"
    grep -F -- "wget-progress" "$wget_transcript" >/dev/null 2>&1 ||
      fail "Darwin wget -o did not expose backend progress on terminal stderr"
    [ "$(cat "$wget_output")" = "body-from-wget" ] ||
      fail "Darwin wget -o produced unexpected body"
    if grep -F -x -- "--no-verbose" "$HTTP_FETCH_WGET_ARGS" >/dev/null 2>&1
    then
      fail "Darwin wget -o unexpectedly enabled --no-verbose"
    fi

    wget_body_stdout="$tmp/wget-body.stdout"
    wget_body_transcript="$tmp/wget-body.transcript"
    run_darwin_case wget-body "" "$wget_body_stdout" "$wget_body_transcript" || {
      cat "$wget_body_transcript" >&2 2>/dev/null || :
      fail "Darwin wget body case failed"
    }
    [ "$(cat "$wget_body_stdout")" = "body-from-wget" ] ||
      fail "Darwin wget body case produced unexpected body"
    if grep -F -- "wget-progress" "$wget_body_transcript" >/dev/null 2>&1
    then
      fail "Darwin wget body case exposed progress"
    fi
    grep -F -x -- "--no-verbose" "$HTTP_FETCH_WGET_ARGS" >/dev/null 2>&1 ||
      fail "Darwin wget body case omitted --no-verbose"
    ;;

  *)
    skip "no PTY progress driver is defined for $system"
    ;;
esac

exit "0"
