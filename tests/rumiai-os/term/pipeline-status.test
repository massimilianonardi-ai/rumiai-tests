#!/bin/sh

# Protected current property:
#   term_read_byte reports failure when a required producer in its byte-read
#   pipeline fails, even if it emitted parseable output before failing.

TEST_ID=rumiai-os/term/pipeline-status.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

term_library=$root/lib/sys/sh/term.lib.sh
[ -f "$term_library" ] && [ ! -L "$term_library" ] ||
    fail 'term.lib.sh is missing or is not a regular library file'

tmp=${TMPDIR:-/tmp}/rumiai-term-pipeline-status-$$
fakebin=$tmp/bin
umask 077
mkdir -p "$fakebin" || error 'cannot create test workspace'
: > "$tmp/tty" || error 'cannot create tty input fixture'

cat > "$fakebin/dd" <<'EOF_DD'
#!/bin/sh

printf 'A' || exit 90
[ "${TERM_TEST_DD_FAIL-}" = 1 ] && exit 7
exit 0
EOF_DD
chmod 700 "$fakebin/dd" || error 'cannot make dd boundary fixture executable'
command -p sh -n "$fakebin/dd" ||
    error 'dd boundary fixture has invalid shell syntax'

driver=$tmp/term-pipeline-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m

loadsyslib "term" || exit 3
term_tty_saved=true
term_tty_device=$1

term_read_byte || exit "$?"
printf '%s %s\n' "$term_byte_dec" "$term_byte_hex"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare term pipeline driver'

PATH="$fakebin:$PATH"
export PATH

TERM_TEST_DD_FAIL=0
export TERM_TEST_DD_FAIL
result=$("$root/m" "$driver" "$tmp/tty") ||
    fail 'term_read_byte failed when the byte producer succeeded'
[ "$result" = '65 41' ] ||
    fail "term_read_byte returned unexpected byte result: $result"

TERM_TEST_DD_FAIL=1
export TERM_TEST_DD_FAIL
if "$root/m" "$driver" "$tmp/tty" > "$tmp/fail.out" 2> "$tmp/fail.err"
then
    fail 'term_read_byte succeeded after its byte producer failed'
fi

exit 0
