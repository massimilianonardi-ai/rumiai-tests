#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-chrome/versions.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; tests_dir=${group_dir%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot load target discovery helper"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-chrome.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Chrome repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Chrome repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-chrome-versions-$$"
umask 077
mkdir -p "$tmp/repository" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
printf -- '%s\n' chrome > "$tmp/repository/type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
cat <<'EOF_PACKAGES'
Package: unrelated
Version: 999.0.0.0-1
Architecture: amd64
Filename: unrelated.deb
Size: 1
SHA256: FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF

Package: google-chrome-stable
Version: 153.0.8010.36-2
Architecture: amd64
Filename: pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-2_amd64.deb
Size: 400
SHA256: DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD

Package: google-chrome-stable
Version: 99.0.1.1-1
Architecture: amd64
Filename: pool/main/g/google-chrome-stable/google-chrome-stable_99.0.1.1-1_amd64.deb
Size: 100
SHA256: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

Package: google-chrome-stable
Version: 100.0.1.1-1
Architecture: amd64
Filename: pool/main/g/google-chrome-stable/google-chrome-stable_100.0.1.1-1_amd64.deb
Size: 200
SHA256: BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

Package: google-chrome-stable
Version: 153.0.8010.36-1
Architecture: amd64
Filename: pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb
Size: 300
SHA256: CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
EOF_PACKAGES
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"
PATH="$tmp/bin:/usr/bin:/bin"; export PATH
log() { printf -- '%s\n' "$*" >&2; }
. "$library" || error "cannot source Chrome repository adapter"

versions="$(pkg_repository_list_versions "$tmp/repository")" || fail "Chrome version enumeration failed"
expected='99.0.1.1-1
100.0.1.1-1
153.0.8010.36-1
153.0.8010.36-2'
[ "$versions" = "$expected" ] || fail "Chrome versions are not ordered by numeric product version"

latest="$(pkg_repository_resolve_version "$tmp/repository")" || fail "Chrome latest resolution failed"
[ "$latest" = 153.0.8010.36-2 ] || fail "latest Chrome version is $latest, expected 153.0.8010.36-2"
exact="$(pkg_repository_resolve_version "$tmp/repository" 100.0.1.1-1)" || fail "Chrome exact resolution failed"
[ "$exact" = 100.0.1.1-1 ] || fail "exact Chrome version changed unexpectedly"

[ "$(pkg_repository_compare_versions "$tmp/repository" 99.0.1.1-1 100.0.1.1-1)" = -1 ] || fail "numeric major comparison failed"
[ "$(pkg_repository_compare_versions "$tmp/repository" 153.0.8010.36-1 153.0.8010.36-2)" = -1 ] || fail "Debian revision comparison failed"
[ "$(pkg_repository_compare_versions "$tmp/repository" 153.0.8010.36-2 153.0.8010.36-2)" = 0 ] || fail "equality comparison failed"
[ "$(pkg_repository_compare_versions "$tmp/repository" 153.0.8010.36-2 100.0.1.1-1)" = 1 ] || fail "descending comparison failed"

if diagnostic="$(pkg_repository_resolve_version "$tmp/repository" 152.0.0.0-1 2>&1)"
then
  fail "vendor-removed Chrome version was accepted"
fi
case "$diagnostic" in
  *'repository chrome reason upstream-version-unavailable version 152.0.0.0-1'*) :;;
  *) fail "vendor-removed Chrome version did not produce clear runtime diagnostics";;
esac

[ "$(pkg_repository_compare_versions "$tmp/repository" 99.0.1.1-1 152.0.0.0-1)" = -1 ] ||
  fail "comparison incorrectly requires a historical range anchor to remain upstream-available"
[ "$(pkg_repository_compare_versions "$tmp/repository" 154.0.0.0-1 153.0.8010.36-2)" = 1 ] ||
  fail "comparison of syntactically valid non-indexed versions is not locally ordered"

if pkg_repository_resolve_version "$tmp/repository" 153.00.8010.36-1 >/dev/null 2>&1; then fail "non-canonical Chrome version was accepted"; fi

exit 0
