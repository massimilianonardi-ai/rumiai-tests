#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-chrome/artifact.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; tests_dir=${group_dir%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot load target discovery helper"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

library="$root/lib/sys/sh/pkg/pkg-repository-chrome.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Chrome repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Chrome repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-chrome-artifact-$$"
umask 077
mkdir -p "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
printf -- '%s\n' chrome > "$tmp/repository/type"
printf -- '%s\n' '^google-chrome-stable_[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*-[0-9][0-9]*_amd64\.deb$' > "$tmp/range/archive_regex"
printf -- '%s\n' sha256 > "$tmp/range/digest_type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
case "${CHROME_ARTIFACT_MODE-normal}" in
  normal)
    filename='pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb'
    size=141931876
    digest=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
    architecture=amd64
    extra=
    ;;
  bad-filename)
    filename='pool/main/g/google-chrome-stable/other_153.0.8010.36-1_amd64.deb'
    size=141931876
    digest=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
    architecture=amd64
    extra=
    ;;
  missing-size)
    filename='pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb'
    size=
    digest=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
    architecture=amd64
    extra=
    ;;
  bad-digest)
    filename='pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb'
    size=141931876
    digest=not-a-sha256
    architecture=amd64
    extra=
    ;;
  wrong-arch)
    filename='pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb'
    size=141931876
    digest=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
    architecture=arm64
    extra=
    ;;
  duplicate-field)
    filename='pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb'
    size=141931876
    digest=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
    architecture=amd64
    extra='Size: 1'
    ;;
  *) exit 88 ;;
esac
printf '%s\n' 'Package: google-chrome-stable'
printf '%s\n' 'Version: 153.0.8010.36-1'
printf 'Architecture: %s\n' "$architecture"
printf 'Filename: %s\n' "$filename"
[ -z "$size" ] || printf 'Size: %s\n' "$size"
[ -z "$extra" ] || printf '%s\n' "$extra"
printf 'SHA256: %s\n' "$digest"
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"
PATH="$tmp/bin:/usr/bin:/bin"; export PATH
log() { printf -- '%s\n' "$*" >&2; }
CHROME_ARTIFACT_MODE=normal; export CHROME_ARTIFACT_MODE
. "$library" || error "cannot source Chrome repository adapter"

descriptor="$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" 153.0.8010.36-1)" || fail "Chrome artifact resolution failed"
expected='name=google-chrome-stable_153.0.8010.36-1_amd64.deb
url=https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.36-1_amd64.deb
size=141931876
digest=sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd'
[ "$descriptor" = "$expected" ] || fail "Chrome artifact descriptor differs from pkg_download contract"

rm "$tmp/range/digest_type" || error "cannot remove digest_type fixture"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" 153.0.8010.36-1 >/dev/null 2>&1; then fail "Chrome artifact resolution accepted missing SHA-256 policy"; fi
printf -- '%s\n' sha256 > "$tmp/range/digest_type"
printf -- '%s\n' '^unused$' > "$tmp/range/digest_regex"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" 153.0.8010.36-1 >/dev/null 2>&1; then fail "unsupported digest_regex was accepted"; fi
rm "$tmp/range/digest_regex" || error "cannot remove digest_regex fixture"

printf -- '%s\n' '^other$' > "$tmp/range/archive_regex"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" 153.0.8010.36-1 >/dev/null 2>&1; then fail "artifact outside archive_regex was accepted"; fi
printf -- '%s\n' '^google-chrome-stable_[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*-[0-9][0-9]*_amd64\.deb$' > "$tmp/range/archive_regex"

for mode in bad-filename missing-size bad-digest wrong-arch duplicate-field
do
  CHROME_ARTIFACT_MODE=$mode; export CHROME_ARTIFACT_MODE
  if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" 153.0.8010.36-1 >/dev/null 2>&1
  then
    fail "malformed upstream Packages metadata was accepted in mode $mode"
  fi
done

exit 0
