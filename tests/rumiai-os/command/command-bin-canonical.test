#!/bin/sh

TEST_ID=rumiai-os/command/command-bin-canonical.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'

tmp=${TMPDIR:-/tmp}/rumiai-command-bin-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM


real=$tmp/real-command
alias=$tmp/command-alias
observed=$tmp/observed

cat > "$real" <<'EOF_COMMAND'
#!/usr/bin/env m
printf '%s\n' "$m_COMMAND_BIN" > "$OBSERVED_COMMAND_BIN" || return 41
return 0
EOF_COMMAND
chmod 700 "$real" || error 'cannot prepare command body'
ln -s "$real" "$alias" || error 'cannot create command symlink'
expected=$(command -p realpath -- "$real" 2>/dev/null) || error 'cannot canonicalize expected command'

OBSERVED_COMMAND_BIN=$observed
export OBSERVED_COMMAND_BIN
"$root/m" "$alias" > "$tmp/stdout" 2> "$tmp/stderr" || {
    status=$?
    cat "$tmp/stderr" >&2
    fail "symlink command dispatch returned $status"
}
actual=$(cat "$observed") || error 'cannot read m_COMMAND_BIN observation'
[ "$actual" = "$expected" ] || fail "m_COMMAND_BIN is not the canonical command pathname: expected=$expected observed=$actual"

path_dir=$tmp/path
cwd=$tmp/cwd
shadowed=$path_dir/shadowed
shadow_observed=$tmp/shadow-observed
mkdir "$path_dir" "$cwd" "$cwd/shadowed" || error 'cannot prepare slashless command shadow fixture'
cat > "$shadowed" <<'EOF_SHADOW'
#!/usr/bin/env m
printf '%s\n' "$m_COMMAND_BIN" > "$OBSERVED_COMMAND_BIN" || return 42
return 0
EOF_SHADOW
chmod 700 "$shadowed" || error 'cannot prepare PATH command'
shadow_expected=$(command -p realpath -- "$shadowed" 2>/dev/null) || error 'cannot canonicalize PATH command'

OBSERVED_COMMAND_BIN=$shadow_observed
export OBSERVED_COMMAND_BIN
(
    cd "$cwd" || exit 90
    PATH="$path_dir:$PATH"
    export PATH
    "$root/m" shadowed
) > "$tmp/shadow.stdout" 2> "$tmp/shadow.stderr" || {
    status=$?
    cat "$tmp/shadow.stderr" >&2
    fail "slashless PATH command dispatch returned $status"
}
shadow_actual=$(cat "$shadow_observed") || error 'cannot read slashless command observation'
[ "$shadow_actual" = "$shadow_expected" ] || fail "CWD object shadowed slashless PATH command: expected=$shadow_expected observed=$shadow_actual"
exit 0
