#!/bin/sh

TEST_ID=rumiai-os/command/direct-symlink-alias.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group=${test_dir%/*}
rumiai_os_group=${group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'

tmp=${TMPDIR:-/tmp}/rumiai-command-direct-alias-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM


real=$tmp/canonical-command
alias=$tmp/renamed-alias
observed=$tmp/observed

cat > "$real" <<'EOF_COMMAND'
#!/usr/bin/env m
printf '%s\n' "$m_COMMAND_BIN" > "$OBSERVED_ALIAS" || return 41
return 0
EOF_COMMAND
chmod 700 "$real" || error 'cannot make canonical command executable'
ln -s "$real" "$alias" || error 'cannot create renamed command alias'
expected=$(command -p realpath -- "$real" 2>/dev/null) || error 'cannot canonicalize canonical command'

OBSERVED_ALIAS=$observed
PATH=$root/bin/sys:$PATH
export OBSERVED_ALIAS PATH
"$alias" > "$tmp/stdout" 2> "$tmp/stderr" || {
    status=$?
    cat "$tmp/stderr" >&2
    fail "renamed direct alias returned $status"
}
actual=$(cat "$observed") || error 'cannot read alias observation'
[ "$actual" = "$expected" ] || fail "direct symlink alias did not canonicalize m_COMMAND_BIN: expected=$expected observed=$actual"
exit 0
