#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-chromium/contract.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-chromium.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Chromium repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Chromium repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-chromium-contract-$$"
umask 077
mkdir "$tmp" "$tmp/bin" "$tmp/repository" "$tmp/range" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository_dir="$tmp/repository"
range_dir="$tmp/range"
CHROMIUM_HTTP_LOG="$tmp/http.log"; export CHROMIUM_HTTP_LOG

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
for url do :; done
printf -- '%s\n' "$url" >> "$CHROMIUM_HTTP_LOG"

case "$url" in
  https://www.googleapis.com/download/storage/v1/b/chromium-browser-snapshots/o/*%2FLAST_CHANGE\?alt=media)
    encoded=${url#https://www.googleapis.com/download/storage/v1/b/chromium-browser-snapshots/o/}
    encoded=${encoded%\?alt=media}
    case "$encoded" in
      Linux_x64%2FLAST_CHANGE|Mac%2FLAST_CHANGE|Mac_Arm%2FLAST_CHANGE|Win_x64%2FLAST_CHANGE|Win_Arm64%2FLAST_CHANGE)
        printf -- '%s\n' 200
        exit 0
        ;;
    esac
    exit 88
    ;;
  https://www.googleapis.com/storage/v1/b/chromium-browser-snapshots/o/*\?fields=name%2Csize%2Cmd5Hash%2Ccrc32c)
    encoded=${url#https://www.googleapis.com/storage/v1/b/chromium-browser-snapshots/o/}
    encoded=${encoded%\?fields=name%2Csize%2Cmd5Hash%2Ccrc32c}
    object="$(printf -- '%s\n' "$encoded" | command -p -- sed 's/%2F/\//g')" || exit 89

    platform=${object%%/*}
    rest=${object#*/}
    version=${rest%%/*}
    archive=${rest#*/}
    case "$version" in ''|*[!0-9]*) exit 88;; esac
    [ "$version" != 333 ] || exit 22

    case "$platform:$archive" in
      Linux_x64:chrome-linux.zip|Mac:chrome-mac.zip|Mac_Arm:chrome-mac.zip|Win_x64:chrome-win.zip|Win_Arm64:chrome-win.zip) :;;
      *) exit 88;;
    esac

    case "${CHROMIUM_METADATA_MODE-ok}" in
      ok)
        printf -- '{"name":"%s","size":"7","md5Hash":"XUFAKrxLKna5cZ2REBfFkg==","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      no-md5)
        printf -- '{"name":"%s","size":"7","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      wrong-name)
        printf -- '{"name":"wrong/object","size":"7","md5Hash":"XUFAKrxLKna5cZ2REBfFkg==","crc32c":"ImIEBA=="}\n'
        ;;
      bad-md5)
        printf -- '{"name":"%s","size":"7","md5Hash":"not-base64","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      *) exit 87;;
    esac
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

write_repository()
{
  platform=$1
  rm -rf "$repository_dir"
  mkdir "$repository_dir" || error "cannot recreate repository descriptor"
  printf -- '%s\n' chromium > "$repository_dir/type"
  printf -- '%s\n' "$platform" > "$repository_dir/platform"
}

write_range()
{
  expression=$1
  rm -rf "$range_dir"
  mkdir "$range_dir" || error "cannot recreate range"
  printf -- '%s\n' "$expression" > "$range_dir/archive_regex"
  printf -- '%s\n' md5 > "$range_dir/digest_type"
}

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
. "$library" || error "cannot source Chromium repository adapter"

CHROMIUM_METADATA_MODE=ok; export CHROMIUM_METADATA_MODE
: > "$CHROMIUM_HTTP_LOG"

write_repository Linux_x64
latest="$(pkg_repository_resolve_version "$repository_dir")" || fail "latest Chromium resolution failed"
[ "$latest" = 200 ] || fail "latest Chromium version is incorrect"
grep -F 'https://www.googleapis.com/download/storage/v1/b/chromium-browser-snapshots/o/Linux_x64%2FLAST_CHANGE?alt=media' "$CHROMIUM_HTTP_LOG" >/dev/null 2>&1 || fail "latest did not use the canonical LAST_CHANGE media endpoint"

[ "$(pkg_repository_resolve_version "$repository_dir" 100)" = 100 ] || fail "exact Chromium version was rejected"
if pkg_repository_resolve_version "$repository_dir" 333 >/dev/null 2>&1; then fail "missing exact Chromium artifact was accepted"; fi
if pkg_repository_resolve_version "$repository_dir" not-a-version >/dev/null 2>&1; then fail "non-decimal Chromium version was accepted"; fi

[ "$(pkg_repository_compare_versions "$repository_dir" 100 200)" = -1 ] || fail "numeric Chromium comparison left<right failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 200 200)" = 0 ] || fail "numeric Chromium comparison equality failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 200 100)" = 1 ] || fail "numeric Chromium comparison left>right failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 999999999999999999999999 1000000000000000000000000)" = -1 ] || fail "Chromium comparison overflowed or became lexical"
if pkg_repository_compare_versions "$repository_dir" 333 200 >/dev/null 2>&1; then fail "comparison accepted a non-installable Chromium version"; fi

check_artifact()
{
  platform=$1
  expression=$2
  expected_name=$3

  write_repository "$platform"
  write_range "$expression"
  descriptor="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100)" || fail "artifact resolution failed for $platform"

  printf -- '%s\n' "$descriptor" | grep -F "name=$expected_name" >/dev/null 2>&1 || fail "wrong artifact name for $platform"
  printf -- '%s\n' "$descriptor" | grep -F "url=https://www.googleapis.com/download/storage/v1/b/chromium-browser-snapshots/o/$platform%2F100%2F$expected_name?alt=media" >/dev/null 2>&1 || fail "wrong media URL for $platform"
  printf -- '%s\n' "$descriptor" | grep -F 'size=7' >/dev/null 2>&1 || fail "wrong size for $platform"
  printf -- '%s\n' "$descriptor" | grep -F 'digest=md5:5d41402abc4b2a76b9719d911017c592' >/dev/null 2>&1 || fail "wrong MD5 conversion or digest type for $platform"
}

check_artifact Linux_x64 '^chrome-linux\.zip$' chrome-linux.zip
check_artifact Mac '^chrome-mac\.zip$' chrome-mac.zip
check_artifact Mac_Arm '^chrome-mac\.zip$' chrome-mac.zip
check_artifact Win_x64 '^chrome-win\.zip$' chrome-win.zip
check_artifact Win_Arm64 '^chrome-win\.zip$' chrome-win.zip

write_repository Linux_x64
write_range '^chrome-linux\.zip$'
CHROMIUM_METADATA_MODE=no-md5; export CHROMIUM_METADATA_MODE
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium adapter silently downgraded when md5Hash was absent"
fi

CHROMIUM_METADATA_MODE=wrong-name; export CHROMIUM_METADATA_MODE
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium adapter accepted metadata for a different object"
fi

CHROMIUM_METADATA_MODE=bad-md5; export CHROMIUM_METADATA_MODE
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium adapter accepted malformed md5Hash"
fi

CHROMIUM_METADATA_MODE=ok; export CHROMIUM_METADATA_MODE
write_range '^other\.zip$'
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium adapter ignored archive_regex"
fi

write_range '^chrome-linux\.zip$'
printf -- '%s\n' sha256 > "$range_dir/digest_type"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium MD5 range accepted a different digest_type"
fi

write_range '^chrome-linux\.zip$'
printf -- '%s\n' 'unused' > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 100 >/dev/null 2>&1
then
  fail "Chromium adapter accepted digest_regex in the current range contract"
fi

write_repository linux-arm64
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1
then
  fail "invented Linux ARM64 Chromium platform was accepted"
fi

write_repository Linux_x64
printf -- '%s\n' unexpected > "$repository_dir/extra"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1
then
  fail "unknown Chromium repository field was accepted"
fi

write_repository Linux_x64
printf -- '%s\n' github > "$repository_dir/type"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1
then
  fail "non-Chromium repository type was accepted"
fi

exit 0
