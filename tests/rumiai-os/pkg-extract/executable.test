#!/bin/sh

TEST_ID="rumiai-os/pkg-extract/executable.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac
  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return "1"
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"
  rumiai_test_target_have git || return "3"
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi
    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done
  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1" ;;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") : ;;
  "1") skip "rumiai-os target checkout not found" ;;
  "2") fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

library="$root/lib/sys/sh/pkg-extract.lib.sh"
[ -f "$library" ] || fail "lib/sys/sh/pkg-extract.lib.sh is missing"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-extract-executable-$$"
umask "077"
command -p mkdir "$tmp" || error "cannot create temporary directory"
trap 'command -p rm -rf "$tmp"' 0 HUP INT TERM

fakebin="$tmp/bin"
stage="$tmp/stage"
command -p mkdir "$fakebin" "$stage" || error "cannot create fixture directories"

extract_marker="$tmp/extract-called"
execute_marker="$tmp/artifact-executed"
cat > "$fakebin/extract" <<'EOF_EXTRACT'
#!/bin/sh
: > "$PKG_EXTRACT_EXECUTABLE_EXTRACT_MARKER"
exit 99
EOF_EXTRACT
command -p chmod "700" "$fakebin/extract" || error "cannot prepare fake extract"

artifact="$tmp/jq-linux-amd64"
cat > "$artifact" <<EOF_ARTIFACT
#!/bin/sh
: > "$execute_marker"
EOF_ARTIFACT
command -p chmod "600" "$artifact" || error "cannot prepare artifact"

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  case "$2" in
    */*) dir=${2%/*}; base=${2##*/}; [ -n "$dir" ] || dir=/ ;;
    *) dir=.; base=$2 ;;
  esac
  physical_dir="$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
  eval "$1=\$physical_dir/\$base"
}

log()
{
  :
}

PATH="$fakebin:/usr/bin:/bin"
PKG_EXTRACT_EXECUTABLE_EXTRACT_MARKER="$extract_marker"
export PATH PKG_EXTRACT_EXECUTABLE_EXTRACT_MARKER

. "$library" || error "cannot source pkg-extract library"

pkg_extract "$artifact" executable "$stage" || fail "executable materialization failed"

output="$stage/jq-linux-amd64"
[ ! -e "$extract_marker" ] || fail "executable format was delegated to extract"
[ ! -e "$execute_marker" ] || fail "artifact was executed during materialization"
[ -f "$output" ] && [ ! -L "$output" ] || fail "materialized executable is missing or not a regular file"
command -p cmp "$artifact" "$output" >/dev/null 2>&1 || fail "materialized executable content changed"
[ -x "$output" ] || fail "materialized executable is not executable"
[ ! -x "$artifact" ] || fail "input artifact mode was modified"

entry_count=0
for entry in \
  "$stage"/* \
  "$stage"/.[!.]* \
  "$stage"/..?*
do
  [ -e "$entry" ] || [ -L "$entry" ] || continue
  entry_count=$((entry_count + 1))
done
[ "$entry_count" -eq 1 ] || fail "executable useful root contains unexpected entries"

exit "0"
