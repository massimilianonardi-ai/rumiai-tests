#!/bin/sh

TEST_ID="rumiai-os/pkg-extract/contract.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac
  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"
  rumiai_test_target_have git || return "3"
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi
    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done
  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) :;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1";;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") :;;
  "1") skip "rumiai-os target checkout not found";;
  "2") fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

library="$root/lib/sh/pkg-extract.lib.sh"
[ -f "$library" ] || fail "lib/sh/pkg-extract.lib.sh is missing"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-extract-contract-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fakebin="$tmp/bin"
mkdir "$fakebin" || error "cannot create fake backend directory"

cat > "$fakebin/extract" <<'EOF_EXTRACT'
#!/bin/sh
printf -- '%s\n' "$*" > "$PKG_EXTRACT_ARGS"
case "${PKG_EXTRACT_LAYOUT-flat}" in
  flat)
    printf -- '%s\n' one > "$3/one"
    printf -- '%s\n' two > "$3/two"
    ;;
  wrapper)
    mkdir "$3/release-26.2.0" || exit 1
    printf -- '%s\n' executable > "$3/release-26.2.0/program"
    mkdir "$3/release-26.2.0/lib" || exit 1
    ;;
  deep)
    mkdir -p "$3/product/26.2.0/root/bin" "$3/product/26.2.0/root/lib" || exit 1
    printf -- '%s\n' executable > "$3/product/26.2.0/root/bin/program"
    ;;
  hidden)
    mkdir "$3/wrapper" || exit 1
    printf -- '%s\n' payload > "$3/wrapper/program"
    printf -- '%s\n' marker > "$3/.marker"
    ;;
  symlink)
    mkdir "$PKG_EXTRACT_SYMLINK_TARGET" || exit 1
    printf -- '%s\n' payload > "$PKG_EXTRACT_SYMLINK_TARGET/program"
    ln -s "$PKG_EXTRACT_SYMLINK_TARGET" "$3/wrapper" || exit 1
    ;;
  fail)
    printf -- '%s\n' partial > "$3/partial"
    exit 7
    ;;
  *)
    exit 9
    ;;
esac
exit 0
EOF_EXTRACT
chmod "700" "$fakebin/extract"

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  case "$2" in
    */*) dir=${2%/*}; base=${2##*/}; [ -n "$dir" ] || dir=/;;
    *) dir=.; base=$2;;
  esac
  physical_dir="$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
  eval "$1=\$physical_dir/\$base"
}
log()
{
  :
}

PATH="$fakebin:/usr/bin:/bin"
export PATH
PKG_EXTRACT_ARGS="$tmp/extract.args"
export PKG_EXTRACT_ARGS
m_ROOT="$tmp/forbidden-root"
mkdir -p "$m_ROOT/pkg" || error "cannot create forbidden package store fixture"
export m_ROOT
. "$library" || error "cannot source pkg-extract library"

artifact="$tmp/archive.tar.gz"
printf -- '%s' payload > "$artifact"

stage="$tmp/custom-destination"
mkdir "$stage"
readpathce artifact_canonical "$artifact" || error "cannot canonicalize artifact fixture"
readpathce stage_canonical "$stage" || error "cannot canonicalize staging fixture"
PKG_EXTRACT_LAYOUT=flat
export PKG_EXTRACT_LAYOUT
pkg_extract "$artifact" tar.gz "$stage" || fail "identity materialization failed"
[ "$(cat "$PKG_EXTRACT_ARGS")" = "tar.gz $artifact_canonical $stage_canonical" ] || fail "pkg_extract delegated incorrect extract arguments"
[ -f "$stage/one" ] && [ -f "$stage/two" ] || fail "identity useful root was not preserved"
[ -z "$(find "$m_ROOT/pkg" -mindepth 1 -print -quit)" ] || fail "pkg_extract wrote into m_ROOT/pkg instead of the caller destination"

rm -rf "$stage"
mkdir "$stage"
PKG_EXTRACT_LAYOUT=wrapper
export PKG_EXTRACT_LAYOUT
pkg_extract "$artifact" tar "$stage" || fail "single-wrapper normalization failed"
[ -f "$stage/program" ] && [ -d "$stage/lib" ] || fail "single-wrapper useful root was not lifted into destination"
[ ! -e "$stage/release-26.2.0" ] && [ ! -L "$stage/release-26.2.0" ] || fail "single wrapper survived normalization"

rm -rf "$stage"
mkdir "$stage"
PKG_EXTRACT_LAYOUT=deep
export PKG_EXTRACT_LAYOUT
pkg_extract "$artifact" zip "$stage" || fail "deep-wrapper normalization failed"
[ -f "$stage/bin/program" ] && [ -d "$stage/lib" ] || fail "deep useful root was not lifted into destination"
[ ! -e "$stage/product" ] && [ ! -L "$stage/product" ] || fail "deep wrapper survived normalization"

rm -rf "$stage"
mkdir "$stage"
PKG_EXTRACT_LAYOUT=hidden
export PKG_EXTRACT_LAYOUT
pkg_extract "$artifact" tar "$stage" || fail "hidden-entry identity case failed"
[ -f "$stage/.marker" ] && [ -d "$stage/wrapper" ] || fail "hidden entry was ignored by structural discovery"

rm -rf "$stage"
mkdir "$stage"
PKG_EXTRACT_LAYOUT=symlink
PKG_EXTRACT_SYMLINK_TARGET="$tmp/symlink-target"
export PKG_EXTRACT_LAYOUT PKG_EXTRACT_SYMLINK_TARGET
pkg_extract "$artifact" tar "$stage" || fail "symlink-wrapper identity case failed"
[ -L "$stage/wrapper" ] || fail "symlink wrapper was followed or replaced"

rm -rf "$stage"
mkdir "$stage"
appimage="$tmp/malicious.AppImage"
marker="$tmp/appimage-executed"
cat > "$appimage" <<EOF_APPIMAGE
#!/bin/sh
printf -- '%s\\n' executed > "$marker"
EOF_APPIMAGE
chmod "755" "$appimage"
pkg_extract "$appimage" appimage "$stage" || fail "opaque AppImage materialization failed"
[ ! -e "$marker" ] || fail "AppImage was executed during pkg_extract"
[ -f "$stage/malicious.AppImage" ] || fail "AppImage was not copied opaquely"
[ -x "$stage/malicious.AppImage" ] || fail "AppImage mode was not preserved"

rm -rf "$stage"
mkdir "$stage"
PKG_EXTRACT_LAYOUT=fail
export PKG_EXTRACT_LAYOUT
if pkg_extract "$artifact" tar "$stage" >/dev/null 2>&1
then
  fail "extract backend failure was accepted"
else
  status=$?
  [ "$status" -eq 1 ] || fail "extract backend failure returned $status instead of 1"
fi

rm -rf "$stage"
mkdir "$stage"
printf -- '%s\n' occupied > "$stage/existing"
if pkg_extract "$artifact" tar "$stage" >/dev/null 2>&1
then
  fail "non-empty staging directory was accepted"
fi

rm -rf "$stage"
mkdir "$stage"
if pkg_extract "$artifact" unsupported "$stage" >/dev/null 2>&1
then
  fail "unsupported format was accepted"
else
  status=$?
  [ "$status" -eq 2 ] || fail "unsupported format returned $status instead of 2"
fi

exit "0"
