#!/bin/sh

TEST_ID=rumiai-os/pkg-extract/flat-pkg.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

[ "$(uname -s 2>/dev/null)" = Darwin ] || skip 'flat-pkg materialization is macOS-specific'
for tool in pkgbuild productbuild pkgutil
do
  command -v "$tool" >/dev/null 2>&1 || skip "$tool is unavailable"
done

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; suite_root=${rumiai_os_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac

tmp=${TMPDIR:-/tmp}/rumiai-flat-pkg-$$
marker=$tmp/postinstall-executed
umask 077
mkdir -p "$tmp/root/example/bin" "$tmp/root/installer-only" "$tmp/scripts" "$tmp/stage" || error 'cannot create fixture'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

cat > "$tmp/root/example/bin/tool" <<'EOF_TOOL'
#!/bin/sh
exit 0
EOF_TOOL
chmod 755 "$tmp/root/example/bin/tool" || error 'cannot prepare payload command'
printf '%s\n' payload-sibling > "$tmp/root/example/runtime-marker" || error 'cannot prepare payload sibling'
printf '%s\n' installer-only > "$tmp/root/installer-only/marker" || error 'cannot prepare installer-only sibling'

cat > "$tmp/scripts/postinstall" <<EOF_POSTINSTALL
#!/bin/sh
printf '%s\\n' executed > "$marker"
EOF_POSTINSTALL
chmod 755 "$tmp/scripts/postinstall" || error 'cannot prepare postinstall fixture'

pkgbuild \
  --root "$tmp/root" \
  --scripts "$tmp/scripts" \
  --identifier org.rumiai.test.flatpkg \
  --version 1 \
  --install-location /opt \
  "$tmp/Example.pkg" >/dev/null || error 'cannot build component package'

productbuild --package "$tmp/Example.pkg" "$tmp/Product.pkg" >/dev/null ||
  error 'cannot build flat product package'

driver=$tmp/pkg-extract-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-extract" || exit 3
pkg_extract "$@"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

range=$tmp/range-payload-root
mkdir "$range" || error 'cannot create flat-pkg payload-root range'
printf '%s\n' flat-pkg > "$range/format" || error 'cannot write flat-pkg format'
printf '%s\n' Example.pkg > "$range/component" || error 'cannot write flat-pkg component'
printf '%s\n' example > "$range/payload-root" || error 'cannot write flat-pkg payload root'

"$root/m" "$driver" "$tmp/Product.pkg" "$range" "$tmp/stage" ||
  fail 'flat-pkg payload-root extraction failed'

[ -x "$tmp/stage/bin/tool" ] || fail 'selected flat-pkg payload root did not expose tool'
[ -f "$tmp/stage/runtime-marker" ] || fail 'selected flat-pkg payload sibling was not preserved'
[ ! -e "$tmp/stage/example" ] && [ ! -L "$tmp/stage/example" ] ||
  fail 'payload-root wrapper survived flat-pkg extraction'
[ ! -e "$tmp/stage/installer-only" ] && [ ! -L "$tmp/stage/installer-only" ] ||
  fail 'payload sibling outside selected flat-pkg root survived'
[ ! -e "$marker" ] && [ ! -L "$marker" ] ||
  fail 'flat-pkg materialization executed installer postinstall script'

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for complete payload'
range=$tmp/range-complete
mkdir "$range" || error 'cannot create flat-pkg complete range'
printf '%s\n' flat-pkg > "$range/format" || error 'cannot write flat-pkg complete format'
printf '%s\n' Example.pkg > "$range/component" || error 'cannot write flat-pkg complete component'
"$root/m" "$driver" "$tmp/Product.pkg" "$range" "$tmp/stage" ||
  fail 'flat-pkg complete payload extraction failed'
[ -x "$tmp/stage/example/bin/tool" ] || fail 'complete flat-pkg payload lost tool'
[ -f "$tmp/stage/installer-only/marker" ] || fail 'complete flat-pkg payload lost sibling'
[ ! -e "$marker" ] && [ ! -L "$marker" ] ||
  fail 'complete flat-pkg materialization executed installer script'

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for missing component'
range=$tmp/range-missing
mkdir "$range" || error 'cannot create flat-pkg missing-component range'
printf '%s\n' flat-pkg > "$range/format" || error 'cannot write flat-pkg missing-component format'
printf '%s\n' Missing.pkg > "$range/component" || error 'cannot write missing flat-pkg component'
if "$root/m" "$driver" "$tmp/Product.pkg" "$range" "$tmp/stage" >/dev/null 2>&1
then
  fail 'missing flat-pkg component was accepted'
fi

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for invalid payload root'
range=$tmp/range-invalid
mkdir "$range" || error 'cannot create flat-pkg invalid range'
printf '%s\n' flat-pkg > "$range/format" || error 'cannot write flat-pkg invalid format'
printf '%s\n' Example.pkg > "$range/component" || error 'cannot write flat-pkg invalid component'
printf '%s\n' ../escape > "$range/payload-root" || error 'cannot write invalid flat-pkg payload root'
"$root/m" "$driver" "$tmp/Product.pkg" "$range" "$tmp/stage" >/dev/null 2>&1
[ "$?" -eq 2 ] || fail 'invalid flat-pkg payload-root did not return invalid-invocation status'

exit 0
