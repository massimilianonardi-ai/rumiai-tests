#!/bin/sh

TEST_ID=rumiai-os/pkg-extract/dmg-pkg.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

[ "$(uname -s 2>/dev/null)" = Darwin ] || skip 'dmg-pkg materialization is macOS-specific'
for tool in hdiutil pkgbuild productbuild pkgutil
do
  command -v "$tool" >/dev/null 2>&1 || skip "$tool is unavailable"
done

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; suite_root=${rumiai_os_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac

tmp=${TMPDIR:-/tmp}/rumiai-dmg-pkg-$$
umask 077
mkdir -p \
  "$tmp/primary-root/private/tmp/org.gpgtools/MacGPG2/bin" \
  "$tmp/primary-root/private/tmp/org.gpgtools/MacGPG2/lib" \
  "$tmp/primary-root/Library/LaunchAgents" \
  "$tmp/raw-root/bin" \
  "$tmp/raw-root/lib" \
  "$tmp/pinentry-root/pinentry-mac.app/Contents/MacOS" \
  "$tmp/overlay/pinentry" \
  "$tmp/outer" "$tmp/dmgsrc" "$tmp/stage" || error 'cannot create fixture'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

cat > "$tmp/primary-root/private/tmp/org.gpgtools/MacGPG2/bin/gpg" <<'EOF_GPG'
#!/bin/sh
exit 0
EOF_GPG
chmod 755 "$tmp/primary-root/private/tmp/org.gpgtools/MacGPG2/bin/gpg" || error 'cannot prepare payload command'
printf '%s\n' fixture > "$tmp/primary-root/private/tmp/org.gpgtools/MacGPG2/lib/runtime-marker" || error 'cannot prepare useful-root sibling'
printf '%s\n' installer-only > "$tmp/primary-root/Library/LaunchAgents/org.gpgtools.macgpg2.fix.plist" || error 'cannot prepare payload sibling'

cat > "$tmp/pinentry-root/pinentry-mac.app/Contents/MacOS/pinentry-mac" <<'EOF_PINENTRY'
#!/bin/sh
exit 0
EOF_PINENTRY
chmod 755 "$tmp/pinentry-root/pinentry-mac.app/Contents/MacOS/pinentry-mac" ||
  error 'cannot prepare pinentry overlay executable'

printf '%s\n' pinentry_Core.pkg > "$tmp/overlay/pinentry/component" ||
  error 'cannot write pinentry overlay component'
printf '%s\n' libexec > "$tmp/overlay/pinentry/target-root" ||
  error 'cannot write pinentry overlay target root'

cat > "$tmp/raw-root/bin/raw-tool" <<'EOF_RAW'
#!/bin/sh
exit 0
EOF_RAW
chmod 755 "$tmp/raw-root/bin/raw-tool" || error 'cannot prepare raw component command'
printf '%s\n' raw > "$tmp/raw-root/lib/runtime-marker" || error 'cannot prepare raw component sibling'

pkgbuild \
  --root "$tmp/primary-root" \
  --identifier org.rumiai.test.macgpg.primary \
  --version 1 \
  --install-location / \
  "$tmp/MacGPG2.1_Core.pkg" >/dev/null || error 'cannot build primary component package'

pkgbuild \
  --root "$tmp/pinentry-root" \
  --identifier org.rumiai.test.macgpg.pinentry \
  --version 1 \
  --install-location / \
  "$tmp/pinentry_Core.pkg" >/dev/null || error 'cannot build pinentry component package'

pkgbuild \
  --root "$tmp/raw-root" \
  --identifier org.rumiai.test.macgpg.raw \
  --version 1 \
  --install-location / \
  "$tmp/Raw.pkg" >/dev/null || error 'cannot build raw component package'

productbuild \
  --package "$tmp/MacGPG2.1_Core.pkg" \
  --package "$tmp/pinentry_Core.pkg" \
  --package "$tmp/Raw.pkg" \
  "$tmp/outer/Install.pkg" >/dev/null || error 'cannot build outer product package'

cp "$tmp/outer/Install.pkg" "$tmp/dmgsrc/Install.pkg" || error 'cannot stage outer package'
hdiutil create -quiet -srcfolder "$tmp/dmgsrc" "$tmp/GPG_Suite-test.dmg" || error 'cannot create DMG fixture'

driver=$tmp/pkg-extract-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-extract" || exit 3
pkg_extract "$@"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

range=$tmp/range-primary
mkdir "$range" || error 'cannot create dmg-pkg primary range'
printf '%s\n' dmg-pkg > "$range/format" || error 'cannot write dmg-pkg format'
printf '%s\n' MacGPG2.1_Core.pkg > "$range/component" || error 'cannot write dmg-pkg component'
printf '%s\n' private/tmp/org.gpgtools/MacGPG2 > "$range/payload-root" || error 'cannot write dmg-pkg payload root'
mv "$tmp/overlay" "$range/overlay" || error 'cannot attach dmg-pkg overlay metadata'

"$root/m" "$driver" "$tmp/GPG_Suite-test.dmg" "$range" "$tmp/stage" ||
  fail 'dmg-pkg payload-root/overlay extraction failed'
[ -x "$tmp/stage/bin/gpg" ] || fail 'selected payload root did not expose gpg'
[ -f "$tmp/stage/lib/runtime-marker" ] || fail 'selected payload-root sibling was not preserved'
[ -x "$tmp/stage/libexec/pinentry-mac.app/Contents/MacOS/pinentry-mac" ] ||
  fail 'pinentry overlay was not materialized at target root'
[ ! -e "$tmp/stage/private" ] || fail 'payload staging prefix survived payload-root selection'
[ ! -e "$tmp/stage/Library" ] || fail 'installer-only Payload sibling survived payload-root selection'

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for raw component'
range=$tmp/range-raw
mkdir "$range" || error 'cannot create raw dmg-pkg range'
printf '%s\n' dmg-pkg > "$range/format" || error 'cannot write raw dmg-pkg format'
printf '%s\n' Raw.pkg > "$range/component" || error 'cannot write raw dmg-pkg component'
"$root/m" "$driver" "$tmp/GPG_Suite-test.dmg" "$range" "$tmp/stage" || fail 'raw dmg-pkg extraction regressed'
[ -x "$tmp/stage/bin/raw-tool" ] || fail 'raw component did not expose tool'
[ -f "$tmp/stage/lib/runtime-marker" ] || fail 'raw component sibling was not preserved'

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for missing component'
range=$tmp/range-missing
mkdir "$range" || error 'cannot create missing-component dmg-pkg range'
printf '%s\n' dmg-pkg > "$range/format" || error 'cannot write missing-component dmg-pkg format'
printf '%s\n' Missing.pkg > "$range/component" || error 'cannot write missing dmg-pkg component'
if "$root/m" "$driver" "$tmp/GPG_Suite-test.dmg" "$range" "$tmp/stage" >/dev/null 2>&1
then
  fail 'missing component was accepted'
fi

rm -rf "$tmp/stage"; mkdir "$tmp/stage" || error 'cannot reset stage for invalid payload root'
range=$tmp/range-invalid
mkdir "$range" || error 'cannot create invalid dmg-pkg range'
printf '%s\n' dmg-pkg > "$range/format" || error 'cannot write invalid dmg-pkg format'
printf '%s\n' MacGPG2.1_Core.pkg > "$range/component" || error 'cannot write invalid dmg-pkg component'
printf '%s\n' ../escape > "$range/payload-root" || error 'cannot write invalid dmg-pkg payload root'
"$root/m" "$driver" "$tmp/GPG_Suite-test.dmg" "$range" "$tmp/stage" >/dev/null 2>&1
[ "$?" -eq 2 ] || fail 'invalid payload-root did not return invalid-invocation status'
exit 0
