#!/bin/sh

TEST_ID=rumiai-os/editor/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
editor_group=${test_dir%/*}
rumiai_os_group=${editor_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

editor=$root/bin/sys/editor
manual=$root/res/sys/manual/editor
manual_command=$root/bin/sys/manual

[ -f "$editor" ] && [ -x "$editor" ] || fail 'editor is missing or not executable'
[ "$(sed -n '1p' "$editor")" = '#!/bin/sh' ] || fail 'editor is not standalone POSIX sh'
command -p sh -n "$editor" || fail 'editor is not valid POSIX-shell syntax'
[ -f "$manual" ] && [ ! -L "$manual" ] || fail 'editor operational manual is missing'
[ -x "$manual_command" ] || fail 'manual command is unavailable'

manual_text=$("$root/m" "$manual_command" --no-pager editor) ||
    fail 'manual editor lookup failed'
printf '%s\n' "$manual_text" | grep -F 'nano' >/dev/null 2>&1 ||
    fail 'manual editor does not document nano'
printf '%s\n' "$manual_text" | grep -F 'vim' >/dev/null 2>&1 ||
    fail 'manual editor does not document vim'
printf '%s\n' "$manual_text" | grep -F 'vi' >/dev/null 2>&1 ||
    fail 'manual editor does not document vi'

tmp=${TMPDIR:-/tmp}/rumiai-editor-contract-$$
umask 077
mkdir -p "$tmp/all" "$tmp/no-nano" "$tmp/vi-only" ||
    error 'cannot create backend fixtures'

cat > "$tmp/all/nano" <<'EOF_NANO'
#!/bin/sh
printf '%s\n' nano > "$RUMIAI_EDITOR_BACKEND"
printf '%s\n' "$#" > "$RUMIAI_EDITOR_ARGS"
for arg
do
    printf '%s\n' "$arg" >> "$RUMIAI_EDITOR_ARGS"
done
exit "${RUMIAI_EDITOR_STATUS:-0}"
EOF_NANO

cat > "$tmp/all/vim" <<'EOF_VIM_ALL'
#!/bin/sh
printf '%s\n' vim > "$RUMIAI_EDITOR_BACKEND"
exit 91
EOF_VIM_ALL

cat > "$tmp/all/vi" <<'EOF_VI_ALL'
#!/bin/sh
printf '%s\n' vi > "$RUMIAI_EDITOR_BACKEND"
exit 92
EOF_VI_ALL

cat > "$tmp/no-nano/vim" <<'EOF_VIM'
#!/bin/sh
printf '%s\n' vim > "$RUMIAI_EDITOR_BACKEND"
printf '%s\n' "$#" > "$RUMIAI_EDITOR_ARGS"
for arg
do
    printf '%s\n' "$arg" >> "$RUMIAI_EDITOR_ARGS"
done
exit "${RUMIAI_EDITOR_STATUS:-0}"
EOF_VIM

cat > "$tmp/no-nano/vi" <<'EOF_VI_FALLBACK'
#!/bin/sh
printf '%s\n' vi > "$RUMIAI_EDITOR_BACKEND"
exit 93
EOF_VI_FALLBACK

cat > "$tmp/vi-only/vi" <<'EOF_VI'
#!/bin/sh
printf '%s\n' vi > "$RUMIAI_EDITOR_BACKEND"
printf '%s\n' "$#" > "$RUMIAI_EDITOR_ARGS"
for arg
do
    printf '%s\n' "$arg" >> "$RUMIAI_EDITOR_ARGS"
done
exit "${RUMIAI_EDITOR_STATUS:-0}"
EOF_VI

chmod +x     "$tmp/all/nano" "$tmp/all/vim" "$tmp/all/vi"     "$tmp/no-nano/vim" "$tmp/no-nano/vi"     "$tmp/vi-only/vi" ||
    error 'cannot make editor fixtures executable'

backend=$tmp/backend
args=$tmp/args
operand="$tmp/file with spaces"

PATH="$tmp/all" RUMIAI_EDITOR_BACKEND="$backend" RUMIAI_EDITOR_ARGS="$args" RUMIAI_EDITOR_STATUS=37 "$editor" "$operand" '+7' >/dev/null 2>&1
status=$?
[ "$status" -eq 37 ] || fail "editor did not propagate nano status: $status"
[ "$(cat "$backend")" = nano ] || fail 'editor did not prefer nano'
[ "$(sed -n '1p' "$args")" -eq 2 ] || fail 'editor did not preserve argument count for nano'
[ "$(sed -n '2p' "$args")" = "$operand" ] || fail 'editor changed the first argument'
[ "$(sed -n '3p' "$args")" = '+7' ] || fail 'editor changed the second argument'

: > "$backend"
: > "$args"
PATH="$tmp/no-nano" RUMIAI_EDITOR_BACKEND="$backend" RUMIAI_EDITOR_ARGS="$args" RUMIAI_EDITOR_STATUS=23 "$editor" "$operand" >/dev/null 2>&1
status=$?
[ "$status" -eq 23 ] || fail "editor did not propagate vim status: $status"
[ "$(cat "$backend")" = vim ] || fail 'editor did not fall back to vim'
[ "$(sed -n '2p' "$args")" = "$operand" ] || fail 'editor changed operand during vim fallback'

: > "$backend"
: > "$args"
PATH="$tmp/vi-only" RUMIAI_EDITOR_BACKEND="$backend" RUMIAI_EDITOR_ARGS="$args" RUMIAI_EDITOR_STATUS=19 "$editor" "$operand" >/dev/null 2>&1
status=$?
[ "$status" -eq 19 ] || fail "editor did not propagate vi status: $status"
[ "$(cat "$backend")" = vi ] || fail 'editor did not fall back to vi'
[ "$(sed -n '2p' "$args")" = "$operand" ] || fail 'editor changed operand during vi fallback'

exit 0
