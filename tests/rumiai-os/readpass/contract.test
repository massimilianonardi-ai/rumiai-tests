#!/bin/sh

TEST_ID="rumiai-os/readpass/contract.test"

fail()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case $self in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

readpass=$root/bin/sys/readpass
readpassv=$root/bin/sys/readpassv

[ -f "$readpass" ] && [ -x "$readpass" ] || fail "readpass command is missing or not executable"
[ -f "$readpassv" ] && [ -x "$readpassv" ] || fail "readpassv command is missing or not executable"
[ -f "$root/res/sys/manual/readpass" ] && [ ! -L "$root/res/sys/manual/readpass" ] ||
  fail "readpass operational manual is missing"
[ -f "$root/res/sys/manual/readpassv" ] && [ ! -L "$root/res/sys/manual/readpassv" ] ||
  fail "readpassv operational manual is missing"

IFS= read -r first_line < "$readpass" || fail "cannot read readpass shebang"
[ "$first_line" = '#!/bin/sh' ] || fail "readpass shebang is not #!/bin/sh"

IFS= read -r first_line < "$readpassv" || fail "cannot read readpassv shebang"
[ "$first_line" = '#!/usr/bin/env m' ] || fail "readpassv shebang is not #!/usr/bin/env m"

if grep -E '(^|[^[:alnum:]_])m_[[:alnum:]_]+|(^|[^[:alnum:]_])log([[:space:](]|$)|(^|[^[:alnum:]_])lang([[:space:](]|$)|m_COMMAND_BIN' "$readpass" >/dev/null 2>&1
then
  fail "readpass contains a bootstrap dependency"
fi

command -p sh -n "$readpass" || fail "readpass is not valid POSIX-shell syntax for the host sh"
command -p sh -n "$readpassv" || fail "readpassv is not valid POSIX-shell syntax for the host sh"

tmp=${TMPDIR:-/tmp}/rumiai-readpass-contract-$$
umask 077
command -p mkdir "$tmp" || error "cannot create temporary directory"
trap 'command -p rm -rf "$tmp"' 0 HUP INT TERM

"$readpass" one two > "$tmp/readpass.stdout" 2> "$tmp/readpass.stderr"
status=$?
[ "$status" -eq 2 ] || fail "readpass invalid invocation returned $status instead of 2"
[ ! -s "$tmp/readpass.stdout" ] || fail "readpass invalid invocation wrote stdout data"

"$root/m" "$readpassv" only-one > "$tmp/readpassv.stdout" 2> "$tmp/readpassv.stderr"
status=$?
[ "$status" -eq 2 ] || fail "readpassv invalid invocation returned $status instead of 2"
[ ! -s "$tmp/readpassv.stdout" ] || fail "readpassv invalid invocation wrote stdout data"

exit 0
