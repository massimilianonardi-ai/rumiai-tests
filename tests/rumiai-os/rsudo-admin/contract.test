#!/bin/sh

TEST_ID=rumiai-os/rsudo-admin/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}

trap cleanup 0 HUP INT QUIT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

command_path=$root/bin/sys/rsudo-admin
manual_path=$root/res/sys/manual/rsudo-admin
legacy_template=$root/lib/sys/sh/rsudo/rsudo-jobs-template

[ -f "$command_path" ] && [ -x "$command_path" ] ||
    fail 'bin/sys/rsudo-admin is missing or not executable'

[ "$(sed -n '1p' "$command_path")" = '#!/usr/bin/env m' ] ||
    fail 'rsudo-admin has the wrong interpreter header'

command -p sh -n "$command_path" ||
    fail 'rsudo-admin is not valid POSIX-shell syntax'

[ -f "$manual_path" ] && [ ! -L "$manual_path" ] ||
    fail 'rsudo-admin operational manual is missing'

[ ! -e "$legacy_template" ] && [ ! -L "$legacy_template" ] ||
    fail 'superseded rsudo-jobs-template still exists'

tmp=${TMPDIR:-/tmp}/rumiai-rsudo-admin-contract-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

"$root/m" "$command_path" unexpected >"$tmp/stdout" 2>"$tmp/stderr"
status=$?
[ "$status" -eq 1 ] ||
    fail "invalid invocation returned $status instead of 1"

exit 0
