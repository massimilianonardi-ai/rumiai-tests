#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-artifact/contract.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-artifact.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "artifact override library is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "artifact override library syntax invalid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-repository-artifact-$$"
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository="$tmp/repository"; range="$tmp/range"
mkdir "$repository/download" "$repository/metadata" || error "cannot create override directories"

printf '%s\n' template-url > "$repository/download/type"
printf '%s\n' 'demo-{version}.zip' > "$repository/download/name-template"
printf '%s\n' 'https://downloads.example/{version}/{name}' > "$repository/download/url-template"
printf '%s\n' checksum-sidecar > "$repository/metadata/type"
printf '%s\n' digest-name > "$repository/metadata/record-format"
printf '%s\n' 'https://checks.example/{version}/{name}.sha512' > "$repository/metadata/url-template"
printf '%s\n' sha512 > "$range/digest_type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
length=0
url=
for argument
do
  [ "$argument" = -l ] && length=1
  url=$argument
done
if [ "$length" -eq 1 ]
then
  [ "$url" = 'https://downloads.example/v1/demo-v1.zip' ] || exit 87
  printf '%s\n' 777
  exit 0
fi
case "$url" in
  https://checks.example/v1/demo-v1.zip.sha512)
    printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  demo-v1.zip'
    ;;
  https://checks.example/v1/demo-v1.zip.sha512-only)
    printf '%s\n' 'EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE'
    ;;
  https://checks.example/v1/SHA256SUMS)
    printf '%s\n' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  other.zip'
    printf '%s\n' 'CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  demo-v1.zip'
    ;;
  'https://sourceforge.net/projects/demo/rss?path=/Demo/v1/')
    printf '%s\n' '<rss><channel><item><media:content url="https://sourceforge.net/projects/demo/files/Demo/v1/demo-v1.zip/download" filesize="888"><media:hash algo="md5">DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD</media:hash></media:content></item></channel></rss>'
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"
PATH="$tmp/bin:/usr/bin:/bin"; export PATH
. "$library" || error "cannot source artifact override library"

pkg_repository_artifact_overrides_validate "$repository" || fail "valid override schema rejected"
download="$(pkg_repository_artifact_download_resolve "$repository/download" v1)" || fail "template-url resolution failed"
tab="$(printf '\t')"
expected="demo-v1.zip${tab}https://downloads.example/v1/demo-v1.zip"
[ "$download" = "$expected" ] || fail "template-url output incorrect"
direct_download="$(pkg_repository_artifact_download_template_url 'demo-{version}.zip' 'https://downloads.example/{version}/{name}' v1)" || fail "direct template-url mechanism resolution failed"
[ "$direct_download" = "$expected" ] || fail "direct template-url mechanism output differs"

metadata="$(pkg_repository_artifact_metadata_resolve "$repository/metadata" sha512 v1 demo-v1.zip https://downloads.example/v1/demo-v1.zip)" || fail "checksum-sidecar resolution failed"
expected="777${tab}sha512:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
[ "$metadata" = "$expected" ] || fail "checksum-sidecar output incorrect"

printf '%s\n' digest-only > "$repository/metadata/record-format"
printf '%s\n' 'https://checks.example/{version}/{name}.sha512-only' > "$repository/metadata/url-template"
metadata="$(pkg_repository_artifact_metadata_resolve "$repository/metadata" sha512 v1 demo-v1.zip https://downloads.example/v1/demo-v1.zip)" || fail "digest-only checksum-sidecar resolution failed"
expected="777${tab}sha512:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
[ "$metadata" = "$expected" ] || fail "digest-only checksum-sidecar output incorrect"
direct="$(pkg_repository_artifact_metadata_checksum_sidecar 'https://checks.example/v1/demo-v1.zip.sha512-only' digest-only sha512 demo-v1.zip 'https://downloads.example/v1/demo-v1.zip')" || fail "direct checksum-sidecar mechanism resolution failed"
[ "$direct" = "$expected" ] || fail "direct checksum-sidecar mechanism output differs"

printf '%s\n' unknown-format > "$repository/metadata/record-format"
if pkg_repository_artifact_overrides_validate "$repository" >/dev/null 2>&1; then fail "unknown checksum-sidecar record format was accepted"; fi

rm "$repository/metadata/record-format"
printf '%s\n' checksum-manifest > "$repository/metadata/type"
printf '%s\n' 'https://checks.example/{version}/SHA256SUMS' > "$repository/metadata/url-template"
printf '%s\n' sha256 > "$range/digest_type"
metadata="$(pkg_repository_artifact_metadata_resolve "$repository/metadata" sha256 v1 demo-v1.zip https://downloads.example/v1/demo-v1.zip)" || fail "checksum-manifest resolution failed"
expected="777${tab}sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
[ "$metadata" = "$expected" ] || fail "checksum-manifest output incorrect"

printf '%s\n' 'demo-{unknown}.zip' > "$repository/download/name-template"
if pkg_repository_artifact_overrides_validate "$repository" >/dev/null 2>&1; then fail "unknown template placeholder was accepted"; fi
printf '%s\n' 'demo-{version}.zip' > "$repository/download/name-template"

printf '%s\n' unexpected > "$repository/download/extra"
if pkg_repository_artifact_overrides_validate "$repository" >/dev/null 2>&1; then fail "unknown download override field was accepted"; fi
rm "$repository/download/extra"

if pkg_repository_artifact_metadata_resolve "$repository/metadata" sha1 v1 demo-v1.zip https://downloads.example/v1/demo-v1.zip >/dev/null 2>&1
then
  fail "unsupported digest algorithm was accepted"
fi

sourceforge_metadata="$tmp/sourceforge-metadata"
mkdir "$sourceforge_metadata" || error "cannot create SourceForge metadata fixture"
printf '%s\n' sourceforge-rss > "$sourceforge_metadata/type"
printf '%s\n' demo > "$sourceforge_metadata/project"
printf '%s\n' '/Demo/{version}/' > "$sourceforge_metadata/path-template"
sourceforge_url='https://sourceforge.net/projects/demo/files/Demo/v1/demo-v1.zip/download'
metadata="$(pkg_repository_artifact_metadata_resolve "$sourceforge_metadata" md5 v1 demo-v1.zip "$sourceforge_url")" || fail "sourceforge-rss metadata resolution failed"
expected="888${tab}md5:dddddddddddddddddddddddddddddddd"
[ "$metadata" = "$expected" ] || fail "sourceforge-rss output incorrect"
direct="$(pkg_repository_artifact_metadata_sourceforge_rss demo '/Demo/{version}/' md5 v1 demo-v1.zip "$sourceforge_url")" || fail "direct SourceForge mechanism resolution failed"
[ "$direct" = "$expected" ] || fail "direct SourceForge mechanism output differs"

exit 0
