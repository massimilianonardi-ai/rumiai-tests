#!/bin/sh

TEST_ID=rumiai-os/pkg-integration/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${root-}" ] && [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :

    for cleanup_version in 1 2
    do
      if [ -d "$root/pkg/$package@$cleanup_version" ] && [ ! -L "$root/pkg/$package@$cleanup_version" ]
      then
        if [ -n "${driver-}" ] && [ -f "$driver" ]
        then
          "$root/m" "$driver" deintegrate "$package" "$cleanup_version" >/dev/null 2>&1 || :
        fi
        rm -rf "$root/pkg/$package@$cleanup_version" 2>/dev/null || :
      fi
    done

    rm -f "$root/pkg/$package" "$root/bin/ext/$package" 2>/dev/null || :

    if [ "${bin_ext_created-0}" -eq 1 ]
    then
      rmdir "$root/bin/ext" 2>/dev/null || :
    fi
    if [ "${pkg_store_created-0}" -eq 1 ]
    then
      rmdir "$root/pkg" 2>/dev/null || :
    fi
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_payload()
{
  payload=$1
  marker=$2
  mkdir "$payload" || return 1
  printf '%s\n' "$marker" > "$payload/payload-marker"
}

integrate()
{
  version=$1
  range=$2
  payload=$3
  "$root/m" "$driver" integrate "$package" "$version" "$range" "$payload"
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-integration-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=pitest$$
pkg_store_created=0
bin_ext_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 600 "$driver" || error 'cannot prepare integration driver'

range1=$tmp/range-1
payload1=$tmp/payload-1
mkdir "$range1" || error 'cannot create version 1 definition'
make_payload "$payload1" one || error 'cannot create version 1 payload'

integrate 1 "$range1" "$payload1" > "$tmp/integrate-1.out" 2> "$tmp/integrate-1.err" || {
  cat "$tmp/integrate-1.err" >&2
  fail 'valid package integration failed'
}

versions=$(run_pkg versions "$package" 2> "$tmp/versions-1.err") || {
  cat "$tmp/versions-1.err" >&2
  fail 'integrated package is not visible to pkg versions'
}
[ "$versions" = "$package@1" ] || fail "pkg versions returned unexpected result after integration: $versions"

duplicate=$tmp/payload-duplicate
make_payload "$duplicate" duplicate || error 'cannot create duplicate payload'
if integrate 1 "$range1" "$duplicate" > "$tmp/duplicate.out" 2> "$tmp/duplicate.err"
then
  fail 'pkg_integrate replaced an existing concrete package'
else
  [ "$?" -eq 1 ] || fail 'duplicate concrete integration did not return 1'
fi
[ -d "$duplicate" ] && [ -f "$duplicate/payload-marker" ] ||
  fail 'failed duplicate integration consumed caller-owned payload'

range_unsupported=$tmp/range-unsupported
payload_unsupported=$tmp/payload-unsupported
mkdir "$range_unsupported" || error 'cannot create unsupported definition'
printf '%s\n' future > "$range_unsupported/future"
make_payload "$payload_unsupported" unsupported || error 'cannot create unsupported payload'
if integrate 2 "$range_unsupported" "$payload_unsupported" > "$tmp/unsupported.out" 2> "$tmp/unsupported.err"
then
  fail 'pkg_integrate accepted an unsupported definition feature'
else
  [ "$?" -eq 2 ] || fail 'unsupported definition did not return 2'
fi
[ -d "$payload_unsupported" ] && [ -f "$payload_unsupported/payload-marker" ] ||
  fail 'rejected definition consumed caller-owned payload'

range_invalid=$tmp/range-invalid
payload_invalid=$tmp/payload-invalid
mkdir "$range_invalid" || error 'cannot create invalid-version definition'
make_payload "$payload_invalid" invalid || error 'cannot create invalid-version payload'
if integrate '1/2' "$range_invalid" "$payload_invalid" > "$tmp/version.out" 2> "$tmp/version.err"
then
  fail 'pkg_integrate accepted an invalid version'
else
  [ "$?" -eq 2 ] || fail 'invalid integration version did not return 2'
fi
[ -d "$payload_invalid" ] && [ -f "$payload_invalid/payload-marker" ] ||
  fail 'invalid-version integration consumed caller-owned payload'

range2=$tmp/range-2
payload2=$tmp/payload-2
mkdir "$range2" || error 'cannot create version 2 definition'
make_payload "$payload2" two || error 'cannot create version 2 payload'
integrate 2 "$range2" "$payload2" > "$tmp/integrate-2.out" 2> "$tmp/integrate-2.err" || {
  cat "$tmp/integrate-2.err" >&2
  fail 'second valid package integration failed'
}

versions=$(run_pkg versions "$package" 2> "$tmp/versions-2.err") || fail 'pkg versions failed with two integrated concretes'
printf '%s\n' "$versions" | grep -Fx "$package@1" >/dev/null 2>&1 || fail 'version 1 missing after integrating version 2'
printf '%s\n' "$versions" | grep -Fx "$package@2" >/dev/null 2>&1 || fail 'version 2 missing after integration'

run_pkg default "$package@2" > "$tmp/default.out" 2> "$tmp/default.err" || {
  cat "$tmp/default.err" >&2
  fail 'cannot select integrated version 2 as default'
}

if "$root/m" "$driver" deintegrate "$package" 2 > "$tmp/current-remove.out" 2> "$tmp/current-remove.err"
then
  fail 'pkg_deintegrate removed the current/default concrete'
else
  [ "$?" -eq 1 ] || fail 'deintegrating current concrete did not return 1'
fi

run_pkg default -u -- "$package" > "$tmp/clear.out" 2> "$tmp/clear.err" ||
  fail 'cannot clear default before deintegration'

"$root/m" "$driver" deintegrate "$package" 2 > "$tmp/remove-2.out" 2> "$tmp/remove-2.err" || {
  cat "$tmp/remove-2.err" >&2
  fail 'pkg_deintegrate failed for non-current version 2'
}

versions=$(run_pkg versions "$package" 2> "$tmp/versions-after-2.err") || fail 'pkg versions failed after deintegrating version 2'
[ "$versions" = "$package@1" ] || fail "version 2 remained visible after deintegration: $versions"

"$root/m" "$driver" deintegrate "$package" 1 > "$tmp/remove-1.out" 2> "$tmp/remove-1.err" || {
  cat "$tmp/remove-1.err" >&2
  fail 'pkg_deintegrate failed for final non-current version'
}

if run_pkg versions "$package" > "$tmp/versions-empty.out" 2> "$tmp/versions-empty.err"
then
  fail 'pkg versions still reports a class after all concretes were deintegrated'
else
  [ "$?" -eq 1 ] || fail 'empty package class query did not return 1'
fi

"$root/m" "$driver" deintegrate > "$tmp/deintegrate-arity.out" 2> "$tmp/deintegrate-arity.err"
[ "$?" -eq 2 ] || fail 'pkg_deintegrate invalid arity did not return 2'

exit 0
