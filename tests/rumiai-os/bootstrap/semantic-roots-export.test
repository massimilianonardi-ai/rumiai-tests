#!/bin/sh

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@5af68cbff09ce979df3dff91e398e287eadd48b7:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.

TEST_ID=rumiai-os/bootstrap/semantic-roots-export.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok() {
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
    esac
    return 1
}
rumiai_test_target_rumiai_os_validate() {
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1
    printf '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find() {
    start=$1
    rumiai_test_target_have git || return 3
    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then
        rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi
    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :; do
        if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
        [ "$candidate" != / ] || break
        parent=${candidate%/*}; [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done
    return 1
}

resolve_test_dir() {
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(rumiai_test_target_rumiai_os_find "$start")
status=$?
case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac

entry=$root/rumiai-os
[ -x "$entry" ] || fail 'rumiai-os entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-bootstrap-semantic-roots-export-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
probe=$tmp/probe
transcript=$tmp/transcript

cat > "$probe" <<'EOT'
command -p sh -c '
[ "${m_ROOT-}" = "$EXPECTED_ROOT" ] || exit 41
[ "${m_BOOTSTRAP_BIN-}" = "$EXPECTED_BOOTSTRAP_BIN" ] || exit 42
[ "${m_BIN_DIR-}" = "$EXPECTED_BIN_DIR" ] || exit 43
[ "${m_LIB_DIR-}" = "$EXPECTED_LIB_DIR" ] || exit 44
[ "${m_PKG_DIR-}" = "$EXPECTED_PKG_DIR" ] || exit 45
[ "${m_LANG_DIR-}" = "$EXPECTED_LANG_DIR" ] || exit 46
[ "${m_SRC_DIR-}" = "$EXPECTED_SRC_DIR" ] || exit 47
[ "${m_CONF_DIR-}" = "$EXPECTED_CONF_DIR" ] || exit 48
[ "${m_DATA_DIR-}" = "$EXPECTED_DATA_DIR" ] || exit 49
[ "${m_HOME_DIR-}" = "$EXPECTED_HOME_DIR" ] || exit 50
[ "${m_CACHE_DIR-}" = "$EXPECTED_CACHE_DIR" ] || exit 51
[ "${m_LOG_DIR-}" = "$EXPECTED_LOG_DIR" ] || exit 52
[ "${m_RUN_DIR-}" = "$EXPECTED_RUN_DIR" ] || exit 53
[ "${m_TMP_DIR-}" = "$EXPECTED_TMP_DIR" ] || exit 54
[ "${m_VAR_DIR+x}" != x ] || exit 55
' || return $?
return 0
EOT

EXPECTED_ROOT="$root"
EXPECTED_BOOTSTRAP_BIN="$entry"
EXPECTED_BIN_DIR="$root/bin"
EXPECTED_LIB_DIR="$root/lib"
EXPECTED_PKG_DIR="$root/pkg"
EXPECTED_LANG_DIR="$root/lang"
EXPECTED_SRC_DIR="$root/src"
EXPECTED_CONF_DIR="$root/conf"
EXPECTED_DATA_DIR="$root/data"
EXPECTED_HOME_DIR="$root/home"
EXPECTED_CACHE_DIR="$root/cache"
EXPECTED_LOG_DIR="$root/log"
EXPECTED_RUN_DIR="$root/run"
EXPECTED_TMP_DIR="$root/tmp"
export EXPECTED_ROOT EXPECTED_BOOTSTRAP_BIN EXPECTED_BIN_DIR EXPECTED_LIB_DIR EXPECTED_PKG_DIR EXPECTED_LANG_DIR EXPECTED_SRC_DIR EXPECTED_CONF_DIR EXPECTED_DATA_DIR EXPECTED_HOME_DIR EXPECTED_CACHE_DIR EXPECTED_LOG_DIR EXPECTED_RUN_DIR EXPECTED_TMP_DIR

(
    unset LC_ALL LC_MESSAGES m_VAR_DIR
    LANG=C
    export LANG
    "$entry" "$probe"
) >"$transcript" 2>&1 || {
    status=$?
    cat "$transcript" >&2
    fail "semantic roots export probe returned $status"
}

[ ! -s "$transcript" ] || {
    cat "$transcript" >&2
    fail 'semantic roots export probe produced unexpected output'
}

exit 0
