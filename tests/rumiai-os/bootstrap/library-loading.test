#!/bin/sh
# Protects: BOOT-10, BOOT-11, BOOT-12, BOOT-13, BOOT-14, LIB-11, LIB-12, LIB-13, LIB-15, LIB-16, LIB-17, LIB-18, PKG-30.

TEST_ID=rumiai-os/bootstrap/library-loading.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
bootstrap_group=${test_dir%/*}
rumiai_os_group=${bootstrap_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

tmp=${TMPDIR:-/tmp}/rumiai-library-loading-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

awk '
  /^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*\(\)[[:space:]]*$/ {
    name=$0
    sub(/\(\)[[:space:]]*$/, "", name)
    print name
  }
' "$root/m" > "$tmp/bootstrap-functions" ||
  error 'cannot inspect bootstrap function surface'

cat > "$tmp/bootstrap-functions.expected" <<'EOF_BOOTSTRAP_FUNCTIONS'
readpathce
export_readonly
EOF_BOOTSTRAP_FUNCTIONS

cmp -s "$tmp/bootstrap-functions.expected" "$tmp/bootstrap-functions" || {
  printf '%s\n' 'expected bootstrap functions:' >&2
  cat "$tmp/bootstrap-functions.expected" >&2
  printf '%s\n' 'observed bootstrap functions:' >&2
  cat "$tmp/bootstrap-functions" >&2
  fail 'root m bootstrap function surface is not minimal'
}

awk '
  $0 == ". \"$m_LIB_DIR/sys/sh/core.lib.sh\"" { count++ }
  END { exit count == 1 ? 0 : 1 }
' "$root/m" ||
  fail 'root m bootstrap must directly source core.lib.sh exactly once'

grep -F 'pkg/pkg-provider' "$root/m" >/dev/null 2>&1 &&
  fail 'root m bootstrap must not own pkg provider initialization'

grep -F 'pkg_provider_global_environment_apply' "$root/m" >/dev/null 2>&1 &&
  fail 'root m bootstrap must not apply pkg provider environment'

core_library="$root/lib/sys/sh/core.lib.sh"
[ -f "$core_library" ] || error 'core library is unavailable'

base_library="$root/lib/sys/sh/base.lib.sh"
[ -f "$base_library" ] || error 'base library is unavailable'

grep -F 'loadlib "sys/sh/base"' "$core_library" >/dev/null 2>&1 ||
  fail 'core must load the common base through loadlib'

grep -F 'loadsyslib()' "$core_library" >/dev/null 2>&1 &&
  fail 'core must not define loadsyslib'

grep -F 'loadsyslib()' "$base_library" >/dev/null 2>&1 ||
  fail 'base must define loadsyslib'

grep -F 'loadsyslib "pkg/pkg-provider"' "$core_library" >/dev/null 2>&1 &&
  fail 'core must not initialize pkg defaults'

grep -F 'pkg_provider_global_environment_apply' "$core_library" >/dev/null 2>&1 &&
  fail 'core must not apply pkg default environment'

grep -F 'loadsyslib "pkg/pkg-provider"' "$base_library" >/dev/null 2>&1 &&
  fail 'base must not initialize pkg defaults'

grep -F 'pkg_provider_global_environment_apply' "$base_library" >/dev/null 2>&1 &&
  fail 'base must not apply pkg default environment'

probe_name=rumiai-loadlib-probe-$$
probe=$tmp/$probe_name
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m

loadsyslib >/dev/null 2>&1
printf 'loadsyslib-zero=%s\n' "$?"

loadsyslib array extra >/dev/null 2>&1
printf 'loadsyslib-extra=%s\n' "$?"

loadsyslib does-not-exist >/dev/null 2>&1
printf 'loadsyslib-missing=%s\n' "$?"

loadsyslib array >/dev/null 2>&1
printf 'loadsyslib-array=%s\n' "$?"
command -v array >/dev/null 2>&1
printf 'array-function=%s\n' "$?"

loadlib sys/sh/map >/dev/null 2>&1
printf 'loadlib-map=%s\n' "$?"
command -v map >/dev/null 2>&1
printf 'map-function=%s\n' "$?"

loadsyslib pkg/facility/pkg-facility >/dev/null 2>&1
printf 'loadsyslib-grouped=%s\n' "$?"
command -v pkg_facility_contract_validate >/dev/null 2>&1
printf 'grouped-function=%s\n' "$?"
EOF_PROBE
chmod 700 "$probe" || error 'cannot make loader probe executable'

PATH="$tmp:$PATH" "$root/m" "$probe_name" > "$tmp/probe.out" 2> "$tmp/probe.err"
probe_status=$?
[ "$probe_status" -eq 0 ] || {
  cat "$tmp/probe.err" >&2
  fail "loader probe failed with status $probe_status"
}

cat > "$tmp/probe.expected" <<'EOF_EXPECTED'
loadsyslib-zero=1
loadsyslib-extra=1
loadsyslib-missing=2
loadsyslib-array=0
array-function=0
loadlib-map=0
map-function=0
loadsyslib-grouped=0
grouped-function=0
EOF_EXPECTED

cmp -s "$tmp/probe.expected" "$tmp/probe.out" || {
  printf '%s\n' 'expected loader probe output:' >&2
  cat "$tmp/probe.expected" >&2
  printf '%s\n' 'observed loader probe output:' >&2
  cat "$tmp/probe.out" >&2
  fail 'loadlib/loadsyslib behavior does not match the contract'
}

inject_command=$tmp/inject-command
cat > "$inject_command" <<'EOF_INJECT_COMMAND'
loadsyslib "array" || exit "$?"

command -v array >/dev/null 2>&1 || exit 9

printf 'argc=%s\n' "$#"
printf 'argv='
quote "$@" || exit "$?"
printf '\n'
EOF_INJECT_COMMAND

standalone_command=$tmp/inject-standalone-command
cat > "$standalone_command" <<'EOF_STANDALONE_COMMAND'
[ "$#" -eq 2 ] || exit 8
[ "$1" = "alpha beta" ] || exit 8
[ -z "$2" ] || exit 8
printf '%s\n' 'standalone-command-ok'
EOF_STANDALONE_COMMAND

named_command=$tmp/inject-named-command
cat > "$named_command" <<'EOF_NAMED_COMMAND'
printf 'named-argc=%s\n' "$#"
printf 'named-arg1=%s\n' "$1"
RUMIAI_NAMED_LEAK=1
cd "$RUMIAI_ALT_DIR" || exit 30
umask 027
exit 7
EOF_NAMED_COMMAND

isolated_command=$tmp/inject-isolated-command
cat > "$isolated_command" <<'EOF_ISOLATED_COMMAND'
command -v array >/dev/null 2>&1 || exit 31
command -v named_probe >/dev/null 2>&1 || exit 32
printf 'one-shot-argc=%s\n' "$#"
printf 'one-shot-arg1=%s\n' "$1"
named_probe "from one-shot"
printf 'named-status=%s\n' "$?"
oneshot_private()
{
  :
}
RUMIAI_ONESHOT_LEAK=1
cd "$RUMIAI_ALT_DIR" || exit 33
umask 022
trap 'printf "%s\n" "one-shot-trap"' 0
exit 6
EOF_ISOLATED_COMMAND

generator_name=rumiai-loadlib-inject-stream-probe
generator=$tmp/$generator_name
cat > "$generator" <<'EOF_GENERATOR'
#!/usr/bin/env m

loadsyslib "loadlib-inject-stream" || exit "$?"

case "$1" in
  complete)
    loadlib_inject_stream base array -- "$RUMIAI_INJECT_COMMAND" "alpha beta" "" gamma
    ;;
  isolated)
    loadlib_inject_stream \
      base \
      --command named_probe "$RUMIAI_NAMED_COMMAND" \
      array \
      -- "$RUMIAI_ISOLATED_COMMAND" "alpha beta"
    ;;
  missing-dependency)
    loadlib_inject_stream base -- "$RUMIAI_INJECT_COMMAND" "alpha beta" "" gamma
    ;;
  library-only)
    loadlib_inject_stream base array
    ;;
  zero-library)
    loadlib_inject_stream
    ;;
  command-only)
    loadlib_inject_stream -- "$RUMIAI_STANDALONE_COMMAND" "alpha beta" ""
    ;;
  separator-without-command)
    loadlib_inject_stream base --
    ;;
  named-missing-operands)
    loadlib_inject_stream base --command named_probe
    ;;
  named-invalid-name)
    loadlib_inject_stream base --command bad-name "$RUMIAI_NAMED_COMMAND"
    ;;
  named-duplicate)
    loadlib_inject_stream \
      --command named_probe "$RUMIAI_NAMED_COMMAND" \
      --command named_probe "$RUMIAI_NAMED_COMMAND"
    ;;
  named-reserved-loadlib)
    loadlib_inject_stream --command loadlib "$RUMIAI_NAMED_COMMAND"
    ;;
  named-reserved-internal)
    loadlib_inject_stream --command _loadlib_inject_stream_probe "$RUMIAI_NAMED_COMMAND"
    ;;
  named-missing-source)
    loadlib_inject_stream --command named_probe "$RUMIAI_MISSING_COMMAND"
    ;;
  missing-library)
    loadlib_inject_stream base does-not-exist
    ;;
  *)
    exit 99
    ;;
esac
EOF_GENERATOR
chmod 700 "$generator" || error 'cannot make injection generator probe executable'

RUMIAI_INJECT_COMMAND=$inject_command
RUMIAI_STANDALONE_COMMAND=$standalone_command
RUMIAI_NAMED_COMMAND=$named_command
RUMIAI_ISOLATED_COMMAND=$isolated_command
RUMIAI_MISSING_COMMAND=$tmp/does-not-exist-command
RUMIAI_ALT_DIR=$tmp/isolated-cwd
command -p -- mkdir "$RUMIAI_ALT_DIR" || error 'cannot create isolated-command alternate directory'
export \
  RUMIAI_INJECT_COMMAND \
  RUMIAI_STANDALONE_COMMAND \
  RUMIAI_NAMED_COMMAND \
  RUMIAI_ISOLATED_COMMAND \
  RUMIAI_MISSING_COMMAND \
  RUMIAI_ALT_DIR

PATH="$tmp:$PATH" "$root/m" "$generator_name" complete > "$tmp/inject.stream" 2> "$tmp/inject-generate.err"
inject_generate_status=$?
[ "$inject_generate_status" -eq 0 ] || {
  cat "$tmp/inject-generate.err" >&2
  fail "injection stream generation failed with status $inject_generate_status"
}

sh -n "$tmp/inject.stream" || fail 'generated injection stream is not valid POSIX-sh syntax'

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh "$tmp/inject.stream" > "$tmp/inject.out" 2> "$tmp/inject.err"
inject_status=$?
[ "$inject_status" -eq 0 ] || {
  cat "$tmp/inject.err" >&2
  fail "generated injection stream execution failed with status $inject_status"
}

cat > "$tmp/inject.expected" <<'EOF_INJECT_EXPECTED'
argc=3
argv='alpha beta' '' 'gamma'
EOF_INJECT_EXPECTED

cmp -s "$tmp/inject.expected" "$tmp/inject.out" || {
  printf '%s\n' 'expected injection stream output:' >&2
  cat "$tmp/inject.expected" >&2
  printf '%s\n' 'observed injection stream output:' >&2
  cat "$tmp/inject.out" >&2
  fail 'generated injection stream did not preserve command argv'
}

cat > "$tmp/inject-stdin-source" <<'EOF_INJECT_STDIN_SOURCE'
command -v array >/dev/null 2>&1 || exit 14
printf 'stdin-argc=%s\n' "$#"
printf 'stdin-source-ok\n'
EOF_INJECT_STDIN_SOURCE

cat "$tmp/inject-stdin-source" |
  PATH="$tmp:$PATH" "$root/m" "$generator_name" complete > "$tmp/inject-with-stdin.stream" 2> "$tmp/inject-with-stdin-generate.err"
inject_with_stdin_generate_status=$?
[ "$inject_with_stdin_generate_status" -eq 0 ] || {
  cat "$tmp/inject-with-stdin-generate.err" >&2
  fail "stdin-source injection generation failed with status $inject_with_stdin_generate_status"
}

sh -n "$tmp/inject-with-stdin.stream" ||
  fail 'generated command+stdin injection stream is not valid POSIX-sh syntax'

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh "$tmp/inject-with-stdin.stream" > "$tmp/inject-with-stdin.out" 2> "$tmp/inject-with-stdin.err"
inject_with_stdin_status=$?
[ "$inject_with_stdin_status" -eq 0 ] || {
  cat "$tmp/inject-with-stdin.err" >&2
  fail "generated command+stdin injection stream execution failed with status $inject_with_stdin_status"
}

cat > "$tmp/inject-with-stdin.expected" <<'EOF_INJECT_WITH_STDIN_EXPECTED'
argc=3
argv='alpha beta' '' 'gamma'
stdin-argc=0
stdin-source-ok
EOF_INJECT_WITH_STDIN_EXPECTED

cmp -s "$tmp/inject-with-stdin.expected" "$tmp/inject-with-stdin.out" || {
  printf '%s\n' 'expected command+stdin injection output:' >&2
  cat "$tmp/inject-with-stdin.expected" >&2
  printf '%s\n' 'observed command+stdin injection output:' >&2
  cat "$tmp/inject-with-stdin.out" >&2
  fail 'one-shot command positional parameters leaked into continuation source'
}

cat > "$tmp/isolated-stdin-source" <<'EOF_ISOLATED_STDIN'
printf 'one-shot-status=%s\n' "$?"
[ "$#" -eq 0 ] || exit 40
[ "${RUMIAI_ONESHOT_LEAK+x}" != x ] || exit 41
[ "${RUMIAI_NAMED_LEAK+x}" != x ] || exit 42
command -v oneshot_private >/dev/null 2>&1 && exit 43
[ "$(command -p -- pwd -P)" = "$RUMIAI_EXPECT_PWD" ] || exit 44
[ "$(umask)" = "$RUMIAI_EXPECT_UMASK" ] || exit 45
printf '%s\n' 'state-clean'
named_probe "from stdin"
printf 'stdin-named-status=%s\n' "$?"
printf '%s\n' 'isolated-stdin-ok'
EOF_ISOLATED_STDIN

RUMIAI_EXPECT_PWD="$(command -p -- pwd -P)" || error 'cannot capture expected working directory'
RUMIAI_EXPECT_UMASK="$(umask)"
export RUMIAI_EXPECT_PWD RUMIAI_EXPECT_UMASK

cat "$tmp/isolated-stdin-source" |
  PATH="$tmp:$PATH" "$root/m" "$generator_name" isolated > "$tmp/isolated.stream" 2> "$tmp/isolated-generate.err"
isolated_generate_status=$?
[ "$isolated_generate_status" -eq 0 ] || {
  cat "$tmp/isolated-generate.err" >&2
  fail "isolated command stream generation failed with status $isolated_generate_status"
}

sh -n "$tmp/isolated.stream" ||
  fail 'isolated command generated stream is not valid POSIX-sh syntax'

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" \
  RUMIAI_ALT_DIR="$RUMIAI_ALT_DIR" \
  RUMIAI_EXPECT_PWD="$RUMIAI_EXPECT_PWD" \
  RUMIAI_EXPECT_UMASK="$RUMIAI_EXPECT_UMASK" \
  sh "$tmp/isolated.stream" > "$tmp/isolated.out" 2> "$tmp/isolated.err"
isolated_status=$?
[ "$isolated_status" -eq 0 ] || {
  cat "$tmp/isolated.err" >&2
  fail "isolated command generated stream failed with status $isolated_status"
}

cat > "$tmp/isolated.expected" <<'EOF_ISOLATED_EXPECTED'
one-shot-argc=1
one-shot-arg1=alpha beta
named-argc=1
named-arg1=from one-shot
named-status=7
one-shot-trap
one-shot-status=6
state-clean
named-argc=1
named-arg1=from stdin
stdin-named-status=7
isolated-stdin-ok
EOF_ISOLATED_EXPECTED

cmp -s "$tmp/isolated.expected" "$tmp/isolated.out" || {
  printf '%s\n' 'expected isolated-command output:' >&2
  cat "$tmp/isolated.expected" >&2
  printf '%s\n' 'observed isolated-command output:' >&2
  cat "$tmp/isolated.out" >&2
  fail 'named/one-shot command subshell isolation does not match the contract'
}

PATH="$tmp:$PATH" "$root/m" "$generator_name" missing-dependency > "$tmp/inject-missing.stream" 2> "$tmp/inject-missing-generate.err"
missing_generate_status=$?
[ "$missing_generate_status" -eq 0 ] || {
  cat "$tmp/inject-missing-generate.err" >&2
  fail "explicit incomplete library set was not generated: status $missing_generate_status"
}

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh "$tmp/inject-missing.stream" > "$tmp/inject-missing.out" 2> "$tmp/inject-missing.err"
missing_status=$?
[ "$missing_status" -eq 2 ] || {
  cat "$tmp/inject-missing.err" >&2
  fail "non-embedded runtime library did not fail with status 2: observed $missing_status"
}

PATH="$tmp:$PATH" "$root/m" "$generator_name" library-only > "$tmp/inject-library-only.stream" 2> "$tmp/inject-library-only-generate.err"
library_only_generate_status=$?
[ "$library_only_generate_status" -eq 0 ] || {
  cat "$tmp/inject-library-only-generate.err" >&2
  fail "library-only stream generation failed with status $library_only_generate_status"
}

sh -n "$tmp/inject-library-only.stream" ||
  fail 'library-only generated stream is not valid POSIX-sh syntax'

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh -c '
  stream=$1
  set -- keep ""
  . "$stream" || exit "$?"
  command -v loadsyslib >/dev/null 2>&1 || exit 9
  command -v array >/dev/null 2>&1 || exit 10
  [ "$#" -eq 2 ] || exit 11
  [ "$1" = "keep" ] || exit 12
  [ -z "$2" ] || exit 13
' sh "$tmp/inject-library-only.stream"
library_only_status=$?
[ "$library_only_status" -eq 0 ] ||
  fail "library-only stream failed or changed positional parameters: status $library_only_status"

PATH="$tmp:$PATH" "$root/m" "$generator_name" zero-library > "$tmp/inject-zero-library.stream" 2> "$tmp/inject-zero-library-generate.err"
zero_library_generate_status=$?
[ "$zero_library_generate_status" -eq 0 ] || {
  cat "$tmp/inject-zero-library-generate.err" >&2
  fail "zero-library stream generation failed with status $zero_library_generate_status"
}

sh -n "$tmp/inject-zero-library.stream" ||
  fail 'zero-library generated stream is not valid POSIX-sh syntax'

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh -c '
  . "$1" || exit "$?"
  loadlib "sys/sh/base" >/dev/null 2>&1
  [ "$?" -eq 2 ]
' sh "$tmp/inject-zero-library.stream"
zero_library_status=$?
[ "$zero_library_status" -eq 0 ] ||
  fail "zero-library stream did not install the empty injected loader: status $zero_library_status"

PATH="$tmp:$PATH" "$root/m" "$generator_name" command-only > "$tmp/inject-command-only.stream" 2> "$tmp/inject-command-only-generate.err"
command_only_generate_status=$?
[ "$command_only_generate_status" -eq 0 ] || {
  cat "$tmp/inject-command-only-generate.err" >&2
  fail "command-only stream generation failed with status $command_only_generate_status"
}

m_LIB_DIR="$tmp/nonexistent-remote-lib-root" sh "$tmp/inject-command-only.stream" > "$tmp/inject-command-only.out" 2> "$tmp/inject-command-only.err"
command_only_status=$?
[ "$command_only_status" -eq 0 ] || {
  cat "$tmp/inject-command-only.err" >&2
  fail "command-only stream execution failed with status $command_only_status"
}

grep -Fx 'standalone-command-ok' "$tmp/inject-command-only.out" >/dev/null 2>&1 ||
  fail 'command-only stream did not execute the command source with preserved argv'

for invalid_case in \
  separator-without-command \
  named-missing-operands \
  named-invalid-name \
  named-duplicate \
  named-reserved-loadlib \
  named-reserved-internal
do
  PATH="$tmp:$PATH" "$root/m" "$generator_name" "$invalid_case" > "$tmp/$invalid_case.out" 2> "$tmp/$invalid_case.err"
  invalid_status=$?
  [ "$invalid_status" -eq 1 ] ||
    fail "$invalid_case returned $invalid_status instead of 1"
done

PATH="$tmp:$PATH" "$root/m" "$generator_name" named-missing-source > "$tmp/named-missing-source.out" 2> "$tmp/named-missing-source.err"
named_missing_source_status=$?
[ "$named_missing_source_status" -eq 2 ] ||
  fail "named command with unavailable source returned $named_missing_source_status instead of 2"

PATH="$tmp:$PATH" "$root/m" "$generator_name" missing-library > "$tmp/inject-missing-library.out" 2> "$tmp/inject-missing-library.err"
missing_library_status=$?
[ "$missing_library_status" -eq 2 ] ||
  fail "generator with unavailable selected library returned $missing_library_status instead of 2"

: > "$tmp/direct-imports"

scan_file()
{
  scan_allow_bootstrap_core=${2-}

  awk -v allow_bootstrap_core="$scan_allow_bootstrap_core" '
    /^[[:space:]]*\.[[:space:]]+/ && /\$m_LIB_DIR\/sys\/sh\// {
      if (allow_bootstrap_core == "yes" &&
          $0 == ". \"$m_LIB_DIR/sys/sh/core.lib.sh\"")
        next

      print FNR ":" $0
      found=1
    }
    END { exit found ? 0 : 1 }
  ' "$1" > "$tmp/matches" 2>/dev/null || return 0

  while IFS= read -r match
  do
    printf '%s:%s\n' "$1" "$match" >> "$tmp/direct-imports"
  done < "$tmp/matches"
}

[ -f "$root/m" ] && scan_file "$root/m" yes

for file in "$root/rumiai-os" "$root/rumiai-os-sh"
do
  [ -f "$file" ] && scan_file "$file"
done

for dir in "$root/bin/sys" "$root/bin/ai" "$root/lib/sys/sh" "$root/lib/ai/sh"
do
  [ -d "$dir" ] || continue
  find "$dir" -type f -print | while IFS= read -r file
  do
    scan_file "$file"
  done
done

if [ -s "$tmp/direct-imports" ]
then
  cat "$tmp/direct-imports" >&2
  fail 'owned system shell libraries are still dot-sourced directly'
fi

exit 0
