#!/bin/sh

TEST_ID=rumiai-os/bootstrap/system-profile-selector.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

restore_selector()
{
  [ "${selector_modified-0}" -eq 1 ] || return 0
  rm -f "$selector_dir/current" 2>/dev/null || :
  ln -s "$original_target" "$selector_dir/current" 2>/dev/null || return 1
  selector_modified=0
}

cleanup()
{
  trap - 0 HUP INT TERM
  restore_selector || :
  [ -z "${alternate_profile-}" ] || rmdir "$alternate_profile" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

set_selector()
{
  target=$1
  rm -f "$selector_dir/current" || return 1
  selector_modified=1
  [ "$target" = absent ] && return 0
  ln -s "$target" "$selector_dir/current"
}

probe_semantic_paths()
{
  label=$1
  output=$("$root/m" "$probe" 2> "$tmp/$label.err") || {
    cat "$tmp/$label.err" >&2
    fail "$label did not boot"
  }
  state=$(printf '%s\n' "$output" | sed -n '1p')
  run=$(printf '%s\n' "$output" | sed -n '2p')
  scratch=$(printf '%s\n' "$output" | sed -n '3p')

  [ "$state" = "$selector_dir/current" ] ||
    fail "$label exported unexpected m_STATE_SYS_DIR: $state"
  [ "$run" = "$selector_dir/current/sys/selector-test/run" ] ||
    fail "$label resolved unexpected run path: $run"
  [ "$scratch" = "$selector_dir/current/sys/selector-test/tmp" ] ||
    fail "$label resolved unexpected tmp path: $scratch"
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target helper'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

selector_dir=$root/state/system
[ -d "$selector_dir/profile" ] && [ ! -L "$selector_dir/profile" ] ||
  fail 'system profile root is unavailable'
[ -L "$selector_dir/current" ] || fail 'initial system/current is not a symlink'
original_target=$(readlink "$selector_dir/current") ||
  error 'cannot read initial system selector'
case $original_target in
  profile/*) :;;
  *) fail "initial system selector is not profile-relative: $original_target";;
esac

tmp=${TMPDIR:-/tmp}/rumiai-system-profile-selector-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

alternate_name=selector-test-$$
alternate_profile=$selector_dir/profile/$alternate_name
[ ! -e "$alternate_profile" ] && [ ! -L "$alternate_profile" ] ||
  error 'temporary alternate profile already exists'
mkdir "$alternate_profile" || error 'cannot create temporary alternate profile'

probe=$tmp/probe
cat > "$probe" <<'EOF_PROBE'
printf '%s\n' "$m_STATE_SYS_DIR"
state-path system sys selector-test run
state-path system sys selector-test tmp
EOF_PROBE

selector_modified=0
probe_semantic_paths initial

set_selector absent || error 'cannot stage absent selector'
probe_semantic_paths absent

set_selector profile/missing-selector-test || error 'cannot stage broken selector'
probe_semantic_paths broken

set_selector "$selector_dir/profile/$alternate_name" ||
  error 'cannot stage absolute selector'
probe_semantic_paths absolute

set_selector "profile/$alternate_name" ||
  error 'cannot select temporary alternate profile'
probe_semantic_paths alternate

restore_selector || error 'cannot restore original system selector'
[ "$(readlink "$selector_dir/current")" = "$original_target" ] ||
  fail 'original system selector was not restored'
probe_semantic_paths restored

exit 0
