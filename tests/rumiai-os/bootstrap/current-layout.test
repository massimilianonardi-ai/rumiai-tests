#!/bin/sh

TEST_ID=rumiai-os/bootstrap/current-layout.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
bootstrap_group=${test_dir%/*}
rumiai_os_group=${bootstrap_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'technical m entrypoint is missing or not executable'
[ -x "$root/rumiai-os" ] || fail 'rumiai-os branded entrypoint is missing or not executable'
[ -x "$root/rumiai-os-sh" ] || fail 'rumiai-os-sh branded entrypoint is missing or not executable'

[ -L "$root/bin/sys/m" ] || fail 'bin/sys/m is not a symlink'
[ "$(readlink "$root/bin/sys/m")" = '../../m' ] || fail 'bin/sys/m target is not ../../m'

for dir in \
  "$root/bin/sys" \
  "$root/lib/sys/sh" \
  "$root/lib/sys/js" \
  "$root/lib/sys/sh/pkg" \
  "$root/lib/sys/sh/pkg/facility" \
  "$root/lib/sys/sh/pkg/repository"
do
  [ -d "$dir" ] && [ ! -L "$dir" ] || fail "required current directory is missing or not a real directory: $dir"
done

[ -f "$root/lib/sys/js/mk.lib.js" ] && [ ! -L "$root/lib/sys/js/mk.lib.js" ] ||
  fail 'mk JavaScript lifecycle library is missing'
[ ! -x "$root/lib/sys/js/mk.lib.js" ] || fail 'mk JavaScript lifecycle library must not be executable'

[ -f "$root/product-name" ] && [ ! -L "$root/product-name" ] || fail 'product-name scalar is missing'
[ -f "$root/product-version" ] && [ ! -L "$root/product-version" ] || fail 'product-version scalar is missing'
[ "$(cat "$root/product-name")" = RumiAI ] || fail 'product-name is not RumiAI'
[ "$(wc -l < "$root/product-name" | tr -d ' ')" -eq 1 ] || fail 'product-name is not a one-line scalar'
[ "$(wc -l < "$root/product-version" | tr -d ' ')" -eq 1 ] || fail 'product-version is not a one-line scalar'
case $(cat "$root/product-version") in
  2.*) :;;
  *) fail 'product-version is outside the current Model 2.x release lineage';;
esac

exit 0
