#!/bin/sh

TEST_ID=rumiai-os/bootstrap/semantic-roots.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir() {
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

entry=$root/m
[ -x "$entry" ] || fail 'm entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-bootstrap-semantic-roots-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
probe=$tmp/probe
transcript=$tmp/transcript

cat > "$probe" <<'EOT'
#!/usr/bin/env m
[ "${m_ROOT-}" = "$EXPECTED_ROOT" ] || return 41
[ "${m_BOOTSTRAP_BIN-}" = "$EXPECTED_BOOTSTRAP_BIN" ] || return 42
[ "${m_BIN_DIR-}" = "$EXPECTED_BIN_DIR" ] || return 43
[ "${m_LIB_DIR-}" = "$EXPECTED_LIB_DIR" ] || return 44
[ "${m_PKG_DIR-}" = "$EXPECTED_PKG_DIR" ] || return 45
[ "${m_RES_DIR-}" = "$EXPECTED_RES_DIR" ] || return 46
[ "${m_LANG_DIR-}" = "$EXPECTED_LANG_DIR" ] || return 47
[ "${m_SRC_DIR-}" = "$EXPECTED_SRC_DIR" ] || return 48
[ "${m_STATE_DIR-}" = "$EXPECTED_STATE_DIR" ] || return 49
[ "${m_STATE_SYS_DIR-}" = "$EXPECTED_STATE_SYS_DIR" ] || return 50
[ "${m_STATE_USER_DIR-}" = "$EXPECTED_STATE_USER_DIR" ] || return 51
for legacy in m_CONF_DIR m_DATA_DIR m_HOME_DIR m_CACHE_DIR m_LOG_DIR m_RUN_DIR m_TMP_DIR m_VAR_DIR
do
    eval "present=\${$legacy+x}"
    [ "$present" != x ] || return 52
done
return 0
EOT
chmod 700 "$probe" || error 'cannot make probe executable'

EXPECTED_ROOT=$root
EXPECTED_BOOTSTRAP_BIN=$entry
EXPECTED_BIN_DIR=$root/bin
EXPECTED_LIB_DIR=$root/lib
EXPECTED_PKG_DIR=$root/pkg
EXPECTED_RES_DIR=$root/res
EXPECTED_LANG_DIR=$root/res/sys/lang
EXPECTED_SRC_DIR=$root/src
EXPECTED_STATE_DIR=$root/state
EXPECTED_STATE_SYS_DIR=$root/state/system/current
EXPECTED_STATE_USER_DIR=$root/state/user/current
export EXPECTED_ROOT EXPECTED_BOOTSTRAP_BIN EXPECTED_BIN_DIR EXPECTED_LIB_DIR EXPECTED_PKG_DIR EXPECTED_RES_DIR EXPECTED_LANG_DIR EXPECTED_SRC_DIR EXPECTED_STATE_DIR EXPECTED_STATE_SYS_DIR EXPECTED_STATE_USER_DIR

(
    unset LC_ALL LC_MESSAGES m_CONF_DIR m_DATA_DIR m_HOME_DIR m_CACHE_DIR m_LOG_DIR m_RUN_DIR m_TMP_DIR m_VAR_DIR
    LANG=C
    export LANG
    "$entry" "$probe"
) >"$transcript" 2>&1 || {
    status=$?
    cat "$transcript" >&2
    fail "semantic roots probe returned $status"
}

[ ! -s "$transcript" ] || { cat "$transcript" >&2; fail 'semantic roots probe produced unexpected output'; }
exit 0
