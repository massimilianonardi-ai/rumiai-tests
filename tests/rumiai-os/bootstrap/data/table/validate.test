#!/bin/sh

TEST_ID=rumiai-os/bootstrap/data/table/validate.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@5af68cbff09ce979df3dff91e398e287eadd48b7:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.

rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok() {
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
    esac
    return 1
}
rumiai_test_target_rumiai_os_validate() {
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1
    printf '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find() {
    start=$1
    rumiai_test_target_have git || return 3
    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then
        rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi
    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :; do
        if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
        [ "$candidate" != / ] || break
        parent=${candidate%/*}; [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done
    return 1
}

resolve_test_dir() {
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
capability_group=${test_dir%/*}
data_group=${capability_group%/*}
bootstrap_group=${data_group%/*}
rumiai_os_group=${bootstrap_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

entry=$root/rumiai-os
[ -x "$entry" ] || fail 'rumiai-os entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-data-rumiai-os-bootstrap-data-table-validate-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

valid=$tmp/valid.tsv
wrong_header=$tmp/wrong-header.tsv
duplicate_header=$tmp/duplicate-header.tsv
wrong_columns=$tmp/wrong-columns.tsv

printf 'type\tmode\tdigest\ttarget\tpath\nD\t0500\t-\t-\t.\nF\t0500\tabc\t-\t./bin/foo\nL\t-\tdef\t../run/log\t./log\n' > "$valid" || error 'cannot create valid table'
printf 'mode\ttype\tdigest\ttarget\tpath\nD\t0500\t-\t-\t.\n' > "$wrong_header" || error 'cannot create wrong-header table'
printf 'type\tmode\tdigest\tpath\tpath\nD\t0500\t-\t-\t.\n' > "$duplicate_header" || error 'cannot create duplicate-header table'
printf 'type\tmode\tdigest\ttarget\tpath\nD\t0500\t-\t-\n' > "$wrong_columns" || error 'cannot create wrong-columns table'

probe=$tmp/probe
transcript=$tmp/transcript
cat > "$probe" <<'EOT'
rumi_table_validate "$VALID" type mode digest target path || return 41

rumi_table_validate "$WRONG_HEADER" type mode digest target path >/dev/null 2>&1
[ "$?" -eq 2 ] || return 42

rumi_table_validate "$DUPLICATE_HEADER" >/dev/null 2>&1
[ "$?" -eq 2 ] || return 43

rumi_table_validate "$WRONG_COLUMNS" type mode digest target path >/dev/null 2>&1
[ "$?" -eq 2 ] || return 44

return 0
EOT

VALID=$valid; export VALID
WRONG_HEADER=$wrong_header; export WRONG_HEADER
DUPLICATE_HEADER=$duplicate_header; export DUPLICATE_HEADER
WRONG_COLUMNS=$wrong_columns; export WRONG_COLUMNS

(
    unset LC_ALL LC_MESSAGES
    LANG=C
    RumiAI_LOG_LEVEL=off
    export LANG RumiAI_LOG_LEVEL
    "$entry" "$probe"
) >"$transcript" 2>&1
status=$?

[ "$status" -eq 0 ] || {
    cat "$transcript" >&2
    fail "target probe returned status $status"
}

exit 0
