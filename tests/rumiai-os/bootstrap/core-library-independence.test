#!/bin/sh

TEST_ID="rumiai-os/bootstrap/core-library-independence.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self="$0"
    case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
    self_dir="${self%/*}"
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"
target_lib="$suite_root/lib/rumiai-os-target.lib"
fixture_lib="$suite_root/lib/rumiai-os-fixture.lib"

[ -r "$target_lib" ] || error "rumiai-os target discovery library is unavailable"
[ -r "$fixture_lib" ] || error "rumiai-os fixture library is unavailable"
. "$target_lib" || error "cannot load rumiai-os target discovery library"
. "$fixture_lib" || error "cannot load rumiai-os fixture library"

source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
    0) : ;;
    1) skip "rumiai-os target checkout not found" ;;
    2) fail "invalid explicit rumiai-os target" ;;
    *) error "target discovery failed" ;;
esac

tmp="${TMPDIR:-/tmp}/rumiai-bootstrap-core-library-independence-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"
status="$?"
case "$status" in
    0) : ;;
    1) fail "source checkout lacks required runtime material" ;;
    2) error "cannot materialize isolated fixture" ;;
    *) error "fixture primitive returned unexpected status $status" ;;
esac
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

core_lib="$fixture/lib/sys/sh/core.lib.sh"
command -p -- rm -f "$core_lib" || error "cannot replace fixture core library"
cat > "$core_lib" <<'EOF_CORE' || error "cannot create poisoned core library"
printf -- '%s\n' 'core-library-loaded' >&2
exit 97
EOF_CORE

probe="$tmp/probe"
cat > "$probe" <<'EOF_PROBE' || error "cannot create bootstrap probe"
[ "$m_ROOT" = "$EXPECTED_ROOT" ] || exit 11
[ "$m_LOG_LEVEL" = "info" ] || exit 12
[ "$(lang bootstrap core-independent)" = "bootstrap.core-independent" ] || exit 13
log info bootstrap core-independent || exit 14
printf -- '%s\n' 'bootstrap=independent'
EOF_PROBE

stdout="$tmp/stdout"
stderr="$tmp/stderr"
EXPECTED_ROOT="$fixture" m_LOG_LEVEL="info" "$fixture/m" "$probe" > "$stdout" 2> "$stderr"
status="$?"
if [ "$status" -ne 0 ]
then
    command -p -- cat "$stderr" >&2
    fail "bootstrap probe returned $status while core.lib.sh was poisoned"
fi

[ "$(command -p -- cat "$stdout")" = "bootstrap=independent" ] || {
    command -p -- cat "$stdout" >&2
    fail "bootstrap probe produced unexpected stdout"
}

if LC_ALL=C command -p -- grep -F "core-library-loaded" "$stderr" >/dev/null 2>&1
then
    command -p -- cat "$stderr" >&2
    fail "bootstrap loaded core.lib.sh"
fi

LC_ALL=C command -p -- grep -F "[info] [bootstrap.core-independent] bootstrap.core-independent" "$stderr" >/dev/null 2>&1 || {
    command -p -- cat "$stderr" >&2
    fail "bootstrap-local logging and language fallback were not available"
}

exit 0
