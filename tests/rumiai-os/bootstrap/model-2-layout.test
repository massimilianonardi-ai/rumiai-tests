#!/bin/sh

TEST_ID=rumiai-os/bootstrap/model-2-layout.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
origin_ok() { origin=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;; esac; return 1; }
validate_root() { [ -f "$1/m" ] && [ -f "$1/rumiai-os" ] && [ -f "$1/rumiai-os-sh" ] && origin_ok "$1"; }
find_root() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then validate_root "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; (CDPATH= cd -- "$RUMIAI_TEST_RUMIAI_OS_ROOT" && pwd -P); return; fi; candidate=$(CDPATH= cd -- "$start" && pwd -P) || return 3; while :; do if validate_root "$candidate"; then printf '%s\n' "$candidate"; return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) :;; *) self=$(command -v "$self") || return 1;; esac; dir=${self%/*}; [ "$dir" != "$self" ] || dir=.; CDPATH= cd -- "$dir" && pwd -P; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(find_root "$start"); status=$?; case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac

[ -x "$root/m" ] || fail 'technical m entrypoint is missing or not executable'
[ -x "$root/rumiai-os" ] || fail 'rumiai-os branded entrypoint is missing or not executable'
[ -x "$root/rumiai-os-sh" ] || fail 'rumiai-os-sh branded entrypoint is missing or not executable'
[ -L "$root/bin/sys/m" ] || fail 'bin/sys/m is not a symlink'
[ "$(readlink "$root/bin/sys/m")" = '../../m' ] || fail 'bin/sys/m target is not ../../m'
[ ! -e "$root/bin/sys/rumiai-os" ] && [ ! -L "$root/bin/sys/rumiai-os" ] || fail 'legacy bin/sys/rumiai-os runtime link remains'
for dir in "$root/bin/sys" "$root/lib/sys/sh" "$root/lib/sys/sh/pkg" "$root/lib/sys/sh/pkg/facility" "$root/lib/sys/sh/pkg/repository" "$root/lib/sys/sh/mk"; do [ -d "$dir" ] || fail "required Model 2.0 directory is missing: $dir"; done
for flat in "$root"/lib/sys/sh/pkg-*.lib.sh "$root"/lib/sys/sh/mk-*.lib.sh; do [ ! -e "$flat" ] && [ ! -L "$flat" ] || fail "flat subsystem library remains: $flat"; done
for misplaced in "$root"/lib/sys/sh/pkg/pkg-facility.lib.sh "$root"/lib/sys/sh/pkg/pkg-dependency.lib.sh "$root"/lib/sys/sh/pkg/pkg-repository-*.lib.sh; do [ ! -e "$misplaced" ] && [ ! -L "$misplaced" ] || fail "misplaced package library remains: $misplaced"; done
[ ! -d "$root/lib/sh" ] || fail 'legacy lib/sh directory remains'
[ -f "$root/product-name" ] && [ ! -L "$root/product-name" ] || fail 'product-name scalar is missing'
[ -f "$root/product-version" ] && [ ! -L "$root/product-version" ] || fail 'product-version scalar is missing'
[ "$(cat "$root/product-name")" = RumiAI ] || fail 'product-name is not RumiAI'
[ "$(wc -l < "$root/product-name" | tr -d ' ')" -eq 1 ] || fail 'product-name is not a one-line scalar'
[ "$(wc -l < "$root/product-version" | tr -d ' ')" -eq 1 ] || fail 'product-version is not a one-line scalar'
[ "$(cat "$root/product-version")" = 2.0.0 ] || fail 'product-version is not 2.0.0 after migration completion'
[ ! -d "$root/conf" ] || fail 'legacy top-level conf directory remains'
for legacy in data home cache log run tmp; do [ ! -e "$root/$legacy" ] || fail "legacy top-level state root remains: $legacy"; done
exit 0
