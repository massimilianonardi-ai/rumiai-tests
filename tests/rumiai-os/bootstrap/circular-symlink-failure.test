#!/bin/sh

TEST_ID=rumiai-os/bootstrap/circular-symlink-failure.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_origin_ok()
{
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
    esac
    return 1
}
rumiai_test_target_validate()
{
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_origin_ok "$candidate" || return 1
    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1
    printf '%s\n' "$target_root"
}
rumiai_test_target_find()
{
    start=$1
    command -v git >/dev/null 2>&1 || return 3
    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then
        rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi
    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :; do
        if rumiai_test_target_validate "$candidate"; then return 0; fi
        [ "$candidate" != / ] || break
        parent=${candidate%/*}; [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done
    return 1
}
resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root=$(rumiai_test_target_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac
entry=$root/rumiai-os
[ -x "$entry" ] || fail 'rumiai-os entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-bootstrap-loop-failure-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
loop_a=$tmp/a
loop_b=$tmp/b
stdout=$tmp/stdout
stderr=$tmp/stderr
ln -s b "$loop_a" || error 'cannot create first loop symlink'
ln -s a "$loop_b" || error 'cannot create second loop symlink'

/bin/sh -c '. "$1"' "$loop_a" "$entry" >"$stdout" 2>"$stderr"
status=$?
[ "$status" -eq 1 ] || {
    cat "$stderr" >&2
    fail "circular symlink failure returned $status instead of 1"
}

[ ! -s "$stdout" ] || fail 'bootstrap emitted unexpected stdout before path resolution failure'
actual=$(cat "$stderr") || error 'cannot read bootstrap stderr'
[ "$actual" = 'bootstrap bin resolution error' ] || fail "unexpected bootstrap stderr: $actual"

exit 0
