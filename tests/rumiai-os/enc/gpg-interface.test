#!/bin/sh

TEST_ID=rumiai-os/enc/gpg-interface.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) printf '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

enc_library=$root/lib/sys/sh/enc.lib.sh
[ -f "$enc_library" ] && [ ! -L "$enc_library" ] ||
    fail 'enc.lib.sh is missing or is not a regular library file'
. "$enc_library" || error 'cannot source enc.lib.sh'

tmp=${TMPDIR:-/tmp}/rumiai-enc-gpg-interface-$$
umask 077
mkdir "$tmp" "$tmp/bin" || error 'cannot create temporary directories'

secret='boundary-secret-58319'
export FAKE_GPG_LOG="$tmp/gpg.log"
export FAKE_GPG_OPTIONS='--force-ocb'

cat > "$tmp/bin/gpg" <<'EOF_GPG'
#!/bin/sh

expected='boundary-secret-58319'

[ "${m_ENC_PASS+x}" != x ] || exit 91

for arg
do
    case $arg in
        *"$expected"*) exit 92 ;;
    esac
done

for arg
do
    if [ "$arg" = '--dump-options' ]
    then
        printf '%s\n' "$FAKE_GPG_OPTIONS"
        exit 0
    fi
done

: > "$FAKE_GPG_LOG" || exit 93
for arg
do
    printf '%s\n' "$arg" >> "$FAKE_GPG_LOG" || exit 93
done

passphrase_fd=
previous=
for arg
do
    if [ "$previous" = '--passphrase-fd' ]
    then
        passphrase_fd=$arg
    fi
    previous=$arg
done

if [ -n "$passphrase_fd" ]
then
    [ "$passphrase_fd" = 3 ] || exit 94
    IFS= read -r observed <&3 || exit 95
    [ "$observed" = "$expected" ] || exit 96
fi

cat
EOF_GPG
chmod 700 "$tmp/bin/gpg" || error 'cannot make fake gpg executable'

old_path=$PATH
PATH="$tmp/bin:$PATH"
export PATH

# A shell function with the same name must not intercept the external dependency.
gpg()
{
    return 99
}

printf 'payload-one\n' > "$tmp/plain" || error 'cannot create payload'
export m_ENC_PASS="$secret"
encode < "$tmp/plain" > "$tmp/out" || fail 'supplied-passphrase encode failed'
unset m_ENC_PASS
cmp -s "$tmp/plain" "$tmp/out" || fail 'encode did not preserve payload stdin at the gpg boundary'
grep -qx -e '--passphrase-fd' "$FAKE_GPG_LOG" ||
    fail 'encode did not request a passphrase file descriptor'
grep -qx -e '3' "$FAKE_GPG_LOG" ||
    fail 'encode did not use file descriptor 3'
grep -qx -e '--force-ocb' "$FAKE_GPG_LOG" ||
    fail 'encode did not use advertised --force-ocb fallback'
if grep -qx -e '--use-ocb-sym' "$FAKE_GPG_LOG"
then
    fail 'encode selected unavailable --use-ocb-sym'
fi

FAKE_GPG_OPTIONS='--use-ocb-sym
--force-ocb'
export FAKE_GPG_OPTIONS
export m_ENC_PASS="$secret"
encode < "$tmp/plain" > "$tmp/out" || fail 'preferred-OCB encode failed'
unset m_ENC_PASS
grep -qx -e '--use-ocb-sym' "$FAKE_GPG_LOG" ||
    fail 'encode did not prefer --use-ocb-sym'
if grep -qx -e '--force-ocb' "$FAKE_GPG_LOG"
then
    fail 'encode used fallback OCB option when preferred option was available'
fi

export m_ENC_PASS="$secret"
decode < "$tmp/plain" > "$tmp/out" || fail 'supplied-passphrase decode failed'
unset m_ENC_PASS
cmp -s "$tmp/plain" "$tmp/out" || fail 'decode did not preserve ciphertext stdin at the gpg boundary'
grep -qx -e '--passphrase-fd' "$FAKE_GPG_LOG" ||
    fail 'decode did not request a passphrase file descriptor'
grep -qx -e '3' "$FAKE_GPG_LOG" ||
    fail 'decode did not use file descriptor 3'

unset m_ENC_PASS
FAKE_GPG_OPTIONS='--force-ocb'
export FAKE_GPG_OPTIONS
encode < "$tmp/plain" > "$tmp/out" || fail 'interactive encode invocation failed at gpg boundary'
if grep -qx -e '--batch' "$FAKE_GPG_LOG" ||
   grep -qx -e '--passphrase-fd' "$FAKE_GPG_LOG" ||
   grep -qx -e '--pinentry-mode' "$FAKE_GPG_LOG"
then
    fail 'interactive encode retained unattended passphrase options'
fi
grep -qx -e '--passphrase-repeat' "$FAKE_GPG_LOG" ||
    fail 'interactive encode did not request passphrase confirmation'
grep -qx -e '1' "$FAKE_GPG_LOG" ||
    fail 'interactive encode did not request one passphrase repetition'

decode < "$tmp/plain" > "$tmp/out" || fail 'interactive decode invocation failed at gpg boundary'
if grep -qx -e '--batch' "$FAKE_GPG_LOG" ||
   grep -qx -e '--passphrase-fd' "$FAKE_GPG_LOG" ||
   grep -qx -e '--pinentry-mode' "$FAKE_GPG_LOG"
then
    fail 'interactive decode retained unattended passphrase options'
fi

PATH=$old_path
export PATH
unset FAKE_GPG_LOG FAKE_GPG_OPTIONS

exit 0
