#!/bin/sh

TEST_ID=rumiai-os/enc/encoded-file-eval.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    if [ -n "${gpg_home-}" ] && command -v gpgconf >/dev/null 2>&1
    then
        GNUPGHOME=$gpg_home gpgconf --kill gpg-agent >/dev/null 2>&1 || :
    fi
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

command -v gpg >/dev/null 2>&1 || skip 'gpg is unavailable'
gpg_options=$(command gpg --no-options --dump-options 2>/dev/null) ||
    skip 'gpg option discovery failed'
if ! printf '%s\n' "$gpg_options" | grep -qx -e '--use-ocb-sym' &&
   ! printf '%s\n' "$gpg_options" | grep -qx -e '--force-ocb'
then
    skip 'gpg lacks symmetric OCB encryption support'
fi
unset gpg_options

core_library=$root/lib/sys/sh/core.lib.sh
enc_library=$root/lib/sys/sh/enc.lib.sh
[ -f "$core_library" ] && [ ! -L "$core_library" ] ||
    fail 'core.lib.sh is missing or is not a regular library file'
[ -f "$enc_library" ] && [ ! -L "$enc_library" ] ||
    fail 'enc.lib.sh is missing or is not a regular library file'

. "$core_library" || error 'cannot source core.lib.sh'
. "$enc_library" || error 'cannot source enc.lib.sh'

tmp=${TMPDIR:-/tmp}/rumiai-encoded-file-eval-$$
umask 077
mkdir "$tmp" "$tmp/path" || error 'cannot create test workspace'
gpg_home=$tmp/gnupg
mkdir -m 700 "$gpg_home" || error 'cannot create temporary GnuPG home'
GNUPGHOME=$gpg_home
export GNUPGHOME

pass='encoded eval $() \\ * ? [ ] " passphrase'

if encoded_file_eval >/dev/null 2>&1
then
    fail 'encoded_file_eval accepted a missing file operand'
else
    status=$?
    [ "$status" -eq 1 ] || fail "missing-file status was $status instead of 1"
fi

if encoded_file_eval '' >/dev/null 2>&1
then
    fail 'encoded_file_eval accepted an empty file operand'
else
    status=$?
    [ "$status" -eq 1 ] || fail "empty-file status was $status instead of 1"
fi

if encoded_file_eval "$tmp/missing.gpg" >/dev/null 2>&1
then
    fail 'encoded_file_eval accepted a missing explicit pathname'
else
    status=$?
    [ "$status" -eq 2 ] || fail "missing-path status was $status instead of 2"
fi

cat > "$tmp/source.sh" <<'EOF_SOURCE'
printf '%s\n' "count=$#" "one=${1-}" "two=${2-}" "three=${3-}"
ENC_EVAL_SIDE_EFFECT=changed
set -- source-local
return 7
EOF_SOURCE

m_ENC_PASS=$pass
encode < "$tmp/source.sh" > "$tmp/source.gpg" ||
    fail 'cannot encrypt encoded_file_eval source fixture'

set -- caller-one 'caller two'
ENC_EVAL_SIDE_EFFECT=before
m_ENC_PASS=$pass
encoded_file_eval "$tmp/source.gpg" alpha 'beta gamma' '$delta' > "$tmp/explicit.out"
status=$?
[ "$status" -eq 7 ] || fail "source return status was $status instead of 7"

cat > "$tmp/explicit.expected" <<'EOF_EXPECTED'
count=3
one=alpha
two=beta gamma
three=$delta
EOF_EXPECTED
cmp -s "$tmp/explicit.expected" "$tmp/explicit.out" ||
    fail 'forwarded positional arguments were not preserved exactly'
[ "$#" -eq 2 ] && [ "$1" = caller-one ] && [ "$2" = 'caller two' ] ||
    fail 'evaluated source changed caller positional parameters'
[ "$ENC_EVAL_SIDE_EFFECT" = changed ] ||
    fail 'ordinary evaluated source state did not affect the caller shell context'

cp "$tmp/source.gpg" "$tmp/path/eval-source.gpg" ||
    error 'cannot create PATH-resolution fixture'
old_path=$PATH
PATH=$tmp/path:$PATH
export PATH
ENC_EVAL_SIDE_EFFECT=path-before
m_ENC_PASS=$pass
encoded_file_eval eval-source.gpg path-one > "$tmp/path.out"
status=$?
PATH=$old_path
export PATH
[ "$status" -eq 7 ] || fail "PATH-resolved source status was $status instead of 7"
cat > "$tmp/path.expected" <<'EOF_PATH_EXPECTED'
count=1
one=path-one
two=
three=
EOF_PATH_EXPECTED
cmp -s "$tmp/path.expected" "$tmp/path.out" ||
    fail 'bare encrypted source was not resolved/evaluated through PATH correctly'
[ "$ENC_EVAL_SIDE_EFFECT" = changed ] ||
    fail 'PATH-resolved evaluated source did not execute'

ENC_EVAL_SIDE_EFFECT=auth-before
m_ENC_PASS=wrong-passphrase
encoded_file_eval "$tmp/source.gpg" ignored > "$tmp/wrong.out" 2>/dev/null
status=$?
[ "$status" -eq 3 ] || fail "decode/authentication status was $status instead of 3"
[ "$ENC_EVAL_SIDE_EFFECT" = auth-before ] ||
    fail 'source executed after decode/authentication failure'
[ ! -s "$tmp/wrong.out" ] ||
    fail 'decode/authentication failure leaked plaintext to encoded_file_eval stdout'

cat > "$tmp/partial-source.sh" <<'EOF_PARTIAL'
: > "$ENC_EVAL_PARTIAL_MARKER"
EOF_PARTIAL
command -p awk 'BEGIN { printf "#"; for (i = 0; i < 100000; i++) printf "x"; printf "\nreturn 0\n" }' >> "$tmp/partial-source.sh" ||
    error 'cannot build multi-chunk encrypted source fixture'

m_ENC_PASS=$pass
encode < "$tmp/partial-source.sh" > "$tmp/partial.gpg" ||
    fail 'cannot encrypt partial-plaintext barrier fixture'

cipher_size=$(command -p wc -c < "$tmp/partial.gpg" | command -p tr -d '[:space:]') ||
    error 'cannot determine ciphertext size'
case $cipher_size in ''|*[!0-9]*) error 'ciphertext size is not numeric' ;; esac
[ "$cipher_size" -gt 1 ] || error 'ciphertext fixture is unexpectedly small'
truncated_size=$((cipher_size - 1))
command -p dd \
    if="$tmp/partial.gpg" \
    of="$tmp/partial-truncated.gpg" \
    bs=1 \
    count="$truncated_size" \
    2>/dev/null || error 'cannot truncate ciphertext fixture'

m_ENC_PASS=$pass
decode < "$tmp/partial-truncated.gpg" > "$tmp/partial-decoded.out" 2>/dev/null
status=$?
[ "$status" -ne 0 ] || fail 'real decode accepted the truncated ciphertext fixture'
grep -F 'ENC_EVAL_PARTIAL_MARKER' "$tmp/partial-decoded.out" >/dev/null 2>&1 ||
    error 'truncated ciphertext did not exercise real partial-plaintext decode behavior'

ENC_EVAL_PARTIAL_MARKER=$tmp/partial-executed
rm -f "$ENC_EVAL_PARTIAL_MARKER" || error 'cannot reset partial-execution marker'
m_ENC_PASS=$pass
encoded_file_eval "$tmp/partial-truncated.gpg" > "$tmp/partial-eval.out" 2>/dev/null
status=$?
[ "$status" -eq 3 ] || fail "partial decode failure status was $status instead of 3"
[ ! -e "$ENC_EVAL_PARTIAL_MARKER" ] ||
    fail 'partial plaintext from a failing real decode was executed'
[ ! -s "$tmp/partial-eval.out" ] ||
    fail 'partial plaintext from a failing real decode reached encoded_file_eval stdout'

cat > "$tmp/trace-source.sh" <<'EOF_TRACE'
: ENC_EVAL_TRACE_EXECUTED
# ENC_EVAL_TRACE_PLAINTEXT_SECRET_73491
return 0
EOF_TRACE
m_ENC_PASS=$pass
encode < "$tmp/trace-source.sh" > "$tmp/trace.gpg" ||
    fail 'cannot encrypt xtrace fixture'

(
    m_ENC_PASS=$pass
    set -x
    encoded_file_eval "$tmp/trace.gpg"
    status=$?
    case $- in *x*) : ;; *) exit 91 ;; esac
    : ENC_EVAL_TRACE_CALLER
    exit "$status"
) > "$tmp/trace.out" 2> "$tmp/trace.err"
status=$?
[ "$status" -eq 0 ] || fail "xtrace evaluation returned unexpected status $status"
grep -F 'ENC_EVAL_TRACE_EXECUTED' "$tmp/trace.err" >/dev/null 2>&1 ||
    fail 'xtrace was not restored before authenticated source execution'
grep -F 'ENC_EVAL_TRACE_CALLER' "$tmp/trace.err" >/dev/null 2>&1 ||
    fail 'xtrace was not preserved after encoded_file_eval returned'
if grep -F 'ENC_EVAL_TRACE_PLAINTEXT_SECRET_73491' "$tmp/trace.err" >/dev/null 2>&1
then
    fail 'complete decrypted source was exposed as a traced eval operand'
fi

exit 0
