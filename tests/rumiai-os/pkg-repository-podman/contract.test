#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-podman/contract.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) :;;
  1) skip "rumiai-os target checkout not found";;
  2) fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-podman.lib.sh"
manual="$root/res/sys/manual/pkg-repository-podman.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] ||
  fail "Podman repository adapter is missing or has invalid mode"
[ -f "$manual" ] && [ ! -L "$manual" ] && [ -r "$manual" ] && [ ! -x "$manual" ] ||
  fail "Podman repository adapter manual is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Podman repository adapter syntax invalid"

tmp=${TMPDIR:-/tmp}/rumiai-pkg-repository-podman-$$
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository="$tmp/repository"
range="$tmp/range"

write_repository()
{
  rm -rf "$repository"
  mkdir "$repository" || error "cannot recreate repository descriptor"
  printf '%s\n' podman > "$repository/type"
  printf '%s\n' v6.1.2 > "$repository/version"
  printf '%s\n' 'https://github.com/podman-container-tools/podman/releases/download/v6.1.2/podman-installer-macos-arm64.pkg' > "$repository/url"
  printf '%s\n' 88def43af7fbe7baf40fc2f12d69267f6d845768020709900fb1b8c3bfe015b3 > "$repository/digest"
}

printf '%s\n' '^podman-installer-macos-arm64\.pkg$' > "$range/archive_regex"
printf '%s\n' sha256 > "$range/digest_type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
expected='https://github.com/podman-container-tools/podman/releases/download/v6.1.2/podman-installer-macos-arm64.pkg'
[ "$#" -eq 3 ] || exit 80
[ "$1" = -l ] || exit 81
[ "$2" = -- ] || exit 82
[ "$3" = "$expected" ] || exit 83
printf '%s\n' 76397383
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$tmp/bin:/usr/bin:/bin"
export PATH
. "$library" || error "cannot source Podman repository adapter"

write_repository
versions="$(pkg_repository_list_versions "$repository")" || fail "cannot list pinned Podman version"
[ "$versions" = v6.1.2 ] || fail "unexpected pinned Podman version list"

[ "$(pkg_repository_compare_versions "$repository" v6.1.2 v6.1.2)" = 0 ] ||
  fail "equal Podman versions did not compare equal"
[ "$(pkg_repository_compare_versions "$repository" v6.1.2 v6.2.0)" = -1 ] ||
  fail "Podman version ordering did not detect ascending version"
[ "$(pkg_repository_compare_versions "$repository" v7.0.0 v6.9.9)" = 1 ] ||
  fail "Podman version ordering did not detect descending version"

resolved="$(pkg_repository_resolve_version "$repository")" || fail "cannot resolve pinned Podman version"
[ "$resolved" = v6.1.2 ] || fail "resolved Podman version is unexpected"
resolved="$(pkg_repository_resolve_version "$repository" v6.1.2)" ||
  fail "explicit pinned Podman version was rejected"
[ "$resolved" = v6.1.2 ] || fail "explicit Podman version resolved unexpectedly"
if pkg_repository_resolve_version "$repository" v6.1.1 >/dev/null 2>&1
then
  fail "unpinned Podman version was accepted"
fi

descriptor="$(pkg_repository_resolve_artifact "$repository" "$range" v6.1.2)" ||
  fail "cannot resolve pinned Podman artifact"
expected='name=podman-installer-macos-arm64.pkg
url=https://github.com/podman-container-tools/podman/releases/download/v6.1.2/podman-installer-macos-arm64.pkg
size=76397383
digest=sha256:88def43af7fbe7baf40fc2f12d69267f6d845768020709900fb1b8c3bfe015b3'
[ "$descriptor" = "$expected" ] || fail "Podman artifact descriptor differs from pinned release"

write_repository
printf '%s\n' unexpected > "$repository/extra"
if pkg_repository_resolve_version "$repository" >/dev/null 2>&1
then
  fail "unknown Podman repository field was accepted"
fi

write_repository
printf '%s\n' v06.1.2 > "$repository/version"
if pkg_repository_resolve_version "$repository" >/dev/null 2>&1
then
  fail "non-canonical Podman version was accepted"
fi

write_repository
printf '%s\n' 'https://example.invalid/podman.pkg' > "$repository/url"
if pkg_repository_resolve_version "$repository" >/dev/null 2>&1
then
  fail "non-official Podman URL was accepted"
fi

write_repository
printf '%s\n' xyz > "$repository/digest"
if pkg_repository_resolve_version "$repository" >/dev/null 2>&1
then
  fail "invalid Podman digest was accepted"
fi

exit 0
