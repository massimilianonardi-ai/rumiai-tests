#!/bin/sh

TEST_ID=rumiai-os/lang/selection.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

snapshot_selectors()
{
    output=$1
    : > "$output" || return 1
    for owner_dir in "$root/res"/*
    do
        [ -d "$owner_dir" ] && [ ! -L "$owner_dir" ] || continue
        lang_dir=$owner_dir/lang
        [ -d "$lang_dir" ] && [ ! -L "$lang_dir" ] || continue
        [ -L "$lang_dir/current" ] || return 2
        target=$(readlink "$lang_dir/current" 2>/dev/null) || return 2
        case $target in ''|*/*|.|..) return 2 ;; esac
        [ -d "$lang_dir/$target" ] && [ ! -L "$lang_dir/$target" ] || return 2
        printf '%s\t%s\n' "${owner_dir##*/}" "$target" >> "$output" || return 1
    done
    LC_ALL=C sort "$output" -o "$output" || return 1
}

snapshot_pkg_paths()
{
    output=$1
    if [ -d "$root/pkg" ]; then
        find "$root/pkg" -print | LC_ALL=C sort > "$output" || return 1
    else
        printf '%s\n' ABSENT > "$output" || return 1
    fi
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

command=$root/bin/sys/lang-set
[ -x "$root/m" ] || fail 'm bootstrap is not executable'
[ -x "$command" ] || fail 'lang-set is missing or not executable'
command -v readlink >/dev/null 2>&1 || error 'readlink is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-lang-selection-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

selected=$("$root/m" "$command" 2> "$tmp/query.err") || {
    cat "$tmp/query.err" >&2
    fail 'lang-set query failed'
}
[ -n "$selected" ] || fail 'lang-set query returned an empty locale'
[ "$(readlink "$root/res/sys/lang/current" 2>/dev/null)" = "$selected" ] ||
    fail 'lang-set query does not match sys/current'

snapshot_selectors "$tmp/selectors.before"
status=$?
case $status in
    0) : ;;
    2) fail 'a materialized global language selector is structurally invalid' ;;
    *) error 'cannot snapshot global language selectors' ;;
esac

while IFS="$(printf '\t')" read -r owner target
do
    [ "$target" = "$selected" ] || fail "global language selectors disagree: $owner=$target selected=$selected"
done < "$tmp/selectors.before"

snapshot_pkg_paths "$tmp/pkg.before" || error 'cannot snapshot package paths'

"$root/m" "$command" "$selected" > "$tmp/select.out" 2> "$tmp/select.err" || {
    cat "$tmp/select.err" >&2
    fail 'lang-set could not re-select the currently available global language'
}
[ ! -s "$tmp/select.out" ] || fail 'successful lang-set selection wrote stdout'
[ ! -s "$tmp/select.err" ] || fail 'successful lang-set selection wrote stderr'

snapshot_selectors "$tmp/selectors.after" || error 'cannot resnapshot global language selectors'
cmp -s "$tmp/selectors.before" "$tmp/selectors.after" ||
    fail 'idempotent language selection changed the selected locale topology'

snapshot_pkg_paths "$tmp/pkg.after" || error 'cannot resnapshot package paths'
cmp -s "$tmp/pkg.before" "$tmp/pkg.after" || fail 'lang-set modified package-local resource paths'

missing=missinglocale$$
for owner_dir in "$root/res"/*
do
    [ -d "$owner_dir/lang/$missing" ] && fail "unexpected temporary missing locale collision: $owner_dir/lang/$missing"
done

if "$root/m" "$command" "$missing" > "$tmp/missing.out" 2> "$tmp/missing.err"; then
    fail 'lang-set accepted a locale unavailable from participating global language trees'
fi
snapshot_selectors "$tmp/selectors.missing" || error 'cannot inspect selectors after rejected locale'
cmp -s "$tmp/selectors.before" "$tmp/selectors.missing" ||
    fail 'rejected locale changed global language selection'

if "$root/m" "$command" "$selected" extra > "$tmp/args.out" 2> "$tmp/args.err"; then
    fail 'lang-set accepted more than one locale operand'
fi
snapshot_selectors "$tmp/selectors.args" || error 'cannot inspect selectors after invalid invocation'
cmp -s "$tmp/selectors.before" "$tmp/selectors.args" ||
    fail 'invalid lang-set invocation changed global language selection'

reported=$("$root/m" "$command" 2> "$tmp/final-query.err") || fail 'post-selection lang-set query failed'
[ "$reported" = "$selected" ] || fail 'lang-set query changed after idempotent/rejected operations'

exit 0
