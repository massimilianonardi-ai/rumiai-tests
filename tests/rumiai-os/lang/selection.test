#!/bin/sh

TEST_ID=rumiai-os/lang/selection.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_origin_ok() { candidate=$1; origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_validate() { candidate=$1; [ -n "$candidate" ] || return 1; [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1; rumiai_test_target_origin_ok "$candidate" || return 1; target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1; [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_find() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3; while :; do if rumiai_test_target_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac; self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
make_fixture() { source_root=$1; fixture_root=$2; mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 1; for fixture_file in m rumiai-os rumiai-os-sh product-name product-version; do cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || return 1; done; for fixture_dir in bin lib res state; do cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || return 1; done; chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || return 1; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
root=$(rumiai_test_target_find "$suite_root"); status=$?; case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
[ -x "$root/bin/sys/lang-set" ] || fail 'bin/sys/lang-set is missing or not executable'
command -v readlink >/dev/null 2>&1 || error 'readlink is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-lang-selection-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture=$tmp/root; make_fixture "$root" "$fixture" || error 'cannot materialize isolated rumiai-os fixture'

rm -rf "$fixture/res" || error 'cannot reset fixture resources'
mkdir -p \
    "$fixture/res/sys/lang/en_US" \
    "$fixture/res/sys/lang/it_IT" \
    "$fixture/res/ai/lang/en_US" \
    "$fixture/res/ai/lang/it_IT" || error 'cannot create fixture language trees'
ln -s en_US "$fixture/res/sys/lang/current" || error 'cannot create sys selector'
ln -s en_US "$fixture/res/ai/lang/current" || error 'cannot create ai selector'

# Adversarial package-local sentinel: lang-set must never inspect m_PKG_DIR.
mkdir -p "$fixture/pkg/demo/lang" || error 'cannot create package sentinel'
ln -s package-local "$fixture/pkg/demo/lang/current" || error 'cannot create package selector sentinel'
printf '%s\n' keep > "$fixture/pkg/demo/lang/marker" || error 'cannot create package marker'

stdout=$tmp/stdout
stderr=$tmp/stderr

LC_ALL=C "$fixture/m" "$fixture/bin/sys/lang-set" >"$stdout" 2>"$stderr" || { cat "$stderr" >&2; fail 'lang-set query failed'; }
[ "$(cat "$stdout")" = en_US ] || { cat "$stdout" >&2; fail 'lang-set query did not return only the sys selected locale'; }
[ ! -s "$stderr" ] || { cat "$stderr" >&2; fail 'lang-set query produced unexpected stderr'; }

"$fixture/m" "$fixture/bin/sys/lang-set" it_IT >"$stdout" 2>"$stderr" || { cat "$stderr" >&2; fail 'lang-set could not select a globally available language'; }
[ ! -s "$stdout" ] || fail 'successful lang-set selection produced unexpected stdout'
[ ! -s "$stderr" ] || { cat "$stderr" >&2; fail 'successful lang-set selection produced unexpected stderr'; }
[ -L "$fixture/res/sys/lang/current" ] || fail 'sys current is not a symlink'
[ -L "$fixture/res/ai/lang/current" ] || fail 'ai current is not a symlink'
[ "$(readlink "$fixture/res/sys/lang/current")" = it_IT ] || fail 'sys current target is not the selected relative locale'
[ "$(readlink "$fixture/res/ai/lang/current")" = it_IT ] || fail 'ai current target is not synchronized with sys'
[ "$(readlink "$fixture/pkg/demo/lang/current")" = package-local ] || fail 'lang-set modified a package-local selector'
[ "$(cat "$fixture/pkg/demo/lang/marker")" = keep ] || fail 'lang-set modified package-local resources'

LC_ALL=C "$fixture/m" "$fixture/bin/sys/lang-set" >"$stdout" 2>"$stderr" || { cat "$stderr" >&2; fail 'lang-set post-selection query failed'; }
[ "$(cat "$stdout")" = it_IT ] || fail 'lang-set did not report the selected sys locale'

"$fixture/m" "$fixture/bin/sys/lang-set" fr_FR >"$stdout" 2>"$stderr" && fail 'lang-set accepted unavailable global language'
grep -F '[fatal] [execution.invalid-arguments]' "$stderr" >/dev/null 2>&1 || { cat "$stderr" >&2; fail 'unavailable language was not reported as fatal invalid-arguments'; }
[ "$(readlink "$fixture/res/sys/lang/current")" = it_IT ] || fail 'unavailable language changed sys selection'
[ "$(readlink "$fixture/res/ai/lang/current")" = it_IT ] || fail 'unavailable language changed ai selection'

rmdir "$fixture/res/ai/lang/en_US" || error 'cannot remove ai en_US locale'
"$fixture/m" "$fixture/bin/sys/lang-set" en_US >"$stdout" 2>"$stderr" && fail 'lang-set selected language missing from one global owner'
grep -F '[fatal] [execution.invalid-arguments]' "$stderr" >/dev/null 2>&1 || { cat "$stderr" >&2; fail 'missing owner language was not reported as fatal invalid-arguments'; }
[ "$(readlink "$fixture/res/sys/lang/current")" = it_IT ] || fail 'failed global prevalidation changed sys selection'
[ "$(readlink "$fixture/res/ai/lang/current")" = it_IT ] || fail 'failed global prevalidation changed ai selection'
mkdir "$fixture/res/ai/lang/en_US" || error 'cannot restore ai en_US locale'

"$fixture/m" "$fixture/bin/sys/lang-set" en_US extra >"$stdout" 2>"$stderr" && fail 'lang-set accepted more than one argument'
grep -F '[fatal] [execution.invalid-arguments]' "$stderr" >/dev/null 2>&1 || { cat "$stderr" >&2; fail 'invalid argument count was not reported as fatal invalid-arguments'; }
[ "$(readlink "$fixture/res/sys/lang/current")" = it_IT ] || fail 'invalid argument count changed sys selection'
[ "$(readlink "$fixture/res/ai/lang/current")" = it_IT ] || fail 'invalid argument count changed ai selection'

rm -f "$fixture/res/ai/lang/current" || error 'cannot remove ai current symlink'
printf '%s\n' keep > "$fixture/res/ai/lang/current" || error 'cannot create non-symlink ai current fixture'
"$fixture/m" "$fixture/bin/sys/lang-set" en_US >"$stdout" 2>"$stderr" && fail 'lang-set overwrote non-symlink ai current object'
grep -F '[fatal] [filesystem.path-invalid]' "$stderr" >/dev/null 2>&1 || { cat "$stderr" >&2; fail 'non-symlink ai current was not reported as fatal path-invalid'; }
[ "$(readlink "$fixture/res/sys/lang/current")" = it_IT ] || fail 'invalid ai selector changed sys selection'
[ -f "$fixture/res/ai/lang/current" ] && [ ! -L "$fixture/res/ai/lang/current" ] || fail 'non-symlink ai current object was replaced'
[ "$(cat "$fixture/res/ai/lang/current")" = keep ] || fail 'non-symlink ai current object content changed'
rm -f "$fixture/res/ai/lang/current" || error 'cannot remove ai current fixture'
ln -s it_IT "$fixture/res/ai/lang/current" || error 'cannot restore ai selector'

rm -f "$fixture/res/sys/lang/current" || error 'cannot remove sys current symlink'
printf '%s\n' keep > "$fixture/res/sys/lang/current" || error 'cannot create non-symlink sys current fixture'
"$fixture/m" "$fixture/bin/sys/lang-set" >"$stdout" 2>"$stderr" && fail 'lang-set query accepted non-symlink sys current object'
grep -F '[fatal] [filesystem.path-invalid]' "$stderr" >/dev/null 2>&1 || { cat "$stderr" >&2; fail 'invalid sys selector query was not reported as fatal path-invalid'; }
[ -f "$fixture/res/sys/lang/current" ] && [ ! -L "$fixture/res/sys/lang/current" ] || fail 'invalid sys selector was replaced by query'
[ "$(cat "$fixture/res/sys/lang/current")" = keep ] || fail 'invalid sys selector content changed'
[ "$(readlink "$fixture/res/ai/lang/current")" = it_IT ] || fail 'invalid sys query changed ai selector'

exit 0
