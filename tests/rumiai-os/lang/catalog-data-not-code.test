#!/bin/sh

TEST_ID=rumiai-os/lang/catalog-data-not-code.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_origin_ok() { candidate=$1; origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_validate() { candidate=$1; [ -n "$candidate" ] || return 1; [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1; rumiai_test_target_origin_ok "$candidate" || return 1; target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1; [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_find() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3; while :; do if rumiai_test_target_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac; self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
make_fixture() { source_root=$1; fixture_root=$2; mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 1; for fixture_file in m rumiai-os rumiai-os-sh product-name product-version; do cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || return 1; done; for fixture_dir in bin lib res state; do cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || return 1; done; chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || return 1; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
root=$(rumiai_test_target_find "$suite_root"); status=$?; case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
[ -x "$root/bin/sys/lang" ] || fail 'bin/sys/lang is missing or not executable'

tmp=${TMPDIR:-/tmp}/rumiai-lang-data-not-code-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture=$tmp/root; make_fixture "$root" "$fixture" || error 'cannot materialize isolated rumiai-os fixture'
rm -rf "$fixture/res/sys/lang" || error 'cannot reset technical fixture catalogs'
mkdir -p "$fixture/res/sys/lang/en_US/demo" || error 'cannot create technical catalog fixture'
marker=$tmp/executed
message="\$(touch $marker)"
printf '%s\n' "$message" > "$fixture/res/sys/lang/en_US/demo/item" || error 'cannot write catalog message'

stdout=$tmp/stdout; stderr=$tmp/stderr
"$fixture/m" "$fixture/bin/sys/lang" demo item >"$stdout" 2>"$stderr" || { cat "$stderr" >&2; fail 'catalog lookup failed'; }
[ "$(cat "$stdout")" = "$message" ] || fail 'catalog text was not returned literally'
[ ! -e "$marker" ] || fail 'catalog content was executed as shell code'
[ ! -s "$stderr" ] || { cat "$stderr" >&2; fail 'catalog lookup produced unexpected stderr'; }

exit 0
