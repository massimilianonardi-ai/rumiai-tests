#!/bin/sh

TEST_ID="rumiai-os/manual/interface.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_capture()
{
  name=$1
  shift
  stdout="$tmp/$name.stdout"
  stderr="$tmp/$name.stderr"

  "$@" >"$stdout" 2>"$stderr" &
  command_pid=$!

  (
    sleep 10
    kill -TERM "$command_pid" 2>/dev/null
  ) &
  watchdog_pid=$!

  wait "$command_pid"
  RUN_STATUS=$?

  kill -TERM "$watchdog_pid" 2>/dev/null
  wait "$watchdog_pid" 2>/dev/null

  [ "$RUN_STATUS" -ne 143 ] || fail "command timed out: $*"
}

expect_status()
{
  expected=$1
  name=$2
  shift 2
  run_capture "$name" "$@"
  [ "$RUN_STATUS" -eq "$expected" ] || {
    cat "$tmp/$name.stderr" >&2
    fail "expected status $expected, got $RUN_STATUS from $*"
  }
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
manual_group=${test_dir%/*}
tests_dir=${manual_group%/*}
suite_root=${tests_dir%/*}

target_library="$suite_root/lib/rumiai-os-target.lib"
fixture_library="$suite_root/lib/rumiai-os-fixture.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
[ -f "$fixture_library" ] || error "rumiai-os fixture helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"
. "$fixture_library" || error "cannot source rumiai-os fixture helper"

source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

source_command="$source_root/bin/sys/manual"
source_page="$source_root/res/sys/manual/manual"
[ -x "$source_command" ] || fail "bin/sys/manual is missing or not executable"
[ "$(sed -n '1p' "$source_command")" = '#!/usr/bin/env m' ] || fail "manual command entry has wrong shebang"
[ -f "$source_page" ] && [ ! -L "$source_page" ] || fail "res/sys/manual/manual is missing or not a regular file"

tmp="${TMPDIR:-/tmp}/rumiai-manual-interface-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture" || error "cannot materialize isolated rumiai-os fixture"
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

manual="$fixture/bin/sys/manual"
[ -x "$manual" ] || fail "isolated manual command is missing"
PATH="$fixture/bin/sys:$PATH"
export PATH

rm -rf "$fixture/res/sys/manual" "$fixture/res/ai/manual" || error "cannot reset isolated manual resources"
mkdir -p "$fixture/res/sys/manual" "$fixture/res/ai/manual" || error "cannot create isolated manual resources"
printf -- 'SYS ALPHA\n' > "$fixture/res/sys/manual/alpha" || error "cannot write sys alpha topic"
printf -- 'SYS COMMON\n' > "$fixture/res/sys/manual/common" || error "cannot write sys common topic"
printf -- 'SYS ZETA\n' > "$fixture/res/sys/manual/zeta" || error "cannot write sys zeta topic"
printf -- 'AI BETA\n' > "$fixture/res/ai/manual/beta" || error "cannot write ai beta topic"
printf -- 'AI COMMON\n' > "$fixture/res/ai/manual/common" || error "cannot write ai common topic"

expect_status 0 discover "$manual"
expected_discovery="$tmp/expected-discovery"
cat > "$expected_discovery" <<'EOF_DISCOVERY'
ai beta
ai common
sys alpha
sys common
sys zeta
EOF_DISCOVERY
cmp -s "$expected_discovery" "$tmp/discover.stdout" || {
  printf -- '%s\n' "$TEST_ID: unexpected discovery output" >&2
  cat "$tmp/discover.stdout" >&2
  exit 1
}
[ ! -s "$tmp/discover.stderr" ] || fail "discovery produced unexpected stderr"

expect_status 0 unique-default "$manual" alpha
[ "$(cat "$tmp/unique-default.stdout")" = 'SYS ALPHA' ] || fail "default non-terminal presentation returned wrong content"
[ ! -s "$tmp/unique-default.stderr" ] || fail "default non-terminal presentation produced unexpected stderr"

expect_status 0 unique-no-pager "$manual" --no-pager beta
[ "$(cat "$tmp/unique-no-pager.stdout")" = 'AI BETA' ] || fail "--no-pager returned wrong content"
[ ! -s "$tmp/unique-no-pager.stderr" ] || fail "--no-pager produced unexpected stderr"

expect_status 1 invalid-option "$manual" --bad alpha
[ ! -s "$tmp/invalid-option.stdout" ] || fail "invalid invocation wrote stdout"
expect_status 1 no-pager-without-topic "$manual" --no-pager
[ ! -s "$tmp/no-pager-without-topic.stdout" ] || fail "missing --no-pager operand wrote stdout"
expect_status 1 invalid-topic "$manual" BAD
[ ! -s "$tmp/invalid-topic.stdout" ] || fail "invalid topic wrote stdout"

expect_status 2 missing-unqualified "$manual" missing
[ ! -s "$tmp/missing-unqualified.stdout" ] || fail "missing unqualified topic wrote stdout"
expect_status 2 missing-qualified "$manual" ai missing
[ ! -s "$tmp/missing-qualified.stdout" ] || fail "missing qualified topic wrote stdout"

expect_status 3 ambiguous "$manual" common
[ ! -s "$tmp/ambiguous.stdout" ] || fail "ambiguous topic wrote stdout"
grep '^manual ' "$tmp/ambiguous.stderr" > "$tmp/ambiguous-alternatives" || fail "ambiguity alternatives are missing"
cat > "$tmp/expected-alternatives" <<'EOF_ALTERNATIVES'
manual ai common
manual sys common
EOF_ALTERNATIVES
cmp -s "$tmp/expected-alternatives" "$tmp/ambiguous-alternatives" || fail "ambiguity alternatives are incorrect or unordered"

expect_status 0 qualified-ai "$manual" --no-pager ai common
[ "$(cat "$tmp/qualified-ai.stdout")" = 'AI COMMON' ] || fail "qualified ai lookup returned wrong content"
expect_status 0 qualified-sys "$manual" --no-pager sys common
[ "$(cat "$tmp/qualified-sys.stdout")" = 'SYS COMMON' ] || fail "qualified sys lookup returned wrong content"

rm -rf "$fixture/res/sys/manual" "$fixture/res/ai/manual" || error "cannot clear isolated manual resources"
expect_status 0 empty-discovery "$manual"
[ ! -s "$tmp/empty-discovery.stdout" ] || fail "empty discovery wrote topic entries"
[ ! -s "$tmp/empty-discovery.stderr" ] || fail "empty discovery produced stderr"

mv "$fixture/res" "$fixture/res.saved" || error "cannot hide resource root"
expect_status 4 missing-resource-root "$manual"
mv "$fixture/res.saved" "$fixture/res" || error "cannot restore resource root"
[ ! -s "$tmp/missing-resource-root.stdout" ] || fail "execution failure wrote stdout"

exit 0
