#!/bin/sh

TEST_ID=rumiai-os/manual/interface.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_capture()
{
    name=$1
    shift
    "$@" > "$tmp/$name.stdout" 2> "$tmp/$name.stderr"
    RUN_STATUS=$?
}

expect_status()
{
    expected=$1
    name=$2
    shift 2
    run_capture "$name" "$@"
    [ "$RUN_STATUS" -eq "$expected" ] || {
        cat "$tmp/$name.stderr" >&2
        fail "expected status $expected, got $RUN_STATUS from $*"
    }
}

cleanup()
{
    [ -z "${sys_alpha_path-}" ] || rm -f "$sys_alpha_path" 2>/dev/null || :
    [ -z "${sys_common_path-}" ] || rm -f "$sys_common_path" 2>/dev/null || :
    [ -z "${ai_beta_path-}" ] || rm -f "$ai_beta_path" 2>/dev/null || :
    [ -z "${ai_common_path-}" ] || rm -f "$ai_common_path" 2>/dev/null || :
    if [ "${ai_manual_created-0}" -eq 1 ]; then rmdir "$ai_manual_dir" 2>/dev/null || :; fi
    if [ "${ai_owner_created-0}" -eq 1 ]; then rmdir "$ai_owner_dir" 2>/dev/null || :; fi
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
manual_group=${test_dir%/*}
tests_dir=${manual_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

manual=$root/bin/sys/manual
[ -x "$manual" ] || fail 'manual command is missing or not executable'
[ -f "$root/res/sys/manual/manual" ] && [ ! -L "$root/res/sys/manual/manual" ] ||
    fail 'manual operational topic is missing'

tmp=${TMPDIR:-/tmp}/rumiai-manual-interface-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

sys_manual_dir=$root/res/sys/manual
ai_owner_dir=$root/res/ai
ai_manual_dir=$ai_owner_dir/manual
[ -d "$sys_manual_dir" ] && [ ! -L "$sys_manual_dir" ] || fail 'sys manual resource tree is unavailable'

ai_owner_created=0
ai_manual_created=0
if [ ! -d "$ai_owner_dir" ]; then
    mkdir "$ai_owner_dir" || error 'cannot create temporary ai resource owner'
    ai_owner_created=1
fi
if [ ! -d "$ai_manual_dir" ]; then
    mkdir "$ai_manual_dir" || error 'cannot create temporary ai manual tree'
    ai_manual_created=1
fi
[ ! -L "$ai_manual_dir" ] || fail 'ai manual resource tree is a symlink'

token=manualprobe$$
sys_alpha=${token}alpha
ai_beta=${token}beta
common=${token}common
missing=${token}missing
sys_alpha_path=$sys_manual_dir/$sys_alpha
sys_common_path=$sys_manual_dir/$common
ai_beta_path=$ai_manual_dir/$ai_beta
ai_common_path=$ai_manual_dir/$common

for path in "$sys_alpha_path" "$sys_common_path" "$ai_beta_path" "$ai_common_path"
do
    [ ! -e "$path" ] && [ ! -L "$path" ] || error "temporary manual topic already exists: $path"
done
printf '%s\n' 'SYS ALPHA' > "$sys_alpha_path" || error 'cannot create sys manual topic'
printf '%s\n' 'SYS COMMON' > "$sys_common_path" || error 'cannot create sys common topic'
printf '%s\n' 'AI BETA' > "$ai_beta_path" || error 'cannot create ai manual topic'
printf '%s\n' 'AI COMMON' > "$ai_common_path" || error 'cannot create ai common topic'

expect_status 0 discover "$root/m" "$manual"
grep -F "$token" "$tmp/discover.stdout" > "$tmp/discover.probe" || fail 'discovery omitted temporary topics'
cat > "$tmp/discover.expected" <<EOF_EXPECTED
ai $ai_beta
ai $common
sys $sys_alpha
sys $common
EOF_EXPECTED
cmp -s "$tmp/discover.expected" "$tmp/discover.probe" || {
    cat "$tmp/discover.probe" >&2
    fail 'discovery did not return owner-qualified topics in lexical order'
}

expect_status 0 exact-default "$root/m" "$manual" "$sys_alpha"
[ "$(cat "$tmp/exact-default.stdout")" = 'SYS ALPHA' ] || fail 'normal non-terminal exact lookup returned wrong content'

expect_status 0 exact-no-pager "$root/m" "$manual" --no-pager "$ai_beta"
[ "$(cat "$tmp/exact-no-pager.stdout")" = 'AI BETA' ] || fail '--no-pager exact lookup returned wrong content'

expect_status 0 substring "$root/m" "$manual" "$token"
cmp -s "$tmp/discover.expected" "$tmp/substring.stdout" || fail 'substring fallback returned wrong qualified result set'

expect_status 3 ambiguous "$root/m" "$manual" "$common"
[ ! -s "$tmp/ambiguous.stdout" ] || fail 'ambiguous exact lookup wrote topic content'
grep -E "^manual (ai|sys) $common$" "$tmp/ambiguous.stderr" > "$tmp/ambiguous.alternatives" ||
    fail 'ambiguity alternatives are missing'
cat > "$tmp/ambiguous.expected" <<EOF_EXPECTED
manual ai $common
manual sys $common
EOF_EXPECTED
cmp -s "$tmp/ambiguous.expected" "$tmp/ambiguous.alternatives" ||
    fail 'ambiguity alternatives are incorrect or unordered'

expect_status 0 qualified-ai "$root/m" "$manual" --no-pager ai "$common"
[ "$(cat "$tmp/qualified-ai.stdout")" = 'AI COMMON' ] || fail 'qualified ai lookup returned wrong content'
expect_status 0 qualified-sys "$root/m" "$manual" --no-pager sys "$common"
[ "$(cat "$tmp/qualified-sys.stdout")" = 'SYS COMMON' ] || fail 'qualified sys lookup returned wrong content'

expect_status 1 invalid-option "$root/m" "$manual" --bad
expect_status 1 missing-no-pager-operand "$root/m" "$manual" --no-pager
expect_status 1 invalid-topic "$root/m" "$manual" BAD
expect_status 2 missing-unqualified "$root/m" "$manual" "$missing"
expect_status 2 missing-qualified "$root/m" "$manual" ai "$missing"

exit 0
