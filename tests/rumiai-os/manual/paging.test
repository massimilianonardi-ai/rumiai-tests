#!/bin/sh

TEST_ID="rumiai-os/manual/paging.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
manual_group=${test_dir%/*}
tests_dir=${manual_group%/*}
suite_root=${tests_dir%/*}

target_library="$suite_root/lib/rumiai-os-target.lib"
fixture_library="$suite_root/lib/rumiai-os-fixture.lib"
interactive_library="$suite_root/lib/interactive.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
[ -f "$fixture_library" ] || error "rumiai-os fixture helper is unavailable"
[ -f "$interactive_library" ] || error "interactive helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"
. "$fixture_library" || error "cannot source rumiai-os fixture helper"
. "$interactive_library" || error "cannot source interactive helper"

rumiai_test_interactive_require
status=$?
case "$status" in
  0) : ;;
  2) skip "supported interactive TTY driver is unavailable" ;;
  *) error "interactive TTY driver detection failed" ;;
esac

source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

tmp="${TMPDIR:-/tmp}/rumiai-manual-paging-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture" || error "cannot materialize isolated rumiai-os fixture"
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

rm -rf "$fixture/res/sys/manual" "$fixture/res/ai/manual" || error "cannot reset isolated manual resources"
mkdir -p "$fixture/res/sys/manual" || error "cannot create isolated manual resources"

long_topic="$fixture/res/sys/manual/long"
: > "$long_topic" || error "cannot create long manual topic"
i=1
while [ "$i" -le 200 ]
do
  printf -- 'line %03d manual paging probe\n' "$i" >> "$long_topic" || error "cannot populate long manual topic"
  i=$((i + 1))
done

runner="$tmp/run-manual"
cat > "$runner" <<'EOF_RUNNER'
#!/bin/sh
exec "$RUMIAI_MANUAL_FIXTURE/m" "$RUMIAI_MANUAL_FIXTURE/bin/sys/manual" long
EOF_RUNNER
chmod 700 "$runner" || error "cannot make paging runner executable"
RUMIAI_MANUAL_FIXTURE="$fixture"
export RUMIAI_MANUAL_FIXTURE
PATH="$fixture/bin/sys:$PATH"
export PATH

case "$RUMIAI_TEST_INTERACTIVE_SYSTEM" in
  Linux)
    RUMIAI_MANUAL_RUNNER="$runner"
    export RUMIAI_MANUAL_RUNNER
    interactive_command='exec "$RUMIAI_MANUAL_RUNNER"'
    ;;
  Darwin)
    interactive_command=$runner
    ;;
esac

dialogue="$tmp/dialogue"
printf -- 'line 001 manual paging probe\tq\n' > "$dialogue" || error "cannot create pager dialogue"
transcript="$tmp/transcript"
rumiai_test_interactive_run "$dialogue" "$transcript" "$interactive_command" || {
  cat "$transcript" >&2 2>/dev/null
  fail "interactive manual presentation failed"
}

grep -F -- 'line 001 manual paging probe' "$transcript" >/dev/null 2>&1 || fail "pager transcript lacks initial topic content"
if grep -F -- 'line 200 manual paging probe' "$transcript" >/dev/null 2>&1
then
  fail "terminal presentation did not stop through the interactive pager"
fi

exit 0
