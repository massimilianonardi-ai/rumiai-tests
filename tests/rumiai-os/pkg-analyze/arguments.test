#!/bin/sh

TEST_ID="rumiai-os/pkg-analyze/arguments.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error "cannot resolve test directory"
suite_root=${test_dir%/tests/rumiai-os/pkg-analyze}

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip "rumiai-os target checkout not found";;
  2) fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_file="$root/bin/sys/pkg-analyze"
[ -x "$command_file" ] || fail "pkg-analyze is missing or not executable"
[ ! -e "$root/bin/sys/pkg_analyze" ] && [ ! -L "$root/bin/sys/pkg_analyze" ] ||
  fail "superseded bin/sys/pkg_analyze still exists"

PATH="$root/bin/sys:$PATH"
export PATH

tmp=${TMPDIR:-/tmp}/rumiai-pkg-analyze-arguments-$$
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

"$command_file" > "$tmp/stdout-zero" 2> "$tmp/stderr-zero"
status=$?
[ "$status" -eq 2 ] || fail "zero arguments returned $status instead of 2"

"$command_file" one two three > "$tmp/stdout-three" 2> "$tmp/stderr-three"
status=$?
[ "$status" -eq 2 ] || fail "three arguments returned $status instead of 2"

exit 0
