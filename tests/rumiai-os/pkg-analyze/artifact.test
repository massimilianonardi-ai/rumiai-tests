#!/bin/sh

TEST_ID="rumiai-os/pkg-analyze/artifact.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_rumiai_os_origin_ok()
{
  origin="$(git -C "$1" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  [ -n "$1" ] && [ -f "$1/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$1" || return 1
  target_root="$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P)" || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  command -v git >/dev/null 2>&1 || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    rumiai_test_target_rumiai_os_validate "$candidate" && return 0
    [ "$candidate" != / ] || break
    parent=${candidate%/*}; [ -n "$parent" ] || parent=/
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self="$0"
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
suite_root=${test_dir%/tests/rumiai-os/pkg-analyze}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

command_file="$root/bin/sys/pkg-analyze"
[ -x "$command_file" ] || fail "pkg-analyze is missing or not executable"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-analyze-artifact-$$"
umask 077
command -p -- mkdir -p -- "$tmp/home" || error "cannot create fixture"
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

artifact="$tmp/demo.AppImage"
cat > "$artifact" <<'EOF_ARTIFACT'
#!/bin/sh
exit 0
EOF_ARTIFACT
command -p -- chmod 700 "$artifact" || error "cannot make artifact executable"

PATH="$root/bin/sys:$PATH"
HOME="$tmp/home"
export PATH HOME

printf -- '\n\n' | "$command_file" appimage "$artifact" > "$tmp/report" 2> "$tmp/diagnostic"
status=$?
[ "$status" -eq 0 ] || fail "artifact analysis returned status $status"

command -p -- grep -F 'source' "$tmp/report" | command -p -- grep -F 'artifact' >/dev/null || fail "artifact source was not reported"
command -p -- grep -F 'format' "$tmp/report" | command -p -- grep -F 'appimage' >/dev/null || fail "artifact format was not reported"
command -p -- grep -F 'suggested-useful-root' "$tmp/report" | command -p -- grep -F '.' >/dev/null || fail "AppImage useful root was not reported"
command -p -- grep -F 'executable' "$tmp/report" | command -p -- grep -F 'demo.AppImage' >/dev/null || fail "materialized AppImage candidate was not reported"
command -p -- grep -F 'Selected export candidates:' "$tmp/report" >/dev/null || fail "selection section is missing"
command -p -- grep -F '(none)' "$tmp/report" >/dev/null || fail "empty selection was not represented"

exit 0
