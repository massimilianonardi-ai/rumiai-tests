#!/bin/sh

TEST_ID="rumiai-os/pkg-analyze/workflow.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case $self in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${home_marker_path-}" ]
  then
    command -p -- rm -f -- "$home_marker_path" 2>/dev/null || :
  fi
  if [ -n "${runtime_marker_path-}" ]
  then
    command -p -- rm -f -- "$runtime_marker_path" 2>/dev/null || :
  fi
  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp" 2>/dev/null || :
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip "rumiai-os target checkout not found";;
  2) fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

command_file="$root/bin/sys/pkg-analyze"
[ -f "$command_file" ] || fail "bin/sys/pkg-analyze is missing"
[ -x "$command_file" ] || fail "bin/sys/pkg-analyze is not executable"

case "$(command -p -- sed -n '1p' "$command_file")" in
  '#!/usr/bin/env m') :;;
  *) fail "pkg-analyze has the wrong command entrypoint";;
esac

[ -n "${HOME-}" ] || skip "HOME is unavailable in the supplied environment"
[ -d "$HOME" ] && [ ! -L "$HOME" ] && [ -w "$HOME" ] ||
  skip "HOME is not a writable real directory in the supplied environment"

[ -n "${XDG_RUNTIME_DIR-}" ] ||
  skip "XDG_RUNTIME_DIR is unavailable in the supplied environment"
[ -d "$XDG_RUNTIME_DIR" ] && [ ! -L "$XDG_RUNTIME_DIR" ] &&
[ -w "$XDG_RUNTIME_DIR" ] ||
  skip "XDG_RUNTIME_DIR is not a writable real directory in the supplied environment"

tmp=${TMPDIR:-/tmp}/rumiai-pkg-analyze-workflow-$$
umask 077
command -p -- mkdir -p --   "$tmp/input/wrapper/root/bin"   "$tmp/input/wrapper/root/scripts"   "$tmp/input/wrapper/root/share" ||
  error "cannot create fixture directories"

home_marker=rumiai-pkg-analyze-home-$$
runtime_marker=rumiai-pkg-analyze-runtime-$$
home_marker_path=$HOME/$home_marker
runtime_marker_path=$XDG_RUNTIME_DIR/$runtime_marker

[ ! -e "$home_marker_path" ] && [ ! -L "$home_marker_path" ] ||
  error "HOME marker pathname already exists"
[ ! -e "$runtime_marker_path" ] && [ ! -L "$runtime_marker_path" ] ||
  error "runtime marker pathname already exists"

RUMIAI_TEST_HOME_MARKER=$home_marker
RUMIAI_TEST_RUNTIME_MARKER=$runtime_marker
export RUMIAI_TEST_HOME_MARKER RUMIAI_TEST_RUNTIME_MARKER

cat > "$tmp/input/wrapper/root/bin/tool" <<'EOF_TOOL'
#!/bin/sh
printf -- '%s\n' state > "$HOME/$RUMIAI_TEST_HOME_MARKER"
printf -- '%s\n' config > "$XDG_CONFIG_HOME/probe-config"
printf -- '%s\n' temp > "$TMPDIR/probe-tmp"
printf -- '%s\n' runtime > "$XDG_RUNTIME_DIR/$RUMIAI_TEST_RUNTIME_MARKER"
printf -- '%s\n' "$XDG_RUNTIME_DIR" > ./runtime-dir-observed
printf -- '%s\n' root > ./runtime-created
exit 7
EOF_TOOL
command -p -- chmod 700 "$tmp/input/wrapper/root/bin/tool" ||
  error "cannot make fixture executable"

printf -- '#!/bin/sh\n' > "$tmp/input/wrapper/root/bin/helper.sh"
printf -- '@echo off\n' > "$tmp/input/wrapper/root/scripts/setup.cmd"
printf -- 'readme\n' > "$tmp/input/wrapper/root/share/readme"

PATH="$root/bin/sys:$PATH"
export PATH

discovery=$tmp/discovery
printf -- '\n' | "$command_file" "$tmp/input/wrapper/root"   > "$discovery" 2> "$tmp/discovery-diagnostic"
status=$?
[ "$status" -eq 0 ] || fail "pkg-analyze discovery returned status $status"

candidate_id=$(
  LC_ALL=C command -p -- awk -F '	' '
    NF == 3 && $1 ~ /^[0-9]+$/ && $3 == "bin/tool" {
      print $1
      count++
    }
    END {
      if (count != 1) exit 1
    }
  ' "$discovery"
) || {
  command -p -- cat "$discovery" >&2
  fail "pkg-analyze did not report exactly one bin/tool candidate"
}

case "$candidate_id" in
  "" | *[!0-9]*) fail "pkg-analyze returned an invalid candidate id";;
esac

report=$tmp/report
diagnostic=$tmp/diagnostic
printf -- '%s\ny\n\n' "$candidate_id" |
  "$command_file" "$tmp/input/wrapper/root" > "$report" 2> "$diagnostic"
status=$?
[ "$status" -eq 0 ] || {
  command -p -- cat "$diagnostic" >&2
  fail "pkg-analyze workflow returned status $status"
}

command -p -- grep -F 'useful-root' "$report" |
  command -p -- grep -F '.' >/dev/null ||
  fail "provided directory was not treated as the useful root"

command -p -- grep -F 'launch-like' "$report" |
  command -p -- grep -F 'bin/helper.sh' >/dev/null ||
  fail "non-executable shell candidate is missing"

command -p -- grep -F 'executable' "$report" |
  command -p -- grep -F 'bin/tool' >/dev/null ||
  fail "executable candidate is missing"

command -p -- grep -F 'launch-like' "$report" |
  command -p -- grep -F 'scripts/setup.cmd' >/dev/null ||
  fail "CMD candidate is missing"

command -p -- grep -F 'exit-status: 7' "$report" >/dev/null ||
  fail "candidate exit status was not reported"

for expected in   runtime-created   runtime-dir-observed   "$home_marker"   probe-config   probe-tmp   "$runtime_marker"
do
  command -p -- grep -F "$expected" "$report" >/dev/null ||
    fail "pkg-analyze report is missing observed effect: $expected"
done

[ -f "$tmp/input/wrapper/root/runtime-created" ] ||
  fail "fixture package-root mutation did not occur"

[ -f "$tmp/input/wrapper/root/runtime-dir-observed" ] ||
  fail "fixture did not record the inherited runtime directory"

observed_runtime=$(command -p -- cat "$tmp/input/wrapper/root/runtime-dir-observed") ||
  error "cannot read observed runtime directory"
[ "$observed_runtime" = "$XDG_RUNTIME_DIR" ] ||
  fail "pkg-analyze replaced XDG_RUNTIME_DIR instead of preserving it"

[ -f "$runtime_marker_path" ] ||
  fail "candidate did not use the supplied XDG_RUNTIME_DIR"

[ "$(command -p -- cat "$runtime_marker_path")" = runtime ] ||
  fail "runtime marker content is incorrect"

[ ! -e "$home_marker_path" ] && [ ! -L "$home_marker_path" ] ||
  fail "candidate escaped pkg-analyze HOME redirection"

exit 0
