#!/bin/sh
TEST_ID=rumiai-os/text-document/core.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }

self=$0
case "$self" in */*) : ;; *) self=$(command -v "$self") || error "cannot resolve test pathname" ;; esac
test_dir=$(CDPATH= cd -- "${self%/*}" && pwd -P) || error "cannot resolve test directory"
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error "cannot resolve suite root"
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "target discovery library missing"
. "$target_library" || error "target discovery unavailable"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit product target checkout' ;;
  *) error 'product target discovery failed' ;;
esac
command -v node >/dev/null 2>&1 || skip 'Node.js is not installed'
[ -f "$root/lib/sys/js/core/modules-js.json" ] || fail 'core JavaScript descriptor unavailable'
[ -f "$root/lib/sys/js/text-edit.lib.js" ] || fail 'unchanged TextEdit reference unavailable'
RUMIAI_OS_ROOT="$root" node "$test_dir/core.test.mjs" || fail 'document extraction/real core compilation checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/geometry.test.mjs" || fail 'cell pre/post geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/annotation-rebase.test.mjs" || fail 'annotation anchor preservation checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/fold-geometry.test.mjs" || fail 'fold old/new geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/substitution-geometry.test.mjs" || fail 'substitution old/new geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/fold-precommit.test.mjs" || fail 'fold old-boundary precommit checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/substitution-precommit.test.mjs" || fail 'substitution old-boundary precommit checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/cell-precommit-chain.test.mjs" || fail 'cell immediate-view precommit checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/annotation-precommit-chain.test.mjs" || fail 'annotation identity precommit checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/cell-annotated-input.test.mjs" || fail 'annotated raw cell geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/cell-cell-precommit.test.mjs" || fail 'nested cell geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/cell-annotation-cell-precommit.test.mjs" || fail 'annotated cell geometry checks failed'
RUMIAI_OS_ROOT="$root" node "$test_dir/cell-annotation-cell-protected.test.mjs" || fail 'nested Cell Fold/Substitution geometry checks failed'
