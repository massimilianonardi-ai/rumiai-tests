#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-chrome-for-testing/contract.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=${RUMIAI_TEST_SOURCE_PATH:-$0}
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=$tests_dir
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

test_script="$test_dir/${TEST_ID##*/}"
rumiai_test_target_rumiai_os_enter_m "$root" "$test_script" || error "cannot re-enter test through target m bootstrap"

library="$root/lib/sys/sh/pkg/repository/pkg-repository-chrome-for-testing.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Chrome for Testing repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Chrome for Testing repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-cft-contract-$$"
umask 077
mkdir "$tmp" "$tmp/bin" "$tmp/repository" "$tmp/range" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository_dir="$tmp/repository"
range_dir="$tmp/range"
CFT_HTTP_LOG="$tmp/http.log"; export CFT_HTTP_LOG

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
for url do :; done
printf -- '%s\n' "$url" >> "$CFT_HTTP_LOG"
if [ -n "${CFT_HTTP_FAIL_URL-}" ] && [ "$url" = "$CFT_HTTP_FAIL_URL" ]
then
  exit "${CFT_HTTP_FAIL_STATUS:-22}"
fi

case "$url" in
  https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_STABLE)
    printf -- '%s\n' 155.0.8059.39
    ;;
  https://www.googleapis.com/storage/v1/b/chrome-for-testing-public/o/*\?fields=name%2Csize%2Cmd5Hash%2Ccrc32c)
    encoded=${url#https://www.googleapis.com/storage/v1/b/chrome-for-testing-public/o/}
    encoded=${encoded%\?fields=name%2Csize%2Cmd5Hash%2Ccrc32c}
    object="$(printf -- '%s\n' "$encoded" | command -p -- sed 's/%2F/\//g')" || exit 89

    version=${object%%/*}
    rest=${object#*/}
    platform=${rest%%/*}
    archive=${rest#*/}

    [ "$version" != 999.0.0.0 ] || exit 22
    [ "$platform" = linux-arm64 ] || exit 88
    [ "$archive" = chrome-linux-arm64.zip ] || exit 88

    case "${CFT_METADATA_MODE-ok}" in
      ok)
        printf -- '{"name":"%s","size":"7","md5Hash":"XUFAKrxLKna5cZ2REBfFkg==","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      no-md5)
        printf -- '{"name":"%s","size":"7","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      no-crc32c)
        printf -- '{"name":"%s","size":"7","md5Hash":"XUFAKrxLKna5cZ2REBfFkg=="}\n' "$object"
        ;;
      wrong-name)
        printf -- '{"name":"wrong/object","size":"7","md5Hash":"XUFAKrxLKna5cZ2REBfFkg==","crc32c":"ImIEBA=="}\n'
        ;;
      bad-md5)
        printf -- '{"name":"%s","size":"7","md5Hash":"not-base64","crc32c":"ImIEBA=="}\n' "$object"
        ;;
      *) exit 87;;
    esac
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

write_repository()
{
  channel=$1
  platform=$2
  rm -rf "$repository_dir"
  mkdir "$repository_dir" || error "cannot recreate repository descriptor"
  printf -- '%s\n' chrome-for-testing > "$repository_dir/type"
  printf -- '%s\n' "$channel" > "$repository_dir/channel"
  printf -- '%s\n' "$platform" > "$repository_dir/platform"
}

write_range()
{
  expression=$1
  rm -rf "$range_dir"
  mkdir "$range_dir" || error "cannot recreate range"
  printf -- '%s\n' "$expression" > "$range_dir/archive_regex"
  printf -- '%s\n' md5 > "$range_dir/digest_type"
}

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
loadsyslib "pkg/repository/pkg-repository-chrome-for-testing" || error "cannot load Chrome for Testing repository adapter through m"

CFT_METADATA_MODE=ok; export CFT_METADATA_MODE
write_repository Stable linux-arm64
write_range '^chrome-linux-arm64\.zip$'
: > "$CFT_HTTP_LOG"

latest="$(pkg_repository_resolve_version "$repository_dir")" || fail "latest Chrome for Testing resolution failed"
[ "$latest" = 155.0.8059.39 ] || fail "latest Chrome for Testing version is incorrect"
grep -Fx 'https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_STABLE' "$CFT_HTTP_LOG" >/dev/null 2>&1 || fail "latest resolution did not use LATEST_RELEASE_STABLE"
grep -F '155.0.8059.39%2Flinux-arm64%2Fchrome-linux-arm64.zip?fields=name%2Csize%2Cmd5Hash%2Ccrc32c' "$CFT_HTTP_LOG" >/dev/null 2>&1 || fail "latest resolution did not validate Google Storage metadata"

CFT_HTTP_FAIL_URL=https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_STABLE
CFT_HTTP_FAIL_STATUS=22
export CFT_HTTP_FAIL_URL CFT_HTTP_FAIL_STATUS
pkg_repository_resolve_version "$repository_dir" >"$tmp/upstream.out" 2>"$tmp/upstream.err"
status=$?
unset CFT_HTTP_FAIL_URL CFT_HTTP_FAIL_STATUS
[ "$status" -eq 1 ] || fail "Chrome for Testing upstream failure returned status $status instead of 1"
grep -F 'operation="pkg-repository-chrome-for-testing"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Chrome for Testing failure diagnostic does not identify adapter"
grep -F 'function="pkg_repository_resolve_version"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Chrome for Testing failure diagnostic does not identify resolve-version function"
grep -F 'url="https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_STABLE"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Chrome for Testing failure diagnostic does not preserve endpoint"
grep -F 'status="22"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Chrome for Testing failure diagnostic does not preserve http-fetch status"

[ "$(pkg_repository_resolve_version "$repository_dir" 153.0.8010.12)" = 153.0.8010.12 ] || fail "exact Chrome for Testing version was rejected"
if pkg_repository_resolve_version "$repository_dir" 999.0.0.0 >/dev/null 2>&1; then fail "missing exact Chrome for Testing artifact was accepted"; fi
for invalid in 153 153.0.8010 153.0.8010.12.1 153.00.8010.12 v153.0.8010.12
do
  if pkg_repository_resolve_version "$repository_dir" "$invalid" >/dev/null 2>&1; then fail "invalid Chrome for Testing version was accepted: $invalid"; fi
done

: > "$CFT_HTTP_LOG"
[ "$(pkg_repository_compare_versions "$repository_dir" 153.0.8010.12 155.0.8059.39)" = -1 ] || fail "Chrome for Testing comparison left<right failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 155.0.8059.39 155.0.8059.39)" = 0 ] || fail "Chrome for Testing comparison equality failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 156.0.0.0 155.999999999999999999999999.0.0)" = 1 ] || fail "Chrome for Testing comparison left>right failed"
[ "$(pkg_repository_compare_versions "$repository_dir" 155.0.999999999999999999999999.0 155.0.1000000000000000000000000.0)" = -1 ] || fail "Chrome for Testing comparison overflowed or became lexical"
[ ! -s "$CFT_HTTP_LOG" ] || fail "Chrome for Testing comparison consulted upstream availability"

descriptor="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 153.0.8010.12)" || fail "artifact resolution failed"
printf -- '%s\n' "$descriptor" | grep -Fx 'name=chrome-linux-arm64.zip' >/dev/null 2>&1 || fail "wrong artifact name"
printf -- '%s\n' "$descriptor" | grep -Fx 'url=https://storage.googleapis.com/chrome-for-testing-public/153.0.8010.12/linux-arm64/chrome-linux-arm64.zip' >/dev/null 2>&1 || fail "wrong artifact URL"
printf -- '%s\n' "$descriptor" | grep -Fx 'size=7' >/dev/null 2>&1 || fail "wrong artifact size"
printf -- '%s\n' "$descriptor" | grep -Fx 'digest=md5:5d41402abc4b2a76b9719d911017c592' >/dev/null 2>&1 || fail "wrong MD5 conversion or digest"

for mode in no-md5 no-crc32c wrong-name bad-md5
do
  CFT_METADATA_MODE=$mode; export CFT_METADATA_MODE
  if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 153.0.8010.12 >/dev/null 2>&1
  then
    fail "Chrome for Testing adapter accepted invalid metadata mode: $mode"
  fi
done
CFT_METADATA_MODE=ok; export CFT_METADATA_MODE

write_range '^other\.zip$'
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 153.0.8010.12 >/dev/null 2>&1; then fail "Chrome for Testing adapter ignored archive_regex"; fi

write_range '^chrome-linux-arm64\.zip$'
printf -- '%s\n' sha256 > "$range_dir/digest_type"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 153.0.8010.12 >/dev/null 2>&1; then fail "Chrome for Testing MD5 range accepted a different digest_type"; fi

write_range '^chrome-linux-arm64\.zip$'
printf -- '%s\n' unused > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 153.0.8010.12 >/dev/null 2>&1; then fail "Chrome for Testing adapter accepted digest_regex"; fi

write_repository Beta linux-arm64
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unsupported Chrome for Testing channel was accepted"; fi
write_repository Stable linux64
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unsupported Chrome for Testing platform was accepted"; fi
write_repository Stable linux-arm64
printf -- '%s\n' unexpected > "$repository_dir/extra"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unknown Chrome for Testing repository field was accepted"; fi

exit 0
