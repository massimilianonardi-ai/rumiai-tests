#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-nodejs/contract.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=${RUMIAI_TEST_SOURCE_PATH:-$0}
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=$tests_dir
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit target";; *) error "target discovery failed";; esac

test_script="$test_dir/${TEST_ID##*/}"
rumiai_test_target_rumiai_os_enter_m "$root" "$test_script" || error "cannot re-enter through target m bootstrap"

library="$root/lib/sys/sh/pkg/repository/pkg-repository-nodejs.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Node.js adapter missing or invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Node.js adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-nodejs-contract-$$"
umask 077
mkdir "$tmp" "$tmp/bin" "$tmp/repository" "$tmp/repository/download" "$tmp/repository/metadata" "$tmp/range" || error "cannot create fixtures"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
export NODEJS_HTTP_LOG="$tmp/http.log"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
mode=body
if [ "${1-}" = -l ]; then mode=length; shift; fi
[ "${1-}" = -- ] && shift
url=${1-}
printf -- '%s\t%s\n' "$mode" "$url" >> "$NODEJS_HTTP_LOG"
if [ -n "${NODEJS_HTTP_FAIL_URL-}" ] && [ "$url" = "$NODEJS_HTTP_FAIL_URL" ]
then
  exit "${NODEJS_HTTP_FAIL_STATUS:-22}"
fi
case "$mode:$url" in
  body:https://nodejs.org/dist/index.json)
    printf '%s\n' '[{"version":"v26.11.1"},{"version":"v26.10.0"},{"version":"v25.9.0"},{"version":"v26.8.2"}]'
    ;;
  body:https://nodejs.org/dist/v26.11.1/SHASUMS256.txt)
    printf '%s\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  node-v26.11.1-linux-arm64.tar.xz'
    ;;
  length:https://nodejs.org/dist/v26.11.1/node-v26.11.1-linux-arm64.tar.xz)
    printf '%s\n' 123
    ;;
  *) exit 22;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot prepare fake http-fetch"

printf '%s\n' nodejs > "$tmp/repository/type"
printf '%s\n' 26 > "$tmp/repository/major"
printf '%s\n' template-url > "$tmp/repository/download/type"
printf '%s\n' 'node-{version}-linux-arm64.tar.xz' > "$tmp/repository/download/name-template"
printf '%s\n' 'https://nodejs.org/dist/{version}/{name}' > "$tmp/repository/download/url-template"
printf '%s\n' checksum-manifest > "$tmp/repository/metadata/type"
printf '%s\n' 'https://nodejs.org/dist/{version}/SHASUMS256.txt' > "$tmp/repository/metadata/url-template"
printf '%s\n' '^node-v[0-9][A-Za-z0-9._+~-]*-linux-arm64\.tar\.xz$' > "$tmp/range/archive_regex"
printf '%s\n' sha256 > "$tmp/range/digest_type"

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
loadsyslib "pkg/repository/pkg-repository-nodejs" || error "cannot load Node.js adapter"

: > "$NODEJS_HTTP_LOG"
versions="$(pkg_repository_list_versions "$tmp/repository")" || fail "list versions failed"
printf '%s\n' "$versions" | grep -Fx v26.11.1 >/dev/null 2>&1 || fail "latest v26 missing from list"
printf '%s\n' "$versions" | grep -Fx v25.9.0 >/dev/null 2>&1 && fail "wrong major leaked into list"

[ "$(pkg_repository_resolve_version "$tmp/repository")" = v26.11.1 ] || fail "latest Node.js version resolution failed"
[ "$(pkg_repository_resolve_version "$tmp/repository" v26.8.2)" = v26.8.2 ] || fail "exact Node.js version resolution failed"
if pkg_repository_resolve_version "$tmp/repository" v26.9.9 >/dev/null 2>&1; then fail "missing exact release was accepted"; fi

NODEJS_HTTP_FAIL_URL=https://nodejs.org/dist/index.json
NODEJS_HTTP_FAIL_STATUS=22
export NODEJS_HTTP_FAIL_URL NODEJS_HTTP_FAIL_STATUS
pkg_repository_resolve_version "$tmp/repository" >"$tmp/upstream.out" 2>"$tmp/upstream.err"
status=$?
unset NODEJS_HTTP_FAIL_URL NODEJS_HTTP_FAIL_STATUS
[ "$status" -eq 1 ] || fail "Node.js upstream failure returned status $status instead of 1"
grep -F 'operation="pkg-repository-nodejs"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Node.js failure diagnostic does not identify adapter"
grep -F 'function="pkg_repository_resolve_version"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Node.js failure diagnostic does not identify resolve-version function"
grep -F 'url="https://nodejs.org/dist/index.json"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Node.js failure diagnostic does not preserve endpoint"
grep -F 'status="22"' "$tmp/upstream.err" >/dev/null 2>&1 || fail "Node.js failure diagnostic does not preserve http-fetch status"

: > "$NODEJS_HTTP_LOG"
[ "$(pkg_repository_compare_versions "$tmp/repository" v26.9.0 v26.10.0)" = -1 ] || fail "numeric comparison failed"
[ "$(pkg_repository_compare_versions "$tmp/repository" v26.10.0 v26.10.0)" = 0 ] || fail "equality comparison failed"
[ "$(pkg_repository_compare_versions "$tmp/repository" v26.100000000000000000000.0 v26.99999999999999999999.0)" = 1 ] || fail "large component comparison failed"
[ ! -s "$NODEJS_HTTP_LOG" ] || fail "version comparison consulted upstream"

descriptor="$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.11.1)" || fail "artifact resolution failed"
printf '%s\n' "$descriptor" | grep -Fx 'name=node-v26.11.1-linux-arm64.tar.xz' >/dev/null 2>&1 || fail "artifact name wrong"
printf '%s\n' "$descriptor" | grep -Fx 'url=https://nodejs.org/dist/v26.11.1/node-v26.11.1-linux-arm64.tar.xz' >/dev/null 2>&1 || fail "artifact URL wrong"
printf '%s\n' "$descriptor" | grep -Fx 'size=123' >/dev/null 2>&1 || fail "artifact size wrong"
printf '%s\n' "$descriptor" | grep -Fx 'digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' >/dev/null 2>&1 || fail "artifact digest wrong"

for invalid in 26.11.1 vv26.11.1 v26.011.1 v26.11
do
  if pkg_repository_resolve_version "$tmp/repository" "$invalid" >/dev/null 2>&1; then fail "invalid version accepted: $invalid"; fi
done

printf '%s\n' 25 > "$tmp/repository/major"
if pkg_repository_resolve_version "$tmp/repository" v26.11.1 >/dev/null 2>&1; then fail "repository major boundary ignored"; fi

exit 0
