#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-nodejs/versions.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-nodejs.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Node.js repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Node.js repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-nodejs-versions-$$"
umask 077
mkdir -p "$tmp/repository" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
printf -- '%s\n' nodejs > "$tmp/repository/type"
printf -- '%s\n' nodejs > "$tmp/repository/owner"
printf -- '%s\n' node > "$tmp/repository/repository"

NODEJS_HTTP_LOG="$tmp/http.log"
export NODEJS_HTTP_LOG

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
for url do :; done
[ -z "${NODEJS_HTTP_LOG-}" ] || printf '%s\n' "$url" >> "$NODEJS_HTTP_LOG"
case "$url" in
  https://api.github.com/repos/nodejs/node/releases/latest)
    printf '%s\n' '{"tag_name":"v26.8.2","draft":false,"prerelease":false,"created_at":"2026-09-09T16:03:05Z"}'
    ;;
  'https://api.github.com/repos/nodejs/node/releases?per_page=100&page=1')
    printf '%s\n' '[{"tag_name":"v26.8.2","draft":false,"prerelease":false,"created_at":"2026-09-09T16:03:05Z","published_at":"2026-09-09T16:07:48Z"},{"tag_name":"v1.0.0","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-01T00:01:00Z"},{"tag_name":"v99.0.0","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-01T00:01:00Z"},{"tag_name":"v100.0.0-rc.1","draft":false,"prerelease":true,"created_at":"2026-10-01T00:00:00Z","published_at":"2026-10-01T00:01:00Z"},{"tag_name":"v101.0.0","draft":true,"prerelease":false,"created_at":"2026-11-01T00:00:00Z","published_at":"2026-11-01T00:01:00Z"}]'
    ;;
  https://api.github.com/repos/nodejs/node/releases/tags/v26.8.2)
    printf '%s\n' '{"tag_name":"v26.8.2","draft":false,"prerelease":false,"created_at":"2026-09-09T16:03:05Z","published_at":"2026-09-09T16:07:48Z"}'
    ;;
  https://api.github.com/repos/nodejs/node/releases/tags/v1.0.0)
    printf '%s\n' '{"tag_name":"v1.0.0","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-01T00:01:00Z"}'
    ;;
  https://api.github.com/repos/nodejs/node/releases/tags/v99.0.0)
    printf '%s\n' '{"tag_name":"v99.0.0","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-01T00:01:00Z"}'
    ;;
  https://api.github.com/repos/nodejs/node/releases/tags/v2.0.0)
    printf '%s\n' '{"tag_name":"v2.0.0","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-01T00:01:00Z"}'
    ;;
  https://api.github.com/repos/nodejs/node/releases/tags/v100.0.0-rc.1)
    printf '%s\n' '{"tag_name":"v100.0.0-rc.1","draft":false,"prerelease":true,"created_at":"2026-10-01T00:00:00Z","published_at":"2026-10-01T00:01:00Z"}'
    ;;
  *) exit 88 ;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"
PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
. "$library" || error "cannot source Node.js repository adapter"

latest="$(pkg_repository_resolve_version "$tmp/repository")" || fail "GitHub latest release resolution failed"
[ "$latest" = v26.8.2 ] || fail "latest release is $latest, expected v26.8.2"
exact="$(pkg_repository_resolve_version "$tmp/repository" v1.0.0)" || fail "GitHub exact release resolution failed"
[ "$exact" = v1.0.0 ] || fail "exact release changed unexpectedly"
if pkg_repository_resolve_version "$tmp/repository" v404.0.0 >/dev/null 2>&1; then fail "nonexistent GitHub release was accepted"; fi
if pkg_repository_resolve_version "$tmp/repository" v100.0.0-rc.1 >/dev/null 2>&1; then fail "GitHub prerelease was accepted as installable"; fi

versions="$(pkg_repository_list_versions "$tmp/repository")" || fail "GitHub release enumeration failed"
expected='v99.0.0
v1.0.0
v26.8.2'
[ "$versions" = "$expected" ] || fail "Node.js release enumeration did not preserve GitHub release chronology"

[ "$(pkg_repository_compare_versions "$tmp/repository" v99.0.0 v1.0.0)" = -1 ] || fail "GitHub chronological comparison failed"
: > "$NODEJS_HTTP_LOG" || error "cannot reset HTTP log"
[ "$(pkg_repository_compare_versions "$tmp/repository" v26.8.2 v26.8.2)" = 0 ] || fail "equality comparison failed"
[ ! -s "$NODEJS_HTTP_LOG" ] || fail "equal version comparison performed an unnecessary GitHub API request"
[ "$(pkg_repository_compare_versions "$tmp/repository" v26.8.2 v1.0.0)" = 1 ] || fail "descending GitHub comparison failed"
if pkg_repository_compare_versions "$tmp/repository" v1.0.0 v2.0.0 >/dev/null 2>&1; then fail "created_at+published_at tie between distinct releases was accepted"; fi

# Deliberately v99 before v1 proves the adapter does not impose SemVer/numeric ordering.
case "$versions" in v99.0.0*) : ;; *) fail "version order was reinterpreted instead of following GitHub chronology" ;; esac

exit 0
