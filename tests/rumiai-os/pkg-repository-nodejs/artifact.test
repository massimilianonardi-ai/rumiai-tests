#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-nodejs/artifact.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@d0617fdb3f7d7960e92cfdabef818a626eb22004:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}
rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1
  printf -- '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}
resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

library="$root/lib/sys/sh/pkg-repository-nodejs.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Node.js repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Node.js repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-nodejs-artifact-$$"
umask 077
mkdir -p "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
printf -- '%s\n' nodejs > "$tmp/repository/type"
printf -- '%s\n' nodejs > "$tmp/repository/owner"
printf -- '%s\n' node > "$tmp/repository/repository"
printf -- '%s\n' '^node-v[0-9][A-Za-z0-9._+~-]*-darwin-arm64\.tar\.gz$' > "$tmp/range/archive_regex"
printf -- '%s\n' sha256 > "$tmp/range/digest_type"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
for url do :; done
case "$url" in
  https://api.github.com/repos/nodejs/node/releases/tags/v26.8.2)
    case "${NODEJS_ARTIFACT_MODE-normal}" in
      draft) printf '%s\n' '{"tag_name":"v26.8.2","draft":true,"prerelease":false,"created_at":"2026-09-09T16:03:05Z","assets":[]}' ;;
      *) printf '%s\n' '{"tag_name":"v26.8.2","draft":false,"prerelease":false,"created_at":"2026-09-09T16:03:05Z","assets":[]}' ;;
    esac
    ;;
  https://nodejs.org/dist/v26.8.2/SHASUMS256.txt)
    case "${NODEJS_ARTIFACT_MODE-normal}" in
      bad-digest)
        printf '%s\n' 'not-a-sha  node-v26.8.2-darwin-arm64.tar.gz'
        ;;
      ambiguous)
        printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  node-v26.8.2-darwin-arm64.tar.gz'
        printf '%s\n' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  node-v26.8.2-darwin-arm64.tar.gz.debug'
        ;;
      *)
        printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  node-v26.8.2-linux-arm64.tar.xz'
        printf '%s\n' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  node-v26.8.2-linux-x64.tar.xz'
        printf '%s\n' 'CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  node-v26.8.2-darwin-arm64.tar.gz'
        printf '%s\n' 'DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD  node-v26.8.2-darwin-x64.tar.gz'
        printf '%s\n' 'EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE  node-v26.8.2-win-arm64.zip'
        printf '%s\n' 'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF  node-v26.8.2-win-x64.zip'
        ;;
    esac
    ;;
  https://nodejs.org/dist/v26.8.2/)
    case "${NODEJS_ARTIFACT_MODE-normal}" in
      missing-size) printf '%s\n' '<a href="other">other</a> 09-Sep-2026 14:42 1' ;;
      *)
        printf '%s\n' '<a href="node-v26.8.2-linux-arm64.tar.xz">node-v26.8.2-linux-arm64.tar.xz</a> 09-Sep-2026 14:42 32715752'
        printf '%s\n' '<a href="node-v26.8.2-linux-x64.tar.xz">node-v26.8.2-linux-x64.tar.xz</a> 09-Sep-2026 14:43 33720236'
        printf '%s\n' '<a href="node-v26.8.2-darwin-arm64.tar.gz">node-v26.8.2-darwin-arm64.tar.gz</a> 09-Sep-2026 14:42 57818610'
        printf '%s\n' '<a href="node-v26.8.2-darwin-x64.tar.gz">node-v26.8.2-darwin-x64.tar.gz</a> 09-Sep-2026 15:16 59215598'
        printf '%s\n' '<a href="node-v26.8.2-win-arm64.zip">node-v26.8.2-win-arm64.zip</a> 09-Sep-2026 01:31 36945374'
        printf '%s\n' '<a href="node-v26.8.2-win-x64.zip">node-v26.8.2-win-x64.zip</a> 09-Sep-2026 00:25 41379367'
        ;;
    esac
    ;;
  *index.tab*) exit 91 ;;
  *) exit 88 ;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"
PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
NODEJS_ARTIFACT_MODE=normal; export NODEJS_ARTIFACT_MODE
. "$library" || error "cannot source Node.js repository adapter"

descriptor="$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2)" || fail "artifact resolution failed"
expected='name=node-v26.8.2-darwin-arm64.tar.gz
url=https://nodejs.org/dist/v26.8.2/node-v26.8.2-darwin-arm64.tar.gz
size=57818610
digest=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'
[ "$descriptor" = "$expected" ] || fail "artifact descriptor differs from pkg_download contract"

while IFS='|' read -r artifact_regex artifact_name artifact_size artifact_digest
 do
  printf -- '%s\n' "$artifact_regex" > "$tmp/range/archive_regex"
  descriptor="$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2)" || fail "artifact mapping failed for $artifact_name"
  expected="name=$artifact_name
url=https://nodejs.org/dist/v26.8.2/$artifact_name
size=$artifact_size
digest=sha256:$artifact_digest"
  [ "$descriptor" = "$expected" ] || fail "custom Node.js URL mapping is incorrect for $artifact_name"
done <<'EOF_OSARCH'
^node-v[0-9][A-Za-z0-9._+~-]*-linux-arm64\.tar\.xz$|node-v26.8.2-linux-arm64.tar.xz|32715752|aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
^node-v[0-9][A-Za-z0-9._+~-]*-linux-x64\.tar\.xz$|node-v26.8.2-linux-x64.tar.xz|33720236|bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
^node-v[0-9][A-Za-z0-9._+~-]*-darwin-arm64\.tar\.gz$|node-v26.8.2-darwin-arm64.tar.gz|57818610|cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
^node-v[0-9][A-Za-z0-9._+~-]*-darwin-x64\.tar\.gz$|node-v26.8.2-darwin-x64.tar.gz|59215598|dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
^node-v[0-9][A-Za-z0-9._+~-]*-win-arm64\.zip$|node-v26.8.2-win-arm64.zip|36945374|eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
^node-v[0-9][A-Za-z0-9._+~-]*-win-x64\.zip$|node-v26.8.2-win-x64.zip|41379367|ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
EOF_OSARCH

printf -- '%s\n' '^node-v[0-9][A-Za-z0-9._+~-]*-darwin-arm64\.tar\.gz$' > "$tmp/range/archive_regex"

rm "$tmp/range/digest_type" || error "cannot remove digest_type fixture"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "Node.js artifact resolution accepted missing SHA-256 policy"; fi
printf -- '%s\n' sha256 > "$tmp/range/digest_type"
printf -- '%s\n' '^unused$' > "$tmp/range/digest_regex"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "unsupported digest_regex was accepted"; fi
rm "$tmp/range/digest_regex" || error "cannot remove digest_regex fixture"

NODEJS_ARTIFACT_MODE=missing-size; export NODEJS_ARTIFACT_MODE
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "artifact without authoritative byte size was accepted"; fi
NODEJS_ARTIFACT_MODE=bad-digest; export NODEJS_ARTIFACT_MODE
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "invalid SHASUMS256 record was accepted"; fi
NODEJS_ARTIFACT_MODE=ambiguous; export NODEJS_ARTIFACT_MODE
printf -- '%s\n' '^node-v26\.8\.2-darwin-arm64\.tar\.gz.*$' > "$tmp/range/archive_regex"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "ambiguous artifact regex was accepted"; fi

NODEJS_ARTIFACT_MODE=draft; export NODEJS_ARTIFACT_MODE
printf -- '%s\n' '^node-v[0-9][A-Za-z0-9._+~-]*-darwin-arm64\.tar\.gz$' > "$tmp/range/archive_regex"
if pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" v26.8.2 >/dev/null 2>&1; then fail "draft GitHub release was accepted for official Node.js artifact resolution"; fi

exit 0
