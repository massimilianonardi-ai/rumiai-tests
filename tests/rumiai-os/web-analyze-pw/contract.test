#!/bin/sh
TEST_ID=rumiai-os/web-analyze-pw/contract.test

fail()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self=$(command -v "$self") || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

dir=$(resolve_test_dir) || error 'cannot locate test directory'
group=${dir%/*}
tests=${group%/*}
suite=${tests%/*}
target_lib=$suite/lib/rumiai-os-target.lib

[ -f "$target_lib" ] || error 'target resolver missing'
. "$target_lib" || error 'target resolver could not load'

root=$(rumiai_test_target_rumiai_os_find "$suite")
status=$?
case "$status" in
  0) : ;;
  1) skip 'rumiai-os target unavailable' ;;
  2) fail 'invalid explicit target' ;;
  *) error 'target resolution failed' ;;
esac

library=$root/lib/sys/js/web-analyze-pw.lib.js
library_manual=$root/res/sys/manual/web-analyze-pw.lib.js

[ ! -e "$root/bin/sys/web-analyze-pw" ] ||
  fail 'unrequested standalone command exists'
[ ! -e "$root/res/sys/manual/web-analyze-pw" ] ||
  fail 'obsolete standalone command manual exists'
[ -f "$library" ] && [ ! -L "$library" ] && [ ! -x "$library" ] ||
  fail 'missing or executable JS library'
[ -f "$library_manual" ] && [ ! -L "$library_manual" ] ||
  fail 'missing library manual'

command -v node >/dev/null 2>&1 ||
  skip 'node unavailable'

node --check "$library" || fail 'JavaScript syntax invalid'
node -e '
 const assert = require("node:assert/strict");
 const api = require(process.argv[1]);
 assert.equal(typeof api.webAnalyzePw, "function");
 assert.equal(typeof api.webAnalyzePwMain, "function");
 api.webAnalyzePwMain([]).then(status =>
 {
   assert.equal(status, 1);
   return api.webAnalyzePwMain(["file:///tmp/not-http", "./analysis"]);
 }).then(status =>
 {
   assert.equal(status, 1);
   return api.webAnalyzePwMain(["https://example.com/"]);
 }).then(status => assert.equal(status, 1)).catch(error =>
 {
   console.error(error);
   process.exitCode = 1;
 });
' "$library" || fail 'JavaScript API / arguments failed'

exit 0
