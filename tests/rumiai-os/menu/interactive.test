#!/bin/sh

TEST_ID=rumiai-os/menu/interactive.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

decode_result()
{
    [ -f "$RUMIAI_MENU_TEST_RESULT" ] || fail "scenario $1 produced no result file"
    result_text=$(cat "$RUMIAI_MENU_TEST_RESULT") || error "cannot read result for scenario $1"
    [ -n "$result_text" ] || fail "scenario $1 produced an empty successful result"
    eval "set -- $result_text" || fail "scenario $1 produced invalid shell serialization"
    RESULT_COUNT=$#
    RESULT_1=${1-}
    RESULT_2=${2-}
    RESULT_3=${3-}
    RESULT_4=${4-}
}

run_scenario()
{
    scenario=$1
    dialogue=$2
    output=$3

    : > "$RUMIAI_MENU_TEST_RESULT" || error "cannot reset result for $scenario"
    : > "$RUMIAI_MENU_TEST_STATUS" || error "cannot reset status for $scenario"
    RUMIAI_MENU_TEST_SCENARIO=$scenario
    export RUMIAI_MENU_TEST_SCENARIO

    rumiai_test_interactive_run "$dialogue" "$output" "$wrapper" || {
        cat "$output" >&2 2>/dev/null || :
        fail "interactive driver failed for $scenario"
    }

    [ -s "$RUMIAI_MENU_TEST_STATUS" ] || fail "scenario $scenario did not record status"
    SCENARIO_STATUS=$(cat "$RUMIAI_MENU_TEST_STATUS") || error "cannot read status for $scenario"
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
menu_group=${test_dir%/*}
rumiai_os_group=${menu_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
interactive_library=$suite_root/lib/interactive.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
[ -f "$interactive_library" ] || error 'interactive helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'
. "$interactive_library" || error 'cannot source interactive helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

menu=$root/bin/sys/menu
[ -x "$menu" ] || fail 'menu command is unavailable'

rumiai_test_interactive_require
status=$?
case $status in
    0) : ;;
    2) skip 'no supported scripted TTY driver is available on this host' ;;
    *) error 'cannot initialize scripted TTY driver' ;;
esac

command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable for PTY cancellation validation'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput cols >/dev/null 2>&1 || skip 'xterm-256color terminfo entry is unavailable'
down=$(TERM=xterm-256color tput kcud1 2>/dev/null) || skip 'Down capability is unavailable'
up=$(TERM=xterm-256color tput kcuu1 2>/dev/null) || skip 'Up capability is unavailable'
backspace=$(TERM=xterm-256color tput kbs 2>/dev/null) || skip 'Backspace capability is unavailable'
[ -n "$down" ] && [ -n "$up" ] || skip 'arrow capabilities are unavailable'
[ -n "$backspace" ] || skip 'Backspace capability is unavailable'

export TERM=xterm-256color

tmp=${TMPDIR:-/tmp}/rumiai-menu-interactive-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

wrapper=$tmp/wrapper
RUMIAI_MENU_TEST_ROOT=$root
RUMIAI_MENU_TEST_COMMAND=$menu
RUMIAI_MENU_TEST_RESULT=$tmp/result
RUMIAI_MENU_TEST_STATUS=$tmp/status
RUMIAI_MENU_TEST_FS=$tmp/fs
export RUMIAI_MENU_TEST_ROOT RUMIAI_MENU_TEST_COMMAND RUMIAI_MENU_TEST_RESULT RUMIAI_MENU_TEST_STATUS RUMIAI_MENU_TEST_FS

mkdir -p "$RUMIAI_MENU_TEST_FS/sub" || error 'cannot prepare filesystem scenario'
: > "$RUMIAI_MENU_TEST_FS/z-file" || error 'cannot prepare filesystem file'
: > "$RUMIAI_MENU_TEST_FS/sub/a file" || error 'cannot prepare first subdirectory file'
: > "$RUMIAI_MENU_TEST_FS/sub/b*file" || error 'cannot prepare second subdirectory file'
mkdir "$RUMIAI_MENU_TEST_FS/.hidden-dir" || error 'cannot prepare hidden directory'
: > "$RUMIAI_MENU_TEST_FS/a-file" || error 'cannot prepare mixed-sort file'
mkdir "$RUMIAI_MENU_TEST_FS/z-dir" || error 'cannot prepare mixed-sort directory'

cat > "$wrapper" <<'EOF_WRAPPER'
#!/bin/sh
case $RUMIAI_MENU_TEST_SCENARIO in
    list-enter)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_LIST_ENTER -- 'single value@:=Single label' > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    list-space-action)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_LIST_SPACE -K space -- \
            'space value@:=Space action' other > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    list-multi)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_LIST_MULTI -M -K x -- \
            'alpha value@:=Alpha' 'star*value@:=Star' third > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    toggle-key)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_TOGGLE -S z -K space -- 'selected value@:=Selected' other > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    fs-browse)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_FS -M -K x -n -c -d "$RUMIAI_MENU_TEST_FS" > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    fs-parent-custom)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_FS_PARENT_CUSTOM -K x -P z -n -c -d "$RUMIAI_MENU_TEST_FS" > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    fs-hidden)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_FS_HIDDEN -K x -n -c -d "$RUMIAI_MENU_TEST_FS" > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    fs-mixed)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_FS_MIXED -K x -n -m -c -d "$RUMIAI_MENU_TEST_FS" > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    cancel)
        "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
            -H MENU_CANCEL -- one two > "$RUMIAI_MENU_TEST_RESULT"
        ;;
    *)
        exit 90
        ;;
esac
child_status=$?
printf '%s\n' "$child_status" > "$RUMIAI_MENU_TEST_STATUS"
exit 0
EOF_WRAPPER
chmod +x "$wrapper" || error 'cannot make interactive wrapper executable'

# Enter returns the current item in list mode.
dialogue=$tmp/list-enter.dialogue
printf '%s\t%s\n' MENU_LIST_ENTER '' > "$dialogue" || error 'cannot create list-enter dialogue'
run_scenario list-enter "$dialogue" "$tmp/list-enter.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "list-enter status is $SCENARIO_STATUS"
decode_result list-enter
[ "$RESULT_COUNT" -eq 2 ] || fail 'list-enter returned wrong argument count'
[ "$RESULT_1" = enter ] || fail "list-enter key is '$RESULT_1'"
[ "$RESULT_2" = 'single value' ] || fail "list-enter value is '$RESULT_2'"
grep -F '[ ]' "$tmp/list-enter.output" >/dev/null 2>&1 &&
    fail 'single-selection rendering unexpectedly showed mark boxes'

# Space is available as an action key when multi-selection is not enabled.
dialogue=$tmp/list-space-action.dialogue
printf '%s\t%s\n' MENU_LIST_SPACE ' ' > "$dialogue" || error 'cannot create list-space-action dialogue'
run_scenario list-space-action "$dialogue" "$tmp/list-space-action.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "list-space-action status is $SCENARIO_STATUS"
decode_result list-space-action
[ "$RESULT_COUNT" -eq 2 ] || fail 'list-space-action returned wrong argument count'
[ "$RESULT_1" = space ] || fail "list-space-action key is '$RESULT_1'"
[ "$RESULT_2" = 'space value' ] || fail "list-space-action value is '$RESULT_2'"

# Mark the second item first, then the first item; output must still follow provider order.
dialogue=$tmp/list-multi.dialogue
list_multi_response="${down} ${up} x"
printf '%s\t%s\n' MENU_LIST_MULTI "$list_multi_response" > "$dialogue" || error 'cannot create list-multi dialogue'
run_scenario list-multi "$dialogue" "$tmp/list-multi.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "list-multi status is $SCENARIO_STATUS"
decode_result list-multi
[ "$RESULT_COUNT" -eq 3 ] || fail 'list-multi returned wrong argument count'
[ "$RESULT_1" = x ] || fail "list-multi key is '$RESULT_1'"
[ "$RESULT_2" = 'alpha value' ] || fail "list-multi first value is '$RESULT_2'"
[ "$RESULT_3" = 'star*value' ] || fail "list-multi second value is '$RESULT_3'"
grep -F '[ ]' "$tmp/list-multi.output" >/dev/null 2>&1 ||
    fail 'multi-selection rendering did not show mark boxes'

# Reassign the toggle key so Space becomes available as an action key.
dialogue=$tmp/toggle-key.dialogue
printf '%s\t%s\n' MENU_TOGGLE 'z ' > "$dialogue" || error 'cannot create toggle-key dialogue'
run_scenario toggle-key "$dialogue" "$tmp/toggle-key.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "toggle-key status is $SCENARIO_STATUS"
decode_result toggle-key
[ "$RESULT_COUNT" -eq 2 ] || fail 'toggle-key returned wrong argument count'
[ "$RESULT_1" = space ] || fail "toggle-key action is '$RESULT_1'"
[ "$RESULT_2" = 'selected value' ] || fail "toggle-key value is '$RESULT_2'"

# Navigation inside an unchanged viewport and a multi-selection toggle must
# repaint only affected rows, without emitting the terminal clear capability.
python3 - "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" <<'PY_INCREMENTAL'
import os
import pty
import select
import subprocess
import sys
import time

m_command, menu_command = sys.argv[1:3]
env = os.environ.copy()
env["TERM"] = "xterm-256color"
clear_seq = subprocess.check_output(["tput", "clear"], env=env)
down = subprocess.check_output(["tput", "kcud1"], env=env)


def run_case(header, extra_args, key, expected_fragment, expected_value):
    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    pid, master = pty.fork()

    if pid == 0:
        os.dup2(out_w, 1)
        os.dup2(err_w, 2)
        for fd in (out_r, err_r, out_w, err_w):
            try:
                os.close(fd)
            except OSError:
                pass
        os.execve(
            m_command,
            [m_command, menu_command, "-H", header, *extra_args, "--", "one", "two", "three"],
            env,
        )

    os.close(out_w)
    os.close(err_w)
    ui = bytearray()
    out = bytearray()
    err = bytearray()

    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)
        if header.encode() in ui and b"> one" in ui:
            break
    else:
        raise AssertionError((header, "initial menu render timed out", bytes(ui), bytes(out), bytes(err)))

    ui.clear()
    os.write(master, key)

    settle = time.monotonic() + 0.35
    while time.monotonic() < settle:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.03)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)

    assert clear_seq not in ui, (
        header,
        "incremental update emitted full-screen clear",
        bytes(ui),
    )
    assert expected_fragment in ui, (
        header,
        "expected incremental row was not rendered",
        expected_fragment,
        bytes(ui),
    )

    os.write(master, b"\n")

    status = None
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = os.waitstatus_to_exitcode(wait_status)
            break

    if status is None:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError((header, "menu did not exit", bytes(ui), bytes(out), bytes(err)))

    for fd, target in ((out_r, out), (err_r, err)):
        while True:
            ready, _, _ = select.select([fd], [], [], 0)
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            target.extend(chunk)

    os.close(out_r)
    os.close(err_r)
    os.close(master)

    assert status == 0, (header, status, bytes(out), bytes(err))
    assert err == b"", (header, status, bytes(out), bytes(err))

    text = out.decode("utf-8", "strict").strip()
    assert expected_value in text, (header, text)


run_case(
    "MENU_INCREMENTAL_MOVE",
    [],
    down,
    b"> two",
    "two",
)
run_case(
    "MENU_INCREMENTAL_TOGGLE",
    ["-M"],
    b" ",
    b"> [x] one",
    "one",
)
PY_INCREMENTAL
status=$?
[ "$status" -eq 0 ] || fail 'incremental menu rendering validation failed'

# Filesystem mode without -K uses Tab as the fallback action in both
# single-selection and multi-selection. When an explicit -K exists, Tab must
# remain inactive rather than becoming an additional implicit action. Use a
# direct PTY because the shared dialogue format itself uses TAB as a record
# separator.
tab_single_result=$tmp/fs-tab-single.result
tab_multi_result=$tmp/fs-tab-multi.result
tab_explicit_result=$tmp/fs-tab-explicit.result
python3 - "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
    "$RUMIAI_MENU_TEST_FS" "$tab_single_result" "$tab_multi_result" \
    "$tab_explicit_result" <<'PY_TAB_CONFIRM'
import os
import pty
import select
import sys
import time

m_command, menu_command, fs_root, single_path, multi_path, explicit_path = sys.argv[1:7]


def run_case(header, multi, extra_args, explicit_action):
    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    pid, master = pty.fork()

    if pid == 0:
        os.dup2(out_w, 1)
        os.dup2(err_w, 2)
        for fd in (out_r, err_r, out_w, err_w):
            try:
                os.close(fd)
            except OSError:
                pass
        env = os.environ.copy()
        env["TERM"] = "xterm-256color"
        argv = [
            m_command,
            menu_command,
            "-H",
            header,
        ]
        if multi:
            argv.append("-M")
        argv.extend([
            "-n",
            "-c",
            *extra_args,
            "-d",
            fs_root,
        ])
        os.execve(m_command, argv, env)

    os.close(out_w)
    os.close(err_w)
    ui = bytearray()
    out = bytearray()
    err = bytearray()

    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline and header.encode() not in ui:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)

    assert header.encode() in ui, (header, bytes(ui), bytes(out), bytes(err))

    # At the confined root, the first visible item is the sub directory.
    if multi:
        os.write(master, b" ")
    os.write(master, b"\t")

    if explicit_action:
        probe_deadline = time.monotonic() + 0.25
        while time.monotonic() < probe_deadline:
            ready, _, _ = select.select([master, out_r, err_r], [], [], 0.02)
            for fd in ready:
                try:
                    chunk = os.read(fd, 4096)
                except OSError:
                    chunk = b""
                if fd == master:
                    ui.extend(chunk)
                elif fd == out_r:
                    out.extend(chunk)
                else:
                    err.extend(chunk)
            waited, wait_status = os.waitpid(pid, os.WNOHANG)
            assert waited == 0, (
                "Tab unexpectedly completed a filesystem menu with explicit -K",
                os.waitstatus_to_exitcode(wait_status),
                bytes(out),
                bytes(err),
            )
        os.write(master, b"x")

    status = None
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = os.waitstatus_to_exitcode(wait_status)
            break

    if status is None:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError((header, "menu confirmation timed out", bytes(out), bytes(err)))

    for fd, target in ((out_r, out), (err_r, err)):
        while True:
            ready, _, _ = select.select([fd], [], [], 0)
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            target.extend(chunk)

    os.close(out_r)
    os.close(err_r)
    os.close(master)

    assert status == 0, (header, status, bytes(out), bytes(err))
    assert err == b"", (header, status, bytes(out), bytes(err))
    return bytes(out)


with open(single_path, "wb") as result:
    result.write(run_case("MENU_FS_TAB_SINGLE", False, [], False))

with open(multi_path, "wb") as result:
    result.write(run_case("MENU_FS_TAB_MULTI", True, [], False))

with open(explicit_path, "wb") as result:
    result.write(run_case("MENU_FS_TAB_EXPLICIT", True, ["-K", "x"], True))
PY_TAB_CONFIRM
status=$?
[ "$status" -eq 0 ] || fail 'filesystem Tab confirmation validation failed'

RUMIAI_MENU_TEST_RESULT=$tab_single_result
decode_result fs-tab-single
[ "$RESULT_COUNT" -eq 2 ] || fail 'fs-tab-single returned wrong argument count'
[ "$RESULT_1" = tab ] || fail "fs-tab-single key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] ||
    fail "fs-tab-single value is '$RESULT_2'"

RUMIAI_MENU_TEST_RESULT=$tab_multi_result
decode_result fs-tab-multi
[ "$RESULT_COUNT" -eq 2 ] || fail 'fs-tab-multi returned wrong argument count'
[ "$RESULT_1" = tab ] || fail "fs-tab-multi key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] ||
    fail "fs-tab-multi value is '$RESULT_2'"

RUMIAI_MENU_TEST_RESULT=$tab_explicit_result
decode_result fs-tab-explicit
[ "$RESULT_COUNT" -eq 2 ] || fail 'fs-tab-explicit returned wrong argument count'
[ "$RESULT_1" = x ] || fail "explicit -K did not suppress Tab fallback: '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] ||
    fail "fs-tab-explicit value is '$RESULT_2'"

RUMIAI_MENU_TEST_RESULT=$tmp/result

# -n + -c must make the visible subdirectory the first directory instead of .. or .hidden-dir.
# Enter browses it; marks inside the new view are returned as absolute paths in view order.
dialogue=$tmp/fs-browse.dialogue
fs_second_response="${down} ${down} x"
printf '%s\t%s\n' \
    "$RUMIAI_MENU_TEST_FS" '' \
    "$RUMIAI_MENU_TEST_FS/sub" "$fs_second_response" > "$dialogue" || error 'cannot create fs-browse dialogue'
run_scenario fs-browse "$dialogue" "$tmp/fs-browse.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "fs-browse status is $SCENARIO_STATUS"
decode_result fs-browse
[ "$RESULT_COUNT" -eq 3 ] || fail 'fs-browse returned wrong argument count'
[ "$RESULT_1" = x ] || fail "fs-browse key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub/a file" ] || fail "fs-browse first path is '$RESULT_2'"
[ "$RESULT_3" = "$RUMIAI_MENU_TEST_FS/sub/b*file" ] || fail "fs-browse second path is '$RESULT_3'"

# Default Backspace is validated with a direct PTY because a line-oriented
# script/Expect dialogue can let the terminal line discipline consume erase.
: > "$RUMIAI_MENU_TEST_RESULT" || error 'cannot reset default-parent result'
python3 - "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" \
    "$RUMIAI_MENU_TEST_FS" "$RUMIAI_MENU_TEST_RESULT" <<'PY_PARENT'
import os
import pty
import select
import subprocess
import sys
import termios
import time

m_command, menu_command, fs_root, result_path = sys.argv[1:5]
out_r, out_w = os.pipe()
err_r, err_w = os.pipe()
pid, master = pty.fork()

if pid == 0:
    os.dup2(out_w, 1)
    os.dup2(err_w, 2)
    for fd in (out_r, err_r, out_w, err_w):
        try:
            os.close(fd)
        except OSError:
            pass
    env = os.environ.copy()
    env["TERM"] = "xterm-256color"
    os.execve(
        m_command,
        [
            m_command,
            menu_command,
            "-H",
            "MENU_FS_PARENT_DEFAULT",
            "-K",
            "x",
            "-n",
            "-c",
            "-d",
            fs_root,
        ],
        env,
    )

os.close(out_w)
os.close(err_w)
ui = bytearray()
out = bytearray()
err = bytearray()


def pump_until(needle, timeout=3.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                ui.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)
        if needle in ui:
            return
    raise AssertionError(("timed out waiting for UI", needle, bytes(ui), bytes(out), bytes(err)))


pump_until(fs_root.encode())
os.write(master, b"\n")
pump_until((fs_root + "/sub").encode())

# Discard the child-view transcript so a later root match cannot be satisfied by
# the root prefix contained in the child path.
ui.clear()
kbs = subprocess.check_output(
    ["tput", "kbs"],
    env={**os.environ, "TERM": "xterm-256color"},
)
os.write(master, kbs)
pump_until(b"> sub")
os.write(master, b"x")

status = None
deadline = time.monotonic() + 3.0
while time.monotonic() < deadline:
    ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
    for fd in ready:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        if fd == master:
            ui.extend(chunk)
        elif fd == out_r:
            out.extend(chunk)
        else:
            err.extend(chunk)

    waited, wait_status = os.waitpid(pid, os.WNOHANG)
    if waited == pid:
        status = os.waitstatus_to_exitcode(wait_status)
        break

if status is None:
    os.kill(pid, 9)
    os.waitpid(pid, 0)
    raise AssertionError("default Backspace parent navigation timed out")

for fd, target in ((out_r, out), (err_r, err)):
    while True:
        ready, _, _ = select.select([fd], [], [], 0)
        if not ready:
            break
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        target.extend(chunk)

attrs = termios.tcgetattr(master)
lflag = attrs[3]
restored = bool(lflag & termios.ICANON) and bool(lflag & termios.ECHO)

os.close(out_r)
os.close(err_r)
os.close(master)

assert status == 0, (status, bytes(out), bytes(err))
assert err == b"", (status, bytes(out), bytes(err))
assert restored, "terminal state was not restored after parent navigation"

with open(result_path, "wb") as result_file:
    result_file.write(out)
PY_PARENT
status=$?
[ "$status" -eq 0 ] || fail 'default Backspace parent-navigation validation failed'
decode_result fs-parent-default
[ "$RESULT_COUNT" -eq 2 ] || fail 'fs-parent-default returned wrong argument count'
[ "$RESULT_1" = x ] || fail "fs-parent-default key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] ||
    fail "Backspace did not return to the parent view: '$RESULT_2'"

# -P replaces Backspace with another parent-navigation key.
dialogue=$tmp/fs-parent-custom.dialogue
printf '%s\t%s\n' \
    "$RUMIAI_MENU_TEST_FS" '' \
    "$RUMIAI_MENU_TEST_FS/sub" 'zx' > "$dialogue" ||
    error 'cannot create fs-parent-custom dialogue'
run_scenario fs-parent-custom "$dialogue" "$tmp/fs-parent-custom.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "fs-parent-custom status is $SCENARIO_STATUS"
decode_result fs-parent-custom
[ "$RESULT_COUNT" -eq 2 ] || fail 'fs-parent-custom returned wrong argument count'
[ "$RESULT_1" = x ] || fail "fs-parent-custom key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] ||
    fail "custom parent key did not return to the parent view: '$RESULT_2'"

# With -n, the first root entry must not be the hidden directory.
dialogue=$tmp/fs-hidden.dialogue
printf '%s\t%s\n' MENU_FS_HIDDEN x > "$dialogue" || error 'cannot create fs-hidden dialogue'
run_scenario fs-hidden "$dialogue" "$tmp/fs-hidden.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "fs-hidden status is $SCENARIO_STATUS"
decode_result fs-hidden
[ "$RESULT_1" = x ] || fail "fs-hidden key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/sub" ] || fail "-n did not hide/sort as expected: '$RESULT_2'"

# With -m, lexical order across types puts a-file before the directories.
dialogue=$tmp/fs-mixed.dialogue
printf '%s\t%s\n' MENU_FS_MIXED x > "$dialogue" || error 'cannot create fs-mixed dialogue'
run_scenario fs-mixed "$dialogue" "$tmp/fs-mixed.output"
[ "$SCENARIO_STATUS" -eq 0 ] || fail "fs-mixed status is $SCENARIO_STATUS"
decode_result fs-mixed
[ "$RESULT_1" = x ] || fail "fs-mixed key is '$RESULT_1'"
[ "$RESULT_2" = "$RUMIAI_MENU_TEST_FS/a-file" ] || fail "-m did not mix lexical order as expected: '$RESULT_2'"

# Escape cancels with status 1, no successful stdout result, and restored TTY state.
python3 - "$RUMIAI_MENU_TEST_ROOT/m" "$RUMIAI_MENU_TEST_COMMAND" <<'PY_CANCEL'
import os
import pty
import select
import sys
import termios
import time

m_command, menu_command = sys.argv[1:3]
out_r, out_w = os.pipe()
err_r, err_w = os.pipe()
pid, master = pty.fork()

if pid == 0:
    os.dup2(out_w, 1)
    os.dup2(err_w, 2)
    for fd in (out_r, err_r, out_w, err_w):
        try:
            os.close(fd)
        except OSError:
            pass
    env = os.environ.copy()
    env["TERM"] = "xterm-256color"
    os.execve(
        m_command,
        [m_command, menu_command, "-H", "MENU_CANCEL", "--", "one", "two"],
        env,
    )

os.close(out_w)
os.close(err_w)

setup_deadline = time.monotonic() + 0.5
while time.monotonic() < setup_deadline:
    ready, _, _ = select.select([master], [], [], 0.02)
    if ready:
        try:
            os.read(master, 4096)
        except OSError:
            pass
        break

os.write(master, b"\x1b")
out = bytearray()
err = bytearray()
status = None
deadline = time.monotonic() + 3.0

while time.monotonic() < deadline:
    ready, _, _ = select.select([out_r, err_r, master], [], [], 0.05)
    for fd in ready:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        if fd == out_r:
            out.extend(chunk)
        elif fd == err_r:
            err.extend(chunk)
    waited, wait_status = os.waitpid(pid, os.WNOHANG)
    if waited == pid:
        status = os.waitstatus_to_exitcode(wait_status)
        break

if status is None:
    os.kill(pid, 9)
    os.waitpid(pid, 0)
    raise AssertionError("menu cancellation timed out")

for fd, target in ((out_r, out), (err_r, err)):
    while True:
        ready, _, _ = select.select([fd], [], [], 0)
        if not ready:
            break
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        target.extend(chunk)

attrs = termios.tcgetattr(master)
lflag = attrs[3]
restored = bool(lflag & termios.ICANON) and bool(lflag & termios.ECHO)

os.close(out_r)
os.close(err_r)
os.close(master)

assert status == 1, (status, bytes(out), bytes(err))
assert out == b"", (status, bytes(out), bytes(err))
assert err == b"", (status, bytes(out), bytes(err))
assert restored, "terminal state was not restored after Escape cancellation"
PY_CANCEL
status=$?
[ "$status" -eq 0 ] || fail 'Escape cancellation validation failed'

exit 0
