#!/bin/sh

TEST_ID="rumiai-os/mk/artifact-restoration.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

trace_count()
{
  file=$1
  if [ -f "$file" ]
  then
    command -p -- awk 'END { print NR }' "$file"
  else
    printf -- '0\n'
  fi
}

sha256_value()
{
  "$root/m" node -e 'const c=require("node:crypto");process.stdout.write(c.createHash("sha256").update(process.argv[1]).digest("hex")+"\n")' "$1"
}

cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "${cache_project-}" ] || command -p -- rm -rf -- "$cache_project" 2>/dev/null || :
  [ -z "${moved_cache_project-}" ] || command -p -- rm -rf -- "$moved_cache_project" 2>/dev/null || :
  if [ -n "${shared_root-}" ] && [ -d "$shared_root" ] && [ -n "${shared_before-}" ] && [ -f "$shared_before" ]
  then
    for shared_entry in "$shared_root"/*
    do
      [ -e "$shared_entry" ] || continue
      shared_name=${shared_entry##*/}
      if ! command -p -- grep -F -x -- "$shared_name" "$shared_before" >/dev/null 2>&1
      then
        command -p -- rm -rf -- "$shared_entry" 2>/dev/null || :
      fi
    done
  fi
  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/mk"
[ -x "$command_path" ] || fail "bin/sys/mk is missing or not executable"
[ -x "$root/bin/sys/state-path" ] || fail "state-path command is missing"

PATH="$root/bin/sys:$PATH"
export PATH

if ! "$root/bin/sys/pkg" default nodejs >/dev/null 2>&1
then
  skip "managed nodejs runtime is not installed/default in the supplied target"
fi

tmp="${TMPDIR:-/tmp}/rumiai-mk-artifact-restoration-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
tmp="$(CDPATH= cd -- "$tmp" 2>/dev/null && pwd -P)" ||
  error "cannot canonicalize temporary directory"

project="$tmp/project"
mkdir -p "$project/src" || error "cannot create project fixture"
printf '%s\n' FILE-ONE > "$project/src/file.txt" || error "cannot create file source"
printf '%s\n' TREE-ONE > "$project/src/tree.txt" || error "cannot create tree source"
printf '%s\n' MULTI-ONE > "$project/src/multi.txt" || error "cannot create multi source"
printf '%s\n' PRODUCER-ONE > "$project/src/producer.txt" || error "cannot create producer source"
printf '%s\n' PROVIDER-A > "$project/src/provider-a.txt" || error "cannot create provider source A"
printf '%s\n' PROVIDER-B > "$project/src/provider-b.txt" || error "cannot create provider source B"

cat > "$project/mk.json" <<'EOF_PROJECT' || error "cannot write artifact project"
{
  "version": 2,
  "goals": {
    "file": ["file"],
    "tree": ["tree"],
    "multi": ["multi"],
    "chain": ["consumer"],
    "provider": ["compile"],
    "observed": ["observe"]
  },
  "collections": {
    "provider-sources": {
      "type": "files",
      "root": "src",
      "include": ["provider-a.txt", "provider-b.txt"]
    }
  },
  "providers": {
    "compile": {
      "type": "map-process",
      "collection": "provider-sources",
      "outputs": {"artifact": {"path": "out/${item}.out"}},
      "incremental": {},
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "mkdir -p \"$(dirname \"$2\")\"; cp \"$1\" \"$2\"; printf '%s\\n' \"$1\" >> provider.trace", "sh", "${item}", "out/${item}.out"]
      }
    }
  },
  "operations": {
    "file": {
      "inputs": {"source": {"path": "src/file.txt"}},
      "incremental": {},
      "outputs": {"artifact": {"path": "out/file.out"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "mkdir -p out; cp src/file.txt out/file.out; printf 'run\\n' >> file.trace"]}
    },
    "tree": {
      "inputs": {"source": {"path": "src/tree.txt"}},
      "incremental": {},
      "outputs": {"artifact": {"path": "out/tree"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "mkdir -p out/tree/sub; cp src/tree.txt out/tree/value; cp src/tree.txt out/tree/sub/tool; chmod 755 out/tree/sub/tool; printf 'run\\n' >> tree.trace"]}
    },
    "multi": {
      "inputs": {"source": {"path": "src/multi.txt"}},
      "incremental": {},
      "outputs": {"first": {"path": "out/multi-a"}, "second": {"path": "out/multi-dir"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "mkdir -p out/multi-dir; cp src/multi.txt out/multi-a; cp src/multi.txt out/multi-dir/b; printf 'run\\n' >> multi.trace"]}
    },
    "producer": {
      "inputs": {"source": {"path": "src/producer.txt"}},
      "incremental": {},
      "outputs": {"artifact": {"path": "out/producer.out"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "mkdir -p out; cp src/producer.txt out/producer.out; printf 'run\\n' >> producer.trace"]}
    },
    "consumer": {
      "inputs": {"generated": {"output": {"operation": "producer", "name": "artifact"}}},
      "incremental": {},
      "outputs": {"artifact": {"path": "out/consumer.out"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "cp out/producer.out out/consumer.out; printf 'run\\n' >> consumer.trace"]}
    },
    "observe": {
      "when": {"op": "eq", "left": {"result": {"operation": "file", "field": "status"}}, "right": 0},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf observed > observed.out"]}
    }
  }
}
EOF_PROJECT

cache_root="$("$root/m" "$root/bin/sys/state-path" user sys mk cache)" ||
  error "cannot resolve mk cache area"
shared_root="$cache_root/shared-artifacts"
shared_before="$tmp/shared-before"
if [ -d "$shared_root" ]
then
  command -p -- ls -1 "$shared_root" > "$shared_before" ||
    error "cannot snapshot pre-existing shared artifact state"
else
  : > "$shared_before" || error "cannot create empty shared-artifact snapshot"
fi
project_key="$(sha256_value "$project")" || error "cannot compute project cache key"
cache_project="$cache_root/projects/$project_key"
command -p -- rm -rf -- "$cache_project" 2>/dev/null || :

"$command_path" --project "$project" file || fail "initial file build failed"
[ "$(trace_count "$project/file.trace")" -eq 1 ] || fail "initial file action did not execute exactly once"
command -p -- rm -f -- "$project/out/file.out" || error "cannot remove file output"
plan="$tmp/file-missing.plan.json"
"$command_path" --project "$project" --plan file > "$plan" || fail "missing-output plan failed"
[ ! -e "$project/out/file.out" ] || fail "MK-77 --plan restored a missing declared output"
"$root/m" node - "$plan" <<'EOF_NODE' || fail "missing-output plan did not remain executable"
const fs=require('node:fs');
const p=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const op=p.operations.find(v=>v.name==='file');
if(!op || op.state!=='ready') process.exit(1);
EOF_NODE
"$command_path" --project "$project" file || fail "file restoration failed"
[ "$(trace_count "$project/file.trace")" -eq 1 ] || fail "MK-76 restoration reran file action"
command -p -- cmp -s "$project/src/file.txt" "$project/out/file.out" ||
  fail "MK-78 restored file bytes do not match successful output"

printf '%s\n' TAMPERED > "$project/out/file.out" || error "cannot tamper file output"
"$command_path" --project "$project" file || fail "tampered file restoration failed"
[ "$(trace_count "$project/file.trace")" -eq 1 ] || fail "tampered output caused action instead of restoration"
command -p -- cmp -s "$project/src/file.txt" "$project/out/file.out" ||
  fail "tampered output was not restored"

"$command_path" --project "$project" tree || fail "initial tree build failed"
command -p -- rm -rf -- "$project/out/tree" || error "cannot remove tree output"
"$command_path" --project "$project" tree || fail "tree restoration failed"
[ "$(trace_count "$project/tree.trace")" -eq 1 ] || fail "directory restoration reran action"
[ "$(cat "$project/out/tree/sub/tool")" = TREE-ONE ] || fail "nested tree artifact bytes were not restored"
"$root/m" node - "$project/out/tree/sub/tool" <<'EOF_NODE' ||
  fail "restored file mode was not preserved"
const fs=require('node:fs');
if((fs.statSync(process.argv[2]).mode & 0o777)!==0o755) process.exit(1);
EOF_NODE

"$command_path" --project "$project" multi || fail "initial multi-output build failed"
command -p -- rm -f -- "$project/out/multi-a" || error "cannot remove first multi output"
command -p -- rm -rf -- "$project/out/multi-dir" || error "cannot remove second multi output"
"$command_path" --project "$project" multi || fail "multi-output restoration failed"
[ "$(trace_count "$project/multi.trace")" -eq 1 ] || fail "multi-output restoration reran action"
[ "$(cat "$project/out/multi-a")" = MULTI-ONE ] || fail "first output not restored"
[ "$(cat "$project/out/multi-dir/b")" = MULTI-ONE ] || fail "second output not restored"

"$command_path" --project "$project" chain || fail "initial output-input chain failed"
producer_before="$(trace_count "$project/producer.trace")"
consumer_before="$(trace_count "$project/consumer.trace")"
command -p -- rm -f -- "$project/out/producer.out" || error "cannot remove producer output"
"$command_path" --project "$project" chain || fail "restored producer chain failed"
[ "$(trace_count "$project/producer.trace")" -eq "$producer_before" ] ||
  fail "restored producer reran action"
[ "$(trace_count "$project/consumer.trace")" -eq "$consumer_before" ] ||
  fail "unchanged output-input consumer reran after producer restoration"
[ "$(cat "$project/out/producer.out")" = PRODUCER-ONE ] ||
  fail "producer output was not restored"

"$command_path" --project "$project" provider || fail "initial provider build failed"
provider_before="$(trace_count "$project/provider.trace")"
[ "$provider_before" -eq 2 ] || fail "provider did not execute both members initially"
command -p -- rm -f -- "$project/out/src/provider-a.txt.out" ||
  error "cannot remove provider member output"
"$command_path" --project "$project" provider || fail "provider member restoration failed"
[ "$(trace_count "$project/provider.trace")" -eq "$provider_before" ] ||
  fail "provider member restoration reran derived action"
[ "$(cat "$project/out/src/provider-a.txt.out")" = PROVIDER-A ] ||
  fail "provider-derived output was not restored"

file_key="$(sha256_value file)" || error "cannot compute file operation key"
file_record="$cache_project/operations/$file_key.json"
[ -f "$file_record" ] || error "cannot locate file freshness record"
file_fingerprint="$("$root/m" node - "$file_record" <<'EOF_NODE'
const fs=require('node:fs');
const value=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
if(typeof value.fingerprint!=='string' || !/^[a-f0-9]{64}$/.test(value.fingerprint)) process.exit(1);
process.stdout.write(value.fingerprint+'\n');
EOF_NODE
)" || error "cannot read file operation fingerprint"
artifact_root="$shared_root/$file_fingerprint"
[ -d "$artifact_root" ] || error "cannot locate shared artifact fingerprint state"
artifact_candidate="$(cat "$artifact_root/current")" || error "cannot read shared artifact selector"
[ -n "$artifact_candidate" ] || error "shared artifact selector is empty"
artifact_payload="$artifact_root/candidates/$artifact_candidate/payload"
payload_file="$(command -p -- find "$artifact_payload" -type f -print | command -p -- head -n 1)" ||
  error "cannot locate shared artifact payload"
[ -n "$payload_file" ] || error "shared artifact payload fixture is missing"
printf '%s\n' CORRUPT > "$payload_file" || error "cannot corrupt artifact fixture"
command -p -- rm -f -- "$project/out/file.out" || error "cannot remove file before corrupt-cache test"
before="$(trace_count "$project/file.trace")"
"$command_path" --project "$project" file || fail "corrupt artifact fallback failed"
[ "$(trace_count "$project/file.trace")" -eq "$((before + 1))" ] ||
  fail "MK-78 corrupt artifact state did not cause ordinary execution"
command -p -- rm -f -- "$project/out/file.out" || error "cannot remove refreshed file output"
before="$(trace_count "$project/file.trace")"
"$command_path" --project "$project" file || fail "post-refresh restoration failed"
[ "$(trace_count "$project/file.trace")" -eq "$before" ] ||
  fail "refreshed artifact state was not reusable"

command -p -- rm -f -- "$project/out/file.out" || error "cannot remove file before result observation"
before="$(trace_count "$project/file.trace")"
"$command_path" --project "$project" observed || fail "result-observed request failed"
[ "$(trace_count "$project/file.trace")" -eq "$((before + 1))" ] ||
  fail "MK-79 result observation incorrectly used restoration-only evidence"
[ -f "$project/observed.out" ] || fail "result observer did not execute"

moved="$tmp/moved"
mkdir -p "$moved/src" || error "cannot create moved checkout fixture"
command -p -- cp -- "$project/src/file.txt" "$moved/src/file.txt" || error "cannot copy moved source"
cat > "$moved/mk.json" <<'EOF_MOVED' || error "cannot write moved project"
{
  "version": 2,
  "goals": {"file": ["file"]},
  "operations": {
    "file": {
      "inputs": {"source": {"path": "src/file.txt"}},
      "incremental": {},
      "outputs": {"artifact": {"path": "out/file.out"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "mkdir -p out; cp src/file.txt out/file.out; printf 'run\\n' >> file.trace"]}
    }
  }
}
EOF_MOVED
moved_key="$(sha256_value "$moved")" || error "cannot compute moved project cache key"
moved_cache_project="$cache_root/projects/$moved_key"
command -p -- rm -rf -- "$moved_cache_project" 2>/dev/null || :
plan="$tmp/moved.plan.json"
"$command_path" --project "$moved" --plan file > "$plan" || fail "moved checkout plan failed"
[ ! -e "$moved/out/file.out" ] || fail "MK-77 moved checkout plan restored artifact"
[ ! -e "$moved_cache_project" ] || fail "moved checkout plan created freshness metadata"
"$command_path" --project "$moved" file || fail "moved checkout shared restore failed"
[ "$(trace_count "$moved/file.trace")" -eq 0 ] ||
  fail "MK-81 moved checkout action ran instead of shared artifact restore"
command -p -- cmp -s "$moved/src/file.txt" "$moved/out/file.out" ||
  fail "MK-81 moved checkout shared artifact bytes are incorrect"
[ -d "$moved_cache_project" ] ||
  fail "MK-79 moved checkout restore did not create project-scoped freshness metadata"

exit 0
