#!/bin/sh

TEST_ID="rumiai-os/mk/refinement.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/mk"
[ -x "$command_path" ] || fail "bin/sys/mk is missing or not executable"

PATH="$root/bin/sys:$PATH"
export PATH

if ! "$root/bin/sys/pkg" default nodejs >/dev/null 2>&1
then
  skip "managed nodejs runtime is not installed/default in the supplied target"
fi

tmp="${TMPDIR:-/tmp}/rumiai-mk-refinement-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
tmp="$(CDPATH= cd -- "$tmp" 2>/dev/null && pwd -P)" || error "cannot canonicalize temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

project="$tmp/project"
mkdir -p "$project/src" || error "cannot create project fixture"
printf -- '%s\n' alpha > "$project/src/a.txt" || error "cannot create source a"
printf -- '%s\n' extra > "$project/src/extra.txt" || error "cannot create source extra"

cat > "$project/mk.json" <<'EOF_PROJECT' || error "cannot write version-2 project configuration"
{
  "version": 2,
  "goals": {
    "generated": ["bundle"],
    "branch": ["small", "large"],
    "fallback": ["preferred-ok", "fallback-op"],
    "state": ["state-present", "state-absent"]
  },
  "collections": {
    "initial": {
      "type": "files",
      "root": "src",
      "suffixes": [".txt"]
    },
    "generated": {
      "type": "files",
      "root": "generated",
      "suffixes": [".txt"],
      "after": ["generate"]
    }
  },
  "providers": {
    "copy-initial": {
      "type": "map-process",
      "collection": "initial",
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "mkdir -p out; cp \"$1\" \"out/${1##*/}\"", "sh", "${item}"]
      }
    },
    "copy-generated": {
      "type": "map-process",
      "collection": "generated",
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "mkdir -p out; cp \"$1\" \"out/g-${1##*/}\"", "sh", "${item}"]
      }
    }
  },
  "operations": {
    "generate": {
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "mkdir -p generated; printf 'beta\\n' > generated/b.txt; printf 'gamma\\n' > generated/c.txt"]
      }
    },
    "bundle": {
      "prerequisites": ["copy-initial", "copy-generated"],
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "printf 'artifact\\n' > bundle.txt"]
      },
      "outputs": {
        "artifact": {"path": "bundle.txt"}
      }
    },
    "small": {
      "when": {
        "op": "lt",
        "left": {"output": {"operation": "bundle", "name": "artifact", "property": "size"}},
        "right": 100
      },
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf small > small.txt"]}
    },
    "large": {
      "when": {
        "op": "gte",
        "left": {"output": {"operation": "bundle", "name": "artifact", "property": "size"}},
        "right": 100
      },
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf large > large.txt"]}
    },
    "attempt": {
      "failure": "continue",
      "action": {"type": "process", "command": "sh", "args": ["-c", "exit 7"]}
    },
    "preferred-ok": {
      "when": {"op": "eq", "left": {"result": {"operation": "attempt", "field": "status"}}, "right": 0}
    },
    "fallback-op": {
      "when": {"op": "ne", "left": {"result": {"operation": "attempt", "field": "status"}}, "right": 0},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf fallback > fallback.txt"]}
    },
    "state-present": {
      "when": {"op": "truthy", "value": {"state": {"path": "marker", "property": "exists"}}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf present > state-present.txt"]}
    },
    "state-absent": {
      "when": {"op": "not", "condition": {"op": "truthy", "value": {"state": {"path": "marker", "property": "exists"}}}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf absent > state-absent.txt"]}
    }
  },
  "profiles": {
    "release": {
      "collections": {
        "initial": {
          "type": "files",
          "root": "src",
          "include": ["a.txt"]
        }
      }
    }
  }
}
EOF_PROJECT

plan="$tmp/generated.plan.json"
"$command_path" --project "$project" --plan generated > "$plan" || fail "version-2 generated-source plan failed"
[ ! -e "$project/generated" ] || fail "--plan executed the generator"

"$root/m" node - "$plan" <<'EOF_NODE' || fail "version-2 plan did not preserve resolved/pending derivation"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const collections = Object.fromEntries(plan.collections.map(value => [value.name, value]));
const providers = Object.fromEntries(plan.providers.map(value => [value.name, value]));
if (plan.version !== 2) process.exit(1);
if (JSON.stringify(collections.initial.items) !== JSON.stringify(['src/a.txt', 'src/extra.txt'])) process.exit(2);
if (collections.generated.state !== 'pending' || JSON.stringify(collections.generated.waitingFor) !== JSON.stringify(['generate'])) process.exit(3);
if (providers['copy-generated'].state !== 'pending') process.exit(4);
if (!plan.operations.some(value => value.name === 'generate' && value.state === 'ready')) process.exit(5);
if (!plan.operations.some(value => value.derived && value.derived.provider === 'copy-initial' && value.derived.item === 'src/a.txt')) process.exit(6);
if (plan.operations.some(value => value.derived && value.derived.provider === 'copy-generated' && value.derived.item)) process.exit(7);
EOF_NODE

"$command_path" --project "$project" generated || fail "generated-source runtime refinement failed"
for file in out/a.txt out/extra.txt out/g-b.txt out/g-c.txt bundle.txt
 do
  [ -f "$project/$file" ] || fail "runtime refinement omitted output: $file"
done

command -p -- rm -f "$project/small.txt" "$project/large.txt" || error "cannot reset branch outputs"
branch_plan="$tmp/branch.plan.json"
"$command_path" --project "$project" --plan branch > "$branch_plan" || fail "output-dependent plan failed"
"$root/m" node - "$branch_plan" <<'EOF_NODE' || fail "output-dependent alternatives were not both preserved"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
for (const name of ['small', 'large']) {
  const operation = plan.operations.find(value => value.name === name);
  if (!operation || operation.state !== 'conditional' || operation.when.state !== 'unknown' || !operation.observes.includes('bundle')) process.exit(1);
}
EOF_NODE
"$command_path" --project "$project" branch || fail "output-dependent branch execution failed"
[ -f "$project/small.txt" ] || fail "small output branch was not selected"
[ ! -e "$project/large.txt" ] || fail "large output branch was selected unexpectedly"

command -p -- rm -f "$project/fallback.txt" || error "cannot reset fallback output"
"$command_path" --project "$project" fallback || fail "result-dependent fallback execution failed"
[ -f "$project/fallback.txt" ] || fail "fallback was not selected after continued non-zero result"

printf -- '%s' x > "$project/marker" || error "cannot create state marker"
command -p -- rm -f "$project/state-present.txt" "$project/state-absent.txt" || error "cannot reset state outputs"
"$command_path" --project "$project" state || fail "state-present branch execution failed"
[ -f "$project/state-present.txt" ] || fail "state-present branch was not selected"
[ ! -e "$project/state-absent.txt" ] || fail "state-absent branch was selected while marker existed"
command -p -- rm -f "$project/marker" "$project/state-present.txt" "$project/state-absent.txt" || error "cannot reset state scenario"
"$command_path" --project "$project" state || fail "state-absent branch execution failed"
[ ! -e "$project/state-present.txt" ] || fail "state-present branch was selected without marker"
[ -f "$project/state-absent.txt" ] || fail "state-absent branch was not selected"

release_plan="$tmp/release.plan.json"
"$command_path" --project "$project" --profile release --plan generated > "$release_plan" || fail "profile collection plan failed"
"$root/m" node - "$release_plan" <<'EOF_NODE' || fail "profile explicit collection subset was not applied"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const collection = plan.collections.find(value => value.name === 'initial');
if (!collection || JSON.stringify(collection.items) !== JSON.stringify(['src/a.txt'])) process.exit(1);
EOF_NODE

# A declared output is current-run evidence, not an arbitrary existing pathname.
stale="$tmp/stale-output"
mkdir "$stale" || error "cannot create stale-output project"
printf -- '%s' stale > "$stale/artifact" || error "cannot create stale output pathname"
cat > "$stale/mk.json" <<'EOF_STALE' || error "cannot write stale-output configuration"
{
  "version": 2,
  "goals": {"check": ["observe"]},
  "operations": {
    "produce": {
      "failure": "continue",
      "action": {"type": "process", "command": "sh", "args": ["-c", "exit 9"]},
      "outputs": {"artifact": {"path": "artifact"}}
    },
    "observe": {
      "when": {"op": "truthy", "value": {"output": {"operation": "produce", "name": "artifact", "property": "exists"}}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf bad > observed"]}
    }
  }
}
EOF_STALE
"$command_path" --project "$stale" check || fail "failed-producer output observation did not resolve"
[ ! -e "$stale/observed" ] || fail "stale output pathname was treated as current producer output"

cycle="$tmp/cycle"
mkdir "$cycle" || error "cannot create dynamic cycle project"
cat > "$cycle/mk.json" <<'EOF_CYCLE' || error "cannot write dynamic cycle configuration"
{
  "version": 2,
  "goals": {"cycle": ["a"]},
  "operations": {
    "a": {"prerequisites": ["b"]},
    "b": {"prerequisites": ["a"]}
  }
}
EOF_CYCLE
"$command_path" --project "$cycle" --plan cycle >/dev/null 2>&1
status=$?
[ "$status" -eq 1 ] || fail "version-2 dependency cycle returned status $status, expected 1"


# A skipped producer does not satisfy a generated-collection after barrier.
skipped="$tmp/skipped-after"
mkdir -p "$skipped/generated" || error "cannot create skipped-after project"
printf -- '%s\n' stale > "$skipped/generated/stale.txt" || error "cannot create stale generated source"
cat > "$skipped/mk.json" <<'EOF_SKIPPED' || error "cannot write skipped-after configuration"
{
  "version": 2,
  "goals": {"check": ["consume"]},
  "collections": {
    "generated": {"type": "files", "root": "generated", "after": ["generate"]}
  },
  "providers": {
    "consume": {
      "type": "map-process",
      "collection": "generated",
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf '%s\\n' \"$1\" >> consumed", "sh", "${item}"]}
    }
  },
  "operations": {
    "generate": {
      "when": {"op": "truthy", "value": false},
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf new > generated/new.txt"]}
    }
  }
}
EOF_SKIPPED
"$command_path" --project "$skipped" --plan check > "$tmp/skipped.plan.json" || fail "skipped-after plan failed"
"$root/m" node - "$tmp/skipped.plan.json" <<'EOF_NODE' || fail "skipped producer incorrectly unlocked generated collection"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const collection = plan.collections.find(value => value.name === 'generated');
const provider = plan.providers.find(value => value.name === 'consume');
const generator = plan.operations.find(value => value.name === 'generate');
if (!collection || collection.state !== 'pending' || JSON.stringify(collection.waitingFor) !== JSON.stringify(['generate'])) process.exit(1);
if (!provider || provider.state !== 'pending' || provider.operations.length !== 0) process.exit(2);
if (!generator || generator.state !== 'skipped') process.exit(3);
if (plan.operations.some(value => value.derived && value.derived.item === 'generated/stale.txt')) process.exit(4);
EOF_NODE

# Provider prerequisites remain real prerequisites even when the mapped collection is empty.
empty_provider="$tmp/empty-provider"
mkdir -p "$empty_provider/empty" || error "cannot create empty-provider project"
cat > "$empty_provider/mk.json" <<'EOF_EMPTY_PROVIDER' || error "cannot write empty-provider configuration"
{
  "version": 2,
  "goals": {"check": ["mapped"]},
  "collections": {"empty": {"type": "files", "root": "empty"}},
  "providers": {
    "mapped": {
      "type": "map-process",
      "collection": "empty",
      "prerequisites": ["prepare"],
      "action": {"type": "process", "command": "sh", "args": ["-c", "exit 99"]}
    }
  },
  "operations": {
    "prepare": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf prepared > prepared"]}}
  }
}
EOF_EMPTY_PROVIDER
"$command_path" --project "$empty_provider" check || fail "empty provider prerequisite execution failed"
[ -f "$empty_provider/prepared" ] || fail "empty provider bypassed its prerequisite"

exit 0
