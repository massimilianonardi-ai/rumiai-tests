#!/bin/sh

TEST_ID="rumiai-os/mk/requirement.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "unexpected status $actual, expected $expected: $*"
}

sha256_value()
{
  "$root/m" node -e 'const crypto=require("node:crypto");process.stdout.write(crypto.createHash("sha256").update(process.argv[1]).digest("hex")+"\\n")' "$1"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ -n "${facility-}" ]
  then
    run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  fi
  if [ -n "${provider-}" ]
  then
    run_pkg default -u -- "$provider" >/dev/null 2>&1 || :
    run_pkg uninstall "$provider@1" >/dev/null 2>&1 || :
    run_pkg uninstall "$provider@2" >/dev/null 2>&1 || :
  fi
  [ -z "${cache_project-}" ] || rm -rf "$cache_project" 2>/dev/null || :
  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/mk"
[ -x "$command_path" ] || fail "bin/sys/mk is missing or not executable"
[ -x "$root/m" ] || fail "m bootstrap is missing"
[ -x "$root/bin/sys/pkg" ] || fail "pkg command is missing"
[ -x "$root/bin/sys/state-path" ] || fail "state-path command is missing"
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail "pkg integration library is missing"

PATH="$root/bin/sys:$PATH"
export PATH

if ! "$root/bin/sys/pkg" default nodejs >/dev/null 2>&1
then
  skip "managed nodejs runtime is not installed/default in the supplied target"
fi

tmp="${TMPDIR:-/tmp}/rumiai-mk-requirement-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
tmp="$(CDPATH= cd -- "$tmp" 2>/dev/null && pwd -P)" || error "cannot canonicalize temporary directory"

pkg_store_created=0
if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error "cannot create package store for requirement fixture"
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail "package store is not a real directory"

facility=mkreqfacility$$
provider=mkreqprovider$$

driver="$tmp/integration-driver"
cat > "$driver" <<'EOF_DRIVER' || error "cannot write integration driver"
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
pkg_integrate "$@"
EOF_DRIVER
chmod 700 "$driver" || error "cannot make integration driver executable"

range="$tmp/range"
payload="$tmp/payload"
mkdir "$range" "$payload" || error "cannot create provider fixture"
printf -- '%s\n' tar.xz > "$range/format" || error "cannot define provider format"
printf -- '%s %s\n' "$facility" 21 > "$range/facility" || error "cannot define provider facility"
printf -- '%s\n' provider > "$payload/marker" || error "cannot create provider payload"
"$root/m" "$driver" "$provider" 1 "$range" "$payload" > "$tmp/integrate.out" 2> "$tmp/integrate.err" || {
  cat "$tmp/integrate.err" >&2
  error "cannot integrate synthetic requirement provider"
}
run_pkg default "$provider@1" >/dev/null 2> "$tmp/provider-default.err" ||
  error "cannot select synthetic provider package default"

project="$tmp/project"
mkdir -p "$project/src" || error "cannot create project fixture"
printf -- '%s\n' source > "$project/src/input.txt" || error "cannot create source fixture"

cat > "$project/mk.json" <<EOF_PROJECT || error "cannot write requirement project"
{
  "version": 2,
  "goals": {
    "docs": ["docs"],
    "build": ["compile"],
    "incremental": ["incremental"],
    "mapped": ["mapped"],
    "impossible": ["impossible"]
  },
  "requirements": {
    "tool": {
      "type": "facility",
      "facility": "$facility",
      "constraints": [">=21", "<26"]
    },
    "too-new": {
      "type": "facility",
      "facility": "$facility",
      "constraints": [">25"]
    }
  },
  "collections": {
    "sources": {
      "type": "files",
      "root": "src"
    }
  },
  "providers": {
    "mapped": {
      "type": "map-process",
      "collection": "sources",
      "prerequisites": ["enable-mapped"],
      "requirements": ["tool"],
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "printf mapped > mapped.marker"]
      }
    }
  },
  "operations": {
    "docs": {
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf docs > docs.marker"]}
    },
    "enable-build": {
      "action": {
        "type": "process",
        "command": "$root/m",
        "args": ["$root/bin/sys/pkg", "provider", "default", "$facility", "$provider"]
      }
    },
    "compile": {
      "prerequisites": ["enable-build"],
      "requirements": ["tool"],
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf compiled > compile.marker"]}
    },
    "incremental": {
      "requirements": ["tool"],
      "incremental": {
        "inputs": {
          "source": {"path": "src/input.txt"}
        }
      },
      "action": {
        "type": "process",
        "command": "sh",
        "args": ["-c", "printf 'run\\n' >> incremental.trace; cp src/input.txt incremental.out"]
      },
      "outputs": {
        "artifact": {"path": "incremental.out"}
      }
    },
    "enable-mapped": {
      "action": {
        "type": "process",
        "command": "$root/m",
        "args": ["$root/bin/sys/pkg", "provider", "default", "$facility", "$provider"]
      }
    },
    "impossible": {
      "requirements": ["too-new"],
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf bad > impossible.marker"]}
    }
  },
  "profiles": {
    "strict": {
      "requirements": {
        "tool": {
          "type": "facility",
          "facility": "$facility",
          "constraints": [">25"]
        }
      }
    }
  }
}
EOF_PROJECT

cache_root="$("$root/m" "$root/bin/sys/state-path" user sys mk cache)" ||
  error "cannot resolve mk cache area"
project_key="$(sha256_value "$project")" || error "cannot compute project cache key"
cache_project="$cache_root/projects/$project_key"

expect_status 1 run_pkg provider default "$facility"

docs_plan="$tmp/docs.plan.json"
"$command_path" --project "$project" --plan docs > "$docs_plan" || fail "MK-38 unreachable-requirement plan failed"
"$root/m" node - "$docs_plan" <<'EOF_NODE' || fail "MK-38 unreachable requirement appeared in plan"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
if (!Array.isArray(plan.requirements) || plan.requirements.length !== 0) process.exit(1);
const docs = plan.operations.find(value => value.name === 'docs');
if (!docs || docs.state !== 'ready') process.exit(2);
EOF_NODE
expect_status 1 run_pkg provider default "$facility"
[ ! -e "$project/docs.marker" ] || fail "plan inspection executed docs action"

build_plan="$tmp/build-unsatisfied.plan.json"
"$command_path" --project "$project" --plan build > "$build_plan" ||
  fail "MK-42 unsatisfied requirement plan failed"
"$root/m" node - "$build_plan" "$facility" <<'EOF_NODE' || fail "MK-42 unsatisfied requirement was not preserved in plan"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const req = plan.requirements.find(value => value.name === 'tool');
const compile = plan.operations.find(value => value.name === 'compile');
const enable = plan.operations.find(value => value.name === 'enable-build');
if (!req || req.facility !== process.argv[3] || req.state !== 'unsatisfied' || req.provider !== null) process.exit(1);
if (!compile || compile.state !== 'blocked' || !compile.unsatisfiedRequirements.includes('tool')) process.exit(2);
if (!enable || enable.state !== 'ready') process.exit(3);
EOF_NODE
expect_status 1 run_pkg provider default "$facility"

"$command_path" --project "$project" build ||
  fail "MK-42 runtime requirement refinement failed"
[ -f "$project/compile.marker" ] || fail "consumer action did not run after requirement became satisfied"
selected="$(run_pkg provider default "$facility" 2> "$tmp/default-after-build.err")" ||
  fail "enable-build did not configure facility default"
[ "$selected" = "$provider" ] || fail "enable-build configured unexpected facility selector"

satisfied_plan="$tmp/build-satisfied.plan.json"
"$command_path" --project "$project" --plan build > "$satisfied_plan" ||
  fail "MK-43 satisfied requirement plan failed"
"$root/m" node - "$satisfied_plan" "$provider@1" <<'EOF_NODE' || fail "MK-43 selected provider was not exposed by the plan"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const req = plan.requirements.find(value => value.name === 'tool');
if (!req || req.state !== 'satisfied' || req.provider !== process.argv[3]) process.exit(1);
EOF_NODE

# MK-47: the concrete provider selected for a facility requirement is part of
# incremental identity even when project inputs/action are otherwise unchanged.
"$command_path" --project "$project" incremental ||
  fail "initial requirement-backed incremental execution failed"
[ "$(command -p -- awk 'END { print NR }' "$project/incremental.trace")" -eq 1 ] ||
  fail "initial requirement-backed incremental action did not run"
"$command_path" --project "$project" incremental ||
  fail "unchanged requirement-backed incremental execution failed"
[ "$(command -p -- awk 'END { print NR }' "$project/incremental.trace")" -eq 1 ] ||
  fail "unchanged requirement provider did not produce up-to-date operation"

range2="$tmp/range2"
payload2="$tmp/payload2"
mkdir "$range2" "$payload2" || error "cannot create provider v2 fixture"
printf -- '%s\n' tar.xz > "$range2/format" || error "cannot define provider v2 format"
printf -- '%s %s\n' "$facility" 21 > "$range2/facility" ||
  error "cannot define provider v2 facility"
printf -- '%s\n' provider-v2 > "$payload2/marker" ||
  error "cannot create provider v2 payload"
"$root/m" "$driver" "$provider" 2 "$range2" "$payload2" > "$tmp/integrate-v2.out" 2> "$tmp/integrate-v2.err" || {
  cat "$tmp/integrate-v2.err" >&2
  error "cannot integrate synthetic requirement provider v2"
}
run_pkg default "$provider@2" >/dev/null 2> "$tmp/provider-v2-default.err" ||
  error "cannot move synthetic provider package default to v2"

provider_changed_plan="$tmp/provider-changed.plan.json"
"$command_path" --project "$project" --plan incremental > "$provider_changed_plan" ||
  fail "provider-changed incremental plan failed"
"$root/m" node - "$provider_changed_plan" "$provider@2" <<'EOF_NODE' || fail "MK-47 provider identity change did not invalidate incremental freshness"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const req = plan.requirements.find(value => value.name === 'tool');
const op = plan.operations.find(value => value.name === 'incremental');
if (!req || req.provider !== process.argv[3]) process.exit(1);
if (!op || op.state !== 'ready') process.exit(2);
EOF_NODE
"$command_path" --project "$project" incremental ||
  fail "provider-changed incremental execution failed"
[ "$(command -p -- awk 'END { print NR }' "$project/incremental.trace")" -eq 2 ] ||
  fail "MK-47 provider concrete change did not rerun incremental operation"

strict_plan="$tmp/strict.plan.json"
"$command_path" --project "$project" --profile strict --plan build > "$strict_plan" ||
  fail "profile requirement plan failed"
"$root/m" node - "$strict_plan" <<'EOF_NODE' || fail "profile did not replace the named requirement"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const req = plan.requirements.find(value => value.name === 'tool');
if (!req || JSON.stringify(req.constraints) !== JSON.stringify(['>25']) || req.state !== 'unsatisfied') process.exit(1);
EOF_NODE

run_pkg provider default -u -- "$facility" >/dev/null 2> "$tmp/default-before-mapped.err" ||
  error "cannot reset facility default before provider requirement scenario"
command -p -- rm -f "$project/mapped.marker" || error "cannot reset mapped marker"
"$command_path" --project "$project" mapped ||
  fail "MK-38 provider requirement refinement failed"
[ -f "$project/mapped.marker" ] || fail "provider-derived action did not run after requirement became satisfied"

command -p -- rm -f "$project/impossible.marker" || error "cannot reset impossible marker"
expect_status 1 "$command_path" --project "$project" impossible
[ ! -e "$project/impossible.marker" ] ||
  fail "MK-41 unsatisfied requirement allowed its consumer action to execute"

exit 0
