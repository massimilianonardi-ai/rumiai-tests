#!/bin/sh

TEST_ID="rumiai-os/mk/project-dependency.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "unexpected status $actual, expected $expected: $*"
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/mk"
[ -x "$command_path" ] || fail "bin/sys/mk is missing or not executable"

PATH="$root/bin/sys:$PATH"
export PATH

if ! "$root/bin/sys/pkg" default nodejs >/dev/null 2>&1
then
  skip "managed nodejs runtime is not installed/default in the supplied target"
fi

tmp="${TMPDIR:-/tmp}/rumiai-mk-project-dependency-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
tmp="$(CDPATH= cd -- "$tmp" 2>/dev/null && pwd -P)" || error "cannot canonicalize temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

trace="$tmp/trace"
TRACE_FILE="$trace"
export TRACE_FILE

mkdir "$tmp/A" "$tmp/B" "$tmp/C" || error "cannot create recursive dependency fixtures"

cat > "$tmp/C/mk.json" <<'EOF_C' || error "cannot write C configuration"
{
  "version": 2,
  "goals": {"assemble": ["assemble"]},
  "operations": {
    "assemble": {
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf 'C\\n' >> \"$TRACE_FILE\""]}
    }
  }
}
EOF_C

cat > "$tmp/B/mk.json" <<'EOF_B' || error "cannot write B configuration"
{
  "version": 2,
  "environment": {"MODE": "child-base"},
  "goals": {"compile": ["compile"], "verify": ["verify"]},
  "dependencies": {
    "c": {"project": "../C", "goals": {"compile": ["assemble"]}}
  },
  "operations": {
    "prepare": {
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf 'B-prepare:%s\\n' \"$MODE\" >> \"$TRACE_FILE\""]}
    },
    "compile": {
      "prerequisites": ["prepare"],
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf 'B-compile:%s\\n' \"$MODE\" >> \"$TRACE_FILE\""]}
    },
    "verify": {
      "prerequisites": ["prepare"],
      "action": {"type": "process", "command": "sh", "args": ["-c", "printf 'B-verify:%s\\n' \"$MODE\" >> \"$TRACE_FILE\""]}
    }
  },
  "profiles": {
    "release": {"environment": {"MODE": "child-release"}}
  }
}
EOF_B

cat > "$tmp/A/mk.json" <<'EOF_A' || error "cannot write A configuration"
{
  "version": 2,
  "environment": {"MODE": "parent-base"},
  "goals": {"build": ["build"], "check": ["check"]},
  "dependencies": {
    "b": {"project": "../B", "goals": {"build": ["compile"], "check": ["verify"]}}
  },
  "operations": {
    "build": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf 'A-build:%s\\n' \"$MODE\" >> \"$TRACE_FILE\""]}},
    "check": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf 'A-check:%s\\n' \"$MODE\" >> \"$TRACE_FILE\""]}}
  },
  "profiles": {
    "parent-release": {"environment": {"MODE": "parent-release"}}
  }
}
EOF_A

"$command_path" --project "$tmp/A" build || fail "recursive project dependency execution failed"
cat > "$tmp/expected" <<'EOF_EXPECTED'
C
B-prepare:child-base
B-compile:child-base
A-build:parent-base
EOF_EXPECTED
command -p -- cmp -s "$tmp/expected" "$trace" || fail "MK-28/MK-29/MK-33 recursive child-before-parent execution is incorrect"

command -p -- rm -f "$trace" || error "cannot reset trace"
"$command_path" --project "$tmp/A" --profile parent-release build || fail "parent profile dependency execution failed"
cat > "$tmp/expected" <<'EOF_EXPECTED'
C
B-prepare:child-base
B-compile:child-base
A-build:parent-release
EOF_EXPECTED
command -p -- cmp -s "$tmp/expected" "$trace" || fail "MK-30 parent profile leaked into child project"

command -p -- rm -f "$trace" || error "cannot reset trace"
"$command_path" --project "$tmp/A" build check || fail "multi-goal dependency execution failed"
cat > "$tmp/expected" <<'EOF_EXPECTED'
C
B-prepare:child-base
B-compile:child-base
B-verify:child-base
A-build:parent-base
A-check:parent-base
EOF_EXPECTED
command -p -- cmp -s "$tmp/expected" "$trace" || fail "MK-32 direct child request did not aggregate mapped child goals"

mkdir "$tmp/P" || error "cannot create explicit-profile fixture"
cat > "$tmp/P/mk.json" <<'EOF_P' || error "cannot write P configuration"
{
  "version": 2,
  "goals": {"build": ["done"]},
  "dependencies": {
    "b": {"project": "../B", "goals": {"build": ["compile"]}}
  },
  "operations": {
    "done": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf 'P\\n' >> \"$TRACE_FILE\""]}}
  },
  "profiles": {
    "release": {
      "dependencies": {
        "b": {"project": "../B", "goals": {"build": ["compile"]}, "profile": "release"}
      }
    }
  }
}
EOF_P
command -p -- rm -f "$trace" || error "cannot reset trace"
"$command_path" --project "$tmp/P" --profile release build || fail "explicit child profile execution failed"
cat > "$tmp/expected" <<'EOF_EXPECTED'
C
B-prepare:child-release
B-compile:child-release
P
EOF_EXPECTED
command -p -- cmp -s "$tmp/expected" "$trace" || fail "MK-30 explicit child profile was not selected"

command -p -- rm -f "$trace" || error "cannot reset trace"
plan="$tmp/plan.json"
"$command_path" --project "$tmp/A" --plan build > "$plan" || fail "nested dependency plan failed"
[ ! -e "$trace" ] || fail "MK-34 dependency plan executed lifecycle work"
"$root/m" node - "$plan" "$tmp/A" "$tmp/B" "$tmp/C" <<'EOF_NODE' || fail "MK-34 nested project plan is incorrect"
const fs = require('fs');
const plan = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const canonical = value => fs.realpathSync(value);
if (plan.version !== 2 || !Array.isArray(plan.dependencies) || plan.dependencies.length !== 1) process.exit(1);
const b = plan.dependencies[0];
if (b.name !== 'b' || canonical(b.project) !== canonical(process.argv[4])) process.exit(2);
if (JSON.stringify(b.goals) !== JSON.stringify(['compile']) || b.profile !== null) process.exit(3);
if (!b.plan || b.plan.version !== 2 || !Array.isArray(b.plan.dependencies) || b.plan.dependencies.length !== 1) process.exit(4);
const c = b.plan.dependencies[0];
if (c.name !== 'c' || canonical(c.project) !== canonical(process.argv[5])) process.exit(5);
if (JSON.stringify(c.goals) !== JSON.stringify(['assemble'])) process.exit(6);
EOF_NODE

mkdir "$tmp/X" "$tmp/Y" || error "cannot create cycle fixtures"
cat > "$tmp/X/mk.json" <<'EOF_X' || error "cannot write X configuration"
{"version":2,"goals":{"build":[]},"dependencies":{"y":{"project":"../Y","goals":{"build":["build"]}}}}
EOF_X
cat > "$tmp/Y/mk.json" <<'EOF_Y' || error "cannot write Y configuration"
{"version":2,"goals":{"build":[]},"dependencies":{"x":{"project":"../X","goals":{"build":["build"]}}}}
EOF_Y
expect_status 1 "$command_path" --project "$tmp/X" build
expect_status 1 "$command_path" --project "$tmp/X" --plan build

mkdir "$tmp/F" "$tmp/PF" || error "cannot create failure fixtures"
cat > "$tmp/F/mk.json" <<'EOF_F' || error "cannot write F configuration"
{"version":2,"goals":{"fail":["fail"]},"operations":{"fail":{"action":{"type":"process","command":"sh","args":["-c","exit 7"]}}}}
EOF_F
cat > "$tmp/PF/mk.json" <<'EOF_PF' || error "cannot write PF configuration"
{
  "version": 2,
  "goals": {"build": ["local"]},
  "dependencies": {"f": {"project": "../F", "goals": {"build": ["fail"]}}},
  "operations": {"local": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf bad > local-ran"]}}}
}
EOF_PF
expect_status 1 "$command_path" --project "$tmp/PF" build
[ ! -e "$tmp/PF/local-ran" ] || fail "MK-33 parent local work ran after child dependency failure"

mkdir "$tmp/D" "$tmp/DB" "$tmp/DC" "$tmp/DA" || error "cannot create diamond fixtures"
cat > "$tmp/D/mk.json" <<'EOF_D' || error "cannot write D configuration"
{"version":2,"goals":{"build":["build"]},"operations":{"build":{"action":{"type":"process","command":"sh","args":["-c","printf 'D\\n' >> \"$TRACE_FILE\""]}}}}
EOF_D
cat > "$tmp/DB/mk.json" <<'EOF_DB' || error "cannot write DB configuration"
{"version":2,"goals":{"build":["build"]},"dependencies":{"d":{"project":"../D","goals":{"build":["build"]}}},"operations":{"build":{"action":{"type":"process","command":"sh","args":["-c","printf 'DB\\n' >> \"$TRACE_FILE\""]}}}}
EOF_DB
cat > "$tmp/DC/mk.json" <<'EOF_DC' || error "cannot write DC configuration"
{"version":2,"goals":{"build":["build"]},"dependencies":{"d":{"project":"../D","goals":{"build":["build"]}}},"operations":{"build":{"action":{"type":"process","command":"sh","args":["-c","printf 'DC\\n' >> \"$TRACE_FILE\""]}}}}
EOF_DC
cat > "$tmp/DA/mk.json" <<'EOF_DA' || error "cannot write DA configuration"
{
  "version": 2,
  "goals": {"build": ["build"]},
  "dependencies": {
    "b": {"project": "../DB", "goals": {"build": ["build"]}},
    "c": {"project": "../DC", "goals": {"build": ["build"]}}
  },
  "operations": {"build": {"action": {"type": "process", "command": "sh", "args": ["-c", "printf 'DA\\n' >> \"$TRACE_FILE\""]}}}
}
EOF_DA
command -p -- rm -f "$trace" || error "cannot reset trace"
"$command_path" --project "$tmp/DA" build || fail "diamond project dependency execution failed"
cat > "$tmp/expected" <<'EOF_EXPECTED'
D
DB
D
DC
DA
EOF_EXPECTED
command -p -- cmp -s "$tmp/expected" "$trace" || fail "MK-35 diamond dependency unexpectedly acquired request-wide de-duplication"

exit 0
