#!/bin/sh

TEST_ID="rumiai-os/mk/provider-incremental.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

trace_count()
{
  if [ -f "$trace" ]
  then
    command -p -- awk 'END { print NR }' "$trace"
  else
    printf -- '0\n'
  fi
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] ||
    fail "unexpected status $actual, expected $expected: $*"
}

cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "${cache_project-}" ] || command -p -- rm -rf -- "$cache_project" 2>/dev/null || :
  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/mk"
[ -x "$command_path" ] || fail "bin/sys/mk is missing or not executable"
[ -x "$root/bin/sys/state-path" ] || fail "state-path command is missing"

PATH="$root/bin/sys:$PATH"
export PATH

if ! "$root/bin/sys/pkg" default nodejs >/dev/null 2>&1
then
  skip "managed nodejs runtime is not installed/default in the supplied target"
fi

tmp="${TMPDIR:-/tmp}/rumiai-mk-provider-incremental-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
tmp="$(CDPATH= cd -- "$tmp" 2>/dev/null && pwd -P)" ||
  error "cannot canonicalize temporary directory"

project="$tmp/project"
mkdir -p "$project/src" "$project/cfg/src" || error "cannot create project fixture"
printf -- '%s\n' alpha > "$project/src/a.txt" || error "cannot create source a"
printf -- '%s\n' beta > "$project/src/b.txt" || error "cannot create source b"
printf -- '%s\n' cfg-a > "$project/cfg/src/a.txt.cfg" || error "cannot create config a"
printf -- '%s\n' cfg-b > "$project/cfg/src/b.txt.cfg" || error "cannot create config b"

trace="$project/trace"
TRACE_FILE="$trace"
export TRACE_FILE

cat > "$project/mk.json" <<'EOF_PROJECT' || error "cannot write provider incremental project"
{
  "version": 2,
  "goals": {
    "build": ["compile"],
    "ordinary": ["copy"]
  },
  "collections": {
    "sources": {
      "type": "files",
      "root": "src",
      "suffixes": [".txt"]
    }
  },
  "providers": {
    "compile": {
      "type": "map-process",
      "collection": "sources",
      "inputs": {
        "config": {"path": "cfg/${item}.cfg"}
      },
      "outputs": {
        "artifact": {"path": "out/${item}.out"}
      },
      "incremental": {},
      "action": {
        "type": "process",
        "command": "sh",
        "args": [
          "-c",
          "mkdir -p \"$(dirname \"$2\")\"; printf '%s\\n' \"$1\" >> \"$TRACE_FILE\"; cat \"$1\" \"$3\" > \"$2\"",
          "sh",
          "${item}",
          "out/${item}.out",
          "cfg/${item}.cfg"
        ]
      }
    },
    "copy": {
      "type": "map-process",
      "collection": "sources",
      "inputs": {
        "config": {"path": "cfg/${item}.cfg"}
      },
      "outputs": {
        "artifact": {"path": "ordinary/${item}.out"}
      },
      "action": {
        "type": "process",
        "command": "sh",
        "args": [
          "-c",
          "mkdir -p \"$(dirname \"$2\")\"; printf 'ordinary:%s\\n' \"$1\" >> \"$TRACE_FILE\"; cat \"$1\" \"$3\" > \"$2\"",
          "sh",
          "${item}",
          "ordinary/${item}.out",
          "cfg/${item}.cfg"
        ]
      }
    }
  }
}
EOF_PROJECT

cache_root="$("$root/m" "$root/bin/sys/state-path" user sys mk cache)" ||
  error "cannot resolve mk cache area"
project_key="$("$root/m" node -e 'const c=require("node:crypto");process.stdout.write(c.createHash("sha256").update(process.argv[1]).digest("hex")+"\n")' "$project")" ||
  error "cannot compute project cache key"
cache_project="$cache_root/projects/$project_key"
command -p -- rm -rf -- "$cache_project" 2>/dev/null || :

plan="$tmp/initial.plan.json"
"$command_path" --project "$project" --plan build > "$plan" ||
  fail "initial provider incremental plan failed"
"$root/m" node - "$plan" <<'EOF_NODE' ||
  fail "MK-69/MK-70/MK-72 provider plan identity is incorrect"
const fs=require('node:fs');
const plan=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const members=plan.operations.filter(value=>value.derived && value.derived.provider==='compile');
if(members.length!==2) process.exit(1);
for(const op of members){
  if(op.state!=='ready') process.exit(2);
  const item=op.derived.item;
  if(!op.inputs || !op.inputs['$item'] || op.inputs['$item'].type!=='path' || op.inputs['$item'].path!==item) process.exit(3);
  if(!op.inputs.config || op.inputs.config.type!=='path' || op.inputs.config.path!==`cfg/${item}.cfg`) process.exit(4);
}
EOF_NODE

before="$(trace_count)"
"$command_path" --project "$project" build || fail "initial provider incremental execution failed"
after="$(trace_count)"
[ "$after" -eq "$((before + 2))" ] ||
  fail "MK-69 initial provider execution did not run each derived member exactly once"
[ -f "$project/out/src/a.txt.out" ] && [ -f "$project/out/src/b.txt.out" ] ||
  fail "MK-72 templated provider outputs were not produced"

plan="$tmp/hit.plan.json"
"$command_path" --project "$project" --plan build > "$plan" ||
  fail "provider up-to-date plan failed"
"$root/m" node - "$plan" <<'EOF_NODE' ||
  fail "MK-71 derived members did not become independently up-to-date"
const fs=require('node:fs');
const plan=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
const provider=plan.providers.find(value=>value.name==='compile');
const members=plan.operations.filter(value=>value.derived && value.derived.provider==='compile');
if(!provider || provider.state!=='completed') process.exit(1);
if(members.length!==2 || members.some(value=>value.state!=='up-to-date')) process.exit(2);
EOF_NODE
before="$(trace_count)"
"$command_path" --project "$project" build || fail "unchanged provider request failed"
[ "$(trace_count)" -eq "$before" ] ||
  fail "MK-71 unchanged derived members executed instead of reusing freshness"

touch "$project/src/a.txt" || error "cannot touch mapped item"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "mtime-only provider request failed"
[ "$(trace_count)" -eq "$before" ] ||
  fail "mtime-only mapped-item change invalidated provider freshness"

printf -- '%s\n' alpha-two > "$project/src/a.txt" || error "cannot change source a"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "mapped-item invalidation request failed"
[ "$(trace_count)" -eq "$((before + 1))" ] ||
  fail "MK-70 mapped-item content change did not rerun exactly one derived member"
[ "$(command -p -- tail -n 1 "$trace")" = "src/a.txt" ] ||
  fail "mapped-item change reran the wrong derived member"

printf -- '%s\n' cfg-b-two > "$project/cfg/src/b.txt.cfg" ||
  error "cannot change templated config input"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "templated provider input invalidation failed"
[ "$(trace_count)" -eq "$((before + 1))" ] ||
  fail "MK-72 templated path input change did not rerun exactly one member"
[ "$(command -p -- tail -n 1 "$trace")" = "src/b.txt" ] ||
  fail "templated path input change reran the wrong derived member"

printf -- '%s\n' damaged > "$project/out/src/a.txt.out" ||
  error "cannot tamper provider output"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "provider output repair failed"
[ "$(trace_count)" -eq "$((before + 1))" ] ||
  fail "MK-71 tampered provider output did not invalidate exactly one member"
[ "$(command -p -- tail -n 1 "$trace")" = "src/a.txt" ] ||
  fail "provider output tamper reran the wrong derived member"

printf -- '%s\n' zero > "$project/src/0.txt" || error "cannot add earlier source"
printf -- '%s\n' cfg-zero > "$project/cfg/src/0.txt.cfg" || error "cannot add earlier config"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "provider collection add request failed"
[ "$(trace_count)" -eq "$((before + 1))" ] ||
  fail "MK-74 adding one member invalidated unchanged derived members"
[ "$(command -p -- tail -n 1 "$trace")" = "src/0.txt" ] ||
  fail "newly added member was not the only executed derived operation"

command -p -- rm -f -- "$project/src/0.txt" "$project/cfg/src/0.txt.cfg" ||
  error "cannot remove earlier member"
before="$(trace_count)"
"$command_path" --project "$project" build || fail "provider collection remove request failed"
[ "$(trace_count)" -eq "$before" ] ||
  fail "MK-74 removing a member invalidated unchanged reachable derived members"

before="$(trace_count)"
"$command_path" --project "$project" ordinary || fail "ordinary provider execution failed"
"$command_path" --project "$project" ordinary || fail "second ordinary provider execution failed"
[ "$(trace_count)" -eq "$((before + 4))" ] ||
  fail "provider inputs/outputs without incremental unexpectedly enabled reuse"

invalid_no_output="$tmp/invalid-no-output"
mkdir -p "$invalid_no_output/src" || error "cannot create invalid provider fixture"
printf x > "$invalid_no_output/src/x" || error "cannot create invalid provider source"
cat > "$invalid_no_output/mk.json" <<'EOF_INVALID_OUTPUT' ||
  error "cannot write incremental-provider-without-output fixture"
{
  "version": 2,
  "goals": {"build": ["p"]},
  "collections": {"s": {"type": "files", "root": "src"}},
  "providers": {
    "p": {
      "type": "map-process",
      "collection": "s",
      "incremental": {},
      "action": {"type": "process", "command": "sh", "args": ["-c", "true"]}
    }
  }
}
EOF_INVALID_OUTPUT
expect_status 1 "$command_path" --project "$invalid_no_output" --plan build

invalid_legacy="$tmp/invalid-legacy"
mkdir -p "$invalid_legacy/src" || error "cannot create legacy-provider fixture"
printf x > "$invalid_legacy/src/x" || error "cannot create legacy-provider source"
cat > "$invalid_legacy/mk.json" <<'EOF_INVALID_LEGACY' ||
  error "cannot write legacy provider incremental fixture"
{
  "version": 2,
  "goals": {"build": ["p"]},
  "collections": {"s": {"type": "files", "root": "src"}},
  "providers": {
    "p": {
      "type": "map-process",
      "collection": "s",
      "incremental": {
        "inputs": {"source": {"path": "${item}"}}
      },
      "outputs": {"artifact": {"path": "out/${item}"}},
      "action": {"type": "process", "command": "sh", "args": ["-c", "true"]}
    }
  }
}
EOF_INVALID_LEGACY
expect_status 1 "$command_path" --project "$invalid_legacy" --plan build

invalid_private="$tmp/invalid-private"
mkdir -p "$invalid_private/src" || error "cannot create private-input fixture"
printf x > "$invalid_private/src/x" || error "cannot create private-input source"
cat > "$invalid_private/mk.json" <<'EOF_INVALID_PRIVATE' ||
  error "cannot write private provider input fixture"
{
  "version": 2,
  "goals": {"build": ["p"]},
  "collections": {"s": {"type": "files", "root": "src"}},
  "providers": {
    "p": {
      "type": "map-process",
      "collection": "s",
      "inputs": {"$item": {"path": "other"}},
      "outputs": {"artifact": {"path": "out/${item}"}},
      "incremental": {},
      "action": {"type": "process", "command": "sh", "args": ["-c", "true"]}
    }
  }
}
EOF_INVALID_PRIVATE
expect_status 1 "$command_path" --project "$invalid_private" --plan build

exit 0
