#!/bin/sh

TEST_ID=rumiai-os/pkg/depend.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -f "$root/lib/sys/sh/pkg/pkg-depend.lib.sh" ] || fail 'pkg-depend library missing'
[ -f "$root/res/sys/manual/pkg-depend.lib.sh" ] || fail 'pkg-depend manual missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-depend-$$
umask 077
mkdir -- "$tmp" || error 'cannot create scenario evidence directory'
trap 'command -p -- rm -rf -- "$tmp"' 0

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

# The public CLI validates syntax before consulting any catalog.
run_pkg depend >"$tmp/empty.out" 2>"$tmp/empty.err"
[ "$?" -eq 2 ] || fail 'missing dependency operands did not return usage status 2'

run_pkg depend 'invalid/name' >"$tmp/invalid.out" 2>"$tmp/invalid.err"
[ "$?" -eq 2 ] || fail 'invalid dependency operand did not return syntax status 2'

# Unlike the former fixture, this test exercises the real package subsystem,
# real catalog snapshot and normal provider selection, not a fake adapter or
# replacements for readonly bootstrap paths.
run_pkg depend rumiai-web-control@v0.1.3 >"$tmp/plan.out" 2>"$tmp/plan.err" || {
  command -p -- cat "$tmp/plan.err" >&2
  fail 'public dependency plan for web-control release failed'
}

[ -s "$tmp/plan.out" ] || fail 'web-control dependencies were omitted'
provider_count=0
while IFS= read -r dependency
do
  case "$dependency" in
    ''|*[!A-Za-z0-9._+@!~-]*)
      fail "invalid public dependency identity: $dependency"
      ;;
    rumiai-web-control@*)
      fail 'requested root leaked into its dependency plan'
      ;;
    *@*)
      provider_count=$((provider_count + 1))
      ;;
    *)
      fail "non-concrete dependency identity: $dependency"
      ;;
  esac
done <"$tmp/plan.out"
[ "$provider_count" -ge 2 ] ||
  fail "expected provider dependencies for Chromium and Node.js, observed $provider_count"

run_pkg depend rumiai-test-nonexistent-package-20261010 >"$tmp/missing.out" 2>"$tmp/missing.err"
status=$?
[ "$status" -eq 1 ] || {
  command -p -- cat "$tmp/missing.err" >&2
  fail "missing original package returned status $status instead of 1"
}
[ ! -s "$tmp/missing.out" ] ||
  fail 'failed dependency resolution emitted a partial dependency plan'
grep -F 'reason="request-unresolvable"' "$tmp/missing.err" >/dev/null ||
  fail 'missing root diagnostic lacks request-unresolvable reason'
grep -F 'request="rumiai-test-nonexistent-package-20261010"' "$tmp/missing.err" >/dev/null ||
  fail 'missing root diagnostic lacks original user request'

exit 0
