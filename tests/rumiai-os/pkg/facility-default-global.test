#!/bin/sh

TEST_ID=rumiai-os/pkg/facility-default-global.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

expect_global_env()
{
  expected=$1
  label=$2

  "$root/m" "$env_probe" > "$tmp/$label.out" 2> "$tmp/$label.err" || {
    cat "$tmp/$label.err" >&2
    fail "$label bootstrap probe failed"
  }
  actual=$(cat "$tmp/$label.out") || error "$label cannot read probe output"
  [ "$actual" = "$expected" ] ||
    fail "$label expected global environment '$expected', observed '$actual'"
}

cleanup()
{
  trap - 0 HUP INT TERM

  [ -z "${collision_public-}" ] || rm -f "$collision_public" 2>/dev/null || :

  if [ -n "${consumer-}" ] && [ -n "${facility-}" ]
  then
    run_pkg provider bind -u -- "$consumer" "$facility" >/dev/null 2>&1 || :
  fi
  [ -z "${facility-}" ] || run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  [ -z "${provider-}" ] || run_pkg default -u -- "$provider" >/dev/null 2>&1 || :

  if [ -n "${root-}" ] && [ -n "${driver-}" ] && [ -n "${provider-}" ]
  then
    for version in 1 2
    do
      if [ -d "$root/pkg/$provider@$version" ] && [ ! -L "$root/pkg/$provider@$version" ]
      then
        "$root/m" "$driver" deintegrate "$provider" "$version" >/dev/null 2>&1 || :
      fi
    done
  fi

  [ -z "${consumer_state-}" ] || rm -rf "$consumer_state" 2>/dev/null || :
  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi
  if [ "${bin_ext_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/bin/ext" 2>/dev/null || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-facility-global-$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

unset RUMIAI_TEST_FACILITY_GLOBAL_MARKER
env_probe=$tmp/env-probe
cat > "$env_probe" <<'EOF_ENV_PROBE'
#!/usr/bin/env m
if [ "${RUMIAI_TEST_FACILITY_GLOBAL_MARKER+x}" = x ]
then
  printf '%s\n' "$RUMIAI_TEST_FACILITY_GLOBAL_MARKER"
else
  printf '%s\n' '<unset>'
fi
exit 0
EOF_ENV_PROBE
chmod 700 "$env_probe" || error 'cannot prepare ambient environment probe'

provider=globalprovider$$
consumer=globalconsumer$$
facility=globalfacility$$
main_command=globalmain$$
old_command=globalold$$
new_command=globalnew$$
collision_command=globalcollision$$
public_dir=$root/bin/ext
main_public=$public_dir/$main_command
old_public=$public_dir/$old_command
new_public=$public_dir/$new_command
collision_public=$public_dir/$collision_command

pkg_store_created=0
if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

bin_ext_created=0
if [ ! -e "$public_dir" ] && [ ! -L "$public_dir" ]
then
  bin_ext_created=1
fi

for version in 1 2
do
  [ ! -e "$root/pkg/$provider@$version" ] && [ ! -L "$root/pkg/$provider@$version" ] ||
    error "temporary provider already exists: $provider@$version"
done
[ ! -e "$root/pkg/$provider" ] && [ ! -L "$root/pkg/$provider" ] ||
  error 'temporary provider package selector already exists'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate)
    [ -f "$3/format" ] || printf '%s\n' tar.gz > "$3/format" || exit 3
    pkg_integrate "$@"
    ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

make_provider()
{
  version=$1
  range=$tmp/range-$version
  payload=$tmp/payload-$version
  mkdir -p "$range/facility-cmd/$facility" "$range/facility-env" "$payload/bin" || return 1
  printf '%s 1\n' "$facility" > "$range/facility" || return 1
  tab=$(printf '\t')
  printf 'RUMIAI_TEST_FACILITY_GLOBAL_MARKER%s%s\n' "$tab" "literal provider-$version" > "$range/facility-env/$facility" || return 1

  commands=$main_command
  if [ "$version" -eq 1 ]
  then
    commands="$commands $old_command"
  else
    commands="$commands $new_command $collision_command"
  fi

  for command_name in $commands
  do
    printf '%s\n' "bin/$command_name" > "$range/facility-cmd/$facility/$command_name" || return 1
    cat > "$payload/bin/$command_name" <<EOF_COMMAND
#!/bin/sh
printf '%s\\n' 'version=$version'
EOF_COMMAND
    chmod 700 "$payload/bin/$command_name" || return 1
  done

  "$root/m" "$driver" integrate "$provider" "$version" "$range" "$payload"
}

make_provider 1 > "$tmp/integrate-1.out" 2> "$tmp/integrate-1.err" || {
  cat "$tmp/integrate-1.err" >&2
  fail 'cannot integrate provider version 1'
}
make_provider 2 > "$tmp/integrate-2.out" 2> "$tmp/integrate-2.err" || {
  cat "$tmp/integrate-2.err" >&2
  fail 'cannot integrate provider version 2'
}

run_pkg default "$provider@1" > "$tmp/default-1.out" 2> "$tmp/default-1.err" || {
  cat "$tmp/default-1.err" >&2
  fail 'cannot select provider package default version 1'
}

run_pkg provider default "$facility" "$provider" > "$tmp/facility-unversioned.out" 2> "$tmp/facility-unversioned.err" || {
  cat "$tmp/facility-unversioned.err" >&2
  fail 'cannot configure unversioned facility default'
}

[ "${RUMIAI_TEST_FACILITY_GLOBAL_MARKER+x}" != x ] ||
  fail 'facility default retroactively changed the already-running test process'
expect_global_env 'provider-1' env-unversioned-v1

expected_unversioned="../../pkg/$provider/facility-cmd/$facility/$main_command"
[ -L "$main_public" ] || fail 'unversioned facility main command was not published'
[ "$(readlink "$main_public")" = "$expected_unversioned" ] ||
  fail 'unversioned facility command does not point through the provider package selector'
[ "$("$main_public")" = 'version=1' ] || fail 'unversioned facility command did not reach provider version 1'
[ -L "$old_public" ] || fail 'version-1-only facility command was not published'
[ ! -e "$new_public" ] && [ ! -L "$new_public" ] || fail 'version-2-only command was published from version 1'
[ ! -e "$collision_public" ] && [ ! -L "$collision_public" ] || fail 'version-2 collision command was published from version 1'

run_pkg default "$provider@2" > "$tmp/default-2.out" 2> "$tmp/default-2.err" || {
  cat "$tmp/default-2.err" >&2
  fail 'cannot switch provider package default to version 2'
}

[ "$(readlink "$main_public")" = "$expected_unversioned" ] ||
  fail 'unversioned facility link was rewritten away from the package selector'
[ "$("$main_public")" = 'version=2' ] || fail 'unversioned facility command did not follow package default version 2'
[ ! -e "$old_public" ] && [ ! -L "$old_public" ] || fail 'old facility command survived command-set reconciliation'
[ -L "$new_public" ] || fail 'new facility command was not added after package-default transition'
[ -L "$collision_public" ] || fail 'new collision command was not added after package-default transition'
expect_global_env 'provider-2' env-unversioned-v2

run_pkg provider default "$facility" "$provider@1" > "$tmp/pin-1.out" 2> "$tmp/pin-1.err" || {
  cat "$tmp/pin-1.err" >&2
  fail 'cannot pin facility default to provider version 1'
}

expected_pinned="../../pkg/$provider@1/facility-cmd/$facility/$main_command"
[ "$(readlink "$main_public")" = "$expected_pinned" ] ||
  fail 'pinned facility command does not target the pinned concrete'
[ "$("$main_public")" = 'version=1' ] || fail 'pinned facility command did not remain on version 1'
[ -L "$old_public" ] || fail 'pinned version-1 command set was not restored'
[ ! -e "$new_public" ] && [ ! -L "$new_public" ] || fail 'pinned version 1 retained a version-2-only command'
[ ! -e "$collision_public" ] && [ ! -L "$collision_public" ] || fail 'pinned version 1 retained the version-2 collision command'
expect_global_env 'provider-1' env-pinned-v1

printf '%s\n' foreign > "$collision_public" || error 'cannot create foreign collision pathname'
expect_status 1 collision-rejected run_pkg provider default "$facility" "$provider@2"
[ -f "$collision_public" ] && [ ! -L "$collision_public" ] || fail 'collision mutation modified the foreign pathname'
[ "$(cat "$collision_public")" = foreign ] || fail 'collision mutation changed foreign pathname contents'
configured=$(run_pkg provider default "$facility" 2> "$tmp/collision-query.err") ||
  fail 'facility default query failed after rejected collision'
[ "$configured" = "$provider@1" ] || fail 'rejected collision changed authoritative facility selector'
[ "$(readlink "$main_public")" = "$expected_pinned" ] || fail 'rejected collision changed existing owned projection'
expect_global_env 'provider-1' env-collision-rollback
rm -f "$collision_public" || error 'cannot remove foreign collision pathname'

run_pkg provider default "$facility" "$provider" > "$tmp/unversioned-again.out" 2> "$tmp/unversioned-again.err" || {
  cat "$tmp/unversioned-again.err" >&2
  fail 'cannot restore unversioned facility selector'
}
[ "$("$main_public")" = 'version=2' ] || fail 'restored unversioned selector did not use package default version 2'
expect_global_env 'provider-2' env-unversioned-restored

consumer_conf=$("$root/m" "$root/bin/sys/state-path" system pkg "$consumer" conf) ||
  error 'cannot resolve consumer system configuration'
consumer_state=${consumer_conf%/conf}
run_pkg provider bind "$consumer" "$facility" "$provider@1" > "$tmp/bind.out" 2> "$tmp/bind.err" || {
  cat "$tmp/bind.err" >&2
  fail 'cannot configure consumer-specific provider binding'
}
[ "$("$main_public")" = 'version=2' ] ||
  fail 'consumer-specific binding changed global facility command publication'
expect_global_env 'provider-2' env-binding-independent
run_pkg provider bind -u -- "$consumer" "$facility" >/dev/null 2> "$tmp/bind-unset.err" ||
  fail 'cannot remove consumer-specific provider binding'

run_pkg default -u -- "$provider" > "$tmp/default-clear.out" 2> "$tmp/default-clear.err" || {
  cat "$tmp/default-clear.err" >&2
  fail 'cannot clear provider package default'
}
for public_path in "$main_public" "$old_public" "$new_public" "$collision_public"
do
  [ ! -e "$public_path" ] && [ ! -L "$public_path" ] ||
    fail 'unversioned facility command remained after package class default was cleared'
done
configured=$(run_pkg provider default "$facility" 2> "$tmp/default-still-configured.err") ||
  fail 'facility selector disappeared when provider package default was cleared'
[ "$configured" = "$provider" ] || fail 'provider package default clear changed facility selector intent'
expect_global_env '<unset>' env-unversioned-class-absent

run_pkg default "$provider@1" > "$tmp/default-recreate.out" 2> "$tmp/default-recreate.err" || {
  cat "$tmp/default-recreate.err" >&2
  fail 'cannot recreate provider package default'
}
[ "$("$main_public")" = 'version=1' ] || fail 'facility commands were not republished when package class reappeared'
expect_global_env 'provider-1' env-class-recreated

run_pkg provider default "$facility" "$provider@2" > "$tmp/pin-2.out" 2> "$tmp/pin-2.err" || {
  cat "$tmp/pin-2.err" >&2
  fail 'cannot pin facility default to provider version 2'
}
expected_pinned_2="../../pkg/$provider@2/facility-cmd/$facility/$main_command"
[ "$(readlink "$main_public")" = "$expected_pinned_2" ] || fail 'version-2 pin did not target pinned concrete'
[ "$("$main_public")" = 'version=2' ] || fail 'version-2 pin did not execute pinned concrete'
expect_global_env 'provider-2' env-pinned-v2

run_pkg default -u -- "$provider" > "$tmp/pinned-class-clear.out" 2> "$tmp/pinned-class-clear.err" || {
  cat "$tmp/pinned-class-clear.err" >&2
  fail 'cannot clear package class while facility selector is pinned'
}
for public_path in "$main_public" "$old_public" "$new_public" "$collision_public"
do
  [ ! -e "$public_path" ] && [ ! -L "$public_path" ] ||
    fail 'pinned no-osarch facility projection remained after package class disappeared'
done
expect_global_env '<unset>' env-pinned-class-absent

run_pkg default "$provider@1" > "$tmp/pinned-class-recreate.out" 2> "$tmp/pinned-class-recreate.err" || {
  cat "$tmp/pinned-class-recreate.err" >&2
  fail 'cannot recreate package class while facility selector is pinned'
}
[ "$(readlink "$main_public")" = "$expected_pinned_2" ] ||
  fail 'pinned projection did not republish with its pinned concrete when package class reappeared'
[ "$("$main_public")" = 'version=2' ] ||
  fail 'republished pinned projection followed package default instead of pinned concrete'
expect_global_env 'provider-2' env-pinned-class-recreated

run_pkg provider default -u -- "$facility" > "$tmp/facility-unset.out" 2> "$tmp/facility-unset.err" || {
  cat "$tmp/facility-unset.err" >&2
  fail 'cannot unset facility default'
}
for public_path in "$main_public" "$old_public" "$new_public" "$collision_public"
do
  [ ! -e "$public_path" ] && [ ! -L "$public_path" ] ||
    fail 'owned global facility command remained after facility default unset'
done
expect_global_env '<unset>' env-facility-unset

printf 'unversioned-follow=ok\n'
printf 'command-set-reconcile=ok\n'
printf 'pinned-selector=ok\n'
printf 'collision-rollback=ok\n'
printf 'binding-independent=ok\n'
printf 'class-presence-reconcile=ok\n'
printf 'global-facility-env=ok\n'
printf 'running-process-unchanged=ok\n'
exit 0
