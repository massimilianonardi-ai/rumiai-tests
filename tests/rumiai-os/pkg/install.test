#!/bin/sh

TEST_ID="rumiai-os/pkg/install.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

library="$root/lib/sh/pkg-install.lib.sh"
command_path="$root/bin/sys/pkg"
[ -f "$library" ] || fail "lib/sh/pkg-install.lib.sh is missing"
[ -x "$command_path" ] || fail "bin/sys/pkg is missing or not executable"
[ "$(sed -n '1p' "$command_path")" = '#!/usr/bin/env rumiai-os' ] || fail "pkg command entry has wrong shebang"

PATH="$root/bin/sys:$PATH"
export PATH
"$command_path" >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "pkg without arguments did not return 2"
"$command_path" install >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "pkg install without operands did not return 2"
"$command_path" unsupported >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "unsupported pkg subcommand did not return 2"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-install-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

m_LIB_DIR="$root/lib"
m_TMP_DIR="$tmp/runtime-tmp"
m_CACHE_DIR="$tmp/cache"
m_RUN_DIR="$tmp/run"
m_PKG_DIR="$tmp/pkg"
m_BIN_DIR="$tmp/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_OSARCH=linux-arm64
mkdir -p "$m_TMP_DIR" "$m_CACHE_DIR" "$m_RUN_DIR" "$m_PKG_DIR" "$m_BIN_DIR" || error "cannot create fixture roots"
export m_LIB_DIR m_TMP_DIR m_CACHE_DIR m_RUN_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_OSARCH

log()
{
  :
}

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  case "$2" in
    */*) dir=${2%/*}; base=${2##*/}; [ -n "$dir" ] || dir=/ ;;
    *) dir=.; base=$2 ;;
  esac
  physical_dir="$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
  eval "$1=\$physical_dir/\$base"
}

. "$library" || error "cannot source pkg-install library"

fixture_lib="$tmp/lib"
mkdir -p "$fixture_lib/sh" || error "cannot create fixture lib"
cat > "$fixture_lib/sh/pkg-repository-fixture.lib.sh" <<'EOF_ADAPTER'
pkg_repository_list_versions()
{
  printf -- '%s\n' v9 2.0 v1
}

pkg_repository_resolve_version()
{
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || return 2
  if [ "$#" -eq 1 ]
  then
    printf -- '%s\n' v1
  else
    printf -- '%s\n' "$2"
  fi
}

pkg_repository_resolve_artifact()
{
  [ "$#" -eq 3 ] || return 2
  printf -- 'name=payload\nurl=https://example.invalid/payload\nsize=8\n'
}
EOF_ADAPTER
chmod 600 "$fixture_lib/sh/pkg-repository-fixture.lib.sh" || error "cannot set fixture adapter mode"
m_LIB_DIR="$fixture_lib"
export m_LIB_DIR

fixture_catalog="$tmp/catalog-fixture"
mkdir "$fixture_catalog" || error "cannot create catalog fixture"

make_stream()
{
  package=$1
  stream=$2
  base="$fixture_catalog/$package/$stream"
  mkdir -p "$base/repository" "$base/n0001=v9" "$base/n0002=v1" || return 1
  printf -- '%s\n' fixture > "$base/repository/type" || return 1
  printf -- '%s\n' appimage > "$base/n0001=v9/format" || return 1
  printf -- '%s\n' appimage > "$base/n0002=v1/format" || return 1
}

for package in alpha beta gamma delta first unsupported
do
  make_stream "$package" catalog-linux-arm64 || error "cannot create target stream fixture"
done
make_stream generic catalog || error "cannot create generic stream fixture"
make_stream broken catalog || error "cannot create malformed-target fallback fixture"
printf -- '%s\n' invalid > "$fixture_catalog/broken/catalog-linux-arm64" || error "cannot create malformed target stream object"

snapshot_calls="$tmp/snapshot-calls"
: > "$snapshot_calls" || error "cannot initialize snapshot counter"
_pkg_install_catalog_snapshot()
{
  [ "$#" -eq 1 ] || return 2
  printf -- 'snapshot\n' >> "$snapshot_calls" || return 1
  command -p -- cp -R "$fixture_catalog/." "$1" || return 1
  printf -- '%040d\n' 0
}

pkg_download()
{
  [ "$#" -eq 1 ] || return 2
  target="$1/payload"
  printf -- 'payload\n' > "$target" || return 1
  printf -- '%s\n' "$target"
}

pkg_extract()
{
  [ "$#" -eq 3 ] || return 2
  [ -f "$1" ] || return 1
  [ "$2" = appimage ] || return 1
  printf -- 'payload\n' > "$3/payload" || return 1
}

integrations="$tmp/integrations"
: > "$integrations" || error "cannot initialize integration log"
pkg_integrate()
{
  [ "$#" -eq 4 ] || [ "$#" -eq 5 ] || return 2
  [ "$1" != unsupported ] || return 2
  if [ "$#" -eq 5 ]
  then
    identity="$1@$2!$5"
  else
    identity="$1@$2"
  fi
  [ ! -e "$m_PKG_DIR/$identity" ] || return 1
  mkdir "$m_PKG_DIR/$identity" || return 1
  printf -- '%s|%s\n' "$identity" "${3##*/}" >> "$integrations" || return 1
}

default_called="$tmp/default-called"
pkg_default()
{
  : > "$default_called"
  return 1
}

if pkg_install alpha 'beta@2.0' 'gamma!linux-arm64' 'delta@2.0!linux-arm64' 'generic@2.0!linux-arm64'
then
  :
else
  fail "valid multi-package install failed"
fi

[ "$(wc -l < "$snapshot_calls" | tr -d ' ')" = 1 ] || fail "multi-package install did not use exactly one catalog snapshot"
cat > "$tmp/expected-integrations" <<'EOF_EXPECTED'
alpha@v1!linux-arm64|n0002=v1
beta@2.0!linux-arm64|n0001=v9
gamma@v1!linux-arm64|n0002=v1
delta@2.0!linux-arm64|n0001=v9
generic@2.0|n0001=v9
EOF_EXPECTED
cmp "$integrations" "$tmp/expected-integrations" >/dev/null 2>&1 || fail "resolved integration identities/ranges differ from contract"
[ ! -e "$default_called" ] || fail "pkg install called pkg_default"
[ ! -e "$m_PKG_DIR/alpha!linux-arm64" ] || fail "pkg install created target current selector"
[ ! -e "$m_PKG_DIR/generic" ] || fail "pkg install created generic current selector"
[ ! -e "$m_BIN_DIR/ext-linux-arm64/alpha" ] || fail "pkg install created target public binding"
[ ! -e "$m_BIN_EXT_DIR/generic" ] || fail "pkg install created generic public binding"

before_snapshots="$(wc -l < "$snapshot_calls" | tr -d ' ')"
if pkg_install alpha 'bad@' >/dev/null 2>&1
then
  fail "lexically invalid operand was accepted"
else
  status=$?
  [ "$status" -eq 2 ] || fail "invalid operand returned $status instead of 2"
fi
after_snapshots="$(wc -l < "$snapshot_calls" | tr -d ' ')"
[ "$after_snapshots" = "$before_snapshots" ] || fail "invalid operand triggered catalog snapshot before prevalidation"

: > "$integrations" || error "cannot reset integration log"
if pkg_install 'first@2.0' 'missing@2.0' >/dev/null 2>&1
then
  fail "multi-package install unexpectedly succeeded after missing package"
else
  status=$?
  [ "$status" -eq 1 ] || fail "operational package failure returned $status instead of 1"
fi
[ -d "$m_PKG_DIR/first@2.0!linux-arm64" ] || fail "successful earlier integration was rolled back after later failure"
[ ! -e "$m_PKG_DIR/missing@2.0!linux-arm64" ] || fail "failed package was integrated"

if pkg_install 'unsupported@2.0' >/dev/null 2>&1
then
  fail "unsupported integration unexpectedly succeeded"
else
  status=$?
  [ "$status" -eq 1 ] || fail "unsupported lower-layer feature leaked status $status instead of operational status 1"
fi

if pkg_install 'broken@2.0' >/dev/null 2>&1
then
  fail "malformed target-specific stream silently fell back to generic"
else
  status=$?
  [ "$status" -eq 1 ] || fail "malformed target-specific stream returned $status instead of 1"
fi
[ ! -e "$m_PKG_DIR/broken@2.0" ] || fail "generic fallback was used despite malformed target-specific stream object"

exit 0
