#!/bin/sh

TEST_ID="rumiai-os/pkg/install.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

command_path="$root/bin/sys/pkg"
[ -x "$command_path" ] || fail "bin/sys/pkg is missing or not executable"
[ "$(sed -n '1p' "$command_path")" = '#!/usr/bin/env m' ] || fail "pkg command entry has wrong shebang"

PATH="$root/bin/sys:$PATH"
export PATH

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

expect_status 2 "$command_path"
expect_status 2 "$command_path" install
expect_status 2 "$command_path" unsupported

# Invalid install operands are rejected by the public command before catalog access.
# This keeps lexical/prevalidation coverage on the real entrypoint without replacing
# catalog, repository, download, extraction or integration components.
expect_status 2 "$command_path" install 'bad@'
expect_status 2 "$command_path" install Bad
expect_status 2 "$command_path" install 'alpha@1@2'
expect_status 2 "$command_path" install 'alpha!linux-arm64!linux-arm64'

exit 0
