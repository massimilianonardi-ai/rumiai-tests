#!/bin/sh

TEST_ID=rumiai-os/pkg/env.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_package()
{
  (
    PATH="$root/bin/ext:$root/bin/sys:$PATH"
    export PATH
    "$package"
  )
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${root-}" ] && [ -n "${package-}" ]
  then
    run_pkg uninstall "$package@1" >/dev/null 2>&1 || :
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :
    rm -rf "$root/pkg/$package@1" 2>/dev/null || :
    rm -f "$root/pkg/$package" "$root/bin/ext/$package" 2>/dev/null || :
  fi

  [ -z "${user_pkg_root-}" ] || rm -rf "$user_pkg_root" 2>/dev/null || :

  if [ "${bin_ext_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/bin/ext" 2>/dev/null || :
  fi
  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

expect_integrate_failure()
{
  label=$1
  name=$2
  range=$3
  payload=$4

  "$root/m" "$driver" integrate "$name" 1 "$range" "$payload"     > "$tmp/$label.out" 2> "$tmp/$label.err"
  status=$?
  [ "$status" -eq 1 ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $status instead of 1"
  }
  [ -d "$payload" ] || fail "$label consumed caller-owned payload"

  if run_pkg versions "$name" > "$tmp/$label.versions" 2> "$tmp/$label.versions.err"
  then
    fail "$label published an installed package"
  else
    [ "$?" -eq 1 ] || fail "$label produced an unexpected pkg versions status"
  fi
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-env-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=penv$$
bad_syntax=penvbad$$
bad_exec=penvexec$$
pkg_store_created=0
bin_ext_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

range=$tmp/range
payload=$tmp/payload
mkdir -p "$range/cmd" "$range/link" "$payload/bin" ||
  error 'cannot create package definition'

cat > "$range/cmd/$package" <<EOF_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_COMMAND
chmod 600 "$range/cmd/$package" || error 'cannot prepare package command'
printf '%s\n' bin/upstream > "$range/link/$package" ||
  error 'cannot prepare package link'

cat > "$range/env" <<'EOF_ENV'
RUMIAI_ENV_PACKAGE=package
RUMIAI_ENV_OVERRIDE=package
export RUMIAI_ENV_PACKAGE RUMIAI_ENV_OVERRIDE
EOF_ENV
chmod 600 "$range/env" || error 'cannot prepare package env'

cat > "$payload/bin/upstream" <<'EOF_UPSTREAM'
#!/bin/sh
printf 'package=%s\n' "${RUMIAI_ENV_PACKAGE-unset}"
printf 'user=%s\n' "${RUMIAI_ENV_USER-unset}"
printf 'override=%s\n' "${RUMIAI_ENV_OVERRIDE-unset}"
printf 'home=%s\n' "${HOME-unset}"
EOF_UPSTREAM
chmod 700 "$payload/bin/upstream" || error 'cannot prepare upstream command'

"$root/m" "$driver" integrate "$package" 1 "$range" "$payload"   > "$tmp/integrate.out" 2> "$tmp/integrate.err" || {
    cat "$tmp/integrate.err" >&2
    fail 'package env integration failed'
  }

run_pkg default "$package@1" > "$tmp/default.out" 2> "$tmp/default.err" || {
  cat "$tmp/default.err" >&2
  fail 'cannot select package env test package'
}

user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" conf) ||
  error 'cannot resolve package user configuration'
user_home=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" home) ||
  error 'cannot resolve package HOME'
user_pkg_root=${user_conf%/conf}

run_package > "$tmp/package-only.out" 2> "$tmp/package-only.err" || {
  cat "$tmp/package-only.err" >&2
  fail 'package launch with package env failed'
}
grep -Fx 'package=package' "$tmp/package-only.out" >/dev/null 2>&1 ||
  fail 'package env was not applied at launch'
grep -Fx 'user=unset' "$tmp/package-only.out" >/dev/null 2>&1 ||
  fail 'unexpected user env existed before user configuration'
grep -Fx 'override=package' "$tmp/package-only.out" >/dev/null 2>&1 ||
  fail 'package env override value was not visible'
grep -Fx "home=$user_home" "$tmp/package-only.out" >/dev/null 2>&1 ||
  fail 'package launch did not expose package HOME'

mkdir -p "$user_conf/.m" || error 'cannot create user package configuration'
cat > "$user_conf/.m/env" <<'EOF_USER_ENV'
RUMIAI_ENV_USER=user
RUMIAI_ENV_OVERRIDE=user
export RUMIAI_ENV_USER RUMIAI_ENV_OVERRIDE
EOF_USER_ENV
chmod 600 "$user_conf/.m/env" || error 'cannot prepare user package env'

run_package > "$tmp/user-env.out" 2> "$tmp/user-env.err" || {
  cat "$tmp/user-env.err" >&2
  fail 'package launch with user env failed'
}
grep -Fx 'package=package' "$tmp/user-env.out" >/dev/null 2>&1 ||
  fail 'package env disappeared when user env was applied'
grep -Fx 'user=user' "$tmp/user-env.out" >/dev/null 2>&1 ||
  fail 'user package env was not applied'
grep -Fx 'override=user' "$tmp/user-env.out" >/dev/null 2>&1 ||
  fail 'user package env was not applied after package env'
grep -Fx "home=$user_home" "$tmp/user-env.out" >/dev/null 2>&1 ||
  fail 'package HOME changed when user env was applied'

bad_range=$tmp/bad-range
bad_payload=$tmp/bad-payload
mkdir "$bad_range" "$bad_payload" || error 'cannot create invalid env fixture'
printf '%s\n' if > "$bad_range/env"
printf '%s\n' payload > "$bad_payload/payload"
expect_integrate_failure bad-syntax "$bad_syntax" "$bad_range" "$bad_payload"

exec_range=$tmp/exec-range
exec_payload=$tmp/exec-payload
mkdir "$exec_range" "$exec_payload" || error 'cannot create executable env fixture'
printf '%s\n' 'EXAMPLE=value' > "$exec_range/env"
chmod 700 "$exec_range/env" || error 'cannot make invalid env executable'
printf '%s\n' payload > "$exec_payload/payload"
expect_integrate_failure executable-env "$bad_exec" "$exec_range" "$exec_payload"

exit 0
