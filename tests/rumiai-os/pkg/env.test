#!/bin/sh

TEST_ID="rumiai-os/pkg/env.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v -- "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v -- "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

readpathce()
{
  [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || return 1
  case "$1" in "" | [0-9]* | *[!a-zA-Z0-9_]*) return 2 ;; esac
  resolved="$(command -p -- realpath -- "$2" 2>/dev/null)" || return 1
  [ -e "$resolved" ] || return 1
  eval "$1=\$resolved"
}

log()
{
  :
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

command -v -- git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"
command -v -- realpath >/dev/null 2>&1 || fail "realpath runtime dependency is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

integration_library="$root/lib/sh/pkg-integration.lib.sh"
launch_library="$root/lib/sh/pkg-launch.lib.sh"
[ -f "$integration_library" ] || fail "lib/sh/pkg-integration.lib.sh is missing"
[ ! -x "$integration_library" ] || fail "pkg-integration library must not be executable"
[ -f "$launch_library" ] || fail "lib/sh/pkg-launch.lib.sh is missing"
[ ! -x "$launch_library" ] || fail "pkg-launch library must not be executable"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-env-$$"
umask 077
command -p -- mkdir -- "$tmp" || error "cannot create temporary directory"
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

m_ROOT="$tmp/root"
m_LIB_DIR="$root/lib"
m_PKG_DIR="$m_ROOT/pkg"
m_BIN_DIR="$m_ROOT/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_DATA_DIR="$m_ROOT/data"
m_HOME_DIR="$m_ROOT/home"
m_CONF_DIR="$m_ROOT/conf"
m_OSARCH="linux-arm64"
command -p -- mkdir -p -- "$m_PKG_DIR" "$m_BIN_DIR" "$m_DATA_DIR" "$m_HOME_DIR" "$m_CONF_DIR" || error "cannot create fixture root"
export m_ROOT m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_DATA_DIR m_HOME_DIR m_CONF_DIR m_OSARCH

. "$integration_library" || error "cannot source pkg-integration library"
. "$launch_library" || error "cannot source pkg-launch library"

provider_range="$tmp/provider-range"
provider_root="$tmp/provider-root"
command -p -- mkdir -- "$provider_range" || error "cannot create provider range"
printf -- '%s\n' 'java 21' > "$provider_range/facility" || error "cannot create provider facility"
command -p -- mkdir -p -- "$provider_root/bin" || error "cannot create provider root"
cat > "$provider_root/bin/java" <<'EOF_PROVIDER'
#!/bin/sh
printf -- 'provider-java-home=%s\n' "$JAVA_HOME"
EOF_PROVIDER
command -p -- chmod 700 "$provider_root/bin/java" || error "cannot make provider executable"
pkg_integrate java-provider 21 "$provider_range" "$provider_root" || fail "provider integration failed"
provider_concrete="$m_PKG_DIR/java-provider@21"
[ -d "$provider_concrete/root" ] || fail "provider concrete root is missing"

consumer_range="$tmp/consumer-range"
consumer_root="$tmp/consumer-root"
command -p -- mkdir -p -- "$consumer_range/cmd" "$consumer_range/link" "$consumer_root/bin" || error "cannot create consumer fixture"
printf -- '%s\n' 'java =21' > "$consumer_range/dependency" || error "cannot create consumer dependency"
cat > "$consumer_range/env" <<'EOF_ENV'
package_dir=${m_COMMAND_BIN%/*}
package_dir=${package_dir%/*}
java_binding="$(command -p -- cat -- "$package_dir/binding/java")" || return 1
JAVA_HOME="$m_ROOT/pkg/$java_binding/root"
PATH="$JAVA_HOME/bin:$PATH"
export JAVA_HOME PATH
printf -- '%s\n' applied > "$TEST_ENV_MARKER" || return 1
unset package_dir java_binding
EOF_ENV
cat > "$consumer_range/cmd/consumer" <<'EOF_COMMAND'
#!/usr/bin/env rumiai-os

. "$m_LIB_DIR/sh/pkg-launch.lib.sh"

launcher "consumer" "$@"
EOF_COMMAND
printf -- '%s\n' 'bin/consumer' > "$consumer_range/link/consumer" || error "cannot create consumer link definition"
cat > "$consumer_root/bin/consumer" <<'EOF_CONSUMER'
#!/bin/sh
printf -- 'consumer-java-home=%s\n' "$JAVA_HOME"
java
EOF_CONSUMER
command -p -- chmod 700 "$consumer_root/bin/consumer" || error "cannot make consumer executable"
command -p -- chmod 600 "$consumer_range/env" "$consumer_range/cmd/consumer" "$consumer_range/link/consumer" || error "cannot set catalog source modes"

TEST_ENV_MARKER="$tmp/env-applied"
export TEST_ENV_MARKER
pkg_integrate consumer 1 "$consumer_range" "$consumer_root" || fail "consumer integration failed"
consumer_concrete="$m_PKG_DIR/consumer@1"
[ ! -e "$TEST_ENV_MARKER" ] || fail "package env was executed during integration"
[ -f "$consumer_concrete/env" ] && [ ! -L "$consumer_concrete/env" ] && [ -r "$consumer_concrete/env" ] || fail "materialized package env is not a readable regular file"
[ ! -x "$consumer_range/env" ] || fail "catalog env source was made executable"
[ ! -x "$consumer_concrete/env" ] || fail "materialized package env is executable"
cmp "$consumer_range/env" "$consumer_concrete/env" >/dev/null 2>&1 || fail "materialized package env differs from catalog bytes"
[ "$(command -p -- cat -- "$consumer_concrete/binding/java")" = 'java-provider@21' ] || fail "consumer java binding is incorrect"

command -p -- rm -rf -- "$m_DATA_DIR/sys/pkg/providers" || error "cannot remove provider index fixture"
output="$tmp/launch-output"
if ! (
  m_COMMAND_BIN="$consumer_concrete/cmd/consumer"
  export m_COMMAND_BIN
  launcher consumer
) > "$output" 2> "$tmp/launch-stderr"
then
  fail "consumer launch failed after provider index removal"
fi
[ -f "$TEST_ENV_MARKER" ] || fail "package env was not sourced during launch"
expected_java_home="$provider_concrete/root"
LC_ALL=C command -p -- grep -Fx "consumer-java-home=$expected_java_home" "$output" >/dev/null || fail "consumer did not receive JAVA_HOME from resolved binding"
LC_ALL=C command -p -- grep -Fx "provider-java-home=$expected_java_home" "$output" >/dev/null || fail "resolved provider executable was not selected through package env"

bad_range="$tmp/bad-range"
bad_root="$tmp/bad-root"
command -p -- mkdir -- "$bad_range" "$bad_root" || error "cannot create invalid env fixture"
printf -- '%s\n' 'if' > "$bad_range/env" || error "cannot write syntactically invalid env"
printf -- '%s\n' payload > "$bad_root/payload" || error "cannot write invalid env root payload"
expect_status 1 pkg_integrate bad-env 1 "$bad_range" "$bad_root"
[ -d "$bad_root" ] || fail "syntactically invalid env consumed useful root"
[ ! -e "$m_PKG_DIR/bad-env@1" ] && [ ! -L "$m_PKG_DIR/bad-env@1" ] || fail "syntactically invalid env published a concrete package"

exec_range="$tmp/executable-range"
exec_root="$tmp/executable-root"
command -p -- mkdir -- "$exec_range" "$exec_root" || error "cannot create executable env fixture"
printf -- '%s\n' 'EXAMPLE=value' > "$exec_range/env" || error "cannot write executable env"
command -p -- chmod 700 "$exec_range/env" || error "cannot make catalog env executable"
printf -- '%s\n' payload > "$exec_root/payload" || error "cannot write executable env root payload"
expect_status 1 pkg_integrate executable-env 1 "$exec_range" "$exec_root"
[ -d "$exec_root" ] || fail "executable env consumed useful root"
[ ! -e "$m_PKG_DIR/executable-env@1" ] && [ ! -L "$m_PKG_DIR/executable-env@1" ] || fail "executable env published a concrete package"

symlink_range="$tmp/symlink-range"
symlink_root="$tmp/symlink-root"
command -p -- mkdir -- "$symlink_range" "$symlink_root" || error "cannot create symlink env fixture"
printf -- '%s\n' 'EXAMPLE=value' > "$tmp/env-target" || error "cannot create env symlink target"
command -p -- ln -s "$tmp/env-target" "$symlink_range/env" || error "cannot create catalog env symlink"
printf -- '%s\n' payload > "$symlink_root/payload" || error "cannot write symlink env root payload"
expect_status 1 pkg_integrate symlink-env 1 "$symlink_range" "$symlink_root"
[ -d "$symlink_root" ] || fail "symlink env consumed useful root"
[ ! -e "$m_PKG_DIR/symlink-env@1" ] && [ ! -L "$m_PKG_DIR/symlink-env@1" ] || fail "symlink env published a concrete package"

exit 0
