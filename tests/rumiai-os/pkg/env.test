#!/bin/sh

TEST_ID=rumiai-os/pkg/env.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
origin_ok() { origin=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;; esac; return 1; }
validate_root() { [ -f "$1/m" ] && [ -f "$1/rumiai-os" ] && [ -f "$1/rumiai-os-sh" ] && origin_ok "$1"; }
find_root() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then validate_root "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; (CDPATH= cd -- "$RUMIAI_TEST_RUMIAI_OS_ROOT" && pwd -P); return; fi; candidate=$(CDPATH= cd -- "$start" && pwd -P) || return 3; while :; do if validate_root "$candidate"; then printf '%s\n' "$candidate"; return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) :;; *) self=$(command -v "$self") || return 1;; esac; dir=${self%/*}; [ "$dir" != "$self" ] || dir=.; CDPATH= cd -- "$dir" && pwd -P; }
readpathce() { [ "$#" -eq 2 ] || return 2; resolved=$(realpath -- "$2" 2>/dev/null) || return 1; [ -e "$resolved" ] || return 1; eval "$1=\$resolved"; }
log() { :; }
expect_status() { expected=$1; shift; "$@" >/dev/null 2>&1; actual=$?; [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(find_root "$start"); status=$?; case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac
integration_library=$root/lib/sys/sh/pkg-integration.lib.sh; launch_library=$root/lib/sys/sh/pkg-launch.lib.sh
[ -f "$integration_library" ] && [ ! -x "$integration_library" ] || fail 'pkg-integration library is missing or executable'
[ -f "$launch_library" ] && [ ! -x "$launch_library" ] || fail 'pkg-launch library is missing or executable'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-env-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
m_ROOT=$tmp/root; m_LIB_DIR=$root/lib; m_PKG_DIR=$m_ROOT/pkg; m_BIN_DIR=$m_ROOT/bin; m_BIN_EXT_DIR=$m_BIN_DIR/ext; m_STATE_DIR=$m_ROOT/state; m_STATE_SYS_DIR=$m_STATE_DIR/system/profile/main; m_STATE_USER_DIR=$m_STATE_DIR/user/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-501; m_OSARCH=linux-arm64
mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" "$m_STATE_SYS_DIR" "$m_STATE_USER_DIR" || error 'cannot create fixture root'; export m_ROOT m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_STATE_DIR m_STATE_SYS_DIR m_STATE_USER_DIR m_OSARCH
fake_bin=$tmp/fake-bin; mkdir "$fake_bin"; { printf '%s\n' '#!/bin/sh'; sed '1d' "$root/bin/sys/state-path"; } > "$fake_bin/state-path" || error 'cannot prepare state-path fixture'; chmod 700 "$fake_bin/state-path"; PATH=$fake_bin:$PATH; export PATH
. "$integration_library" || error 'cannot source pkg-integration library'; . "$launch_library" || error 'cannot source pkg-launch library'

provider_range=$tmp/provider-range; provider_root=$tmp/provider-root; mkdir "$provider_range"; printf '%s\n' 'java 21' > "$provider_range/facility"; mkdir -p "$provider_root/bin"; printf '%s\n' '#!/bin/sh' 'printf "provider-java-home=%s\n" "$JAVA_HOME"' > "$provider_root/bin/java"; chmod 700 "$provider_root/bin/java"
pkg_integrate java-provider 21 "$provider_range" "$provider_root" || fail 'provider integration failed'; provider_concrete=$m_PKG_DIR/java-provider@21

consumer_range=$tmp/consumer-range; consumer_root=$tmp/consumer-root; mkdir -p "$consumer_range/cmd" "$consumer_range/link" "$consumer_root/bin"; printf '%s\n' 'java =21' > "$consumer_range/dependency"
cat > "$consumer_range/env" <<'EOF_ENV'
package_dir=${m_COMMAND_BIN%/*}; package_dir=${package_dir%/*}
java_binding="$(cat "$package_dir/binding/java")" || return 1
JAVA_HOME="$m_ROOT/pkg/$java_binding/root"
PATH="$JAVA_HOME/bin:$PATH"
export JAVA_HOME PATH
printf '%s\n' applied > "$TEST_ENV_MARKER" || return 1
unset package_dir java_binding
EOF_ENV
cat > "$consumer_range/cmd/consumer" <<'EOF_COMMAND'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg-launch.lib.sh"
launcher "consumer" "$@"
EOF_COMMAND
printf '%s\n' 'bin/consumer' > "$consumer_range/link/consumer"
cat > "$consumer_root/bin/consumer" <<'EOF_CONSUMER'
#!/bin/sh
printf 'consumer-java-home=%s\n' "$JAVA_HOME"
java
EOF_CONSUMER
chmod 700 "$consumer_root/bin/consumer"; chmod 600 "$consumer_range/env" "$consumer_range/cmd/consumer" "$consumer_range/link/consumer"
TEST_ENV_MARKER=$tmp/env-applied; export TEST_ENV_MARKER
pkg_integrate consumer 1 "$consumer_range" "$consumer_root" || fail 'consumer integration failed'; consumer_concrete=$m_PKG_DIR/consumer@1
[ ! -e "$TEST_ENV_MARKER" ] || fail 'package env executed during integration'; cmp "$consumer_range/env" "$consumer_concrete/env" >/dev/null 2>&1 || fail 'materialized package env differs from catalog bytes'; [ "$(cat "$consumer_concrete/binding/java")" = java-provider@21 ] || fail 'consumer binding is incorrect'
provider_data=$(state-path system sys pkg data) || fail 'cannot resolve provider data'; rm -rf "$provider_data/providers" || error 'cannot remove provider index fixture'
output=$tmp/output
if ! (m_COMMAND_BIN=$consumer_concrete/cmd/consumer; export m_COMMAND_BIN; launcher consumer) > "$output" 2>"$tmp/stderr"; then fail 'consumer launch failed after provider index removal'; fi
[ -f "$TEST_ENV_MARKER" ] || fail 'package env was not sourced during launch'; expected_java_home=$provider_concrete/root; grep -Fx "consumer-java-home=$expected_java_home" "$output" >/dev/null || fail 'consumer did not receive JAVA_HOME'; grep -Fx "provider-java-home=$expected_java_home" "$output" >/dev/null || fail 'provider executable was not selected'
expected_home=$(state-path user pkg consumer home) || fail 'cannot resolve consumer HOME'; [ -d "$expected_home" ] || fail 'launcher did not create consumer HOME'

bad_range=$tmp/bad-range; bad_root=$tmp/bad-root; mkdir "$bad_range" "$bad_root"; printf '%s\n' if > "$bad_range/env"; printf '%s\n' payload > "$bad_root/payload"; expect_status 1 pkg_integrate bad-env 1 "$bad_range" "$bad_root"; [ -d "$bad_root" ] || fail 'invalid env consumed root'; [ ! -e "$m_PKG_DIR/bad-env@1" ] || fail 'invalid env published package'
exec_range=$tmp/exec-range; exec_root=$tmp/exec-root; mkdir "$exec_range" "$exec_root"; printf '%s\n' 'EXAMPLE=value' > "$exec_range/env"; chmod 700 "$exec_range/env"; printf '%s\n' payload > "$exec_root/payload"; expect_status 1 pkg_integrate executable-env 1 "$exec_range" "$exec_root"
exit 0
