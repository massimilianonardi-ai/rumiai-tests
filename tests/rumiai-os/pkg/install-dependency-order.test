#!/bin/sh

TEST_ID=rumiai-os/pkg/install-dependency-order.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

driver=${TMPDIR:-/tmp}/rumiai-pkg-install-order-$$
marker=$driver.marker
depend_marker=$driver.depend
trap 'rm -rf "$driver" "$marker" "$depend_marker" "$driver.err" "$driver.invalid.err" "$driver.store" "$driver.installed" "$driver.installed.err" "$driver.dependency.err"' 0 HUP INT TERM

cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-install" || exit 3

pkg_depend()
{
  printf '%s\n' called >> "$PKG_INSTALL_DEPEND_MARKER"
  if [ "${PKG_INSTALL_DEPEND_FAIL-}" = 1 ]
  then
    log error execution execution-failed operation pkg-depend \
      reason provider-ambiguous \
      facility java \
      constraints '=25' \
      target linux-x86_64 \
      providers 'graalvm@1!linux-x86_64 temurin@2!linux-x86_64'
    return 1
  fi
  printf '%s\n' 'openssl@1!linux-x86_64' 'temurin@21!linux-x86_64'
}

_pkg_install_init()
{
  :
}

pkg_install_one()
{
  printf '%s\n' "$1" >> "$PKG_INSTALL_ORDER_MARKER"
}

pkg_install "$@"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

export PKG_INSTALL_ORDER_MARKER=$marker
export PKG_INSTALL_DEPEND_MARKER=$depend_marker

"$root/m" "$driver" 'bad@@version' > /dev/null 2>"$driver.invalid.err"
invalid_status=$?
[ "$invalid_status" -eq 2 ] || {
  cat "$driver.invalid.err" >&2
  fail "invalid request returned $invalid_status instead of 2"
}
[ ! -e "$depend_marker" ] || fail 'pkg_depend was called before install request validation'

"$root/m" "$driver" geoserver 'demo@3!linux-x86_64' > /dev/null 2>"$driver.err" || {
  cat "$driver.err" >&2
  fail 'pkg_install orchestration failed'
}

expected="openssl@1!linux-x86_64
temurin@21!linux-x86_64
geoserver
demo@3!linux-x86_64"
actual=$(cat "$marker") || error 'cannot read install order'
[ "$actual" = "$expected" ] || fail "unexpected install order:
$actual"
[ "$(cat "$depend_marker")" = called ] || fail 'valid install did not call pkg_depend exactly once'

: > "$depend_marker"
export PKG_INSTALL_DEPEND_FAIL=1
"$root/m" "$driver" keycloak > /dev/null 2>"$driver.dependency.err"
dependency_status=$?
unset PKG_INSTALL_DEPEND_FAIL
[ "$dependency_status" -ne 0 ] || fail 'ambiguous dependency unexpectedly succeeded'
grep -F 'reason="provider-ambiguous"' "$driver.dependency.err" >/dev/null ||
  fail 'pkg install did not preserve pkg depend ambiguity diagnostic'
grep -F '[execution.execution-failed]' "$driver.dependency.err" >/dev/null ||
  fail 'pkg install dependency failure was not classified as execution failure'
if grep -F '[execution.invalid-arguments]' "$driver.dependency.err" >/dev/null
then
  fail 'pkg install dependency failure was incorrectly classified as invalid arguments'
fi

installed_store=$driver.store
mkdir -p "$installed_store/temurin@21!linux-x86_64" || error 'cannot prepare installed concrete fixture'
installed_driver=$driver.installed
cat > "$installed_driver" <<'EOF_INSTALLED_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-install" || exit 3

m_PKG_DIR=$PKG_INSTALL_ORDER_STORE

pkg_catalog_request_resolve()
{
  exit 99
}

pkg_install_one 'temurin@21!linux-x86_64'
EOF_INSTALLED_DRIVER
chmod 700 "$installed_driver" || error 'cannot prepare installed concrete driver'
export PKG_INSTALL_ORDER_STORE=$installed_store
"$root/m" "$installed_driver" > /dev/null 2>"$installed_driver.err" || {
  cat "$installed_driver.err" >&2
  fail 'already-installed dependency concrete was resolved through catalog instead of reused directly'
}

exit 0
