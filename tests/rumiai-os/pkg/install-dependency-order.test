#!/bin/sh

TEST_ID=rumiai-os/pkg/install-dependency-order.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

driver=${TMPDIR:-/tmp}/rumiai-pkg-install-order-$$
marker=$driver.marker
trap 'rm -f "$driver" "$marker"' 0 HUP INT TERM

cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-install" || exit 3

pkg_depend()
{
  printf '%s\n' 'openssl@1!linux-x86_64' 'temurin@21!linux-x86_64'
}

_pkg_install_init()
{
  :
}

pkg_install_one()
{
  printf '%s\n' "$1" >> "$PKG_INSTALL_ORDER_MARKER"
}

pkg_install "$@"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

export PKG_INSTALL_ORDER_MARKER=$marker
"$root/m" "$driver" geoserver 'demo@3!linux-x86_64' > /dev/null 2>"$driver.err" || {
  cat "$driver.err" >&2
  fail 'pkg_install orchestration failed'
}

expected="openssl@1!linux-x86_64
temurin@21!linux-x86_64
geoserver
demo@3!linux-x86_64"
actual=$(cat "$marker") || error 'cannot read install order'
[ "$actual" = "$expected" ] || fail "unexpected install order:
$actual"

exit 0
