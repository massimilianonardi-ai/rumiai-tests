#!/bin/sh

TEST_ID=rumiai-os/pkg/versions.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${root-}" ] && [ -n "${driver-}" ] && [ -f "${driver-}" ]
  then
    for cleanup_spec in       "$generic@1"       "$generic@2"       "$generic@10"       "$target@3!macos-arm64"
    do
      cleanup_name=${cleanup_spec%%@*}
      cleanup_rest=${cleanup_spec#*@}
      case $cleanup_rest in
        *!*)
          cleanup_version=${cleanup_rest%%!*}
          cleanup_osarch=${cleanup_rest#*!}
          "$root/m" "$driver" deintegrate "$cleanup_name" "$cleanup_version" "$cleanup_osarch" >/dev/null 2>&1 || :
          ;;
        *)
          "$root/m" "$driver" deintegrate "$cleanup_name" "$cleanup_rest" >/dev/null 2>&1 || :
          ;;
      esac
    done
  fi

  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_payload()
{
  payload=$1
  marker=$2
  mkdir "$payload" || return 1
  printf '%s\n' "$marker" > "$payload/marker"
}

integrate_generic()
{
  pkg_name=$1
  version=$2
  range=$tmp/range-$pkg_name-$version
  payload=$tmp/payload-$pkg_name-$version
  mkdir "$range" || return 1
  make_payload "$payload" "$pkg_name@$version" || return 1
  "$root/m" "$driver" integrate "$pkg_name" "$version" "$range" "$payload"
}

integrate_target()
{
  pkg_name=$1
  version=$2
  osarch=$3
  range=$tmp/range-$pkg_name-$version-$osarch
  payload=$tmp/payload-$pkg_name-$version-$osarch
  mkdir "$range" || return 1
  make_payload "$payload" "$pkg_name@$version!$osarch" || return 1
  "$root/m" "$driver" integrate "$pkg_name" "$version" "$range" "$payload" "$osarch"
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-versions-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

generic=pvgen$$
target=pvtgt$$
absent=pvabsent$$
pkg_store_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

expect_status 2 no-operand run_pkg versions

for version in 2 10 1
do
  integrate_generic "$generic" "$version" > "$tmp/integrate-$version.out" 2> "$tmp/integrate-$version.err" || {
    cat "$tmp/integrate-$version.err" >&2
    fail "cannot integrate generic version $version"
  }
done

versions=$(run_pkg versions "$generic" 2> "$tmp/generic.err") || {
  cat "$tmp/generic.err" >&2
  fail 'generic versions query failed'
}
expected="$generic@1
$generic@10
$generic@2"
[ "$versions" = "$expected" ] || fail "generic versions output/order is incorrect: $versions"

integrate_target "$target" 3 macos-arm64 > "$tmp/target-integrate.out" 2> "$tmp/target-integrate.err" || {
  cat "$tmp/target-integrate.err" >&2
  fail 'cannot integrate explicit target package'
}

versions=$(run_pkg versions "$target!macos-arm64" 2> "$tmp/target.err") || {
  cat "$tmp/target.err" >&2
  fail 'explicit-target versions query failed'
}
[ "$versions" = "$target@3!macos-arm64" ] ||
  fail "explicit-target versions output is incorrect: $versions"

expect_status 1 absent run_pkg versions "$absent"
[ ! -s "$tmp/absent.out" ] || fail 'missing package produced versions output'

expect_status 2 versioned run_pkg versions "$generic@1"
expect_status 2 invalid-name run_pkg versions Bad
expect_status 2 invalid-osarch run_pkg versions "$generic!foo-bar"
expect_status 2 extra-operand run_pkg versions "$generic" extra

exit 0
