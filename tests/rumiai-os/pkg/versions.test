#!/bin/sh

TEST_ID="rumiai-os/pkg/versions.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

# Target discovery authoring reference:
# massimilianonardi-ai/rumiai-tests@71963b08476ff5c4d5557ed593cd6c4c8414b63c:lib/rumiai-os-target.lib
# Kept inline intentionally so this permanent test remains historically independent.
rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != "/" ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || {
  printf -- '%s\n' "$TEST_ID: git is unavailable" >&2
  exit 2
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

library="$root/lib/sh/pkg-versions.lib.sh"
local_library="$root/lib/sh/pkg-local.lib.sh"
command_path="$root/bin/sys/pkg"
[ -f "$library" ] || fail "lib/sh/pkg-versions.lib.sh is missing"
[ ! -x "$library" ] || fail "pkg-versions library must not be executable"
[ -f "$local_library" ] || fail "lib/sh/pkg-local.lib.sh is missing"
[ ! -x "$local_library" ] || fail "pkg-local library must not be executable"
[ -x "$command_path" ] || fail "bin/sys/pkg is missing or not executable"

PATH="$root/bin/sys:$PATH"
export PATH
"$command_path" versions >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "pkg versions without operand did not return 2"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-versions-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

m_LIB_DIR="$root/lib"
m_PKG_DIR="$tmp/pkg"
m_BIN_DIR="$tmp/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_OSARCH="linux-arm64"
m_CACHE_DIR="$tmp/cache-must-remain-absent"
mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" || error "cannot create fixture roots"
export m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_OSARCH m_CACHE_DIR

log()
{
  :
}

. "$library" || error "cannot source pkg-versions library"

reset_fixture()
{
  rm -rf "$m_PKG_DIR" "$m_BIN_DIR" "$m_CACHE_DIR" || return 1
  mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" || return 1
}

make_concrete()
{
  [ "$#" -eq 2 ] || return 1
  mkdir -p "$m_PKG_DIR/$1@$2" || return 1
}

make_target_concrete()
{
  [ "$#" -eq 3 ] || return 1
  mkdir -p "$m_PKG_DIR/$1@$2!$3" || return 1
}

expect_status()
{
  expected=$1
  shift
  "$@" > "$tmp/output" 2>/dev/null
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

reset_fixture || error "cannot reset fixture"
make_concrete tool 2 || error "cannot create tool 2"
make_concrete tool 10 || error "cannot create tool 10"
make_concrete tool 1 || error "cannot create tool 1"
pkg_versions tool > "$tmp/output" || fail "generic versions query failed"
expected='tool@1
tool@10
tool@2'
[ "$(cat "$tmp/output")" = "$expected" ] || fail "generic versions output/order is incorrect"

reset_fixture || error "cannot reset fixture"
make_concrete dual 1 || error "cannot create dual generic"
make_target_concrete dual 3 macos-arm64 || error "cannot create dual macOS target"
pkg_versions 'dual!macos-arm64' > "$tmp/output" || fail "explicit-target versions query failed"
[ "$(cat "$tmp/output")" = 'dual@3!macos-arm64' ] || fail "explicit-target query leaked another class"

reset_fixture || error "cannot reset fixture"
make_concrete precedence 1 || error "cannot create precedence generic"
make_target_concrete precedence 2 linux-arm64 || error "cannot create precedence target"
ln -s 'precedence@2!linux-arm64' "$m_PKG_DIR/precedence!linux-arm64" || error "cannot create target selector"
pkg_versions precedence > "$tmp/output" || fail "current-target precedence query failed"
[ "$(cat "$tmp/output")" = 'precedence@2!linux-arm64' ] || fail "target precedence or marker-free output is incorrect"

reset_fixture || error "cannot reset fixture"
make_concrete corrupt 1 || error "cannot create corrupt generic"
printf -- '%s\n' broken > "$m_PKG_DIR/corrupt!linux-arm64" || error "cannot create malformed target selector"
expect_status 1 pkg_versions corrupt
[ ! -s "$tmp/output" ] || fail "corrupt priority class fell back to generic output"

reset_fixture || error "cannot reset fixture"
expect_status 1 pkg_versions absent
[ ! -s "$tmp/output" ] || fail "missing package produced versions output"

expect_status 2 pkg_versions 'tool@1'
expect_status 2 pkg_versions Bad
expect_status 2 pkg_versions 'tool!foo-bar'
expect_status 2 pkg_versions tool extra

[ ! -e "$m_CACHE_DIR" ] && [ ! -L "$m_CACHE_DIR" ] || fail "pkg versions touched catalog/cache state"

exit 0
