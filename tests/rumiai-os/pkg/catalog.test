#!/bin/sh

TEST_ID=rumiai-os/pkg/catalog.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -f "$root/lib/sys/sh/pkg/pkg-catalog.lib.sh" ] || fail 'pkg-catalog library is missing'
[ -f "$root/res/sys/manual/pkg-catalog.lib.sh" ] || fail 'pkg-catalog manual is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-catalog-$$
umask 077
mkdir -p "$tmp/source/pkg/demo/linux-x86_64/repository" "$tmp/source/pkg/demo/linux-x86_64/n0001=1" "$tmp/source/pkg/demo/linux-x86_64/n0002=3" "$tmp/source/pkg/generic/all/repository" "$tmp/source/pkg/generic/all/n0001=1" "$tmp/source/pkg/budget/linux-x86_64/repository" "$tmp/source/pkg/budget/linux-x86_64/n0001=1" "$tmp/source/pkg/budget/linux-x86_64/n0002=2" "$tmp/source/pkg/budget/linux-x86_64/n0003=3" "$tmp/source/pkg/budget/linux-x86_64/n0004=4" "$tmp/source/pkg/bad/linux-x86_64/repository" "$tmp/source/pkg/bad/linux-x86_64/n0002=1" "$tmp/conf" "$tmp/work" "$tmp/cache" "$tmp/requirement-tmp" "$tmp/bin" || error 'cannot create fixture'

trap 'rm -rf "$tmp"' 0 HUP INT TERM

for item in demo generic budget bad
do
  case "$item" in
    generic) folder="$tmp/source/pkg/generic/all/repository" ;;
    *) folder="$tmp/source/pkg/$item/linux-x86_64/repository" ;;
  esac
  printf '%s\n' github > "$folder/type"
  printf '%s\n' acme > "$folder/owner"
  printf '%s\n' "$item" > "$folder/repository"
done
printf '%s\n' 1 3 > "$tmp/source/pkg/demo/linux-x86_64/repository/versions"
printf '%s\n' 1 > "$tmp/source/pkg/generic/all/repository/versions"
printf '%s\n' 1 2 3 4 > "$tmp/source/pkg/budget/linux-x86_64/repository/versions"
printf '%s\n' 1 > "$tmp/source/pkg/bad/linux-x86_64/repository/versions"
printf '%s\n' 3 > "$tmp/source/pkg/demo/linux-x86_64/repository/version"
printf '%s\n' 1 > "$tmp/source/pkg/generic/all/repository/version"
printf '%s\n' 4 > "$tmp/source/pkg/budget/linux-x86_64/repository/version"
printf '%s\n' 'java =25' > "$tmp/source/pkg/generic/all/n0001=1/dependency"
printf '%s\n' 1 > "$tmp/source/pkg/bad/linux-x86_64/repository/version"

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
for url do :; done
[ -z "${PKG_CATALOG_TEST_HTTP_LOG-}" ] || printf '%s\n' "$url" >> "$PKG_CATALOG_TEST_HTTP_LOG"
case "$url" in
  */repos/acme/demo/releases/latest)
    printf '%s\n' '{"tag_name":"3","draft":false,"prerelease":false,"created_at":"2026-01-03T00:00:00Z"}'
    ;;
  */repos/acme/demo/releases/tags/2|*/repos/acme/generic/releases/tags/2)
    printf '%s\n' '{"tag_name":"2","draft":false,"prerelease":false,"created_at":"2026-01-02T00:00:00Z","published_at":"2026-01-02T01:00:00Z"}'
    ;;
  */repos/acme/demo/releases/tags/1|*/repos/acme/generic/releases/tags/1)
    printf '%s\n' '{"tag_name":"1","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-01T01:00:00Z"}'
    ;;
  */repos/acme/demo/releases/tags/0)
    printf '%s\n' '{"tag_name":"0","draft":false,"prerelease":false,"created_at":"2025-12-30T00:00:00Z","published_at":"2025-12-30T01:00:00Z"}'
    ;;
  *) exit 77 ;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error 'cannot prepare external boundary fixtures'

driver=$tmp/driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-catalog" || exit 3
PATH="$PKG_CATALOG_TEST_BIN:$PATH"
export PATH

case "$1" in
  stream)
    pkg_catalog_stream_resolve test_stream test_osarch "$2" "$3" "$4" || exit $?
    printf 'stream=%s\n' "$test_stream"
    printf 'osarch=%s\n' "$test_osarch"
    ;;
  range)
    pkg_catalog_range_resolve test_range "$2" "$3" || exit $?
    printf 'range=%s\n' "$test_range"
    ;;
  request)
    pkg_catalog_request_resolve test_concrete test_target "$2" "$3" "$4" || exit $?
    printf 'concrete=%s\n' "$test_concrete"
    printf 'target=%s\n' "$test_target"
    ;;
  invalid-output)
    pkg_catalog_range_resolve bad-name "$2" "$3"
    ;;
  *)
    exit 2
    ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

export PKG_CATALOG_TEST_HTTP_LOG="$tmp/http.log"
export PKG_CATALOG_TEST_BIN="$tmp/bin"
PATH="$tmp/bin:$root/bin/sys:/usr/bin:/bin"
export PATH

# The range/request tests use catalog data as an external input boundary;
# catalog Git transport is exercised by the composed install tests.
mkdir "$tmp/work/catalog" || error 'cannot create catalog fixture snapshot'
command -p -- cp -R "$tmp/source/." "$tmp/work/catalog/" ||
  error 'cannot materialize catalog fixture'
catalog=$tmp/work/catalog

output=$("$root/m" "$driver" stream "$catalog" demo linux-x86_64 2> "$tmp/stream-platform.err") || {
  cat "$tmp/stream-platform.err" >&2
  fail 'platform stream resolution failed'
}
expected="stream=$catalog/pkg/demo/linux-x86_64
osarch=linux-x86_64"
[ "$output" = "$expected" ] || fail "platform stream output is incorrect: $output"

output=$("$root/m" "$driver" stream "$catalog" generic linux-x86_64 2> "$tmp/stream-all.err") || {
  cat "$tmp/stream-all.err" >&2
  fail 'all stream resolution failed'
}
expected="stream=$catalog/pkg/generic/all
osarch="
[ "$output" = "$expected" ] || fail "all stream output is incorrect: $output"

output=$("$root/m" "$driver" range "$catalog" 'demo@2!linux-x86_64' 2> "$tmp/range-middle.err") || {
  cat "$tmp/range-middle.err" >&2
  fail 'range resolution failed'
}
[ "$output" = "range=$catalog/pkg/demo/linux-x86_64/n0001=1" ] || fail "middle version selected wrong range: $output"

output=$("$root/m" "$driver" range "$catalog" 'demo@3!linux-x86_64' 2> "$tmp/range-anchor.err") || {
  cat "$tmp/range-anchor.err" >&2
  fail 'anchor range resolution failed'
}
[ "$output" = "range=$catalog/pkg/demo/linux-x86_64/n0002=3" ] || fail "anchor version selected wrong range: $output"

output=$("$root/m" "$driver" range "$catalog" 'generic@2' 2> "$tmp/range-all.err") || {
  cat "$tmp/range-all.err" >&2
  fail 'all-stream range resolution failed'
}
[ "$output" = "range=$catalog/pkg/generic/all/n0001=1" ] || fail "all-stream range output is incorrect: $output"

: > "$PKG_CATALOG_TEST_HTTP_LOG"
output=$("$root/m" "$driver" range "$catalog" 'budget@4!linux-x86_64' 2> "$tmp/range-budget.err") || {
  cat "$tmp/range-budget.err" >&2
  fail 'newest-anchor range resolution failed'
}
[ "$output" = "range=$catalog/pkg/budget/linux-x86_64/n0004=4" ] || fail "newest-anchor selected wrong range: $output"
[ ! -s "$PKG_CATALOG_TEST_HTTP_LOG" ] ||
  fail 'indexed range selection performed unexpected HTTP requests'

output=$("$root/m" "$driver" request "$catalog" demo linux-x86_64 2> "$tmp/request-latest.err") || {
  cat "$tmp/request-latest.err" >&2
  fail 'request resolution failed'
}
expected="concrete=demo@3!linux-x86_64
target=linux-x86_64"
[ "$output" = "$expected" ] || fail "request resolution output is incorrect: $output"

output=$("$root/m" "$driver" request "$catalog" 'generic@1' linux-x86_64 2> "$tmp/request-all.err") || {
  cat "$tmp/request-all.err" >&2
  fail 'all-stream request resolution failed'
}
expected="concrete=generic@1
target=linux-x86_64"
[ "$output" = "$expected" ] || fail "all-stream request output is incorrect: $output"

expect_status 1 bad-range "$root/m" "$driver" range "$catalog" 'bad@1!linux-x86_64'
expect_status 1 below-first "$root/m" "$driver" range "$catalog" 'demo@0!linux-x86_64'
expect_status 1 missing-stream "$root/m" "$driver" stream "$catalog" missing linux-x86_64
expect_status 2 invalid-output "$root/m" "$driver" invalid-output "$catalog" 'demo@2!linux-x86_64'

exit 0
