#!/bin/sh

TEST_ID=rumiai-os/pkg/state.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
origin_ok() { origin=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;; esac; return 1; }
validate_root() { [ -f "$1/m" ] && [ -f "$1/rumiai-os" ] && [ -f "$1/rumiai-os-sh" ] && origin_ok "$1"; }
find_root() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then validate_root "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; (CDPATH= cd -- "$RUMIAI_TEST_RUMIAI_OS_ROOT" && pwd -P); return; fi; candidate=$(CDPATH= cd -- "$start" && pwd -P) || return 3; while :; do if validate_root "$candidate"; then printf '%s\n' "$candidate"; return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) :;; *) self=$(command -v "$self") || return 1;; esac; dir=${self%/*}; [ "$dir" != "$self" ] || dir=.; CDPATH= cd -- "$dir" && pwd -P; }
readpathce() { [ "$#" -eq 2 ] || return 2; resolved=$(realpath -- "$2" 2>/dev/null) || return 1; [ -e "$resolved" ] || return 1; eval "$1=\$resolved"; }
log() { :; }
expect_status() { expected=$1; shift; "$@" >/dev/null 2>&1; actual=$?; [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"; }
expect_integration_failure() { pkg=$1; ver=$2; range=$3; payload=$4; expect_status 1 pkg_integrate "$pkg" "$ver" "$range" "$payload"; [ -d "$payload" ] || fail "failed integration consumed payload for $pkg"; [ ! -e "$m_PKG_DIR/$pkg@$ver" ] || fail "failed integration published $pkg@$ver"; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(find_root "$start"); status=$?; case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac
integration_library=$root/lib/sys/sh/pkg-integration.lib.sh; state_library=$root/lib/sys/sh/pkg-state.lib.sh; uninstall_library=$root/lib/sys/sh/pkg-uninstall.lib.sh
for lib in "$integration_library" "$state_library" "$uninstall_library"; do [ -f "$lib" ] && [ ! -x "$lib" ] || fail "package library missing or executable: $lib"; done
case "$(sed -n '1p' "$state_library")" in '#!'*) fail 'pkg-state library has a shebang';; esac

tmp=${TMPDIR:-/tmp}/rumiai-pkg-state-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
m_ROOT=$tmp/root
m_LIB_DIR=$root/lib
m_PKG_DIR=$m_ROOT/pkg
m_BIN_DIR=$m_ROOT/bin
m_BIN_EXT_DIR=$m_BIN_DIR/ext
m_STATE_DIR=$m_ROOT/state
m_STATE_SYS_DIR=$m_STATE_DIR/system/current
m_STATE_USER_DIR=$m_STATE_DIR/user/current
m_OSARCH=linux-arm64
mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" "$m_STATE_DIR/system/profile/main" "$m_STATE_DIR/user/default" || error 'cannot create fixture root'
ln -s profile/main "$m_STATE_SYS_DIR" || error 'cannot create current selector'
export m_ROOT m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_STATE_DIR m_STATE_SYS_DIR m_STATE_USER_DIR m_OSARCH
fake_bin=$tmp/fake-bin; mkdir "$fake_bin"; { printf '%s\n' '#!/bin/sh'; sed '1d' "$root/bin/sys/state-path"; } > "$fake_bin/state-path" || error 'cannot prepare state-path fixture'; chmod 700 "$fake_bin/state-path"; PATH=$fake_bin:$PATH; export PATH
. "$integration_library" || error 'cannot source pkg-integration library'; . "$uninstall_library" || error 'cannot source pkg-uninstall library'

plain_range=$tmp/plain-range; plain_root=$tmp/plain-root; mkdir "$plain_range" "$plain_root"; printf '%s\n' payload > "$plain_root/payload"; pkg_integrate plain 1 "$plain_range" "$plain_root" || fail 'plain integration failed'; plain=$m_PKG_DIR/plain@1; [ ! -e "$plain/var" ] || fail 'plain package gained var'; [ ! -e "$plain/default" ] || fail 'plain package gained default'; pkg_deintegrate plain 1 || fail 'plain deintegration failed'

range1=$tmp/stateful-v1-range; payload1=$tmp/stateful-v1-payload
mkdir -p "$range1/var" "$payload1/etc/tool" "$payload1/workspace" "$payload1/space dir" || error 'cannot create v1 fixture'
printf '%s\n' 'etc/tool/config' 'space dir/-settings' > "$range1/var/conf"; printf '%s\n' workspace > "$range1/var/data"
printf '%s\n' factory-v1 > "$payload1/etc/tool/config"; printf '%s\n' spaced-v1 > "$payload1/space dir/-settings"; printf '%s\n' workspace-v1 > "$payload1/workspace/item"
pkg_integrate stateful 1 "$range1" "$payload1" || fail 'stateful v1 integration failed'; concrete1=$m_PKG_DIR/stateful@1
[ "$(readlink "$concrete1/var/conf")" = '../../../state/system/current/pkg/stateful/conf' ] || fail 'var/conf does not follow system/current'
[ "$(readlink "$concrete1/var/data")" = '../../../state/system/current/pkg/stateful/data' ] || fail 'var/data does not follow system/current'
[ "$(readlink "$concrete1/root/etc/tool/config")" = '../../../var/conf/etc/tool/config' ] || fail 'nested root state link is wrong'
[ "$(readlink "$concrete1/root/workspace")" = '../var/data/workspace' ] || fail 'top-level root state link is wrong'
[ "$(readlink "$concrete1/root/space dir/-settings")" = '../../var/conf/space dir/-settings' ] || fail 'state link did not preserve path bytes'
[ "$(cat "$concrete1/default/conf/etc/tool/config")" = factory-v1 ] || fail 'v1 config default missing'; [ "$(cat "$concrete1/default/data/workspace/item")" = workspace-v1 ] || fail 'v1 data default missing'
sys_conf=$m_STATE_SYS_DIR/pkg/stateful/conf; sys_data=$m_STATE_SYS_DIR/pkg/stateful/data
[ "$(cat "$sys_conf/etc/tool/config")" = factory-v1 ] || fail 'system config state not initialized'; [ "$(cat "$sys_data/workspace/item")" = workspace-v1 ] || fail 'system data state not initialized'
[ ! -e "$m_ROOT/conf" ] && [ ! -e "$m_ROOT/data" ] && [ ! -e "$m_ROOT/var" ] || fail 'legacy global state root was materialized'
user_root=$m_STATE_DIR/user/default
user_entries=$(find "$user_root" ! -path "$user_root" -print) || error 'cannot inspect user state'; [ -z "$user_entries" ] || fail 'var-backed package state leaked into user scope'

printf '%s\n' user-config > "$concrete1/root/etc/tool/config"; printf '%s\n' runtime-data > "$concrete1/root/workspace/runtime"
[ "$(cat "$sys_conf/etc/tool/config")" = user-config ] || fail 'root -> var -> system conf chain failed'; [ "$(cat "$sys_data/workspace/runtime")" = runtime-data ] || fail 'root -> var -> system data chain failed'

range2=$tmp/stateful-v2-range; payload2=$tmp/stateful-v2-payload
mkdir -p "$range2/var" "$payload2/etc/tool" "$payload2/workspace" "$payload2/space dir"; printf '%s\n' 'etc/tool/config' 'space dir/-settings' > "$range2/var/conf"; printf '%s\n' workspace > "$range2/var/data"; printf '%s\n' factory-v2 > "$payload2/etc/tool/config"; printf '%s\n' spaced-v2 > "$payload2/space dir/-settings"; printf '%s\n' workspace-v2 > "$payload2/workspace/item"
pkg_integrate stateful 2 "$range2" "$payload2" || fail 'stateful v2 integration failed'; concrete2=$m_PKG_DIR/stateful@2
[ "$(cat "$sys_conf/etc/tool/config")" = user-config ] || fail 'v2 overwrote config state'; [ "$(cat "$sys_data/workspace/runtime")" = runtime-data ] || fail 'v2 lost runtime data'; [ "$(cat "$concrete2/default/conf/etc/tool/config")" = factory-v2 ] || fail 'v2 factory default missing'

other=$m_STATE_DIR/system/profile/other; mkdir -p "$other/pkg/stateful/conf/etc/tool" "$other/pkg/stateful/data/workspace"; printf '%s\n' other-config > "$other/pkg/stateful/conf/etc/tool/config"; printf '%s\n' other-data > "$other/pkg/stateful/data/workspace/item"
rm "$m_STATE_DIR/system/current"; ln -s profile/other "$m_STATE_DIR/system/current" || error 'cannot switch selector fixture'
[ "$(cat "$concrete2/root/etc/tool/config")" = other-config ] || fail 'var did not follow state/system/current after profile switch'
[ "$(state-path system pkg stateful conf)" = "$m_STATE_SYS_DIR/pkg/stateful/conf" ] || fail 'state-path fixture did not preserve the semantic system selector path'
rm "$m_STATE_DIR/system/current"; ln -s profile/main "$m_STATE_DIR/system/current" || error 'cannot restore selector fixture'
[ "$(cat "$concrete2/root/etc/tool/config")" = user-config ] || fail 'restored selector did not expose main state'

pkg_deintegrate stateful 1 || fail 'v1 deintegration failed'; pkg_uninstall 'stateful@2' || fail 'v2 uninstall failed'
[ "$(cat "$sys_conf/etc/tool/config")" = user-config ] || fail 'uninstall removed config state'; [ "$(cat "$sys_data/workspace/runtime")" = runtime-data ] || fail 'uninstall removed data state'

bad_range=$tmp/bad-range; bad_root=$tmp/bad-root; mkdir -p "$bad_range/var" "$bad_root"; printf '%s\n' item > "$bad_range/var/other"; printf '%s\n' value > "$bad_root/item"; expect_integration_failure bad-area 1 "$bad_range" "$bad_root"
rm -rf "$bad_range" "$bad_root"; mkdir -p "$bad_range/var" "$bad_root/dir"; printf '%s\n' dir 'dir/file' > "$bad_range/var/conf"; printf '%s\n' value > "$bad_root/dir/file"; expect_integration_failure overlap 1 "$bad_range" "$bad_root"
rm -rf "$bad_range" "$bad_root"; mkdir -p "$bad_range/var" "$bad_root"; printf '%s\n' item > "$bad_range/var/conf"; printf '%s\n' value > "$bad_root/item"; expect_integration_failure sys 1 "$bad_range" "$bad_root"
rm -rf "$bad_range" "$bad_root"; mkdir -p "$bad_range/var" "$bad_root/.m"; printf '%s\n' '.m/env' > "$bad_range/var/conf"; printf '%s\n' upstream > "$bad_root/.m/env"; expect_integration_failure reserved-conf 1 "$bad_range" "$bad_root"
exit 0
