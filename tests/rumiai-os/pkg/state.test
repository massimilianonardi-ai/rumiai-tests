#!/bin/sh

TEST_ID=rumiai-os/pkg/state.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${root-}" ] && [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :

    for cleanup_version in 1 2
    do
      if [ -d "$root/pkg/$package@$cleanup_version" ] && [ ! -L "$root/pkg/$package@$cleanup_version" ]
      then
        if [ -n "${driver-}" ] && [ -f "$driver" ]
        then
          "$root/m" "$driver" deintegrate "$package" "$cleanup_version" >/dev/null 2>&1 || :
        fi
        rm -rf "$root/pkg/$package@$cleanup_version" 2>/dev/null || :
      fi
    done

    rm -f "$root/pkg/$package" "$root/bin/ext/$package" 2>/dev/null || :
  fi

  [ -z "${system_pkg_root-}" ] || rm -rf "$system_pkg_root" 2>/dev/null || :
  [ -z "${user_pkg_root-}" ] || rm -rf "$user_pkg_root" 2>/dev/null || :

  if [ "${bin_ext_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/bin/ext" 2>/dev/null || :
  fi
  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_stateful_definition()
{
  version=$1
  range=$tmp/range-$version
  payload=$tmp/payload-$version

  mkdir -p "$range/cmd" "$range/link" "$range/var"     "$payload/bin" "$payload/etc/tool" "$payload/workspace" ||
    return 1

  cat > "$range/cmd/$package" <<EOF_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_COMMAND
  chmod 600 "$range/cmd/$package" || return 1
  printf '%s\n' bin/upstream > "$range/link/$package" || return 1
  printf '%s\n' etc/tool/config > "$range/var/conf" || return 1
  printf '%s\n' workspace > "$range/var/data" || return 1

  cat > "$payload/bin/upstream" <<'EOF_UPSTREAM'
#!/bin/sh
self_dir=${0%/*}
root=${self_dir%/*}

case ${1-read} in
  read)
    printf 'config=%s\n' "$(cat "$root/etc/tool/config")"
    printf 'item=%s\n' "$(cat "$root/workspace/item")"
    if [ -f "$root/workspace/runtime" ]
    then
      printf 'runtime=%s\n' "$(cat "$root/workspace/runtime")"
    else
      printf 'runtime=absent\n'
    fi
    ;;
  write)
    printf '%s\n' user-config > "$root/etc/tool/config"
    printf '%s\n' runtime-data > "$root/workspace/runtime"
    ;;
  *)
    exit 2
    ;;
esac
EOF_UPSTREAM
  chmod 700 "$payload/bin/upstream" || return 1

  printf '%s\n' "factory-v$version" > "$payload/etc/tool/config" || return 1
  printf '%s\n' "workspace-v$version" > "$payload/workspace/item" || return 1
}

expect_failed_integration()
{
  name=$1
  range=$2
  payload=$3

  "$root/m" "$driver" integrate "$name" 1 "$range" "$payload"     > "$tmp/$name.out" 2> "$tmp/$name.err"
  status=$?
  [ "$status" -eq 1 ] || {
    cat "$tmp/$name.err" >&2
    fail "$name invalid state definition returned $status instead of 1"
  }
  [ -d "$payload" ] || fail "$name failed integration consumed caller-owned payload"
  [ ! -e "$root/pkg/$name@1" ] && [ ! -L "$root/pkg/$name@1" ] ||
    fail "$name failed integration published a concrete package"
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-state-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=pstest$$
pkg_store_created=0
bin_ext_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 600 "$driver" || error 'cannot prepare integration driver'

system_conf=$("$root/m" "$root/bin/sys/state-path" system pkg "$package" conf) ||
  error 'cannot resolve system package conf'
system_data=$("$root/m" "$root/bin/sys/state-path" system pkg "$package" data) ||
  error 'cannot resolve system package data'
user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" conf) ||
  error 'cannot resolve user package conf'
user_data=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" data) ||
  error 'cannot resolve user package data'
user_home=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" home) ||
  error 'cannot resolve user package home'

system_pkg_root=${system_conf%/conf}
user_pkg_root=${user_home%/home}

for path in "$system_conf" "$system_data" "$user_conf" "$user_data" "$user_home"
do
  [ ! -e "$path" ] && [ ! -L "$path" ] ||
    error "temporary package state already exists: $path"
done

make_stateful_definition 1 || error 'cannot prepare stateful version 1'
"$root/m" "$driver" integrate "$package" 1 "$tmp/range-1" "$tmp/payload-1"   > "$tmp/integrate-1.out" 2> "$tmp/integrate-1.err" || {
    cat "$tmp/integrate-1.err" >&2
    fail 'stateful version 1 integration failed'
  }

[ "$(cat "$system_conf/etc/tool/config")" = factory-v1 ] ||
  fail 'version 1 did not initialize system configuration state'
[ "$(cat "$system_data/workspace/item")" = workspace-v1 ] ||
  fail 'version 1 did not initialize system data state'
[ ! -e "$user_conf" ] && [ ! -L "$user_conf" ] ||
  fail 'system-scoped var configuration leaked into user state'
[ ! -e "$user_data" ] && [ ! -L "$user_data" ] ||
  fail 'system-scoped var data leaked into user state'

run_pkg default "$package@1" > "$tmp/default-1.out" 2> "$tmp/default-1.err" || {
  cat "$tmp/default-1.err" >&2
  fail 'cannot select stateful version 1'
}

(
  PATH="$root/bin/ext:$root/bin/sys:$PATH"
  export PATH
  "$package" read
) > "$tmp/read-1.out" 2> "$tmp/read-1.err" || {
  cat "$tmp/read-1.err" >&2
  fail 'stateful version 1 command failed'
}
grep -Fx 'config=factory-v1' "$tmp/read-1.out" >/dev/null 2>&1 ||
  fail 'integrated command did not observe version 1 system configuration'
grep -Fx 'item=workspace-v1' "$tmp/read-1.out" >/dev/null 2>&1 ||
  fail 'integrated command did not observe version 1 system data'
grep -Fx 'runtime=absent' "$tmp/read-1.out" >/dev/null 2>&1 ||
  fail 'unexpected runtime data existed before write'

(
  PATH="$root/bin/ext:$root/bin/sys:$PATH"
  export PATH
  "$package" write
) > "$tmp/write.out" 2> "$tmp/write.err" || {
  cat "$tmp/write.err" >&2
  fail 'stateful package could not write through var routing'
}

[ "$(cat "$system_conf/etc/tool/config")" = user-config ] ||
  fail 'write through package root did not reach system configuration state'
[ "$(cat "$system_data/workspace/runtime")" = runtime-data ] ||
  fail 'write through package root did not reach system data state'

make_stateful_definition 2 || error 'cannot prepare stateful version 2'
"$root/m" "$driver" integrate "$package" 2 "$tmp/range-2" "$tmp/payload-2"   > "$tmp/integrate-2.out" 2> "$tmp/integrate-2.err" || {
    cat "$tmp/integrate-2.err" >&2
    fail 'stateful version 2 integration failed'
  }

[ "$(cat "$system_conf/etc/tool/config")" = user-config ] ||
  fail 'version 2 integration overwrote authoritative mutable configuration'
[ "$(cat "$system_data/workspace/item")" = workspace-v1 ] ||
  fail 'version 2 integration overwrote existing mutable data defaults'
[ "$(cat "$system_data/workspace/runtime")" = runtime-data ] ||
  fail 'version 2 integration lost runtime-created mutable data'

run_pkg default "$package@2" > "$tmp/default-2.out" 2> "$tmp/default-2.err" || {
  cat "$tmp/default-2.err" >&2
  fail 'cannot select stateful version 2'
}

(
  PATH="$root/bin/ext:$root/bin/sys:$PATH"
  export PATH
  "$package" read
) > "$tmp/read-2.out" 2> "$tmp/read-2.err" || {
  cat "$tmp/read-2.err" >&2
  fail 'stateful version 2 command failed'
}
grep -Fx 'config=user-config' "$tmp/read-2.out" >/dev/null 2>&1 ||
  fail 'version 2 command did not observe preserved configuration state'
grep -Fx 'item=workspace-v1' "$tmp/read-2.out" >/dev/null 2>&1 ||
  fail 'version 2 command did not observe preserved data state'
grep -Fx 'runtime=runtime-data' "$tmp/read-2.out" >/dev/null 2>&1 ||
  fail 'version 2 command did not observe runtime-created data'

[ ! -e "$user_conf" ] && [ ! -L "$user_conf" ] ||
  fail 'stateful integration wrote configuration into user scope'
[ ! -e "$user_data" ] && [ ! -L "$user_data" ] ||
  fail 'stateful integration wrote data into user scope'
[ -d "$user_home" ] && [ ! -L "$user_home" ] ||
  fail 'launcher did not independently materialize package HOME'

run_pkg default -u -- "$package" > "$tmp/clear.out" 2> "$tmp/clear.err" ||
  fail 'cannot clear stateful package default'

"$root/m" "$driver" deintegrate "$package" 1 > "$tmp/remove-1.out" 2> "$tmp/remove-1.err" ||
  fail 'cannot deintegrate stateful version 1'
"$root/m" "$driver" deintegrate "$package" 2 > "$tmp/remove-2.out" 2> "$tmp/remove-2.err" ||
  fail 'cannot deintegrate stateful version 2'

[ "$(cat "$system_conf/etc/tool/config")" = user-config ] ||
  fail 'deintegration removed persistent configuration state'
[ "$(cat "$system_data/workspace/runtime")" = runtime-data ] ||
  fail 'deintegration removed persistent data state'

empty_dir=${package}d
empty_dir_range=$tmp/empty-dir-range
empty_dir_payload=$tmp/empty-dir-payload
mkdir -p "$empty_dir_range/var" "$empty_dir_payload" ||
  error 'cannot create empty-directory state fixture'
printf '%s\n' data > "$empty_dir_range/var/data" ||
  error 'cannot define empty-directory state mapping'

empty_dir_data=$("$root/m" "$root/bin/sys/state-path" system pkg "$empty_dir" data) ||
  error 'cannot resolve empty-directory package data state'
empty_dir_state_root=${empty_dir_data%/data}
[ ! -e "$empty_dir_state_root" ] && [ ! -L "$empty_dir_state_root" ] ||
  error 'empty-directory package state already exists'

"$root/m" "$driver" integrate "$empty_dir" 1 "$empty_dir_range" "$empty_dir_payload" \
  > "$tmp/empty-dir.out" 2> "$tmp/empty-dir.err" || {
    cat "$tmp/empty-dir.err" >&2
    fail 'declared absent state directory integration failed'
  }

empty_dir_concrete=$root/pkg/$empty_dir@1
[ -L "$empty_dir_concrete/root/data" ] ||
  fail 'declared absent state directory was not routed from package root'
[ "$(readlink "$empty_dir_concrete/root/data")" = ../var/data/data ] ||
  fail 'declared absent state directory has an unexpected package-root route'
[ -d "$empty_dir_concrete/default/data/data" ] &&
[ ! -L "$empty_dir_concrete/default/data/data" ] ||
  fail 'declared absent state directory did not materialize an empty factory directory'
[ -d "$empty_dir_data/data" ] && [ ! -L "$empty_dir_data/data" ] ||
  fail 'declared absent state directory did not initialize managed mutable state'

for empty_dir_item in \
  "$empty_dir_concrete/default/data/data"/* \
  "$empty_dir_concrete/default/data/data"/.[!.]* \
  "$empty_dir_concrete/default/data/data"/..?*
do
  [ -e "$empty_dir_item" ] || [ -L "$empty_dir_item" ] || continue
  fail 'declared absent state factory directory is not empty'
done

printf '%s\n' runtime > "$empty_dir_concrete/root/data/runtime" ||
  fail 'cannot write through synthesized package state route'
[ "$(cat "$empty_dir_data/data/runtime")" = runtime ] ||
  fail 'write through synthesized package state route did not reach managed state'

"$root/m" "$driver" deintegrate "$empty_dir" 1 \
  > "$tmp/empty-dir-remove.out" 2> "$tmp/empty-dir-remove.err" || {
    cat "$tmp/empty-dir-remove.err" >&2
    fail 'cannot deintegrate synthesized-state package'
  }
[ "$(cat "$empty_dir_data/data/runtime")" = runtime ] ||
  fail 'deintegration removed synthesized mutable state'
rm -rf "$empty_dir_state_root" || error 'cannot remove empty-directory package state fixture'

missing_parent=${package}e
missing_parent_range=$tmp/missing-parent-range
missing_parent_payload=$tmp/missing-parent-payload
mkdir -p "$missing_parent_range/var" "$missing_parent_payload" ||
  error 'cannot create missing-parent state fixture'
printf '%s\n' missing/data > "$missing_parent_range/var/data"
expect_failed_integration "$missing_parent" "$missing_parent_range" "$missing_parent_payload"

bad_area=${package}a
bad_range=$tmp/bad-area-range
bad_payload=$tmp/bad-area-payload
mkdir -p "$bad_range/var" "$bad_payload" || error 'cannot create invalid-area fixture'
printf '%s\n' item > "$bad_range/var/other"
printf '%s\n' value > "$bad_payload/item"
expect_failed_integration "$bad_area" "$bad_range" "$bad_payload"

overlap=${package}b
overlap_range=$tmp/overlap-range
overlap_payload=$tmp/overlap-payload
mkdir -p "$overlap_range/var" "$overlap_payload/dir" || error 'cannot create overlap fixture'
printf '%s\n' dir dir/file > "$overlap_range/var/conf"
printf '%s\n' value > "$overlap_payload/dir/file"
expect_failed_integration "$overlap" "$overlap_range" "$overlap_payload"

reserved=${package}c
reserved_range=$tmp/reserved-range
reserved_payload=$tmp/reserved-payload
mkdir -p "$reserved_range/var" "$reserved_payload/.m" || error 'cannot create reserved-conf fixture'
printf '%s\n' .m/env > "$reserved_range/var/conf"
printf '%s\n' upstream > "$reserved_payload/.m/env"
expect_failed_integration "$reserved" "$reserved_range" "$reserved_payload"

exit 0
