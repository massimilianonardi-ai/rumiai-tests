#!/bin/sh

TEST_ID=rumiai-os/pkg/facility-contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'
[ -f "$root/lib/sys/sh/pkg/facility/pkg-facility.lib.sh" ] ||
  fail 'pkg facility library is missing'
[ -f "$root/lib/sys/sh/pkg/facility/pkg-facility-cmd.lib.sh" ] ||
  fail 'pkg facility cmd handler is missing'
[ -f "$root/lib/sys/sh/pkg/facility/pkg-facility-env.lib.sh" ] ||
  fail 'pkg facility env handler is missing'
[ -f "$root/lib/sys/sh/pkg/facility/pkg-facility-service.lib.sh" ] ||
  fail 'pkg facility service handler is missing'
[ -f "$root/res/sys/manual/pkg-facility.lib.sh" ] ||
  fail 'pkg facility library manual is missing'
[ -f "$root/res/sys/manual/pkg-facility-cmd.lib.sh" ] ||
  fail 'pkg facility cmd manual is missing'
[ -f "$root/res/sys/manual/pkg-facility-env.lib.sh" ] ||
  fail 'pkg facility env manual is missing'
[ -f "$root/res/sys/manual/pkg-facility-service.lib.sh" ] ||
  fail 'pkg facility service manual is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-facility-contract-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

driver=$tmp/facility-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/facility/pkg-facility.lib.sh" || exit 3
action=$1
shift
case "$action" in
  contract) pkg_facility_contract_validate "$@" ;;
  provider) pkg_facility_provider_validate "$@" ;;
  provider-inert)
    JAVA_HOME=caller-value
    export JAVA_HOME
    pkg_facility_provider_validate "$@" || exit $?
    [ "$JAVA_HOME" = caller-value ]
    ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare facility driver'

facility=facilityprobe$$
catalog=$tmp/catalog
contract=$catalog/facility/$facility/25
provider=$catalog/pkg/provider/linux-x86_64/range
payload=$tmp/payload
SERVICE_EXEC_MARKER=$tmp/service-executed
export SERVICE_EXEC_MARKER

make_valid()
{
  rm -rf "$catalog" "$provider" "$payload"
  rm -f "$SERVICE_EXEC_MARKER"
  mkdir -p "$contract/cmd" "$contract/env" "$contract/service" \
    "$provider/facility-cmd/$facility" "$provider/facility-env" \
    "$provider/facility-service/$facility" "$provider/cmd" "$provider/link" \
    "$payload/bin" || return 1

  : > "$contract/cmd/java" || return 1
  : > "$contract/cmd/javac" || return 1
  : > "$contract/env/JAVA_HOME" || return 1
  printf '%s\n' package-command > "$contract/service/start" || return 1
  printf '%s\n' foreground > "$contract/service/process" || return 1
  printf '%s\n' sigterm > "$contract/service/stop" || return 1

  printf '%s 25\n' "$facility" > "$provider/facility" || return 1
  printf '%s\n' bin/java > "$provider/facility-cmd/$facility/java" || return 1
  printf '%s\n' bin/javac > "$provider/facility-cmd/$facility/javac" || return 1
  tab=$(printf '\t')
  printf 'JAVA_HOME%sroot\n' "$tab" > "$provider/facility-env/$facility" || return 1

  printf '%s\n' service-start > "$provider/facility-service/$facility/start" || return 1
  cat > "$provider/cmd/service-start" <<'EOF_SERVICE_COMMAND'
#!/usr/bin/env m
exit 0
EOF_SERVICE_COMMAND
  printf '%s\n' bin/service-target > "$provider/link/service-start" || return 1

  cat > "$payload/bin/java" <<'EOF_JAVA'
#!/bin/sh
exit 0
EOF_JAVA
  cp "$payload/bin/java" "$payload/bin/javac" || return 1

  cat > "$payload/bin/service-target" <<'EOF_SERVICE_TARGET'
#!/bin/sh
: > "$SERVICE_EXEC_MARKER"
exit 0
EOF_SERVICE_TARGET

  chmod 700 "$payload/bin/java" "$payload/bin/javac" "$payload/bin/service-target" || return 1
}

make_valid || error 'cannot prepare valid facility/provider fixture'

"$root/m" "$driver" contract "$contract" > "$tmp/contract-valid.out" 2> "$tmp/contract-valid.err" || {
  cat "$tmp/contract-valid.err" >&2
  fail 'valid facility contract was rejected'
}
"$root/m" "$driver" provider "$catalog" "$provider" "$payload" > "$tmp/provider-valid.out" 2> "$tmp/provider-valid.err" || {
  cat "$tmp/provider-valid.err" >&2
  fail 'conforming provider realization was rejected'
}
[ ! -e "$SERVICE_EXEC_MARKER" ] ||
  fail 'service conformance executed the provider start target'

# Conformance is inert: it must not create provider-selection configuration.
expect_status 1 default-before "$root/m" "$root/bin/sys/pkg" provider default "$facility"
"$root/m" "$driver" provider-inert "$catalog" "$provider" "$payload" >/dev/null 2> "$tmp/provider-inert.err" || {
  cat "$tmp/provider-inert.err" >&2
  fail 'provider validation changed process environment'
}
expect_status 1 default-after "$root/m" "$root/bin/sys/pkg" provider default "$facility"

# Contract part types are closed and trusted.
make_valid || error 'cannot reset valid fixture'
mkdir "$contract/unknown" || error 'cannot prepare unknown contract part'
: > "$contract/unknown/member" || error 'cannot prepare unknown contract member'
expect_status 1 unknown-contract-part "$root/m" "$driver" contract "$contract"

# Every required command must be realized.
make_valid || error 'cannot reset valid fixture'
rm "$provider/facility-cmd/$facility/javac" || error 'cannot remove required command realization'
expect_status 1 missing-command "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Provider-specific extras do not become optional facility members.
make_valid || error 'cannot reset valid fixture'
printf '%s\n' bin/java > "$provider/facility-cmd/$facility/jar" ||
  error 'cannot prepare extra command realization'
expect_status 1 extra-command "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Environment realization must match the exact required surface.
make_valid || error 'cannot reset valid fixture'
tab=$(printf '\t')
{
  printf 'EXTRA%s%s\n' "$tab" 'literal extra'
  printf 'JAVA_HOME%s%s\n' "$tab" root
} > "$provider/facility-env/$facility" || error 'cannot prepare extra environment realization'
expect_status 1 extra-environment "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# PATH is not an environment facility member.
make_valid || error 'cannot reset valid fixture'
: > "$contract/env/PATH" || error 'cannot prepare invalid PATH contract marker'
expect_status 1 path-contract "$root/m" "$driver" contract "$contract"

# Service contract values are a closed trusted schema.
make_valid || error 'cannot reset valid fixture'
printf '%s\n' daemon > "$contract/service/process" ||
  error 'cannot prepare invalid service process contract'
expect_status 1 invalid-service-process "$root/m" "$driver" contract "$contract"

# A service provider must realize the required package-command start mapping.
make_valid || error 'cannot reset valid fixture'
rm "$provider/facility-service/$facility/start" ||
  error 'cannot remove service start realization'
expect_status 1 missing-service-start "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Generic SIGTERM stop does not admit a provider-specific stop realization.
make_valid || error 'cannot reset valid fixture'
printf '%s\n' service-stop > "$provider/facility-service/$facility/stop" ||
  error 'cannot prepare provider-specific stop realization'
expect_status 1 extra-service-stop "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# The service start mapping must name an ordinary command of the same provider.
make_valid || error 'cannot reset valid fixture'
printf '%s\n' missing-start-command > "$provider/facility-service/$facility/start" ||
  error 'cannot prepare missing service command mapping'
expect_status 1 missing-service-command "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# A service realization cannot exist when the exact facility contract has no service part.
make_valid || error 'cannot reset valid fixture'
rm -rf "$contract/service" || error 'cannot remove service contract part'
expect_status 1 service-without-contract "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Provider realization surfaces are closed as well.
make_valid || error 'cannot reset valid fixture'
mkdir -p "$provider/facility-lifecycle/$facility" ||
  error 'cannot prepare unknown provider facility surface'
expect_status 1 unknown-provider-surface "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Exact compatibility must have an exact facility contract.
make_valid || error 'cannot reset valid fixture'
printf '%s 26\n' "$facility" > "$provider/facility" ||
  error 'cannot prepare missing-compatibility declaration'
expect_status 1 missing-contract "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

# Provider definitions outside catalog/pkg are rejected: conformance is snapshot-bound.
make_valid || error 'cannot reset valid fixture'
outside=$tmp/outside-provider
cp -R "$provider" "$outside" || error 'cannot prepare outside provider definition'
expect_status 1 outside-catalog "$root/m" "$driver" provider "$catalog" "$outside" "$payload"

# Facility realization without a declaration is invalid.
make_valid || error 'cannot reset valid fixture'
rm "$provider/facility" || error 'cannot remove provider facility declaration'
expect_status 1 realization-without-declaration "$root/m" "$driver" provider "$catalog" "$provider" "$payload"

printf 'contract-validation=ok\n'
printf 'provider-conformance=ok\n'
printf 'service-conformance=ok\n'
printf 'conformance-inert=ok\n'
exit 0
