#!/bin/sh

TEST_ID=rumiai-os/pkg/common.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -f "$root/lib/sys/sh/pkg/pkg-common.lib.sh" ] || fail 'pkg-common library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-common-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

driver=$tmp/driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-common" || exit 3

case "$1" in
  request)
    shift
    pkg_request_read pkg_test_name pkg_test_version pkg_test_osarch "$1" || exit $?
    printf 'name=%s\n' "$pkg_test_name"
    printf 'version=%s\n' "$pkg_test_version"
    printf 'osarch=%s\n' "$pkg_test_osarch"
    ;;
  read)
    shift
    pkg_concrete_read pkg_test_name pkg_test_version pkg_test_osarch "$1" || exit $?
    printf 'name=%s\n' "$pkg_test_name"
    printf 'version=%s\n' "$pkg_test_version"
    printf 'osarch=%s\n' "$pkg_test_osarch"
    ;;
  invalid-preserves)
    pkg_test_name=before-name
    pkg_test_version=before-version
    pkg_test_osarch=before-osarch
    pkg_concrete_read pkg_test_name pkg_test_version pkg_test_osarch foo || status=$?
    [ "${status-0}" -eq 1 ] || exit 4
    [ "$pkg_test_name" = before-name ] || exit 5
    [ "$pkg_test_version" = before-version ] || exit 6
    [ "$pkg_test_osarch" = before-osarch ] || exit 7
    ;;
  invalid-output)
    pkg_concrete_read bad-name pkg_test_version pkg_test_osarch foo@1
    ;;
  duplicate-output)
    pkg_concrete_read pkg_test_name pkg_test_name pkg_test_osarch foo@1
    ;;
  *)
    exit 2
    ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

output=$("$root/m" "$driver" request 'temurin!linux-x86_64' 2> "$tmp/request-platform.err") || {
  cat "$tmp/request-platform.err" >&2
  fail 'platform request read failed'
}
expected='name=temurin
version=
osarch=linux-x86_64'
[ "$output" = "$expected" ] || fail "platform request output is incorrect: $output"

output=$("$root/m" "$driver" request 'foo' 2> "$tmp/request-generic.err") || {
  cat "$tmp/request-generic.err" >&2
  fail 'generic request read failed'
}
expected='name=foo
version=
osarch='
[ "$output" = "$expected" ] || fail "generic request output is incorrect: $output"

output=$("$root/m" "$driver" request 'foo@1.2' 2> "$tmp/request-version.err") || {
  cat "$tmp/request-version.err" >&2
  fail 'versioned request read failed'
}
expected='name=foo
version=1.2
osarch='
[ "$output" = "$expected" ] || fail "versioned request output is incorrect: $output"

output=$("$root/m" "$driver" read 'temurin@25.0.2+10!linux-x86_64' 2> "$tmp/platform.err") || {
  cat "$tmp/platform.err" >&2
  fail 'platform concrete read failed'
}
expected='name=temurin
version=25.0.2+10
osarch=linux-x86_64'
[ "$output" = "$expected" ] || fail "platform concrete output is incorrect: $output"

output=$("$root/m" "$driver" read 'foo@1.2' 2> "$tmp/generic.err") || {
  cat "$tmp/generic.err" >&2
  fail 'generic concrete read failed'
}
expected='name=foo
version=1.2
osarch='
[ "$output" = "$expected" ] || fail "generic concrete output is incorrect: $output"

expect_status 0 request-unversioned "$root/m" "$driver" request foo
expect_status 1 request-empty-version "$root/m" "$driver" request 'foo@'
expect_status 1 request-invalid-name "$root/m" "$driver" request 'Bad'
expect_status 1 request-invalid-osarch "$root/m" "$driver" request 'foo!other'
expect_status 1 missing-version "$root/m" "$driver" read foo
expect_status 1 empty-version "$root/m" "$driver" read 'foo@'
expect_status 1 invalid-name "$root/m" "$driver" read 'Bad@1'
expect_status 1 invalid-osarch "$root/m" "$driver" read 'foo@1!other'
expect_status 1 duplicate-at "$root/m" "$driver" read 'foo@1@2'
expect_status 1 duplicate-osarch "$root/m" "$driver" read 'foo@1!linux-x86_64!linux-arm64'
expect_status 0 invalid-preserves "$root/m" "$driver" invalid-preserves
expect_status 2 invalid-output "$root/m" "$driver" invalid-output
expect_status 2 duplicate-output "$root/m" "$driver" duplicate-output

printf 'pkg-concrete-read=ok\n'
exit 0
