#!/bin/sh

TEST_ID=rumiai-os/pkg/install-stream.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    command -p -- cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -f "$root/lib/sys/sh/pkg/pkg-install.lib.sh" ] || fail 'pkg-install library missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-install-stream-$$
umask 077
command -p -- mkdir -p "$tmp/catalog/pkg" || error 'cannot prepare catalog fixture'
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

driver=$tmp/driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-install.lib.sh" || exit 3

_pkg_install_stream_select "$@"
status=$?
[ "$status" -eq 0 ] || exit "$status"

printf 'stream=%s\n' "$pkg_install_stream"
printf 'identity-osarch=%s\n' "$pkg_install_identity_osarch"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare stream driver'

generic=streamgeneric
target=streamtarget
legacy=streamlegacy
broken=streambroken

command -p -- mkdir -p "$tmp/catalog/pkg/$generic/all"
out=$("$root/m" "$driver" "$tmp/catalog" "$generic" linux-x86_64) ||
  fail 'all-only package stream was not selected'
expected="stream=$tmp/catalog/pkg/$generic/all
identity-osarch="
[ "$out" = "$expected" ] || fail "all-only stream selection mismatch: $out"

command -p -- mkdir -p \
  "$tmp/catalog/pkg/$target/all" \
  "$tmp/catalog/pkg/$target/linux-x86_64"
out=$("$root/m" "$driver" "$tmp/catalog" "$target" linux-x86_64) ||
  fail 'exact target stream was not selected'
expected="stream=$tmp/catalog/pkg/$target/linux-x86_64
identity-osarch=linux-x86_64"
[ "$out" = "$expected" ] || fail "exact target stream selection mismatch: $out"

command -p -- mkdir -p "$tmp/catalog/pkg/$legacy/catalog"
expect_status 1 legacy-catalog "$root/m" "$driver" "$tmp/catalog" "$legacy" linux-x86_64

command -p -- mkdir -p "$tmp/catalog/pkg/$broken/all"
printf '%s\n' invalid > "$tmp/catalog/pkg/$broken/linux-x86_64"
expect_status 1 malformed-exact "$root/m" "$driver" "$tmp/catalog" "$broken" linux-x86_64

printf 'exact-target-precedence=ok\n'
printf 'all-fallback=ok\n'
printf 'catalog-not-stream=ok\n'

exit 0
