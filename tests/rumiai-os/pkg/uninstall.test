#!/bin/sh

TEST_ID="rumiai-os/pkg/uninstall.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

library="$root/lib/sh/pkg-uninstall.lib.sh"
command_path="$root/bin/sys/pkg"
[ -f "$library" ] || fail "lib/sh/pkg-uninstall.lib.sh is missing"
[ ! -x "$library" ] || fail "pkg-uninstall library must not be executable"
[ -x "$command_path" ] || fail "bin/sys/pkg is missing or not executable"
[ "$(sed -n '1p' "$command_path")" = '#!/usr/bin/env rumiai-os' ] || fail "pkg command entry has wrong shebang"

PATH="$root/bin/sys:$PATH"
export PATH
"$command_path" uninstall >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "pkg uninstall without operands did not return 2"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-uninstall-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

m_LIB_DIR="$root/lib"
m_PKG_DIR="$tmp/pkg"
m_BIN_DIR="$tmp/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_HOME_DIR="$tmp/home"
m_OSARCH=linux-arm64
m_CACHE_DIR="$tmp/cache-must-not-be-required"
mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" "$m_HOME_DIR" || error "cannot create fixture roots"
export m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_HOME_DIR m_OSARCH m_CACHE_DIR

log()
{
  :
}

. "$library" || error "cannot source pkg-uninstall library"

reset_fixture()
{
  rm -rf "$m_PKG_DIR" "$m_BIN_DIR" "$m_HOME_DIR" "$m_CACHE_DIR" || return 1
  mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" "$m_HOME_DIR" || return 1
}

make_concrete()
{
  package=$1
  version=$2
  osarch=${3-}
  if [ -n "$osarch" ]
  then
    identity="$package@$version!$osarch"
  else
    identity="$package@$version"
  fi
  mkdir -p "$m_PKG_DIR/$identity/root" "$m_PKG_DIR/$identity/cmd" || return 1
  printf -- '#!/bin/sh\nexit 0\n' > "$m_PKG_DIR/$identity/cmd/$package" || return 1
  chmod 700 "$m_PKG_DIR/$identity/cmd/$package" || return 1
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

reset_fixture || error "cannot reset fixture"
make_concrete alpha 1 linux-arm64 || error "cannot create alpha"
pkg_uninstall alpha || fail "unversioned target uninstall failed"
[ ! -e "$m_PKG_DIR/alpha@1!linux-arm64" ] || fail "alpha target concrete survived"

reset_fixture || error "cannot reset fixture"
make_concrete beta 2.0 linux-arm64 || error "cannot create beta"
pkg_uninstall 'beta@2.0' || fail "versioned target uninstall failed"
[ ! -e "$m_PKG_DIR/beta@2.0!linux-arm64" ] || fail "beta target concrete survived"

reset_fixture || error "cannot reset fixture"
make_concrete gamma 3 linux-arm64 || error "cannot create gamma"
pkg_uninstall 'gamma!linux-arm64' || fail "explicit-target unversioned uninstall failed"
[ ! -e "$m_PKG_DIR/gamma@3!linux-arm64" ] || fail "gamma target concrete survived"

reset_fixture || error "cannot reset fixture"
make_concrete delta 4 linux-arm64 || error "cannot create delta"
pkg_uninstall 'delta@4!linux-arm64' || fail "explicit-target versioned uninstall failed"
[ ! -e "$m_PKG_DIR/delta@4!linux-arm64" ] || fail "delta target concrete survived"

reset_fixture || error "cannot reset fixture"
make_concrete generic 1 || error "cannot create generic"
expect_status 1 pkg_uninstall 'generic!linux-arm64'
[ -d "$m_PKG_DIR/generic@1" ] || fail "explicit target silently fell back to generic"

reset_fixture || error "cannot reset fixture"
make_concrete precedence 1 || error "cannot create generic precedence"
make_concrete precedence 1 linux-arm64 || error "cannot create target precedence"
pkg_uninstall 'precedence@1' || fail "target-precedence uninstall failed"
[ ! -e "$m_PKG_DIR/precedence@1!linux-arm64" ] || fail "target-precedence concrete survived"
[ -d "$m_PKG_DIR/precedence@1" ] || fail "generic concrete removed instead of current-target concrete"

reset_fixture || error "cannot reset fixture"
make_concrete nofallback 1 || error "cannot create generic nofallback"
make_concrete nofallback 2 linux-arm64 || error "cannot create target nofallback"
expect_status 1 pkg_uninstall 'nofallback@1'
[ -d "$m_PKG_DIR/nofallback@1" ] || fail "generic fallback used after target class selection"
[ -d "$m_PKG_DIR/nofallback@2!linux-arm64" ] || fail "unrelated target concrete changed"

reset_fixture || error "cannot reset fixture"
make_concrete malformed 1 || error "cannot create generic malformed"
printf -- 'not-a-selector\n' > "$m_PKG_DIR/malformed!linux-arm64" || error "cannot create malformed selector"
expect_status 1 pkg_uninstall 'malformed@1'
[ -d "$m_PKG_DIR/malformed@1" ] || fail "malformed target class silently fell back to generic"

reset_fixture || error "cannot reset fixture"
make_concrete current 1 linux-arm64 || error "cannot create current v1"
make_concrete current 2 linux-arm64 || error "cannot create current v2"
pkg_default current 2 linux-arm64 || error "cannot create target default"
[ -L "$m_PKG_DIR/current!linux-arm64" ] || error "target selector was not created"
[ -L "$m_BIN_DIR/ext-linux-arm64/current" ] || error "target public binding was not created"
pkg_uninstall current || fail "unversioned current uninstall failed"
[ -d "$m_PKG_DIR/current@1!linux-arm64" ] || fail "non-current version was removed"
[ ! -e "$m_PKG_DIR/current@2!linux-arm64" ] || fail "current concrete survived uninstall"
[ ! -e "$m_PKG_DIR/current!linux-arm64" ] && [ ! -L "$m_PKG_DIR/current!linux-arm64" ] || fail "current selector survived uninstall"
[ ! -e "$m_BIN_DIR/ext-linux-arm64/current" ] && [ ! -L "$m_BIN_DIR/ext-linux-arm64/current" ] || fail "public binding survived current uninstall"
[ ! -L "$m_PKG_DIR/current!linux-arm64" ] || fail "another version was selected implicitly"

reset_fixture || error "cannot reset fixture"
make_concrete single 1 linux-arm64 || error "cannot create single"
pkg_uninstall single || fail "single availability without current was not removable"
[ ! -e "$m_PKG_DIR/single@1!linux-arm64" ] || fail "single availability survived"

reset_fixture || error "cannot reset fixture"
make_concrete ambiguous 1 linux-arm64 || error "cannot create ambiguous v1"
make_concrete ambiguous 2 linux-arm64 || error "cannot create ambiguous v2"
expect_status 1 pkg_uninstall ambiguous
[ -d "$m_PKG_DIR/ambiguous@1!linux-arm64" ] || fail "ambiguous v1 changed"
[ -d "$m_PKG_DIR/ambiguous@2!linux-arm64" ] || fail "ambiguous v2 changed"

reset_fixture || error "cannot reset fixture"
make_concrete fallback 1 || error "cannot create fallback"
pkg_default fallback 1 || error "cannot create generic default"
pkg_uninstall fallback || fail "generic fallback uninstall failed"
[ ! -e "$m_PKG_DIR/fallback@1" ] || fail "generic concrete survived"
[ ! -e "$m_PKG_DIR/fallback" ] && [ ! -L "$m_PKG_DIR/fallback" ] || fail "generic selector survived"
[ ! -e "$m_BIN_EXT_DIR/fallback" ] && [ ! -L "$m_BIN_EXT_DIR/fallback" ] || fail "generic public binding survived"

reset_fixture || error "cannot reset fixture"
make_concrete stateful 1 linux-arm64 || error "cannot create stateful"
mkdir -p "$m_HOME_DIR/stateful" || error "cannot create package state"
printf -- 'keep\n' > "$m_HOME_DIR/stateful/data" || error "cannot create state file"
pkg_uninstall stateful || fail "stateful uninstall failed"
[ -f "$m_HOME_DIR/stateful/data" ] || fail "uninstall removed package state"

reset_fixture || error "cannot reset fixture"
make_concrete prevalidated 1 linux-arm64 || error "cannot create prevalidated"
expect_status 2 pkg_uninstall prevalidated 'bad@'
[ -d "$m_PKG_DIR/prevalidated@1!linux-arm64" ] || fail "mutation occurred before all operands were prevalidated"

reset_fixture || error "cannot reset fixture"
make_concrete first 1 linux-arm64 || error "cannot create first"
make_concrete last 1 linux-arm64 || error "cannot create last"
expect_status 1 pkg_uninstall first missing last
[ ! -e "$m_PKG_DIR/first@1!linux-arm64" ] || fail "successful first uninstall was rolled back"
[ -d "$m_PKG_DIR/last@1!linux-arm64" ] || fail "operand after first failure was executed"

reset_fixture || error "cannot reset fixture"
make_concrete exact 1 linux-arm64 || error "cannot create exact v1"
make_concrete exact 2 linux-arm64 || error "cannot create exact v2"
pkg_uninstall 'exact@1' || fail "exact version uninstall failed"
[ ! -e "$m_PKG_DIR/exact@1!linux-arm64" ] || fail "exact selected version survived"
[ -d "$m_PKG_DIR/exact@2!linux-arm64" ] || fail "unselected version was removed"

expect_status 2 pkg_uninstall 'Bad'
expect_status 2 pkg_uninstall 'bad@'
expect_status 2 pkg_uninstall 'bad!foo-bar'
expect_status 2 pkg_uninstall 'bad@1!linux-arm64!macos-arm64'

exit 0
