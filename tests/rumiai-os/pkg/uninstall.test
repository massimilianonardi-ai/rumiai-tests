#!/bin/sh

TEST_ID=rumiai-os/pkg/uninstall.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${cleanup_specs-}" ] && [ -n "${root-}" ]
  then
    for spec in $cleanup_specs
    do
      run_pkg uninstall "$spec" >/dev/null 2>&1 || :
    done
  fi

  if [ -n "${cleanup_names-}" ] && [ -n "${root-}" ]
  then
    for name in $cleanup_names
    do
      rm -rf "$root/pkg/$name@"* "$root/pkg/$name@"*'!'* 2>/dev/null || :
      rm -f "$root/pkg/$name" "$root/pkg/$name!"* 2>/dev/null || :
      rm -f "$root/bin/ext/$name" "$root/bin/ext-"*/"$name" 2>/dev/null || :
    done
  fi

  [ -z "${stateful_user_root-}" ] || rm -rf "$stateful_user_root" 2>/dev/null || :

  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_payload()
{
  payload=$1
  label=$2
  mkdir "$payload" || return 1
  printf '%s\n' "$label" > "$payload/payload"
}

integrate()
{
  name=$1
  version=$2
  osarch=${3-}
  range=$tmp/range-$name-$version
  payload=$tmp/payload-$name-$version
  mkdir "$range" || return 1
  make_payload "$payload" "$name@$version" || return 1

  if [ -n "$osarch" ]
  then
    "$root/m" "$driver" integrate "$name" "$version" "$range" "$payload" "$osarch"
  else
    "$root/m" "$driver" integrate "$name" "$version" "$range" "$payload"
  fi
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-uninstall-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

pkg_store_created=0
if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate)
    [ -f "$3/format" ] || printf '%s\n' tar.gz > "$3/format" || exit 3
    pkg_integrate "$@"
    ;;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

exact=putexact$$
current=putcurrent$$
ambiguous=putamb$$
stateful=putstate$$
prevalidated=putpre$$
cleanup_names="$exact $current $ambiguous $stateful $prevalidated"
cleanup_specs="$exact@1 $exact@2 $current@1 $current@2 $ambiguous@1 $ambiguous@2 $stateful@1 $prevalidated@1"

expect_status 2 no-operand run_pkg uninstall
expect_status 2 invalid-name run_pkg uninstall Bad

integrate "$exact" 1 > "$tmp/exact-1.out" 2> "$tmp/exact-1.err" ||
  fail 'cannot integrate exact version 1'
integrate "$exact" 2 > "$tmp/exact-2.out" 2> "$tmp/exact-2.err" ||
  fail 'cannot integrate exact version 2'

run_pkg uninstall "$exact@1" > "$tmp/remove-exact.out" 2> "$tmp/remove-exact.err" || {
  cat "$tmp/remove-exact.err" >&2
  fail 'exact-version uninstall failed'
}
versions=$(run_pkg versions "$exact" 2> "$tmp/exact-versions.err") ||
  fail 'remaining exact package version is not queryable'
[ "$versions" = "$exact@2" ] ||
  fail "exact-version uninstall changed the wrong versions: $versions"

integrate "$current" 1 > "$tmp/current-1.out" 2> "$tmp/current-1.err" ||
  fail 'cannot integrate current version 1'
integrate "$current" 2 > "$tmp/current-2.out" 2> "$tmp/current-2.err" ||
  fail 'cannot integrate current version 2'

run_pkg default "$current@2" > "$tmp/select-current.out" 2> "$tmp/select-current.err" || {
  cat "$tmp/select-current.err" >&2
  error 'cannot establish current version for uninstall scenario'
}

run_pkg uninstall "$current" > "$tmp/remove-current.out" 2> "$tmp/remove-current.err" || {
  cat "$tmp/remove-current.err" >&2
  fail 'unversioned current uninstall failed'
}
versions=$(run_pkg versions "$current" 2> "$tmp/current-versions.err") ||
  fail 'remaining package version is not queryable'
[ "$versions" = "$current@1" ] ||
  fail "unversioned uninstall did not remove only the current version: $versions"

if run_pkg default "$current" > "$tmp/current-default.out" 2> "$tmp/current-default.err"
then
  fail 'uninstall of current package left a selected default'
else
  [ "$?" -eq 1 ] || fail 'querying removed current default returned unexpected status'
fi

integrate "$ambiguous" 1 > "$tmp/amb-1.out" 2> "$tmp/amb-1.err" ||
  fail 'cannot integrate ambiguous version 1'
integrate "$ambiguous" 2 > "$tmp/amb-2.out" 2> "$tmp/amb-2.err" ||
  fail 'cannot integrate ambiguous version 2'
expect_status 1 ambiguous-unversioned run_pkg uninstall "$ambiguous"
versions=$(run_pkg versions "$ambiguous" 2> "$tmp/amb-versions.err") ||
  fail 'ambiguous versions disappeared after rejected uninstall'
expected="$ambiguous@1
$ambiguous@2"
[ "$versions" = "$expected" ] ||
  fail "ambiguous uninstall changed installed versions: $versions"

integrate "$stateful" 1 > "$tmp/stateful.out" 2> "$tmp/stateful.err" ||
  fail 'cannot integrate stateful package'
stateful_home=$("$root/m" "$root/bin/sys/state-path" user pkg "$stateful" home) ||
  error 'cannot resolve stateful package HOME'
stateful_user_root=${stateful_home%/home}
mkdir -p "$stateful_home" || error 'cannot create stateful package HOME'
printf '%s\n' keep > "$stateful_home/sentinel" ||
  error 'cannot create persistent package state'

run_pkg uninstall "$stateful@1" > "$tmp/remove-stateful.out" 2> "$tmp/remove-stateful.err" || {
  cat "$tmp/remove-stateful.err" >&2
  fail 'stateful package uninstall failed'
}
[ -f "$stateful_home/sentinel" ] &&
[ "$(cat "$stateful_home/sentinel")" = keep ] ||
  fail 'pkg uninstall removed persistent package user state'

integrate "$prevalidated" 1 > "$tmp/pre.out" 2> "$tmp/pre.err" ||
  fail 'cannot integrate prevalidation package'
expect_status 2 prevalidation run_pkg uninstall "$prevalidated@1" 'bad@'
versions=$(run_pkg versions "$prevalidated" 2> "$tmp/pre-versions.err") ||
  fail 'prevalidated package disappeared after invalid batch'
[ "$versions" = "$prevalidated@1" ] ||
  fail 'pkg uninstall mutated before validating all operands'

exit 0
