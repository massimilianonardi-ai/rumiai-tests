#!/bin/sh

TEST_ID="rumiai-os/pkg/catalog-snapshot.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed or required git is unavailable" ;;
esac

command -v git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"
library="$root/lib/sh/pkg-install.lib.sh"
[ -f "$library" ] || fail "lib/sh/pkg-install.lib.sh is missing"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-catalog-snapshot-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

m_LIB_DIR="$root/lib"
m_CACHE_DIR="$tmp/cache"
m_RUN_DIR="$tmp/run"
m_TMP_DIR="$tmp/tmp"
m_PKG_DIR="$tmp/pkg"
m_BIN_DIR="$tmp/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
mkdir -p "$m_CACHE_DIR" "$m_RUN_DIR" "$m_TMP_DIR" "$m_PKG_DIR" "$m_BIN_DIR" || error "cannot create fixture roots"
export m_LIB_DIR m_CACHE_DIR m_RUN_DIR m_TMP_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR

log()
{
  :
}

. "$library" || error "cannot source pkg-install library"

remote="$tmp/remote.git"
work="$tmp/work"
cache="$tmp/catalog-cache"
lock="$tmp/catalog.lock"

git init --bare "$remote" >/dev/null 2>&1 || error "cannot initialize bare catalog remote"
git init "$work" >/dev/null 2>&1 || error "cannot initialize catalog worktree"
git -C "$work" config user.name test || error "cannot configure git user"
git -C "$work" config user.email test@example.invalid || error "cannot configure git email"
git -C "$work" checkout -b main >/dev/null 2>&1 || error "cannot create main branch"
printf -- '%s\n' one > "$work/value" || error "cannot create first catalog revision"
git -C "$work" add value || error "cannot add first revision"
git -C "$work" commit -m one >/dev/null 2>&1 || error "cannot commit first revision"
git -C "$work" remote add origin "$remote" || error "cannot add fixture remote"
git -C "$work" push -u origin main >/dev/null 2>&1 || error "cannot push first revision"
git --git-dir="$remote" symbolic-ref HEAD refs/heads/main || error "cannot set bare HEAD"

snapshot1="$tmp/snapshot1"
mkdir "$snapshot1" || error "cannot create first snapshot dir"
head1="$(_pkg_install_catalog_snapshot_impl "$remote" main "$cache" "$lock" "$snapshot1")" || fail "initial clone/snapshot failed"
[ "$(cat "$snapshot1/value")" = one ] || fail "initial snapshot has wrong content"
[ ! -e "$snapshot1/.git" ] || fail "operational snapshot contains .git"
[ ! -e "$lock" ] || fail "catalog lock remained after initial snapshot"

printf -- '%s\n' two > "$work/value" || error "cannot create second catalog revision"
git -C "$work" add value || error "cannot add second revision"
git -C "$work" commit -m two >/dev/null 2>&1 || error "cannot commit second revision"
git -C "$work" push origin main >/dev/null 2>&1 || error "cannot push second revision"

snapshot2="$tmp/snapshot2"
mkdir "$snapshot2" || error "cannot create second snapshot dir"
head2="$(_pkg_install_catalog_snapshot_impl "$remote" main "$cache" "$lock" "$snapshot2")" || fail "fast-forward refresh failed"
[ "$head2" != "$head1" ] || fail "fast-forward refresh did not advance HEAD"
[ "$(cat "$snapshot2/value")" = two ] || fail "refreshed snapshot has wrong content"

mv "$remote" "$remote.offline" || error "cannot simulate offline remote"
snapshot3="$tmp/snapshot3"
mkdir "$snapshot3" || error "cannot create offline snapshot dir"
head3="$(_pkg_install_catalog_snapshot_impl "$remote" main "$cache" "$lock" "$snapshot3")" || fail "valid cached snapshot was not usable after fetch failure"
[ "$head3" = "$head2" ] || fail "offline fallback changed cached HEAD"
[ "$(cat "$snapshot3/value")" = two ] || fail "offline fallback used wrong cached tree"
mv "$remote.offline" "$remote" || error "cannot restore fixture remote"

mkdir -p "$lock" || error "cannot create active lock fixture"
printf -- '%s\n' "$$" > "$lock/pid" || error "cannot write active lock fixture"
snapshot4="$tmp/snapshot4"
mkdir "$snapshot4" || error "cannot create active-lock snapshot dir"
if _pkg_install_catalog_snapshot_impl "$remote" main "$cache" "$lock" "$snapshot4" >/dev/null 2>&1
then
  fail "active catalog lock was ignored"
fi
[ -f "$lock/pid" ] || fail "active lock was destructively altered"
rm -f "$lock/pid" && rmdir "$lock" || error "cannot remove active lock fixture"

sh -c 'exit 0' &
stale_pid=$!
wait "$stale_pid"
mkdir -p "$lock" || error "cannot create stale lock fixture"
printf -- '%s\n' "$stale_pid" > "$lock/pid" || error "cannot write stale lock fixture"
snapshot5="$tmp/snapshot5"
mkdir "$snapshot5" || error "cannot create stale-lock snapshot dir"
_pkg_install_catalog_snapshot_impl "$remote" main "$cache" "$lock" "$snapshot5" >/dev/null || fail "well-formed stale lock was not reclaimed"
[ ! -e "$lock" ] || fail "reclaimed lock remained after snapshot"

capture="$tmp/canonical-args"
_pkg_install_catalog_snapshot_impl()
{
  printf -- '%s\n' "$@" > "$capture"
  printf -- '%040d\n' 0
}
canonical_snapshot="$tmp/canonical-snapshot"
mkdir "$canonical_snapshot" || error "cannot create canonical wrapper snapshot dir"
_pkg_install_catalog_snapshot "$canonical_snapshot" >/dev/null || fail "canonical snapshot wrapper failed"
expected="$tmp/expected-args"
printf -- '%s\n' \
  'https://github.com/massimilianonardi-ai/pkg-catalog.git' \
  main \
  "$m_CACHE_DIR/sys/pkg/pkg-catalog" \
  "$m_RUN_DIR/sys/pkg/pkg-catalog.lock" \
  "$canonical_snapshot" > "$expected"
cmp "$capture" "$expected" >/dev/null 2>&1 || fail "canonical catalog snapshot arguments differ from contract"

exit 0
