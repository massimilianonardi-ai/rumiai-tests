#!/bin/sh

TEST_ID="rumiai-os/pkg/setuid.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v -- "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v -- "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

readpathce()
{
  [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || return 1
  case "$1" in "" | [0-9]* | *[!a-zA-Z0-9_]*) return 2 ;; esac
  resolved="$(command -p -- realpath -- "$2" 2>/dev/null)" || return 1
  [ -e "$resolved" ] || return 1
  eval "$1=\$resolved"
}

log()
{
  if [ -n "${notice_log-}" ]
  then
    printf -- '%s\n' "$*" >> "$notice_log" || return 1
  fi
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

expect_integration_failure()
{
  package=$1
  version=$2
  range=$3
  payload=$4
  osarch=${5-}

  if [ -n "$osarch" ]
  then
    expect_status 1 pkg_integrate "$package" "$version" "$range" "$payload" "$osarch"
    concrete="$m_PKG_DIR/$package@$version!$osarch"
  else
    expect_status 1 pkg_integrate "$package" "$version" "$range" "$payload"
    concrete="$m_PKG_DIR/$package@$version"
  fi

  [ -d "$payload" ] && [ ! -L "$payload" ] || fail "failed integration consumed useful root for $package"
  [ ! -e "$concrete" ] && [ ! -L "$concrete" ] || fail "failed integration published $concrete"
}

new_case()
{
  case_name=$1
  case_range="$tmp/$case_name-range"
  case_payload="$tmp/$case_name-payload"
  command -p -- rm -rf -- "$case_range" "$case_payload" || return 1
  command -p -- mkdir -- "$case_range" "$case_payload" || return 1
}

make_regular_target()
{
  payload=$1
  path=$2
  parent=${path%/*}
  if [ "$parent" != "$path" ]
  then
    command -p -- mkdir -p -- "$payload/$parent" || return 1
  fi
  printf -- '%s\n' sandbox > "$payload/$path" || return 1
  command -p -- chmod 700 "$payload/$path" || return 1
}

reset_fixture()
{
  command -p -- rm -rf -- "$m_ROOT" || return 1
  command -p -- mkdir -p -- \
    "$m_PKG_DIR" \
    "$m_BIN_DIR" \
    "$m_CONF_DIR" \
    "$m_DATA_DIR" \
    "$m_HOME_DIR" \
    "$m_CACHE_DIR" \
    "$m_LOG_DIR" \
    "$m_RUN_DIR" \
    "$m_TMP_DIR" || return 1
}

command -v -- git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"
command -v -- realpath >/dev/null 2>&1 || fail "realpath runtime dependency is unavailable"
command -v -- mkfifo >/dev/null 2>&1 || fail "mkfifo runtime dependency is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

integration_library="$root/lib/sh/pkg-integration.lib.sh"
setuid_library="$root/lib/sh/pkg-setuid.lib.sh"
message_en="$root/lang/en_US/security/package-setuid-root-authorization-required"
message_it="$root/lang/it_IT/security/package-setuid-root-authorization-required"
[ -f "$integration_library" ] || fail "lib/sh/pkg-integration.lib.sh is missing"
[ -f "$setuid_library" ] || fail "lib/sh/pkg-setuid.lib.sh is missing"
[ ! -x "$setuid_library" ] || fail "pkg-setuid library must not be executable"
case "$(command -p -- sed -n '1p' "$setuid_library")" in '#!'*) fail "pkg-setuid library must not have a shebang" ;; esac
[ -s "$message_en" ] || fail "English setuid authorization message is missing"
[ -s "$message_it" ] || fail "Italian setuid authorization message is missing"

command -p -- grep 'command -p -v sudo' "$setuid_library" >/dev/null 2>&1 || fail "sudo is not resolved through command -p"
command -p -- grep 'package-setuid-root-authorization-required' "$setuid_library" >/dev/null 2>&1 || fail "setuid authorization reason is not reported"
command -p -- grep '0:0' "$setuid_library" >/dev/null 2>&1 || fail "fixed root ownership is missing"
command -p -- grep '4755' "$setuid_library" >/dev/null 2>&1 || fail "fixed setuid mode is missing"
if command -p -- grep -E 'sudo[[:space:]]+(sh|bash|zsh)[[:space:]]+-c|pkexec|(^|[[:space:]])su([[:space:]]|$)' "$setuid_library" >/dev/null 2>&1
then
  fail "setuid path introduced a privileged shell or alternate escalation mechanism"
fi
if command -p -- grep -- '--no-sandbox' "$setuid_library" >/dev/null 2>&1
then
  fail "setuid materialization introduced --no-sandbox fallback"
fi
notice_line="$(command -p -- grep -n '_pkg_setuid_privilege_notice "\$pkg_setuid_target"' "$setuid_library" | command -p -- sed -n '1s/:.*//p')" || fail "privilege notice call is missing"
sudo_line="$(command -p -- grep -n '"\$pkg_setuid_sudo_bin" -- "\$pkg_setuid_chown_bin"' "$setuid_library" | command -p -- sed -n '1s/:.*//p')" || fail "sudo chown call is missing"
case "$notice_line:$sudo_line" in *[!0-9:]* | :* | *:) fail "cannot parse privilege notice order" ;; esac
[ "$notice_line" -lt "$sudo_line" ] || fail "privileged command can run before the user notice"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-setuid-$$"
umask 077
command -p -- mkdir -- "$tmp" || error "cannot create temporary directory"
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

m_ROOT="$tmp/root"
m_LIB_DIR="$root/lib"
m_PKG_DIR="$m_ROOT/pkg"
m_BIN_DIR="$m_ROOT/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_CONF_DIR="$m_ROOT/conf"
m_DATA_DIR="$m_ROOT/data"
m_HOME_DIR="$m_ROOT/home"
m_CACHE_DIR="$m_ROOT/cache"
m_LOG_DIR="$m_ROOT/log"
m_RUN_DIR="$m_ROOT/run"
m_TMP_DIR="$m_ROOT/tmp"
export m_ROOT m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR
export m_CONF_DIR m_DATA_DIR m_HOME_DIR m_CACHE_DIR m_LOG_DIR m_RUN_DIR m_TMP_DIR

reset_fixture || error "cannot initialize fixture"
. "$integration_library" || error "cannot source pkg-integration library"

# Absence of setuid_root preserves the existing integration path.
new_case plain || error "cannot create plain fixture"
printf -- '%s\n' payload > "$case_payload/payload" || error "cannot create plain payload"
pkg_integrate plain 1 "$case_range" "$case_payload" || fail "plain integration regressed"
[ -f "$m_PKG_DIR/plain@1/root/payload" ] || fail "plain package payload missing"
[ ! -e "$m_PKG_DIR/plain@1/setuid-root-rollback" ] || fail "plain package gained transient setuid metadata"
pkg_deintegrate plain 1 || fail "plain package deintegration failed"

# Generic and non-Linux definitions are rejected before mutation.
new_case generic || error "cannot create generic fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create generic metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create generic target"
expect_integration_failure generic 1 "$case_range" "$case_payload"

new_case macos || error "cannot create macOS fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create macOS metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create macOS target"
expect_integration_failure macos 1 "$case_range" "$case_payload" macos-arm64

# Metadata serialization and target confinement.
for invalid in executable empty no-lf absolute dotdot duplicate
do
  new_case "metadata-$invalid" || error "cannot create $invalid fixture"
  case "$invalid" in
    executable)
      printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot write executable metadata"
      command -p -- chmod 700 "$case_range/setuid_root" || error "cannot chmod metadata"
      ;;
    empty)
      : > "$case_range/setuid_root" || error "cannot write empty metadata"
      ;;
    no-lf)
      printf -- '%s' chrome-sandbox > "$case_range/setuid_root" || error "cannot write no-lf metadata"
      ;;
    absolute)
      printf -- '%s\n' /chrome-sandbox > "$case_range/setuid_root" || error "cannot write absolute metadata"
      ;;
    dotdot)
      printf -- '%s\n' dir/../chrome-sandbox > "$case_range/setuid_root" || error "cannot write dotdot metadata"
      ;;
    duplicate)
      printf -- '%s\n' chrome-sandbox chrome-sandbox > "$case_range/setuid_root" || error "cannot write duplicate metadata"
      ;;
  esac
  make_regular_target "$case_payload" chrome-sandbox || error "cannot create invalid metadata target"
  expect_integration_failure "metadata-$invalid" 1 "$case_range" "$case_payload" linux-arm64
done

new_case metadata-symlink || error "cannot create metadata symlink fixture"
printf -- '%s\n' chrome-sandbox > "$tmp/setuid-metadata-target" || error "cannot create metadata target"
command -p -- ln -s "$tmp/setuid-metadata-target" "$case_range/setuid_root" || error "cannot create metadata symlink"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create metadata symlink target"
expect_integration_failure metadata-symlink 1 "$case_range" "$case_payload" linux-arm64

new_case target-symlink || error "cannot create target symlink fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create target symlink metadata"
printf -- '%s\n' sandbox > "$case_payload/real-sandbox" || error "cannot create real sandbox"
command -p -- ln -s real-sandbox "$case_payload/chrome-sandbox" || error "cannot create target symlink"
expect_integration_failure target-symlink 1 "$case_range" "$case_payload" linux-arm64

new_case target-directory || error "cannot create target directory fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create target directory metadata"
command -p -- mkdir -- "$case_payload/chrome-sandbox" || error "cannot create target directory"
expect_integration_failure target-directory 1 "$case_range" "$case_payload" linux-arm64

new_case target-fifo || error "cannot create target fifo fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create target fifo metadata"
command -p -- mkfifo -- "$case_payload/chrome-sandbox" || error "cannot create target fifo"
expect_integration_failure target-fifo 1 "$case_range" "$case_payload" linux-arm64

new_case ancestor-symlink || error "cannot create ancestor symlink fixture"
printf -- '%s\n' alias/chrome-sandbox > "$case_range/setuid_root" || error "cannot create ancestor metadata"
command -p -- mkdir -- "$case_payload/real" || error "cannot create real directory"
make_regular_target "$case_payload/real" chrome-sandbox || error "cannot create ancestor target"
command -p -- ln -s real "$case_payload/alias" || error "cannot create ancestor symlink"
expect_integration_failure ancestor-symlink 1 "$case_range" "$case_payload" linux-arm64

new_case state-overlap || error "cannot create state overlap fixture"
command -p -- mkdir -- "$case_range/var" || error "cannot create var fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/var/conf" || error "cannot create state mapping"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create overlap metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create overlap target"
expect_integration_failure state-overlap 1 "$case_range" "$case_payload" linux-arm64

# Privilege helper: deterministic non-root path uses only fixed sudo commands.
helper_bin="$tmp/helper-bin"
command -p -- mkdir -- "$helper_bin" || error "cannot create helper bin"
sudo_log="$tmp/sudo.log"
notice_log="$tmp/notice.log"
export sudo_log notice_log
cat > "$helper_bin/chown" <<'EOF_CHOWN'
#!/bin/sh
printf -- 'chown\t%s\t%s\n' "$1" "$2" >> "$sudo_log"
exit 0
EOF_CHOWN
cat > "$helper_bin/chmod" <<'EOF_CHMOD'
#!/bin/sh
printf -- 'chmod\t%s\t%s\n' "$1" "$2" >> "$sudo_log"
command -p -- chmod "$1" "$2"
EOF_CHMOD
cat > "$helper_bin/sudo" <<'EOF_SUDO'
#!/bin/sh
[ "$1" = -- ] || exit 90
shift
printf -- 'sudo\t%s\t%s\t%s\n' "$1" "$2" "$3" >> "$sudo_log"
"$@"
EOF_SUDO
command -p -- chmod 700 "$helper_bin/chown" "$helper_bin/chmod" "$helper_bin/sudo" || error "cannot chmod helper executables"

original_effective_uid_set='nonroot'
_pkg_setuid_effective_uid_set()
{
  pkg_setuid_effective_uid=1000
}
_pkg_setuid_command_paths_set()
{
  [ "$#" -eq 1 ] || return 2
  pkg_setuid_chown_bin="$helper_bin/chown"
  pkg_setuid_chmod_bin="$helper_bin/chmod"
  pkg_setuid_sudo_bin=
  if [ "$1" -eq 1 ]
  then
    pkg_setuid_sudo_bin="$helper_bin/sudo"
  fi
}

helper_target="$tmp/helper target's file"
printf -- '%s\n' helper > "$helper_target" || error "cannot create helper target"
: > "$sudo_log" || error "cannot reset sudo log"
: > "$notice_log" || error "cannot reset notice log"
_pkg_setuid_apply_file "$helper_target" 2> "$tmp/helper.stderr" || fail "simulated non-root setuid helper failed"
[ -u "$helper_target" ] || fail "simulated sudo chmod did not set setuid bit"
[ "$(command -p -- wc -l < "$sudo_log" | command -p -- tr -d ' ')" -eq 4 ] || fail "unexpected privileged helper call count"
command -p -- sed -n '1p' "$sudo_log" | command -p -- grep '^sudo.*/chown' >/dev/null 2>&1 || fail "first privileged command is not chown"
command -p -- sed -n '3p' "$sudo_log" | command -p -- grep '^sudo.*/chmod' >/dev/null 2>&1 || fail "second privileged command is not chmod"
command -p -- grep 'package-setuid-root-authorization-required' "$notice_log" >/dev/null 2>&1 || fail "authorization reason was not logged"
command -p -- grep "$helper_bin/sudo -- $helper_bin/chown 0:0" "$tmp/helper.stderr" >/dev/null 2>&1 || fail "displayed sudo chown command is missing"
command -p -- grep "$helper_bin/sudo -- $helper_bin/chmod 4755" "$tmp/helper.stderr" >/dev/null 2>&1 || fail "displayed sudo chmod command is missing"
command -p -- grep "'helper target'" "$tmp/helper.stderr" >/dev/null 2>&1 && fail "display unexpectedly lost the full target path"
command -p -- grep "'\\''" "$tmp/helper.stderr" >/dev/null 2>&1 || fail "single quote in displayed target is not shell-escaped"

# Root path bypasses sudo entirely.
_pkg_setuid_effective_uid_set()
{
  pkg_setuid_effective_uid=0
}
: > "$sudo_log" || error "cannot reset root helper log"
printf -- '%s\n' helper > "$helper_target" || error "cannot reset helper target"
_pkg_setuid_apply_file "$helper_target" >/dev/null 2>&1 || fail "simulated root setuid helper failed"
if command -p -- grep '^sudo' "$sudo_log" >/dev/null 2>&1
then
  fail "root path invoked sudo"
fi
command -p -- grep '^chown' "$sudo_log" >/dev/null 2>&1 || fail "root path did not execute chown directly"
command -p -- grep '^chmod' "$sudo_log" >/dev/null 2>&1 || fail "root path did not execute chmod directly"

# Lifecycle tests use the real integration path with only the privileged primitive simulated.
_pkg_setuid_apply_file()
{
  [ "$#" -eq 1 ] || return 2
  [ "${apply_mode-success}" = success ] || return 1
  command -p -- chmod 4755 "$1"
}

provider_mode=success
provider_seen="$tmp/provider-seen"
_pkg_facility_provider_add()
{
  [ "$#" -eq 2 ] || return 2
  case "$provider_mode" in
    success) return 0 ;;
    inspect)
      [ -u "$1/root/chrome-sandbox" ] || return 1
      [ -d "$1/setuid-root-rollback" ] && [ ! -L "$1/setuid-root-rollback" ] || return 1
      : > "$provider_seen" || return 1
      return 0
      ;;
    fail) return 1 ;;
    *) return 2 ;;
  esac
}

reset_fixture || error "cannot reset Electron fixture"
new_case electron || error "cannot create Electron fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create Electron metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create Electron sandbox"
printf -- '%s\n' electron > "$case_payload/electron" || error "cannot create Electron executable"
command -p -- chmod 700 "$case_payload/electron" || error "cannot chmod Electron executable"
provider_mode=inspect
command -p -- rm -f -- "$provider_seen" || error "cannot reset provider marker"
pkg_integrate electron v44.3.0 "$case_range" "$case_payload" linux-arm64 || fail "Electron-like ARM64 integration failed"
concrete="$m_PKG_DIR/electron@v44.3.0!linux-arm64"
[ -u "$concrete/root/chrome-sandbox" ] || fail "Electron sandbox lacks setuid bit"
[ -f "$provider_seen" ] || fail "provider publication did not observe setuid materialization"
[ ! -e "$concrete/setuid-root-rollback" ] && [ ! -L "$concrete/setuid-root-rollback" ] || fail "setuid transient data survived success"

reset_fixture || error "cannot reset x86 fixture"
new_case electron-x86 || error "cannot create x86 fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create x86 metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create x86 target"
provider_mode=success
pkg_integrate electron v44.3.0 "$case_range" "$case_payload" linux-x86_64 || fail "Electron-like x86_64 integration failed"
[ -u "$m_PKG_DIR/electron@v44.3.0!linux-x86_64/root/chrome-sandbox" ] || fail "x86_64 sandbox lacks setuid bit"

reset_fixture || error "cannot reset opaque fixture"
new_case opaque || error "cannot create opaque fixture"
printf -- '%s\n' 'space dir/-sandbox' > "$case_range/setuid_root" || error "cannot create opaque metadata"
make_regular_target "$case_payload" 'space dir/-sandbox' || error "cannot create opaque target"
provider_mode=success
pkg_integrate opaque 1 "$case_range" "$case_payload" linux-arm64 || fail "opaque pathname integration failed"
[ -u "$m_PKG_DIR/opaque@1!linux-arm64/root/space dir/-sandbox" ] || fail "opaque pathname was not preserved"

# Failure in privileged materialization restores the useful root.
reset_fixture || error "cannot reset apply failure fixture"
new_case apply-failure || error "cannot create apply failure fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create apply failure metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create apply failure target"
apply_mode=fail
provider_mode=success
expect_integration_failure apply-failure 1 "$case_range" "$case_payload" linux-arm64
[ -f "$case_payload/chrome-sandbox" ] && [ ! -u "$case_payload/chrome-sandbox" ] || fail "apply failure did not restore original target"
[ "$(command -p -- cat -- "$case_payload/chrome-sandbox")" = sandbox ] || fail "apply failure changed original bytes"
apply_mode=success

# Provider failure occurs while backups are still intact and rolls back.
reset_fixture || error "cannot reset provider failure fixture"
new_case provider-failure || error "cannot create provider failure fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create provider failure metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create provider failure target"
provider_mode=fail
expect_integration_failure provider-failure 1 "$case_range" "$case_payload" linux-arm64
[ -f "$case_payload/chrome-sandbox" ] && [ ! -u "$case_payload/chrome-sandbox" ] || fail "provider failure did not restore original target"
[ "$(command -p -- cat -- "$case_payload/chrome-sandbox")" = sandbox ] || fail "provider failure changed original bytes"

# Cleanup failure after provider publication is post-commit and must not trigger partial rollback.
reset_fixture || error "cannot reset cleanup failure fixture"
new_case cleanup-failure || error "cannot create cleanup failure fixture"
printf -- '%s\n' chrome-sandbox > "$case_range/setuid_root" || error "cannot create cleanup failure metadata"
make_regular_target "$case_payload" chrome-sandbox || error "cannot create cleanup failure target"
provider_mode=success
_pkg_setuid_cleanup()
{
  return 1
}
pkg_integrate cleanup-failure 1 "$case_range" "$case_payload" linux-arm64 || fail "post-commit cleanup failure incorrectly failed integration"
cleanup_concrete="$m_PKG_DIR/cleanup-failure@1!linux-arm64"
[ -u "$cleanup_concrete/root/chrome-sandbox" ] || fail "cleanup failure rolled back committed sandbox"
[ -d "$cleanup_concrete/setuid-root-rollback" ] || fail "cleanup failure fixture did not preserve transient evidence"

exit 0
