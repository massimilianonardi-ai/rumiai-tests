#!/bin/sh

TEST_ID=rumiai-os/pkg/facility.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
origin_ok() { origin=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;; esac; return 1; }
validate_root() { [ -f "$1/m" ] && [ -f "$1/rumiai-os" ] && [ -f "$1/rumiai-os-sh" ] && origin_ok "$1"; }
find_root() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then validate_root "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; (CDPATH= cd -- "$RUMIAI_TEST_RUMIAI_OS_ROOT" && pwd -P); return; fi; candidate=$(CDPATH= cd -- "$start" && pwd -P) || return 3; while :; do if validate_root "$candidate"; then printf '%s\n' "$candidate"; return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) :;; *) self=$(command -v "$self") || return 1;; esac; dir=${self%/*}; [ "$dir" != "$self" ] || dir=.; CDPATH= cd -- "$dir" && pwd -P; }
readpathce() { [ "$#" -eq 2 ] || return 2; case "$2" in */*) dir=${2%/*}; base=${2##*/}; [ -n "$dir" ] || dir=/;; *) dir=.; base=$2;; esac; physical_dir=$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P) || return 1; eval "$1=\$physical_dir/\$base"; }
log() { :; }
expect_status() { expected=$1; shift; "$@" >/dev/null 2>&1; actual=$?; [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"; }
make_root() { [ "$#" -eq 1 ] || return 2; mkdir "$1" || return 1; printf '%s\n' payload > "$1/payload"; }
make_range() { [ "$#" -eq 2 ] || return 2; mkdir "$1" || return 1; printf '%b' "$2" > "$1/facility"; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(find_root "$start"); status=$?; case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac
facility_library=$root/lib/sys/sh/pkg-facility.lib.sh
integration_library=$root/lib/sys/sh/pkg-integration.lib.sh
[ -f "$facility_library" ] && [ ! -x "$facility_library" ] || fail 'pkg-facility library is missing or executable'
[ -f "$integration_library" ] && [ ! -x "$integration_library" ] || fail 'pkg-integration library is missing or executable'
case "$(sed -n '1p' "$facility_library")" in '#!'*) fail 'pkg-facility library has a shebang';; esac

tmp=${TMPDIR:-/tmp}/rumiai-pkg-facility-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
m_ROOT=$tmp/root; m_LIB_DIR=$root/lib; m_PKG_DIR=$m_ROOT/pkg; m_BIN_DIR=$m_ROOT/bin; m_BIN_EXT_DIR=$m_BIN_DIR/ext; m_STATE_DIR=$m_ROOT/state; m_STATE_SYS_DIR=$m_STATE_DIR/system/profile/main; m_STATE_USER_DIR=$m_STATE_DIR/user/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-501; m_OSARCH=linux-arm64
mkdir -p "$m_PKG_DIR" "$m_BIN_DIR" "$m_STATE_SYS_DIR" "$m_STATE_USER_DIR" || error 'cannot create fixture roots'
export m_ROOT m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_STATE_DIR m_STATE_SYS_DIR m_STATE_USER_DIR m_OSARCH
fake_bin=$tmp/fake-bin; mkdir "$fake_bin" || error 'cannot create fake bin'; { printf '%s\n' '#!/bin/sh'; sed '1d' "$root/bin/sys/state-path"; } > "$fake_bin/state-path" || error 'cannot prepare state-path fixture'; chmod 700 "$fake_bin/state-path"; PATH=$fake_bin:$PATH; export PATH
provider_data=$m_STATE_SYS_DIR/sys/pkg/data; provider_root=$provider_data/providers
. "$integration_library" || error 'cannot source pkg-integration library'

range=$tmp/range-generic; root_input=$tmp/root-generic
make_range "$range" 'example-api 3\njava 21\npython 3.11\n' || error 'cannot create generic facility range'; make_root "$root_input" || error 'cannot create generic root'
pkg_integrate alpha 1 "$range" "$root_input" || fail 'generic provider integration failed'
source_serialized=$(cat "$range/facility"; printf x) || error 'cannot read source facility'; materialized_serialized=$(cat "$m_PKG_DIR/alpha@1/facility"; printf x) || error 'cannot read materialized facility'; [ "$source_serialized" = "$materialized_serialized" ] || fail 'materialized facility differs from catalog serialization'
for marker in "$provider_root/example-api/3/alpha@1" "$provider_root/java/21/alpha@1" "$provider_root/python/3.11/alpha@1"; do [ -f "$marker" ] && [ ! -L "$marker" ] && [ ! -s "$marker" ] || fail "provider marker is invalid: $marker"; done

range=$tmp/range-target; root_input=$tmp/root-target
make_range "$range" 'java 21\n' || error 'cannot create target range'; make_root "$root_input" || error 'cannot create target root'; pkg_integrate beta 2 "$range" "$root_input" linux-arm64 || fail 'target provider integration failed'
marker=$provider_root/java/21/beta@2!linux-arm64; [ -f "$marker" ] && [ ! -s "$marker" ] || fail 'target provider marker is invalid'
pkg_deintegrate alpha 1 || fail 'generic provider deintegration failed'
[ -d "$provider_root/java/21" ] || fail 'compatibility directory removed while provider remained'; [ -f "$provider_root/java/21/beta@2!linux-arm64" ] || fail 'remaining provider marker removed'; [ ! -e "$provider_root/example-api/3" ] || fail 'empty compatibility directory survived'
pkg_deintegrate beta 2 linux-arm64 || fail 'target provider deintegration failed'; [ ! -e "$provider_root/java/21" ] || fail 'last compatibility directory survived'

bad_index=0
check_bad_facility() { bad_index=$((bad_index + 1)); bad_range=$tmp/range-bad-$bad_index; bad_root=$tmp/root-bad-$bad_index; mkdir "$bad_range" || error 'cannot create malformed range'; printf '%b' "$1" > "$bad_range/facility" || error 'cannot write malformed facility'; make_root "$bad_root" || error 'cannot create malformed root'; expect_status 1 pkg_integrate bad "$bad_index" "$bad_range" "$bad_root"; [ ! -e "$m_PKG_DIR/bad@$bad_index" ] || fail 'malformed facility published a package'; }
check_bad_facility 'Java 21\n'; check_bad_facility 'java 21.0\n'; check_bad_facility 'java 021\n'; check_bad_facility 'python 3\njava 21\n'; check_bad_facility 'java 17\njava 21\n'; check_bad_facility 'java  21\n'; check_bad_facility 'java 21'; check_bad_facility ''

range=$tmp/range-corrupt; root_input=$tmp/root-corrupt; make_range "$range" 'java 21\n' || error 'cannot create corruption range'; make_root "$root_input" || error 'cannot create corruption root'; pkg_integrate corrupt 1 "$range" "$root_input" || fail 'corruption fixture integration failed'; marker=$provider_root/java/21/corrupt@1; printf '%s\n' corrupt > "$marker"; expect_status 1 pkg_deintegrate corrupt 1; [ -d "$m_PKG_DIR/corrupt@1" ] || fail 'deintegration removed package despite corrupt marker'; : > "$marker"; pkg_deintegrate corrupt 1 || fail 'deintegration failed after restoring marker'

range=$tmp/range-plain; root_input=$tmp/root-plain; mkdir "$range" || error 'cannot create plain range'; make_root "$root_input" || error 'cannot create plain root'; mv "$fake_bin/state-path" "$fake_bin/state-path.off" || error 'cannot disable resolver'; pkg_integrate plain 1 "$range" "$root_input" || fail 'package without facility acquired state-path provider-index dependency'; pkg_deintegrate plain 1 || fail 'plain package deintegration acquired provider-index dependency'
exit 0
