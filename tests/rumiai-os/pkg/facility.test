#!/bin/sh

TEST_ID="rumiai-os/pkg/facility.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

rumiai_test_target_have()
{
  command -v -- "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in */*) : ;; *) self="$(command -v -- "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v -- git >/dev/null 2>&1 || fail "git runtime dependency is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) printf -- '%s\n' "$TEST_ID: rumiai-os target checkout not found" >&2; exit 2 ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

facility_library="$root/lib/sh/pkg-facility.lib.sh"
integration_library="$root/lib/sh/pkg-integration.lib.sh"
[ -f "$facility_library" ] || fail "lib/sh/pkg-facility.lib.sh is missing"
[ ! -x "$facility_library" ] || fail "pkg-facility library must not be executable"
[ -f "$integration_library" ] || fail "lib/sh/pkg-integration.lib.sh is missing"
[ ! -x "$integration_library" ] || fail "pkg-integration library must not be executable"
facility_first_line=
IFS= read -r facility_first_line < "$facility_library" || :
case "$facility_first_line" in '#!'*) fail "pkg-facility library must not have a shebang" ;; esac

tmp="${TMPDIR:-/tmp}/rumiai-pkg-facility-$$"
umask 077
command -p -- mkdir -- "$tmp" || error "cannot create temporary directory"
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

m_LIB_DIR="$root/lib"
m_PKG_DIR="$tmp/pkg"
m_BIN_DIR="$tmp/bin"
m_BIN_EXT_DIR="$m_BIN_DIR/ext"
m_DATA_DIR="$tmp/data"
command -p -- mkdir -p -- "$m_PKG_DIR" "$m_BIN_DIR" "$m_DATA_DIR" || error "cannot create fixture roots"
export m_LIB_DIR m_PKG_DIR m_BIN_DIR m_BIN_EXT_DIR m_DATA_DIR

log()
{
  :
}

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  case "$2" in
    */*) dir=${2%/*}; base=${2##*/}; [ -n "$dir" ] || dir=/ ;;
    *) dir=.; base=$2 ;;
  esac
  physical_dir="$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P)" || return 1
  eval "$1=\$physical_dir/\$base"
}

. "$integration_library" || error "cannot source pkg-integration library"

make_root()
{
  [ "$#" -eq 1 ] || return 2
  command -p -- mkdir -- "$1" || return 1
  printf -- '%s\n' payload > "$1/payload" || return 1
}

make_range()
{
  [ "$#" -eq 2 ] || return 2
  command -p -- mkdir -- "$1" || return 1
  printf -- '%b' "$2" > "$1/facility" || return 1
}

expect_status()
{
  expected=$1
  shift
  "$@" >/dev/null 2>&1
  actual=$?
  [ "$actual" -eq "$expected" ] || fail "expected status $expected, got $actual from $*"
}

range="$tmp/range-generic"
root_input="$tmp/root-generic"
make_range "$range" 'example-api 3\njava 21\npython 3.11\n' || error "cannot create generic facility range"
make_root "$root_input" || error "cannot create generic root"
pkg_integrate alpha 1 "$range" "$root_input" || fail "generic provider integration failed"
source_serialized="$(command -p -- cat -- "$range/facility"; printf -- '%s' x)" || error "cannot read source facility"
materialized_serialized="$(command -p -- cat -- "$m_PKG_DIR/alpha@1/facility"; printf -- '%s' x)" || error "cannot read materialized facility"
[ "$source_serialized" = "$materialized_serialized" ] || fail "materialized facility differs from catalog serialization"

for marker in \
  "$m_DATA_DIR/sys/pkg/providers/example-api/3/alpha@1" \
  "$m_DATA_DIR/sys/pkg/providers/java/21/alpha@1" \
  "$m_DATA_DIR/sys/pkg/providers/python/3.11/alpha@1"
do
  [ -f "$marker" ] && [ ! -L "$marker" ] && [ ! -s "$marker" ] || fail "generic provider marker is not an empty regular file: $marker"
done

range="$tmp/range-target"
root_input="$tmp/root-target"
make_range "$range" 'java 21\n' || error "cannot create target facility range"
make_root "$root_input" || error "cannot create target root"
pkg_integrate beta 2 "$range" "$root_input" linux-arm64 || fail "target-specific provider integration failed"
marker="$m_DATA_DIR/sys/pkg/providers/java/21/beta@2!linux-arm64"
[ -f "$marker" ] && [ ! -L "$marker" ] && [ ! -s "$marker" ] || fail "target-specific provider marker is invalid"

pkg_deintegrate alpha 1 || fail "generic provider deintegration failed"
[ -d "$m_DATA_DIR/sys/pkg/providers/java/21" ] || fail "compatibility directory was removed while another provider remained"
[ -f "$m_DATA_DIR/sys/pkg/providers/java/21/beta@2!linux-arm64" ] || fail "remaining provider marker was removed"
[ ! -e "$m_DATA_DIR/sys/pkg/providers/example-api/3" ] && [ ! -L "$m_DATA_DIR/sys/pkg/providers/example-api/3" ] || fail "empty compatibility directory survived last provider removal"

pkg_deintegrate beta 2 linux-arm64 || fail "target-specific provider deintegration failed"
[ ! -e "$m_DATA_DIR/sys/pkg/providers/java/21" ] && [ ! -L "$m_DATA_DIR/sys/pkg/providers/java/21" ] || fail "last java compatibility directory survived"

bad_index=0
check_bad_facility()
{
  [ "$#" -eq 1 ] || return 2
  bad_index=$((bad_index + 1))
  bad_range="$tmp/range-bad-$bad_index"
  bad_root="$tmp/root-bad-$bad_index"
  command -p -- mkdir -- "$bad_range" || error "cannot create malformed range"
  printf -- '%b' "$1" > "$bad_range/facility" || error "cannot write malformed facility"
  make_root "$bad_root" || error "cannot create malformed root"
  expect_status 1 pkg_integrate bad "$bad_index" "$bad_range" "$bad_root"
  [ ! -e "$m_PKG_DIR/bad@$bad_index" ] && [ ! -L "$m_PKG_DIR/bad@$bad_index" ] || fail "malformed facility materialized a package"
}

check_bad_facility 'Java 21\n'
check_bad_facility 'java 21.0\n'
check_bad_facility 'java 021\n'
check_bad_facility 'python 3\njava 21\n'
check_bad_facility 'java 17\njava 21\n'
check_bad_facility 'java  21\n'
check_bad_facility 'java 21'
check_bad_facility ''

bad_index=$((bad_index + 1))
bad_range="$tmp/range-bad-$bad_index"
bad_root="$tmp/root-bad-$bad_index"
command -p -- mkdir -- "$bad_range" || error "cannot create executable-facility range"
printf -- '%s\n' 'java 21' > "$bad_range/facility" || error "cannot write executable facility"
command -p -- chmod +x -- "$bad_range/facility" || error "cannot mark facility executable"
make_root "$bad_root" || error "cannot create executable-facility root"
expect_status 1 pkg_integrate bad "$bad_index" "$bad_range" "$bad_root"

range="$tmp/range-dependency"
root_input="$tmp/root-dependency"
command -p -- mkdir -- "$range" || error "cannot create dependency range"
printf -- '%s\n' 'java >=17 <22' > "$range/dependency" || error "cannot write dependency fixture"
make_root "$root_input" || error "cannot create dependency root"
expect_status 2 pkg_integrate consumer 1 "$range" "$root_input"
[ ! -e "$m_PKG_DIR/consumer@1" ] && [ ! -L "$m_PKG_DIR/consumer@1" ] || fail "K1 accepted or materialized dependency"

range="$tmp/range-corrupt"
root_input="$tmp/root-corrupt"
make_range "$range" 'java 21\n' || error "cannot create corruption range"
make_root "$root_input" || error "cannot create corruption root"
pkg_integrate corrupt 1 "$range" "$root_input" || fail "corruption fixture integration failed"
marker="$m_DATA_DIR/sys/pkg/providers/java/21/corrupt@1"
printf -- '%s\n' corrupt > "$marker" || error "cannot corrupt provider marker"
expect_status 1 pkg_deintegrate corrupt 1
[ -d "$m_PKG_DIR/corrupt@1" ] || fail "deintegration removed package despite corrupt provider marker"
printf -- '' > "$marker" || error "cannot restore provider marker"
pkg_deintegrate corrupt 1 || fail "deintegration failed after restoring provider marker"

range="$tmp/range-plain"
root_input="$tmp/root-plain"
command -p -- mkdir -- "$range" || error "cannot create plain range"
make_root "$root_input" || error "cannot create plain root"
unset m_DATA_DIR
pkg_integrate plain 1 "$range" "$root_input" || fail "package without facility acquired a provider-index dependency"
pkg_deintegrate plain 1 || fail "package without facility failed deintegration without provider-index environment"

exit 0
