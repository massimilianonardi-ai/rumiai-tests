#!/bin/sh

TEST_ID=rumiai-os/pkg/default.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_selected()
{
  (
    PATH="$root/bin/ext:$root/bin/sys:$PATH"
    export PATH
    "$package"
  )
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${root-}" ] && [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :

    for cleanup_version in 1 2
    do
      if [ -d "$root/pkg/$package@$cleanup_version" ] && [ ! -L "$root/pkg/$package@$cleanup_version" ]
      then
        if [ -n "${driver-}" ] && [ -f "$driver" ]
        then
          "$root/m" "$driver" deintegrate "$package" "$cleanup_version" >/dev/null 2>&1 || :
        fi
        rm -rf "$root/pkg/$package@$cleanup_version" 2>/dev/null || :
      fi
    done

    rm -f "$root/pkg/$package" "$root/bin/ext/$package" 2>/dev/null || :

    if [ "${bin_ext_created-0}" -eq 1 ]
    then
      rmdir "$root/bin/ext" 2>/dev/null || :
    fi
    if [ "${pkg_store_created-0}" -eq 1 ]
    then
      rmdir "$root/pkg" 2>/dev/null || :
    fi
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_definition()
{
  version=$1
  range=$tmp/range-$version
  payload=$tmp/payload-$version

  mkdir -p "$range/cmd" "$range/link" "$payload/bin" || return 1

  cat > "$range/cmd/$package" <<EOF_COMMAND
#!/usr/bin/env m
printf '%s\\n' '$version'
EOF_COMMAND
  chmod 600 "$range/cmd/$package" || return 1
  printf '%s\n' bin/upstream > "$range/link/$package" || return 1

  cat > "$payload/bin/upstream" <<'EOF_UPSTREAM'
#!/bin/sh
exit 0
EOF_UPSTREAM
  chmod 700 "$payload/bin/upstream" || return 1
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-default-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=pdtest$$
pkg_store_created=0
bin_ext_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

for version in 1 2
do
  [ ! -e "$root/pkg/$package@$version" ] && [ ! -L "$root/pkg/$package@$version" ] ||
    error "temporary package identity already exists: $package@$version"
done
[ ! -e "$root/pkg/$package" ] && [ ! -L "$root/pkg/$package" ] ||
  error "temporary package selector already exists: $package"

driver=$tmp/pkg-integration-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/osarch.lib.sh" || exit 3
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3

action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 600 "$driver" || error 'cannot prepare integration driver'

for version in 1 2
do
  make_definition "$version" || error "cannot prepare package version $version"
  "$root/m" "$driver" integrate "$package" "$version" "$tmp/range-$version" "$tmp/payload-$version"     > "$tmp/integrate-$version.out" 2> "$tmp/integrate-$version.err" || {
      cat "$tmp/integrate-$version.err" >&2
      fail "cannot integrate package version $version"
    }
done

run_pkg default > "$tmp/no-operand.out" 2> "$tmp/no-operand.err"
[ "$?" -eq 2 ] || fail 'pkg default without operand did not return 2'

run_pkg default "$package@1" > "$tmp/select-1.out" 2> "$tmp/select-1.err" || {
  cat "$tmp/select-1.err" >&2
  fail 'pkg default could not select version 1'
}

selected=$(run_selected 2> "$tmp/run-1.err") || {
  cat "$tmp/run-1.err" >&2
  fail 'selected package command version 1 was not executable'
}
[ "$selected" = 1 ] || fail "selected package command returned '$selected' instead of version 1"

current=$(run_pkg default "$package" 2> "$tmp/query-1.err") || {
  cat "$tmp/query-1.err" >&2
  fail 'pkg default query failed after selecting version 1'
}
[ "$current" = "$package@1" ] || fail "pkg default query returned '$current' instead of '$package@1'"

run_pkg default "$package@2" > "$tmp/select-2.out" 2> "$tmp/select-2.err" || {
  cat "$tmp/select-2.err" >&2
  fail 'pkg default could not switch to version 2'
}

selected=$(run_selected 2> "$tmp/run-2.err") || {
  cat "$tmp/run-2.err" >&2
  fail 'selected package command version 2 was not executable'
}
[ "$selected" = 2 ] || fail "selected package command returned '$selected' instead of version 2"

current=$(run_pkg default "$package" 2> "$tmp/query-2.err") || fail 'pkg default query failed after switching to version 2'
[ "$current" = "$package@2" ] || fail "pkg default query did not move to version 2: $current"

run_pkg default -u -- "$package" > "$tmp/clear.out" 2> "$tmp/clear.err" || {
  cat "$tmp/clear.err" >&2
  fail 'pkg default could not clear the current binding'
}

if (
  PATH="$root/bin/ext:$root/bin/sys:$PATH"
  export PATH
  command -v "$package" >/dev/null 2>&1
)
then
  fail 'cleared package command remains publicly resolvable'
fi

if run_pkg default "$package" > "$tmp/query-cleared.out" 2> "$tmp/query-cleared.err"
then
  fail 'pkg default query succeeded after clearing the current binding'
else
  [ "$?" -eq 1 ] || fail 'cleared pkg default query did not return 1'
fi

versions=$(run_pkg versions "$package" 2> "$tmp/versions.err") || {
  cat "$tmp/versions.err" >&2
  fail 'pkg versions failed after clearing the default'
}
printf '%s\n' "$versions" | grep -Fx "$package@1" >/dev/null 2>&1 ||
  fail 'version 1 disappeared when the default was cleared'
printf '%s\n' "$versions" | grep -Fx "$package@2" >/dev/null 2>&1 ||
  fail 'version 2 disappeared when the default was cleared'

if run_pkg default -u "$package@1" > "$tmp/invalid-version.out" 2> "$tmp/invalid-version.err"
then
  fail 'pkg default -u accepted a versioned operand'
else
  [ "$?" -eq 2 ] || fail 'versioned pkg default -u operand did not return 2'
fi

if run_pkg default Bad > "$tmp/invalid-name.out" 2> "$tmp/invalid-name.err"
then
  fail 'pkg default accepted an invalid package name'
else
  [ "$?" -eq 2 ] || fail 'invalid pkg default package name did not return 2'
fi

exit 0
