#!/bin/sh

TEST_ID=rumiai-os/pkg/dependency.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

cleanup()
{
  trap - 0 HUP INT TERM

  [ -z "${facility-}" ] || run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  if [ -n "${consumer-}" ] && [ -n "${facility-}" ]
  then
    run_pkg provider bind -u -- "$consumer" "$facility" >/dev/null 2>&1 || :
  fi

  for p in "${provider_a-}" "${provider_b-}" "${provider_bad-}"
  do
    [ -n "$p" ] || continue
    run_pkg default -u -- "$p" >/dev/null 2>&1 || :
  done

  for concrete in     "${consumer-}@1"     "${provider_a-}@1" "${provider_a-}@2"     "${provider_b-}@1" "${provider_bad-}@1"
  do
    case "$concrete" in @*) continue ;; esac
    run_pkg uninstall "$concrete" >/dev/null 2>&1 || :
  done

  [ -z "${consumer_state-}" ] || rm -rf "$consumer_state" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
pkg_group=${test_dir%/*}
tests_dir=${pkg_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg integration library is missing'
[ -f "$root/lib/sys/sh/pkg-dependency.lib.sh" ] || fail 'pkg dependency library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-dependency-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

facility=depjava$$
provider_a=depprova$$
provider_b=depprovb$$
provider_bad=depbad$$
consumer=depconsumer$$

consumer_conf=$("$root/m" "$root/bin/sys/state-path" system pkg "$consumer" conf) ||
  error 'cannot resolve consumer system conf'
consumer_state=${consumer_conf%/conf}
[ ! -e "$consumer_state" ] && [ ! -L "$consumer_state" ] ||
  skip 'temporary consumer state already exists'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@" ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

resolver=$tmp/dependency-resolver
cat > "$resolver" <<'EOF_RESOLVER'
. "$m_LIB_DIR/sys/sh/pkg-facility.lib.sh" || exit 3
. "$m_LIB_DIR/sys/sh/pkg-dependency.lib.sh" || exit 3
pkg_dependency_resolve "$@"
EOF_RESOLVER
chmod 700 "$resolver" || error 'cannot prepare dependency resolver'

make_payload()
{
  dir=$1
  label=$2
  mkdir -p "$dir" || return 1
  printf '%s\n' "$label" > "$dir/marker" || return 1
}

integrate_provider()
{
  pkg=$1
  version=$2
  compatibility=$3
  range=$tmp/range-$pkg-$version
  payload=$tmp/payload-$pkg-$version
  mkdir "$range" || return 1
  printf '%s %s\n' "$facility" "$compatibility" > "$range/facility" || return 1
  make_payload "$payload" "$pkg-$version" || return 1
  "$root/m" "$driver" integrate "$pkg" "$version" "$range" "$payload"
}

integrate_consumer()
{
  range=$tmp/range-$consumer
  payload=$tmp/payload-$consumer
  rm -rf "$range" "$payload"
  mkdir "$range" || return 1
  printf '%s\n' "$facility >=17" > "$range/dependency" || return 1
  make_payload "$payload" "$consumer" || return 1
  "$root/m" "$driver" integrate "$consumer" 1 "$range" "$payload"
}

resolve_consumer()
{
  "$root/m" "$resolver" "$root/pkg/$consumer@1/dependency" "$consumer" ""
}

integrate_provider "$provider_a" 1 17 > "$tmp/prova1.out" 2> "$tmp/prova1.err" || {
  cat "$tmp/prova1.err" >&2
  fail 'cannot integrate provider A v1'
}
run_pkg default "$provider_a@1" >/dev/null 2> "$tmp/prova1-default.err" ||
  fail 'cannot select provider A v1 as package default'

# A compatible installed provider alone is deliberately insufficient.
expect_status 1 no-selector integrate_consumer
[ ! -e "$root/pkg/$consumer@1" ] && [ ! -L "$root/pkg/$consumer@1" ] ||
  fail 'consumer was integrated without a binding or facility default'

# A generic facility default resolves through the provider package default.
run_pkg provider default "$facility" "$provider_a" >/dev/null 2> "$tmp/facility-default.err" ||
  fail 'cannot set generic facility default'
integrate_consumer > "$tmp/consumer.out" 2> "$tmp/consumer.err" || {
  cat "$tmp/consumer.err" >&2
  fail 'consumer did not integrate through facility default'
}
[ -f "$root/pkg/$consumer@1/dependency" ] || fail 'consumer dependency declaration was not materialized'
[ ! -e "$root/pkg/$consumer@1/binding" ] && [ ! -L "$root/pkg/$consumer@1/binding" ] ||
  fail 'integration materialized a concrete provider binding in the package store'

tab=$(printf '\t')
resolved=$(resolve_consumer 2> "$tmp/resolve-a1.err") || {
  cat "$tmp/resolve-a1.err" >&2
  fail 'runtime dependency resolution failed through generic facility default'
}
[ "$resolved" = "$facility$tab$provider_a@1" ] ||
  fail "generic facility default resolved unexpectedly: $resolved"

# Generic selector follows a later provider package-default change.
integrate_provider "$provider_a" 2 21 > "$tmp/prova2.out" 2> "$tmp/prova2.err" ||
  fail 'cannot integrate provider A v2'
run_pkg default "$provider_a@2" >/dev/null 2> "$tmp/prova2-default.err" ||
  fail 'cannot move provider A package default to v2'
resolved=$(resolve_consumer 2> "$tmp/resolve-a2.err") ||
  fail 'generic selector failed after provider package default changed'
[ "$resolved" = "$facility$tab$provider_a@2" ] ||
  fail 'generic selector did not follow provider package default'

# Explicit consumer binding overrides facility default.
integrate_provider "$provider_b" 1 25 > "$tmp/provb.out" 2> "$tmp/provb.err" ||
  fail 'cannot integrate provider B'
run_pkg default "$provider_b@1" >/dev/null 2> "$tmp/provb-default.err" ||
  fail 'cannot select provider B package default'
run_pkg provider bind "$consumer" "$facility" "$provider_b" >/dev/null 2> "$tmp/bind-b.err" ||
  fail 'cannot bind consumer to provider B'
resolved=$(resolve_consumer 2> "$tmp/resolve-b.err") ||
  fail 'consumer binding did not resolve'
[ "$resolved" = "$facility$tab$provider_b@1" ] ||
  fail 'consumer binding did not override facility default'

# Explicit version is pinned even when the provider package default is different.
run_pkg provider bind "$consumer" "$facility" "$provider_a@1" >/dev/null 2> "$tmp/bind-pinned.err" ||
  fail 'cannot pin consumer to provider A v1'
resolved=$(resolve_consumer 2> "$tmp/resolve-pinned.err") ||
  fail 'pinned consumer binding did not resolve'
[ "$resolved" = "$facility$tab$provider_a@1" ] ||
  fail 'explicit version selector did not remain pinned'

# An incompatible selected provider fails; resolver must not hunt for another compatible provider.
integrate_provider "$provider_bad" 1 11 > "$tmp/provbad.out" 2> "$tmp/provbad.err" ||
  fail 'cannot integrate incompatible provider'
run_pkg default "$provider_bad@1" >/dev/null 2> "$tmp/provbad-default.err" ||
  fail 'cannot select incompatible provider package default'
run_pkg provider bind "$consumer" "$facility" "$provider_bad" >/dev/null 2> "$tmp/bind-bad.err" ||
  fail 'cannot configure incompatible binding'
expect_status 1 incompatible-selected resolve_consumer

# Removing the binding restores inheritance from the facility default.
run_pkg provider bind -u -- "$consumer" "$facility" >/dev/null 2> "$tmp/bind-unset.err" ||
  fail 'cannot remove consumer binding'
resolved=$(resolve_consumer 2> "$tmp/resolve-inherited.err") ||
  fail 'consumer did not resume facility-default inheritance'
[ "$resolved" = "$facility$tab$provider_a@2" ] ||
  fail 'binding removal did not restore facility-default provider'

# Removing the facility default leaves no implicit fallback despite installed providers.
run_pkg provider default -u -- "$facility" >/dev/null 2> "$tmp/default-unset.err" ||
  fail 'cannot remove facility default'
expect_status 1 no-default-after-install resolve_consumer

# Provider-selection configuration protects an explicitly referenced concrete.
run_pkg provider default "$facility" "$provider_b@1" >/dev/null 2> "$tmp/default-exact.err" ||
  fail 'cannot set exact facility default'
run_pkg default -u -- "$provider_b" >/dev/null 2> "$tmp/provb-default-unset.err" ||
  fail 'cannot clear provider B package default'
expect_status 1 selected-provider-protected run_pkg uninstall "$provider_b@1"

run_pkg provider default -u -- "$facility" >/dev/null 2> "$tmp/default-final-unset.err" ||
  fail 'cannot remove exact facility default'

# Exact consumer binding protects a non-default concrete.
run_pkg provider bind "$consumer" "$facility" "$provider_a@1" >/dev/null 2> "$tmp/bind-a1.err" ||
  fail 'cannot bind consumer to provider A v1'
expect_status 1 bound-provider-protected run_pkg uninstall "$provider_a@1"
run_pkg provider bind -u -- "$consumer" "$facility" >/dev/null 2> "$tmp/bind-final-unset.err" ||
  fail 'cannot remove final consumer binding'

printf 'provider-selection=ok\n'
printf 'late-binding=ok\n'
printf 'no-install-time-binding=ok\n'
exit 0
