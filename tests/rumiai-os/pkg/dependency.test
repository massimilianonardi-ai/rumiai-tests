#!/bin/sh

TEST_ID=rumiai-os/pkg/dependency.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${cleanup_packages-}" ] && [ -n "${root-}" ]
  then
    for cleanup_package in $cleanup_packages
    do
      run_pkg uninstall "$cleanup_package@1" >/dev/null 2>&1 || :
      rm -rf "$root/pkg/$cleanup_package@1" 2>/dev/null || :
      rm -f "$root/pkg/$cleanup_package" 2>/dev/null || :
    done
  fi

  if [ -n "${providers_root-}" ]
  then
    rm -rf       "$providers_root/$facility_main"       "$providers_root/$facility_amb"       "$providers_root/$facility_missing"       2>/dev/null || :
  fi

  if [ "${providers_root_created-0}" -eq 1 ] && [ -n "${providers_root-}" ]
  then
    rmdir "$providers_root" 2>/dev/null || :
  fi
  if [ "${data_root_created-0}" -eq 1 ] && [ -n "${provider_data_root-}" ]
  then
    rmdir "$provider_data_root" 2>/dev/null || :
  fi
  if [ "${data_parent_created-0}" -eq 1 ] && [ -n "${provider_data_parent-}" ]
  then
    rmdir "$provider_data_parent" 2>/dev/null || :
  fi
  if [ "${state_sys_created-0}" -eq 1 ] && [ -n "${provider_state_sys-}" ]
  then
    rmdir "$provider_state_sys" 2>/dev/null || :
  fi

  if [ "${pkg_store_created-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

make_payload()
{
  payload=$1
  label=$2
  mkdir "$payload" || return 1
  printf '%s\n' "$label" > "$payload/payload"
}

integrate_provider()
{
  pkg_name=$1
  facility=$2
  compatibility=$3
  range=$tmp/range-$pkg_name
  payload=$tmp/payload-$pkg_name

  mkdir "$range" || return 1
  printf '%s %s\n' "$facility" "$compatibility" > "$range/facility" || return 1
  make_payload "$payload" "$pkg_name" || return 1

  "$root/m" "$driver" integrate "$pkg_name" 1 "$range" "$payload"
}

integrate_consumer()
{
  pkg_name=$1
  dependency=$2
  range=$tmp/range-$pkg_name
  payload=$tmp/payload-$pkg_name

  mkdir "$range" || return 1
  printf '%s\n' "$dependency" > "$range/dependency" || return 1
  make_payload "$payload" "$pkg_name" || return 1

  "$root/m" "$driver" integrate "$pkg_name" 1 "$range" "$payload"
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-dependency-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

facility_main=depmain$$
facility_amb=depamb$$
facility_missing=depmiss$$

low=deplow$$
high=dephigh$$
too_high=deptop$$
consumer=depconsumer$$
amb_a=depamba$$
amb_b=depambb$$
amb_consumer=depambconsumer$$
missing_consumer=depmissing$$

cleanup_packages="$missing_consumer $amb_consumer $amb_b $amb_a $consumer $too_high $high $low"

pkg_store_created=0
if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_DRIVER
chmod 600 "$driver" || error 'cannot prepare integration driver'

provider_data_root=$("$root/m" "$root/bin/sys/state-path" system sys pkg data) ||
  error 'cannot resolve package provider state'
providers_root=$provider_data_root/providers
provider_data_parent=${provider_data_root%/data}
provider_state_sys=${provider_data_parent%/pkg}

providers_root_created=0
data_root_created=0
data_parent_created=0
state_sys_created=0
[ -e "$providers_root" ] || [ -L "$providers_root" ] || providers_root_created=1
[ -e "$provider_data_root" ] || [ -L "$provider_data_root" ] || data_root_created=1
[ -e "$provider_data_parent" ] || [ -L "$provider_data_parent" ] || data_parent_created=1
[ -e "$provider_state_sys" ] || [ -L "$provider_state_sys" ] || state_sys_created=1

for facility in "$facility_main" "$facility_amb" "$facility_missing"
do
  [ ! -e "$providers_root/$facility" ] && [ ! -L "$providers_root/$facility" ] ||
    error "temporary dependency facility already exists: $facility"
done

integrate_provider "$low" "$facility_main" 17 > "$tmp/low.out" 2> "$tmp/low.err" || {
  cat "$tmp/low.err" >&2
  fail 'cannot integrate lower compatible provider'
}
integrate_provider "$high" "$facility_main" 21 > "$tmp/high.out" 2> "$tmp/high.err" || {
  cat "$tmp/high.err" >&2
  fail 'cannot integrate highest compatible provider'
}
integrate_provider "$too_high" "$facility_main" 22 > "$tmp/top.out" 2> "$tmp/top.err" || {
  cat "$tmp/top.err" >&2
  fail 'cannot integrate out-of-range provider'
}

integrate_consumer "$consumer" "$facility_main >=17 <22"   > "$tmp/consumer.out" 2> "$tmp/consumer.err" || {
    cat "$tmp/consumer.err" >&2
    fail 'compatible dependency consumer did not integrate'
  }

versions=$(run_pkg versions "$consumer" 2> "$tmp/consumer-versions.err") ||
  fail 'integrated dependency consumer is not visible to pkg versions'
[ "$versions" = "$consumer@1" ] ||
  fail "dependency consumer versions output is unexpected: $versions"

expect_status 1 selected-provider-protected run_pkg uninstall "$high@1"

run_pkg uninstall "$low@1" > "$tmp/remove-low.out" 2> "$tmp/remove-low.err" || {
  cat "$tmp/remove-low.err" >&2
  fail 'lower unselected compatible provider remained referenced'
}
run_pkg uninstall "$too_high@1" > "$tmp/remove-top.out" 2> "$tmp/remove-top.err" || {
  cat "$tmp/remove-top.err" >&2
  fail 'out-of-range provider remained referenced'
}

run_pkg uninstall "$consumer@1" > "$tmp/remove-consumer.out" 2> "$tmp/remove-consumer.err" || {
  cat "$tmp/remove-consumer.err" >&2
  fail 'cannot remove dependency consumer'
}

run_pkg uninstall "$high@1" > "$tmp/remove-high.out" 2> "$tmp/remove-high.err" || {
  cat "$tmp/remove-high.err" >&2
  fail 'selected provider remained blocked after consumer removal'
}

integrate_provider "$amb_a" "$facility_amb" 21 > "$tmp/amb-a.out" 2> "$tmp/amb-a.err" ||
  fail 'cannot integrate first ambiguous provider'
integrate_provider "$amb_b" "$facility_amb" 21 > "$tmp/amb-b.out" 2> "$tmp/amb-b.err" ||
  fail 'cannot integrate second ambiguous provider'

amb_range=$tmp/range-$amb_consumer
amb_payload=$tmp/payload-$amb_consumer
mkdir "$amb_range" || error 'cannot create ambiguous consumer definition'
printf '%s\n' "$facility_amb =21" > "$amb_range/dependency"
make_payload "$amb_payload" "$amb_consumer" || error 'cannot create ambiguous consumer payload'

"$root/m" "$driver" integrate "$amb_consumer" 1 "$amb_range" "$amb_payload"   > "$tmp/amb-consumer.out" 2> "$tmp/amb-consumer.err"
status=$?
[ "$status" -eq 1 ] || {
  cat "$tmp/amb-consumer.err" >&2
  fail "ambiguous dependency integration returned $status instead of 1"
}
[ -d "$amb_payload" ] || fail 'ambiguous dependency failure consumed caller-owned payload'
[ ! -e "$root/pkg/$amb_consumer@1" ] && [ ! -L "$root/pkg/$amb_consumer@1" ] ||
  fail 'ambiguous dependency published a consumer package'

run_pkg uninstall "$amb_a@1" >/dev/null 2> "$tmp/remove-amb-a.err" ||
  fail 'first ambiguous provider remained referenced after rejected consumer'
run_pkg uninstall "$amb_b@1" >/dev/null 2> "$tmp/remove-amb-b.err" ||
  fail 'second ambiguous provider remained referenced after rejected consumer'

missing_range=$tmp/range-$missing_consumer
missing_payload=$tmp/payload-$missing_consumer
mkdir "$missing_range" || error 'cannot create unsatisfied consumer definition'
printf '%s\n' "$facility_missing >=1" > "$missing_range/dependency"
make_payload "$missing_payload" "$missing_consumer" || error 'cannot create unsatisfied consumer payload'

"$root/m" "$driver" integrate "$missing_consumer" 1 "$missing_range" "$missing_payload"   > "$tmp/missing.out" 2> "$tmp/missing.err"
status=$?
[ "$status" -eq 1 ] || {
  cat "$tmp/missing.err" >&2
  fail "unsatisfied dependency integration returned $status instead of 1"
}
[ -d "$missing_payload" ] || fail 'unsatisfied dependency failure consumed caller-owned payload'
[ ! -e "$root/pkg/$missing_consumer@1" ] && [ ! -L "$root/pkg/$missing_consumer@1" ] ||
  fail 'unsatisfied dependency published a consumer package'

exit 0
