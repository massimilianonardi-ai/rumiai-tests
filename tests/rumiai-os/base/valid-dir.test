#!/bin/sh

TEST_ID=rumiai-os/base/valid-dir.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
base_group=${test_dir%/*}
tests_dir=${base_group%/*}
suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -f "$root/lib/sys/sh/base.lib.sh" ] || fail 'base library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-base-valid-dir-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

driver=$tmp/driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
case "$1" in
  valid-dir)
    shift
    valid_dir "$@"
    ;;
  *) exit 3 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

real_dir=$tmp/real
regular_file=$tmp/file
dir_link=$tmp/link
mkdir "$real_dir" || error 'cannot create real directory'
: > "$regular_file" || error 'cannot create regular file'
ln -s "$real_dir" "$dir_link" || error 'cannot create directory symlink'

expect_status 0 real-dir "$root/m" "$driver" valid-dir "$real_dir"
expect_status 2 directory-symlink "$root/m" "$driver" valid-dir "$dir_link"
expect_status 2 regular-file "$root/m" "$driver" valid-dir "$regular_file"
expect_status 2 missing "$root/m" "$driver" valid-dir "$tmp/missing"
expect_status 1 missing-operand "$root/m" "$driver" valid-dir
expect_status 1 extra-operand "$root/m" "$driver" valid-dir "$real_dir" "$real_dir"

exit 0
