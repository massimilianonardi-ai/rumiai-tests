#!/bin/sh

TEST_ID="rumiai-os/osarch/detection.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
tests_dir="${group_dir%/*}"
suite_root="${tests_dir%/*}"

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac

library="$root/lib/sys/sh/osarch.lib.sh"
[ -f "$library" ] || fail "lib/sys/sh/osarch.lib.sh is missing"
[ ! -x "$library" ] || fail "lib/sys/sh/osarch.lib.sh must not be executable"

IFS= read -r first_line < "$library" || first_line=""
case "$first_line" in
  "#!"*) fail "lib/sys/sh/osarch.lib.sh must not contain a shebang" ;;
esac

raw_os="$(command -p -- uname -s 2>/dev/null)" || error "cannot detect host operating system"
raw_arch="$(command -p -- uname -m 2>/dev/null)" || error "cannot detect host architecture"

case "$raw_os" in
  "Linux") expected_os="linux" ;;
  "Darwin") expected_os="macos" ;;
  "MINGW"*|"MSYS"*|"CYGWIN"*) expected_os="windows" ;;
  *) expected_os="$raw_os" ;;
esac

case "$raw_arch" in
  "arm64"|"ARM64"|"aarch64"|"AARCH64") expected_arch="arm64" ;;
  "x86_64"|"X86_64"|"amd64"|"AMD64"|"x64"|"X64") expected_arch="x86_64" ;;
  *) expected_arch="$raw_arch" ;;
esac

expected_osarch="${expected_os}-${expected_arch}"
tmp="${TMPDIR:-/tmp}/rumiai-osarch-detection-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

probe="$tmp/probe"
cat > "$probe" <<'EOF'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s|%s|%s\n' "$m_OSARCH_OS" "$m_OSARCH_ARCH" "$m_OSARCH"
command -p -- sh -c 'printf -- "%s|%s|%s\n" "$m_OSARCH_OS" "$m_OSARCH_ARCH" "$m_OSARCH"'
EOF
chmod 700 "$probe" || error "cannot make osarch probe executable"

output="$("$root/m" "$probe")" || fail "osarch.lib.sh could not be sourced through the m runtime"
expected_line="${expected_os}|${expected_arch}|${expected_osarch}"
expected_output="${expected_line}
${expected_line}"
[ "$output" = "$expected_output" ] || fail "osarch.lib.sh did not normalize/export the expected osarch state"

exit "0"
