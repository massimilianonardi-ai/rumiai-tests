#!/bin/sh

TEST_ID="rumiai-os/osarch/detection.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

rumiai_test_target_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"

  case "$origin" in
    "https://github.com/massimilianonardi-ai/rumiai-os.git"|"git@github.com:massimilianonardi-ai/rumiai-os.git"|"ssh://git@github.com/massimilianonardi-ai/rumiai-os.git")
      return "0"
      ;;
  esac

  return "1"
}

rumiai_test_target_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_origin_ok "$candidate" || return "1"
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_find()
{
  start="$1"
  command -v git >/dev/null 2>&1 || return "3"

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"

  while :
  do
    if rumiai_test_target_validate "$candidate"
    then
      return "0"
    fi

    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done

  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

root="$(rumiai_test_target_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac

library="$root/lib/sh/osarch.lib.sh"
[ -f "$library" ] || fail "lib/sh/osarch.lib.sh is missing"
[ ! -x "$library" ] || fail "lib/sh/osarch.lib.sh must not be executable"

IFS= read -r first_line < "$library" || first_line=""
case "$first_line" in
  "#!"*) fail "lib/sh/osarch.lib.sh must not contain a shebang" ;;
esac

raw_os="$(command -p -- uname -s 2>/dev/null)" || error "cannot detect host operating system"
raw_arch="$(command -p -- uname -m 2>/dev/null)" || error "cannot detect host architecture"

case "$raw_os" in
  "Linux") expected_os="linux" ;;
  "Darwin") expected_os="macos" ;;
  "MINGW"*|"MSYS"*|"CYGWIN"*) expected_os="windows" ;;
  *) expected_os="$raw_os" ;;
esac

case "$raw_arch" in
  "arm64"|"ARM64"|"aarch64"|"AARCH64") expected_arch="arm64" ;;
  "x86_64"|"X86_64"|"amd64"|"AMD64"|"x64"|"X64") expected_arch="x86_64" ;;
  *) expected_arch="$raw_arch" ;;
esac

expected_osarch="${expected_os}-${expected_arch}"
tmp="${TMPDIR:-/tmp}/rumiai-osarch-detection-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

probe="$tmp/probe"
cat > "$probe" <<'EOF'
. "$m_LIB_DIR/sh/osarch.lib.sh"
printf -- '%s|%s|%s\n' "$m_OSARCH_OS" "$m_OSARCH_ARCH" "$m_OSARCH"
command -p -- sh -c 'printf -- "%s|%s|%s\n" "$m_OSARCH_OS" "$m_OSARCH_ARCH" "$m_OSARCH"'
EOF

output="$($root/rumiai-os "$probe")" || fail "osarch.lib.sh could not be sourced through the RumiAI runtime"
expected_line="${expected_os}|${expected_arch}|${expected_osarch}"
expected_output="${expected_line}
${expected_line}"
[ "$output" = "$expected_output" ] || fail "osarch.lib.sh did not normalize/export the expected osarch state"

exit "0"
