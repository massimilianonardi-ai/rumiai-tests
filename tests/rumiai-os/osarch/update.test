#!/bin/sh

TEST_ID=rumiai-os/osarch/update.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
osarch_group=${test_dir%/*}
rumiai_os_group=${osarch_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

osarch=$root/bin/sys/osarch
osarch_update=$root/bin/sys/osarch-update
osarch_set=$root/bin/sys/osarch-set
[ -x "$osarch" ] || fail 'canonical osarch command is missing or not executable'
[ -x "$osarch_update" ] || fail 'compatibility osarch-update command is missing or not executable'
[ -x "$osarch_set" ] || fail 'compatibility osarch-set command is missing or not executable'

case $(command -p -- uname -s 2>/dev/null) in
  Linux) expected_os=linux;;
  Darwin) expected_os=macos;;
  CYGWIN*|MSYS*|MINGW*) expected_os=windows;;
  *) skip 'host operating system is outside the current osarch vocabulary';;
esac

case $(command -p -- uname -m 2>/dev/null) in
  arm64|ARM64|aarch64|AARCH64) expected_arch=arm64;;
  x86_64|X86_64|amd64|AMD64|x64|X64) expected_arch=x86_64;;
  *) skip 'host architecture is outside the current osarch vocabulary';;
esac

expected=$expected_os-$expected_arch
tmp=${TMPDIR:-/tmp}/rumiai-osarch-update-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

"$root/m" "$osarch" update > "$tmp/update.out" 2> "$tmp/update.err" || {
  cat "$tmp/update.err" >&2
  fail 'osarch update failed on the supported host'
}
[ ! -s "$tmp/update.out" ] || fail 'successful osarch update produced unexpected stdout'
[ ! -s "$tmp/update.err" ] || {
  cat "$tmp/update.err" >&2
  fail 'successful osarch update produced unexpected stderr'
}

selected=$("$root/m" "$osarch" 2> "$tmp/query.err") || {
  cat "$tmp/query.err" >&2
  fail 'bare osarch query failed after update'
}
[ "$selected" = "$expected" ] || fail "osarch update selected $selected instead of $expected"

for pair in "sys:sys" "ext:ext" "ai:ai"
do
  name=${pair%%:*}
  prefix=${pair#*:}
  link=$root/bin/$name-osarch
  [ -L "$link" ] || fail "$name-osarch is not a symbolic link after update"
  [ "$(readlink "$link")" = "$prefix-$expected" ] ||
    fail "$name-osarch target is not the expected relative selector"
  [ -d "$root/bin/$prefix-$expected" ] ||
    fail "$name-osarch target directory is missing"
done

"$root/m" "$osarch_update" > "$tmp/compat-update.out" 2> "$tmp/compat-update.err" || {
  cat "$tmp/compat-update.err" >&2
  fail 'compatibility osarch-update command failed'
}
[ ! -s "$tmp/compat-update.out" ] || fail 'compatibility osarch-update produced unexpected stdout'

"$root/m" "$osarch_set" "$expected" > "$tmp/compat-set.out" 2> "$tmp/compat-set.err" || {
  cat "$tmp/compat-set.err" >&2
  fail 'compatibility osarch-set command failed'
}
[ ! -s "$tmp/compat-set.out" ] || fail 'compatibility osarch-set produced unexpected stdout'

selected=$("$root/m" "$osarch") || fail 'bare osarch query failed after compatibility commands'
[ "$selected" = "$expected" ] || fail 'compatibility commands changed the selected osarch unexpectedly'

exit 0
