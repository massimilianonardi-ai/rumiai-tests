#!/bin/sh

TEST_ID=rumiai-os/gitman/interactive.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    if [ -n "${state_current-}" ] && [ -L "$state_current" ]
    then
        rm -f "$state_current" 2>/dev/null || :
    fi
    if [ "${state_user_created-0}" -eq 1 ] && [ -n "${state_user_dir-}" ]
    then
        rmdir "$state_user_dir" 2>/dev/null || :
    fi
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
gitman_group=${test_dir%/*}
rumiai_os_group=${gitman_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

gitman=$root/bin/sys/gitman
state_path=$root/bin/sys/state-path
[ -x "$gitman" ] || fail 'gitman command is unavailable'
[ -x "$state_path" ] || fail 'state-path command is unavailable'

command -v git >/dev/null 2>&1 || skip 'git is unavailable'
command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput cols >/dev/null 2>&1 || skip 'xterm-256color terminfo entry is unavailable'
TERM=xterm-256color tput kcud1 >/dev/null 2>&1 || skip 'Down capability is unavailable'
TERM=xterm-256color tput kend >/dev/null 2>&1 || skip 'End capability is unavailable'
TERM=xterm-256color tput kbs >/dev/null 2>&1 || skip 'Backspace capability is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-gitman-interactive-$$
umask 077
mkdir -p "$tmp/bin" || error 'cannot create temporary directory'

work=$tmp/work
repo_main="$work/a repo"
repo_link="$work/z worktree"
repo_bare="$work/m bare.git"
mkdir -p "$repo_main/sub" || error 'cannot prepare main repository directory'

git init -q "$repo_main" || error 'cannot initialize main Git repository'
git -C "$repo_main" config user.name 'RumiAI Test' || error 'cannot configure Git test name'
git -C "$repo_main" config user.email 'rumiai-test@example.invalid' || error 'cannot configure Git test email'
printf '%s\n' tracked > "$repo_main/tracked.txt" || error 'cannot create tracked fixture'
git -C "$repo_main" add tracked.txt || error 'cannot stage tracked fixture'
git -C "$repo_main" commit -q -m initial || error 'cannot commit tracked fixture'
git -C "$repo_main" branch feature || error 'cannot create feature branch'
git -C "$repo_main" worktree add -q "$repo_link" feature || error 'cannot create linked worktree'
mkdir -p "$repo_link/subdir" || error 'cannot create linked worktree subdirectory'
printf '%s\n' probe > "$repo_main/probe.txt" || error 'cannot create untracked status fixture'
git init -q --bare "$repo_bare" || error 'cannot initialize bare Git repository'

repo_escape=$(printf '%s\n%s' "$work/line" 'literal\n\back')
git init -q "$repo_escape" || error 'cannot initialize escaped-path Git repository'
git -C "$repo_escape" config user.name 'RumiAI Test' || error 'cannot configure escaped-path Git test name'
git -C "$repo_escape" config user.email 'rumiai-test@example.invalid' || error 'cannot configure escaped-path Git test email'
printf '%s\n' escaped > "$repo_escape/tracked.txt" || error 'cannot create escaped-path tracked fixture'
git -C "$repo_escape" add tracked.txt || error 'cannot stage escaped-path tracked fixture'
git -C "$repo_escape" commit -q -m initial || error 'cannot commit escaped-path fixture'

state_user_dir=$root/state/user
state_current=$state_user_dir/current
state_user_created=0

if [ -e "$state_current" ] || [ -L "$state_current" ]
then
    skip 'target already has explicit user/current state binding'
fi

if [ ! -d "$state_user_dir" ]
then
    mkdir "$state_user_dir" || error 'cannot create temporary target user-state selector directory'
    state_user_created=1
fi

user_state=$tmp/user-state
mkdir -p "$user_state" || error 'cannot create temporary user state'
ln -s "$user_state" "$state_current" || error 'cannot install temporary user-state binding'

conf_dir=$("$root/m" "$state_path" user sys gitman conf) || error 'cannot resolve gitman configuration area'
mkdir -p "$conf_dir" || error 'cannot create gitman configuration area'
conf_file=$conf_dir/repositories

pager_probe=$tmp/pager-probe
pager_marker=$tmp/user-pager-invoked
less_marker=$tmp/less-invoked
less_env=$tmp/less-env
fake_less=$tmp/bin/less

cat > "$pager_probe" <<'EOF_PAGER'
#!/bin/sh
: > "$RUMIAI_GITMAN_PAGER_MARKER"
exit 99
EOF_PAGER
chmod +x "$pager_probe" || error 'cannot make pager probe executable'

cat > "$fake_less" <<'EOF_LESS'
#!/bin/sh
printf 'invoked\n' >> "$RUMIAI_GITMAN_LESS_MARKER"
printf 'LESS=%s\n' "${LESS-}" > "$RUMIAI_GITMAN_LESS_ENV"

if [ "$#" -eq 0 ]
then
    command -p cat
else
    command -p cat "$@"
fi
EOF_LESS
chmod +x "$fake_less" || error 'cannot make fake less executable'

export TERM=xterm-256color

python3 - "$root/m" "$gitman" "$work" "$repo_main" "$repo_link" "$repo_bare" "$repo_escape" "$conf_file" "$pager_probe" "$pager_marker" "$tmp/bin" "$less_marker" "$less_env" <<'PY_GITMAN'
import os
import pty
import select
import subprocess
import sys
import time
from pathlib import Path

m_command, gitman_command, work, repo_main, repo_link, repo_bare, repo_escape, conf_file, pager_probe, pager_marker, fake_bin, less_marker, less_env = sys.argv[1:14]

env = os.environ.copy()
env["TERM"] = "xterm-256color"
env["PATH"] = fake_bin + os.pathsep + env["PATH"]
env["GIT_PAGER"] = pager_probe
env["PAGER"] = pager_probe
env["LESS"] = "-S"
env["RUMIAI_GITMAN_PAGER_MARKER"] = pager_marker
env["RUMIAI_GITMAN_LESS_MARKER"] = less_marker
env["RUMIAI_GITMAN_LESS_ENV"] = less_env

def capability(name):
    return subprocess.check_output(["tput", name], env=env)

DOWN = capability("kcud1")
END = capability("kend")
BACKSPACE = capability("kbs")
try:
    RMCUP = capability("rmcup")
except subprocess.CalledProcessError:
    RMCUP = b""

class Session:
    def __init__(self, args, cwd):
        self.buffer = bytearray()
        self.pid, self.master = pty.fork()
        self.exited = False
        self.status = None
        if self.pid == 0:
            os.chdir(cwd)
            argv = [m_command, gitman_command, *args]
            os.execve(m_command, argv, env)

    def pump(self, timeout=0.05):
        if self.exited:
            return
        ready, _, _ = select.select([self.master], [], [], timeout)
        if ready:
            try:
                chunk = os.read(self.master, 65536)
            except OSError:
                chunk = b""
            if chunk:
                self.buffer.extend(chunk)
        waited, wait_status = os.waitpid(self.pid, os.WNOHANG)
        if waited == self.pid:
            self.exited = True
            self.status = os.waitstatus_to_exitcode(wait_status)

    def pump_for(self, duration):
        deadline = time.monotonic() + duration
        while time.monotonic() < deadline and not self.exited:
            self.pump(min(0.05, max(0.0, deadline - time.monotonic())))

    def wait_for(self, needle, start=0, timeout=5.0):
        if isinstance(needle, str):
            needle = needle.encode()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            pos = self.buffer.find(needle, start)
            if pos >= 0:
                return pos
            if self.exited:
                break
            self.pump(0.05)
        raise AssertionError(("missing output", needle, bytes(self.buffer[start:])))

    def send(self, data):
        if isinstance(data, str):
            data = data.encode()
        os.write(self.master, data)

    def wait_exit(self, expected=0, timeout=5.0):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and not self.exited:
            self.pump(0.05)
        if not self.exited:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
            self.exited = True
            raise AssertionError(("session did not exit", bytes(self.buffer)))
        assert self.status == expected, (self.status, bytes(self.buffer))
        os.close(self.master)

    def abort(self):
        if not self.exited:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
            self.exited = True
        try:
            os.close(self.master)
        except OSError:
            pass


def run_explicit_action_and_error_scenario():
    s = Session(["a repo/sub", "missing dir", "m bare.git"], work)
    try:
        s.wait_for("Git repositories")
        combined = b"not a directory: missing dir; bare Git repository is not supported: m bare.git"
        s.wait_for(combined)
        s.wait_for(repo_main)

        mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: pager]", start=mark)
        s.wait_for("Status", start=mark)

        # Default pager mode must override caller Git pager selection, force
        # even Status through RumiAI pager, preserve caller LESS options, and
        # return directly to the action menu without a second key prompt.
        for path in (pager_marker, less_marker, less_env):
            try:
                Path(path).unlink()
            except FileNotFoundError:
                pass

        action_mark = len(s.buffer)
        s.send(b"\n")
        pager_return = s.wait_for("[output: pager]", start=action_mark)
        segment = bytes(s.buffer[action_mark:pager_return])
        assert Path(less_marker).exists(), ("RumiAI pager did not select less", segment)
        assert not Path(pager_marker).exists(), ("caller Git pager was not overridden", segment)
        less_value = Path(less_env).read_text(encoding="utf-8")
        assert "LESS=-S -R -+F -+X" in less_value, less_value
        assert b"probe.txt" in segment, segment
        assert b"Press any key to continue..." not in segment, segment
        assert combined not in bytes(s.buffer[pager_return:]), (
            "successful pager action did not clear previous bottom-footer error",
            bytes(s.buffer[pager_return:]),
        )

        # Toggle to terminal mode. Pager must be bypassed, output must carry a
        # repository/action header, and the explicit key pause must return.
        mode_mark = len(s.buffer)
        s.send(b"p")
        s.wait_for("[output: terminal]", start=mode_mark)
        less_invocations_before = Path(less_marker).read_text(encoding="utf-8").count("invoked")

        terminal_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for(f"Repository: {repo_main}", start=terminal_mark)
        s.wait_for("Action: status", start=terminal_mark)
        s.wait_for("probe.txt", start=terminal_mark)
        s.wait_for("Press any key to continue...", start=terminal_mark)
        less_invocations_after = Path(less_marker).read_text(encoding="utf-8").count("invoked")
        assert less_invocations_after == less_invocations_before, (
            "terminal mode unexpectedly invoked pager",
            bytes(s.buffer[terminal_mark:]),
        )

        resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("[output: terminal]", start=resume_mark)

        # Mode is session state and survives returning to/opening repositories.
        back_mark = len(s.buffer)
        s.send(BACKSPACE)
        s.wait_for("Git repositories", start=back_mark)
        reopen_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: terminal]", start=reopen_mark)

        final_back_mark = len(s.buffer)
        s.send(BACKSPACE)
        s.wait_for("Git repositories", start=final_back_mark)
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise

def run_config_and_dedup_scenario():
    Path(conf_file).write_text("a repo/sub\na repo\nz worktree\n", encoding="utf-8")

    s = Session([], work)
    try:
        s.wait_for("Git repositories")

        # If the root/subdirectory candidates were not deduplicated, one Down
        # would select the duplicate main worktree rather than the linked one.
        s.send(DOWN)
        s.pump_for(0.15)
        mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: pager]", start=mark)
        mode_mark = len(s.buffer)
        s.send(b"p")
        s.wait_for("[output: terminal]", start=mode_mark)

        action_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for(f"Repository: {repo_link}", start=action_mark)
        s.wait_for("Press any key to continue...", start=action_mark)
        resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("Status", start=resume_mark)

        back_mark = len(s.buffer)
        s.send(b"\x1b")
        s.wait_for("Git repositories", start=back_mark)
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise


def run_empty_config_fallback_scenario():
    Path(conf_file).write_text("\n\n", encoding="utf-8")

    s = Session([], os.path.join(repo_link, "subdir"))
    try:
        s.wait_for("Git repositories")
        open_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: pager]", start=open_mark)
        mode_mark = len(s.buffer)
        s.send(b"p")
        s.wait_for("[output: terminal]", start=mode_mark)
        action_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for(f"Repository: {repo_link}", start=action_mark)
        s.wait_for("Press any key to continue...", start=action_mark)
        resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("Status", start=resume_mark)
        back_mark = len(s.buffer)
        s.send(b"\x1b")
        s.wait_for("Git repositories", start=back_mark)
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise


def config_encode(path):
    return path.replace("\\", "\\\\").replace("\n", "\\n")


def run_save_and_escape_roundtrip_scenario():
    Path(conf_file).write_text("legacy\n", encoding="utf-8")

    expected = config_encode(os.path.realpath(repo_escape)) + "\n"

    s = Session([repo_escape], work)
    try:
        s.wait_for("Git repositories")

        confirm_mark = len(s.buffer)
        s.send(b"s")
        s.wait_for("Overwrite repositories configuration?", start=confirm_mark)
        assert Path(conf_file).read_text(encoding="utf-8") == "legacy\n", (
            "configuration changed before overwrite confirmation",
            Path(conf_file).read_bytes(),
        )

        no_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("Git repositories", start=no_mark)
        assert Path(conf_file).read_text(encoding="utf-8") == "legacy\n", (
            "default No confirmation overwrote configuration",
            Path(conf_file).read_bytes(),
        )

        confirm_mark = len(s.buffer)
        s.send(b"s")
        s.wait_for("Overwrite repositories configuration?", start=confirm_mark)
        s.send(DOWN)
        s.pump_for(0.15)
        save_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("Git repositories", start=save_mark)
        assert Path(conf_file).read_text(encoding="utf-8") == expected, (
            "saved configuration did not encode newline/backslash path correctly",
            expected,
            Path(conf_file).read_text(encoding="utf-8"),
        )

        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise

    s = Session([], work)
    try:
        s.wait_for("Git repositories")
        open_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: pager]", start=open_mark)
        mode_mark = len(s.buffer)
        s.send(b"p")
        s.wait_for("[output: terminal]", start=mode_mark)
        action_mark = len(s.buffer)
        s.send(b"\n")
        escaped_real = os.path.realpath(repo_escape)
        escaped_first, escaped_second = escaped_real.split("\n", 1)
        s.wait_for(f"Repository: {escaped_first}", start=action_mark)
        s.wait_for(escaped_second, start=action_mark)
        s.wait_for("Press any key to continue...", start=action_mark)
        resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("Status", start=resume_mark)
        back_mark = len(s.buffer)
        s.send(b"\x1b")
        s.wait_for("Git repositories", start=back_mark)
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise


def run_add_remove_clear_scenario():
    s = Session([repo_main], work)
    try:
        s.wait_for("Git repositories")

        add_mark = len(s.buffer)
        s.send(b"a")
        s.wait_for("Add Git repositories", start=add_mark)
        s.send(END)
        s.pump_for(0.15)
        s.send(b" ")
        s.pump_for(0.1)
        return_mark = len(s.buffer)
        s.send(b"\t")
        s.wait_for("Git repositories", start=return_mark)

        # Prove that the add operation installed the linked worktree without
        # relying on its possibly truncated repository-menu label.
        s.send(DOWN)
        s.pump_for(0.15)
        open_added_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("[output: pager]", start=open_added_mark)
        added_mode_mark = len(s.buffer)
        s.send(b"p")
        s.wait_for("[output: terminal]", start=added_mode_mark)
        added_action_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for(f"Repository: {repo_link}", start=added_action_mark)
        s.wait_for("Press any key to continue...", start=added_action_mark)
        added_resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("Status", start=added_resume_mark)
        added_back_mark = len(s.buffer)
        s.send(b"\x1b")
        s.wait_for("Git repositories", start=added_back_mark)

        remove_mark = len(s.buffer)
        s.send(b"r")
        s.wait_for("Remove Git repositories", start=remove_mark)
        s.send(DOWN)
        s.pump_for(0.15)
        s.send(b" ")
        s.pump_for(0.1)
        post_remove_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("Git repositories", start=post_remove_mark)

        # With only repo_main left, Down cannot select another repository.
        s.send(DOWN)
        s.pump_for(0.15)
        open_remaining_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for("Status", start=open_remaining_mark)
        remaining_action_mark = len(s.buffer)
        s.send(b"\n")
        s.wait_for(f"Repository: {repo_main}", start=remaining_action_mark)
        s.wait_for("Press any key to continue...", start=remaining_action_mark)
        remaining_resume_mark = len(s.buffer)
        s.send(b"x")
        s.wait_for("Status", start=remaining_resume_mark)
        remaining_back_mark = len(s.buffer)
        s.send(b"\x1b")
        s.wait_for("Git repositories", start=remaining_back_mark)

        clear_mark = len(s.buffer)
        s.send(b"c")
        s.wait_for("Select Git repositories", start=clear_mark)
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise


def run_zero_repository_acquisition_scenario():
    s = Session(["missing dir"], work)
    try:
        s.wait_for("Select Git repositories")
        s.wait_for("not a directory: missing dir")
        s.send(b"\x1b")
        s.wait_exit(0)
    except Exception:
        s.abort()
        raise


run_explicit_action_and_error_scenario()
run_config_and_dedup_scenario()
run_empty_config_fallback_scenario()
run_save_and_escape_roundtrip_scenario()
run_add_remove_clear_scenario()
run_zero_repository_acquisition_scenario()
PY_GITMAN
status=$?
[ "$status" -eq 0 ] || fail 'gitman interactive scenarios failed'

exit 0
