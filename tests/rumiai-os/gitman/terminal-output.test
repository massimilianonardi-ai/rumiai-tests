#!/bin/sh

TEST_ID=rumiai-os/gitman/terminal-output.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
gitman_group=${test_dir%/*}
rumiai_os_group=${gitman_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

gitman=$root/bin/sys/gitman
[ -x "$gitman" ] || fail 'gitman command is unavailable'

command -v git >/dev/null 2>&1 || skip 'git is unavailable'
command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput kcud1 >/dev/null 2>&1 || skip 'Down capability is unavailable'
TERM=xterm-256color tput khome >/dev/null 2>&1 || skip 'Home capability is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-gitman-terminal-output-$$
umask 077
mkdir -p "$tmp" || error 'cannot create temporary directory'

repo=$tmp/repo
remote=$tmp/remote.git

git init -q "$repo" || error 'cannot initialize Git repository'
git -C "$repo" config user.name 'RumiAI Test' || error 'cannot configure Git test name'
git -C "$repo" config user.email 'rumiai-test@example.invalid' || error 'cannot configure Git test email'
git -C "$repo" branch -m main || error 'cannot name Git test branch'
printf '%s\n' base > "$repo/tracked.txt" || error 'cannot create tracked fixture'
git -C "$repo" add tracked.txt || error 'cannot stage tracked fixture'
git -C "$repo" commit -q -m initial || error 'cannot commit tracked fixture'

git init -q --bare "$remote" || error 'cannot initialize bare Git remote'
git -C "$repo" remote add origin "$remote" || error 'cannot add Git remote'
git -C "$repo" push -q -u origin main || error 'cannot seed Git remote'

export TERM=xterm-256color

python3 - "$root/m" "$gitman" "$repo" "$tmp" <<'PY_GITMAN_TERMINAL_OUTPUT'
import os
import pty
import select
import subprocess
import sys
import time

m_command, gitman_command, repo, work = sys.argv[1:5]

env = os.environ.copy()
env["TERM"] = "xterm-256color"

SYNC_LABEL = (
    "Sync + Push: git add --all → git commit -m <commit-message> → "
    "git pull --no-rebase --no-edit → git push"
)
STATUS_LABEL = "Status: git status --short --branch"
HEADER_RULE = b"-" * 50


def capability(name):
    return subprocess.check_output(["tput", name], env=env)


DOWN = capability("kcud1")
HOME = capability("khome")


class Session:
    def __init__(self):
        self.buffer = bytearray()
        self.pid, self.master = pty.fork()
        self.exited = False
        self.status = None
        if self.pid == 0:
            os.chdir(work)
            argv = [m_command, gitman_command, repo]
            os.execve(m_command, argv, env)

    def pump(self, timeout=0.05):
        if self.exited:
            return
        ready, _, _ = select.select([self.master], [], [], timeout)
        if ready:
            try:
                chunk = os.read(self.master, 65536)
            except OSError:
                chunk = b""
            if chunk:
                self.buffer.extend(chunk)
        waited, wait_status = os.waitpid(self.pid, os.WNOHANG)
        if waited == self.pid:
            self.exited = True
            self.status = os.waitstatus_to_exitcode(wait_status)

    def pump_for(self, duration):
        deadline = time.monotonic() + duration
        while time.monotonic() < deadline and not self.exited:
            self.pump(min(0.05, max(0.0, deadline - time.monotonic())))

    def wait_for(self, needle, start=0, timeout=10.0):
        if isinstance(needle, str):
            needle = needle.encode("utf-8")
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            pos = self.buffer.find(needle, start)
            if pos >= 0:
                return pos
            if self.exited:
                break
            self.pump(0.05)
        raise AssertionError(("missing output", needle, bytes(self.buffer[start:])))

    def send(self, data):
        if isinstance(data, str):
            data = data.encode("utf-8")
        os.write(self.master, data)

    def wait_exit(self, expected=0, timeout=10.0):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and not self.exited:
            self.pump(0.05)
        if not self.exited:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
            self.exited = True
            raise AssertionError(("session did not exit", bytes(self.buffer)))
        assert self.status == expected, (self.status, bytes(self.buffer))
        os.close(self.master)

    def abort(self):
        if not self.exited:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
            self.exited = True
        try:
            os.close(self.master)
        except OSError:
            pass


def wait_for_header(session, label, start):
    label_bytes = label.encode("utf-8")
    first = session.wait_for(HEADER_RULE, start=start)
    label_pos = session.wait_for(label_bytes, start=first + len(HEADER_RULE))
    second = session.wait_for(HEADER_RULE, start=label_pos + len(label_bytes))
    end = second + len(HEADER_RULE)

    actual = bytes(session.buffer[first:end]).replace(b"\r\n", b"\n")
    expected = HEADER_RULE + b"\n" + label_bytes + b"\n" + HEADER_RULE
    assert actual == expected, ("unexpected terminal header", actual, expected)
    return first, end


s = Session()
try:
    s.wait_for("Git repositories")

    open_mark = len(s.buffer)
    s.send(b"\n")
    sync_pos = s.wait_for(SYNC_LABEL, start=open_mark)
    status_pos = s.wait_for(STATUS_LABEL, start=open_mark)
    assert sync_pos < status_pos, (
        "Sync + Push is not the first root action",
        bytes(s.buffer[open_mark:]),
    )

    mode_mark = len(s.buffer)
    s.send(b"p")
    s.wait_for("[output: terminal]", start=mode_mark)

    s.send(HOME)
    s.pump_for(0.1)
    sync_mark = len(s.buffer)
    s.send(b"\n")
    sync_header_start, _ = wait_for_header(s, SYNC_LABEL, sync_mark)
    sync_pause = s.wait_for("Press any key to continue...", start=sync_header_start)
    sync_segment = bytes(s.buffer[sync_header_start:sync_pause])
    assert sync_segment.count(HEADER_RULE) == 2, (
        "Sync + Push emitted more than one terminal header",
        sync_segment,
    )

    local_head = subprocess.check_output(
        ["git", "-C", repo, "rev-parse", "HEAD"], env=env, text=True
    ).strip()
    upstream_head = subprocess.check_output(
        ["git", "-C", repo, "rev-parse", "@{u}"], env=env, text=True
    ).strip()
    assert local_head == upstream_head, (local_head, upstream_head)

    s.send(b"x")
    s.wait_for("[output: terminal]", start=sync_pause)

    s.send(HOME)
    s.pump_for(0.1)
    s.send(DOWN)
    s.pump_for(0.1)
    status_mark = len(s.buffer)
    s.send(b"\n")
    status_header_start, _ = wait_for_header(s, STATUS_LABEL, status_mark)
    s.wait_for("## main", start=status_header_start)
    status_pause = s.wait_for("Press any key to continue...", start=status_header_start)
    status_segment = bytes(s.buffer[status_header_start:status_pause])
    assert status_segment.count(HEADER_RULE) == 2, (
        "Status emitted more than one terminal header",
        status_segment,
    )

    s.send(b"x")
    s.wait_for("[output: terminal]", start=status_pause)

    repo_mark = len(s.buffer)
    s.send(b"\x1b")
    s.wait_for("Git repositories", start=repo_mark)
    s.send(b"\x1b")
    s.wait_exit(0)
except Exception:
    s.abort()
    raise
PY_GITMAN_TERMINAL_OUTPUT
status=$?
[ "$status" -eq 0 ] || fail 'root ordering or terminal sequence-header behavior is incorrect'

exit 0
