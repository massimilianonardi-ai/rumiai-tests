#!/bin/sh

# Protected current properties:
#   GITMAN-11  Sync + Push is the first root action and Status follows it.
#   GITMAN-13  terminal-mode menu selections emit exactly one
#              50-hyphen / concrete selected-label / 50-hyphen header and pause.
#
# GITMAN-16 (p toggles pager/terminal) is used only as the public path needed to
# reach the protected terminal-mode behavior; driver/synchronization failures are
# test ERRORs, not product FAILs.

TEST_ID=rumiai-os/gitman/terminal-output.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
    [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
gitman_group=${test_dir%/*}
rumiai_os_group=${gitman_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) error 'explicit rumiai-os target is invalid' ;;
    *) error 'target discovery failed' ;;
esac

gitman=$root/bin/sys/gitman
[ -x "$gitman" ] || fail 'GITMAN-01 prerequisite: gitman command is unavailable'

command -v git >/dev/null 2>&1 || skip 'git is unavailable'
command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput kcud1 >/dev/null 2>&1 || skip 'Down capability is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-gitman-terminal-output-$$
umask 077
mkdir -p "$tmp" || error 'cannot create temporary directory'

repo=$tmp/repo
git init -q "$repo" || error 'cannot initialize Git repository'

export TERM=xterm-256color

python3 - "$root/m" "$gitman" "$repo" "$tmp" <<'PY_GITMAN_TERMINAL_OUTPUT'
import os
import pty
import re
import select
import subprocess
import sys
import time

m_command, gitman_command, repo, work = sys.argv[1:5]

env = os.environ.copy()
env["TERM"] = "xterm-256color"

SYNC_LABEL = (
    "Sync + Push: git add --all → git commit -m <commit-message> → "
    "git pull --no-rebase --no-edit → git push"
)
STATUS_LABEL = "Status: git status --short --branch"
PAUSE = b"Press any key to continue..."
HEADER = re.compile(rb"(?m)^-{50}\n([^\n]+)\n-{50}$")


class ContractFailure(Exception):
    pass


class HarnessError(Exception):
    pass


def capability(name):
    try:
        return subprocess.check_output(["tput", name], env=env)
    except Exception as exc:
        raise HarnessError(f"cannot obtain terminal capability {name}: {exc}") from exc


DOWN = capability("kcud1")


class Session:
    def __init__(self):
        self.buffer = bytearray()
        try:
            self.pid, self.master = pty.fork()
        except Exception as exc:
            raise HarnessError(f"cannot create PTY: {exc}") from exc

        self.exited = False
        self.status = None

        if self.pid == 0:
            os.chdir(work)
            argv = [m_command, gitman_command, repo]
            os.execve(m_command, argv, env)

    def pump(self, timeout=0.05):
        if self.exited:
            return

        try:
            ready, _, _ = select.select([self.master], [], [], timeout)
        except Exception as exc:
            raise HarnessError(f"PTY select failed: {exc}") from exc

        if ready:
            try:
                chunk = os.read(self.master, 65536)
            except OSError:
                chunk = b""
            if chunk:
                self.buffer.extend(chunk)

        waited, wait_status = os.waitpid(self.pid, os.WNOHANG)
        if waited == self.pid:
            self.exited = True
            self.status = os.waitstatus_to_exitcode(wait_status)

    def wait_for(self, needle, start=0, timeout=10.0, stage="output synchronization"):
        if isinstance(needle, str):
            needle = needle.encode("utf-8")

        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            pos = self.buffer.find(needle, start)
            if pos >= 0:
                return pos
            if self.exited:
                break
            self.pump(0.05)

        tail = bytes(self.buffer[start:])[-2000:]
        raise HarnessError(
            f"{stage}: expected synchronization marker {needle!r}; "
            f"process_status={self.status!r}; output_tail={tail!r}"
        )

    def send(self, data):
        if isinstance(data, str):
            data = data.encode("utf-8")
        try:
            os.write(self.master, data)
        except OSError as exc:
            raise HarnessError(f"cannot send PTY input: {exc}") from exc

    def abort(self):
        if not self.exited:
            try:
                os.kill(self.pid, 9)
            except ProcessLookupError:
                pass
            try:
                os.waitpid(self.pid, 0)
            except ChildProcessError:
                pass
            self.exited = True
        try:
            os.close(self.master)
        except OSError:
            pass


def capture_sequence(session, start, property_name):
    pause = session.wait_for(
        PAUSE,
        start=start,
        stage=f"{property_name}: waiting for terminal sequence completion",
    )

    segment = bytes(session.buffer[start:pause]).replace(b"\r\n", b"\n")
    labels = [match.decode("utf-8", errors="replace") for match in HEADER.findall(segment)]

    if len(labels) != 1:
        raise ContractFailure(
            f"GITMAN-13: expected exactly one terminal sequence header for "
            f"{property_name}; observed {len(labels)}; output={segment!r}"
        )

    return labels[0], pause


session = None
try:
    session = Session()

    session.wait_for("Git repositories", stage="opening repository menu")

    session.send(b"\n")
    session.wait_for("[output: pager]", stage="opening root Git action menu")

    session.send(b"p")
    session.wait_for("[output: terminal]", stage="entering terminal output mode")

    sync_start = len(session.buffer)
    session.send(b"\n")
    sync_label, sync_pause = capture_sequence(session, sync_start, "root first action")

    if sync_label != SYNC_LABEL:
        raise ContractFailure(
            f"GITMAN-11: expected first root action label {SYNC_LABEL!r}; "
            f"observed {sync_label!r}"
        )

    session.send(b"x")
    session.wait_for(
        "[output: terminal]",
        start=sync_pause,
        stage="returning to root Git action menu after Sync + Push",
    )

    status_start = len(session.buffer)
    session.send(DOWN + b"\n")
    status_label, _ = capture_sequence(session, status_start, "root second action")

    if status_label != STATUS_LABEL:
        raise ContractFailure(
            f"GITMAN-11: expected second root action label {STATUS_LABEL!r}; "
            f"observed {status_label!r}"
        )

except ContractFailure as exc:
    if session is not None:
        session.abort()
    print(f"CONTRACT FAIL: {exc}", file=sys.stderr)
    sys.exit(10)
except Exception as exc:
    if session is not None:
        session.abort()
    print(f"TEST ERROR: {exc}", file=sys.stderr)
    sys.exit(11)
else:
    session.abort()
    sys.exit(0)
PY_GITMAN_TERMINAL_OUTPUT
status=$?

case $status in
    0)
        exit 0
        ;;
    10)
        exit 1
        ;;
    11)
        exit 3
        ;;
    *)
        error "PTY driver exited with unexpected status $status"
        ;;
esac
