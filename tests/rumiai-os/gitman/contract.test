#!/bin/sh

TEST_ID=rumiai-os/gitman/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
gitman_group=${test_dir%/*}
rumiai_os_group=${gitman_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

gitman=$root/bin/sys/gitman
manual=$root/res/sys/manual/gitman
manual_command=$root/bin/sys/manual

[ -f "$gitman" ] && [ -x "$gitman" ] || fail 'gitman is missing or not executable'
[ "$(sed -n '1p' "$gitman")" = '#!/usr/bin/env m' ] || fail 'gitman has the wrong interpreter header'
command -p sh -n "$gitman" || fail 'gitman is not valid POSIX-shell syntax'

[ -f "$manual" ] && [ ! -L "$manual" ] || fail 'gitman operational manual is missing'
[ -x "$manual_command" ] || fail 'manual command is unavailable'

grep -F 'state-path user sys gitman conf' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman does not resolve its user configuration through state-path'
grep -F 'gitman_conf_file="$gitman_conf_dir/repositories"' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman repositories configuration pathname is missing'
grep -F 'gitman_config_decode()' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman configuration decoder is missing'
grep -F 'gitman_config_encode()' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman configuration encoder is missing'
grep -F -- '-K a -K r -K c -K s -K e' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman repository menu management actions are incomplete'
grep -F 'Overwrite repositories configuration?' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman overwrite confirmation is missing'
grep -F 'gitman_output_mode=pager' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman does not default to pager output mode'
grep -F -- '-K backspace -K p' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman Git action menu does not expose Backspace and output toggle'
grep -F 'GIT_PAGER=pager' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman pager mode does not select the RumiAI pager'
grep -F -- '-R -+F -+X' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman pager mode does not keep short less sessions open with screen restoration'
grep -F -- '--paginate' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman pager mode does not force Git paging'
grep -F -- '--no-pager' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman terminal mode does not disable Git paging'
grep -F 'gitman_git_run()' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman generic Git runner is missing'
grep -F 'command -- git --paginate -C "$gitman_git_run_repository" "$@"' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman generic pager runner does not execute an explicit Git argument vector'
grep -F 'command -- git --no-pager -C "$gitman_git_run_repository" "$@"' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman generic terminal runner does not execute an explicit Git argument vector'
grep -F 'gitman_action_dispatch()' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman action dispatcher is missing'
grep -F 'gitman_action_handler="gitman_action_$2"' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman action dispatcher does not use the handler naming convention'
grep -F "status 'Status: git status --short --branch'" "$gitman" >/dev/null 2>&1 ||
    fail 'gitman status menu label does not expose its Git command'
grep -F "log 'Log: git log --oneline --decorate --graph -n 50'" "$gitman" >/dev/null 2>&1 ||
    fail 'gitman log menu label does not expose its Git command'
grep -F "branch 'Branches: git branch -vv'" "$gitman" >/dev/null 2>&1 ||
    fail 'gitman branch menu label does not expose its Git command'
grep -F "diff 'Diff: git diff'" "$gitman" >/dev/null 2>&1 ||
    fail 'gitman diff menu label does not expose its Git command'
grep -F 'gitman_git_run "$1" status status --short --branch' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman status handler is missing'
grep -F 'gitman_git_run "$1" log log --oneline --decorate --graph -n 50' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman log handler is missing'
grep -F 'gitman_git_run "$1" branch branch -vv' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman branch handler is missing'
grep -F 'gitman_git_run "$1" diff diff' "$gitman" >/dev/null 2>&1 ||
    fail 'gitman diff handler is missing'
grep -F "Press any key to continue..." "$gitman" >/dev/null 2>&1 ||
    fail 'gitman terminal-mode post-command pause is missing'

manual_text=$("$root/m" "$manual_command" --no-pager gitman) ||
    fail 'manual gitman lookup failed'
printf '%s\n' "$manual_text" | grep -F 'interactive manager for local Git working trees' >/dev/null 2>&1 ||
    fail 'manual gitman returned unexpected content'
printf '%s\n' "$manual_text" | grep -F 'save the current repository set to configuration' >/dev/null 2>&1 ||
    fail 'manual gitman does not document configuration save'
printf '%s\n' "$manual_text" | grep -F 'EDIT CONFIGURATION' >/dev/null 2>&1 ||
    fail 'manual gitman does not document configuration editing'
printf '%s\n' "$manual_text" | grep -F 'VISUAL' >/dev/null 2>&1 ||
    fail 'manual gitman does not document VISUAL editor selection'
printf '%s\n' "$manual_text" | grep -F 'EDITOR' >/dev/null 2>&1 ||
    fail 'manual gitman does not document EDITOR editor selection'
printf '%s\n' "$manual_text" | grep -F 'falls through to vi' >/dev/null 2>&1 ||
    fail 'manual gitman does not document vi fallback'
printf '%s\n' "$manual_text" | grep -F 'pager' >/dev/null 2>&1 ||
    fail 'manual gitman does not document pager output mode'
printf '%s\n' "$manual_text" | grep -F 'terminal' >/dev/null 2>&1 ||
    fail 'manual gitman does not document terminal output mode'
printf '%s\n' "$manual_text" | grep -F -- '-R -+F -+X' >/dev/null 2>&1 ||
    fail 'manual gitman does not document held less behavior'
printf '%s\n' "$manual_text" | grep -F 'Status: git status --short --branch' >/dev/null 2>&1 ||
    fail 'manual gitman does not expose concrete leaf action commands'
printf '%s\n' "$manual_text" | grep -F 'action model itself is not restricted to read-only' >/dev/null 2>&1 ||
    fail 'manual gitman still claims a read-only action model'

exit 0
