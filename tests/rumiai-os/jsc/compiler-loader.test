#!/bin/sh

TEST_ID=rumiai-os/jsc/compiler-loader.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }

self=$0
case "$self" in */*) : ;; *) self=$(command -v "$self") || error "cannot resolve test pathname" ;; esac
test_dir=$(CDPATH= cd -- "${self%/*}" && pwd -P) || error "cannot resolve test directory"
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error "cannot resolve suite root"
target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "target discovery library missing"
. "$target_library" || error "target discovery unavailable"

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit product target checkout' ;;
  *) error 'product target discovery failed' ;;
esac

command_file="$root/bin/sys/jsc"
engine="$root/lib/sys/js/jsc.lib.js"
loader="$root/lib/sys/js/dynamic-loader.lib.js"
[ -x "$command_file" ] || fail 'jsc command is not executable'
[ -f "$command_file" ] && [ ! -L "$command_file" ] || fail 'jsc command is not a regular file'
[ -f "$engine" ] && [ ! -L "$engine" ] && [ ! -x "$engine" ] || fail 'compiler engine file type/mode invalid'
[ -f "$loader" ] && [ ! -L "$loader" ] && [ ! -x "$loader" ] || fail 'loader library file type/mode invalid'
[ "$(command -p sed -n '1p' "$command_file")" = '#!/usr/bin/env m' ] || fail 'incorrect public command shebang'
command -p sh -n "$command_file" || fail 'public command is not POSIX shell syntax'

for topic in jsc jsc.lib.js dynamic-loader.lib.js
do
  [ -f "$root/res/sys/manual/$topic" ] && [ ! -L "$root/res/sys/manual/$topic" ] ||
    fail "missing operational manual: $topic"
done

command -v node >/dev/null 2>&1 || skip 'Node.js unavailable for actual JavaScript compiler/loader execution'
node "$test_dir/.support/compiler-loader.mjs" "$root" || fail 'real compiler/loader behavior mismatched'
exit 0
