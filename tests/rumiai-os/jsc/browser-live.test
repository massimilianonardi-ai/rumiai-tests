#!/bin/sh
TEST_ID=rumiai-os/jsc/browser-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
self=$0
case "$self" in */*) : ;; *) self=$(command -v "$self") || error "test pathname unavailable" ;; esac
test_dir=$(CDPATH= cd -- "${self%/*}" && pwd -P) || error "test directory unavailable"
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error "suite root unavailable"
. "$suite_root/lib/rumiai-os-target.lib" || error "target helper unavailable"
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in 0) : ;; 1) skip 'rumiai-os checkout unavailable' ;; 2) fail 'invalid product checkout' ;; *) error 'cannot resolve product target' ;; esac
command -v node >/dev/null 2>&1 || skip 'Node.js unavailable'
browser=${CHROMIUM-}
if [ -z "$browser" ]; then
  for executable in google-chrome chromium chromium-browser
  do
    browser=$(command -v "$executable" 2>/dev/null) && break
  done
fi
[ -n "$browser" ] && [ -x "$browser" ] || skip 'Chromium/Chrome browser unavailable'
CHROMIUM=$browser
export CHROMIUM
node "$test_dir/.support/browser-live.mjs" "$root" || fail "published browser loader real-runtime failure"
exit 0
