#!/bin/sh

TEST_ID=rumiai-os/shell/interactive-startup.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Reference implementation copied from:
# massimilianonardi-ai/rumiai-tests@326dc93086af2f5c25716d1d92c08a86317afa7f:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() {
    command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok() {
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|\
        git@github.com:massimilianonardi-ai/rumiai-os.git|\
        ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
            return 0
            ;;
    esac
    return 1
}

rumiai_test_target_rumiai_os_validate() {
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1

    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1

    printf '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find() {
    start=$1
    rumiai_test_target_have git || return 3

    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
    then
        rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi

    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :
    do
        if rumiai_test_target_rumiai_os_validate "$candidate"
        then
            return 0
        fi

        [ "$candidate" != / ] || break
        parent=${candidate%/*}
        [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done

    return 1
}

resolve_test_dir() {
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group=${test_dir%/*}
rumiai_os_group=${group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

source_root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

[ -x "$source_root/rumiai-os" ] || fail 'rumiai-os target entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-shell-interactive-startup-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

command_file=$tmp/shell-command
cat > "$command_file" <<'EOT'
shell "$@"
EOT

ext=$tmp/ext
cat > "$ext" <<'EOT'
TEST_SHELL_EXT_LOADED=loaded
export TEST_SHELL_EXT_LOADED
EOT

tested=0
for shell_name in sh dash ash bash zsh
do
    shell_path=$(command -v "$shell_name" 2>/dev/null) || continue
    tested=$((tested + 1))
    home=$tmp/home-$shell_name
    mkdir "$home" || error "cannot create HOME for $shell_name"

    (
        unset ENV ZDOTDIR
        HOME=$home
        SHELL=$shell_path
        m_SHELL_EXT=$ext
        EXPECTED_SHELL_NAME=$shell_name
        TERM=dumb
        export HOME SHELL m_SHELL_EXT EXPECTED_SHELL_NAME TERM

        "$source_root/rumiai-os" "$command_file" -i -c '
            [ "${TEST_SHELL_EXT_LOADED-}" = "loaded" ] || exit 41
            [ "${m_SHELL_NAME-}" = "$EXPECTED_SHELL_NAME" ] || exit 42
            command -v shell >/dev/null 2>&1 || exit 43
            case "${PS1-}" in
                *"RumiAI:$EXPECTED_SHELL_NAME"*) : ;;
                *) exit 44 ;;
            esac
            [ -n "${m_ROOT-}" ] || exit 45
            exit 0
        '
    ) >"$tmp/$shell_name.out" 2>"$tmp/$shell_name.err"
    status=$?

    [ "$status" -eq 0 ] || {
        cat "$tmp/$shell_name.err" >&2
        fail "$shell_name interactive startup returned $status"
    }
done

[ "$tested" -gt 0 ] || skip 'no supported shell is available on this host'
exit 0
