#!/bin/sh

TEST_ID=rumiai-os/shell/noninteractive-extension.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=$tests_dir

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'; [ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-noninteractive-extension-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM

ext="$tmp/ext"
cat > "$ext" <<'EOT'
printf '%s\n' loaded > "$TEST_EXT_MARKER"
EOT

tested=0
for shell_name in sh dash ash bash zsh
do
  shell_path="$(command -v "$shell_name" 2>/dev/null)" || continue
  tested=$((tested + 1)); marker="$tmp/$shell_name.ext"
  rm -f "$marker"
  (
    unset ENV ZDOTDIR
    SHELL="$shell_path"; m_SHELL_EXT="$ext"; TEST_EXT_MARKER="$marker"; TERM=dumb
    export SHELL m_SHELL_EXT TEST_EXT_MARKER TERM
    "$root/m" "$root/bin/sys/shell" -c 'exit 0'
  ) >"$tmp/$shell_name.out" 2>"$tmp/$shell_name.err"
  status="$?"
  [ "$status" -eq 0 ] || { cat "$tmp/$shell_name.err" >&2; fail "$shell_name non-interactive startup returned $status"; }
  [ ! -e "$marker" ] || fail "$shell_name non-interactive startup loaded m_SHELL_EXT"
done
[ "$tested" -gt 0 ] || skip 'no supported shell is available on this host'
exit 0
