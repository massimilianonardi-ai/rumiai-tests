#!/bin/sh

TEST_ID=rumiai-os/shell/zsh-runtime-state-boundary.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
rumiai_test_target_origin_ok() { candidate="$1"; origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1; case "$origin" in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_validate() { candidate="$1"; [ -n "$candidate" ] || return 1; [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1; rumiai_test_target_origin_ok "$candidate" || return 1; target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1; [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_find() { start="$1"; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3; while :; do if rumiai_test_target_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent="${candidate%/*}"; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate="$parent"; done; return 1; }
resolve_test_dir() { self="$0"; case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac; self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
make_fixture() { source_root="$1"; fixture_root="$2"; mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 1; for fixture_file in m rumiai-os rumiai-os-sh product-name product-version; do cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || return 1; done; for fixture_dir in bin lib lang state; do cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || return 1; done; chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || return 1; }

test_dir="$(resolve_test_dir)" || error 'cannot resolve test directory'; group="${test_dir%/*}"; rumiai_os_group="${group%/*}"; tests_dir="${rumiai_os_group%/*}"; suite_root="${tests_dir%/*}"
source_root="$(rumiai_test_target_find "$suite_root")"; status="$?"; case "$status" in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
[ -x "$source_root/m" ] || fail 'm target runtime is not executable'; [ -x "$source_root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-zsh-runtime-state-boundary-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture_root="$tmp/rumiai-os"; make_fixture "$source_root" "$fixture_root" || error 'cannot materialize isolated rumiai-os fixture'

fake_dir="$tmp/fake"; mkdir "$fake_dir" || error 'cannot create fake shell directory'; fake_zsh="$fake_dir/zsh"
cat > "$fake_zsh" <<'EOT'
#!/bin/sh
[ "$ZDOTDIR" = "$TEST_RUNTIME_ZDOTDIR" ] || exit 41
[ "$ZDOTDIR" != "$TEST_CONF_ZDOTDIR" ] || exit 42
[ -d "$ZDOTDIR" ] || exit 43
printf '%s\n' "$ZDOTDIR" > "$TEST_RECORD" || exit 44
printf '%s\n' runtime-state > "$ZDOTDIR/$TEST_STATE_NAME" || exit 45
exit 0
EOT
chmod 700 "$fake_zsh" || error 'cannot make fake zsh executable'

user_shell_home="$("$fixture_root/m" "$fixture_root/bin/sys/state-path" user sys shell home 2>/dev/null)" || error 'cannot resolve user shell home state'
shell_conf_dir="$("$fixture_root/m" "$fixture_root/bin/sys/state-path" system sys shell conf 2>/dev/null)" || error 'cannot resolve system shell configuration state'
[ -n "$user_shell_home" ] && [ -n "$shell_conf_dir" ] || error 'resolved shell state path is empty'

TEST_RECORD="$tmp/zdotdir.record"
TEST_STATE_NAME=".rumiai-test-runtime-state-$$"
TEST_RUNTIME_ZDOTDIR="$user_shell_home/zsh"
TEST_CONF_ZDOTDIR="$shell_conf_dir/zsh"
HOME="$tmp/user-home"
SHELL="$fake_zsh"
m_SHELL_EXT=
TERM=dumb
mkdir "$HOME" || error 'cannot create user HOME fixture'
export TEST_RECORD TEST_STATE_NAME TEST_RUNTIME_ZDOTDIR TEST_CONF_ZDOTDIR HOME SHELL m_SHELL_EXT TERM
unset ZDOTDIR

"$fixture_root/m" "$fixture_root/bin/sys/shell" >"$tmp/stdout" 2>"$tmp/stderr"
status="$?"
[ "$status" -eq 0 ] || { cat "$tmp/stderr" >&2; fail "fake Zsh launch returned $status"; }

runtime_zdotdir="$TEST_RUNTIME_ZDOTDIR"
conf_zdotdir="$TEST_CONF_ZDOTDIR"
[ "$(cat "$TEST_RECORD")" = "$runtime_zdotdir" ] || fail 'Zsh did not receive the runtime state ZDOTDIR'
[ -f "$runtime_zdotdir/$TEST_STATE_NAME" ] || fail 'runtime state was not materialized in user shell home state'
[ ! -e "$conf_zdotdir/$TEST_STATE_NAME" ] || fail 'runtime state leaked into system shell configuration state'
for proxy in .zshenv .zprofile .zshrc
do
  [ -f "$runtime_zdotdir/$proxy" ] || fail "runtime redirector $proxy is missing"
  [ ! -L "$runtime_zdotdir/$proxy" ] || fail "runtime redirector $proxy must not be a symlink"
  expected=". \"\$(state-path system sys shell conf)/zsh/$proxy\""
  [ "$(cat "$runtime_zdotdir/$proxy")" = "$expected" ] || fail "runtime redirector $proxy does not resolve canonical configuration through state-path"
done
exit 0
