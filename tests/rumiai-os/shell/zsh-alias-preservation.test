#!/bin/sh

TEST_ID=rumiai-os/shell/zsh-alias-preservation.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'; [ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-zsh-alias-preservation-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM

zsh_path="$(command -v zsh 2>/dev/null)" || skip 'Zsh is unavailable on this host'
[ -n "${HOME-}" ] || skip 'HOME is unavailable in the supplied environment'
[ -d "$HOME" ] && [ ! -L "$HOME" ] && [ -w "$HOME" ] ||
  skip 'HOME is not a writable real directory in the supplied environment'

zshenv=$HOME/.zshenv
zshrc=$HOME/.zshrc
for startup_file in "$zshenv" "$zshrc"
do
  [ ! -e "$startup_file" ] && [ ! -L "$startup_file" ] ||
    skip "HOME already contains ${startup_file##*/}; refusing to replace user startup configuration"
done

user_shell_home=$("$root/m" "$root/bin/sys/state-path" user sys shell home 2>/dev/null) ||
  error 'cannot resolve user shell home state'
runtime_zdotdir=$user_shell_home/zsh
[ ! -e "$runtime_zdotdir" ] && [ ! -L "$runtime_zdotdir" ] ||
  skip 'zsh runtime shell state already exists in the supplied target'

user_shell_home_preexisting=0
if [ -d "$user_shell_home" ] && [ ! -L "$user_shell_home" ]
then
  user_shell_home_preexisting=1
fi

cleanup()
{
  trap - 0 HUP INT TERM
  rm -f "$zshrc" 2>/dev/null || :
  rm -rf "$runtime_zdotdir" 2>/dev/null || :
  if [ "$user_shell_home_preexisting" -eq 0 ]
  then
    rmdir "$user_shell_home" 2>/dev/null || :
  fi
  rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

cat > "$zshrc" <<'EOT'
setopt aliases
alias log='false'
alias printf='false'
alias sentinel='false'
EOT
ext="$tmp/ext"
cat > "$ext" <<'EOT'
TEST_SHELL_EXT_LOADED=loaded
export TEST_SHELL_EXT_LOADED
EOT
(
  unset ZDOTDIR
  SHELL="$zsh_path"; m_SHELL_EXT="$ext"; TERM=dumb
  export SHELL m_SHELL_EXT TERM
  "$root/m" "$root/bin/sys/shell" -i -c '
    [[ -o aliases ]] || exit 41
    alias log >/dev/null 2>&1 || exit 42
    alias printf >/dev/null 2>&1 || exit 43
    alias sentinel >/dev/null 2>&1 || exit 44
    functions log >/dev/null 2>&1 || exit 45
    functions shell >/dev/null 2>&1 || exit 46
    [ "${TEST_SHELL_EXT_LOADED-}" = "loaded" ] || exit 47
    exit 0
  '
) >"$tmp/stdout" 2>"$tmp/stderr"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/stderr" >&2; fail "Zsh alias preservation returned $status"; }
exit 0
