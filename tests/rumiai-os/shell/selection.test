#!/bin/sh

TEST_ID=rumiai-os/shell/selection.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir() { self="$0"; case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac; self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }

test_dir="$(resolve_test_dir)" || error 'cannot resolve test directory'
group="${test_dir%/*}"; rumiai_os_group="${group%/*}"; tests_dir="${rumiai_os_group%/*}"; suite_root="${tests_dir%/*}"

target_library="$suite_root/lib/rumiai-os-target.lib"
fixture_library="$suite_root/lib/rumiai-os-fixture.lib"
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
[ -f "$fixture_library" ] || error 'rumiai-os fixture helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'
. "$fixture_library" || error 'cannot source rumiai-os fixture helper'

source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status="$?"
case "$status" in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
[ -x "$source_root/m" ] || fail 'm target runtime is not executable'
[ -x "$source_root/bin/sys/shell" ] || fail 'shell target command is not executable'

tmp="${TMPDIR:-/tmp}/rumiai-shell-selection-$$"
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture_root="$tmp/rumiai-os"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture_root"
status=$?
case "$status" in
  0) : ;;
  1) fail 'source checkout lacks required runtime material' ;;
  2) error 'cannot materialize isolated fixture' ;;
  *) error "fixture primitive returned unexpected status $status" ;;
esac

selected="$tmp/selected-shell"
cat > "$selected" <<'EOT'
#!/bin/sh
{
  printf '%s\n' "${m_SHELL_NAME-}"
  printf '%s\n' "${SHELL-}"
} > "$TEST_RECORD"
exit 0
EOT
chmod 700 "$selected" || error 'cannot make selected shell executable'
TEST_RECORD="$tmp/selected.record"; export TEST_RECORD
(
  SHELL="$selected"; TERM=dumb; export SHELL TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" >"$tmp/selected.out" 2>"$tmp/selected.err"
)
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/selected.err" >&2; fail "explicit SHELL returned $status"; }
{ printf '%s\n' 'selected-shell'; printf '%s\n' "$selected"; } > "$tmp/selected.expected" || error 'cannot write selected expectation'
cmp "$tmp/selected.expected" "$TEST_RECORD" >/dev/null 2>&1 || { cat "$TEST_RECORD" >&2; fail 'explicit SHELL was not selected exactly'; }

mkdir "$tmp/bin" || error 'cannot create fallback bin directory'
fallback="$tmp/bin/sh"
cat > "$fallback" <<'EOT'
#!/bin/sh
{
  printf '%s\n' "${m_SHELL_NAME-}"
  printf '%s\n' "${ENV-}"
} > "$TEST_RECORD"
exit 0
EOT
chmod 700 "$fallback" || error 'cannot make fallback shell executable'
shell_conf_dir="$("$fixture_root/m" "$fixture_root/bin/sys/state-path" system sys shell conf 2>/dev/null)" || error 'cannot resolve shell configuration state'
[ -n "$shell_conf_dir" ] || error 'resolved shell configuration state is empty'
TEST_RECORD="$tmp/fallback.record"; export TEST_RECORD
(
  SHELL=; unset ENV ZDOTDIR; PATH="$tmp/bin:$PATH"; TERM=dumb; export SHELL PATH TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" >"$tmp/fallback.out" 2>"$tmp/fallback.err"
)
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/fallback.err" >&2; fail "fallback shell returned $status"; }
{ printf '%s\n' 'sh'; printf '%s\n' "$shell_conf_dir/sh/env"; } > "$tmp/fallback.expected" || error 'cannot write fallback expectation'
cmp "$tmp/fallback.expected" "$TEST_RECORD" >/dev/null 2>&1 || { cat "$TEST_RECORD" >&2; fail 'empty SHELL did not select the sh adapter'; }
exit 0
