#!/bin/sh

TEST_ID=rumiai-os/shell/zsh-zdotdir-preservation.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
rumiai_test_target_origin_ok() { candidate="$1"; origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1; case "$origin" in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_validate() { candidate="$1"; [ -n "$candidate" ] || return 1; [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1; rumiai_test_target_origin_ok "$candidate" || return 1; target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1; [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_find() { start="$1"; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3; while :; do if rumiai_test_target_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent="${candidate%/*}"; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate="$parent"; done; return 1; }
resolve_test_dir() { self="$0"; case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac; self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
make_fixture() { source_root="$1"; fixture_root="$2"; mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 1; for fixture_file in m rumiai-os rumiai-os-sh product-name product-version; do cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || return 1; done; for fixture_dir in bin lib lang state; do cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || return 1; done; chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || return 1; }

test_dir="$(resolve_test_dir)" || error 'cannot resolve test directory'; group="${test_dir%/*}"; rumiai_os_group="${group%/*}"; tests_dir="${rumiai_os_group%/*}"; suite_root="${tests_dir%/*}"
source_root="$(rumiai_test_target_find "$suite_root")"; status="$?"; case "$status" in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
[ -x "$source_root/m" ] || fail 'm target runtime is not executable'; [ -x "$source_root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-zdotdir-preservation-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture_root="$tmp/rumiai-os"; make_fixture "$source_root" "$fixture_root" || error 'cannot materialize isolated rumiai-os fixture'

zsh_path="$(command -v zsh 2>/dev/null)" || skip 'Zsh is unavailable on this host'
check_command='
case "$EXPECTED_ZDOT_STATE" in
  unset) [ "${ZDOTDIR+x}" != "x" ] || exit 41 ;;
  empty) [ "${ZDOTDIR+x}" = "x" ] || exit 42; [ -z "$ZDOTDIR" ] || exit 43 ;;
  value) [ "${ZDOTDIR+x}" = "x" ] || exit 44; [ "$ZDOTDIR" = "$EXPECTED_ZDOT_VALUE" ] || exit 45 ;;
  *) exit 46 ;;
esac
[ "${m_SHELL_ZDOTDIR+x}" != "x" ] || exit 47
[ "${m_SHELL_ZDOTDIR_INIT+x}" != "x" ] || exit 48
exit 0
'

home="$tmp/home-unset"; mkdir "$home" || error 'cannot create unset-state HOME'
(
  unset ZDOTDIR
  HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=unset; EXPECTED_ZDOT_VALUE=; TERM=dumb
  export HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/unset.out" 2>"$tmp/unset.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/unset.err" >&2; fail "unset ZDOTDIR case returned $status"; }

home="$tmp/home-empty"; mkdir "$home" || error 'cannot create empty-state HOME'
(
  ZDOTDIR=; HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=empty; EXPECTED_ZDOT_VALUE=; TERM=dumb
  export ZDOTDIR HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/empty.out" 2>"$tmp/empty.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/empty.err" >&2; fail "empty ZDOTDIR case returned $status"; }

home="$tmp/home-value"; custom="$home/custom"; mkdir -p "$custom" || error 'cannot create value-state ZDOTDIR'
(
  ZDOTDIR="$custom"; HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=value; EXPECTED_ZDOT_VALUE="$custom"; TERM=dumb
  export ZDOTDIR HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/value.out" 2>"$tmp/value.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/value.err" >&2; fail "value ZDOTDIR case returned $status"; }

home="$tmp/home-mutated"; changed="$home/changed"; final="$home/final"; mkdir -p "$home" "$changed" "$final" || error 'cannot create mutation-state directories'
cat > "$home/.zshenv" <<'EOT'
TEST_ZSHENV_LOADED=loaded
ZDOTDIR="$TEST_CHANGED_ZDOTDIR"
export TEST_ZSHENV_LOADED ZDOTDIR
EOT
cat > "$changed/.zshrc" <<'EOT'
TEST_ZSHRC_LOADED=loaded
ZDOTDIR="$TEST_FINAL_ZDOTDIR"
export TEST_ZSHRC_LOADED ZDOTDIR
EOT
mutation_command='
[ "${TEST_ZSHENV_LOADED-}" = "loaded" ] || exit 51
[ "${TEST_ZSHRC_LOADED-}" = "loaded" ] || exit 52
[ "${ZDOTDIR+x}" = "x" ] || exit 53
[ "$ZDOTDIR" = "$TEST_FINAL_ZDOTDIR" ] || exit 54
[ "${m_SHELL_ZDOTDIR+x}" != "x" ] || exit 55
[ "${m_SHELL_ZDOTDIR_INIT+x}" != "x" ] || exit 56
exit 0
'
(
  unset ZDOTDIR
  HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; TEST_CHANGED_ZDOTDIR="$changed"; TEST_FINAL_ZDOTDIR="$final"; TERM=dumb
  export HOME SHELL m_SHELL_EXT TEST_CHANGED_ZDOTDIR TEST_FINAL_ZDOTDIR TERM
  "$fixture_root/m" "$fixture_root/bin/sys/shell" -i -c "$mutation_command"
) >"$tmp/mutated.out" 2>"$tmp/mutated.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/mutated.err" >&2; fail "startup-mutated ZDOTDIR case returned $status"; }
exit 0
