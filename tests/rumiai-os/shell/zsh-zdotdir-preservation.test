#!/bin/sh

TEST_ID=rumiai-os/shell/zsh-zdotdir-preservation.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'; [ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-zdotdir-preservation-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM

zsh_path="$(command -v zsh 2>/dev/null)" || skip 'Zsh is unavailable on this host'
check_command='
case "$EXPECTED_ZDOT_STATE" in
  unset) [ "${ZDOTDIR+x}" != "x" ] || exit 41 ;;
  empty) [ "${ZDOTDIR+x}" = "x" ] || exit 42; [ -z "$ZDOTDIR" ] || exit 43 ;;
  value) [ "${ZDOTDIR+x}" = "x" ] || exit 44; [ "$ZDOTDIR" = "$EXPECTED_ZDOT_VALUE" ] || exit 45 ;;
  *) exit 46 ;;
esac
[ "${m_SHELL_ZDOTDIR+x}" != "x" ] || exit 47
[ "${m_SHELL_ZDOTDIR_INIT+x}" != "x" ] || exit 48
exit 0
'

home="$tmp/home-unset"; mkdir "$home" || error 'cannot create unset-state HOME'
(
  unset ZDOTDIR
  HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=unset; EXPECTED_ZDOT_VALUE=; TERM=dumb
  export HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$root/m" "$root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/unset.out" 2>"$tmp/unset.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/unset.err" >&2; fail "unset ZDOTDIR case returned $status"; }

home="$tmp/home-empty"; mkdir "$home" || error 'cannot create empty-state HOME'
(
  ZDOTDIR=; HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=empty; EXPECTED_ZDOT_VALUE=; TERM=dumb
  export ZDOTDIR HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$root/m" "$root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/empty.out" 2>"$tmp/empty.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/empty.err" >&2; fail "empty ZDOTDIR case returned $status"; }

home="$tmp/home-value"; custom="$home/custom"; mkdir -p "$custom" || error 'cannot create value-state ZDOTDIR'
(
  ZDOTDIR="$custom"; HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; EXPECTED_ZDOT_STATE=value; EXPECTED_ZDOT_VALUE="$custom"; TERM=dumb
  export ZDOTDIR HOME SHELL m_SHELL_EXT EXPECTED_ZDOT_STATE EXPECTED_ZDOT_VALUE TERM
  "$root/m" "$root/bin/sys/shell" -i -c "$check_command"
) >"$tmp/value.out" 2>"$tmp/value.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/value.err" >&2; fail "value ZDOTDIR case returned $status"; }

home="$tmp/home-mutated"; changed="$home/changed"; final="$home/final"; mkdir -p "$home" "$changed" "$final" || error 'cannot create mutation-state directories'
cat > "$home/.zshenv" <<'EOT'
TEST_ZSHENV_LOADED=loaded
ZDOTDIR="$TEST_CHANGED_ZDOTDIR"
export TEST_ZSHENV_LOADED ZDOTDIR
EOT
cat > "$changed/.zshrc" <<'EOT'
TEST_ZSHRC_LOADED=loaded
ZDOTDIR="$TEST_FINAL_ZDOTDIR"
export TEST_ZSHRC_LOADED ZDOTDIR
EOT
mutation_command='
[ "${TEST_ZSHENV_LOADED-}" = "loaded" ] || exit 51
[ "${TEST_ZSHRC_LOADED-}" = "loaded" ] || exit 52
[ "${ZDOTDIR+x}" = "x" ] || exit 53
[ "$ZDOTDIR" = "$TEST_FINAL_ZDOTDIR" ] || exit 54
[ "${m_SHELL_ZDOTDIR+x}" != "x" ] || exit 55
[ "${m_SHELL_ZDOTDIR_INIT+x}" != "x" ] || exit 56
exit 0
'
(
  unset ZDOTDIR
  HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT=; TEST_CHANGED_ZDOTDIR="$changed"; TEST_FINAL_ZDOTDIR="$final"; TERM=dumb
  export HOME SHELL m_SHELL_EXT TEST_CHANGED_ZDOTDIR TEST_FINAL_ZDOTDIR TERM
  "$root/m" "$root/bin/sys/shell" -i -c "$mutation_command"
) >"$tmp/mutated.out" 2>"$tmp/mutated.err"
status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/mutated.err" >&2; fail "startup-mutated ZDOTDIR case returned $status"; }
exit 0
