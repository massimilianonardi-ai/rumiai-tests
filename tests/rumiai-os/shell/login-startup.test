#!/bin/sh

TEST_ID=rumiai-os/shell/login-startup.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'
[ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path target command is not executable'

[ -n "${HOME-}" ] || skip 'HOME is unavailable in the supplied environment'
[ -d "$HOME" ] && [ ! -L "$HOME" ] && [ -w "$HOME" ] ||
  skip 'HOME is not a writable real directory in the supplied environment'

tmp=${TMPDIR:-/tmp}/rumiai-shell-login-startup-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

bash_profile=
bash_rc=
zsh_profile=
zsh_rc=
runtime_zdotdir=
user_shell_home=
user_shell_home_preexisting=1
cleanup()
{
  trap - 0 HUP INT TERM
  [ -z "$bash_profile" ] || rm -f "$bash_profile" 2>/dev/null || :
  [ -z "$bash_rc" ] || rm -f "$bash_rc" 2>/dev/null || :
  [ -z "$zsh_profile" ] || rm -f "$zsh_profile" 2>/dev/null || :
  [ -z "$zsh_rc" ] || rm -f "$zsh_rc" 2>/dev/null || :
  [ -z "$runtime_zdotdir" ] || rm -rf "$runtime_zdotdir" 2>/dev/null || :
  if [ "$user_shell_home_preexisting" -eq 0 ] && [ -n "$user_shell_home" ]
  then
    rmdir "$user_shell_home" 2>/dev/null || :
  fi
  rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

ext=$tmp/ext
cat > "$ext" <<'EOF_EXT'
printf '%s\n' loaded > "$TEST_EXT_MARKER"
EOF_EXT

tested=0

if bash_path=$(command -v bash 2>/dev/null)
then
  bash_profile=$HOME/.bash_profile
  bash_rc=$HOME/.bashrc
  for startup_file in "$bash_profile" "$bash_rc"
  do
    [ ! -e "$startup_file" ] && [ ! -L "$startup_file" ] ||
      skip "HOME already contains ${startup_file##*/}; refusing to replace user startup configuration"
  done

  profile_marker=$tmp/bash.profile
  rc_marker=$tmp/bash.rc
  ext_marker=$tmp/bash.ext

  cat > "$bash_profile" <<'EOF_BASH_PROFILE'
printf '%s\n' loaded > "$TEST_LOGIN_PROFILE_MARKER"
EOF_BASH_PROFILE
  cat > "$bash_rc" <<'EOF_BASH_RC'
printf '%s\n' loaded > "$TEST_LOGIN_RC_MARKER"
EOF_BASH_RC

  (
    SHELL=$bash_path
    m_SHELL_EXT=$ext
    TEST_LOGIN_PROFILE_MARKER=$profile_marker
    TEST_LOGIN_RC_MARKER=$rc_marker
    TEST_EXT_MARKER=$ext_marker
    TERM=dumb
    export SHELL m_SHELL_EXT TEST_LOGIN_PROFILE_MARKER TEST_LOGIN_RC_MARKER TEST_EXT_MARKER TERM
    "$root/m" "$root/bin/sys/shell" -l -i -c 'exit 0'
  ) > "$tmp/bash.out" 2> "$tmp/bash.err"
  status=$?
  [ "$status" -eq 0 ] || {
    cat "$tmp/bash.err" >&2
    fail "Bash login startup returned $status"
  }
  [ -e "$profile_marker" ] || fail 'Bash login did not execute the native login profile'
  [ ! -e "$rc_marker" ] || fail 'Bash login unexpectedly forced the non-login bashrc'
  [ ! -e "$ext_marker" ] || fail 'Bash login unexpectedly forced m_SHELL_EXT'

  rm -f "$bash_profile" "$bash_rc" || error 'cannot remove Bash startup fixtures'
  bash_profile=
  bash_rc=
  tested=$((tested + 1))
fi

if zsh_path=$(command -v zsh 2>/dev/null)
then
  zsh_env=$HOME/.zshenv
  zsh_profile=$HOME/.zprofile
  zsh_rc=$HOME/.zshrc
  zsh_login=$HOME/.zlogin
  for startup_file in "$zsh_env" "$zsh_profile" "$zsh_rc" "$zsh_login"
  do
    [ ! -e "$startup_file" ] && [ ! -L "$startup_file" ] ||
      skip "HOME already contains ${startup_file##*/}; refusing to replace user startup configuration"
  done

  user_shell_home=$("$root/m" "$root/bin/sys/state-path" user sys shell home 2>/dev/null) ||
    error 'cannot resolve user shell home state'
  runtime_zdotdir=$user_shell_home/zsh
  [ ! -e "$runtime_zdotdir" ] && [ ! -L "$runtime_zdotdir" ] ||
    skip 'zsh runtime shell state already exists in the supplied target'

  if [ -d "$user_shell_home" ] && [ ! -L "$user_shell_home" ]
  then
    user_shell_home_preexisting=1
  elif [ -e "$user_shell_home" ] || [ -L "$user_shell_home" ]
  then
    skip 'user shell home state is not a real directory'
  else
    user_shell_home_preexisting=0
  fi

  profile_marker=$tmp/zsh.profile
  rc_marker=$tmp/zsh.rc
  ext_marker=$tmp/zsh.ext

  cat > "$zsh_profile" <<'EOF_ZPROFILE'
printf '%s\n' loaded > "$TEST_LOGIN_PROFILE_MARKER"
EOF_ZPROFILE
  cat > "$zsh_rc" <<'EOF_ZSHRC'
printf '%s\n' loaded > "$TEST_LOGIN_RC_MARKER"
EOF_ZSHRC

  (
    unset ZDOTDIR
    SHELL=$zsh_path
    m_SHELL_EXT=$ext
    TEST_LOGIN_PROFILE_MARKER=$profile_marker
    TEST_LOGIN_RC_MARKER=$rc_marker
    TEST_EXT_MARKER=$ext_marker
    TERM=dumb
    export SHELL m_SHELL_EXT TEST_LOGIN_PROFILE_MARKER TEST_LOGIN_RC_MARKER TEST_EXT_MARKER TERM
    "$root/m" "$root/bin/sys/shell" -l -i -c 'exit 0'
  ) > "$tmp/zsh.out" 2> "$tmp/zsh.err"
  status=$?
  [ "$status" -eq 0 ] || {
    cat "$tmp/zsh.err" >&2
    fail "Zsh login startup returned $status"
  }
  [ -e "$profile_marker" ] || fail 'Zsh login did not execute the native zprofile'
  [ -e "$rc_marker" ] || fail 'Zsh login did not continue through the native interactive zshrc'
  [ ! -e "$ext_marker" ] || fail 'Zsh login unexpectedly forced m_SHELL_EXT'

  rm -f "$zsh_profile" "$zsh_rc" || error 'cannot remove Zsh startup fixtures'
  zsh_profile=
  zsh_rc=
  rm -rf "$runtime_zdotdir" || error 'cannot remove Zsh runtime-state fixture'
  runtime_zdotdir=
  if [ "$user_shell_home_preexisting" -eq 0 ]
  then
    rmdir "$user_shell_home" 2>/dev/null || :
  fi
  tested=$((tested + 1))
fi

[ "$tested" -gt 0 ] || skip 'neither Bash nor Zsh is available on this host'
exit 0
