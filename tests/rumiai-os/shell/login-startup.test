#!/bin/sh

TEST_ID=rumiai-os/shell/login-startup.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Reference implementation copied from:
# massimilianonardi-ai/rumiai-tests@326dc93086af2f5c25716d1d92c08a86317afa7f:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() {
    command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok() {
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|\
        git@github.com:massimilianonardi-ai/rumiai-os.git|\
        ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
            return 0
            ;;
    esac
    return 1
}

rumiai_test_target_rumiai_os_validate() {
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1

    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1

    printf '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find() {
    start=$1
    rumiai_test_target_have git || return 3

    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
    then
        rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi

    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :
    do
        if rumiai_test_target_rumiai_os_validate "$candidate"
        then
            return 0
        fi

        [ "$candidate" != / ] || break
        parent=${candidate%/*}
        [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done

    return 1
}

resolve_test_dir() {
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group=${test_dir%/*}
rumiai_os_group=${group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

source_root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

[ -x "$source_root/rumiai-os" ] || fail 'rumiai-os target entrypoint is not executable'

tmp=${TMPDIR:-/tmp}/rumiai-shell-login-startup-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

command_file=$tmp/shell-command
cat > "$command_file" <<'EOT'
shell "$@"
EOT

ext=$tmp/ext
cat > "$ext" <<'EOT'
printf '%s\n' loaded > "$TEST_EXT_MARKER"
EOT

tested=0

if bash_path=$(command -v bash 2>/dev/null)
then
    tested=$((tested + 1))
    home=$tmp/home-bash
    mkdir "$home" || error 'cannot create Bash HOME'
    profile_marker=$tmp/bash.profile
    rc_marker=$tmp/bash.rc
    ext_marker=$tmp/bash.ext

    cat > "$home/.bash_profile" <<'EOT'
printf '%s\n' loaded > "$TEST_LOGIN_PROFILE_MARKER"
EOT
    cat > "$home/.bashrc" <<'EOT'
printf '%s\n' loaded > "$TEST_LOGIN_RC_MARKER"
EOT

    (
        HOME=$home
        SHELL=$bash_path
        m_SHELL_EXT=$ext
        TEST_LOGIN_PROFILE_MARKER=$profile_marker
        TEST_LOGIN_RC_MARKER=$rc_marker
        TEST_EXT_MARKER=$ext_marker
        TERM=dumb
        export HOME SHELL m_SHELL_EXT TEST_LOGIN_PROFILE_MARKER TEST_LOGIN_RC_MARKER TEST_EXT_MARKER TERM

        "$source_root/rumiai-os" "$command_file" -l -i -c 'exit 0'
    ) >"$tmp/bash.out" 2>"$tmp/bash.err"
    status=$?

    [ "$status" -eq 0 ] || { cat "$tmp/bash.err" >&2; fail "Bash login startup returned $status"; }
    [ -e "$profile_marker" ] || fail 'Bash login did not execute the native login profile'
    [ ! -e "$rc_marker" ] || fail 'Bash login unexpectedly forced the non-login bashrc'
    [ ! -e "$ext_marker" ] || fail 'Bash login unexpectedly forced m_SHELL_EXT'
fi

if zsh_path=$(command -v zsh 2>/dev/null)
then
    tested=$((tested + 1))
    home=$tmp/home-zsh
    mkdir "$home" || error 'cannot create Zsh HOME'
    profile_marker=$tmp/zsh.profile
    rc_marker=$tmp/zsh.rc
    ext_marker=$tmp/zsh.ext

    cat > "$home/.zprofile" <<'EOT'
printf '%s\n' loaded > "$TEST_LOGIN_PROFILE_MARKER"
EOT
    cat > "$home/.zshrc" <<'EOT'
printf '%s\n' loaded > "$TEST_LOGIN_RC_MARKER"
EOT

    (
        unset ZDOTDIR
        HOME=$home
        SHELL=$zsh_path
        m_SHELL_EXT=$ext
        TEST_LOGIN_PROFILE_MARKER=$profile_marker
        TEST_LOGIN_RC_MARKER=$rc_marker
        TEST_EXT_MARKER=$ext_marker
        TERM=dumb
        export HOME SHELL m_SHELL_EXT TEST_LOGIN_PROFILE_MARKER TEST_LOGIN_RC_MARKER TEST_EXT_MARKER TERM

        "$source_root/rumiai-os" "$command_file" -l -i -c 'exit 0'
    ) >"$tmp/zsh.out" 2>"$tmp/zsh.err"
    status=$?

    [ "$status" -eq 0 ] || { cat "$tmp/zsh.err" >&2; fail "Zsh login startup returned $status"; }
    [ -e "$profile_marker" ] || fail 'Zsh login did not execute the native zprofile'
    [ -e "$rc_marker" ] || fail 'Zsh login did not continue through the native interactive zshrc'
    [ ! -e "$ext_marker" ] || fail 'Zsh login unexpectedly forced m_SHELL_EXT'
fi

[ "$tested" -gt 0 ] || skip 'neither Bash nor Zsh is available on this host'
exit 0
