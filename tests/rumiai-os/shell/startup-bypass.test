#!/bin/sh

TEST_ID=rumiai-os/shell/startup-bypass.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'; [ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'
tmp="${TMPDIR:-/tmp}/rumiai-shell-startup-bypass-$$"; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM

ext="$tmp/ext"
cat > "$ext" <<'EOT'
printf '%s\n' loaded > "$TEST_EXT_MARKER"
EOT

tested=0
if bash_path="$(command -v bash 2>/dev/null)"
then
  tested=$((tested + 1)); home="$tmp/home-bash"; mkdir "$home" || error 'cannot create Bash HOME'; rc_marker="$tmp/bash.rc"; ext_marker="$tmp/bash.ext"
  cat > "$home/.bashrc" <<'EOT'
printf '%s\n' loaded > "$TEST_NATIVE_MARKER"
EOT
  (
    HOME="$home"; SHELL="$bash_path"; m_SHELL_EXT="$ext"; TEST_NATIVE_MARKER="$rc_marker"; TEST_EXT_MARKER="$ext_marker"; TERM=dumb
    export HOME SHELL m_SHELL_EXT TEST_NATIVE_MARKER TEST_EXT_MARKER TERM
    "$root/m" "$root/bin/sys/shell" --norc -i -c 'exit 0'
  ) >"$tmp/bash.out" 2>"$tmp/bash.err"
  status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/bash.err" >&2; fail "Bash --norc returned $status"; }
  [ ! -e "$rc_marker" ] || fail 'Bash --norc did not suppress native bashrc startup'
  [ ! -e "$ext_marker" ] || fail 'Bash --norc was counteracted by m startup'
fi
if zsh_path="$(command -v zsh 2>/dev/null)"
then
  tested=$((tested + 1)); home="$tmp/home-zsh"; mkdir "$home" || error 'cannot create Zsh HOME'; rc_marker="$tmp/zsh.rc"; ext_marker="$tmp/zsh.ext"
  cat > "$home/.zshrc" <<'EOT'
printf '%s\n' loaded > "$TEST_NATIVE_MARKER"
EOT
  (
    unset ZDOTDIR
    HOME="$home"; SHELL="$zsh_path"; m_SHELL_EXT="$ext"; TEST_NATIVE_MARKER="$rc_marker"; TEST_EXT_MARKER="$ext_marker"; TERM=dumb
    export HOME SHELL m_SHELL_EXT TEST_NATIVE_MARKER TEST_EXT_MARKER TERM
    "$root/m" "$root/bin/sys/shell" -f -i -c 'exit 0'
  ) >"$tmp/zsh.out" 2>"$tmp/zsh.err"
  status="$?"; [ "$status" -eq 0 ] || { cat "$tmp/zsh.err" >&2; fail "Zsh -f returned $status"; }
  [ ! -e "$rc_marker" ] || fail 'Zsh -f did not suppress native zshrc startup'
  [ ! -e "$ext_marker" ] || fail 'Zsh -f was counteracted by m startup'
fi
[ "$tested" -gt 0 ] || skip 'neither Bash nor Zsh is available on this host'
exit 0
