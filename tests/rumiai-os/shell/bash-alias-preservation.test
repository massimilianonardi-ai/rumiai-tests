#!/bin/sh

TEST_ID=rumiai-os/shell/bash-alias-preservation.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) :;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
shell_group=${test_dir%/*}
rumiai_os_group=${shell_group%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case "$status" in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm target runtime is not executable'
[ -x "$root/bin/sys/shell" ] || fail 'shell target command is not executable'

tmp="${TMPDIR:-/tmp}/rumiai-shell-bash-alias-preservation-$$"
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

bash_path="$(command -v bash 2>/dev/null)" || skip 'Bash is unavailable on this host'
[ -n "${HOME-}" ] || skip 'HOME is unavailable in the supplied environment'
[ -d "$HOME" ] && [ ! -L "$HOME" ] && [ -w "$HOME" ] ||
  skip 'HOME is not a writable real directory in the supplied environment'

bashrc=$HOME/.bashrc
[ ! -e "$bashrc" ] && [ ! -L "$bashrc" ] ||
  skip 'HOME already contains .bashrc; refusing to replace user startup configuration'

cat > "$bashrc" <<'EOT'
shopt -s expand_aliases
alias log='false'
alias printf='false'
alias sentinel='false'
EOT
trap 'rm -f "$bashrc" 2>/dev/null || :; rm -rf "$tmp"' 0 HUP INT TERM

ext="$tmp/ext"
cat > "$ext" <<'EOT'
TEST_SHELL_EXT_LOADED=loaded
export TEST_SHELL_EXT_LOADED
EOT
(
  SHELL="$bash_path"
  m_SHELL_EXT="$ext"
  TERM=dumb
  export SHELL m_SHELL_EXT TERM
  "$root/m" "$root/bin/sys/shell" -i -c '
    shopt -q expand_aliases || exit 41
    alias log >/dev/null 2>&1 || exit 42
    alias printf >/dev/null 2>&1 || exit 43
    alias sentinel >/dev/null 2>&1 || exit 44
    declare -F log >/dev/null 2>&1 || exit 45
    declare -F shell >/dev/null 2>&1 || exit 46
    [ "${TEST_SHELL_EXT_LOADED-}" = "loaded" ] || exit 47
    exit 0
  '
) >"$tmp/stdout" 2>"$tmp/stderr"
status="$?"
[ "$status" -eq 0 ] || { cat "$tmp/stderr" >&2; fail "Bash alias preservation returned $status"; }
exit 0
