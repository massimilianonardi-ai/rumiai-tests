#!/bin/sh

TEST_ID=rumiai-os/shell/argument-forwarding.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|\
    git@github.com:massimilianonardi-ai/rumiai-os.git|\
    ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return 0
      ;;
  esac
  return 1
}

rumiai_test_target_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1
  rumiai_test_target_origin_ok "$candidate" || return 1

  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1

  printf '%s\n' "$target_root"
}

rumiai_test_target_find()
{
  start="$1"
  command -v git >/dev/null 2>&1 || return 3

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_validate "$candidate"
    then
      return 0
    fi

    [ "$candidate" != / ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done

  return 1
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

make_fixture()
{
  source_root="$1"
  fixture_root="$2"

  mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 1
  for fixture_file in m rumiai-os rumiai-os-sh product-name product-version
  do
    cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || return 1
  done
  for fixture_dir in bin lib res state
  do
    cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || return 1
  done
  chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || return 1
}

test_dir="$(resolve_test_dir)" || error 'cannot resolve test directory'
group="${test_dir%/*}"
rumiai_os_group="${group%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

source_root="$(rumiai_test_target_find "$suite_root")"
status="$?"
case "$status" in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -x "$source_root/m" ] || fail 'm target runtime is not executable'
[ -x "$source_root/bin/sys/shell" ] || fail 'shell target command is not executable'

tmp="${TMPDIR:-/tmp}/rumiai-shell-forwarding-$$"
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

fixture_root="$tmp/rumiai-os"
make_fixture "$source_root" "$fixture_root" || error 'cannot materialize isolated rumiai-os fixture'
ext_marker="$tmp/ext.loaded"
ext="$tmp/ext"
cat > "$ext" <<'EOT'
printf '%s\n' loaded > "$TEST_EXT_MARKER"
EOT

fake="$tmp/unsupported-shell"
cat > "$fake" <<'EOT'
#!/bin/sh
{
  printf '%s\n' "$#"
  while [ "$#" -gt 0 ]
  do
    printf '%s\n' "$1"
    shift
  done
} > "$TEST_RECORD"
exit 0
EOT
chmod 700 "$fake" || error 'cannot make unsupported shell executable'

TEST_RECORD="$tmp/args.record"
TEST_EXT_MARKER="$ext_marker"
SHELL="$fake"
m_SHELL_EXT="$ext"
TERM=dumb
export TEST_RECORD TEST_EXT_MARKER SHELL m_SHELL_EXT TERM

"$fixture_root/m" "$fixture_root/bin/sys/shell" \
  'alpha' \
  'two words' \
  '' \
  '-x' \
  '--' \
  '*' \
  'a=b' \
  >"$tmp/stdout" 2>"$tmp/stderr"
status="$?"

[ "$status" -eq 0 ] || { cat "$tmp/stderr" >&2; fail "unsupported shell returned $status"; }
[ ! -e "$ext_marker" ] || fail 'unsupported shell unexpectedly loaded m_SHELL_EXT'

cat > "$tmp/expected" <<'EOT'
7
alpha
two words

-x
--
*
a=b
EOT

cmp "$tmp/expected" "$TEST_RECORD" >/dev/null 2>&1 || {
  cat "$TEST_RECORD" >&2
  fail 'shell arguments were not forwarded exactly'
}

exit 0
