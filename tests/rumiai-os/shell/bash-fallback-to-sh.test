#!/bin/sh

TEST_ID=rumiai-os/shell/bash-fallback-to-sh.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@5af68cbff09ce979df3dff91e398e287eadd48b7:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok() { candidate=$1; origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_rumiai_os_validate() { candidate=$1; [ -n "$candidate" ] || return 1; [ -f "$candidate/rumiai-os" ] || return 1; rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1; target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1; [ -f "$target_root/rumiai-os" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_rumiai_os_find() { start=$1; rumiai_test_target_have git || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3; while :; do if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate=$parent; done; return 1; }

# Isolated root primitive copied from:
# massimilianonardi-ai/rumiai-tests@251ec2bde45a197590ec7dc23b8b41e60a79543f:lib/rumiai-os-fixture.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_fixture_rumiai_os_create() { [ "$#" -eq 2 ] || return 3; source_root=$1; fixture_root=$2; [ -n "$source_root" ] || return 3; [ -n "$fixture_root" ] || return 3; [ -f "$source_root/rumiai-os" ] || return 1; [ -d "$source_root/bin" ] || return 1; [ -d "$source_root/lib" ] || return 1; [ -d "$source_root/lang" ] || return 1; [ ! -e "$fixture_root" ] || return 2; mkdir -p "$fixture_root/conf/bootstrap" || return 2; cp "$source_root/rumiai-os" "$fixture_root/rumiai-os" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/bin" "$fixture_root/bin" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/lib" "$fixture_root/lib" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/lang" "$fixture_root/lang" || { rm -rf "$fixture_root"; return 2; }; chmod u+x "$fixture_root/rumiai-os" || { rm -rf "$fixture_root"; return 2; }; return 0; }

resolve_test_dir() { self=$0; case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac; self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group=${test_dir%/*}; rumiai_os_group=${group%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
source_root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac

tmp=${TMPDIR:-/tmp}/rumiai-shell-bash-fallback-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture=$tmp/root
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"; status=$?
case $status in 0) : ;; 1) fail 'source checkout lacks required runtime material' ;; 2) error 'cannot materialize isolated fixture' ;; *) error "fixture primitive returned unexpected status $status" ;; esac
fixture=$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P) || error 'cannot canonicalize fixture root'
mkdir -p "$fixture/conf/shell" || error 'cannot create shell configuration directory'
printf '%s\n' bash > "$fixture/conf/shell/default" || error 'cannot write shell default'

# This test owns only the bash-unavailable -> sh fallback contract.  Real PTY/prompt
# behavior of the selected sh is covered independently by sh-selection.test.
RUMIAI_TEST_FALLBACK_PATH=$fixture/bin
export RUMIAI_TEST_FALLBACK_PATH

if /bin/sh -c 'PATH=$RUMIAI_TEST_FALLBACK_PATH; export PATH; command -v -- bash >/dev/null 2>&1'
then
    fail 'test precondition failed: bash is resolvable in controlled PATH'
fi

wrapper=$tmp/run
cat > "$wrapper" <<'EOT'
#!/bin/sh
LC_ALL=C
RumiAI_LOG_LEVEL=info
PATH=$RUMIAI_TEST_FALLBACK_PATH
export LC_ALL RumiAI_LOG_LEVEL PATH

if command -v -- bash >/dev/null 2>&1
then
    printf '%s\n' 'RUMIAI_TEST_BASH_STILL_VISIBLE' >&2
    exit 97
fi

exec "$RUMIAI_TEST_FIXTURE/rumiai-os"
EOT
chmod 700 "$wrapper" || error 'cannot make wrapper executable'
RUMIAI_TEST_FIXTURE=$fixture
export RUMIAI_TEST_FIXTURE

printf '%s\n' 'exit 0' | "$wrapper" >"$tmp/stdout" 2>"$tmp/stderr"
status=$?
[ "$status" -eq 0 ] || { cat "$tmp/stderr" >&2; fail "bash-to-sh fallback returned $status"; }

text=$(cat "$tmp/stderr") || error 'cannot read fallback diagnostics'
case $text in *'[warn] [shell.fallback]'*) : ;; *) cat "$tmp/stderr" >&2; fail 'bash-to-sh fallback warning event is missing' ;; esac
case $text in *'[requested="bash"]'*) : ;; *) cat "$tmp/stderr" >&2; fail 'fallback warning lacks requested bash field' ;; esac
case $text in *'[selected="sh"]'*) : ;; *) cat "$tmp/stderr" >&2; fail 'fallback warning lacks selected sh field' ;; esac
case $text in *'RUMIAI_TEST_BASH_STILL_VISIBLE'*) cat "$tmp/stderr" >&2; fail 'bash unexpectedly became visible in wrapper' ;; *) : ;; esac

exit 0
