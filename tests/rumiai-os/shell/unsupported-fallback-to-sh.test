#!/bin/sh

TEST_ID=rumiai-os/shell/unsupported-fallback-to-sh.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@5af68cbff09ce979df3dff91e398e287eadd48b7:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok() { candidate=$1; origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;; esac; return 1; }
rumiai_test_target_rumiai_os_validate() { candidate=$1; [ -n "$candidate" ] || return 1; [ -f "$candidate/rumiai-os" ] || return 1; rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1; target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1; [ -f "$target_root/rumiai-os" ] || return 1; printf '%s\n' "$target_root"; }
rumiai_test_target_rumiai_os_find() { start=$1; rumiai_test_target_have git || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi; candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3; while :; do if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break; candidate=$parent; done; return 1; }

# Isolated root primitive copied from:
# massimilianonardi-ai/rumiai-tests@251ec2bde45a197590ec7dc23b8b41e60a79543f:lib/rumiai-os-fixture.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_fixture_rumiai_os_create() { [ "$#" -eq 2 ] || return 3; source_root=$1; fixture_root=$2; [ -n "$source_root" ] || return 3; [ -n "$fixture_root" ] || return 3; [ -f "$source_root/rumiai-os" ] || return 1; [ -d "$source_root/bin" ] || return 1; [ -d "$source_root/lib" ] || return 1; [ -d "$source_root/lang" ] || return 1; [ ! -e "$fixture_root" ] || return 2; mkdir -p "$fixture_root/conf/bootstrap" || return 2; cp "$source_root/rumiai-os" "$fixture_root/rumiai-os" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/bin" "$fixture_root/bin" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/lib" "$fixture_root/lib" || { rm -rf "$fixture_root"; return 2; }; cp -R "$source_root/lang" "$fixture_root/lang" || { rm -rf "$fixture_root"; return 2; }; chmod u+x "$fixture_root/rumiai-os" || { rm -rf "$fixture_root"; return 2; }; return 0; }

# Interactive primitive copied from:
# massimilianonardi-ai/rumiai-tests@7eed87d7cba441d248ae68de82762b73b2320f77:lib/interactive.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_interactive_have() {
    command -v "$1" >/dev/null 2>&1
}

rumiai_test_interactive_system() {
    uname -s 2>/dev/null
}

rumiai_test_interactive_require() {
    rumiai_test_interactive_have uname || return 3

    RUMIAI_TEST_INTERACTIVE_SYSTEM=$(rumiai_test_interactive_system) || return 3
    export RUMIAI_TEST_INTERACTIVE_SYSTEM

    case $RUMIAI_TEST_INTERACTIVE_SYSTEM in
        Darwin)
            rumiai_test_interactive_have expect || return 2
            ;;
        Linux)
            rumiai_test_interactive_have script || return 2
            rumiai_test_interactive_have grep || return 2
            ;;
        *)
            return 2
            ;;
    esac

    return 0
}

rumiai_test_interactive_make_linux_input() {
    dialogue=$1
    input=$2
    tab=$(printf '\tX')
    tab=${tab%X}

    : > "$input" || return 1
    while IFS="$tab" read -r prompt response extra; do
        [ -z "$extra" ] || return 1
        printf '%s\n' "$response" >> "$input" || return 1
    done < "$dialogue"
}

rumiai_test_interactive_verify_linux_prompts() {
    dialogue=$1
    output=$2
    tab=$(printf '\tX')
    tab=${tab%X}

    while IFS="$tab" read -r prompt response extra; do
        [ -z "$extra" ] || return 1
        grep -F -- "$prompt" "$output" >/dev/null 2>&1 || return 1
    done < "$dialogue"
}

rumiai_test_interactive_run_darwin() {
    dialogue=$1
    output=$2
    command=$3
    driver=${output}.expect

    cat > "$driver" <<'EOT'
set timeout 180
log_user 1
spawn $env(RUMIAI_TEST_INTERACTIVE_COMMAND)
set fh [open $env(RUMIAI_TEST_INTERACTIVE_DIALOGUE) r]
while {[gets $fh line] >= 0} {
    set tab [string first "\t" $line]
    if {$tab < 0} {
        puts stderr "invalid dialogue record: missing TAB"
        close $fh
        exit 2
    }
    set prompt [string range $line 0 [expr {$tab - 1}]]
    set response [string range $line [expr {$tab + 1}] end]
    set outcome none
    expect -timeout 180 \
        -ex "$prompt" {set outcome matched} \
        timeout {set outcome timeout} \
        eof {set outcome eof}
    if {$outcome ne "matched"} {
        puts stderr "$outcome waiting for prompt: $prompt"
        close $fh
        if {$outcome eq "timeout"} {
            exit 124
        }
        exit 125
    }
    send -- "$response\r"
}
close $fh
expect eof
EOT

    RUMIAI_TEST_INTERACTIVE_DIALOGUE=$dialogue \
    RUMIAI_TEST_INTERACTIVE_COMMAND=$command \
    export RUMIAI_TEST_INTERACTIVE_DIALOGUE RUMIAI_TEST_INTERACTIVE_COMMAND

    expect -f "$driver" > "$output" 2>&1
}

rumiai_test_interactive_run_linux() {
    dialogue=$1
    output=$2
    command=$3
    input=${output}.input

    rumiai_test_interactive_make_linux_input "$dialogue" "$input" || return 1
    script -q -c "$command" /dev/null < "$input" > "$output" 2>&1 || return 1
    rumiai_test_interactive_verify_linux_prompts "$dialogue" "$output"
}

rumiai_test_interactive_run() {
    dialogue=$1
    output=$2
    command=$3

    case ${RUMIAI_TEST_INTERACTIVE_SYSTEM:-} in
        Darwin)
            rumiai_test_interactive_run_darwin "$dialogue" "$output" "$command"
            ;;
        Linux)
            rumiai_test_interactive_run_linux "$dialogue" "$output" "$command"
            ;;
        *)
            return 2
            ;;
    esac
}

resolve_test_dir() { self=$0; case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac; self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P; }
test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group=${test_dir%/*}; rumiai_os_group=${group%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
source_root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac
rumiai_test_interactive_require; status=$?
case $status in 0) : ;; 2) skip 'interactive PTY driver is unavailable on this host' ;; *) error 'interactive PTY driver discovery failed' ;; esac

tmp=${TMPDIR:-/tmp}/rumiai-shell-unsupported-fallback-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture=$tmp/root
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"; status=$?
case $status in 0) : ;; 1) fail 'source checkout lacks required runtime material' ;; 2) error 'cannot materialize isolated fixture' ;; *) error "fixture primitive returned unexpected status $status" ;; esac
fixture=$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P) || error 'cannot canonicalize fixture root'
mkdir -p "$fixture/conf/shell" || error 'cannot create shell configuration directory'
printf '%s\n' zsh > "$fixture/conf/shell/default" || error 'cannot write shell default'

wrapper=$tmp/run
cat > "$wrapper" <<EOT
#!/bin/sh
LC_ALL=C
RumiAI_LOG_LEVEL=info
export LC_ALL RumiAI_LOG_LEVEL
exec "$fixture/rumiai-os"
EOT
chmod 700 "$wrapper" || error 'cannot make wrapper executable'
dialogue=$tmp/dialogue
printf '[RumiAI] $ \texit 0\n' > "$dialogue" || error 'cannot write dialogue'
output=$tmp/session
rumiai_test_interactive_run "$dialogue" "$output" "$wrapper" || { cat "$output" >&2; fail 'interactive unsupported-shell fallback failed'; }
text=$(cat "$output") || error 'cannot read interactive transcript'
case $text in *'[RumiAI] $ '*) : ;; *) cat "$output" >&2; fail 'unsupported-shell fallback sh prompt was not observed' ;; esac
case $text in *'[warn] [shell.unsupported]'*) : ;; *) cat "$output" >&2; fail 'unsupported-shell warning event is missing' ;; esac
case $text in *'[requested="zsh"]'*) : ;; *) cat "$output" >&2; fail 'unsupported-shell warning lacks requested field' ;; esac
case $text in *'[selected="sh"]'*) : ;; *) cat "$output" >&2; fail 'unsupported-shell warning lacks selected sh field' ;; esac
exit 0
