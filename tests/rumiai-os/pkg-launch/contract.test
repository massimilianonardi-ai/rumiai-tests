#!/bin/sh

TEST_ID=rumiai-os/pkg-launch/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${package_state_root-}" ]
  then
    rm -rf "$package_state_root" 2>/dev/null || :
  fi

  if [ -n "${root-}" ] && [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :

    if [ -d "$root/pkg/$package@1" ] && [ ! -L "$root/pkg/$package@1" ]
    then
      if [ -n "${integration_driver-}" ] && [ -f "$integration_driver" ]
      then
        "$root/m" "$integration_driver" deintegrate "$package" 1 >/dev/null 2>&1 || :
      fi
      rm -rf "$root/pkg/$package@1" 2>/dev/null || :
    fi

    rm -f "$root/pkg/$package" "$root/bin/ext/$package" 2>/dev/null || :

    if [ "${bin_ext_created-0}" -eq 1 ]
    then
      rmdir "$root/bin/ext" 2>/dev/null || :
    fi
    if [ "${pkg_store_created-0}" -eq 1 ]
    then
      rmdir "$root/pkg" 2>/dev/null || :
    fi
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg-launch.lib.sh" ] || fail 'pkg-launch library is missing'
[ -f "$root/lib/sys/sh/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-launch-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=pltest$$
pkg_store_created=0
bin_ext_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store for test'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is not a real directory'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

[ ! -e "$root/pkg/$package@1" ] && [ ! -L "$root/pkg/$package@1" ] ||
  error "temporary package identity already exists: $package@1"
[ ! -e "$root/pkg/$package" ] && [ ! -L "$root/pkg/$package" ] ||
  error "temporary package selector already exists: $package"

launcher_driver=$tmp/launcher-driver
cat > "$launcher_driver" <<'EOF_LAUNCHER_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-launch.lib.sh" || exit 3
launcher "$@"
EOF_LAUNCHER_DRIVER
chmod 600 "$launcher_driver" || error 'cannot prepare launcher driver'

"$root/m" "$launcher_driver" > "$tmp/arity.out" 2> "$tmp/arity.err"
[ "$?" -eq 2 ] || fail 'launcher without package did not return 2'
"$root/m" "$launcher_driver" 'Bad!' > "$tmp/name.out" 2> "$tmp/name.err"
[ "$?" -eq 2 ] || fail 'launcher accepted an invalid package name'

integration_driver=$tmp/integration-driver
cat > "$integration_driver" <<'EOF_INTEGRATION_DRIVER'
. "$m_LIB_DIR/sys/sh/osarch.lib.sh" || exit 3
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh" || exit 3
action=$1
shift
case $action in
  integrate) pkg_integrate "$@";;
  deintegrate) pkg_deintegrate "$@";;
  *) return 2;;
esac
EOF_INTEGRATION_DRIVER
chmod 600 "$integration_driver" || error 'cannot prepare integration driver'

range=$tmp/range
payload=$tmp/payload
mkdir -p "$range/cmd" "$range/link" "$payload/bin" || error 'cannot create package fixture'

cat > "$range/cmd/$package" <<EOF_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_COMMAND
chmod 600 "$range/cmd/$package" || error 'cannot prepare package command source'
printf '%s\n' bin/upstream > "$range/link/$package" || error 'cannot prepare package link source'

cat > "$range/env" <<'EOF_PACKAGE_ENV'
PKG_ENV=package
export PKG_ENV
ORDER=package
UNEXPORTED=hidden
EOF_PACKAGE_ENV
chmod 600 "$range/env" || error 'cannot prepare package environment'

cat > "$payload/bin/upstream" <<'EOF_UPSTREAM'
#!/bin/sh
: > "$TEST_MARKER"
printf 'home=%s\n' "$HOME"
printf 'package=%s\n' "${PKG_ENV-unset}"
printf 'user=%s\n' "${USER_ENV-unset}"
printf 'unexported=%s\n' "${UNEXPORTED-unset}"
printf 'arg1=%s\n' "$1"
printf 'arg2=%s\n' "$2"
exit 37
EOF_UPSTREAM
chmod 700 "$payload/bin/upstream" || error 'cannot prepare upstream executable'

"$root/m" "$integration_driver" integrate "$package" 1 "$range" "$payload"   > "$tmp/integrate.out" 2> "$tmp/integrate.err" || {
    cat "$tmp/integrate.err" >&2
    fail 'pkg_integrate failed while preparing launcher scenario'
  }

run_pkg default "$package@1" > "$tmp/default.out" 2> "$tmp/default.err" || {
  cat "$tmp/default.err" >&2
  fail 'cannot select launcher test package as default'
}

user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" conf) ||
  error 'cannot resolve package configuration state'
user_home=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" home) ||
  error 'cannot resolve package HOME state'
package_state_root=${user_conf%/conf}

mkdir -p "$user_conf/.m" || error 'cannot create package user configuration'
cat > "$user_conf/.m/env" <<'EOF_USER_ENV'
USER_ENV="$ORDER-user"
export USER_ENV
EOF_USER_ENV

TEST_MARKER=$tmp/upstream-ran
export TEST_MARKER
output=$tmp/output

(
  unset PKG_ENV USER_ENV ORDER UNEXPORTED
  PATH="$root/bin/ext:$root/bin/sys:$PATH"
  export PATH
  "$package" 'a b' '--literal'
) > "$output" 2> "$tmp/run.err"
status=$?
[ "$status" -eq 37 ] || {
  cat "$tmp/run.err" >&2
  fail "launcher did not propagate upstream status 37: $status"
}

[ -f "$TEST_MARKER" ] || fail 'launcher did not execute the integrated upstream target'
grep -Fx "home=$user_home" "$output" >/dev/null 2>&1 || fail 'launcher did not use state-path package HOME'
grep -Fx 'package=package' "$output" >/dev/null 2>&1 || fail 'package environment was not applied'
grep -Fx 'user=package-user' "$output" >/dev/null 2>&1 || fail 'user environment was not applied after package environment'
grep -Fx 'unexported=unset' "$output" >/dev/null 2>&1 || fail 'launcher exported an unexported package variable'
grep -Fx 'arg1=a b' "$output" >/dev/null 2>&1 || fail 'launcher did not preserve first argument'
grep -Fx 'arg2=--literal' "$output" >/dev/null 2>&1 || fail 'launcher did not preserve second argument'
[ -d "$user_home" ] && [ ! -L "$user_home" ] || fail 'launcher did not materialize package HOME'

exit 0
