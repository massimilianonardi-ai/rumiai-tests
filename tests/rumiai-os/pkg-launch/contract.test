#!/bin/sh

TEST_ID=rumiai-os/pkg-launch/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
origin_ok() { origin=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1; case $origin in https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;; esac; return 1; }
validate_root() { [ -f "$1/m" ] && [ -f "$1/rumiai-os" ] && [ -f "$1/rumiai-os-sh" ] && origin_ok "$1"; }
find_root() { start=$1; command -v git >/dev/null 2>&1 || return 3; if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then validate_root "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; (CDPATH= cd -- "$RUMIAI_TEST_RUMIAI_OS_ROOT" && pwd -P); return; fi; candidate=$(CDPATH= cd -- "$start" && pwd -P) || return 3; while :; do if validate_root "$candidate"; then printf '%s\n' "$candidate"; return 0; fi; [ "$candidate" != / ] || break; parent=${candidate%/*}; [ -n "$parent" ] || parent=/; candidate=$parent; done; return 1; }
resolve_test_dir() { self=$0; case $self in */*) :;; *) self=$(command -v "$self") || return 1;; esac; dir=${self%/*}; [ "$dir" != "$self" ] || dir=.; CDPATH= cd -- "$dir" && pwd -P; }
readpathce() { [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || return 1; case "$1" in ""|[0-9]*|*[!a-zA-Z0-9_]*) return 2;; esac; resolved=$(realpath -- "$2" 2>/dev/null) || return 1; [ -e "$resolved" ] || return 1; eval "$1=\$resolved"; }
log() { :; }

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'; start=${test_dir%/*}; start=${start%/*}; start=${start%/*}; start=${start%/*}
root=$(find_root "$start"); status=$?; case $status in 0) :;; 1) skip 'rumiai-os target checkout not found';; 2) fail 'invalid explicit rumiai-os target';; *) error 'target discovery failed';; esac
library=$root/lib/sys/sh/pkg-launch.lib.sh
core=$root/lib/sys/sh/core.lib.sh
bootstrap=$root/m
[ -f "$library" ] && [ ! -x "$library" ] || fail 'pkg-launch library is missing or executable'
case "$(sed -n '1p' "$library")" in '#!'*) fail 'pkg-launch library has a shebang';; esac
grep -E '^[[:space:]]*launcher\(\)' "$core" >/dev/null 2>&1 && fail 'launcher is still defined in core.lib.sh'
grep -F 'pkg-launch.lib.sh' "$bootstrap" >/dev/null 2>&1 && fail 'm bootstrap loads pkg-launch globally'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-launch-contract-$$; umask 077; mkdir "$tmp" || error 'cannot create temporary directory'; trap 'rm -rf "$tmp"' 0 HUP INT TERM
m_ROOT=$tmp/root
m_PKG_DIR=$m_ROOT/pkg
m_STATE_DIR=$m_ROOT/state
m_STATE_SYS_DIR=$m_STATE_DIR/system/current
m_STATE_USER_DIR=$m_STATE_DIR/user/current
mkdir -p "$m_PKG_DIR" "$m_STATE_DIR/system/profile/main" "$m_STATE_DIR/user/default" || error 'cannot create fixture root'
ln -s profile/main "$m_STATE_SYS_DIR" || error 'cannot create system selector'
export m_ROOT m_PKG_DIR m_STATE_DIR m_STATE_SYS_DIR m_STATE_USER_DIR
fake_bin=$tmp/bin; mkdir "$fake_bin" || error 'cannot create fixture bin'
{ printf '%s\n' '#!/bin/sh'; sed '1d' "$root/bin/sys/state-path"; } > "$fake_bin/state-path" || error 'cannot prepare state-path fixture'
chmod 700 "$fake_bin/state-path" || error 'cannot chmod state-path fixture'
PATH=$fake_bin:$PATH; export PATH
. "$library" || error 'cannot source pkg-launch library'

if (launcher >/dev/null 2>&1); then fail 'launcher without package unexpectedly succeeded'; else status=$?; [ "$status" -eq 2 ] || fail "launcher without package returned $status instead of 2"; fi
if (launcher 'Bad!' >/dev/null 2>&1); then fail 'launcher accepted invalid package name'; else status=$?; [ "$status" -eq 2 ] || fail "invalid package name returned $status instead of 2"; fi

concrete=$m_PKG_DIR/tool@1
mkdir -p "$concrete/cmd" "$concrete/link" "$concrete/root/bin" || error 'cannot create launch fixture'
command_file=$concrete/cmd/tool
printf '%s\n' '#!/usr/bin/env m' > "$command_file" || error 'cannot create command fixture'; chmod 700 "$command_file" || error 'cannot chmod command fixture'
target=$concrete/root/bin/upstream
cat > "$target" <<'EOF_TARGET'
#!/bin/sh
: > "$TEST_MARKER"
printf 'home=%s\n' "$HOME"
printf 'package=%s\n' "${PKG_ENV-unset}"
printf 'user=%s\n' "${USER_ENV-unset}"
printf 'unexported=%s\n' "${UNEXPORTED-unset}"
printf 'arg1=%s\n' "$1"
printf 'arg2=%s\n' "$2"
exit 37
EOF_TARGET
chmod 700 "$target" || error 'cannot chmod upstream fixture'; ln -s '../root/bin/upstream' "$concrete/link/tool" || error 'cannot create direct link'
cat > "$concrete/env" <<'EOF_PACKAGE_ENV'
PKG_ENV=package
export PKG_ENV
ORDER=package
UNEXPORTED=hidden
EOF_PACKAGE_ENV
user_conf=$m_STATE_DIR/user/default/pkg/tool/conf
user_home=$m_STATE_DIR/user/default/pkg/tool/home
mkdir -p "$user_conf/.m" || error 'cannot create user conf fixture'
cat > "$user_conf/.m/env" <<'EOF_USER_ENV'
USER_ENV="$ORDER-user"
export USER_ENV
EOF_USER_ENV
TEST_MARKER=$tmp/marker; export TEST_MARKER
output=$tmp/output
if (m_COMMAND_BIN=$command_file; export m_COMMAND_BIN; launcher tool 'a b' '--literal') >"$output" 2>"$tmp/stderr"; then fail 'upstream fixture unexpectedly returned zero'; else status=$?; [ "$status" -eq 37 ] || fail "upstream exit status $status was not propagated"; fi
[ -f "$TEST_MARKER" ] || fail 'direct-link upstream was not executed'
grep -Fx "home=$user_home" "$output" >/dev/null || fail 'HOME isolation is wrong'
grep -Fx 'package=package' "$output" >/dev/null || fail 'package env was not applied'
grep -Fx 'user=package-user' "$output" >/dev/null || fail 'user env did not run after package env'
grep -Fx 'unexported=unset' "$output" >/dev/null || fail 'launcher implicitly exported an unexported variable'
grep -Fx 'arg1=a b' "$output" >/dev/null || fail 'first argument was not preserved'
grep -Fx 'arg2=--literal' "$output" >/dev/null || fail 'second argument was not preserved'
[ -d "$user_home" ] && [ ! -L "$user_home" ] || fail 'launcher did not materialize package HOME'

rm -f "$TEST_MARKER"; printf '%s\n' 'if' > "$concrete/env"
if (m_COMMAND_BIN=$command_file; export m_COMMAND_BIN; launcher tool >/dev/null 2>&1); then fail 'launcher accepted invalid package env'; else [ "$?" -eq 1 ] || fail 'invalid package env did not return 1'; fi
[ ! -e "$TEST_MARKER" ] || fail 'upstream ran after invalid package env'

rm -f "$concrete/env" "$user_conf/.m/env" "$concrete/link/tool"
outside=$m_PKG_DIR/outside; printf '%s\n' '#!/bin/sh' 'exit 0' > "$outside"; chmod 700 "$outside"; ln -s '../../outside' "$concrete/link/tool"
if (m_COMMAND_BIN=$command_file; export m_COMMAND_BIN; launcher tool >/dev/null 2>&1); then fail 'launcher accepted direct-link escaping root'; else [ "$?" -eq 1 ] || fail 'escaping direct-link did not return 1'; fi
exit 0
