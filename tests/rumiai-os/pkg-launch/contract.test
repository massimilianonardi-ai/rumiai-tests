#!/bin/sh

TEST_ID="rumiai-os/pkg-launch/contract.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return 0
      ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

readpathce()
{
  [ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || return 1
  case "$1" in "" | [0-9]* | *[!a-zA-Z0-9_]*) return 2 ;; esac
  resolved="$(command -p -- realpath -- "$2" 2>/dev/null)" || return 1
  [ -e "$resolved" ] || return 1
  eval "$1=\$resolved"
}

log()
{
  :
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

library="$root/lib/sh/pkg-launch.lib.sh"
core="$root/lib/sh/core.lib.sh"
bootstrap="$root/rumiai-os"

[ -f "$library" ] || fail "pkg-launch.lib.sh is missing"
[ ! -x "$library" ] || fail "pkg-launch.lib.sh is executable"
IFS= read -r first_line < "$library" || fail "cannot read pkg-launch.lib.sh"
case "$first_line" in '#!'*) fail "pkg-launch.lib.sh has a shebang" ;; esac

if LC_ALL=C command -p -- grep -E '^[[:space:]]*launcher\(\)' "$core" >/dev/null 2>&1
then
  fail "launcher is still defined in core.lib.sh"
fi
if LC_ALL=C command -p -- grep -F 'pkg-launch.lib.sh' "$bootstrap" >/dev/null 2>&1
then
  fail "bootstrap loads pkg-launch.lib.sh globally"
fi

tmp="${TMPDIR:-/tmp}/rumiai-pkg-launch-contract-$$"
umask 077
command -p -- mkdir "$tmp" || error "cannot create temporary directory"
trap 'command -p -- rm -rf "$tmp"' 0 HUP INT TERM

m_ROOT="$tmp/root"
m_PKG_DIR="$m_ROOT/pkg"
m_HOME_DIR="$m_ROOT/home"
m_CONF_DIR="$m_ROOT/conf"
command -p -- mkdir -p "$m_PKG_DIR" "$m_HOME_DIR" "$m_CONF_DIR" || error "cannot create fixture root"
export m_ROOT m_PKG_DIR m_HOME_DIR m_CONF_DIR

. "$library" || error "cannot source pkg-launch.lib.sh"

if (launcher >/dev/null 2>&1)
then
  fail "launcher without package unexpectedly succeeded"
else
  status=$?
  [ "$status" -eq 2 ] || fail "launcher without package returned $status instead of 2"
fi

if (launcher 'Bad!' >/dev/null 2>&1)
then
  fail "launcher accepted invalid package name"
else
  status=$?
  [ "$status" -eq 2 ] || fail "invalid package name returned $status instead of 2"
fi

if (launcher -c >/dev/null 2>&1)
then
  fail "launcher -c without package unexpectedly succeeded"
else
  status=$?
  [ "$status" -eq 2 ] || fail "launcher -c without package returned $status instead of 2"
fi

if (launcher -c tool >/dev/null 2>&1)
then
  fail "launcher -c without explicit command unexpectedly succeeded"
else
  status=$?
  [ "$status" -eq 2 ] || fail "launcher -c without explicit command returned $status instead of 2"
fi

if (launcher -c tool relative-command >/dev/null 2>&1)
then
  fail "launcher -c accepted a relative explicit command"
else
  status=$?
  [ "$status" -eq 2 ] || fail "relative explicit command returned $status instead of 2"
fi

concrete="$m_PKG_DIR/tool@1"
command -p -- mkdir -p "$concrete/cmd" "$concrete/link" "$concrete/root/bin" "$m_CONF_DIR/tool" || error "cannot create launch fixture"

command_file="$concrete/cmd/tool"
printf -- '%s\n' '#!/usr/bin/env rumiai-os' > "$command_file" || error "cannot create command fixture"
command -p -- chmod 700 "$command_file" || error "cannot chmod command fixture"

target="$concrete/root/bin/upstream"
cat > "$target" <<'EOF_TARGET'
#!/bin/sh
: > "$TEST_MARKER"
printf -- 'home=%s\n' "$HOME"
printf -- 'package=%s\n' "${PKG_ENV-unset}"
printf -- 'user=%s\n' "${USER_ENV-unset}"
printf -- 'unexported=%s\n' "${UNEXPORTED-unset}"
printf -- 'arg1=%s\n' "$1"
printf -- 'arg2=%s\n' "$2"
exit 37
EOF_TARGET
command -p -- chmod 700 "$target" || error "cannot chmod upstream fixture"
command -p -- ln -s '../root/bin/upstream' "$concrete/link/tool" || error "cannot create direct-link fixture"

cat > "$concrete/env" <<'EOF_PACKAGE_ENV'
PKG_ENV=package
export PKG_ENV
ORDER=package
UNEXPORTED=hidden
EOF_PACKAGE_ENV
cat > "$m_CONF_DIR/tool/env" <<'EOF_USER_ENV'
USER_ENV="$ORDER-user"
export USER_ENV
EOF_USER_ENV

fake_bin="$tmp/fake-bin"
command -p -- mkdir "$fake_bin" || error "cannot create fake PATH directory"
cat > "$fake_bin/tool" <<'EOF_FAKE'
#!/bin/sh
printf -- '%s\n' wrong-target
exit 99
EOF_FAKE
command -p -- chmod 700 "$fake_bin/tool" || error "cannot chmod fake PATH target"

TEST_MARKER="$tmp/marker"
export TEST_MARKER
output="$tmp/output"
if (
  PATH="$fake_bin:$PATH"
  export PATH
  m_COMMAND_BIN="$command_file"
  export m_COMMAND_BIN
  launcher tool 'a b' '--literal'
  printf -- '%s\n' after-launcher
) > "$output" 2> "$tmp/stderr"
then
  fail "upstream fixture unexpectedly returned zero"
else
  status=$?
  [ "$status" -eq 37 ] || fail "upstream exit status $status was not propagated"
fi

[ -f "$TEST_MARKER" ] || fail "direct-link upstream was not executed"
expected_home="$m_HOME_DIR/tool"
LC_ALL=C command -p -- grep -Fx "home=$expected_home" "$output" >/dev/null || fail "HOME isolation is wrong"
LC_ALL=C command -p -- grep -Fx 'package=package' "$output" >/dev/null || fail "package env was not applied"
LC_ALL=C command -p -- grep -Fx 'user=package-user' "$output" >/dev/null || fail "user env did not run after package env"
LC_ALL=C command -p -- grep -Fx 'unexported=unset' "$output" >/dev/null || fail "launcher implicitly exported an unexported env variable"
LC_ALL=C command -p -- grep -Fx 'arg1=a b' "$output" >/dev/null || fail "first argument was not preserved"
LC_ALL=C command -p -- grep -Fx 'arg2=--literal' "$output" >/dev/null || fail "second argument was not preserved"
if LC_ALL=C command -p -- grep -Fx 'after-launcher' "$output" >/dev/null 2>&1
then
  fail "launcher returned after successful exec"
fi
if LC_ALL=C command -p -- grep -Fx 'wrong-target' "$output" >/dev/null 2>&1
then
  fail "launcher used PATH instead of package direct-link"
fi

if (
  m_COMMAND_BIN="$command_file"
  export m_COMMAND_BIN
  launcher -c tool "$tmp/does-not-exist" >/dev/null 2>&1
)
then
  fail "launcher -c accepted a missing absolute explicit command"
else
  status=$?
  [ "$status" -eq 1 ] || fail "missing absolute explicit command returned $status instead of 1"
fi

explicit_concrete="$m_PKG_DIR/composed@1"
command -p -- mkdir -p "$explicit_concrete/cmd" "$explicit_concrete/root" "$m_CONF_DIR/composed" "$tmp/explicit" || error "cannot create explicit-command fixture"
explicit_command_file="$explicit_concrete/cmd/composed"
printf -- '%s\n' '#!/usr/bin/env rumiai-os' > "$explicit_command_file" || error "cannot create explicit command entry"
command -p -- chmod 700 "$explicit_command_file" || error "cannot chmod explicit command entry"

explicit_target="$tmp/explicit/upstream"
cat > "$explicit_target" <<'EOF_EXPLICIT'
#!/bin/sh
: > "$TEST_EXPLICIT_MARKER"
printf -- 'home=%s\n' "$HOME"
printf -- 'package=%s\n' "${EXPLICIT_PACKAGE-unset}"
printf -- 'user=%s\n' "${EXPLICIT_USER-unset}"
printf -- 'unexported=%s\n' "${EXPLICIT_UNEXPORTED-unset}"
printf -- 'arg1=%s\n' "$1"
printf -- 'arg2=%s\n' "$2"
exit 41
EOF_EXPLICIT
command -p -- chmod 700 "$explicit_target" || error "cannot chmod explicit upstream"

cat > "$explicit_concrete/env" <<'EOF_EXPLICIT_PACKAGE_ENV'
EXPLICIT_PACKAGE=package
export EXPLICIT_PACKAGE
EXPLICIT_ORDER=package
EXPLICIT_UNEXPORTED=hidden
EOF_EXPLICIT_PACKAGE_ENV
cat > "$m_CONF_DIR/composed/env" <<'EOF_EXPLICIT_USER_ENV'
EXPLICIT_USER="$EXPLICIT_ORDER-user"
export EXPLICIT_USER
EOF_EXPLICIT_USER_ENV

[ ! -e "$explicit_concrete/link" ] && [ ! -L "$explicit_concrete/link" ] || error "explicit fixture unexpectedly has a link directory"
TEST_EXPLICIT_MARKER="$tmp/explicit-marker"
export TEST_EXPLICIT_MARKER
explicit_output="$tmp/explicit-output"
if (
  m_COMMAND_BIN="$explicit_command_file"
  export m_COMMAND_BIN
  launcher -c composed "$explicit_target" 'x y' '--explicit'
  printf -- '%s\n' after-explicit-launcher
) > "$explicit_output" 2> "$tmp/explicit-stderr"
then
  fail "explicit upstream fixture unexpectedly returned zero"
else
  status=$?
  [ "$status" -eq 41 ] || fail "explicit upstream exit status $status was not propagated"
fi

[ -f "$TEST_EXPLICIT_MARKER" ] || fail "explicit upstream was not executed"
expected_explicit_home="$m_HOME_DIR/composed"
LC_ALL=C command -p -- grep -Fx "home=$expected_explicit_home" "$explicit_output" >/dev/null || fail "explicit HOME isolation is wrong"
LC_ALL=C command -p -- grep -Fx 'package=package' "$explicit_output" >/dev/null || fail "explicit package env was not applied"
LC_ALL=C command -p -- grep -Fx 'user=package-user' "$explicit_output" >/dev/null || fail "explicit user env did not run after package env"
LC_ALL=C command -p -- grep -Fx 'unexported=unset' "$explicit_output" >/dev/null || fail "explicit launch implicitly exported an unexported env variable"
LC_ALL=C command -p -- grep -Fx 'arg1=x y' "$explicit_output" >/dev/null || fail "explicit first argument was not preserved"
LC_ALL=C command -p -- grep -Fx 'arg2=--explicit' "$explicit_output" >/dev/null || fail "explicit second argument was not preserved"
if LC_ALL=C command -p -- grep -Fx 'after-explicit-launcher' "$explicit_output" >/dev/null 2>&1
then
  fail "launcher returned after successful explicit exec"
fi

command -p -- rm -f "$TEST_MARKER" || error "cannot reset marker"
printf -- '%s\n' 'if' > "$concrete/env" || error "cannot create invalid package env"
if (
  m_COMMAND_BIN="$command_file"
  export m_COMMAND_BIN
  launcher tool >/dev/null 2>&1
)
then
  fail "launcher accepted syntactically invalid package env"
else
  status=$?
  [ "$status" -eq 1 ] || fail "invalid package env returned $status instead of 1"
fi
[ ! -e "$TEST_MARKER" ] || fail "upstream ran after invalid package env"

command -p -- rm -f "$concrete/env" "$m_CONF_DIR/tool/env" "$concrete/link/tool" || error "cannot reset fixture"
outside="$m_PKG_DIR/outside"
printf -- '%s\n' '#!/bin/sh' 'exit 0' > "$outside" || error "cannot create outside target"
command -p -- chmod 700 "$outside" || error "cannot chmod outside target"
command -p -- ln -s '../../outside' "$concrete/link/tool" || error "cannot create escaping direct-link"
if (
  m_COMMAND_BIN="$command_file"
  export m_COMMAND_BIN
  launcher tool >/dev/null 2>&1
)
then
  fail "launcher accepted direct-link escaping root"
else
  status=$?
  [ "$status" -eq 1 ] || fail "escaping direct-link returned $status instead of 1"
fi

outside_command_dir="$tmp/outside/cmd"
command -p -- mkdir -p "$outside_command_dir" || error "cannot create outside command directory"
outside_command="$outside_command_dir/tool"
printf -- '%s\n' '#!/usr/bin/env rumiai-os' > "$outside_command" || error "cannot create outside command"
command -p -- chmod 700 "$outside_command" || error "cannot chmod outside command"
if (
  m_COMMAND_BIN="$outside_command"
  export m_COMMAND_BIN
  launcher tool >/dev/null 2>&1
)
then
  fail "launcher accepted command outside package store"
else
  status=$?
  [ "$status" -eq 1 ] || fail "outside command returned $status instead of 1"
fi

exit 0
