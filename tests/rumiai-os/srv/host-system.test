#!/bin/sh

TEST_ID=rumiai-os/srv/host-system.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

pid_exists()
{
  seen=$(command -p -- ps -p "$1" -o pid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')
  [ "$seen" = "$1" ]
}

wait_pid_gone()
{
  wait_pid=$1
  wait_count=0
  while pid_exists "$wait_pid" && [ "$wait_count" -lt 15 ]
  do
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  ! pid_exists "$wait_pid"
}

wait_start()
{
  wait_version=$1
  wait_old_pid=${2-}
  wait_count=0
  while [ "$wait_count" -lt 20 ]
  do
    if [ -f "$marker" ]
    then
      wait_pid=$(command -p -- awk -v v="$wait_version" -v old="$wait_old_pid" '
        $1 == "start" && $2 == v && $3 != old { pid = $3 }
        END { if (pid != "") print pid }
      ' "$marker")
      case "$wait_pid" in
        ""|*[!0-9]*) : ;;
        *)
          if pid_exists "$wait_pid"
          then
            printf '%s\n' "$wait_pid"
            return 0
          fi
          ;;
      esac
    fi
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  return 1
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_srv()
{
  "$root/m" "$root/bin/sys/srv" "$@"
}

run_srv_system()
{
  "$sudo_bin" -n "$root/m" "$root/bin/sys/srv" host system "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${facility-}" ]
  then
    [ -z "${sudo_bin-}" ] || run_srv_system uninstall "$facility" >/dev/null 2>&1 || :
    run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  fi
  if [ -n "${dep_facility-}" ]
  then
    run_pkg provider default -u -- "$dep_facility" >/dev/null 2>&1 || :
  fi

  if [ -n "${package-}" ] && [ -n "${dep_facility-}" ]
  then
    run_pkg provider bind -u -- "$package" "$dep_facility" >/dev/null 2>&1 || :
  fi

  for cleanup_pkg in "${package-}" "${dep_package-}"
  do
    [ -n "$cleanup_pkg" ] || continue
    run_pkg default -u -- "$cleanup_pkg" >/dev/null 2>&1 || :
  done

  if [ -n "${driver-}" ] && [ -f "$driver" ]
  then
    for cleanup_spec in "${package-}@2" "${package-}@1" "${dep_package-}@1"
    do
      case "$cleanup_spec" in @*) continue ;; esac
      cleanup_pkg=${cleanup_spec%@*}
      cleanup_version=${cleanup_spec#*@}
      if [ -d "$root/pkg/$cleanup_spec" ] && [ ! -L "$root/pkg/$cleanup_spec" ]
      then
        "$root/m" "$driver" deintegrate "$cleanup_pkg" "$cleanup_version" >/dev/null 2>&1 || :
      fi
    done
  fi

  if [ -n "${sudo_bin-}" ]
  then
    [ -z "${service_state_identity-}" ] ||
      "$sudo_bin" -n "$rm_bin" -rf -- "$service_state_identity" 2>/dev/null || :
    [ -z "${system_srv_state-}" ] ||
      "$sudo_bin" -n "$rm_bin" -rf -- "$system_srv_state" 2>/dev/null || :
  fi
  [ -z "${package_system_identity-}" ] || command -p -- rm -rf -- "$package_system_identity" 2>/dev/null || :

  if [ "${pkg_store_created-0}" -eq 1 ]
  then
    command -p -- rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
test_script="$test_dir/${0##*/}"
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

current_uid=$(command -p -- id -u) || error 'cannot determine current uid'
case "$current_uid" in ""|*[!0-9]*) error 'invalid current uid' ;; esac
[ "$current_uid" -ne 0 ] || skip 'host-system test requires a non-root execution account'

service_account=$(command -p -- id -un) || error 'cannot determine service account'
sudo_bin=$(command -v sudo 2>/dev/null) || skip 'sudo unavailable for administrative host-system test'
"$sudo_bin" -n true >/dev/null 2>&1 || skip 'passwordless sudo unavailable for administrative host-system test'
service_uid=$current_uid

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/srv" ] || fail 'srv command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

[ "$(command -p -- id -u "$service_account" 2>/dev/null)" = "$service_uid" ] ||
  skip 'selected service account is unavailable'
host_os=$(command -p -- uname -s) || error 'cannot identify host OS'
case "$host_os" in
  Linux)
    command -v systemctl >/dev/null 2>&1 || skip 'systemctl unavailable'
    systemctl show-environment >/dev/null 2>&1 || skip 'systemd system manager unavailable'
    ;;
  Darwin)
    command -v launchctl >/dev/null 2>&1 || skip 'launchctl unavailable'
    command -v plutil >/dev/null 2>&1 || skip 'plutil unavailable'
    [ -d /Library/LaunchDaemons ] || skip 'LaunchDaemons directory unavailable'
    ;;
  *)
    skip "system host supervision is not implemented for $host_os"
    ;;
esac

command -v ps >/dev/null 2>&1 || error 'ps unavailable'
command -v awk >/dev/null 2>&1 || error 'awk unavailable'
cat_bin=$(command -p -v cat) || error 'cat unavailable'
rm_bin=$(command -p -v rm) || error 'rm unavailable'
tmp=${TMPDIR:-/tmp}/rumiai-srv-host-system-$$
umask 077
command -p -- mkdir "$tmp" || error 'cannot create temporary directory'

package=srvsysprovider$$
facility=srvsys$$
dep_package=srvsysdep$$
dep_facility=srvsysdep$$
service_command=$package-service-start
pkg_store_created=0
host_installed=0
service_state_identity=
package_system_identity=
system_srv_state=

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  ( umask 022; command -p -- mkdir "$root/pkg" ) || error 'cannot create package store'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is invalid'
command -p -- chmod 755 "$root/pkg" || error 'cannot make package store traversable for service account'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case "$action" in
  integrate)
    [ -f "$3/format" ] || printf '%s\n' tar.gz > "$3/format" || exit 3
    pkg_integrate "$@"
    ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

prepare_dependency_provider()
{
  dep_range=$tmp/range-dependency
  dep_payload=$tmp/payload-dependency
  command -p -- mkdir -p "$dep_range/facility-env" "$dep_payload" || return 1
  command -p -- chmod 755 "$dep_payload" || return 1
  printf '%s 1\n' "$dep_facility" > "$dep_range/facility" || return 1
  dep_tab=$(printf '\t')
  printf 'DEPENDENCY_MARKER%sliteral dependency-ok\n' "$dep_tab" > "$dep_range/facility-env/$dep_facility" || return 1

  ( umask 022; "$root/m" "$driver" integrate "$dep_package" 1 "$dep_range" "$dep_payload" )
}

prepare_service_provider()
{
  provider_version=$1
  provider_range=$tmp/range-$provider_version
  provider_payload=$tmp/payload-$provider_version

  command -p -- mkdir -p \
    "$provider_range/cmd" \
    "$provider_range/link" \
    "$provider_range/facility-service/$facility" \
    "$provider_payload/bin" || return 1
  command -p -- chmod 755 "$provider_payload" "$provider_payload/bin" || return 1

  printf '%s 1\n' "$facility" > "$provider_range/facility" || return 1
  printf '%s =1\n' "$dep_facility" > "$provider_range/dependency" || return 1
  cat > "$provider_range/cmd/$service_command" <<EOF_SERVICE_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_SERVICE_COMMAND
  printf '%s\n' bin/service-target > "$provider_range/link/$service_command" || return 1
  printf '%s\n' "$service_command" > "$provider_range/facility-service/$facility/start" || return 1

  {
    printf '%s\n' '#!/bin/sh'
    printf 'provider_version=%s\n' "$provider_version"
    cat <<'EOF_TARGET'
marker=$HOME/host-system-events
on_term()
{
  printf '%s\n' "term $provider_version $$" >> "$marker"
  exit 0
}
trap on_term TERM
trap 'exit 0' HUP INT
printf '%s\n' "start $provider_version $$ $(id -u) $HOME ${DEPENDENCY_MARKER-}" >> "$marker"
while :
do
  sleep 1
done
EOF_TARGET
  } > "$provider_payload/bin/service-target"
  chmod 755 "$provider_payload/bin/service-target" || return 1

  ( umask 022; "$root/m" "$driver" integrate "$package" "$provider_version" "$provider_range" "$provider_payload" )
}

prepare_dependency_provider > "$tmp/integrate-dep.out" 2> "$tmp/integrate-dep.err" || {
  command -p -- cat "$tmp/integrate-dep.err" >&2
  fail 'cannot integrate dependency provider'
}
run_pkg default "$dep_package@1" >/dev/null 2> "$tmp/dep-default.err" ||
  fail 'cannot select dependency package default'
run_pkg provider default "$dep_facility" "$dep_package" >/dev/null 2> "$tmp/dep-facility-default.err" || {
  command -p -- cat "$tmp/dep-facility-default.err" >&2
  fail 'cannot configure dependency facility default'
}

prepare_service_provider 1 > "$tmp/integrate-1.out" 2> "$tmp/integrate-1.err" || {
  command -p -- cat "$tmp/integrate-1.err" >&2
  fail 'cannot integrate system service provider version 1'
}
prepare_service_provider 2 > "$tmp/integrate-2.out" 2> "$tmp/integrate-2.err" || {
  command -p -- cat "$tmp/integrate-2.err" >&2
  fail 'cannot integrate system service provider version 2'
}

run_pkg default "$package@1" >/dev/null 2> "$tmp/package-default-1.err" ||
  fail 'cannot select service package default version 1'
run_pkg provider bind "$package" "$dep_facility" "$dep_package" >/dev/null 2> "$tmp/dependency-bind.err" || {
  command -p -- cat "$tmp/dependency-bind.err" >&2
  fail 'cannot configure service-package dependency binding'
}
run_pkg provider default "$facility" "$package" >/dev/null 2> "$tmp/service-default.err" || {
  command -p -- cat "$tmp/service-default.err" >&2
  fail 'cannot configure service facility default'
}

service_home=$("$root/m" "$root/bin/sys/state-path" system pkg "$package" home "$facility") ||
  error 'cannot resolve system service HOME'
service_state_identity=${service_home%/home}
package_system_conf=$("$root/m" "$root/bin/sys/state-path" system pkg "$package" conf) ||
  error 'cannot resolve package system state'
package_system_identity=${package_system_conf%/conf}
marker=$service_home/host-system-events
system_srv_conf=$("$root/m" "$root/bin/sys/state-path" system sys srv conf) ||
  error 'cannot resolve system srv state'
system_srv_state=${system_srv_conf%/conf}

for state_root in "$service_state_identity" "$system_srv_state"
do
  if [ -e "$state_root" ] || [ -L "$state_root" ]
  then
    skip 'system service state already exists in the supplied environment'
  fi
done

case "$host_os" in
  Linux) host_manifest=/etc/systemd/system/m-srv-$facility.service ;;
  Darwin) host_manifest=/Library/LaunchDaemons/m.srv.$facility.plist ;;
esac
[ ! -e "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  skip 'synthetic system host registration unexpectedly already exists'

if run_srv_system install "$facility" root > "$tmp/root-account.out" 2> "$tmp/root-account.err"
then
  fail 'root was accepted as system-service execution account'
else
  status=$?
fi
[ "$status" -eq 1 ] || fail "root execution-account rejection returned $status instead of 1"
[ ! -e "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  fail 'rejected root execution account created a native manifest'

run_srv_system install "$facility" "$service_account" > "$tmp/install.out" 2> "$tmp/install.err" || {
  command -p -- cat "$tmp/install.err" >&2
  fail 'cannot install system host integration'
}
host_installed=1
[ ! -e "$marker" ] || fail 'system install unexpectedly started the provider'
[ -f "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  fail 'system host manifest was not persisted as a regular file'

[ -d "$service_home" ] && [ ! -L "$service_home" ] ||
  fail 'system service HOME was not prepared'
home_uid=$(command -p -- ls -dn "$service_home" | command -p -- awk 'NR == 1 { print $3 }') ||
  error 'cannot inspect system service HOME ownership'
[ "$home_uid" = "$service_uid" ] ||
  fail 'system service HOME is not owned by the selected execution account'

system_pkg_conf=$("$root/m" "$root/bin/sys/state-path" system sys pkg conf) ||
  error 'cannot resolve provider system configuration'
service_default_file=$system_pkg_conf/provider/default/$facility
binding_file=$package_system_conf/binding/$dep_facility
"$sudo_bin" -n -u "$service_account" "$cat_bin" "$service_default_file" >/dev/null 2>&1 ||
  fail 'service account cannot read prepared service facility default'
"$sudo_bin" -n -u "$service_account" "$cat_bin" "$binding_file" >/dev/null 2>&1 ||
  fail 'service account cannot read prepared dependency binding'

if run_srv host system start "$facility" > "$tmp/nonadmin.out" 2> "$tmp/nonadmin.err"
then
  fail 'non-root service account was allowed to mutate system host lifecycle'
else
  status=$?
fi
[ "$status" -eq 1 ] || fail "non-root administrative rejection returned $status instead of 1"

run_srv_system start "$facility" > "$tmp/start-1.out" 2> "$tmp/start-1.err" || {
  command -p -- cat "$tmp/start-1.err" >&2
  fail 'cannot start system-hosted provider version 1'
}
pid1=$(wait_start 1) || {
  case "$host_os" in
    Linux) systemctl status "m-srv-$facility.service" --no-pager >&2 || : ;;
    Darwin) launchctl print "system/m.srv.$facility" >&2 || : ;;
  esac
  fail 'system supervisor did not start provider version 1'
}

start_line=$(command -p -- awk -v p="$pid1" '$1 == "start" && $3 == p { line = $0 } END { print line }' "$marker")
set -- $start_line
[ "$1" = start ] && [ "$2" = 1 ] && [ "$3" = "$pid1" ] ||
  fail 'provider version 1 start marker is malformed'
[ "$4" = "$service_uid" ] || fail 'provider did not run as selected non-root account'
[ "$5" = "$service_home" ] || fail 'provider did not receive system State Instance HOME'
[ "$6" = dependency-ok ] || fail 'provider dependency environment was not resolved under service account'

run_srv_system stop "$facility" > "$tmp/stop-1.out" 2> "$tmp/stop-1.err" || {
  command -p -- cat "$tmp/stop-1.err" >&2
  fail 'cannot stop system-hosted provider version 1'
}
wait_pid_gone "$pid1" || fail 'provider version 1 remained alive after system stop'

: > "$marker"
run_pkg default "$package@2" >/dev/null 2> "$tmp/package-default-2.err" ||
  fail 'cannot move service provider package default to version 2'

if run_srv_system start "$facility" > "$tmp/stale-start.out" 2> "$tmp/stale-start.err"
then
  fail 'stale system registration started after provider default changed'
else
  status=$?
fi
[ "$status" -eq 1 ] || fail "stale system registration returned $status instead of 1"
[ ! -s "$marker" ] || fail 'stale registration launched a provider process'

run_srv_system install "$facility" "$service_account" > "$tmp/reinstall.out" 2> "$tmp/reinstall.err" || {
  command -p -- cat "$tmp/reinstall.err" >&2
  fail 'cannot reconcile system registration to provider version 2'
}
[ ! -s "$marker" ] || fail 'system reinstall unexpectedly started the provider'

run_srv_system start "$facility" > "$tmp/start-2.out" 2> "$tmp/start-2.err" || {
  command -p -- cat "$tmp/start-2.err" >&2
  fail 'cannot start reconciled provider version 2'
}
pid2=$(wait_start 2) || fail 'reconciled system registration did not start provider version 2'

run_srv_system restart "$facility" > "$tmp/restart-2.out" 2> "$tmp/restart-2.err" || {
  command -p -- cat "$tmp/restart-2.err" >&2
  fail 'cannot restart system-hosted provider version 2'
}
pid3=$(wait_start 2 "$pid2") || fail 'system restart did not produce a replacement provider process'
[ "$pid3" != "$pid2" ] || fail 'system restart reused the previous provider pid'
wait_pid_gone "$pid2" || fail 'previous provider process remained alive after system restart'

run_srv_system stop "$facility" > "$tmp/stop-2.out" 2> "$tmp/stop-2.err" ||
  fail 'cannot stop restarted system provider'
wait_pid_gone "$pid3" || fail 'restarted provider remained alive after system stop'

run_srv_system uninstall "$facility" > "$tmp/uninstall.out" 2> "$tmp/uninstall.err" || {
  command -p -- cat "$tmp/uninstall.err" >&2
  fail 'cannot uninstall system host integration'
}
host_installed=0
[ ! -e "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  fail 'system host manifest remained after uninstall'
[ -d "$service_home" ] ||
  fail 'system host uninstall deleted authoritative service state'
[ "$(command -p -- id -u "$service_account" 2>/dev/null)" = "$service_uid" ] ||
  fail 'system host uninstall modified or removed the execution account'

printf 'system-service-account=%s\n' "$service_account"
printf 'system-state-instance=ok\n'
printf 'dependency-runtime-access=ok\n'
printf 'provider-reconciliation=ok\n'
printf 'host-system-service=ok\n'

cleanup
trap - 0 HUP INT TERM
exit 0
