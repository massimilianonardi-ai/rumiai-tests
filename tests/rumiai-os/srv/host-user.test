#!/bin/sh

TEST_ID=rumiai-os/srv/host-user.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

pid_exists()
{
  seen=$(command -p -- ps -p "$1" -o pid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')
  [ "$seen" = "$1" ]
}

wait_pid_gone()
{
  wait_pid=$1
  wait_count=0
  while pid_exists "$wait_pid" && [ "$wait_count" -lt 12 ]
  do
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  ! pid_exists "$wait_pid"
}

wait_start()
{
  wait_version=$1
  wait_count=0
  while [ "$wait_count" -lt 12 ]
  do
    if [ -f "$marker" ] &&
       command -p -- awk -v v="$wait_version" '$1 == "start" && $2 == v { found = 1 } END { exit found ? 0 : 1 }' "$marker"
    then
      return 0
    fi
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  return 1
}

start_pid()
{
  command -p -- awk -v v="$1" '$1 == "start" && $2 == v { pid = $3 } END { if (pid != "") print pid }' "$marker"
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_srv()
{
  "$root/m" "$root/bin/sys/srv" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${facility-}" ]
  then
    run_srv host user uninstall "$facility" >/dev/null 2>&1 || :
    run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  fi

  if [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :
    if [ -n "${driver-}" ] && [ -f "$driver" ]
    then
      for cleanup_version in 1 2
      do
        if [ -d "$root/pkg/$package@$cleanup_version" ] && [ ! -L "$root/pkg/$package@$cleanup_version" ]
        then
          "$root/m" "$driver" deintegrate "$package" "$cleanup_version" >/dev/null 2>&1 || :
        fi
      done
    fi
    rm -f "$root/pkg/$package" 2>/dev/null || :
  fi

  if [ -n "${package_state-}" ]
  then
    command -p -- rm -rf -- "$package_state" 2>/dev/null || :
  fi

  if [ "${pkg_store_created-0}" -eq 1 ]
  then
    command -p -- rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/srv" ] || fail 'srv command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] ||
  fail 'pkg-integration library is missing'

command -v ps >/dev/null 2>&1 || error 'ps unavailable'
command -v awk >/dev/null 2>&1 || error 'awk unavailable'

host_os=$(command -p -- uname -s) || error 'cannot identify host OS'
case "$host_os" in
  Linux)
    command -v systemctl >/dev/null 2>&1 || skip 'systemctl unavailable'
    systemctl --user show-environment >/dev/null 2>&1 || skip 'systemd user manager unavailable'
    manifest=${HOME:?}/.config/systemd/user
    ;;
  Darwin)
    command -v launchctl >/dev/null 2>&1 || skip 'launchctl unavailable'
    command -v plutil >/dev/null 2>&1 || skip 'plutil unavailable'
    uid=$(command -p -- id -u) || error 'cannot determine uid'
    launchctl print "gui/$uid" >/dev/null 2>&1 || skip 'launchd gui domain unavailable'
    manifest=${HOME:?}/Library/LaunchAgents
    ;;
  *)
    skip "user host supervision is not implemented for $host_os"
    ;;
esac

tmp=${TMPDIR:-/tmp}/rumiai-srv-host-user-$$
umask 077
command -p -- mkdir "$tmp" || error 'cannot create temporary directory'

package=srvhostprovider$$
facility=srvhost$$
service_command=$package-service-start
package_state=
pkg_store_created=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  command -p -- mkdir "$root/pkg" || error 'cannot create package store'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is invalid'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case "$action" in
  integrate) pkg_integrate "$@" ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

prepare_provider()
{
  provider_version=$1
  provider_range=$tmp/range-$provider_version
  provider_payload=$tmp/payload-$provider_version

  command -p -- mkdir -p \
    "$provider_range/cmd" \
    "$provider_range/link" \
    "$provider_range/facility-service/$facility" \
    "$provider_payload/bin" || return 1

  printf '%s 1\n' "$facility" > "$provider_range/facility" || return 1
  cat > "$provider_range/cmd/$service_command" <<EOF_SERVICE_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_SERVICE_COMMAND
  printf '%s\n' bin/service-target > "$provider_range/link/$service_command" || return 1
  printf '%s\n' "$service_command" > "$provider_range/facility-service/$facility/start" || return 1

  {
    printf '%s\n' '#!/bin/sh'
    printf 'provider_version=%s\n' "$provider_version"
    cat <<'EOF_TARGET'
marker=$HOME/host-user-events
on_term()
{
  printf '%s\n' "term $provider_version $" >> "$marker"
  exit 0
}
trap on_term TERM
trap 'exit 0' HUP INT
printf '%s\n' "start $provider_version $" >> "$marker"
while :
do
  sleep 1
done
EOF_TARGET
  } > "$provider_payload/bin/service-target"
  chmod 700 "$provider_payload/bin/service-target" || return 1

  "$root/m" "$driver" integrate "$package" "$provider_version" "$provider_range" "$provider_payload"
}

prepare_provider 1 > "$tmp/integrate-1.out" 2> "$tmp/integrate-1.err" || {
  command -p -- cat "$tmp/integrate-1.err" >&2
  fail 'cannot integrate service provider version 1'
}
prepare_provider 2 > "$tmp/integrate-2.out" 2> "$tmp/integrate-2.err" || {
  command -p -- cat "$tmp/integrate-2.err" >&2
  fail 'cannot integrate service provider version 2'
}

run_pkg default "$package@1" > "$tmp/package-default-1.out" 2> "$tmp/package-default-1.err" || {
  command -p -- cat "$tmp/package-default-1.err" >&2
  fail 'cannot select provider package default version 1'
}
run_pkg provider default "$facility" "$package" > "$tmp/facility-default.out" 2> "$tmp/facility-default.err" || {
  command -p -- cat "$tmp/facility-default.err" >&2
  fail 'cannot configure generic facility default'
}

package_home=$("$root/m" "$root/bin/sys/state-path" user pkg "$package" home) ||
  error 'cannot resolve package home'
package_state=${package_home%/home}
marker=$package_home/host-user-events

run_srv host user install "$facility" > "$tmp/host-install.out" 2> "$tmp/host-install.err" || {
  command -p -- cat "$tmp/host-install.err" >&2
  fail 'cannot install user host integration'
}
[ ! -e "$marker" ] || fail 'host install unexpectedly started the provider'

case "$host_os" in
  Linux) host_manifest=$manifest/m-srv-$facility.service ;;
  Darwin) host_manifest=$manifest/m.srv.$facility.plist ;;
esac
[ -f "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  fail 'host integration manifest was not persisted as a regular file'

run_srv host user start "$facility" > "$tmp/host-start-1.out" 2> "$tmp/host-start-1.err" || {
  command -p -- cat "$tmp/host-start-1.err" >&2
  fail 'cannot start hosted provider version 1'
}
wait_start 1 || fail 'host supervisor did not start provider version 1'
pid1=$(start_pid 1)
case "$pid1" in ""|*[!0123456789]*) fail 'invalid provider version 1 pid' ;; esac
pid_exists "$pid1" || fail 'provider version 1 is not alive after host start'

run_srv host user stop "$facility" > "$tmp/host-stop-1.out" 2> "$tmp/host-stop-1.err" || {
  command -p -- cat "$tmp/host-stop-1.err" >&2
  fail 'cannot stop hosted provider version 1'
}
wait_pid_gone "$pid1" || fail 'provider version 1 remained alive after host stop'
command -p -- grep -Fx "term 1 $pid1" "$marker" >/dev/null 2>&1 ||
  fail 'host stop did not deliver SIGTERM to provider version 1'

: > "$marker"
run_pkg default "$package@2" > "$tmp/package-default-2.out" 2> "$tmp/package-default-2.err" || {
  command -p -- cat "$tmp/package-default-2.err" >&2
  fail 'cannot move provider package default to version 2'
}
run_srv host user start "$facility" > "$tmp/host-start-2.out" 2> "$tmp/host-start-2.err" || {
  command -p -- cat "$tmp/host-start-2.err" >&2
  fail 'cannot start hosted provider version 2'
}
wait_start 2 || fail 'host start did not re-resolve provider version 2'
pid2=$(start_pid 2)
case "$pid2" in ""|*[!0123456789]*) fail 'invalid provider version 2 pid' ;; esac
pid_exists "$pid2" || fail 'provider version 2 is not alive after default change'

run_pkg default "$package@1" > "$tmp/package-default-back-1.out" 2> "$tmp/package-default-back-1.err" || {
  command -p -- cat "$tmp/package-default-back-1.err" >&2
  fail 'cannot restore provider package default version 1'
}
run_srv host user restart "$facility" > "$tmp/host-restart.out" 2> "$tmp/host-restart.err" || {
  command -p -- cat "$tmp/host-restart.err" >&2
  fail 'cannot restart hosted service'
}
wait_start 1 || fail 'host restart did not re-resolve provider version 1'
pid3=$(start_pid 1)
case "$pid3" in ""|*[!0123456789]*) fail 'invalid restarted provider version 1 pid' ;; esac
[ "$pid3" != "$pid1" ] || fail 'host restart reused the original provider pid'
wait_pid_gone "$pid2" || fail 'provider version 2 remained alive after host restart'
pid_exists "$pid3" || fail 'restarted provider version 1 is not alive'

run_srv host user stop "$facility" > "$tmp/host-stop-final.out" 2> "$tmp/host-stop-final.err" || {
  command -p -- cat "$tmp/host-stop-final.err" >&2
  fail 'cannot stop restarted hosted service'
}
wait_pid_gone "$pid3" || fail 'restarted provider remained alive after final stop'

run_srv host user uninstall "$facility" > "$tmp/host-uninstall.out" 2> "$tmp/host-uninstall.err" || {
  command -p -- cat "$tmp/host-uninstall.err" >&2
  fail 'cannot uninstall user host integration'
}
[ ! -e "$host_manifest" ] && [ ! -L "$host_manifest" ] ||
  fail 'host manifest remained after uninstall'

run_srv host user start "$facility" > "$tmp/start-after-uninstall.out" 2> "$tmp/start-after-uninstall.err"
status=$?
[ "$status" -eq 1 ] || {
  command -p -- cat "$tmp/start-after-uninstall.err" >&2
  fail "host start after uninstall returned $status instead of 1"
}

run_pkg provider default -u -- "$facility" >/dev/null 2> "$tmp/default-unset.err" ||
  fail 'cannot remove facility default'
run_pkg default -u -- "$package" >/dev/null 2> "$tmp/package-default-unset.err" ||
  fail 'cannot remove package default'

"$root/m" "$driver" deintegrate "$package" 2 > "$tmp/deintegrate-2.out" 2> "$tmp/deintegrate-2.err" || {
  command -p -- cat "$tmp/deintegrate-2.err" >&2
  fail 'cannot deintegrate provider version 2'
}
"$root/m" "$driver" deintegrate "$package" 1 > "$tmp/deintegrate-1.out" 2> "$tmp/deintegrate-1.err" || {
  command -p -- cat "$tmp/deintegrate-1.err" >&2
  fail 'cannot deintegrate provider version 1'
}

cleanup
trap - 0 HUP INT TERM
printf 'host-user-lifecycle=ok\n'
printf 'host-user-provider-reresolution=ok\n'
exit 0
