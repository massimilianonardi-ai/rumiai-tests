#!/bin/sh

TEST_ID=rumiai-os/srv/provider.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

pid_exists()
{
  seen=$(command -p -- ps -p "$1" -o pid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')
  [ "$seen" = "$1" ]
}

wait_pid_gone()
{
  wait_pid=$1
  wait_count=0
  while pid_exists "$wait_pid" && [ "$wait_count" -lt 12 ]
  do
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  ! pid_exists "$wait_pid"
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_srv()
{
  if [ -n "${legacy_bin-}" ]
  then
    PATH="$legacy_bin:$PATH" "$root/m" "$root/bin/sys/srv" "$@"
  else
    "$root/m" "$root/bin/sys/srv" "$@"
  fi
}

cleanup()
{
  trap - 0 HUP INT TERM

  if [ -n "${service_pid-}" ]
  then
    kill "$service_pid" 2>/dev/null || :
    wait_pid_gone "$service_pid" 2>/dev/null || :
  fi

  if [ -n "${facility-}" ]
  then
    run_pkg provider default -u -- "$facility" >/dev/null 2>&1 || :
  fi

  if [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :
    if [ -n "${driver-}" ] && [ -f "$driver" ] &&
       [ -d "$root/pkg/$package@1" ] && [ ! -L "$root/pkg/$package@1" ]
    then
      "$root/m" "$driver" deintegrate "$package" 1 >/dev/null 2>&1 || :
    fi
    rm -f "$root/bin/ext/${package}-service-start" "$root/pkg/$package" 2>/dev/null || :
  fi

  if [ -n "${run_root-}" ] && [ -n "${facility-}" ]
  then
    rm -rf "$run_root/$facility" "$run_root/.$facility.lock" "$run_root/.$facility.lock."* 2>/dev/null || :
  fi
  if [ -n "${log_root-}" ] && [ -n "${facility-}" ]
  then
    rm -f "$log_root/$facility.log" 2>/dev/null || :
  fi

  if [ "${bin_ext_created-0}" -eq 1 ]
  then
    rmdir "$root/bin/ext" 2>/dev/null || :
  fi
  if [ "${pkg_store_created-0}" -eq 1 ]
  then
    rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/srv" ] || fail 'srv command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] ||
  fail 'pkg-integration library is missing'

command -v ps >/dev/null 2>&1 || error 'ps unavailable'
command -v awk >/dev/null 2>&1 || error 'awk unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-srv-provider-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

package=srvprovider$$
facility=srvfacility$$
service_command=$package-service-start
missing_provider=srvmissing$$

pkg_store_created=0
bin_ext_created=0
if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  mkdir "$root/pkg" || error 'cannot create package store'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is invalid'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

range=$tmp/range
payload=$tmp/payload
mkdir -p "$range/cmd" "$range/link" "$range/facility-service/$facility" "$payload/bin" ||
  error 'cannot create provider fixture'

printf '%s 1\n' "$facility" > "$range/facility" ||
  error 'cannot write facility declaration'
cat > "$range/cmd/$service_command" <<EOF_SERVICE_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_SERVICE_COMMAND
printf '%s\n' bin/service-target > "$range/link/$service_command" ||
  error 'cannot write package command link'
printf '%s\n' "$service_command" > "$range/facility-service/$facility/start" ||
  error 'cannot write service realization'

TEST_SERVICE_STARTS=$tmp/starts
TEST_SERVICE_TERMS=$tmp/terms
TEST_SERVICE_COMMAND=$tmp/command
export TEST_SERVICE_STARTS TEST_SERVICE_TERMS TEST_SERVICE_COMMAND
: > "$TEST_SERVICE_STARTS" || error 'cannot prepare start marker'
: > "$TEST_SERVICE_TERMS" || error 'cannot prepare termination marker'

cat > "$payload/bin/service-target" <<'EOF_TARGET'
#!/bin/sh
on_term()
{
  printf '%s\n' "$$" >> "$TEST_SERVICE_TERMS"
  exit 0
}
trap on_term TERM
trap 'exit 0' HUP INT
printf '%s\n' "$$" >> "$TEST_SERVICE_STARTS"
printf '%s\n' "${m_COMMAND_BIN-}" > "$TEST_SERVICE_COMMAND"
while :
do
  sleep 1
done
EOF_TARGET
chmod 700 "$payload/bin/service-target" || error 'cannot prepare service target'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case "$action" in
  integrate)
    [ -f "$3/format" ] || printf '%s\n' tar.gz > "$3/format" || exit 3
    pkg_integrate "$@"
    ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

"$root/m" "$driver" integrate "$package" 1 "$range" "$payload" > "$tmp/integrate.out" 2> "$tmp/integrate.err" || {
  cat "$tmp/integrate.err" >&2
  fail 'cannot integrate service provider'
}

run_pkg default "$package@1" > "$tmp/package-default.out" 2> "$tmp/package-default.err" || {
  cat "$tmp/package-default.err" >&2
  fail 'cannot select provider package default'
}

run_pkg provider default "$facility" "$package@1" > "$tmp/facility-default.out" 2> "$tmp/facility-default.err" || {
  cat "$tmp/facility-default.err" >&2
  fail 'cannot configure service facility default'
}

run_root=$("$root/m" "$root/bin/sys/state-path" user sys srv run) ||
  error 'cannot resolve srv run root'
log_root=$("$root/m" "$root/bin/sys/state-path" user sys srv log) ||
  error 'cannot resolve srv log root'

run_srv start "$facility" > "$tmp/start.out" 2> "$tmp/start.err" || {
  cat "$tmp/start.err" >&2
  [ ! -f "$log_root/$facility.log" ] || {
    printf '%s\n' "$TEST_ID: provider service log follows" >&2
    cat "$log_root/$facility.log" >&2
  }
  fail 'provider-backed srv start failed'
}

service_pid=$(command -p -- sed -n '1p' "$TEST_SERVICE_STARTS" 2>/dev/null) ||
  fail 'cannot read provider-backed service pid'
case "$service_pid" in
  "" | *[!0123456789]*) fail 'provider-backed service emitted invalid pid' ;;
esac
pid_exists "$service_pid" || fail 'provider-backed service is not alive'

expected_command=$root/pkg/$package@1/cmd/$service_command
observed_command=$(command -p -- cat "$TEST_SERVICE_COMMAND" 2>/dev/null) ||
  fail 'cannot read package command identity'
[ "$observed_command" = "$expected_command" ] ||
  fail "srv did not launch exact provider concrete command: expected=$expected_command observed=$observed_command"

run_pkg provider default "$facility" "$missing_provider" > "$tmp/default-switch.out" 2> "$tmp/default-switch.err" || {
  cat "$tmp/default-switch.err" >&2
  fail 'cannot change facility default while service is running'
}

run_srv stop -f "$facility" > "$tmp/stop.out" 2> "$tmp/stop.err" || {
  cat "$tmp/stop.err" >&2
  fail 'srv stop re-resolved provider instead of using running-instance state'
}
wait_pid_gone "$service_pid" || fail 'provider-backed service remained alive after stop'
grep -Fx "$service_pid" "$TEST_SERVICE_TERMS" >/dev/null 2>&1 ||
  fail 'provider-backed stop did not deliver SIGTERM'
service_pid=

legacy_bin=$tmp/legacy-bin
mkdir "$legacy_bin" || error 'cannot create legacy fallback directory'
legacy_marker=$tmp/legacy-executed
export legacy_marker
cat > "$legacy_bin/$facility-start" <<'EOF_LEGACY'
#!/bin/sh
: > "$legacy_marker"
while :
do
  sleep 1
done
EOF_LEGACY
chmod 700 "$legacy_bin/$facility-start" || error 'cannot prepare legacy fallback decoy'

run_srv start "$facility" > "$tmp/invalid-default-start.out" 2> "$tmp/invalid-default-start.err"
invalid_status=$?
[ "$invalid_status" -eq 1 ] || {
  cat "$tmp/invalid-default-start.err" >&2
  fail "configured but unresolved provider returned $invalid_status instead of 1"
}
[ ! -e "$legacy_marker" ] ||
  fail 'configured but unresolved provider silently fell back to PATH'

run_pkg provider default -u -- "$facility" > "$tmp/default-unset.out" 2> "$tmp/default-unset.err" ||
  fail 'cannot remove service facility default'

run_srv start "$facility" > "$tmp/no-default-start.out" 2> "$tmp/no-default-start.err"
no_default_status=$?
[ "$no_default_status" -eq 1 ] || {
  command -p -- cat "$tmp/no-default-start.err" >&2
  fail "service without provider default returned $no_default_status instead of 1"
}
[ ! -e "$legacy_marker" ] ||
  fail 'service without provider default fell back to PATH'

run_pkg default -u -- "$package" > "$tmp/package-default-unset.out" 2> "$tmp/package-default-unset.err" ||
  fail 'cannot remove provider package default'

"$root/m" "$driver" deintegrate "$package" 1 > "$tmp/deintegrate.out" 2> "$tmp/deintegrate.err" || {
  cat "$tmp/deintegrate.err" >&2
  fail 'cannot deintegrate service provider'
}

cleanup
trap - 0 HUP INT TERM
exit 0
