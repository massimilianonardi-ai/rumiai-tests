#!/bin/sh

TEST_ID=rumiai-os/srv/lifecycle.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
  esac
  dir=${self%/*}
  [ "$dir" != "$self" ] || dir=.
  CDPATH= cd -- "$dir" 2>/dev/null && pwd -P
}

pid_exists()
{
  seen=$(command -p -- ps -p "$1" -o pid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')
  [ "$seen" = "$1" ]
}

wait_pid_gone()
{
  wait_pid=$1
  wait_count=0
  while pid_exists "$wait_pid" && [ "$wait_count" -lt 12 ]
  do
    command -p -- sleep 1
    wait_count=$((wait_count + 1))
  done
  ! pid_exists "$wait_pid"
}

read_pid_line()
{
  pid_file=$1
  pid_line=$2
  pid_value=$(command -p -- sed -n "${pid_line}p" "$pid_file") || return 1
  case "$pid_value" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$pid_value" -gt 0 ] 2>/dev/null || return 1
  printf '%s\n' "$pid_value"
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

run_srv()
{
  "$root/m" "$root/bin/sys/srv" "$@"
}

cleanup_state_entries()
{
  if [ -n "${run_root-}" ] && [ -d "$run_root" ]
  then
    for candidate in "$run_root"/*"$service_prefix"* "$run_root"/.*"$service_prefix"*
    do
      [ -e "$candidate" ] || [ -L "$candidate" ] || continue
      command -p -- rm -rf -- "$candidate" 2>/dev/null || :
    done
    if [ "${run_root_existed-1}" -eq 0 ]
    then
      command -p -- rmdir "$run_root" 2>/dev/null || :
    fi
  fi

  if [ -n "${log_root-}" ] && [ -d "$log_root" ]
  then
    for candidate in "$log_root"/*"$service_prefix"* "$log_root"/.*"$service_prefix"*
    do
      [ -e "$candidate" ] || [ -L "$candidate" ] || continue
      command -p -- rm -rf -- "$candidate" 2>/dev/null || :
    done
    if [ "${log_root_existed-1}" -eq 0 ]
    then
      command -p -- rmdir "$log_root" 2>/dev/null || :
    fi
  fi
}

cleanup()
{
  trap - 0 HUP INT TERM

  for cleanup_pid in ${SERVICE_PIDS-}
  do
    kill "$cleanup_pid" 2>/dev/null || :
  done
  for cleanup_pid in ${SERVICE_PIDS-}
  do
    wait_pid_gone "$cleanup_pid" 2>/dev/null || :
  done

  cleanup_state_entries

  for cleanup_facility in "${service_name-}" "${fail_service-}"
  do
    [ -n "$cleanup_facility" ] || continue
    run_pkg provider default -u -- "$cleanup_facility" >/dev/null 2>&1 || :
  done

  if [ -n "${package-}" ]
  then
    run_pkg default -u -- "$package" >/dev/null 2>&1 || :
    if [ "${integrated-0}" -eq 1 ] && [ -n "${driver-}" ] && [ -f "$driver" ]
    then
      "$root/m" "$driver" deintegrate "$package" 1 >/dev/null 2>&1 || :
    fi
  fi

  if [ "${bin_ext_created-0}" -eq 1 ]
  then
    command -p -- rmdir "$root/bin/ext" 2>/dev/null || :
  fi
  if [ "${pkg_store_created-0}" -eq 1 ]
  then
    command -p -- rmdir "$root/pkg" 2>/dev/null || :
  fi

  [ -z "${tmp-}" ] || command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing or not executable'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing or not executable'
[ -x "$root/bin/sys/srv" ] || fail 'srv command is missing or not executable'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing or not executable'
[ -f "$root/lib/sys/sh/pkg/pkg-integration.lib.sh" ] || fail 'pkg-integration library is missing'

command -v ps >/dev/null 2>&1 || error 'ps unavailable'
command -v awk >/dev/null 2>&1 || error 'awk unavailable'
command -v sed >/dev/null 2>&1 || error 'sed unavailable'
command -v grep >/dev/null 2>&1 || error 'grep unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-srv-$$
umask 077
command -p -- mkdir "$tmp" || error 'cannot create temporary directory'

service_prefix=rumiaisrv$$
service_name=$service_prefix
fail_service=$service_prefix-fail
missing_service=$service_prefix-missing
package=srvlifecycleprovider$$
service_command=$package-run
fail_command=$package-fail

pkg_store_created=0
bin_ext_created=0
integrated=0

if [ ! -e "$root/pkg" ] && [ ! -L "$root/pkg" ]
then
  command -p -- mkdir "$root/pkg" || error 'cannot create package store'
  pkg_store_created=1
fi
[ -d "$root/pkg" ] && [ ! -L "$root/pkg" ] || fail 'package store is invalid'

if [ ! -e "$root/bin/ext" ] && [ ! -L "$root/bin/ext" ]
then
  bin_ext_created=1
fi

range=$tmp/range
payload=$tmp/payload
command -p -- mkdir -p   "$range/cmd"   "$range/link"   "$range/facility-service/$service_name"   "$range/facility-service/$fail_service"   "$payload/bin" || error 'cannot create provider fixture'

{
  printf '%s 1\n' "$service_name"
  printf '%s 1\n' "$fail_service"
} > "$range/facility" || error 'cannot write facility declarations'

cat > "$range/cmd/$service_command" <<EOF_SERVICE_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_SERVICE_COMMAND
cat > "$range/cmd/$fail_command" <<EOF_FAIL_COMMAND
#!/usr/bin/env m
. "\$m_LIB_DIR/sys/sh/pkg/pkg-launch.lib.sh"
launcher "$package" "\$@"
EOF_FAIL_COMMAND
printf '%s\n' bin/service-target > "$range/link/$service_command" || error 'cannot write service command link'
printf '%s\n' bin/fail-target > "$range/link/$fail_command" || error 'cannot write fail command link'
printf '%s\n' "$service_command" > "$range/facility-service/$service_name/start" ||
  error 'cannot write service realization'
printf '%s\n' "$fail_command" > "$range/facility-service/$fail_service/start" ||
  error 'cannot write fail realization'

TEST_SERVICE_STARTS=$tmp/service-starts
TEST_SERVICE_TERMS=$tmp/service-terms
TEST_SERVICE_STDOUT_MARKER=$service_prefix-stdout
TEST_SERVICE_STDERR_MARKER=$service_prefix-stderr
export TEST_SERVICE_STARTS TEST_SERVICE_TERMS TEST_SERVICE_STDOUT_MARKER TEST_SERVICE_STDERR_MARKER
: > "$TEST_SERVICE_STARTS" || error 'cannot prepare service start marker'
: > "$TEST_SERVICE_TERMS" || error 'cannot prepare service termination marker'

cat > "$payload/bin/service-target" <<'EOF_SERVICE'
#!/bin/sh
on_term()
{
  printf '%s\n' "$$" >> "$TEST_SERVICE_TERMS"
  exit 0
}
trap on_term TERM
trap 'exit 0' HUP INT
printf '%s\n' "$$" >> "$TEST_SERVICE_STARTS"
printf '%s\n' "$TEST_SERVICE_STDOUT_MARKER"
printf '%s\n' "$TEST_SERVICE_STDERR_MARKER" >&2
while :
do
  sleep 1
done
EOF_SERVICE
cat > "$payload/bin/fail-target" <<'EOF_FAIL'
#!/bin/sh
exit 7
EOF_FAIL
chmod 700 "$payload/bin/service-target" "$payload/bin/fail-target" ||
  error 'cannot prepare provider targets'

driver=$tmp/integration-driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/pkg/pkg-integration.lib.sh" || exit 3
action=$1
shift
case "$action" in
  integrate) pkg_integrate "$@" ;;
  deintegrate) pkg_deintegrate "$@" ;;
  *) exit 2 ;;
esac
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare integration driver'

"$root/m" "$driver" integrate "$package" 1 "$range" "$payload" > "$tmp/integrate.out" 2> "$tmp/integrate.err" || {
  command -p -- cat "$tmp/integrate.err" >&2
  fail 'cannot integrate lifecycle service provider'
}
integrated=1

run_pkg default "$package@1" > "$tmp/package-default.out" 2> "$tmp/package-default.err" || {
  command -p -- cat "$tmp/package-default.err" >&2
  fail 'cannot select lifecycle provider package default'
}
for facility in "$service_name" "$fail_service"
do
  run_pkg provider default "$facility" "$package@1" > "$tmp/$facility-default.out" 2> "$tmp/$facility-default.err" || {
    command -p -- cat "$tmp/$facility-default.err" >&2
    fail "cannot configure service facility default for $facility"
  }
done

run_root=$("$root/m" "$root/bin/sys/state-path" user sys srv run) || fail 'cannot resolve srv run state'
log_root=$("$root/m" "$root/bin/sys/state-path" user sys srv log) || fail 'cannot resolve srv log state'
run_root_existed=0
log_root_existed=0
[ -d "$run_root" ] && run_root_existed=1
[ -d "$log_root" ] && log_root_existed=1

run_srv start "$service_name" > "$tmp/start.out" 2> "$tmp/start.err" || {
  command -p -- cat "$tmp/start.err" >&2
  fail 'srv start failed'
}
service_pid=$(read_pid_line "$TEST_SERVICE_STARTS" 1) || fail 'started service did not expose a valid pid'
SERVICE_PIDS=$service_pid
pid_exists "$service_pid" || fail 'started service is not alive'
[ -d "$run_root" ] || fail 'srv did not materialize its state-path run root'
[ -d "$log_root" ] || fail 'srv did not materialize its state-path log root'
managed_log=$log_root/$service_name.log
[ -f "$managed_log" ] || fail 'srv did not materialize its managed service log'
command -p -- grep -F "$TEST_SERVICE_STDOUT_MARKER" "$managed_log" >/dev/null 2>&1 ||
  fail 'service stdout was not appended to the managed service log'
command -p -- grep -F "$TEST_SERVICE_STDERR_MARKER" "$managed_log" >/dev/null 2>&1 ||
  fail 'service stderr was not appended to the same managed service log'

run_srv start "$service_name" > "$tmp/reuse.out" 2> "$tmp/reuse.err" || fail 'second srv start failed'
start_count=$(command -p -- awk 'END { print NR + 0 }' "$TEST_SERVICE_STARTS") || error 'cannot count service starts'
[ "$start_count" -eq 1 ] || fail "idempotent start launched $start_count service instances"
pid_exists "$service_pid" || fail 'service died after idempotent start'

run_srv stop "$service_name" > "$tmp/stop.out" 2> "$tmp/stop.err" || fail 'srv stop failed'
wait_pid_gone "$service_pid" || fail 'service still alive after normal stop'
command -p -- grep -Fx "$service_pid" "$TEST_SERVICE_TERMS" >/dev/null 2>&1 ||
  fail 'normal stop did not terminate the service with SIGTERM'
SERVICE_PIDS=

run_srv stop "$service_name" > "$tmp/idempotent-stop.out" 2> "$tmp/idempotent-stop.err" ||
  fail 'idempotent stop failed when service was already stopped'

: > "$TEST_SERVICE_STARTS" || error 'cannot reset service start marker'
: > "$TEST_SERVICE_TERMS" || error 'cannot reset service termination marker'
run_srv start "$service_name" > "$tmp/concurrent-a.out" 2> "$tmp/concurrent-a.err" &
concurrent_a=$!
run_srv start "$service_name" > "$tmp/concurrent-b.out" 2> "$tmp/concurrent-b.err" &
concurrent_b=$!
wait "$concurrent_a"
concurrent_a_status=$?
wait "$concurrent_b"
concurrent_b_status=$?
[ "$concurrent_a_status" -eq 0 ] && [ "$concurrent_b_status" -eq 0 ] ||
  fail 'concurrent srv start failed'
concurrent_starts=$(command -p -- awk 'END { print NR + 0 }' "$TEST_SERVICE_STARTS") || error 'cannot count concurrent starts'
[ "$concurrent_starts" -eq 1 ] ||
  fail "concurrent start launched $concurrent_starts service instances"
concurrent_pid=$(read_pid_line "$TEST_SERVICE_STARTS" 1) || fail 'concurrent start did not expose a valid pid'
SERVICE_PIDS=$concurrent_pid
pid_exists "$concurrent_pid" || fail 'concurrent start service is not alive'
run_srv stop -f "$service_name" > "$tmp/concurrent-stop.out" 2> "$tmp/concurrent-stop.err" ||
  fail 'forced cleanup after concurrent start failed'
wait_pid_gone "$concurrent_pid" || fail 'concurrent service still alive after stop'
SERVICE_PIDS=

: > "$TEST_SERVICE_STARTS" || error 'cannot reset service start marker'
TEST_ROOT=$root
TEST_SERVICE_NAME=$service_name
export TEST_ROOT TEST_SERVICE_NAME
cat > "$tmp/foreign-start" <<'EOF_FOREIGN'
#!/bin/sh
"$TEST_ROOT/m" "$TEST_ROOT/bin/sys/srv" start "$TEST_SERVICE_NAME"
EOF_FOREIGN
chmod 700 "$tmp/foreign-start" || error 'cannot prepare foreign caller input'
"$tmp/foreign-start" > "$tmp/foreign-start.out" 2> "$tmp/foreign-start.err" ||
  fail 'foreign caller start failed'
foreign_pid=$(read_pid_line "$TEST_SERVICE_STARTS" 1) || fail 'foreign service did not expose a valid pid'
SERVICE_PIDS=$foreign_pid
pid_exists "$foreign_pid" || fail 'foreign service is not alive'

run_srv stop "$service_name" > "$tmp/foreign-stop.out" 2> "$tmp/foreign-stop.err" ||
  fail 'owner-aware stop returned failure'
pid_exists "$foreign_pid" || fail 'owner-aware stop killed a service created by another caller'

run_srv stop -f "$service_name" > "$tmp/force-stop.out" 2> "$tmp/force-stop.err" ||
  fail 'forced stop failed'
wait_pid_gone "$foreign_pid" || fail 'forced stop left service alive'
SERVICE_PIDS=

: > "$TEST_SERVICE_STARTS" || error 'cannot reset service start marker'
run_srv start "$service_name" > "$tmp/stale-a.out" 2> "$tmp/stale-a.err" ||
  fail 'stale-state setup start failed'
stale_pid=$(read_pid_line "$TEST_SERVICE_STARTS" 1) || fail 'stale-state service did not expose a valid pid'
SERVICE_PIDS=$stale_pid
kill "$stale_pid" 2>/dev/null || error 'cannot terminate stale-state service externally'
wait_pid_gone "$stale_pid" || error 'externally terminated service did not exit'
SERVICE_PIDS=

run_srv start "$service_name" > "$tmp/stale-b.out" 2> "$tmp/stale-b.err" ||
  fail 'start did not recover stale lifecycle state'
recovered_pid=$(read_pid_line "$TEST_SERVICE_STARTS" 2) || fail 'recovered service did not expose a valid pid'
[ "$recovered_pid" != "$stale_pid" ] || fail 'stale service pid was reused'
SERVICE_PIDS=$recovered_pid
pid_exists "$recovered_pid" || fail 'service not alive after stale-state recovery'
run_srv stop -f "$service_name" > "$tmp/stale-stop.out" 2> "$tmp/stale-stop.err" ||
  fail 'cleanup stop after stale-state recovery failed'
wait_pid_gone "$recovered_pid" || fail 'recovered service still alive after stop'
SERVICE_PIDS=

if run_srv start "$fail_service" > "$tmp/fail-start.out" 2> "$tmp/fail-start.err"
then
  fail 'immediate startup failure was reported as success'
else
  status=$?
fi
[ "$status" -eq 1 ] || fail "immediate startup failure returned $status instead of 1"

if run_srv start "$missing_service" > "$tmp/missing.out" 2> "$tmp/missing.err"
then
  fail 'service without provider default was reported as success'
else
  status=$?
fi
[ "$status" -eq 1 ] || fail "service without provider default returned $status instead of 1"

if run_srv start BadName > "$tmp/invalid.out" 2> "$tmp/invalid.err"
then
  fail 'invalid service name was reported as success'
else
  status=$?
fi
[ "$status" -eq 2 ] || fail "invalid service name returned $status instead of 2"

cleanup
trap - 0 HUP INT TERM
exit 0
