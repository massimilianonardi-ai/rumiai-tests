#!/bin/sh

TEST_ID=rumiai-os/pkg-extract2/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

reset_stage()
{
  rm -rf "$stage" || return 1
  mkdir "$stage"
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
suite_root=${rumiai_os_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root"); status=$?
case $status in 0) : ;; 1) skip 'rumiai-os target checkout not found' ;; 2) fail 'invalid explicit rumiai-os target' ;; *) error 'target discovery failed' ;; esac

library="$root/lib/sys/sh/pkg/pkg-extract2.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail 'pkg-extract2 library is missing or has invalid mode'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-extract2-contract-$$
fakebin=$tmp/bin
marker=$tmp/marker
stage=$tmp/stage
umask 077
mkdir "$tmp" "$fakebin" "$stage" || error 'cannot create fixture directories'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
export PKG_EXTRACT2_MARKER=$marker

cat > "$fakebin/extract2" <<'EOF_EXTRACT2'
#!/bin/sh
[ "$#" -eq 3 ] || exit 2
format=$1
destination=$3
printf '%s\n' "$format" >> "$PKG_EXTRACT2_MARKER"
case "$format" in
  tar)
    mkdir -p "$destination/release/root/bin" || exit 1
    printf '%s\n' ordinary > "$destination/release/root/bin/tool" || exit 1
    ;;
  dmg)
    : > "$destination/Installer.pkg" || exit 1
    printf '%s\n' unrelated > "$destination/README" || exit 1
    ;;
  pkg)
    mkdir -p "$destination/Example.pkg/Payload/example/bin" "$destination/Overlay.pkg/Payload/pinentry-mac.app/Contents/MacOS" || exit 1
    printf '%s\n' primary > "$destination/Example.pkg/Payload/example/bin/tool" || exit 1
    printf '%s\n' ignored > "$destination/Example.pkg/Payload/installer-only" || exit 1
    printf '%s\n' overlay > "$destination/Overlay.pkg/Payload/pinentry-mac.app/Contents/MacOS/pinentry-mac" || exit 1
    ;;
  *) exit 2 ;;
esac
EOF_EXTRACT2
chmod 700 "$fakebin/extract2" || error 'cannot prepare fake extract2'

driver=$tmp/driver
cat > "$driver" <<'EOF_DRIVER'
#!/usr/bin/env m
loadsyslib "pkg/pkg-extract2" || exit 3
pkg_extract2 "$@"
EOF_DRIVER
chmod 700 "$driver" || error 'cannot prepare driver'

artifact=$tmp/artifact
printf '%s\n' artifact > "$artifact"
runtime_path="$fakebin:$root/bin/sys:/usr/bin:/bin"

range=$tmp/range-tar
mkdir "$range" || error 'cannot create ordinary range'
printf '%s\n' tar > "$range/format"
: > "$marker"
PATH="$runtime_path" "$root/m" "$driver" "$artifact" "$range" "$stage" >/dev/null 2>"$tmp/tar.err" || { cat "$tmp/tar.err" >&2; fail 'ordinary pkg_extract2 failed'; }
[ -f "$stage/bin/tool" ] || fail 'ordinary useful-root normalization failed'
[ "$(cat "$marker")" = tar ] || fail 'ordinary format was not delegated once to extract2'

reset_stage || error 'cannot reset flat stage'
range=$tmp/range-flat
mkdir "$range" || error 'cannot create flat-pkg range'
printf '%s\n' flat-pkg > "$range/format"
printf '%s\n' Example.pkg > "$range/component"
printf '%s\n' example > "$range/payload-root"
: > "$marker"
PATH="$runtime_path" "$root/m" "$driver" "$artifact" "$range" "$stage" >/dev/null 2>"$tmp/flat.err" || { cat "$tmp/flat.err" >&2; fail 'flat-pkg pkg_extract2 failed'; }
[ -f "$stage/bin/tool" ] || fail 'flat-pkg component/payload-root selection failed'
[ ! -e "$stage/installer-only" ] || fail 'flat-pkg content outside payload-root leaked into staging'
[ "$(cat "$marker")" = pkg ] || fail 'flat-pkg was not composed from extract2 pkg'

reset_stage || error 'cannot reset dmg stage'
range=$tmp/range-dmg
mkdir -p "$range/overlay/pinentry" || error 'cannot create dmg-pkg range'
printf '%s\n' dmg-pkg > "$range/format"
printf '%s\n' Example.pkg > "$range/component"
printf '%s\n' example > "$range/payload-root"
printf '%s\n' Overlay.pkg > "$range/overlay/pinentry/component"
printf '%s\n' libexec > "$range/overlay/pinentry/target-root"
: > "$marker"
PATH="$runtime_path" "$root/m" "$driver" "$artifact" "$range" "$stage" >/dev/null 2>"$tmp/dmg.err" || { cat "$tmp/dmg.err" >&2; fail 'dmg-pkg pkg_extract2 failed'; }
[ -f "$stage/bin/tool" ] || fail 'dmg-pkg primary component was not materialized'
[ -f "$stage/libexec/pinentry-mac.app/Contents/MacOS/pinentry-mac" ] || fail 'dmg-pkg overlay was not materialized'
actual=$(tr '\n' ' ' < "$marker" | sed 's/ $//')
[ "$actual" = 'dmg pkg' ] || fail "dmg-pkg composition was '$actual' instead of 'dmg pkg'"

reset_stage || error 'cannot reset metadata rejection stage'
range=$tmp/range-invalid
mkdir "$range" || error 'cannot create invalid ordinary range'
printf '%s\n' tar > "$range/format"
printf '%s\n' Example.pkg > "$range/component"
PATH="$runtime_path" "$root/m" "$driver" "$artifact" "$range" "$stage" >/dev/null 2>"$tmp/metadata.err"
[ "$?" -ne 0 ] || fail 'ordinary format accepted package-specific component metadata'

reset_stage || error 'cannot reset unsupported stage'
range=$tmp/range-unsupported
mkdir "$range" || error 'cannot create unsupported range'
printf '%s\n' pkg > "$range/format"
PATH="$runtime_path" "$root/m" "$driver" "$artifact" "$range" "$stage" >/dev/null 2>"$tmp/unsupported.err"
[ "$?" -eq 2 ] || fail 'pkg_extract2 accepted raw pkg as a package format'

exit 0
