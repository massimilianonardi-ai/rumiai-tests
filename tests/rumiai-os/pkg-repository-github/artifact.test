#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-github/artifact.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group=${test_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-github.lib.sh"
artifact_library="$root/lib/sys/sh/pkg/repository/pkg-repository-artifact.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "GitHub repository adapter is missing or has invalid mode"
[ -f "$artifact_library" ] && [ ! -L "$artifact_library" ] && [ -r "$artifact_library" ] && [ ! -x "$artifact_library" ] || fail "artifact override library is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "GitHub repository adapter syntax invalid"
command -p -- sh -n "$artifact_library" >/dev/null 2>&1 || fail "artifact override library syntax invalid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-github-artifact-$$"
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository="$tmp/repository"; range="$tmp/range"
printf '%s\n' github > "$repository/type"
printf '%s\n' acme > "$repository/owner"
printf '%s\n' demo > "$repository/repository"
printf '%s\n' '^demo-1\\.2\\.3-linux-x86_64\\.zip$' > "$range/archive_regex"
printf '%s\n' sha256 > "$range/digest_type"

GITHUB_HTTP_LOG="$tmp/http.log"; export GITHUB_HTTP_LOG
GITHUB_FIXTURE_MODE=normal; export GITHUB_FIXTURE_MODE

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
length=0
url=
for argument
do
  [ "$argument" = -l ] && length=1
  url=$argument
done
printf '%s\n' "$*" >> "$GITHUB_HTTP_LOG"

if [ "$length" -eq 1 ]
then
  case "$url" in
    https://vendor.example/releases/1.2.3/demo-1.2.3-linux-x86_64.zip) printf '%s\n' 321;;
    https://downloads.example.test/demo-1.2.3-linux-x86_64.zip) printf '%s\n' 654;;
    *) exit 87;;
  esac
  exit 0
fi

case "$url" in
  https://api.github.com/repos/acme/demo/releases/tags/1.2.3)
    if [ "$GITHUB_FIXTURE_MODE" = draft ]; then draft=true; else draft=false; fi
    printf '{"tag_name":"1.2.3","draft":%s,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","assets":[' "$draft"
    printf '{"name":"demo-1.2.3-linux-x86_64.zip","state":"uploaded","size":123,"digest":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","browser_download_url":"https://downloads.example.test/demo-1.2.3-linux-x86_64.zip"}'
    printf ']}\n'
    ;;
  https://vendor.example/releases/1.2.3/SHA256SUMS)
    printf '%s\n' 'DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD  demo-1.2.3-linux-x86_64.zip'
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
. "$library" || error "cannot source GitHub repository adapter"

descriptor="$(pkg_repository_resolve_artifact "$repository" "$range" 1.2.3)" || fail "default GitHub artifact resolution failed"
expected='name=demo-1.2.3-linux-x86_64.zip
url=https://downloads.example.test/demo-1.2.3-linux-x86_64.zip
size=123
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
[ "$descriptor" = "$expected" ] || fail "default GitHub descriptor changed"

mkdir "$repository/download" "$repository/metadata" || error "cannot create override fixtures"
printf '%s\n' template-url > "$repository/download/type"
printf '%s\n' 'demo-{version}-linux-x86_64.zip' > "$repository/download/name-template"
printf '%s\n' 'https://vendor.example/releases/{version}/{name}' > "$repository/download/url-template"
printf '%s\n' checksum-manifest > "$repository/metadata/type"
printf '%s\n' 'https://vendor.example/releases/{version}/SHA256SUMS' > "$repository/metadata/url-template"

: > "$GITHUB_HTTP_LOG"
descriptor="$(pkg_repository_resolve_artifact "$repository" "$range" 1.2.3)" || fail "composed download+metadata overrides failed"
expected='name=demo-1.2.3-linux-x86_64.zip
url=https://vendor.example/releases/1.2.3/demo-1.2.3-linux-x86_64.zip
size=321
digest=sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
[ "$descriptor" = "$expected" ] || fail "composed override descriptor incorrect"
grep -F 'https://api.github.com/repos/acme/demo/releases/tags/1.2.3' "$GITHUB_HTTP_LOG" >/dev/null || fail "override bypassed GitHub exact release authority"

rm -rf "$repository/metadata"
descriptor="$(pkg_repository_resolve_artifact "$repository" "$range" 1.2.3)" || fail "download-only override failed"
expected='name=demo-1.2.3-linux-x86_64.zip
url=https://vendor.example/releases/1.2.3/demo-1.2.3-linux-x86_64.zip
size=123
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
[ "$descriptor" = "$expected" ] || fail "download-only override did not retain GitHub metadata"

rm -rf "$repository/download"
mkdir "$repository/metadata" || error "cannot recreate metadata override"
printf '%s\n' checksum-manifest > "$repository/metadata/type"
printf '%s\n' 'https://vendor.example/releases/{version}/SHA256SUMS' > "$repository/metadata/url-template"
descriptor="$(pkg_repository_resolve_artifact "$repository" "$range" 1.2.3)" || fail "metadata-only override failed"
expected='name=demo-1.2.3-linux-x86_64.zip
url=https://downloads.example.test/demo-1.2.3-linux-x86_64.zip
size=654
digest=sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
[ "$descriptor" = "$expected" ] || fail "metadata-only override did not retain GitHub download resolution"

GITHUB_FIXTURE_MODE=draft; export GITHUB_FIXTURE_MODE
if pkg_repository_resolve_artifact "$repository" "$range" 1.2.3 >/dev/null 2>&1; then fail "artifact override accepted a draft GitHub release"; fi
GITHUB_FIXTURE_MODE=normal; export GITHUB_FIXTURE_MODE

printf '%s\n' unknown > "$repository/metadata/type"
if pkg_repository_resolve_artifact "$repository" "$range" 1.2.3 >/dev/null 2>&1; then fail "unknown metadata override type was accepted"; fi

exit 0
