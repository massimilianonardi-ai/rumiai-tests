#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-github/artifact.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@c39b1a2c0b6e96e8e43809a6e66d16918cf90a7d:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"

  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac

  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"

  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"

  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"

  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"

  rumiai_test_target_have git || return "3"

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"

  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi

    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done

  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac


library="$root/lib/sh/pkg-repository-github.lib.sh"
[ -f "$library" ] || fail "lib/sh/pkg-repository-github.lib.sh is missing"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-github-artifact-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

repository_dir="$tmp/repository"
range_dir="$tmp/range"
fakebin="$tmp/bin"
mkdir "$repository_dir" "$range_dir" "$fakebin" || error "cannot create fixture directories"
printf -- '%s\n' "github" > "$repository_dir/type"
printf -- '%s\n' "acme" > "$repository_dir/owner"
printf -- '%s\n' "demo" > "$repository_dir/repository"
printf -- '%s\n' '^demo-1\.2\.3-linux-x86_64\.zip$' > "$range_dir/archive_regex"
printf -- '%s\n' "sha256" > "$range_dir/digest_type"

cat > "$fakebin/http-fetch" <<'EOF_HTTP_FETCH'
#!/bin/sh
url=
for arg
do
  url=$arg
done
case "$url" in
  *'/releases/tags/1.2.3')
    case "${GITHUB_FIXTURE_MODE-normal}" in
      normal)
        digest='"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"'
        ;;
      missing-digest)
        digest='null'
        ;;
      *)
        exit 89
        ;;
    esac
    printf '{"tag_name":"1.2.3","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","assets":['
    printf '{"name":"demo-1.2.3-linux-x86_64.zip","state":"uploaded","size":123,"digest":%s,"browser_download_url":"https://downloads.example.test/demo-1.2.3-linux-x86_64.zip"},' "$digest"
    printf '{"name":"demo-1.2.3-linux-arm64.zip","state":"uploaded","size":456,"digest":"sha256:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB","browser_download_url":"https://downloads.example.test/demo-1.2.3-linux-arm64.zip"},'
    printf '{"name":"demo-1.2.3-source.zip","state":"new","size":789,"digest":"sha256:CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC","browser_download_url":"https://downloads.example.test/demo-1.2.3-source.zip"}'
    printf ']}\n'
    ;;
  *)
    exit 88
    ;;
esac
EOF_HTTP_FETCH
chmod "700" "$fakebin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$fakebin:/usr/bin:/bin"
export PATH
m_LIB_DIR="$root/lib"
export m_LIB_DIR
GITHUB_FIXTURE_MODE="normal"
export GITHUB_FIXTURE_MODE
. "$library" || error "cannot source GitHub repository adapter"

descriptor="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" "1.2.3")" || fail "artifact resolution with SHA-256 metadata failed"
expected="name=demo-1.2.3-linux-x86_64.zip
url=https://downloads.example.test/demo-1.2.3-linux-x86_64.zip
size=123
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
[ "$descriptor" = "$expected" ] || fail "artifact descriptor or SHA-256 normalization is incorrect"

rm "$range_dir/digest_type" || error "cannot remove digest_type fixture"
descriptor="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" "1.2.3")" || fail "artifact resolution without digest requirement failed"
expected="name=demo-1.2.3-linux-x86_64.zip
url=https://downloads.example.test/demo-1.2.3-linux-x86_64.zip
size=123"
[ "$descriptor" = "$expected" ] || fail "digest was emitted when digest_type was absent"

printf -- '%s\n' '^demo-1\.2\.3-linux-.*\.zip$' > "$range_dir/archive_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" "1.2.3" >/dev/null 2>&1
then
  fail "ambiguous archive_regex was accepted"
fi

printf -- '%s\n' '^demo-1\.2\.3-linux-x86_64\.zip$' > "$range_dir/archive_regex"
printf -- '%s\n' "sha256" > "$range_dir/digest_type"
printf -- '%s\n' '^SHA256' > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" "1.2.3" >/dev/null 2>&1
then
  fail "digest_regex was accepted before its contract is implemented"
fi
rm "$range_dir/digest_regex" || error "cannot remove digest_regex fixture"

GITHUB_FIXTURE_MODE="missing-digest"
export GITHUB_FIXTURE_MODE
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" "1.2.3" >/dev/null 2>&1
then
  fail "missing GitHub SHA-256 asset metadata was accepted"
fi

exit "0"
