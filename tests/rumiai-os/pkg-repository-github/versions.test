#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-github/versions.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@c39b1a2c0b6e96e8e43809a6e66d16918cf90a7d:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"

  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac

  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"

  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"

  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"

  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"

  rumiai_test_target_have git || return "3"

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"

  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi

    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done

  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac


library="$root/lib/sh/pkg-repository-github.lib.sh"
[ -f "$library" ] || fail "lib/sh/pkg-repository-github.lib.sh is missing"
[ ! -x "$library" ] || fail "pkg-repository-github.lib.sh must not be executable"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-github-versions-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

repository_dir="$tmp/repository"
ambiguous_repository_dir="$tmp/ambiguous-repository"
fakebin="$tmp/bin"
mkdir "$repository_dir" "$ambiguous_repository_dir" "$fakebin" || error "cannot create fixture directories"
printf -- '%s\n' "github" > "$repository_dir/type"
printf -- '%s\n' "acme" > "$repository_dir/owner"
printf -- '%s\n' "demo" > "$repository_dir/repository"
printf -- '%s\n' "github" > "$ambiguous_repository_dir/type"
printf -- '%s\n' "acme" > "$ambiguous_repository_dir/owner"
printf -- '%s\n' "ambiguous" > "$ambiguous_repository_dir/repository"

cat > "$fakebin/http-fetch" <<'EOF_HTTP_FETCH'
#!/bin/sh
url=
for arg
do
  url=$arg
done

case "$url" in
  *'/repos/acme/ambiguous/releases?per_page=100&page=1')
    printf '%s\n' '[{"tag_name":"same-a","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"},{"tag_name":"same-b","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"}]'
    ;;
  *'/releases?per_page=100&page=1')
    printf '['
    i=1
    while [ "$i" -le 100 ]
    do
      [ "$i" -eq 1 ] || printf ','
      case "$i" in
        1)
          printf '{"tag_name":"v2","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-02T00:00:00Z"}'
          ;;
        2)
          printf '{"tag_name":"draft2","draft":true,"prerelease":false,"created_at":"2026-03-01T00:00:00Z"}'
          ;;
        3)
          printf '{"tag_name":"pre3","draft":false,"prerelease":true,"created_at":"2026-04-01T00:00:00Z"}'
          ;;
        4)
          printf '{"tag_name":"v1b","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-17T00:00:00Z"}'
          ;;
        5)
          printf '{"tag_name":"v1a","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-16T00:00:00Z"}'
          ;;
        *)
          printf '{"tag_name":"draft%s","draft":true,"prerelease":false,"created_at":"2025-01-01T00:00:00Z"}' "$i"
          ;;
      esac
      i=$((i + 1))
    done
    printf ']\n'
    ;;
  *'/releases?per_page=100&page=2')
    printf '%s\n' '[{"tag_name":"v1","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-02T00:00:00Z"}]'
    ;;
  *'/releases/latest')
    printf '%s\n' '{"tag_name":"v2","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z"}'
    ;;
  *'/releases/tags/v1')
    printf '%s\n' '{"tag_name":"v1","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z"}'
    ;;
  *'/releases/tags/v-pre')
    printf '%s\n' '{"tag_name":"v-pre","draft":false,"prerelease":true,"created_at":"2026-01-15T00:00:00Z"}'
    ;;
  *)
    exit 88
    ;;
esac
EOF_HTTP_FETCH
chmod "700" "$fakebin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$fakebin:/usr/bin:/bin"
export PATH
m_LIB_DIR="$root/lib"
export m_LIB_DIR
. "$library" || error "cannot source GitHub repository adapter"

versions="$(pkg_repository_list_versions "$repository_dir")" || fail "pkg_repository_list_versions failed"
expected_versions="v1
v1a
v1b
v2"
[ "$versions" = "$expected_versions" ] || fail "version list was not paged, filtered and ordered by created_at then published_at"

if pkg_repository_list_versions "$ambiguous_repository_dir" >/dev/null 2>&1
then
  fail "releases with identical created_at and published_at were accepted as an ordered succession"
fi

latest="$(pkg_repository_resolve_version "$repository_dir")" || fail "latest version resolution failed"
[ "$latest" = "v2" ] || fail "latest version resolution returned $latest instead of v2"

exact="$(pkg_repository_resolve_version "$repository_dir" "v1")" || fail "exact version resolution failed"
[ "$exact" = "v1" ] || fail "exact version resolution returned $exact instead of v1"

if pkg_repository_resolve_version "$repository_dir" "v-pre" >/dev/null 2>&1
then
  fail "prerelease was accepted as an installable full release"
fi

if pkg_repository_resolve_version "$repository_dir" "bad/version" >/dev/null 2>&1
then
  fail "invalid RumiAI version string was accepted"
fi

exit "0"
