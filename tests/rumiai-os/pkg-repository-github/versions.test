#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-github/versions.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
rumiai_os_group="${test_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac

library="$root/lib/sys/sh/pkg/repository/pkg-repository-github.lib.sh"
[ -f "$library" ] || fail "lib/sys/sh/pkg/repository/pkg-repository-github.lib.sh is missing"
[ ! -x "$library" ] || fail "pkg-repository-github.lib.sh must not be executable"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-github-versions-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

repository_dir="$tmp/repository"
ambiguous_repository_dir="$tmp/ambiguous-repository"
fakebin="$tmp/bin"
mkdir "$repository_dir" "$ambiguous_repository_dir" "$fakebin" || error "cannot create fixture directories"
printf -- '%s\n' "github" > "$repository_dir/type"
printf -- '%s\n' "acme" > "$repository_dir/owner"
printf -- '%s\n' "demo" > "$repository_dir/repository"
printf -- '%s\n' "github" > "$ambiguous_repository_dir/type"
printf -- '%s\n' "acme" > "$ambiguous_repository_dir/owner"
printf -- '%s\n' "ambiguous" > "$ambiguous_repository_dir/repository"

GITHUB_HTTP_LOG="$tmp/http.log"
export GITHUB_HTTP_LOG

cat > "$fakebin/http-fetch" <<'EOF_HTTP_FETCH'
#!/bin/sh
url=
for arg
do
  url=$arg
done
[ -z "${GITHUB_HTTP_LOG-}" ] || printf '%s\n' "$url" >> "$GITHUB_HTTP_LOG"

case "$url" in
  *'/repos/acme/ambiguous/releases?per_page=100&page=1')
    printf '%s\n' '[{"tag_name":"same-a","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"},{"tag_name":"same-b","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"}]'
    ;;
  *'/releases?per_page=100&page=1')
    printf '['
    i=1
    while [ "$i" -le 100 ]
    do
      [ "$i" -eq 1 ] || printf ','
      case "$i" in
        1)
          printf '{"tag_name":"v2","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-02T00:00:00Z"}'
          ;;
        2)
          printf '{"tag_name":"draft2","draft":true,"prerelease":false,"created_at":"2026-03-01T00:00:00Z"}'
          ;;
        3)
          printf '{"tag_name":"pre3","draft":false,"prerelease":true,"created_at":"2026-04-01T00:00:00Z"}'
          ;;
        4)
          printf '{"tag_name":"v1b","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-17T00:00:00Z"}'
          ;;
        5)
          printf '{"tag_name":"v1a","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-16T00:00:00Z"}'
          ;;
        *)
          printf '{"tag_name":"draft%s","draft":true,"prerelease":false,"created_at":"2025-01-01T00:00:00Z"}' "$i"
          ;;
      esac
      i=$((i + 1))
    done
    printf ']\n'
    ;;
  *'/releases?per_page=100&page=2')
    printf '%s\n' '[{"tag_name":"v1","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-02T00:00:00Z"}]'
    ;;
  *'/releases/latest')
    printf '%s\n' '{"tag_name":"v2","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z"}'
    ;;
  *'/releases/tags/v1')
    printf '%s\n' '{"tag_name":"v1","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-02T00:00:00Z"}'
    ;;
  *'/releases/tags/v1a')
    printf '%s\n' '{"tag_name":"v1a","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-16T00:00:00Z"}'
    ;;
  *'/releases/tags/v1b')
    printf '%s\n' '{"tag_name":"v1b","draft":false,"prerelease":false,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-17T00:00:00Z"}'
    ;;
  *'/releases/tags/v2')
    printf '%s\n' '{"tag_name":"v2","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-02T00:00:00Z"}'
    ;;
  *'/releases/tags/same-a')
    printf '%s\n' '{"tag_name":"same-a","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"}'
    ;;
  *'/releases/tags/same-b')
    printf '%s\n' '{"tag_name":"same-b","draft":false,"prerelease":false,"created_at":"2026-01-20T00:00:00Z","published_at":"2026-01-21T00:00:00Z"}'
    ;;
  *'/releases/tags/v-pre')
    printf '%s\n' '{"tag_name":"v-pre","draft":false,"prerelease":true,"created_at":"2026-01-15T00:00:00Z","published_at":"2026-01-16T00:00:00Z"}'
    ;;
  *)
    exit 88
    ;;
esac
EOF_HTTP_FETCH
chmod "700" "$fakebin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$fakebin:/usr/bin:/bin"
export PATH
m_LIB_DIR="$root/lib"
export m_LIB_DIR
. "$library" || error "cannot source GitHub repository adapter"

versions="$(pkg_repository_list_versions "$repository_dir")" || fail "pkg_repository_list_versions failed"
expected_versions="v1
v1a
v1b
v2"
[ "$versions" = "$expected_versions" ] || fail "version list was not paged, filtered and ordered by created_at then published_at"

if pkg_repository_list_versions "$ambiguous_repository_dir" >/dev/null 2>&1
then
  fail "releases with identical created_at and published_at were accepted as an ordered succession"
fi

compare="$(pkg_repository_compare_versions "$repository_dir" "v1" "v2")" || fail "ascending version comparison failed"
[ "$compare" = -1 ] || fail "v1 versus v2 returned $compare instead of -1"

compare="$(pkg_repository_compare_versions "$repository_dir" "v2" "v1")" || fail "descending version comparison failed"
[ "$compare" = 1 ] || fail "v2 versus v1 returned $compare instead of 1"

: > "$GITHUB_HTTP_LOG" || error "cannot reset HTTP log"
compare="$(pkg_repository_compare_versions "$repository_dir" "v1" "v1")" || fail "equal version comparison failed"
[ "$compare" = 0 ] || fail "v1 versus v1 returned $compare instead of 0"
[ ! -s "$GITHUB_HTTP_LOG" ] || fail "equal version comparison performed an unnecessary GitHub API request"

compare="$(pkg_repository_compare_versions "$repository_dir" "v1a" "v1b")" || fail "published_at tie-break comparison failed"
[ "$compare" = -1 ] || fail "v1a versus v1b returned $compare instead of -1"

if pkg_repository_compare_versions "$repository_dir" "same-a" "same-b" >/dev/null 2>&1
then
  fail "distinct releases with identical created_at and published_at were ordered"
fi

if pkg_repository_compare_versions "$repository_dir" "v1" "v-pre" >/dev/null 2>&1
then
  fail "prerelease was accepted by version comparison"
fi

if pkg_repository_compare_versions "$repository_dir" "v1" "missing" >/dev/null 2>&1
then
  fail "missing release was accepted by version comparison"
fi

pkg_repository_compare_versions "$repository_dir" "v1" >/dev/null 2>&1
[ "$?" -eq 2 ] || fail "invalid compare argument count did not return status 2"

latest="$(pkg_repository_resolve_version "$repository_dir")" || fail "latest version resolution failed"
[ "$latest" = "v2" ] || fail "latest version resolution returned $latest instead of v2"

exact="$(pkg_repository_resolve_version "$repository_dir" "v1")" || fail "exact version resolution failed"
[ "$exact" = "v1" ] || fail "exact version resolution returned $exact instead of v1"

if pkg_repository_resolve_version "$repository_dir" "v-pre" >/dev/null 2>&1
then
  fail "prerelease was accepted as an installable full release"
fi

if pkg_repository_resolve_version "$repository_dir" "bad/version" >/dev/null 2>&1
then
  fail "invalid RumiAI version string was accepted"
fi

exit "0"
