#!/bin/sh

TEST_ID=rumiai-os/i18n/resolution-order.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@5af68cbff09ce979df3dff91e398e287eadd48b7:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.

rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok() {
    candidate=$1
    origin=$(git -C "$candidate" config --get remote.origin.url 2>/dev/null) || return 1
    case $origin in
        https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
    esac
    return 1
}
rumiai_test_target_rumiai_os_validate() {
    candidate=$1
    [ -n "$candidate" ] || return 1
    [ -f "$candidate/rumiai-os" ] || return 1
    rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
    target_root=$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P) || return 1
    [ -f "$target_root/rumiai-os" ] || return 1
    printf '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find() {
    start=$1
    rumiai_test_target_have git || return 3
    if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then
        rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
        return 0
    fi
    candidate=$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P) || return 3
    while :; do
        if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
        [ "$candidate" != / ] || break
        parent=${candidate%/*}; [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || break
        candidate=$parent
    done
    return 1
}

resolve_test_dir() {
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

tmp=${TMPDIR:-/tmp}/rumiai-i18n-resolution-$$
umask 077
mkdir -p "$tmp/lang/it_IT/demo" "$tmp/lang/en_US/demo" || error 'cannot create catalog fixture'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

printf '%s\n' 'Messaggio italiano' > "$tmp/lang/it_IT/demo/item" || error 'cannot write selected catalog message'
printf '%s\n' 'English message' > "$tmp/lang/en_US/demo/item" || error 'cannot write fallback catalog message'

RumiAI_LANG_DIR=$tmp/lang
RumiAI_LANGUAGE=it_IT
RumiAI_TEXT_ENCODING=UTF-8
export RumiAI_LANG_DIR RumiAI_LANGUAGE RumiAI_TEXT_ENCODING

. "$root/lib/i18n.lib" || error 'cannot load product i18n.lib'

actual=$(i18n demo item) || fail 'selected-language resolution failed'
[ "$actual" = 'Messaggio italiano' ] || fail 'selected-language catalog was not preferred'

rm -f "$tmp/lang/it_IT/demo/item" || error 'cannot remove selected catalog message'
actual=$(i18n demo item) || fail 'English fallback resolution failed'
[ "$actual" = 'English message' ] || fail 'English catalog was not used as fallback'

rm -f "$tmp/lang/en_US/demo/item" || error 'cannot remove English catalog message'
actual=$(i18n demo item) || fail 'stable identifier fallback failed'
[ "$actual" = 'demo.item' ] || fail 'stable domain.message-id was not used as final fallback'

exit 0
