#!/bin/sh
TEST_ID=rumiai-os/web-analyze/inactive-profile.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
self=${RUMIAI_TEST_SOURCE_PATH:-$0}
case "$self" in */*) :;; *) self=$(command -v "$self") || error 'cannot resolve test' ;; esac
test_dir=$(CDPATH= cd -- "${self%/*}" && pwd -P) || error 'cannot resolve test directory'
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error 'cannot resolve suite root'
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target helper'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in 0) :;; 1) skip 'rumiai-os checkout unavailable';; 2) fail 'invalid target checkout';; *) error 'target discovery failed';; esac
[ -f "$root/lib/sys/js/web-analyze.lib.js" ] || fail 'native recorder library absent'
[ -f "$root/lib/sys/js/web-analyze-rest.lib.js" ] || fail 'rest collector library absent'
command -v node >/dev/null 2>&1 || skip 'Node.js unavailable'
command -v chromium >/dev/null 2>&1 || skip 'Chromium unavailable'
node "$test_dir/.support/inactive-profile.js" "$root" || fail 'profile-persistent inactive ServiceWorker regression failed'
