#!/bin/sh

TEST_ID=rumiai-os/web-analyze/cli.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

self=${RUMIAI_TEST_SOURCE_PATH:-$0}
case "$self" in */*) :;; *) self=$(command -v "$self") || error 'cannot resolve test' ;; esac
test_dir=$(CDPATH= cd -- "${self%/*}" && pwd -P) || error 'cannot resolve test directory'
suite_root=$(CDPATH= cd -- "$test_dir/../../.." && pwd -P) || error 'cannot resolve suite root'
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target helper'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in 0) :;; 1) skip 'rumiai-os checkout unavailable';; 2) fail 'invalid target checkout';; *) error 'target discovery failed';; esac

command -v node >/dev/null 2>&1 || skip 'Node.js unavailable'
node "$test_dir/.support/cli.js" "$root"
status=$?
case $status in
  0) exit 0 ;;
  2) skip 'Chromium or graphical display unavailable for direct CLI scenario' ;;
  *) fail 'web-analyze direct Node.js CLI scenario failed' ;;
esac
