#!/bin/sh
# Direct Keycloak CLI: end-to-end public m command against isolated verified HTTPS.
TEST_ID=rumiai-os/keycloak/cli.test
fail() { printf '%s: FAIL: %s\n' "$TEST_ID" "$*" >&2; exit 1; }
error() { printf '%s: ERROR: %s\n' "$TEST_ID" "$*" >&2; exit 3; }
skip() { printf '%s: SKIP: %s\n' "$TEST_ID" "$*" >&2; exit 2; }
case "$0" in */*) test_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P) ;; *) error 'test path unavailable' ;; esac
suite_root=$(CDPATH= cd "$test_dir/../../.." && pwd -P) || error 'suite root unavailable'
. "$suite_root/lib/rumiai-os-target.lib" || error 'target resolver missing'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
case "$?" in 0) : ;; 1) skip 'product missing' ;; 2) fail 'product invalid' ;; *) error 'target lookup failed' ;; esac
[ -x "$root/bin/sys/keycloak" ] || fail 'public keycloak command not executable'
for command_name in curl jq python3 openssl; do
  command -v "$command_name" >/dev/null 2>&1 || skip "$command_name missing"
done
tmp=/tmp/keycloak-cli-test-$$
umask 077
mkdir "$tmp" || error 'temporary directory unavailable'
pid=
cleanup() { [ -z "$pid" ] || { kill "$pid" 2>/dev/null || :; wait "$pid" 2>/dev/null || :; }; rm -rf "$tmp"; }
trap cleanup 0
trap 'exit 3' HUP INT TERM
openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
  -subj /CN=127.0.0.1 -addext 'subjectAltName=IP:127.0.0.1' \
  -keyout "$tmp/server.key" -out "$tmp/server.pem" \
  >"$tmp/cert.out" 2>"$tmp/cert.err" || error 'test TLS certificate failed'
cat > "$tmp/server.py" <<'PY'
import json
from http.server import BaseHTTPRequestHandler, HTTPServer
import ssl
import sys
from urllib.parse import parse_qs

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass
    def respond(self, status, body=None):
        data = b"" if body is None else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
    def body(self):
        return self.rfile.read(int(self.headers.get("Content-Length", "0")))
    def authorized(self):
        return self.headers.get("Authorization") in (
            "Bearer test-access-token-012345", "Bearer existing-file-token")
    def do_GET(self):
        if self.path == "/realms/master/.well-known/openid-configuration":
            self.respond(200, {"issuer": "https://127.0.0.1"})
        elif self.path == "/admin/realms/master/users?max=2" and self.authorized():
            self.respond(200, {"users": ["alice", "bob"]})
        elif self.path == "/admin/realms/master/forbidden":
            self.respond(403, {"error": "forbidden"})
        else:
            self.respond(401)
    def do_POST(self):
        if self.path == "/realms/master/protocol/openid-connect/token":
            form = parse_qs(self.body().decode())
            if (form.get("grant_type") == ["client_credentials"] and
                form.get("client_id") == ["ops"] and
                form.get("client_secret") == ["fixture protected secret"]):
                self.respond(200, {"access_token": "test-access-token-012345",
                                   "token_type": "Bearer", "expires_in": 60})
            else:
                self.respond(401)
        elif self.path == "/admin/realms/master/users" and self.authorized():
            self.respond(201, {"created": json.loads(self.body()) == {"username":"alice","enabled":True}})
        else:
            self.respond(403)
    def do_PUT(self):
        self.body()
        self.respond(204 if self.authorized() else 403)
    def do_DELETE(self):
        self.respond(204 if self.authorized() else 403)

with HTTPServer(("127.0.0.1", 0), Handler) as server:
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(sys.argv[1], sys.argv[2])
    server.socket = ctx.wrap_socket(server.socket, server_side=True)
    with open(sys.argv[3], "x") as output:
        output.write(str(server.server_address[1]))
    server.serve_forever()
PY
python3 "$tmp/server.py" "$tmp/server.pem" "$tmp/server.key" "$tmp/port" \
  >"$tmp/server.out" 2>"$tmp/server.err" &
pid=$!
tries=0
until [ -s "$tmp/port" ]; do
  kill -0 "$pid" 2>/dev/null || error 'fixture server terminated'
  tries=$((tries+1))
  [ "$tries" -lt 80 ] || error 'fixture server did not start'
  sleep 0.1
done
base=https://127.0.0.1:$(cat "$tmp/port")
printf 'fixture protected secret\n' > "$tmp/secret"
printf 'wrong secret\n' > "$tmp/invalid"
printf 'existing-file-token\n' > "$tmp/token"
printf '{"username":"alice","enabled":true}\n' > "$tmp/user.json"
chmod 600 "$tmp/secret" "$tmp/invalid" "$tmp/token"
invoke() {
  "$root/m" keycloak admin --server "$base" --realm master \
    --client-id ops --client-secret-file "$tmp/secret" \
    --ca-file "$tmp/server.pem" "$@"
}
invoke get '/admin/realms/master/users?max=2' >"$tmp/out" 2>"$tmp/err" ||
  fail "real HTTPS GET: $(cat "$tmp/err")"
jq -e '.users == ["alice","bob"]' "$tmp/out" >/dev/null ||
  fail 'GET result invalid'
invoke post /admin/realms/master/users --data-file "$tmp/user.json" >"$tmp/out" 2>"$tmp/err" ||
  fail "real HTTPS POST: $(cat "$tmp/err")"
jq -e '.created == true' "$tmp/out" >/dev/null || fail 'POST JSON invalid'
invoke put /admin/realms/master/users/id --data-file "$tmp/user.json" >"$tmp/out" 2>"$tmp/err" ||
  fail "real HTTPS PUT: $(cat "$tmp/err")"
[ ! -s "$tmp/out" ] || fail 'PUT unexpectedly returned content'
invoke delete /admin/realms/master/users/id >"$tmp/out" 2>"$tmp/err" ||
  fail "real HTTPS DELETE: $(cat "$tmp/err")"
[ ! -s "$tmp/out" ] || fail 'DELETE unexpectedly returned content'
"$root/m" keycloak admin --server "$base" --realm master --ca-file "$tmp/server.pem" \
  discovery >"$tmp/out" 2>"$tmp/err" ||
  fail "real HTTPS discovery: $(cat "$tmp/err")"
jq -e '.issuer == "https://127.0.0.1"' "$tmp/out" >/dev/null ||
  fail 'discovery output invalid'
"$root/m" keycloak admin --server "$base" --realm master \
  --token-file "$tmp/token" --ca-file "$tmp/server.pem" \
  get '/admin/realms/master/users?max=2' >"$tmp/out" 2>"$tmp/err" ||
  fail "existing bearer token: $(cat "$tmp/err")"
jq -e '.users | length == 2' "$tmp/out" >/dev/null ||
  fail 'token file not honored'
invoke get /admin/realms/master/forbidden >"$tmp/out" 2>"$tmp/err"
[ "$?" -eq 8 ] && [ ! -s "$tmp/out" ] &&
  grep -F 'HTTP 403' "$tmp/err" >/dev/null ||
  fail 'Admin REST 403 not handled'
"$root/m" keycloak admin --server "$base" --realm master --client-id ops \
  --client-secret-file "$tmp/invalid" --ca-file "$tmp/server.pem" \
  get /admin/realms/master/users >"$tmp/out" 2>"$tmp/err"
[ "$?" -eq 6 ] && grep -F 'HTTP 401' "$tmp/err" >/dev/null ||
  fail 'OAuth invalid_client not rejected'
chmod 644 "$tmp/secret"
invoke get /admin/realms/master/users >"$tmp/out" 2>"$tmp/err"
[ "$?" -eq 4 ] || fail 'world-readable client secret accepted'
chmod 600 "$tmp/secret"
invoke get /realms/master >"$tmp/out" 2>"$tmp/err"
[ "$?" -eq 2 ] || fail 'non-Admin REST path accepted'
"$root/m" keycloak admin --server "http://127.0.0.1:1234" --realm master \
  discovery >"$tmp/out" 2>"$tmp/err"
[ "$?" -eq 2 ] || fail 'HTTP Keycloak URL accepted'
for marker in 'fixture protected secret' 'test-access-token-012345'; do
  grep -F "$marker" "$tmp/err" >/dev/null &&
    fail 'secret was disclosed in diagnostics'
done
mkdir -p "$tmp/package-bin" || error 'package launcher fixture unavailable'
cat > "$tmp/package-bin/keycloak" <<'PACKAGE'
#!/bin/sh
printf '%s\n' "$*" 
PACKAGE
chmod 700 "$tmp/package-bin/keycloak" ||
  error 'package launcher fixture not executable'
delegated=$(m_ROOT="$root" m_BIN_EXT_DIR="$tmp/package-bin" \
  "$root/bin/sys/keycloak" start-dev --db=dev-mem) ||
  fail 'existing server package launcher was not preserved'
[ "$delegated" = 'start-dev --db=dev-mem' ] ||
  fail 'server package CLI arguments were changed by admin wrapper'
printf '%s: PASS (public m keycloak, verified TLS, OAuth and Admin REST)\n' "$TEST_ID"
