#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-netbeans/contract.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg-repository-netbeans.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "NetBeans repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "NetBeans repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-netbeans-contract-$$"
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository_dir="$tmp/repository"
range_dir="$tmp/range"

write_valid_repository()
{
  rm -rf "$repository_dir"
  mkdir "$repository_dir" || error "cannot recreate repository descriptor"
  printf -- '%s\n' netbeans > "$repository_dir/type"
  printf -- '%s\n' apache > "$repository_dir/owner"
  printf -- '%s\n' netbeans > "$repository_dir/repository"
}
write_valid_range()
{
  rm -rf "$range_dir"
  mkdir "$range_dir" || error "cannot recreate range descriptor"
  printf -- '%s\n' '^netbeans-[A-Za-z0-9][A-Za-z0-9._+~-]*-bin\.zip$' > "$range_dir/archive_regex"
  printf -- '%s\n' sha512 > "$range_dir/digest_type"
}

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
printf -- '%s\n' "$*" >> "$NETBEANS_HTTP_LOG"
for url do :; done
length=0
for arg do [ "$arg" = -l ] && length=1; done
case "$url" in
  https://api.github.com/repos/apache/netbeans/releases/latest)
    printf '%s\n' '{"tag_name":"99","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z"}'
    ;;
  https://api.github.com/repos/apache/netbeans/releases/tags/31)
    printf '%s\n' '{"tag_name":"31","draft":false,"prerelease":false,"created_at":"2026-08-05T12:14:47Z","published_at":"2026-08-10T09:41:42Z"}'
    ;;
  https://api.github.com/repos/apache/netbeans/releases/tags/100)
    printf '%s\n' '{"tag_name":"100","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-02T00:00:00Z"}'
    ;;
  https://api.github.com/repos/apache/netbeans/releases/tags/99)
    printf '%s\n' '{"tag_name":"99","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-02T00:00:00Z"}'
    ;;
  'https://api.github.com/repos/apache/netbeans/releases?per_page=100&page=1')
    printf '%s\n' '[{"tag_name":"99","draft":false,"prerelease":false,"created_at":"2026-02-01T00:00:00Z","published_at":"2026-02-02T00:00:00Z"},{"tag_name":"preview","draft":false,"prerelease":true,"created_at":"2026-03-01T00:00:00Z","published_at":"2026-03-02T00:00:00Z"},{"tag_name":"hidden","draft":true,"prerelease":false,"created_at":"2026-04-01T00:00:00Z","published_at":"2026-04-02T00:00:00Z"},{"tag_name":"100","draft":false,"prerelease":false,"created_at":"2026-01-01T00:00:00Z","published_at":"2026-01-02T00:00:00Z"}]'
    ;;
  https://dlcdn.apache.org/netbeans/netbeans/31/netbeans-31-bin.zip.sha512)
    case "${NETBEANS_SIDECAR_MODE-ok}" in
      ok) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  ./netbeans-31-bin.zip';;
      wrong-name) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  ./other.zip';;
      duplicate) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  ./netbeans-31-bin.zip' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  netbeans-31-bin.zip';;
      bad-digest) printf '%s\n' 'aaaa  ./netbeans-31-bin.zip';;
    esac
    ;;
  https://dlcdn.apache.org/netbeans/netbeans/31/netbeans-31-bin.zip)
    [ "$length" -eq 1 ] || exit 89
    printf -- '%s\n' 123456789
    ;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
NETBEANS_HTTP_LOG="$tmp/http.log"; export NETBEANS_HTTP_LOG
. "$library" || error "cannot source NetBeans repository adapter"

write_valid_repository
[ "$(pkg_repository_resolve_version "$repository_dir")" = 99 ] || fail "valid descriptor/latest resolution failed"

for field_value in 'type github' 'owner other' 'repository other'
do
  set -- $field_value
  write_valid_repository
  printf -- '%s\n' "$2" > "$repository_dir/$1"
  if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "invalid $1 was accepted"; fi
done
write_valid_repository
printf -- '%s\n' unexpected > "$repository_dir/extra"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unknown repository field was accepted"; fi
write_valid_repository
chmod 700 "$repository_dir/owner" || error "cannot change scalar mode"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "executable repository scalar was accepted"; fi
write_valid_repository
printf -- '%s' apache > "$repository_dir/owner"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unterminated repository scalar was accepted"; fi

write_valid_repository
[ "$(pkg_repository_resolve_version "$repository_dir" 100)" = 100 ] || fail "exact release resolution failed"
expected_versions='100
99'
[ "$(pkg_repository_list_versions "$repository_dir")" = "$expected_versions" ] || fail "list_versions did not filter/order full releases"
[ "$(pkg_repository_compare_versions "$repository_dir" 100 99)" = -1 ] || fail "compare_versions interpreted numeric-looking tags"
[ "$(pkg_repository_compare_versions "$repository_dir" 99 100)" = 1 ] || fail "reverse compare_versions is incorrect"
[ "$(pkg_repository_compare_versions "$repository_dir" 100 100)" = 0 ] || fail "equal compare_versions is incorrect"

write_valid_range
NETBEANS_SIDECAR_MODE=ok; export NETBEANS_SIDECAR_MODE
: > "$NETBEANS_HTTP_LOG"
out="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 31)" || fail "valid artifact resolution failed"
expected_descriptor='name=netbeans-31-bin.zip
url=https://dlcdn.apache.org/netbeans/netbeans/31/netbeans-31-bin.zip
size=123456789
digest=sha512:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
[ "$out" = "$expected_descriptor" ] || fail "artifact descriptor is incorrect"
grep -F -- 'https://api.github.com/repos/apache/netbeans/releases/tags/31' "$NETBEANS_HTTP_LOG" >/dev/null || fail "exact GitHub release was not verified"
grep -F -- 'https://dlcdn.apache.org/netbeans/netbeans/31/netbeans-31-bin.zip.sha512' "$NETBEANS_HTTP_LOG" >/dev/null || fail "SHA-512 sidecar URL is incorrect"
grep -F -- '-l -- https://dlcdn.apache.org/netbeans/netbeans/31/netbeans-31-bin.zip' "$NETBEANS_HTTP_LOG" >/dev/null || fail "size did not use http-fetch -l on binary URL"

for mode in wrong-name duplicate bad-digest
do
  NETBEANS_SIDECAR_MODE=$mode; export NETBEANS_SIDECAR_MODE
  if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 31 >/dev/null 2>&1; then fail "$mode sidecar was accepted"; fi
done
NETBEANS_SIDECAR_MODE=ok; export NETBEANS_SIDECAR_MODE
printf -- '%s\n' sha256 > "$range_dir/digest_type"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 31 >/dev/null 2>&1; then fail "non-SHA-512 range was accepted"; fi
write_valid_range
printf -- '%s\n' '.*' > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 31 >/dev/null 2>&1; then fail "digest_regex was accepted"; fi
write_valid_range
printf -- '%s\n' '^other\.zip$' > "$range_dir/archive_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 31 >/dev/null 2>&1; then fail "non-matching archive_regex was accepted"; fi

exit 0
