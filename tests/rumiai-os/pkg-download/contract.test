#!/bin/sh

TEST_ID="rumiai-os/pkg-download/contract.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac
  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"
  rumiai_test_target_have git || return "3"
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi
    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done
  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*) :;;
    *) self="$(command -v "$self" 2>/dev/null)" || return "1";;
  esac
  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0") :;;
  "1") skip "rumiai-os target checkout not found";;
  "2") fail "invalid explicit rumiai-os target";;
  *) error "target discovery failed";;
esac

library="$root/lib/sh/pkg-download.lib.sh"
[ -f "$library" ] || fail "lib/sh/pkg-download.lib.sh is missing"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-download-contract-$$"
umask "077"
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fakebin="$tmp/bin"
mkdir "$fakebin" || error "cannot create fake backend directory"

cat > "$fakebin/http-fetch" <<'EOF_FETCH'
#!/bin/sh
output=
while [ "$#" -gt 0 ]
do
  if [ "$1" = "-o" ]
  then
    shift
    output=$1
  fi
  shift
done
[ -n "$output" ] || exit 90
case "${PKG_DOWNLOAD_FETCH_MODE-ok}" in
  ok) printf -- '%s' 'payload' > "$output";;
  short) printf -- '%s' 'x' > "$output";;
  fail) printf -- '%s' 'partial' > "$output"; exit 9;;
esac
EOF_FETCH
chmod "700" "$fakebin/http-fetch"

cat > "$fakebin/digest" <<'EOF_DIGEST'
#!/bin/sh
printf -- '%s\n' "$*" > "$PKG_DOWNLOAD_DIGEST_ARGS"
case "${PKG_DOWNLOAD_DIGEST_MODE-ok}" in
  ok) printf -- '%s\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';;
  mismatch) printf -- '%s\n' 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';;
  fail) exit 7;;
esac
EOF_DIGEST
chmod "700" "$fakebin/digest"

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  eval "$1=\$(CDPATH= cd -- \"\$2\" 2>/dev/null && pwd -P)"
}
log()
{
  :
}

PATH="$fakebin:/usr/bin:/bin"
export PATH
PKG_DOWNLOAD_DIGEST_ARGS="$tmp/digest.args"
export PKG_DOWNLOAD_DIGEST_ARGS
. "$library" || error "cannot source pkg-download library"

run_download()
{
  stage="$1"
  descriptor="$2"
  printf -- '%s' "$descriptor" | pkg_download "$stage"
}

stage="$tmp/stage"
mkdir "$stage"
stage_canonical="$(CDPATH= cd -- "$stage" 2>/dev/null && pwd -P)" || error "cannot canonicalize staging fixture"
artifact_path="$stage_canonical/artifact.bin"
PKG_DOWNLOAD_FETCH_MODE=ok
PKG_DOWNLOAD_DIGEST_MODE=ok
export PKG_DOWNLOAD_FETCH_MODE PKG_DOWNLOAD_DIGEST_MODE
out="$(run_download "$stage" 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
')" || fail "valid download failed"
[ "$out" = "$artifact_path" ] || fail "pkg_download returned incorrect pathname"
[ "$(cat "$PKG_DOWNLOAD_DIGEST_ARGS")" = "-a sha256 -- $artifact_path" ] || fail "pkg_download did not delegate SHA-256 to digest"

rm "$artifact_path"
PKG_DOWNLOAD_FETCH_MODE=short
export PKG_DOWNLOAD_FETCH_MODE
if run_download "$stage" 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
' >/dev/null 2>&1
then
  fail "size mismatch was accepted"
fi
[ ! -e "$artifact_path" ] || fail "size mismatch left target behind"

PKG_DOWNLOAD_FETCH_MODE=ok
PKG_DOWNLOAD_DIGEST_MODE=mismatch
export PKG_DOWNLOAD_FETCH_MODE PKG_DOWNLOAD_DIGEST_MODE
if run_download "$stage" 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
' >/dev/null 2>&1
then
  fail "digest mismatch was accepted"
fi
[ ! -e "$artifact_path" ] || fail "digest mismatch left target behind"

PKG_DOWNLOAD_DIGEST_MODE=fail
export PKG_DOWNLOAD_DIGEST_MODE
if run_download "$stage" 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
' >/dev/null 2>&1
then
  fail "digest backend failure was accepted"
fi
[ ! -e "$artifact_path" ] || fail "digest failure left target behind"

PKG_DOWNLOAD_FETCH_MODE=fail
export PKG_DOWNLOAD_FETCH_MODE
if run_download "$stage" 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
' >/dev/null 2>&1
then
  fail "transfer failure was accepted"
fi
[ ! -e "$artifact_path" ] || fail "transfer failure left target behind"

if run_download "$stage" 'name=../escape
url=https://example.test/x
size=1
' >/dev/null 2>&1
then
  fail "non-basename artifact name was accepted"
fi

if run_download "$stage" 'name=x
name=y
url=https://example.test/x
size=1
' >/dev/null 2>&1
then
  fail "duplicate descriptor field was accepted"
fi

if run_download "$stage" 'name=x
url=https://example.test/x
size=1
unknown=value
' >/dev/null 2>&1
then
  fail "unknown descriptor field was accepted"
fi

exit "0"
