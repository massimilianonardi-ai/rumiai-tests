#!/bin/sh

TEST_ID=rumiai-os/pkg-download/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

expect_status()
{
  expected=$1
  label=$2
  shift 2
  "$@" > "$tmp/$label.out" 2> "$tmp/$label.err"
  actual=$?
  [ "$actual" -eq "$expected" ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $actual instead of $expected"
  }
}

expect_descriptor_failure()
{
  label=$1
  descriptor=$2
  "$root/m" "$driver" "$stage" < "$descriptor" > "$tmp/$label.out" 2> "$tmp/$label.err"
  status=$?
  [ "$status" -eq 1 ] || {
    cat "$tmp/$label.err" >&2
    fail "$label returned $status instead of 1"
  }
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_os_group=${test_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

library=$root/lib/sys/sh/pkg/pkg-download.lib.sh
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] ||
  fail 'pkg-download library is missing or has invalid mode'

tmp=${TMPDIR:-/tmp}/rumiai-pkg-download-contract-$$
umask 077
mkdir "$tmp" "$tmp/stage" || error 'cannot create temporary directories'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
stage=$tmp/stage

driver=$tmp/pkg-download-driver
cat > "$driver" <<'EOF_DRIVER'
. "$m_LIB_DIR/sys/sh/pkg-download.lib.sh" || exit 3
pkg_download "$@"
EOF_DRIVER
chmod 600 "$driver" || error 'cannot prepare pkg-download driver'

expect_status 2 arity "$root/m" "$driver"

descriptor=$tmp/non-basename
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=../escape
url=https://example.invalid/artifact
size=1
EOF_DESCRIPTOR
expect_descriptor_failure non-basename "$descriptor"

descriptor=$tmp/duplicate
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
name=y
url=https://example.invalid/x
size=1
EOF_DESCRIPTOR
expect_descriptor_failure duplicate "$descriptor"

descriptor=$tmp/unknown
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
size=1
unknown=value
EOF_DESCRIPTOR
expect_descriptor_failure unknown "$descriptor"

descriptor=$tmp/missing
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
EOF_DESCRIPTOR
expect_descriptor_failure missing "$descriptor"

descriptor=$tmp/url
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=file:///tmp/x
size=1
EOF_DESCRIPTOR
expect_descriptor_failure url "$descriptor"

descriptor=$tmp/size
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
size=01
EOF_DESCRIPTOR
expect_descriptor_failure size "$descriptor"

descriptor=$tmp/digest-algorithm
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
size=1
digest=crc32c:aaaaaaaa
EOF_DESCRIPTOR
expect_descriptor_failure digest-algorithm "$descriptor"

descriptor=$tmp/md5-length
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
size=1
digest=md5:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EOF_DESCRIPTOR
expect_descriptor_failure md5-length "$descriptor"

descriptor=$tmp/sha256-hex
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=x
url=https://example.invalid/x
size=1
digest=sha256:gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg
EOF_DESCRIPTOR
expect_descriptor_failure sha256-hex "$descriptor"

short_sha512=$(printf '%0127d' 0 | tr 0 a)
descriptor=$tmp/sha512-length
printf 'name=x\nurl=https://example.invalid/x\nsize=1\ndigest=sha512:%s\n' "$short_sha512" > "$descriptor" ||
  error 'cannot prepare SHA-512 descriptor'
expect_descriptor_failure sha512-length "$descriptor"

descriptor=$tmp/not-lf-terminated
printf '%s' 'name=x
url=https://example.invalid/x
size=1' > "$descriptor" || error 'cannot prepare unterminated descriptor'
expect_descriptor_failure not-lf-terminated "$descriptor"

printf '%s\n' keep > "$stage/existing" || error 'cannot create existing target'
descriptor=$tmp/target-exists
cat > "$descriptor" <<'EOF_DESCRIPTOR'
name=existing
url=https://example.invalid/x
size=1
EOF_DESCRIPTOR
expect_descriptor_failure target-exists "$descriptor"
[ "$(cat "$stage/existing")" = keep ] || fail 'existing download target was modified'

exit 0
