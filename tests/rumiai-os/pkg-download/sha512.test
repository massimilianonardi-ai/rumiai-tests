#!/bin/sh

TEST_ID="rumiai-os/pkg-download/sha512.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg-download.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "pkg-download library is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "pkg-download library is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-download-sha512-$$"
umask 077
mkdir "$tmp" "$tmp/bin" "$tmp/stage" || error "cannot create temporary directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

cat > "$tmp/bin/http-fetch" <<'EOF_FETCH'
#!/bin/sh
output=
while [ "$#" -gt 0 ]
do
  if [ "$1" = -o ]; then shift; output=$1; fi
  shift
done
[ -n "$output" ] || exit 90
printf -- '%s' payload > "$output"
EOF_FETCH
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

cat > "$tmp/bin/digest" <<'EOF_DIGEST'
#!/bin/sh
printf -- '%s\n' "$*" > "$PKG_DOWNLOAD_SHA512_ARGS"
[ "$#" -eq 4 ] && [ "$1" = -a ] && [ "$2" = sha512 ] && [ "$3" = -- ] || exit 91
case "${PKG_DOWNLOAD_SHA512_MODE-ok}" in
  ok) printf -- '%s\n' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;;
  mismatch) printf -- '%s\n' bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb;;
  fail) exit 7;;
esac
EOF_DIGEST
chmod 700 "$tmp/bin/digest" || error "cannot make fake digest executable"

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  eval "$1=\$(CDPATH= cd -- \"\$2\" 2>/dev/null && pwd -P)"
}
log() { :; }

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
PKG_DOWNLOAD_SHA512_ARGS="$tmp/digest.args"; export PKG_DOWNLOAD_SHA512_ARGS
. "$library" || error "cannot source pkg-download library"

stage="$tmp/stage"
stage_canonical="$(CDPATH= cd -- "$stage" 2>/dev/null && pwd -P)" || error "cannot canonicalize staging fixture"
artifact="$stage_canonical/artifact.bin"
digest_upper='AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
descriptor="name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=sha512:$digest_upper
"

PKG_DOWNLOAD_SHA512_MODE=ok; export PKG_DOWNLOAD_SHA512_MODE
out="$(printf -- '%s' "$descriptor" | pkg_download "$stage")" || fail "valid SHA-512 descriptor failed"
[ "$out" = "$artifact" ] || fail "pkg_download returned incorrect pathname"
[ "$(cat "$PKG_DOWNLOAD_SHA512_ARGS")" = "-a sha512 -- $artifact" ] || fail "pkg_download did not delegate SHA-512 to digest"
rm "$artifact" || error "cannot remove successful artifact fixture"

PKG_DOWNLOAD_SHA512_MODE=mismatch; export PKG_DOWNLOAD_SHA512_MODE
if printf -- '%s' "$descriptor" | pkg_download "$stage" >/dev/null 2>&1; then fail "SHA-512 mismatch was accepted"; fi
[ ! -e "$artifact" ] || fail "SHA-512 mismatch left target behind"

PKG_DOWNLOAD_SHA512_MODE=fail; export PKG_DOWNLOAD_SHA512_MODE
if printf -- '%s' "$descriptor" | pkg_download "$stage" >/dev/null 2>&1; then fail "SHA-512 backend failure was accepted"; fi
[ ! -e "$artifact" ] || fail "SHA-512 backend failure left target behind"

short_digest=$(printf '%0127d' 0 | tr 0 a)
if printf -- 'name=artifact.bin\nurl=https://example.test/artifact.bin\nsize=7\ndigest=sha512:%s\n' "$short_digest" | pkg_download "$stage" >/dev/null 2>&1; then fail "127-hex SHA-512 descriptor was accepted"; fi

exit 0
