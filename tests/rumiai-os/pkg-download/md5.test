#!/bin/sh

TEST_ID="rumiai-os/pkg-download/md5.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0;;
  esac
  return 1
}
rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/m" ] && [ -f "$candidate/rumiai-os" ] && [ -f "$candidate/rumiai-os-sh" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/m" ] && [ -f "$target_root/rumiai-os" ] && [ -f "$target_root/rumiai-os-sh" ] || return 1
  printf -- '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}; [ -n "$parent" ] || parent=/; [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}
resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg-download.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "pkg-download library is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "pkg-download library is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-download-md5-$$"
umask 077
mkdir "$tmp" "$tmp/bin" "$tmp/stage" || error "cannot create temporary directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM

cat > "$tmp/bin/http-fetch" <<'EOF_FETCH'
#!/bin/sh
output=
while [ "$#" -gt 0 ]
do
  if [ "$1" = -o ]
  then
    shift
    output=$1
  fi
  shift
done
[ -n "$output" ] || exit 90
printf -- '%s' payload > "$output"
EOF_FETCH
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

cat > "$tmp/bin/digest" <<'EOF_DIGEST'
#!/bin/sh
printf -- '%s\n' "$*" > "$PKG_DOWNLOAD_MD5_ARGS"
[ "$#" -eq 4 ] && [ "$1" = -a ] && [ "$2" = md5 ] && [ "$3" = -- ] || exit 91
case "${PKG_DOWNLOAD_MD5_MODE-ok}" in
  ok) printf -- '%s\n' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;;
  mismatch) printf -- '%s\n' bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb;;
  fail) exit 7;;
esac
EOF_DIGEST
chmod 700 "$tmp/bin/digest" || error "cannot make fake digest executable"

readpathce()
{
  [ "$#" -eq 2 ] || return 2
  eval "$1=\$(CDPATH= cd -- \"\$2\" 2>/dev/null && pwd -P)"
}
log() { :; }

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
PKG_DOWNLOAD_MD5_ARGS="$tmp/digest.args"; export PKG_DOWNLOAD_MD5_ARGS
. "$library" || error "cannot source pkg-download library"

stage="$tmp/stage"
stage_canonical="$(CDPATH= cd -- "$stage" 2>/dev/null && pwd -P)" || error "cannot canonicalize staging fixture"
artifact="$stage_canonical/artifact.bin"

descriptor='name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=md5:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
'

PKG_DOWNLOAD_MD5_MODE=ok; export PKG_DOWNLOAD_MD5_MODE
out="$(printf -- '%s' "$descriptor" | pkg_download "$stage")" || fail "valid MD5 download descriptor failed"
[ "$out" = "$artifact" ] || fail "pkg_download returned incorrect MD5 pathname"
[ "$(cat "$PKG_DOWNLOAD_MD5_ARGS")" = "-a md5 -- $artifact" ] || fail "pkg_download did not delegate MD5 to digest"
rm "$artifact" || error "cannot remove successful artifact fixture"

PKG_DOWNLOAD_MD5_MODE=mismatch; export PKG_DOWNLOAD_MD5_MODE
if printf -- '%s' "$descriptor" | pkg_download "$stage" >/dev/null 2>&1
then
  fail "MD5 mismatch was accepted"
fi
[ ! -e "$artifact" ] || fail "MD5 mismatch left target behind"

PKG_DOWNLOAD_MD5_MODE=fail; export PKG_DOWNLOAD_MD5_MODE
if printf -- '%s' "$descriptor" | pkg_download "$stage" >/dev/null 2>&1
then
  fail "MD5 backend failure was accepted"
fi
[ ! -e "$artifact" ] || fail "MD5 backend failure left target behind"

if printf -- '%s' 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=md5:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
' | pkg_download "$stage" >/dev/null 2>&1
then
  fail "31-hex MD5 descriptor was accepted"
fi

if printf -- '%s' 'name=artifact.bin
url=https://example.test/artifact.bin
size=7
digest=crc32c:aaaaaaaa
' | pkg_download "$stage" >/dev/null 2>&1
then
  fail "unsupported digest algorithm was accepted"
fi

exit 0
