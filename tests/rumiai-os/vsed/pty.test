#!/bin/sh

TEST_ID=rumiai-os/vsed/pty.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

directory_names()
{
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*
  do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    printf '%s\n' "${entry##*/}"
  done | LC_ALL=C sort
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
vsed_group=${test_dir%/*}
rumiai_os_group=${vsed_group%/*}
suite_root=${rumiai_os_group%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

command_path=$root/bin/sys/vsed
m_path=$root/m
[ -x "$command_path" ] || fail 'vsed command is unavailable'
[ -x "$m_path" ] || fail 'm bootstrap is unavailable'

command -v uname >/dev/null 2>&1 || skip 'uname is unavailable'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput cols >/dev/null 2>&1 ||
  skip 'xterm-256color terminfo entry is unavailable'
export TERM=xterm-256color

tmp=${TMPDIR:-/tmp}/rumiai-vsed-pty-$$
umask 077
mkdir -p "$tmp/files" || error 'cannot create test workspace'

system=$(uname -s 2>/dev/null) || error 'cannot determine host system'

case $system in
  Linux)
    command -v python3 >/dev/null 2>&1 ||
      skip 'python3 is unavailable for Linux PTY support'

    python3 - "$m_path" "$command_path" "$tmp" <<'PY_LINUX'
import os
import pty
import select
import stat
import sys
import termios
import time

m_path, command_path, base = sys.argv[1:4]
base_env = os.environ.copy()
base_env["TERM"] = "xterm-256color"


def run_vsed(initial=b"", keys=b"\x18", file_path=None, timeout=5.0, stdin_terminal=False):
    in_r = in_w = None
    if not stdin_terminal:
        in_r, in_w = os.pipe()

    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    pid, master = pty.fork()

    if pid == 0:
        if not stdin_terminal:
            os.dup2(in_r, 0)
        os.dup2(out_w, 1)
        os.dup2(err_w, 2)

        fds = [out_r, out_w, err_r, err_w]
        if not stdin_terminal:
            fds.extend([in_r, in_w])
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass

        argv = [m_path, command_path]
        if file_path is not None:
            argv.append(file_path)
        os.execve(m_path, argv, base_env)

    os.close(out_w)
    os.close(err_w)

    if not stdin_terminal:
        os.close(in_r)
        os.write(in_w, initial)
        os.close(in_w)

    screen = bytearray()
    out = bytearray()
    err = bytearray()
    deadline_setup = time.monotonic() + 3.0
    ready_for_keys = False
    setup_status = None

    while time.monotonic() < deadline_setup:
        ready, _, _ = select.select([master, out_r, err_r], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == master:
                screen.extend(chunk)
            elif fd == out_r:
                out.extend(chunk)
            else:
                err.extend(chunk)

        if b"^X save" in screen:
            ready_for_keys = True
            break

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            setup_status = os.waitstatus_to_exitcode(wait_status)
            break

    if not ready_for_keys:
        if setup_status is None:
            os.kill(pid, 9)
            os.waitpid(pid, 0)
        raise AssertionError((
            "vsed did not enter interactive screen",
            setup_status,
            bytes(out),
            bytes(err),
            bytes(screen),
        ))

    os.write(master, keys)

    deadline = time.monotonic() + timeout
    status = None

    while time.monotonic() < deadline:
        ready, _, _ = select.select([out_r, err_r, master], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == out_r:
                out.extend(chunk)
            elif fd == err_r:
                err.extend(chunk)
            else:
                screen.extend(chunk)

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = os.waitstatus_to_exitcode(wait_status)
            break

    if status is None:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError("vsed timed out")

    time.sleep(0.03)
    for fd, target in ((out_r, out), (err_r, err)):
        while True:
            ready, _, _ = select.select([fd], [], [], 0)
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            target.extend(chunk)

    attrs = termios.tcgetattr(master)
    lflag = attrs[3]
    restored = bool(lflag & termios.ICANON) and bool(lflag & termios.ECHO)

    os.close(out_r)
    os.close(err_r)
    os.close(master)
    return status, bytes(out), bytes(err), restored


status, out, err, restored = run_vsed(b"alpha\tbeta\n\nsecond\n", b"\x18")
assert status == 0, (status, out, err)
assert out == b"alpha\tbeta\n\nsecond\n", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after stream save"

# No-operand invocation with terminal stdin must start from an empty buffer.
status, out, err, restored = run_vsed(keys=b"N\x18", stdin_terminal=True)
assert status == 0, (status, out, err)
assert out == b"N", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after empty interactive save"

status, out, err, restored = run_vsed(b"a\nb", b"X\nY\x18")
assert status == 0, (status, out, err)
assert out == b"X\nYa\nb", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after edited stream save"

file_path = os.path.join(base, "files", "secret.txt")
with open(file_path, "wb") as f:
    f.write(b"abc\nxyz")
before_names = sorted(os.listdir(os.path.dirname(file_path)))
status, out, err, restored = run_vsed(b"", b"Q\x18", file_path=file_path)
assert status == 0, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after file save"
with open(file_path, "rb") as f:
    assert f.read() == b"Qabc\nxyz"
assert sorted(os.listdir(os.path.dirname(file_path))) == before_names, \
    "file save created collateral files"

# A missing file operand starts empty and is created only on save.
new_path = os.path.join(base, "files", "new.txt")
assert not os.path.lexists(new_path)
status, out, err, restored = run_vsed(b"", b"N\x18", file_path=new_path)
assert status == 0, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after new-file save"
with open(new_path, "rb") as f:
    assert f.read() == b"N"
assert stat.S_IMODE(os.stat(new_path).st_mode) == 0o600, \
    oct(stat.S_IMODE(os.stat(new_path).st_mode))

empty_path = os.path.join(base, "files", "empty.txt")
assert not os.path.lexists(empty_path)
status, out, err, restored = run_vsed(b"", b"\x18", file_path=empty_path)
assert status == 0, (status, out, err)
assert os.path.isfile(empty_path)
assert os.path.getsize(empty_path) == 0
assert stat.S_IMODE(os.stat(empty_path).st_mode) == 0o600, \
    oct(stat.S_IMODE(os.stat(empty_path).st_mode))

cancel_new_path = os.path.join(base, "files", "cancel-new.txt")
assert not os.path.lexists(cancel_new_path)
status, out, err, restored = run_vsed(b"", b"X\x1b", file_path=cancel_new_path)
assert status == 1, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after new-file cancel"
assert not os.path.lexists(cancel_new_path), "cancel created the new-file pathname"

with open(file_path, "wb") as f:
    f.write(b"sensitive")
before_names = sorted(os.listdir(os.path.dirname(file_path)))
status, out, err, restored = run_vsed(b"", b"X\x1b", file_path=file_path)
assert status == 1, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after cancel"
with open(file_path, "rb") as f:
    assert f.read() == b"sensitive"
assert sorted(os.listdir(os.path.dirname(file_path))) == before_names, \
    "cancel created collateral files"
PY_LINUX
    status=$?
    [ "$status" -eq 0 ] || fail 'Linux PTY editing validation failed'
    ;;

  Darwin)
    command -v expect >/dev/null 2>&1 ||
      skip 'expect is unavailable for Darwin TTY support'

    driver=$tmp/vsed-driver
    cat > "$driver" <<'EOF_DRIVER'
#!/bin/sh

tty_state()
{
  state=$(stty -g) || return 1

  case $state in
    *:lflag=*:oflag=*)
      prefix=${state%%:lflag=*}
      rest=${state#*:lflag=}
      lflag_hex=${rest%%:*}
      suffix=${rest#*:}
      lflag_dec=$(printf '%d' "0x$lflag_hex" 2>/dev/null) || return 1

      # Darwin PENDIN (0x20000000) is a kernel-managed transient state flag.
      # Ignore only that bit while preserving every other stty -g field.
      lflag_dec=$((lflag_dec & ~536870912))
      printf '%s:lflag=%s:%s\n' "$prefix" "$lflag_dec" "$suffix"
      ;;
    *)
      printf '%s\n' "$state"
      ;;
  esac
}

before=$(tty_state) || exit 90

case ${RUMIAI_VSED_MODE-} in
  stream)
    "$RUMIAI_VSED_M" "$RUMIAI_VSED_COMMAND" \
      < "$RUMIAI_VSED_INPUT" \
      > "$RUMIAI_VSED_OUTPUT" \
      2> "$RUMIAI_VSED_ERROR"
    status=$?
    ;;
  stream-terminal)
    "$RUMIAI_VSED_M" "$RUMIAI_VSED_COMMAND" \
      > "$RUMIAI_VSED_OUTPUT" \
      2> "$RUMIAI_VSED_ERROR"
    status=$?
    ;;
  file)
    "$RUMIAI_VSED_M" "$RUMIAI_VSED_COMMAND" "$RUMIAI_VSED_FILE" \
      > "$RUMIAI_VSED_OUTPUT" \
      2> "$RUMIAI_VSED_ERROR"
    status=$?
    ;;
  *)
    exit 93
    ;;
esac

after=$(tty_state) || exit 91
if [ "$before" != "$after" ]
then
  {
    printf '%s\n' "TTY before: $before"
    printf '%s\n' "TTY after:  $after"
  } > "$RUMIAI_VSED_TTY_DIAGNOSTIC"
  exit 92
fi
exit "$status"
EOF_DRIVER
    chmod +x "$driver" || error 'cannot create Darwin vsed driver'

    expect_driver=$tmp/vsed.expect
    cat > "$expect_driver" <<'EOF_EXPECT'
set timeout 10
log_user 0

set transcript [file join $env(RUMIAI_VSED_BASE) "$env(RUMIAI_VSED_CASE).transcript"]
log_file -noappend $transcript

spawn -noecho $env(RUMIAI_VSED_DRIVER)

expect {
    -ex "^X save" {}
    timeout {
        puts stderr "timeout waiting for vsed editor screen"
        exit 1
    }
    eof {
        set result [wait]
        puts stderr "vsed exited before editor screen: $result"
        exit 1
    }
}

switch -- $env(RUMIAI_VSED_KEYS) {
    save {
        set keys "\x18"
    }
    terminal-save {
        set keys "N\x18"
    }
    split {
        set keys "X\rY\x18"
    }
    file-save {
        set keys "Q\x18"
    }
    cancel {
        set keys "X\x1b"
    }
    default {
        puts stderr "unknown vsed key scenario"
        exit 1
    }
}

send -- $keys

expect {
    eof {}
    timeout {
        puts stderr "timeout waiting for vsed exit"
        exit 1
    }
}

set result [wait]
log_file

set os_error [lindex $result 2]
set status [lindex $result 3]

if {$os_error != 0 || $status != $env(RUMIAI_VSED_EXPECTED_STATUS)} {
    puts stderr "unexpected vsed wait result: $result"
    exit 1
}

exit 0
EOF_EXPECT

    run_darwin()
    {
      case_name=$1
      mode=$2
      input=$3
      output=$4
      error_file=$5
      file_path=$6
      keys=$7
      expected_status=$8

      RUMIAI_VSED_BASE=$tmp
      RUMIAI_VSED_CASE=$case_name
      RUMIAI_VSED_DRIVER=$driver
      RUMIAI_VSED_MODE=$mode
      RUMIAI_VSED_M=$m_path
      RUMIAI_VSED_COMMAND=$command_path
      RUMIAI_VSED_INPUT=$input
      RUMIAI_VSED_OUTPUT=$output
      RUMIAI_VSED_ERROR=$error_file
      RUMIAI_VSED_FILE=$file_path
      RUMIAI_VSED_KEYS=$keys
      RUMIAI_VSED_EXPECTED_STATUS=$expected_status
      RUMIAI_VSED_TTY_DIAGNOSTIC=$tmp/$case_name.tty
      export RUMIAI_VSED_BASE RUMIAI_VSED_CASE RUMIAI_VSED_DRIVER \
        RUMIAI_VSED_MODE RUMIAI_VSED_M RUMIAI_VSED_COMMAND RUMIAI_VSED_INPUT \
        RUMIAI_VSED_OUTPUT RUMIAI_VSED_ERROR RUMIAI_VSED_FILE \
        RUMIAI_VSED_KEYS RUMIAI_VSED_EXPECTED_STATUS \
        RUMIAI_VSED_TTY_DIAGNOSTIC

      rm -f "$RUMIAI_VSED_TTY_DIAGNOSTIC" || return 1
      expect -f "$expect_driver"
      status=$?
      if [ "$status" -ne 0 ] && [ -s "$RUMIAI_VSED_TTY_DIAGNOSTIC" ]
      then
        cat "$RUMIAI_VSED_TTY_DIAGNOSTIC" >&2
      fi
      return "$status"
    }

    input=$tmp/stream.input
    output=$tmp/stream.output
    error_file=$tmp/stream.error
    expected=$tmp/stream.expected
    printf 'alpha\tbeta\n\nsecond\n' > "$input" ||
      error 'cannot create stream fixture'
    cp "$input" "$expected" || error 'cannot create stream expectation'
    run_darwin stream stream "$input" "$output" "$error_file" '' save 0 ||
      fail 'Darwin unchanged stream editing failed'
    cmp "$expected" "$output" >/dev/null 2>&1 ||
      fail 'Darwin unchanged stream save changed document bytes'
    [ ! -s "$error_file" ] ||
      fail 'Darwin unchanged stream save emitted stderr'

    : > "$tmp/empty.input" || error 'cannot create empty input fixture'
    output=$tmp/terminal.output
    error_file=$tmp/terminal.error
    expected=$tmp/terminal.expected
    printf 'N' > "$expected" || error 'cannot create terminal-input expectation'
    run_darwin terminal-empty stream-terminal "$tmp/empty.input" "$output" \
      "$error_file" '' terminal-save 0 ||
      fail 'Darwin empty terminal-stdin editing failed'
    cmp "$expected" "$output" >/dev/null 2>&1 ||
      fail 'Darwin terminal-stdin session did not start empty'
    [ ! -s "$error_file" ] ||
      fail 'Darwin terminal-stdin session emitted stderr'

    input=$tmp/edit.input
    output=$tmp/edit.output
    error_file=$tmp/edit.error
    expected=$tmp/edit.expected
    printf 'a\nb' > "$input" || error 'cannot create edit fixture'
    printf 'X\nYa\nb' > "$expected" || error 'cannot create edit expectation'
    run_darwin edit stream "$input" "$output" "$error_file" '' split 0 ||
      fail 'Darwin stream editing failed'
    cmp "$expected" "$output" >/dev/null 2>&1 ||
      fail 'Darwin stream edit produced unexpected document'
    [ ! -s "$error_file" ] || fail 'Darwin stream edit emitted stderr'

    file_path=$tmp/files/secret.txt
    output=$tmp/file.output
    error_file=$tmp/file.error
    expected=$tmp/file.expected
    : > "$tmp/empty.input" || error 'cannot create empty input fixture'
    printf 'abc\nxyz' > "$file_path" || error 'cannot create file fixture'
    printf 'Qabc\nxyz' > "$expected" || error 'cannot create file expectation'
    before=$(directory_names "$tmp/files") ||
      error 'cannot inspect file fixture directory'
    run_darwin file-save file "$tmp/empty.input" "$output" "$error_file" \
      "$file_path" file-save 0 ||
      fail 'Darwin file editing failed'
    cmp "$expected" "$file_path" >/dev/null 2>&1 ||
      fail 'Darwin file save produced unexpected document'
    [ ! -s "$output" ] || fail 'Darwin file save emitted stdout'
    [ ! -s "$error_file" ] || fail 'Darwin file save emitted stderr'
    after=$(directory_names "$tmp/files") ||
      error 'cannot re-inspect file fixture directory'
    [ "$before" = "$after" ] || fail 'Darwin file save created collateral files'

    new_path=$tmp/files/new.txt
    rm -f "$new_path" || error 'cannot reset new-file fixture'
    : > "$output" || error 'cannot reset new-file stdout'
    : > "$error_file" || error 'cannot reset new-file stderr'
    run_darwin new-file file "$tmp/empty.input" "$output" "$error_file" \
      "$new_path" file-save 0 ||
      fail 'Darwin new-file editing failed'
    printf 'Q' > "$expected" || error 'cannot create new-file expectation'
    cmp "$expected" "$new_path" >/dev/null 2>&1 ||
      fail 'Darwin new-file save produced unexpected document'
    [ "$(stat -f '%Lp' "$new_path" 2>/dev/null)" = 600 ] ||
      fail 'Darwin new file was not created with mode 0600'
    [ ! -s "$output" ] || fail 'Darwin new-file save emitted stdout'
    [ ! -s "$error_file" ] || fail 'Darwin new-file save emitted stderr'

    empty_path=$tmp/files/empty.txt
    rm -f "$empty_path" || error 'cannot reset empty-file fixture'
    : > "$output" || error 'cannot reset empty-file stdout'
    : > "$error_file" || error 'cannot reset empty-file stderr'
    run_darwin empty-file file "$tmp/empty.input" "$output" "$error_file" \
      "$empty_path" save 0 ||
      fail 'Darwin empty new-file save failed'
    [ -f "$empty_path" ] && [ ! -s "$empty_path" ] ||
      fail 'Darwin empty new-file save did not create an empty file'
    [ "$(stat -f '%Lp' "$empty_path" 2>/dev/null)" = 600 ] ||
      fail 'Darwin empty new file was not created with mode 0600'

    cancel_new_path=$tmp/files/cancel-new.txt
    rm -f "$cancel_new_path" || error 'cannot reset new-file cancel fixture'
    : > "$output" || error 'cannot reset new-file cancel stdout'
    : > "$error_file" || error 'cannot reset new-file cancel stderr'
    run_darwin cancel-new file "$tmp/empty.input" "$output" "$error_file" \
      "$cancel_new_path" cancel 1 ||
      fail 'Darwin new-file cancellation failed'
    [ ! -e "$cancel_new_path" ] && [ ! -L "$cancel_new_path" ] ||
      fail 'Darwin cancel created the new-file pathname'

    printf 'sensitive' > "$file_path" || error 'cannot reset cancel fixture'
    cp "$file_path" "$expected" || error 'cannot create cancel expectation'
    : > "$output" || error 'cannot reset cancel stdout'
    : > "$error_file" || error 'cannot reset cancel stderr'
    before=$(directory_names "$tmp/files") ||
      error 'cannot inspect cancel fixture directory'
    run_darwin cancel file "$tmp/empty.input" "$output" "$error_file" \
      "$file_path" cancel 1 ||
      fail 'Darwin cancellation failed'
    cmp "$expected" "$file_path" >/dev/null 2>&1 ||
      fail 'Darwin cancel modified the file'
    [ ! -s "$output" ] || fail 'Darwin cancel emitted stdout'
    [ ! -s "$error_file" ] || fail 'Darwin cancel emitted stderr'
    after=$(directory_names "$tmp/files") ||
      error 'cannot re-inspect cancel fixture directory'
    [ "$before" = "$after" ] || fail 'Darwin cancel created collateral files'
    ;;

  *)
    skip "no scripted TTY driver is defined for $system"
    ;;
esac

bad_path=$tmp/files/bad.txt
bad_out=$tmp/bad.out
bad_err=$tmp/bad.err
printf 'safe\runsafe' > "$bad_path" ||
  error 'cannot create unsupported-input fixture'

"$m_path" "$command_path" "$bad_path" > "$bad_out" 2> "$bad_err"
status=$?
[ "$status" -eq 2 ] || fail "unsupported control content status is $status"
[ ! -s "$bad_out" ] || fail 'unsupported control content emitted stdout'
grep -F 'safe' "$bad_err" >/dev/null 2>&1 &&
  fail 'unsupported-input diagnostic leaked document content'
grep -F 'unsafe' "$bad_err" >/dev/null 2>&1 &&
  fail 'unsupported-input diagnostic leaked document content'
printf 'safe\runsafe' > "$tmp/bad.expected" ||
  error 'cannot create unsupported-input expectation'
cmp "$tmp/bad.expected" "$bad_path" >/dev/null 2>&1 ||
  fail 'unsupported control input was rewritten'

exit 0
