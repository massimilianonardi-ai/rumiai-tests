#!/bin/sh

TEST_ID=rumiai-os/vsed/pty.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

cleanup()
{
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

command_path=$root/bin/sys/vsed
m_path=$root/m
[ -x "$command_path" ] || fail 'vsed command is unavailable'
[ -x "$m_path" ] || fail 'm bootstrap is unavailable'

command -v python3 >/dev/null 2>&1 || skip 'python3 is unavailable for PTY test support'
command -v tput >/dev/null 2>&1 || skip 'tput is unavailable'
TERM=xterm-256color tput cols >/dev/null 2>&1 || skip 'xterm-256color terminfo entry is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-vsed-pty-$$
umask 077
mkdir -p "$tmp/home" "$tmp/tmp" "$tmp/files" || error 'cannot create test workspace'

python3 - "$m_path" "$command_path" "$tmp" <<'PY'
import os
import pty
import select
import subprocess
import sys
import termios
import time

m_path, command_path, base = sys.argv[1:4]
term = "xterm-256color"
base_env = os.environ.copy()
base_env.update({
    "TERM": term,
    "HOME": os.path.join(base, "home"),
    "TMPDIR": os.path.join(base, "tmp"),
})


def tree_snapshot(path):
    result = []
    for root, dirs, files in os.walk(path):
        dirs.sort()
        files.sort()
        for name in dirs:
            result.append(("d", os.path.relpath(os.path.join(root, name), path)))
        for name in files:
            p = os.path.join(root, name)
            result.append(("f", os.path.relpath(p, path), os.stat(p).st_size))
    return result


def run_vsed(initial=b"", keys=b"\x18", file_path=None, timeout=5.0):
    in_r, in_w = os.pipe()
    out_r, out_w = os.pipe()
    err_r, err_w = os.pipe()
    pid, master = pty.fork()

    if pid == 0:
        os.dup2(in_r, 0)
        os.dup2(out_w, 1)
        os.dup2(err_w, 2)
        for fd in (in_r, in_w, out_r, out_w, err_r, err_w):
            try:
                os.close(fd)
            except OSError:
                pass
        argv = [m_path, command_path]
        if file_path is not None:
            argv.append(file_path)
        os.execve(m_path, argv, base_env)

    os.close(in_r)
    os.close(out_w)
    os.close(err_w)

    os.write(in_w, initial)
    os.close(in_w)

    screen = bytearray()
    deadline_setup = time.monotonic() + 2.0
    ready_for_keys = False
    while time.monotonic() < deadline_setup:
        ready, _, _ = select.select([master], [], [], 0.05)
        if not ready:
            continue
        try:
            chunk = os.read(master, 4096)
        except OSError:
            chunk = b""
        screen.extend(chunk)
        if b"^X save" in screen:
            ready_for_keys = True
            break

    if not ready_for_keys:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError(("vsed did not enter interactive screen", bytes(screen)))

    os.write(master, keys)

    out = bytearray()
    err = bytearray()
    deadline = time.monotonic() + timeout
    status = None

    while time.monotonic() < deadline:
        ready, _, _ = select.select([out_r, err_r, master], [], [], 0.05)
        for fd in ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if fd == out_r:
                out.extend(chunk)
            elif fd == err_r:
                err.extend(chunk)
            else:
                screen.extend(chunk)

        waited, wait_status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = os.waitstatus_to_exitcode(wait_status)
            break

    if status is None:
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        raise AssertionError("vsed timed out")

    time.sleep(0.03)
    for fd, target in ((out_r, out), (err_r, err)):
        while True:
            ready, _, _ = select.select([fd], [], [], 0)
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            target.extend(chunk)

    attrs = termios.tcgetattr(master)
    lflag = attrs[3]
    restored = bool(lflag & termios.ICANON) and bool(lflag & termios.ECHO)

    os.close(out_r)
    os.close(err_r)
    os.close(master)
    return status, bytes(out), bytes(err), restored, bytes(screen)


# Stream mode: unchanged save must preserve TAB, empty lines and final LF exactly.
stream_before = tree_snapshot(os.path.join(base, "tmp"))
status, out, err, restored, screen = run_vsed(b"alpha\tbeta\n\nsecond\n", b"\x18")
assert status == 0, (status, out, err)
assert out == b"alpha\tbeta\n\nsecond\n", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after stream save"
assert tree_snapshot(os.path.join(base, "tmp")) == stream_before, "stream save created TMPDIR artifacts"

# Stream mode edit: insertion and Enter operate on the in-memory buffer.
status, out, err, restored, screen = run_vsed(b"a\nb", b"X\nY\x18")
assert status == 0, (status, out, err)
assert out == b"X\nYa\nb", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after edited stream save"

# File mode: save modifies only the selected file and emits no stdout.
file_path = os.path.join(base, "files", "secret.txt")
with open(file_path, "wb") as f:
    f.write(b"abc\nxyz")
before_names = sorted(os.listdir(os.path.dirname(file_path)))
status, out, err, restored, screen = run_vsed(b"", b"Q\x18", file_path=file_path)
assert status == 0, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after file save"
with open(file_path, "rb") as f:
    assert f.read() == b"Qabc\nxyz"
assert sorted(os.listdir(os.path.dirname(file_path))) == before_names, "file save created collateral files"

# Cancel must preserve the target and produce no saved output.
with open(file_path, "wb") as f:
    f.write(b"sensitive")
before_names = sorted(os.listdir(os.path.dirname(file_path)))
status, out, err, restored, screen = run_vsed(b"", b"X\x1b", file_path=file_path)
assert status == 1, (status, out, err)
assert out == b"", (status, out, err)
assert err == b"", (status, out, err)
assert restored, "terminal state was not restored after cancel"
with open(file_path, "rb") as f:
    assert f.read() == b"sensitive"
assert sorted(os.listdir(os.path.dirname(file_path))) == before_names, "cancel created collateral files"

# Unsupported control content is rejected before interactive editing and is not rewritten.
bad_path = os.path.join(base, "files", "bad.txt")
with open(bad_path, "wb") as f:
    f.write(b"safe\runsafe")
completed = subprocess.run(
    [m_path, command_path, bad_path],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    env=base_env,
    timeout=3,
)
assert completed.returncode == 2, (completed.returncode, completed.stdout, completed.stderr)
assert completed.stdout == b""
assert b"safe" not in completed.stderr and b"unsafe" not in completed.stderr
with open(bad_path, "rb") as f:
    assert f.read() == b"safe\runsafe"
PY
status=$?
[ "$status" -eq 0 ] || fail 'PTY/security behavior validation failed'

exit 0
