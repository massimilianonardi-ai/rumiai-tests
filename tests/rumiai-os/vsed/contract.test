#!/bin/sh

TEST_ID=rumiai-os/vsed/contract.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
group_dir=${test_dir%/*}
rumiai_os_group=${group_dir%/*}
tests_dir=${rumiai_os_group%/*}
suite_root=${tests_dir%/*}

target_library=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_library" ] || error 'rumiai-os target helper is unavailable'
. "$target_library" || error 'cannot source rumiai-os target helper'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) : ;;
  1) skip 'rumiai-os target checkout not found' ;;
  2) fail 'invalid explicit rumiai-os target' ;;
  *) error 'target discovery failed' ;;
esac

command_path=$root/bin/sys/vsed
manual_path=$root/res/sys/manual/vsed
manual_command=$root/bin/sys/manual

[ -f "$command_path" ] && [ -x "$command_path" ] || fail 'vsed is missing or not executable'
[ "$(sed -n '1p' "$command_path")" = '#!/usr/bin/env m' ] || fail 'vsed does not use the integrated m shebang'
command -p sh -n "$command_path" || fail 'vsed is not valid POSIX-shell syntax'
[ -f "$manual_path" ] && [ ! -L "$manual_path" ] || fail 'vsed operational manual is missing'
[ -x "$manual_command" ] || fail 'manual command is unavailable'

manual_text=$("$root/m" "$manual_command" --no-pager vsed) || fail 'manual vsed lookup failed'
printf '%s\n' "$manual_text" | grep -F 'vsed <file>' >/dev/null 2>&1 ||
  fail 'manual does not document file mode'
printf '%s\n' "$manual_text" | grep -F 'does not create plaintext temporary' >/dev/null 2>&1 ||
  fail 'manual does not document the memory-only storage guarantee'
printf '%s\n' "$manual_text" | grep -F 'Ctrl-X' >/dev/null 2>&1 ||
  fail 'manual does not document save-and-exit'

"$root/m" "$command_path" one two >/dev/null 2>&1
[ "$?" -eq 2 ] || fail 'two file operands are not rejected with status 2'

exit 0
