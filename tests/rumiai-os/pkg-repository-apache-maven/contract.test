#!/bin/sh

TEST_ID="rumiai-os/pkg-repository-apache-maven/contract.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir=${test_dir%/*}; rumiai_os_group=${group_dir%/*}; tests_dir=${rumiai_os_group%/*}; suite_root=${tests_dir%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

library="$root/lib/sys/sh/pkg-repository-apache-maven.lib.sh"
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] || fail "Apache Maven repository adapter is missing or has invalid mode"
command -p -- sh -n "$library" >/dev/null 2>&1 || fail "Apache Maven repository adapter is not POSIX-shell syntax valid"

tmp="${TMPDIR:-/tmp}/rumiai-pkg-apache-maven-contract-$$"
umask 077
mkdir "$tmp" "$tmp/repository" "$tmp/range" "$tmp/bin" || error "cannot create fixture directories"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
repository_dir="$tmp/repository"
range_dir="$tmp/range"

write_valid_repository()
{
  rm -rf "$repository_dir"
  mkdir "$repository_dir" || error "cannot recreate repository descriptor"
  printf -- '%s\n' apache-maven > "$repository_dir/type"
}

write_valid_range()
{
  rm -rf "$range_dir"
  mkdir "$range_dir" || error "cannot recreate range descriptor"
  printf -- '%s\n' '^apache-maven-[A-Za-z0-9][A-Za-z0-9._+~-]*-bin\.tar\.gz$' > "$range_dir/archive_regex"
  printf -- '%s\n' sha512 > "$range_dir/digest_type"
}

cat > "$tmp/bin/http-fetch" <<'EOF_HTTP'
#!/bin/sh
printf -- '%s\n' "$*" >> "$MAVEN_HTTP_LOG"
length=0
for arg
do
  [ "$arg" = -l ] && length=1
done
for url do :; done
case "$url" in
  https://dlcdn.apache.org/maven/maven-4/)
    case "${MAVEN_INDEX_MODE-ok}" in
      ok)
        cat <<'EOF_INDEX'
<html><body>
<a href="../">Parent Directory</a>
<a href="4.0.0/">4.0.0/</a>
<a href="4.0.0-rc-10/">4.0.0-rc-10/</a>
<a href="4.0.0-beta-5/">4.0.0-beta-5/</a>
<a href="4.0.0-rc-6/">4.0.0-rc-6/</a>
<a href="4.0.0-rc-7/">4.0.0-rc-7/</a>
EOF_INDEX
        ;;
      duplicate) printf '%s\n' '<a href="4.0.0-rc-6/">first</a><a href="4.0.0-rc-6/">second</a>';;
      malformed) printf '%s\n' '<html>no supported versions</html>';;
    esac
    ;;
  https://downloads.apache.org/maven/maven-4/4.0.0-rc-6/binaries/apache-maven-4.0.0-rc-6-bin.tar.gz.sha512)
    case "${MAVEN_SIDECAR_MODE-ok}" in
      ok) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA';;
      filename) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  apache-maven-4.0.0-rc-6-bin.tar.gz';;
      duplicate) printf '%s\n' 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB';;
      bad-digest) printf '%s\n' aaaa;;
    esac;;
  https://downloads.apache.org/maven/maven-4/4.0.0-rc-7/binaries/apache-maven-4.0.0-rc-7-bin.tar.gz.sha512) printf '%s\n' 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB';;
  https://downloads.apache.org/maven/maven-4/4.0.0-rc-10/binaries/apache-maven-4.0.0-rc-10-bin.tar.gz.sha512) printf '%s\n' 'CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC';;
  https://downloads.apache.org/maven/maven-4/4.0.0/binaries/apache-maven-4.0.0-bin.tar.gz.sha512) printf '%s\n' 'DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD';;
  https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-6/binaries/apache-maven-4.0.0-rc-6-bin.tar.gz) [ "$length" -eq 1 ] || exit 89; printf -- '%s\n' 14000006;;
  https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-7/binaries/apache-maven-4.0.0-rc-7-bin.tar.gz) [ "$length" -eq 1 ] || exit 89; printf -- '%s\n' 14000007;;
  https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-10/binaries/apache-maven-4.0.0-rc-10-bin.tar.gz) [ "$length" -eq 1 ] || exit 89; printf -- '%s\n' 14000010;;
  https://dlcdn.apache.org/maven/maven-4/4.0.0/binaries/apache-maven-4.0.0-bin.tar.gz) [ "$length" -eq 1 ] || exit 89; printf -- '%s\n' 14000100;;
  *) exit 88;;
esac
EOF_HTTP
chmod 700 "$tmp/bin/http-fetch" || error "cannot make fake http-fetch executable"

PATH="$tmp/bin:/usr/bin:/bin"; export PATH
m_LIB_DIR="$root/lib"; export m_LIB_DIR
MAVEN_HTTP_LOG="$tmp/http.log"; export MAVEN_HTTP_LOG
MAVEN_INDEX_MODE=ok; export MAVEN_INDEX_MODE
MAVEN_SIDECAR_MODE=ok; export MAVEN_SIDECAR_MODE
. "$library" || error "cannot source Apache Maven repository adapter"

write_valid_repository
[ "$(pkg_repository_resolve_version "$repository_dir" 4.0.0-rc-6)" = 4.0.0-rc-6 ] || fail "exact release resolution failed"
write_valid_repository
printf -- '%s\n' maven > "$repository_dir/type"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "common repository type maven was accepted"; fi
write_valid_repository
printf -- '%s\n' unexpected > "$repository_dir/extra"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unknown repository field was accepted"; fi
write_valid_repository
chmod 700 "$repository_dir/type" || error "cannot change scalar mode"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "executable repository scalar was accepted"; fi
write_valid_repository
printf -- '%s' apache-maven > "$repository_dir/type"
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "unterminated repository scalar was accepted"; fi

write_valid_repository
expected_versions='4.0.0-rc-6
4.0.0-rc-7
4.0.0-rc-10
4.0.0'
[ "$(pkg_repository_list_versions "$repository_dir")" = "$expected_versions" ] || fail "list_versions did not filter/order Maven 4 releases"
[ "$(pkg_repository_resolve_version "$repository_dir")" = 4.0.0 ] || fail "latest resolution is incorrect"
[ "$(pkg_repository_compare_versions "$repository_dir" 4.0.0-rc-6 4.0.0-rc-10)" = -1 ] || fail "RC numeric ordering is incorrect"
[ "$(pkg_repository_compare_versions "$repository_dir" 4.0.0-rc-10 4.0.0)" = -1 ] || fail "RC must sort before the corresponding GA"
[ "$(pkg_repository_compare_versions "$repository_dir" 4.0.0 4.0.0)" = 0 ] || fail "equal comparison is incorrect"
for invalid_version in 4.0.0-beta-5 4.0.0-rc-0 4.0.0-rc-01 04.0.0 4.00.0
do
  if pkg_repository_resolve_version "$repository_dir" "$invalid_version" >/dev/null 2>&1; then fail "invalid version $invalid_version was accepted"; fi
done
if pkg_repository_resolve_version "$repository_dir" 4.0.0-rc-8 >/dev/null 2>&1; then fail "version absent from current index was accepted"; fi
MAVEN_INDEX_MODE=duplicate; export MAVEN_INDEX_MODE
if pkg_repository_list_versions "$repository_dir" >/dev/null 2>&1; then fail "duplicate current-index version was accepted"; fi
MAVEN_INDEX_MODE=malformed; export MAVEN_INDEX_MODE
if pkg_repository_resolve_version "$repository_dir" >/dev/null 2>&1; then fail "empty supported current index resolved a latest version"; fi
MAVEN_INDEX_MODE=ok; export MAVEN_INDEX_MODE

write_valid_range
MAVEN_SIDECAR_MODE=ok; export MAVEN_SIDECAR_MODE
: > "$MAVEN_HTTP_LOG"
out="$(pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 4.0.0-rc-6)" || fail "valid artifact resolution failed"
expected_descriptor='name=apache-maven-4.0.0-rc-6-bin.tar.gz
url=https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-6/binaries/apache-maven-4.0.0-rc-6-bin.tar.gz
size=14000006
digest=sha512:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
[ "$out" = "$expected_descriptor" ] || fail "artifact descriptor is incorrect"
grep -F -e 'https://dlcdn.apache.org/maven/maven-4/' "$MAVEN_HTTP_LOG" >/dev/null || fail "current version index URL is incorrect"
grep -F -e 'https://downloads.apache.org/maven/maven-4/4.0.0-rc-6/binaries/apache-maven-4.0.0-rc-6-bin.tar.gz.sha512' "$MAVEN_HTTP_LOG" >/dev/null || fail "official SHA-512 sidecar URL is incorrect"
grep -F -e '-l -- https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-6/binaries/apache-maven-4.0.0-rc-6-bin.tar.gz' "$MAVEN_HTTP_LOG" >/dev/null || fail "size did not use http-fetch -l on user-selected binary URL"
if grep -F -e 'archive.apache.org' "$MAVEN_HTTP_LOG" >/dev/null; then fail "archive fallback was used"; fi
for mode in filename duplicate bad-digest
do
  MAVEN_SIDECAR_MODE=$mode; export MAVEN_SIDECAR_MODE
  if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 4.0.0-rc-6 >/dev/null 2>&1; then fail "$mode sidecar was accepted"; fi
done
MAVEN_SIDECAR_MODE=ok; export MAVEN_SIDECAR_MODE
printf -- '%s\n' sha256 > "$range_dir/digest_type"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 4.0.0-rc-6 >/dev/null 2>&1; then fail "non-SHA-512 range was accepted"; fi
write_valid_range
printf -- '%s\n' '.*' > "$range_dir/digest_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 4.0.0-rc-6 >/dev/null 2>&1; then fail "digest_regex was accepted"; fi
write_valid_range
printf -- '%s\n' '^other\.tar\.gz$' > "$range_dir/archive_regex"
if pkg_repository_resolve_artifact "$repository_dir" "$range_dir" 4.0.0-rc-6 >/dev/null 2>&1; then fail "non-matching archive_regex was accepted"; fi
exit 0
