#!/bin/sh

TEST_ID="rumiai-os/json/object-read.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="$tests_dir"

target_library="$suite_root/lib/rumiai-os-target.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac

library="$root/lib/sys/sh/json.lib.sh"
[ -f "$library" ] || fail "lib/sys/sh/json.lib.sh is missing"
. "$library" || error "cannot source json.lib.sh"

json='{"text":"$(printf injected) `printf injected` ;","number":12,"flag":false,"none":null}'
json_object_read \
  text text_token \
  number number_token \
  flag flag_token \
  none none_token \
  missing missing_token <<EOF_JSON
$json
EOF_JSON
[ "$?" -eq "0" ] || fail "json_object_read rejected a valid object"

[ "$text_token" = 's:$(printf injected) `printf injected` ;' ] || fail "string data was not preserved literally"
[ "$number_token" = "n:12" ] || fail "number token is incorrect"
[ "$flag_token" = "b:false" ] || fail "boolean token is incorrect"
[ "$none_token" = "z:" ] || fail "null token is incorrect"
[ "$missing_token" = "m:" ] || fail "missing token is incorrect"

if printf -- '%s\n' '{"value":"line\nbreak"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing LF was accepted"
fi

if printf -- '%s\n' '{"value":"tab\tbreak"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing TAB was accepted"
fi

if printf -- '%s\n' '{"value":"carriage\rreturn"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing CR was accepted"
fi

if printf -- '%s\n' '{"value":"\u0041"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected Unicode escape was accepted"
fi

if printf -- '%s\n' '{"value":' | json_object_fields value >/dev/null 2>&1
then
  fail "malformed JSON was accepted"
fi

json_object_read value 'invalid-name' <<'EOF_JSON'
{"value":"x"}
EOF_JSON
status="$?"
[ "$status" -eq "2" ] || fail "invalid destination variable name did not return status 2"

exit "0"
