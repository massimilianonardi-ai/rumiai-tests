#!/bin/sh

TEST_ID="rumiai-os/json/object-read.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "1"
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "3"
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit "2"
}

# Target discovery primitive copied from:
# massimilianonardi-ai/rumiai-tests@c39b1a2c0b6e96e8e43809a6e66d16918cf90a7d:lib/rumiai-os-target.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"

  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return "1"
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return "0"
      ;;
  esac

  return "1"
}

rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"

  [ -n "$candidate" ] || return "1"
  [ -f "$candidate/rumiai-os" ] || return "1"
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return "1"

  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return "1"
  [ -f "$target_root/rumiai-os" ] || return "1"

  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start="$1"

  rumiai_test_target_have git || return "3"

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return "2"
    return "0"
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return "3"

  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return "0"
    fi

    [ "$candidate" != "/" ] || break
    parent="${candidate%/*}"
    [ -n "$parent" ] || parent="/"
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done

  return "1"
}

resolve_test_dir()
{
  self="$0"
  case "$self" in
    */*)
      :
      ;;
    *)
      self="$(command -v "$self" 2>/dev/null)" || return "1"
      ;;
  esac

  self_dir="${self%/*}"
  [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
group_dir="${test_dir%/*}"
rumiai_os_group="${group_dir%/*}"
tests_dir="${rumiai_os_group%/*}"
suite_root="${tests_dir%/*}"

root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status="$?"
case "$status" in
  "0")
    :
    ;;
  "1")
    skip "rumiai-os target checkout not found"
    ;;
  "2")
    fail "invalid explicit rumiai-os target"
    ;;
  *)
    error "target discovery failed"
    ;;
esac


library="$root/lib/sh/json.lib.sh"
[ -f "$library" ] || fail "lib/sh/json.lib.sh is missing"
. "$library" || error "cannot source json.lib.sh"

json='{"text":"$(printf injected) `printf injected` ;","number":12,"flag":false,"none":null}'
json_object_read \
  text text_token \
  number number_token \
  flag flag_token \
  none none_token \
  missing missing_token <<EOF_JSON
$json
EOF_JSON
[ "$?" -eq "0" ] || fail "json_object_read rejected a valid object"

[ "$text_token" = 's:$(printf injected) `printf injected` ;' ] || fail "string data was not preserved literally"
[ "$number_token" = "n:12" ] || fail "number token is incorrect"
[ "$flag_token" = "b:false" ] || fail "boolean token is incorrect"
[ "$none_token" = "z:" ] || fail "null token is incorrect"
[ "$missing_token" = "m:" ] || fail "missing token is incorrect"

if printf -- '%s\n' '{"value":"line\nbreak"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing LF was accepted"
fi

if printf -- '%s\n' '{"value":"tab\tbreak"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing TAB was accepted"
fi

if printf -- '%s\n' '{"value":"carriage\rreturn"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected string containing CR was accepted"
fi

if printf -- '%s\n' '{"value":"\u0041"}' | json_object_fields value >/dev/null 2>&1
then
  fail "selected Unicode escape was accepted"
fi

if printf -- '%s\n' '{"value":' | json_object_fields value >/dev/null 2>&1
then
  fail "malformed JSON was accepted"
fi

json_object_read value 'invalid-name' <<'EOF_JSON'
{"value":"x"}
EOF_JSON
status="$?"
[ "$status" -eq "2" ] || fail "invalid destination variable name did not return status 2"

exit "0"
