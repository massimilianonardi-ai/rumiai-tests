#!/bin/sh

TEST_ID=rumiai-tests/lib/rumiai-os-target-reference.test

fail()
{
    printf '%s\n' "$TEST_ID: $*" >&2
    exit 1
}

error()
{
    printf '%s\n' "$TEST_ID: $*" >&2
    exit 3
}

skip()
{
    printf '%s\n' "$TEST_ID: $*" >&2
    exit 2
}

resolve_test_dir()
{
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

make_target_checkout()
{
    target="$1"

    mkdir -p "$target" || return 1
    git -C "$target" init -q >/dev/null 2>&1 || return 1
    git -C "$target" remote add origin https://github.com/massimilianonardi-ai/rumiai-os.git >/dev/null 2>&1 || return 1
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_tests_group=${test_dir%/*}
tests_dir=${rumiai_tests_group%/*}
suite_root=${tests_dir%/*}

target_lib=$suite_root/lib/rumiai-os-target.lib
[ -f "$target_lib" ] || error 'lib/rumiai-os-target.lib is unavailable'

# The library is intentionally sourced here because it is the target of this test.
. "$target_lib" || error 'cannot load lib/rumiai-os-target.lib'

command -v git >/dev/null 2>&1 || skip 'git is unavailable'

tmp="${TMPDIR:-/tmp}/rumiai-os-target-reference-$$"
umask 077
mkdir "$tmp" || error 'cannot create temporary discovery workspace'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

explicit_target_was_set=0
explicit_target=
if [ "${RUMIAI_TEST_RUMIAI_OS_ROOT+x}" = x ]; then
    explicit_target_was_set=1
    explicit_target=$RUMIAI_TEST_RUMIAI_OS_ROOT
fi
unset RUMIAI_TEST_RUMIAI_OS_ROOT

nested_target="$tmp/nested/rumiai-os"
nested_start="$nested_target/src/rumiai-tests"
make_target_checkout "$nested_target" || error 'cannot create nested target fixture'
mkdir -p "$nested_start" || error 'cannot create nested discovery start'
nested_root=$(rumiai_test_target_rumiai_os_find "$nested_start") || fail 'cannot discover a target from a nested suite location'
nested_physical=$(CDPATH= cd -- "$nested_target" 2>/dev/null && pwd -P) || error 'cannot canonicalize nested target fixture'
[ "$nested_root" = "$nested_physical" ] || fail "nested discovery returned unexpected root: $nested_root"

sibling_workspace="$tmp/sibling"
sibling_target="$sibling_workspace/rumiai-os"
sibling_start="$sibling_workspace/rumiai-tests"
make_target_checkout "$sibling_target" || error 'cannot create sibling target fixture'
mkdir -p "$sibling_start" || error 'cannot create sibling discovery start'
sibling_root=$(rumiai_test_target_rumiai_os_find "$sibling_start") || fail 'cannot discover a target from a sibling suite location'
sibling_physical=$(CDPATH= cd -- "$sibling_target" 2>/dev/null && pwd -P) || error 'cannot canonicalize sibling target fixture'
[ "$sibling_root" = "$sibling_physical" ] || fail "sibling discovery returned unexpected root: $sibling_root"

if [ "$explicit_target_was_set" -eq 1 ]; then
    RUMIAI_TEST_RUMIAI_OS_ROOT=$explicit_target
    export RUMIAI_TEST_RUMIAI_OS_ROOT
fi

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'no rumiai-os target checkout is discoverable from this suite location' ;;
    2) fail 'explicit RUMIAI_TEST_RUMIAI_OS_ROOT is not a valid rumiai-os checkout' ;;
    *) error 'cannot perform rumiai-os target discovery' ;;
esac

case $root in
    /*) : ;;
    *) fail "discovered target root is not absolute: $root" ;;
esac

[ -f "$root/m" ] || fail 'discovered target has no m runtime'
[ -f "$root/rumiai-os" ] || fail 'discovered target has no rumiai-os entrypoint'
[ -f "$root/rumiai-os-sh" ] || fail 'discovered target has no rumiai-os-sh entrypoint'
rumiai_test_target_rumiai_os_origin_ok "$root" || fail 'discovered target has unexpected Git origin'
physical=$(CDPATH= cd -- "$root" 2>/dev/null && pwd -P) || error 'cannot canonicalize discovered root'
[ "$physical" = "$root" ] || fail "discovered root is not physical: $root -> $physical"

exit 0
