#!/bin/sh

TEST_ID=rumiai-tests/lib/rumiai-os-fixture-reference.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
    self=$0
    case $self in */*) : ;; *) self=$(command -v "$self" 2>/dev/null) || return 1 ;; esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
rumiai_tests_group=${test_dir%/*}
tests_dir=${rumiai_tests_group%/*}
suite_root=${tests_dir%/*}

target_lib=$suite_root/lib/rumiai-os-target.lib
fixture_lib=$suite_root/lib/rumiai-os-fixture.lib
[ -f "$target_lib" ] || error 'lib/rumiai-os-target.lib is unavailable'
[ -f "$fixture_lib" ] || error 'lib/rumiai-os-fixture.lib is unavailable'
. "$target_lib" || error 'cannot load lib/rumiai-os-target.lib'
. "$fixture_lib" || error 'cannot load lib/rumiai-os-fixture.lib'

source_root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
    0) : ;;
    1) skip 'rumiai-os target checkout not found' ;;
    2) fail 'invalid explicit rumiai-os target' ;;
    *) error 'target discovery failed' ;;
esac

tmp=${TMPDIR:-/tmp}/rumiai-os-fixture-reference-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture=$tmp/root

rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"
status=$?
case $status in
    0) : ;;
    1) fail 'source checkout lacks required runtime material' ;;
    2) error 'cannot materialize isolated fixture' ;;
    *) error "fixture primitive returned unexpected status $status" ;;
esac

fixture=$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P) || error 'cannot canonicalize fixture root'
[ -x "$fixture/m" ] || fail 'fixture m runtime is not executable'
[ -f "$fixture/m.lib.sh" ] && [ ! -L "$fixture/m.lib.sh" ] || fail 'fixture m bootstrap library is missing or invalid'
[ -x "$fixture/rumiai-os" ] || fail 'fixture rumiai-os entrypoint is not executable'
[ -x "$fixture/rumiai-os-sh" ] || fail 'fixture rumiai-os-sh entrypoint is not executable'
[ -d "$fixture/bin" ] || fail 'fixture bin directory is missing'
[ -d "$fixture/lib" ] || fail 'fixture lib directory is missing'
[ -d "$fixture/res" ] || fail 'fixture res directory is missing'
[ ! -e "$fixture/lang" ] && [ ! -L "$fixture/lang" ] || fail 'fixture contains superseded top-level lang root'
[ -d "$fixture/state/system/profile/main" ] || fail 'fixture main system profile is missing'
[ -L "$fixture/state/system/current" ] || fail 'fixture system selector is missing'
[ "$(readlink "$fixture/state/system/current")" = 'profile/main' ] || fail 'fixture system selector does not target profile/main'
[ -f "$fixture/product-name" ] || fail 'fixture product-name metadata is missing'
[ -f "$fixture/product-version" ] || fail 'fixture product-version metadata is missing'
[ "$(cat "$fixture/product-name")" = 'RumiAI' ] || fail 'fixture product-name metadata is incorrect'

for legacy_root in conf data home cache log run tmp
do
    [ ! -e "$fixture/$legacy_root" ] && [ ! -L "$fixture/$legacy_root" ] || fail "fixture contains superseded top-level state root: $legacy_root"
done

probe=$tmp/probe
cat > "$probe" <<'EOT'
[ "${m_ROOT-}" = "$EXPECTED_ROOT" ] || return 41
[ "${m_LIB_DIR-}" = "$EXPECTED_ROOT/lib" ] || return 42
[ "${m_RES_DIR-}" = "$EXPECTED_ROOT/res" ] || return 53
[ "${m_LANG_DIR-}" = "$EXPECTED_ROOT/res/sys/lang" ] || return 54
[ "${m_STATE_DIR-}" = "$EXPECTED_ROOT/state" ] || return 43
[ "${m_STATE_SYS_DIR-}" = "$EXPECTED_ROOT/state/system/current" ] || return 44
[ "${m_STATE_USER_DIR-}" = "$EXPECTED_ROOT/state/user/current" ] || return 45
[ "${m_CONF_DIR+x}" != x ] || return 46
[ "${m_DATA_DIR+x}" != x ] || return 47
[ "${m_HOME_DIR+x}" != x ] || return 48
[ "${m_CACHE_DIR+x}" != x ] || return 49
[ "${m_LOG_DIR+x}" != x ] || return 50
[ "${m_RUN_DIR+x}" != x ] || return 51
[ "${m_TMP_DIR+x}" != x ] || return 52
return 0
EOT

EXPECTED_ROOT=$fixture
export EXPECTED_ROOT
"$fixture/m" "$probe" >/dev/null 2>"$tmp/stderr" || {
    status=$?
    cat "$tmp/stderr" >&2
    fail "isolated fixture m runtime returned $status"
}

exit 0
