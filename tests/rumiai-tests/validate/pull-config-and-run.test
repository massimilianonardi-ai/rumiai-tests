#!/bin/sh

TEST_ID=rumiai-tests/validate/pull-config-and-run.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir() {
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip 'git is required'

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
suite_root=${test_dir%/*}
suite_root=${suite_root%/*}
suite_root=${suite_root%/*}
[ -f "$suite_root/rumiai-validate" ] || error 'cannot locate rumiai-validate'
[ -f "$suite_root/lib/sh/rumiai-validate.lib.sh" ] || error 'cannot locate validation launcher implementation'
[ -f "$suite_root/lib/rumiai-os-target.lib" ] || error 'cannot locate rumiai-os target discovery library'

tmp=${TMPDIR:-/tmp}/rumiai-validate-flow-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

commit_repo() {
    repo=$1
    message=$2
    git -C "$repo" -c user.name=RumiAI-Test -c user.email=rumiai-test@example.invalid commit -q -m "$message"
}

mkdir "$tmp/target-remote.git" || error 'cannot create target remote directory'
git -C "$tmp/target-remote.git" init --bare -q || error 'cannot initialize target remote'
mkdir "$tmp/target-seed" || error 'cannot create target seed directory'
git -C "$tmp/target-seed" init -q || error 'cannot initialize target seed'
target_branch=$(git -C "$tmp/target-seed" symbolic-ref --short HEAD) || error 'cannot determine target branch'
printf 'src/\n' > "$tmp/target-seed/.gitignore" || error 'cannot write target gitignore'
printf '#!/bin/sh\nexit 0\n' > "$tmp/target-seed/rumiai-os" || error 'cannot write target entrypoint'
chmod +x "$tmp/target-seed/rumiai-os" || error 'cannot make target entrypoint executable'
git -C "$tmp/target-seed" add . || error 'cannot stage initial target'
commit_repo "$tmp/target-seed" initial-target || error 'cannot commit initial target'
git -C "$tmp/target-seed" remote add origin "$tmp/target-remote.git" || error 'cannot add target remote'
git -C "$tmp/target-seed" push -q -u origin "$target_branch" || error 'cannot push initial target'
git -C "$tmp/target-remote.git" symbolic-ref HEAD "refs/heads/$target_branch" || error 'cannot set target remote HEAD'

mkdir "$tmp/work" || error 'cannot create work directory'
git clone -q "$tmp/target-remote.git" "$tmp/work/rumiai-os" || error 'cannot clone target worktree'
git -C "$tmp/work/rumiai-os" remote rename origin local || error 'cannot rename target local remote'
git -C "$tmp/work/rumiai-os" remote add origin https://github.com/massimilianonardi-ai/rumiai-os.git || error 'cannot configure canonical target origin'
git -C "$tmp/work/rumiai-os" config "branch.$target_branch.remote" local || error 'cannot configure target tracking remote'
git -C "$tmp/work/rumiai-os" config "branch.$target_branch.merge" "refs/heads/$target_branch" || error 'cannot configure target tracking branch'

printf 'updated\n' > "$tmp/target-seed/marker" || error 'cannot write target update marker'
git -C "$tmp/target-seed" add marker || error 'cannot stage target update'
commit_repo "$tmp/target-seed" updated-target || error 'cannot commit target update'
git -C "$tmp/target-seed" push -q origin "$target_branch" || error 'cannot push target update'
expected_target=$(git -C "$tmp/target-seed" rev-parse HEAD) || error 'cannot read expected target commit'

mkdir "$tmp/suite-remote.git" || error 'cannot create suite remote directory'
git -C "$tmp/suite-remote.git" init --bare -q || error 'cannot initialize suite remote'
mkdir "$tmp/suite-seed" || error 'cannot create suite seed directory'
git -C "$tmp/suite-seed" init -q || error 'cannot initialize suite seed'
suite_branch=$(git -C "$tmp/suite-seed" symbolic-ref --short HEAD) || error 'cannot determine suite branch'
cp "$suite_root/rumiai-validate" "$tmp/suite-seed/rumiai-validate" || error 'cannot copy launcher bootstrap'
chmod +x "$tmp/suite-seed/rumiai-validate" || error 'cannot make launcher executable'
mkdir -p "$tmp/suite-seed/lib/sh" "$tmp/suite-seed/sessions" "$tmp/suite-seed/validation" ||
    error 'cannot create suite support directories'
cp "$suite_root/lib/rumiai-os-target.lib" "$tmp/suite-seed/lib/rumiai-os-target.lib" || error 'cannot copy target discovery library'

# The initial implementation is intentionally not valid shell. If the bootstrap
# loads it before updating rumiai-tests, the test must fail.
printf '%s\n' 'broken implementation (' > "$tmp/suite-seed/lib/sh/rumiai-validate.lib.sh" ||
    error 'cannot write intentionally broken initial implementation'

cat > "$tmp/suite-seed/rumiai-test" <<'EOT'
#!/bin/sh
suite_root="$(CDPATH= cd "${0%/*}" 2>/dev/null && pwd -P)" || exit 3
printf '%s\n' "$PWD" > "$FAKE_PWD" || exit 3
printf '%s\n' "$*" > "$FAKE_ARGS" || exit 3

case $#:$1:${2-} in
    1:--validation:)
        selection="tests/"
        ;;
    3:--validation:--)
        selection="$3"
        ;;
    *)
        exit 3
        ;;
esac

counter="0"
[ ! -f "$FAKE_SESSION_COUNTER" ] || counter="$(cat "$FAKE_SESSION_COUNTER")" || exit 3
counter="$((counter + 1))"
printf '%s\n' "$counter" > "$FAKE_SESSION_COUNTER" || exit 3
session_name="$(printf 'fake-%04d' "$counter")"
session_dir="$suite_root/sessions/$session_name"
mkdir -p "$session_dir/logs" || exit 3
suite_commit="$(git -C "$suite_root" rev-parse HEAD)" || exit 3
{
    printf 'type\tvalidation\n'
    printf 'start\t2026-09-15T00:00:00+0000\n'
    printf 'end\t2026-09-15T00:00:01+0000\n'
    printf 'selection\t%s\n' "$selection"
    printf 'rumiai-tests-commit\t%s\n' "$suite_commit"
    printf 'runner-exit-status\t0\n'
} > "$session_dir/session" || exit 3
printf 'PASS\tfake.test\t0\n' > "$session_dir/results" || exit 3
: > "$session_dir/logs/fake.log" || exit 3
exit 0
EOT
chmod +x "$tmp/suite-seed/rumiai-test" || error 'cannot make fake runner executable'

initial_target=$(git -C "$tmp/work/rumiai-os" rev-parse HEAD) || error 'cannot read initial target commit'
printf 'rumiai-os-commit\t%s\nselection\told-selection\n' "$initial_target" > "$tmp/suite-seed/validation/zzz-old.conf" ||
    error 'cannot write initial validation scope'

git -C "$tmp/suite-seed" add . || error 'cannot stage initial suite'
commit_repo "$tmp/suite-seed" initial-suite || error 'cannot commit initial suite'
git -C "$tmp/suite-seed" remote add origin "$tmp/suite-remote.git" || error 'cannot add suite remote'
git -C "$tmp/suite-seed" push -q -u origin "$suite_branch" || error 'cannot push initial suite'
git -C "$tmp/suite-remote.git" symbolic-ref HEAD "refs/heads/$suite_branch" || error 'cannot set suite remote HEAD'

mkdir -p "$tmp/work/rumiai-os/src" || error 'cannot create target source directory'
git clone -q "$tmp/suite-remote.git" "$tmp/work/rumiai-os/src/rumiai-tests" || error 'cannot clone suite worktree'
work_suite="$(CDPATH= cd -- "$tmp/work/rumiai-os/src/rumiai-tests" 2>/dev/null && pwd -P)" || error 'cannot canonicalize suite worktree'
git -C "$work_suite" config user.name RumiAI-Test || error 'cannot configure suite test identity'
git -C "$work_suite" config user.email rumiai-test@example.invalid || error 'cannot configure suite test email'

cp "$suite_root/lib/sh/rumiai-validate.lib.sh" "$tmp/suite-seed/lib/sh/rumiai-validate.lib.sh" ||
    error 'cannot install updated launcher implementation'
rm "$tmp/suite-seed/validation/zzz-old.conf" || error 'cannot remove stale validation scope'
printf 'rumiai-os-commit\t%s\nselection\twrong-selection\n' "$expected_target" > "$tmp/suite-seed/validation/alpha.conf" ||
    error 'cannot write alpha validation scope'
printf 'rumiai-os-commit\t%s\nselection\trumiai-os/bootstrap\n' "$expected_target" > "$tmp/suite-seed/validation/beta.conf" ||
    error 'cannot write beta validation scope'
printf 'kind\thealth\nrumiai-os-commit\t%s\n' "$expected_target" > "$tmp/suite-seed/validation/rumiai-os-health.conf" ||
    error 'cannot write full-suite health scope'
git -C "$tmp/suite-seed" add -A lib/sh/rumiai-validate.lib.sh validation ||
    error 'cannot stage suite update'
commit_repo "$tmp/suite-seed" updated-suite || error 'cannot commit suite update'
git -C "$tmp/suite-seed" push -q origin "$suite_branch" || error 'cannot push suite update'
expected_suite=$(git -C "$tmp/suite-seed" rev-parse HEAD) || error 'cannot read expected suite commit'

mkdir "$tmp/elsewhere" || error 'cannot create unrelated working directory'
printf 'local residue\n' > "$work_suite/local-untracked" || error 'cannot create untracked suite residue'

printf 'x\n2\n' | RUMIAI_TEST_RUMIAI_OS_ROOT="$tmp/work/rumiai-os" FAKE_ARGS="$tmp/runner-args" FAKE_PWD="$tmp/runner-pwd" FAKE_SESSION_COUNTER="$tmp/session-counter" \
    sh -c 'cd "$1" && "$2"' sh "$tmp/elsewhere" "$work_suite/rumiai-validate" \
    > "$tmp/first-transcript" 2>&1
first_status=$?

[ "$first_status" -eq 3 ] || {
    cat "$tmp/first-transcript" >&2
    fail "launcher with untracked residue returned $first_status instead of 3"
}

actual_suite=$(git -C "$work_suite" rev-parse HEAD) || error 'cannot read suite commit after self-update'
[ "$actual_suite" = "$expected_suite" ] || fail 'launcher did not fast-forward rumiai-tests before the interactive menu'
[ ! -f "$tmp/runner-args" ] || fail 'runner executed despite dirty validation working tree'
grep -F '  0) all tests' "$tmp/first-transcript" >/dev/null || fail 'full-suite option zero missing from menu'
grep -F '  1) alpha' "$tmp/first-transcript" >/dev/null || fail 'updated alpha scope missing from menu'
grep -F '  2) beta' "$tmp/first-transcript" >/dev/null || fail 'updated beta scope missing from menu'
if grep -F ') rumiai-os-health' "$tmp/first-transcript" >/dev/null; then
    fail 'full-suite health scope was duplicated in numbered task entries'
fi
if grep -F ') zzz-old' "$tmp/first-transcript" >/dev/null; then
    fail 'menu was built before self-update'
fi
grep -F 'enter the number of an available validation scope' "$tmp/first-transcript" >/dev/null ||
    fail 'invalid interactive choice did not request a new number'

rm "$work_suite/local-untracked" || error 'cannot remove test residue'

printf '2\n' | RUMIAI_TEST_RUMIAI_OS_ROOT="$tmp/work/rumiai-os" FAKE_ARGS="$tmp/runner-args" FAKE_PWD="$tmp/runner-pwd" FAKE_SESSION_COUNTER="$tmp/session-counter" \
    sh -c 'cd "$1" && "$2"' sh "$tmp/elsewhere" "$work_suite/rumiai-validate" \
    > "$tmp/second-transcript" 2>&1
second_status=$?
if [ "$second_status" -ne 0 ]; then
    cat "$tmp/second-transcript" >&2
    fail "launcher returned $second_status after cleanup"
fi

actual_target=$(git -C "$tmp/work/rumiai-os" rev-parse HEAD) || error 'cannot read updated target commit'
[ "$actual_target" = "$expected_target" ] || fail 'launcher did not fast-forward rumiai-os before execution'
[ -f "$tmp/runner-args" ] || fail 'configured runner was not executed'
[ "$(cat "$tmp/runner-args")" = '--validation -- rumiai-os/bootstrap' ] ||
    fail 'launcher did not use the numerically selected updated task scope'
[ "$(cat "$tmp/runner-pwd")" = "$work_suite" ] || fail 'launcher did not enter the rumiai-tests repository root before running'
grep -F 'Scope:        beta (task)' "$tmp/second-transcript" >/dev/null ||
    fail 'launcher did not report the selected task scope'

printf '0\n' | RUMIAI_TEST_RUMIAI_OS_ROOT="$tmp/work/rumiai-os" FAKE_ARGS="$tmp/runner-args" FAKE_PWD="$tmp/runner-pwd" FAKE_SESSION_COUNTER="$tmp/session-counter" \
    sh -c 'cd "$1" && "$2"' sh "$tmp/elsewhere" "$work_suite/rumiai-validate" \
    > "$tmp/full-transcript" 2>&1
full_status="$?"
if [ "$full_status" -ne 0 ]; then
    cat "$tmp/full-transcript" >&2
    fail "full-suite option zero returned $full_status"
fi
[ "$(cat "$tmp/runner-args")" = '--validation' ] || fail 'option zero passed a selection instead of running the root suite'
[ "$(cat "$tmp/runner-pwd")" = "$work_suite" ] || fail 'full-suite runner did not execute from the suite root'
grep -F 'Scope:        rumiai-os-health (health)' "$tmp/full-transcript" >/dev/null ||
    fail 'option zero did not select the canonical health scope'
grep -F 'Selection:    tests/ (full suite)' "$tmp/full-transcript" >/dev/null ||
    fail 'full-suite root selection was not reported'
grep -F 'Health result: SUCCESS' "$tmp/full-transcript" >/dev/null || fail 'full-suite health run was not reported successful'

publication_count="$(git -C "$tmp/suite-remote.git" for-each-ref --format='%(refname)' refs/heads/validation/ | wc -l | tr -d ' ')"
[ "$publication_count" -eq 2 ] || fail "expected two published sessions after one task run and one full-suite run, found $publication_count"

exit 0
