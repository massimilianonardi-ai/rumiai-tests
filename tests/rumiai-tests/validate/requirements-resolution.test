#!/bin/sh

TEST_ID=rumiai-tests/validate/requirements-resolution.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }
fatal() { fail "$*"; }

resolve_test_dir() {
    self=$0
    case $self in
        */*) : ;;
        *) self=$(command -v "$self" 2>/dev/null) || return 1 ;;
    esac
    self_dir=${self%/*}
    [ "$self_dir" != "$self" ] || self_dir=.
    CDPATH= cd "$self_dir" 2>/dev/null && pwd -P
}

command -v grep >/dev/null 2>&1 || skip 'grep is required'

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
validate_group=${test_dir%/*}
tests_dir=${validate_group%/*}
suite_source=${tests_dir%/*}
implementation=$suite_source/lib/sh/rumiai-validate.lib.sh
[ -r "$implementation" ] || error 'validation implementation is unavailable'

tmp=${TMPDIR:-/tmp}/rumiai-validate-requirements-$$
umask 077
mkdir -p "$tmp/suite/validation/requirements" "$tmp/evidence" || error 'cannot create temporary fixture'
trap 'rm -rf "$tmp"' 0 HUP INT TERM

runner=$tmp/rumiai-test
cat > "$runner" <<'EOT'
#!/bin/sh
[ "$#" -eq 3 ] && [ "$1" = --list ] && [ "$2" = -- ] || exit 3
case $3 in
    rumiai-os/mk)
        printf '%s\n' rumiai-os/mk/lifecycle.test rumiai-os/mk/watch.test
        ;;
    rumiai-os/mk/watch.test)
        printf '%s\n' rumiai-os/mk/watch.test
        ;;
    rumiai-os/other)
        printf '%s\n' rumiai-os/other/contract.test
        ;;
    *)
        exit 3
        ;;
esac
EOT
chmod +x "$runner" || error 'cannot make fake discovery runner executable'

cat > "$tmp/suite/validation/requirements/mk.conf" <<'EOT'
selection	rumiai-os/mk
target-package	nodejs@v26.10.0
target-package	nodejs@v26.10.0
pkg-catalog-commit	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EOT

cat > "$tmp/suite/validation/requirements/other.conf" <<'EOT'
selection	rumiai-os/other
target-package	temurin@v21
EOT

suite_root=$tmp/suite
. "$implementation" || error 'cannot load validation implementation'
validation_evidence_work=$tmp/evidence

selected=$tmp/selected
printf '%s\n' rumiai-os/mk/lifecycle.test rumiai-os/mk/watch.test > "$selected" ||
    error 'cannot write selected-test fixture'

validation_requirements_resolve "$runner" "$selected"

[ "$validation_target_package_count" -eq 1 ] ||
    fail "expected one deduplicated target package, got $validation_target_package_count"
[ "$validation_target_packages" = 'nodejs@v26.10.0' ] ||
    fail "unexpected resolved target packages: $validation_target_packages"
[ "$expected_pkg_catalog_commit" = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' ] ||
    fail "unexpected resolved pkg-catalog pin: $expected_pkg_catalog_commit"
[ "$validation_requirement_profile_count" -eq 1 ] ||
    fail "expected one active requirement profile, got $validation_requirement_profile_count"
[ "$(cat "$validation_requirement_claimed_tests")" = "$(printf '%s\n' rumiai-os/mk/lifecycle.test rumiai-os/mk/watch.test)" ] ||
    fail 'active requirement profile did not claim the selected mk tests exactly once'

printf '%s\n' rumiai-os/other/contract.test > "$selected" ||
    error 'cannot replace selected-test fixture'

validation_requirements_resolve "$runner" "$selected"

[ "$validation_target_package_count" -eq 1 ] ||
    fail "expected one other target package, got $validation_target_package_count"
[ "$validation_target_packages" = 'temurin@v21' ] ||
    fail "unselected mk requirement leaked into other selection: $validation_target_packages"
[ -z "$expected_pkg_catalog_commit" ] ||
    fail "unselected catalog pin leaked into other selection: $expected_pkg_catalog_commit"

exit 0
