#!/bin/sh

# Characterize the official Electron macOS ARM64 ZIP before attributing any
# bundle-integrity property to an extraction backend. The same verified archive
# is extracted with the current RumiAI ZIP backend and with macOS ditto, then
# the resulting trees, framework symlinks, code-signature verification and
# directly executable Electron runtime are compared.

TEST_ID="external/electron/macos-archive-extraction-live.test"
ELECTRON_VERSION="v44.3.0"
ELECTRON_ARCHIVE="electron-v44.3.0-darwin-arm64.zip"
ELECTRON_URL="https://github.com/electron/electron/releases/download/v44.3.0/electron-v44.3.0-darwin-arm64.zip"
ELECTRON_CODE_RESOURCES="Electron.app/Contents/_CodeSignature/CodeResources"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return 0
      ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3

  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi

  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

bundle_symlink_count()
{
  command -p -- find "$1" -type l -print 2>/dev/null | \
    command -p -- wc -l | \
    command -p -- tr -d '[:space:]'
}

bundle_framework_link_map()
{
  bundle=$1
  framework="$bundle/Contents/Frameworks/Electron Framework.framework"

  for relative in Versions/Current Resources 'Electron Framework'
  do
    candidate="$framework/$relative"
    [ -L "$candidate" ] || return 1
    link_target="$(command -p -- readlink "$candidate" 2>/dev/null)" || return 1
    printf -- '%s=%s\n' "$relative" "$link_target"
  done
}

bundle_tree_manifest()
{
  bundle=$1
  output=$2

  (
    CDPATH= cd -- "$bundle" || exit 1
    LC_ALL=C command -p -- find . -print | LC_ALL=C command -p -- sort
  ) > "$output"
}

report_bundle_shape()
{
  label=$1
  bundle=$2

  if [ ! -d "$bundle" ] || [ -L "$bundle" ]
  then
    printf -- '%s-bundle=missing\n' "$label" >&2
    return 1
  fi

  if [ -f "$bundle/Contents/_CodeSignature/CodeResources" ]
  then
    printf -- '%s-code-resources=present\n' "$label" >&2
  else
    printf -- '%s-code-resources=missing\n' "$label" >&2
  fi

  if [ -d "$bundle/Contents/Resources" ] && [ ! -L "$bundle/Contents/Resources" ]
  then
    printf -- '%s-resources=present\n' "$label" >&2
  else
    printf -- '%s-resources=missing-or-not-real-directory\n' "$label" >&2
  fi

  symlink_count="$(bundle_symlink_count "$bundle")" || return 1
  printf -- '%s-symlinks=%s\n' "$label" "$symlink_count" >&2

  link_map="$(bundle_framework_link_map "$bundle")" || return 1
  printf -- '%s\n' "$link_map" | while IFS= read -r link_line
  do
    printf -- '%s-framework-link[%s]\n' "$label" "$link_line" >&2
  done
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"
[ -x /usr/bin/codesign ] || skip "/usr/bin/codesign is unavailable"
[ -x /usr/bin/ditto ] || skip "/usr/bin/ditto is unavailable"
[ -x /usr/bin/unzip ] || skip "/usr/bin/unzip is unavailable"

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
electron_group=${test_dir%/*}
external_group=${electron_group%/*}
tests_dir=${external_group%/*}
suite_root=${tests_dir%/*}
source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

PATH="$source_root/bin/sys:$PATH"
export PATH

runtime_probe="${TMPDIR:-/tmp}/rumiai-electron-macos-archive-runtime-probe-$$"
cat > "$runtime_probe" <<'EOF_PROBE'
#!/usr/bin/env rumiai-os

. "$m_LIB_DIR/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$runtime_probe" || error "cannot make runtime probe executable"
osarch="$($runtime_probe)" || {
  command -p -- rm -f -- "$runtime_probe"
  fail "cannot obtain RumiAI osarch"
}
command -p -- rm -f -- "$runtime_probe"
[ "$osarch" = macos-arm64 ] || skip "Electron macOS archive extraction validation requires macos-arm64; target is $osarch"

http_fetch="$source_root/bin/sys/http-fetch"
extract_command="$source_root/bin/sys/extract"
digest_command="$source_root/bin/sys/digest"
[ -x "$http_fetch" ] || fail "RumiAI http-fetch command is unavailable"
[ -x "$extract_command" ] || fail "RumiAI extract command is unavailable"
[ -x "$digest_command" ] || fail "RumiAI digest command is unavailable"

tmp="${TMPDIR:-/tmp}/rumiai-electron-macos-archive-extraction-live-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
archive="$tmp/$ELECTRON_ARCHIVE"
archive_entries="$tmp/archive.entries"
rumiai_destination="$tmp/rumiai"
ditto_destination="$tmp/ditto"
mkdir "$rumiai_destination" "$ditto_destination" || error "cannot create extraction destinations"

printf -- '%s\n' "$TEST_ID: downloading $ELECTRON_ARCHIVE" >&2
"$http_fetch" -o "$archive" -- "$ELECTRON_URL" || fail "cannot download official Electron archive"
archive_digest="$($digest_command -a sha256 -- "$archive")" || fail "cannot compute Electron archive SHA-256"
printf -- 'electron-version=%s\n' "$ELECTRON_VERSION" >&2
printf -- 'archive-sha256=%s\n' "$archive_digest" >&2

/usr/bin/unzip -Z1 "$archive" > "$archive_entries" 2> "$tmp/archive-list.err" || {
  command -p -- cat -- "$tmp/archive-list.err" >&2
  fail "cannot inspect official Electron ZIP central directory"
}

archive_code_resources=missing
if LC_ALL=C command -p -- grep -Fx "$ELECTRON_CODE_RESOURCES" "$archive_entries" >/dev/null 2>&1
then
  archive_code_resources=present
fi
archive_signature_entries="$(LC_ALL=C command -p -- grep -E '/_CodeSignature/CodeResources$' "$archive_entries" 2>/dev/null | command -p -- wc -l | command -p -- tr -d '[:space:]')"
printf -- 'archive-outer-code-resources=%s\n' "$archive_code_resources" >&2
printf -- 'archive-code-resources-entries=%s\n' "$archive_signature_entries" >&2

printf -- '%s\n' "$TEST_ID: extracting with the current RumiAI zip backend" >&2
"$extract_command" zip "$archive" "$rumiai_destination" || fail "RumiAI raw zip extraction failed"
rumiai_bundle="$rumiai_destination/Electron.app"
report_bundle_shape rumiai "$rumiai_bundle" || fail "RumiAI extraction produced an invalid Electron bundle shape"

printf -- '%s\n' "$TEST_ID: extracting the same archive with /usr/bin/ditto -x -k" >&2
if ! /usr/bin/ditto -x -k "$archive" "$ditto_destination" >"$tmp/ditto.out" 2>&1
then
  command -p -- cat -- "$tmp/ditto.out" >&2
  fail "diagnostic ditto extraction failed"
fi
ditto_bundle="$ditto_destination/Electron.app"
report_bundle_shape ditto "$ditto_bundle" || fail "ditto extraction produced an invalid Electron bundle shape"

rumiai_manifest="$tmp/rumiai.manifest"
ditto_manifest="$tmp/ditto.manifest"
bundle_tree_manifest "$rumiai_bundle" "$rumiai_manifest" || fail "cannot build RumiAI extraction tree manifest"
bundle_tree_manifest "$ditto_bundle" "$ditto_manifest" || fail "cannot build ditto extraction tree manifest"
if ! command -p -- diff "$rumiai_manifest" "$ditto_manifest" > "$tmp/tree.diff" 2>&1
then
  command -p -- cat -- "$tmp/tree.diff" >&2
  fail "RumiAI and ditto extracted different Electron bundle path trees"
fi

rumiai_symlinks="$(bundle_symlink_count "$rumiai_bundle")" || fail "cannot count RumiAI bundle symlinks"
ditto_symlinks="$(bundle_symlink_count "$ditto_bundle")" || fail "cannot count ditto bundle symlinks"
[ "$rumiai_symlinks" = "$ditto_symlinks" ] || fail "RumiAI and ditto preserved different symlink counts"
rumiai_link_map="$(bundle_framework_link_map "$rumiai_bundle")" || fail "RumiAI extraction did not preserve Electron framework symlinks"
ditto_link_map="$(bundle_framework_link_map "$ditto_bundle")" || fail "ditto extraction did not preserve Electron framework symlinks"
[ "$rumiai_link_map" = "$ditto_link_map" ] || fail "RumiAI and ditto preserved different Electron framework symlink targets"

rumiai_codesign="$tmp/rumiai-codesign.out"
if /usr/bin/codesign --verify --deep --strict --verbose=4 "$rumiai_bundle" >"$rumiai_codesign" 2>&1
then
  rumiai_codesign_status=PASS
else
  rumiai_codesign_status=FAIL
fi
printf -- 'rumiai-codesign=%s\n' "$rumiai_codesign_status" >&2
if [ "$rumiai_codesign_status" = FAIL ]
then
  command -p -- cat -- "$rumiai_codesign" >&2
fi

ditto_codesign="$tmp/ditto-codesign.out"
if /usr/bin/codesign --verify --deep --strict --verbose=4 "$ditto_bundle" >"$ditto_codesign" 2>&1
then
  ditto_codesign_status=PASS
else
  ditto_codesign_status=FAIL
fi
printf -- 'ditto-codesign=%s\n' "$ditto_codesign_status" >&2
if [ "$ditto_codesign_status" = FAIL ]
then
  command -p -- cat -- "$ditto_codesign" >&2
fi

rumiai_executable="$rumiai_bundle/Contents/MacOS/Electron"
ditto_executable="$ditto_bundle/Contents/MacOS/Electron"
[ -f "$rumiai_executable" ] && [ ! -L "$rumiai_executable" ] && [ -x "$rumiai_executable" ] || fail "RumiAI extraction lacks executable Electron runtime"
[ -f "$ditto_executable" ] && [ ! -L "$ditto_executable" ] && [ -x "$ditto_executable" ] || fail "ditto extraction lacks executable Electron runtime"
rumiai_runtime_version="$("$rumiai_executable" --version 2> "$tmp/rumiai-runtime.err")" || {
  command -p -- cat -- "$tmp/rumiai-runtime.err" >&2
  fail "Electron runtime from RumiAI extraction is not executable"
}
ditto_runtime_version="$("$ditto_executable" --version 2> "$tmp/ditto-runtime.err")" || {
  command -p -- cat -- "$tmp/ditto-runtime.err" >&2
  fail "Electron runtime from ditto extraction is not executable"
}
printf -- 'rumiai-runtime-version=%s\n' "$rumiai_runtime_version" >&2
printf -- 'ditto-runtime-version=%s\n' "$ditto_runtime_version" >&2
[ "$rumiai_runtime_version" = "$ditto_runtime_version" ] || fail "RumiAI and ditto extractions execute different Electron runtime versions"
[ "$rumiai_runtime_version" = "$ELECTRON_VERSION" ] || fail "extracted Electron runtime version does not match $ELECTRON_VERSION"

if [ "$archive_code_resources" = present ]
then
  [ "$rumiai_codesign_status" = PASS ] || {
    if [ "$ditto_codesign_status" = PASS ]
    then
      fail "official archive contains outer CodeResources and ditto preserves a valid signature while the current RumiAI ZIP backend does not"
    fi
    fail "official archive contains outer CodeResources but strict signature verification fails after both extraction backends"
  }
  printf -- 'signature-criterion=verified-from-upstream-archive\n'
else
  [ "$rumiai_codesign_status" = "$ditto_codesign_status" ] || fail "signature behavior differs between RumiAI and ditto despite outer CodeResources being absent upstream"
  printf -- 'signature-criterion=outer-code-resources-absent-upstream\n'
fi

printf -- 'archive-outer-code-resources=%s\n' "$archive_code_resources"
printf -- 'tree-comparison=equal\n'
printf -- 'symlink-comparison=equal\n'
printf -- 'runtime-version=%s\n' "$rumiai_runtime_version"
printf -- 'rumiai-codesign=%s\n' "$rumiai_codesign_status"
printf -- 'ditto-codesign=%s\n' "$ditto_codesign_status"

exit 0
