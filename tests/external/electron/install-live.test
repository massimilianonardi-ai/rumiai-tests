#!/bin/sh

TEST_ID=external/electron/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall electron >/dev/null 2>&1 || :
  fi
  [ -z "${system_pkg_state-}" ] || rm -rf "$system_pkg_state" 2>/dev/null || :
  [ -z "${user_pkg_state-}" ] || rm -rf "$user_pkg_state" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

run_live_install()
{
  if [ "$mirror_tty" -eq 1 ]
  then
    { run_pkg install electron; printf '%s\n' "$?" > "$pkg_status"; } 2>&1 |
      command -p -- tee "$pkg_output" /dev/tty
  else
    { run_pkg install electron; printf '%s\n' "$?" > "$pkg_status"; } 2>&1 |
      command -p -- tee "$pkg_output"
  fi
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
electron_group=${test_dir%/*}
external_group=${electron_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

command -v tee >/dev/null 2>&1 || skip 'tee is unavailable'
[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-electron-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
case $osarch in
  linux-arm64|linux-x86_64) :;;
  *) skip "Electron privileged install validation is Linux-only; target is $osarch";;
esac

run_pkg versions electron > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'Electron is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing Electron installation state (status $status)"
    ;;
esac

system_conf=$("$root/m" "$root/bin/sys/state-path" system pkg electron conf) ||
  error 'cannot resolve Electron system state'
user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg electron conf) ||
  error 'cannot resolve Electron user state'
system_pkg_state=${system_conf%/conf}
user_pkg_state=${user_conf%/conf}
if [ -e "$system_pkg_state" ] || [ -L "$system_pkg_state" ] ||
   [ -e "$user_pkg_state" ] || [ -L "$user_pkg_state" ]
then
  skip 'Electron package state already exists in the supplied target'
fi

uid=$(command -p -- id -u 2>/dev/null) || error 'cannot determine effective uid'
case $uid in ''|*[!0-9]*) error "invalid effective uid: $uid";; esac
mirror_tty=0
if [ "$uid" -ne 0 ]
then
  if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
  then
    :
  else
    [ -t 0 ] || skip 'interactive terminal input is required for setuid authorization'
    [ -r /dev/tty ] && [ -w /dev/tty ] || skip '/dev/tty is required for setuid authorization'
    if [ ! -t 1 ] || [ ! -t 2 ]; then mirror_tty=1; fi
  fi
fi

pkg_output=$tmp/pkg.output
pkg_status=$tmp/pkg.status
printf '%s\n' "$TEST_ID: installing current catalog-selected Electron for $osarch" >&2
run_live_install || error 'cannot capture Electron installation'
[ -f "$pkg_status" ] || error 'Electron installation did not record a status'
IFS= read -r status < "$pkg_status" || error 'cannot read Electron install status'
[ "$status" -eq 0 ] || {
  cat "$pkg_output" >&2
  fail "pkg install electron failed with status $status"
}
installed=1

identity=$(run_pkg default electron 2> "$tmp/default.err") || fail 'installed Electron has no current default'
[ -n "$identity" ] || fail 'Electron current identity is empty'
versions=$(run_pkg versions electron 2> "$tmp/versions.err") || fail 'pkg versions electron failed'
printf '%s\n' "$versions" | grep -Fx "$identity" >/dev/null 2>&1 ||
  fail 'current Electron identity is absent from pkg versions output'

"$root/m" electron --version > "$tmp/version.out" 2> "$tmp/version.err" || {
  cat "$tmp/version.out" >&2
  cat "$tmp/version.err" >&2
  fail 'Electron public command failed after privileged installation'
}
[ -s "$tmp/version.out" ] || fail 'Electron --version produced no output'

printf 'installed=%s\n' "$identity"
printf 'osarch=%s\n' "$osarch"
printf 'public-command=ok\n'

exit 0
