#!/bin/sh

TEST_ID=external/electron/macos-launch-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall electron >/dev/null 2>&1 || :
  fi
  [ -z "${user_pkg_state-}" ] || rm -rf "$user_pkg_state" 2>/dev/null || :
  [ -z "${system_pkg_state-}" ] || rm -rf "$system_pkg_state" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
electron_group=${test_dir%/*}
external_group=${electron_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

tmp=${TMPDIR:-/tmp}/rumiai-electron-macos-launch-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
[ "$osarch" = macos-arm64 ] || skip "Electron macOS launch requires macos-arm64; target is $osarch"

run_pkg versions electron > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'Electron is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing Electron installation state (status $status)"
    ;;
esac

user_home=$("$root/m" "$root/bin/sys/state-path" user pkg electron home) ||
  error 'cannot resolve Electron package HOME'
system_conf=$("$root/m" "$root/bin/sys/state-path" system pkg electron conf) ||
  error 'cannot resolve Electron system state'
user_pkg_state=${user_home%/home}
system_pkg_state=${system_conf%/conf}
if [ -e "$user_pkg_state" ] || [ -L "$user_pkg_state" ] ||
   [ -e "$system_pkg_state" ] || [ -L "$system_pkg_state" ]
then
  skip 'Electron package state already exists in the supplied target'
fi

run_pkg install electron > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.err" >&2
  fail 'pkg install electron failed'
}
installed=1

identity=$(run_pkg default electron 2> "$tmp/default.err") ||
  fail 'installed Electron has no current default'
public=$root/bin/ext-$osarch/electron
[ -x "$public" ] || fail 'Electron public command is unavailable'

workload=$tmp/workload
mkdir "$workload" || error 'cannot create Electron workload'
cat > "$workload/package.json" <<'EOF_PACKAGE'
{"name":"rumiai-electron-macos-live","version":"1.0.0","main":"main.js"}
EOF_PACKAGE
cat > "$workload/index.html" <<'EOF_HTML'
<!doctype html><html><head><meta charset="utf-8"><title>rumiai-electron-macos-live</title></head><body>RumiAI Electron macOS live validation</body></html>
EOF_HTML
cat > "$workload/main.js" <<'EOF_MAIN'
const { app, BrowserWindow } = require('electron')
const fs = require('node:fs')
const path = require('node:path')
const marker = process.env.RUMIAI_ELECTRON_TEST_MARKER
let window
function write(lines) { if (marker) fs.writeFileSync(marker, `${lines.join('\n')}\n`, 'utf8') }
const watchdog = setTimeout(() => { write(['error=timeout', `home=${process.env.HOME || ''}`]); app.exit(2) }, 15000)
app.whenReady().then(async () => {
  try {
    window = new BrowserWindow({ show: false })
    await window.loadFile(path.join(__dirname, 'index.html'))
    clearTimeout(watchdog)
    write(['ready=true', `title=${window.getTitle()}`, `home=${process.env.HOME || ''}`, ...process.argv.map(v => `argv=${v}`)])
  } catch (failure) {
    clearTimeout(watchdog)
    write([`error=${failure && failure.stack ? failure.stack : String(failure)}`])
  } finally { app.quit() }
})
EOF_MAIN

marker=$tmp/electron.marker
RUMIAI_ELECTRON_TEST_MARKER=$marker
export RUMIAI_ELECTRON_TEST_MARKER

"$public" "$workload" 'rumiai-argument=a b' > "$tmp/launch.out" 2> "$tmp/launch.err" || {
  cat "$tmp/launch.err" >&2
  fail 'Electron public launch failed'
}

[ -f "$marker" ] || fail 'Electron workload produced no completion marker'
grep -F 'error=' "$marker" >/dev/null 2>&1 &&
  fail "Electron workload reported an error: $(cat "$marker")"
grep -Fx 'ready=true' "$marker" >/dev/null 2>&1 || fail 'Electron never reached ready state'
grep -Fx 'title=rumiai-electron-macos-live' "$marker" >/dev/null 2>&1 || fail 'Electron did not load the validation page'
grep -Fx "home=$user_home" "$marker" >/dev/null 2>&1 || fail 'Electron did not use package HOME'
grep -Fx "argv=$workload" "$marker" >/dev/null 2>&1 || fail 'Electron did not receive the workload path'
grep -Fx 'argv=rumiai-argument=a b' "$marker" >/dev/null 2>&1 || fail 'Electron did not preserve the user argument'

printf 'launched=%s\n' "$identity"
printf 'workload=BrowserWindow-ready\n'

exit 0
