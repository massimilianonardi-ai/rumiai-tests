#!/bin/sh

TEST_ID=external/macgpg/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ -n "${root-}" ] && [ -n "${identity-}" ] && [ -n "${gnupg_home-}" ] &&
     [ -x "$root/pkg/$identity/root/bin/gpgconf" ]
  then
    GNUPGHOME="$gnupg_home" "$root/pkg/$identity/root/bin/gpgconf" --kill all >/dev/null 2>&1 || :
  fi
  [ -z "${gnupg_home-}" ] || rm -rf "$gnupg_home"
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall macgpg >/dev/null 2>&1 || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-macgpg-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
[ "$osarch" = macos-arm64 ] || skip "MacGPG install validation is macos-arm64-only; target is $osarch"

for tool in hdiutil xar cpio gzip
do
  command -v "$tool" >/dev/null 2>&1 || skip "$tool is unavailable"
done

run_pkg versions macgpg > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'MacGPG is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing MacGPG installation state (status $status)"
    ;;
esac

printf '%s\n' "$TEST_ID: installing current catalog-selected MacGPG" >&2
run_pkg install macgpg > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.out" >&2
  cat "$tmp/install.err" >&2
  fail 'pkg install macgpg failed'
}
installed=1

identity=$(run_pkg default macgpg 2> "$tmp/default.err") || {
  cat "$tmp/default.err" >&2
  fail 'installed MacGPG has no queryable current default'
}
[ -n "$identity" ] || fail 'MacGPG current identity is empty'

PATH="$root/bin/ext-$osarch:$root/bin/sys:$PATH" \
  "$root/m" gpg --version > "$tmp/version.out" 2> "$tmp/version.err" || {
  cat "$tmp/version.out" >&2
  cat "$tmp/version.err" >&2
  fail 'gpg --version failed after MacGPG installation'
}
grep -F 'gpg (GnuPG' "$tmp/version.out" >/dev/null 2>&1 ||
  fail 'gpg --version did not identify GnuPG/MacGPG'

gnupg_home=${TMPDIR:-/tmp}/g$$
[ ! -e "$gnupg_home" ] && [ ! -L "$gnupg_home" ] || error 'isolated GNUPGHOME already exists'
mkdir "$gnupg_home" || error 'cannot create isolated GNUPGHOME'
chmod 700 "$gnupg_home" || error 'cannot protect isolated GNUPGHOME'
validation_uid='RumiAI MacGPG Validation <validation@example.invalid>'

pkg_root="$root/pkg/$identity/root"
for helper in gpg-agent gpg-connect-agent gpgconf
do
  [ -x "$pkg_root/bin/$helper" ] || fail "installed MacGPG is missing executable $helper"
done

pinentry="$pkg_root/libexec/pinentry-mac.app/Contents/MacOS/pinentry-mac"
[ -x "$pinentry" ] || fail 'installed MacGPG is missing the pinentry overlay executable'
DYLD_LIBRARY_PATH="$pkg_root/lib" "$pinentry" --version > "$tmp/pinentry-version.out" 2> "$tmp/pinentry-version.err" || {
  cat "$tmp/pinentry-version.out" >&2
  cat "$tmp/pinentry-version.err" >&2
  fail 'relocated pinentry-mac --version failed'
}
grep -i 'pinentry' "$tmp/pinentry-version.out" >/dev/null 2>&1 ||
  grep -i 'pinentry' "$tmp/pinentry-version.err" >/dev/null 2>&1 ||
  fail 'relocated pinentry-mac did not identify itself'

GNUPGHOME="$gnupg_home" \
PATH="$root/bin/ext-$osarch:$root/bin/sys:$PATH" \
  "$root/m" gpg --version > "$tmp/isolated-version.out" 2> "$tmp/isolated-version.err" || {
  cat "$tmp/isolated-version.out" >&2
  cat "$tmp/isolated-version.err" >&2
  fail 'public gpg could not initialize isolated agent configuration'
}

agent_conf="$gnupg_home/gpg-agent.conf"
[ -f "$agent_conf" ] && [ ! -L "$agent_conf" ] ||
  fail 'public gpg did not create a regular isolated gpg-agent.conf'
expected_pinentry="$root/pkg/macgpg!$osarch/root/libexec/pinentry-mac.app/Contents/MacOS/pinentry-mac"
expected_pinentry_line="pinentry-program \"$expected_pinentry\""
grep -Fx "$expected_pinentry_line" "$agent_conf" >/dev/null 2>&1 ||
  fail 'isolated gpg-agent.conf does not point to the relocatable MacGPG pinentry'

legacy_pinentry='/usr/local/MacGPG2/libexec/pinentry-mac.app/Contents/MacOS/pinentry-mac'
printf 'default-cache-ttl 600\npinentry-program "%s"\n' "$legacy_pinentry" > "$agent_conf" ||
  error 'cannot prepare legacy GPGTools pinentry configuration'
GNUPGHOME="$gnupg_home" \
PATH="$root/bin/ext-$osarch:$root/bin/sys:$PATH" \
  "$root/m" gpg --version > "$tmp/legacy-version.out" 2> "$tmp/legacy-version.err" || {
  cat "$tmp/legacy-version.out" >&2
  cat "$tmp/legacy-version.err" >&2
  fail 'public gpg could not migrate legacy GPGTools pinentry configuration'
}
grep -F "$legacy_pinentry" "$agent_conf" >/dev/null 2>&1 &&
  fail 'legacy /usr/local MacGPG pinentry path survived migration'
grep -Fx "$expected_pinentry_line" "$agent_conf" >/dev/null 2>&1 ||
  fail 'legacy GPGTools pinentry path was not migrated to the relocatable path'

GNUPGHOME="$gnupg_home" "$pkg_root/bin/gpgconf" --kill gpg-agent >/dev/null 2>&1 || :

if ! GNUPGHOME="$gnupg_home" "$pkg_root/bin/gpg-agent" \
  --homedir "$gnupg_home" \
  --daemon \
  > "$tmp/agent-daemon.out" 2> "$tmp/agent-daemon.err"
then
  cat "$tmp/agent-daemon.out" >&2
  cat "$tmp/agent-daemon.err" >&2
  "$pkg_root/bin/gpg-agent" --version >&2 || :
  "$pkg_root/bin/gpgconf" --list-dirs >&2 || :
  command -v otool >/dev/null 2>&1 && otool -L "$pkg_root/bin/gpg-agent" >&2 || :
  fail 'gpg-agent could not start directly from the relocated package'
fi

if ! GNUPGHOME="$gnupg_home" "$pkg_root/bin/gpg-connect-agent" \
  --homedir "$gnupg_home" \
  'GETINFO pid' /bye \
  > "$tmp/agent-connect.out" 2> "$tmp/agent-connect.err"
then
  cat "$tmp/agent-daemon.out" >&2
  cat "$tmp/agent-daemon.err" >&2
  cat "$tmp/agent-connect.out" >&2
  cat "$tmp/agent-connect.err" >&2
  "$pkg_root/bin/gpgconf" --list-dirs >&2 || :
  fail 'gpg-connect-agent could not query the directly started relocated agent'
fi
grep '^D [0-9][0-9]*$' "$tmp/agent-connect.out" >/dev/null 2>&1 ||
  fail 'gpg-connect-agent did not return the relocated agent pid'
grep '^OK' "$tmp/agent-connect.out" >/dev/null 2>&1 ||
  fail 'gpg-connect-agent did not complete GETINFO pid with OK'

GNUPGHOME="$gnupg_home" "$pkg_root/bin/gpgconf" --kill gpg-agent >/dev/null 2>&1 ||
  fail 'gpgconf could not stop the directly started relocated agent'

GNUPGHOME="$gnupg_home" \
PATH="$root/bin/ext-$osarch:$root/bin/sys:$PATH" \
  "$root/m" gpg \
    --batch \
    --pinentry-mode loopback \
    --passphrase '' \
    --quick-generate-key "$validation_uid" rsa2048 sign 0 \
    > "$tmp/keygen.out" 2> "$tmp/keygen.err" || {
  cat "$tmp/keygen.out" >&2
  cat "$tmp/keygen.err" >&2
  fail 'gpg could not create a key through its runtime helper path'
}

GNUPGHOME="$gnupg_home" \
PATH="$root/bin/ext-$osarch:$root/bin/sys:$PATH" \
  "$root/m" gpg --batch --with-colons --list-secret-keys "$validation_uid" \
  > "$tmp/secret-keys.out" 2> "$tmp/secret-keys.err" || {
  cat "$tmp/secret-keys.err" >&2
  fail 'gpg could not read the generated secret key'
}
grep '^sec:' "$tmp/secret-keys.out" >/dev/null 2>&1 ||
  fail 'generated secret key was not observable'

printf 'installed=%s\n' "$identity"
printf 'public-command=ok\n'
exit 0
