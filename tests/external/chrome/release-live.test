#!/bin/sh

TEST_ID="external/chrome/release-live.test"
RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE="chrome"
RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS="chrome"
RUMIAI_TEST_PACKAGE_RELEASE_ANALYZE_COMMAND="chrome"
RUMIAI_TEST_PACKAGE_RELEASE_TARGETS="linux-x86_64"
RUMIAI_TEST_PACKAGE_RELEASE_MODE="gui"
RUMIAI_TEST_PACKAGE_RELEASE_CATALOG_TREE="e604224104d352473b1d4cd61a7d18ee467c9ca3"
RUMIAI_TEST_PACKAGE_RELEASE_SETUID_LINUX_X86_64="opt/google/chrome/chrome-sandbox"

resolve_test_dir()
{
  rumiai_test_package_release_self=$0
  case "$rumiai_test_package_release_self" in
    */*) :;;
    *) rumiai_test_package_release_self=$(command -v "$rumiai_test_package_release_self" 2>/dev/null) || return 1;;
  esac
  rumiai_test_package_release_self_dir=${rumiai_test_package_release_self%/*}
  [ "$rumiai_test_package_release_self_dir" != "$rumiai_test_package_release_self" ] || rumiai_test_package_release_self_dir=.
  CDPATH= cd -- "$rumiai_test_package_release_self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || { printf -- "%s: cannot resolve test directory\n" "$TEST_ID" >&2; exit 3; }
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/package-release.lib" || { printf -- "%s: cannot load package release helper\n" "$TEST_ID" >&2; exit 3; }

rumiai_test_package_release_run "$suite_root"
exit $?
