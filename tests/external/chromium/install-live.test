#!/bin/sh

TEST_ID=external/chromium/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall chromium >/dev/null 2>&1 || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-chromium-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
[ "$osarch" = linux-x86_64 ] || skip "Chromium sandbox environment validation is linux-x86_64-only; target is $osarch"

run_pkg versions chromium > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'Chromium is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing Chromium installation state (status $status)"
    ;;
esac

uid=$(command -p -- id -u 2>/dev/null) || error 'cannot determine effective uid'
case $uid in ''|*[!0-9]*) error "invalid effective uid: $uid";; esac
if [ "$uid" -ne 0 ]
then
  if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
  then
    :
  elif [ ! -t 0 ] || [ ! -r /dev/tty ] || [ ! -w /dev/tty ]
  then
    skip 'setuid authorization is unavailable without root, passwordless sudo or an interactive terminal'
  fi
fi

printf '%s\n' "$TEST_ID: installing current catalog-selected Chromium for $osarch" >&2
run_pkg install chromium > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.out" >&2
  cat "$tmp/install.err" >&2
  fail 'pkg install chromium failed'
}
installed=1

identity=$(run_pkg default chromium 2> "$tmp/default.err") || {
  cat "$tmp/default.err" >&2
  fail 'installed Chromium has no queryable current default'
}
[ -n "$identity" ] || fail 'Chromium current identity is empty'

versions=$(run_pkg versions chromium 2> "$tmp/versions.err") || fail 'pkg versions chromium failed'
printf '%s\n' "$versions" | grep -Fx "$identity" >/dev/null 2>&1 ||
  fail 'current Chromium identity is absent from pkg versions output'

concrete=$root/pkg/$identity
[ -d "$concrete" ] && [ ! -L "$concrete" ] ||
  fail 'current Chromium concrete package is not materialized'

sandbox=$concrete/root/chrome_sandbox
[ -f "$sandbox" ] && [ ! -L "$sandbox" ] && [ -x "$sandbox" ] ||
  fail 'Chromium chrome_sandbox is not an executable regular file'

listing=$(LC_ALL=C command -p -- ls -ldn "$sandbox" 2>/dev/null) ||
  fail 'cannot inspect Chromium sandbox ownership'
set -- $listing
[ "$#" -ge 4 ] || error 'cannot parse Chromium sandbox ownership'
[ "$3" = 0 ] && [ "$4" = 0 ] ||
  fail "Chromium sandbox ownership is $3:$4 instead of 0:0"

mode_match=$(command -p -- find "$sandbox" -prune -perm 4755 -print 2>/dev/null) ||
  fail 'cannot inspect Chromium sandbox mode'
[ "$mode_match" = "$sandbox" ] ||
  fail 'Chromium sandbox mode is not exactly 4755'

[ -f "$concrete/env" ] && [ ! -L "$concrete/env" ] && [ -r "$concrete/env" ] ||
  fail 'Chromium package environment is not materialized'

sandbox_from_env="$(
  (
    m_COMMAND_BIN="$concrete/cmd/chromium"
    export m_COMMAND_BIN
    unset CHROME_DEVEL_SANDBOX
    . "$concrete/env" || exit 1
    printf '%s\n' "${CHROME_DEVEL_SANDBOX-}"
  )
)" || fail 'Chromium package environment cannot be applied'
[ "$sandbox_from_env" = "$sandbox" ] ||
  fail "CHROME_DEVEL_SANDBOX is $sandbox_from_env instead of $sandbox"

public=$root/bin/ext-$osarch/chromium
[ -x "$public" ] || fail 'Chromium public command is unavailable'
"$public" --version > "$tmp/version.out" 2> "$tmp/version.err" || {
  cat "$tmp/version.out" >&2
  cat "$tmp/version.err" >&2
  fail 'Chromium public command failed after sandbox environment integration'
}
[ -s "$tmp/version.out" ] || fail 'Chromium --version produced no output'

printf 'installed=%s\n' "$identity"
printf 'osarch=%s\n' "$osarch"
printf 'sandbox=%s\n' "$sandbox"
printf 'CHROME_DEVEL_SANDBOX=%s\n' "$sandbox_from_env"
printf 'public-command=ok\n'

exit 0
