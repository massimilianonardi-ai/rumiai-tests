#!/bin/sh
TEST_ID=external/electron-web-control/install-live.test
fail(){ printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error(){ printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
run_pkg(){ "$root/m" "$root/bin/sys/pkg" "$@"; }
run_srv(){ "$root/m" "$root/bin/sys/srv" "$@"; }

service_started=0
provider_set=0
tmp=/tmp/electron-web-control-live-$$
cleanup(){
  trap - 0 HUP INT TERM
  [ "$service_started" -eq 0 ] || run_srv stop -f web-control >/dev/null 2>&1 || :
  [ "$provider_set" -eq 0 ] || run_pkg provider default -u -- web-control >/dev/null 2>&1 || :
  command -p -- rm -rf -- "$tmp"
}
trap cleanup 0 HUP INT TERM

self=$0
case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || error 'cannot resolve self';; esac
test_dir=$(CDPATH= cd -- "$(dirname -- "$self")" 2>/dev/null && pwd -P) || error 'cannot resolve test dir'
suite_root=$(CDPATH= cd -- "$test_dir/../../.." 2>/dev/null && pwd -P) || error 'cannot resolve suite root'
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root") || fail 'rumiai-os target not found'
command -p -- mkdir "$tmp" || error 'cannot create tmp'

"$root/m" "$root/bin/sys/osarch" update >/dev/null 2>"$tmp/osarch.err" || {
  command -p -- cat "$tmp/osarch.err" >&2
  fail 'osarch update failed'
}

if run_pkg provider default web-control >"$tmp/previous-provider.out" 2>"$tmp/previous-provider.err"
then
  printf '%s\n' "$TEST_ID: existing web-control provider selection; preserving host configuration" >&2
  exit 2
fi
if run_pkg versions electron-web-control >"$tmp/previous-install.out" 2>"$tmp/previous-install.err"
then
  printf '%s\n' "$TEST_ID: Electron web-control is already installed; preserving host state" >&2
  exit 2
fi

# Reproduce the normal provider-substitution scenario: a first provider is
# already installed, and its package-specific service command is published.
run_pkg install pwc-web-control >"$tmp/pwc-install.out" 2>"$tmp/pwc-install.err" || {
  command -p -- cat "$tmp/pwc-install.out" >&2
  command -p -- cat "$tmp/pwc-install.err" >&2
  fail 'cannot install existing Playwright provider before Electron'
}
pwc_identity=$(run_pkg default pwc-web-control) ||
  fail 'Playwright provider package default missing'
previous_service=$root/bin/ext/web-control-service
[ -L "$previous_service" ] ||
  fail 'Playwright provider service command projection missing'
previous_service_target=$(command -p -- readlink "$previous_service") ||
  fail 'cannot identify original provider command target'

# The original provider may already be selected when installing another provider.
run_pkg provider default web-control "$pwc_identity" >"$tmp/pwc-provider.out" 2>"$tmp/pwc-provider.err" ||
  fail 'cannot select existing Playwright provider'
provider_set=1

# Reproduce the physical regression: immutable v0.1.0 materializes
# but its ordinary service command collides with Playwright at default selection.
if run_pkg install electron-web-control@v0.1.0 >"$tmp/legacy.out" 2>"$tmp/legacy.err"
then
  fail 'legacy Electron v0.1.0 unexpectedly selected without command collision'
fi
grep -F 'stage="default-selection"' "$tmp/legacy.err" >/dev/null ||
  fail 'legacy Electron v0.1.0 failed outside default selection'
[ -d "$root/pkg/electron-web-control@v0.1.0" ] ||
  fail 'legacy Electron v0.1.0 did not remain materialized after default-selection failure'
if run_pkg default electron-web-control >"$tmp/legacy-default.out" 2>"$tmp/legacy-default.err"
then
  fail 'legacy Electron v0.1.0 became package default despite command collision'
fi
[ -L "$previous_service" ] ||
  fail 'legacy Electron v0.1.0 removed the Playwright service projection'
[ "$(command -p -- readlink "$previous_service")" = "$previous_service_target" ] ||
  fail 'legacy Electron v0.1.0 replaced the Playwright service projection'

# Explicit version verifies recovery with v0.1.0 already materialized.
run_pkg install electron-web-control@v0.1.1 >"$tmp/install.out" 2>"$tmp/install.err" || {
  command -p -- cat "$tmp/install.out" >&2
  command -p -- cat "$tmp/install.err" >&2
  fail 'pkg install electron-web-control failed'
}

web_identity=$(run_pkg default electron-web-control) || fail 'missing web-control package default'
[ "$web_identity" = 'electron-web-control@v0.1.1' ] ||
  fail "the current v0.1.1 coexistence fix was not selected: $web_identity"
[ -L "$previous_service" ] || fail 'existing Playwright service projection removed'
[ "$(command -p -- readlink "$previous_service")" = "$previous_service_target" ] ||
  fail 'existing Playwright service projection overwritten'
[ -L "$root/bin/ext/electron-web-control-service" ] ||
  fail 'Electron provider-specific service projection missing'

# Upgrade the corrected provider using the real versioned package release.
# The v0.1.2 desktop navigation UI must not reintroduce an ordinary command
# collision or disturb the existing Playwright service projection.
run_pkg install electron-web-control@v0.1.2 >"$tmp/desktop-install.out" 2>"$tmp/desktop-install.err" || {
  command -p -- cat "$tmp/desktop-install.out" >&2
  command -p -- cat "$tmp/desktop-install.err" >&2
  fail 'pkg install electron-web-control@v0.1.2 failed'
}
web_identity=$(run_pkg default electron-web-control) ||
  fail 'desktop-enabled Electron version did not become package default'
[ "$web_identity" = 'electron-web-control@v0.1.2' ] ||
  fail "the desktop-enabled Electron version was not selected: $web_identity"
[ -L "$previous_service" ] ||
  fail 'Electron v0.1.2 removed the Playwright service projection'
[ "$(command -p -- readlink "$previous_service")" = "$previous_service_target" ] ||
  fail 'Electron v0.1.2 overwrote the Playwright service projection'
[ -L "$root/bin/ext/electron-web-control-service" ] ||
  fail 'Electron v0.1.2 service projection missing'

# The native-input implementation is released independently as v0.1.3.
# This asserts real installed concrete selection and provider coexistence,
# not that automated actions have been tried against a live Gmail account.
run_pkg install electron-web-control@v0.1.3 >"$tmp/input-install.out" 2>"$tmp/input-install.err" || {
  command -p -- cat "$tmp/input-install.out" >&2
  command -p -- cat "$tmp/input-install.err" >&2
  fail 'pkg install electron-web-control@v0.1.3 failed'
}
web_identity=$(run_pkg default electron-web-control) ||
  fail 'native-input Electron version did not become package default'
[ "$web_identity" = 'electron-web-control@v0.1.3' ] ||
  fail "the native-input Electron version was not selected: $web_identity"
[ -L "$previous_service" ] ||
  fail 'Electron v0.1.3 removed the Playwright service projection'
[ "$(command -p -- readlink "$previous_service")" = "$previous_service_target" ] ||
  fail 'Electron v0.1.3 overwrote the Playwright service projection'
[ -L "$root/bin/ext/electron-web-control-service" ] ||
  fail 'Electron v0.1.3 service projection missing'

run_pkg default electron >/dev/null || fail 'missing electron dependency default'
run_pkg default nodejs >/dev/null || fail 'missing nodejs dependency default'

# Distinct provider packages must coexist; select Electron only after install.
run_pkg provider default web-control "$web_identity" >"$tmp/provider.out" 2>"$tmp/provider.err" || {
  command -p -- cat "$tmp/provider.err" >&2
  fail 'cannot select web-control facility provider'
}
provider_set=1

public="$root/bin/ext/web-control"
[ -L "$public" ] || fail 'web-control facility command missing'

conf=$("$root/m" "$root/bin/sys/state-path" user pkg electron-web-control conf) || error 'cannot resolve package conf'
command -p -- mkdir -p -- "$conf/.m" || error 'cannot create package conf'
printf '%s\n' 'WEB_CONTROL_HEADLESS=1' 'export WEB_CONTROL_HEADLESS' 'ELECTRON_WEB_CONTROL_SOFTWARE_RENDERING=1' 'export ELECTRON_WEB_CONTROL_SOFTWARE_RENDERING' >"$conf/.m/env" || error 'cannot configure headless mode'

run_srv start web-control >"$tmp/start.out" 2>"$tmp/start.err" || {
  command -p -- cat "$tmp/start.err" >&2
  logdir=$("$root/m" "$root/bin/sys/state-path" user sys srv log 2>/dev/null) || logdir=
  [ -z "$logdir" ] || [ ! -f "$logdir/web-control.log" ] || command -p -- cat "$logdir/web-control.log" >&2
  fail 'srv start web-control failed'
}
service_started=1

"$root/m" "$public" status >"$tmp/status.json" 2>"$tmp/status.err" || fail 'web-control status failed'
grep -F '"headless": true' "$tmp/status.json" >/dev/null || fail 'headless state not observed'
grep -F '"browserRunning": true' "$tmp/status.json" >/dev/null || fail 'browser running state not observed'

"$root/m" "$public" page new >"$tmp/page.json" 2>"$tmp/page.err" || fail 'page new failed'
page_id=$(command -p -- awk -F'"' '/"id": "page-/{print $4; exit}' "$tmp/page.json")
[ -n "$page_id" ] || fail 'cannot parse page id'

url='data:text/html,<body>ready</body>'
"$root/m" "$public" page navigate "$page_id" "$url" >/dev/null 2>"$tmp/nav.err" || fail 'page navigate failed'
"$root/m" "$public" page inspect "$page_id" text >"$tmp/inspect.json" 2>"$tmp/inspect.err" || fail 'page inspect failed'
grep -F ready "$tmp/inspect.json" >/dev/null || fail 'rendered page text missing'

"$root/m" "$public" page capture "$page_id" "$tmp/capture" html text screenshot >"$tmp/capture.json" 2>"$tmp/capture.err" || {
  command -p -- cat "$tmp/capture.err" >&2
  fail 'electron capture failed'
}
[ -s "$tmp/capture/page.html" ] || fail 'HTML capture missing'
[ -s "$tmp/capture/page.txt" ] || fail 'text capture missing'
[ -s "$tmp/capture/page.png" ] || fail 'PNG capture missing'


"$root/m" "$public" page list >"$tmp/page-list.json" 2>"$tmp/page-list.err" ||
  fail 'cannot enumerate Electron browser windows'
page_ids=$(command -p -- awk -F'"' '/"id": "page-/{print $4}' "$tmp/page-list.json")
[ -n "$page_ids" ] || fail 'browser window listing unexpectedly empty'
for current_page in $page_ids
do
  "$root/m" "$public" page close "$current_page" >"$tmp/close.out" 2>"$tmp/close.err" ||
    fail 'cannot close Electron window'
done

browser_absent=0
browser_attempt=0
while [ "$browser_attempt" -lt 40 ]
do
  browser_attempt=$((browser_attempt + 1))
  if "$root/m" "$public" status >"$tmp/browser-absent-status.json" 2>"$tmp/browser-absent-status.err" &&
     grep -F '"browserRunning": false' "$tmp/browser-absent-status.json" >/dev/null
  then
    browser_absent=1
    break
  fi
  sleep 1
done
[ "$browser_absent" -eq 1 ] ||
  fail 'controller did not report absence of browser windows'

run_srv start web-control >"$tmp/still-running.out" 2>"$tmp/still-running.err" ||
  fail 'controller process stopped after closing browser windows'
grep -F ' already running pid=' "$tmp/still-running.out" >/dev/null ||
  fail 'Electron controller did not remain active'

"$root/m" "$public" page new >"$tmp/relaunch-page.json" 2>"$tmp/relaunch-page.err" || fail 'page new failed to relaunch browser'
relaunch_page_id=$(command -p -- awk -F'"' '/"id": "page-/{print $4; exit}' "$tmp/relaunch-page.json")
[ -n "$relaunch_page_id" ] || fail 'cannot parse relaunched page id'

"$root/m" "$public" status >"$tmp/relaunch-status.json" 2>"$tmp/relaunch-status.err" || fail 'web-control status failed after browser relaunch'
grep -F '"browserRunning": true' "$tmp/relaunch-status.json" >/dev/null || fail 'Electron window was not recreated on demand'

relaunch_url='data:text/html,<body>relaunched</body>'
"$root/m" "$public" page navigate "$relaunch_page_id" "$relaunch_url" >/dev/null 2>"$tmp/relaunch-nav.err" || fail 'relaunched page navigate failed'
"$root/m" "$public" page inspect "$relaunch_page_id" text >"$tmp/relaunch-inspect.json" 2>"$tmp/relaunch-inspect.err" || fail 'relaunched page inspect failed'
grep -F relaunched "$tmp/relaunch-inspect.json" >/dev/null || fail 'relaunched browser page text missing'

run_srv stop -f web-control >"$tmp/stop.out" 2>"$tmp/stop.err" || fail 'srv stop web-control failed'
service_started=0
printf '%s\n' 'electron-web-control-package-live=ok'
