#!/bin/sh

TEST_ID=external/netbeans/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${netbeans_installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall netbeans >/dev/null 2>&1 || :
  fi
  if [ "${java_installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall java >/dev/null 2>&1 || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-netbeans-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
[ "$osarch" = linux-x86_64 ] || skip "NetBeans matrix validation is linux-x86_64-only; target is $osarch"

run_pkg versions netbeans > "$tmp/netbeans-preexisting.out" 2> "$tmp/netbeans-preexisting.err"
status=$?
case $status in
  0) skip 'NetBeans is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/netbeans-preexisting.err" >&2
    fail "cannot determine pre-existing NetBeans installation state (status $status)"
    ;;
esac

run_pkg versions java > "$tmp/java-preexisting.out" 2> "$tmp/java-preexisting.err"
status=$?
case $status in
  0) skip 'Temurin Java package is already installed in the supplied target';;
  1)
    printf '%s\n' "$TEST_ID: installing Temurin Java provider" >&2
    run_pkg install java > "$tmp/java-install.out" 2> "$tmp/java-install.err" || {
      cat "$tmp/java-install.out" >&2
      cat "$tmp/java-install.err" >&2
      fail 'pkg install java failed'
    }
    java_installed=1
    ;;
  *)
    cat "$tmp/java-preexisting.err" >&2
    fail "cannot determine pre-existing Java installation state (status $status)"
    ;;
esac

java_identity=$(run_pkg default java 2> "$tmp/java-default.err") || {
  cat "$tmp/java-default.err" >&2
  fail 'Temurin Java provider has no queryable current default'
}
[ -n "$java_identity" ] || fail 'Temurin Java provider identity is empty'

printf '%s\n' "$TEST_ID: installing current catalog-selected NetBeans" >&2
run_pkg install netbeans > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.out" >&2
  cat "$tmp/install.err" >&2
  fail 'pkg install netbeans failed'
}
netbeans_installed=1

identity=$(run_pkg default netbeans 2> "$tmp/default.err") || {
  cat "$tmp/default.err" >&2
  fail 'installed NetBeans has no queryable current default'
}
[ -n "$identity" ] || fail 'NetBeans current identity is empty'

public="$root/bin/ext-$osarch/netbeans"
[ -e "$public" ] || [ -L "$public" ] || fail 'NetBeans public command binding is missing'
[ -x "$public" ] || fail 'NetBeans public command binding is not executable'

printf 'installed=%s\n' "$identity"
printf 'java-provider=%s\n' "$java_identity"
printf 'public-command-binding=ok\n'

exit 0
