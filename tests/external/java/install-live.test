#!/bin/sh

TEST_ID=external/java/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall java >/dev/null 2>&1 || :
  fi
  [ -z "${system_pkg_state-}" ] || rm -rf "$system_pkg_state" 2>/dev/null || :
  [ -z "${user_pkg_state-}" ] || rm -rf "$user_pkg_state" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'
[ -x "$root/bin/sys/state-path" ] || fail 'state-path command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-java-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
case $osarch in
  linux-arm64|linux-x86_64|macos-arm64|macos-x86_64|windows-x86_64) :;;
  *) skip "Java is not declared for $osarch";;
esac

run_pkg versions java > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'Java is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing Java installation state (status $status)"
    ;;
esac

system_conf=$("$root/m" "$root/bin/sys/state-path" system pkg java conf) ||
  error 'cannot resolve Java system state'
user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg java conf) ||
  error 'cannot resolve Java user state'
system_pkg_state=${system_conf%/conf}
user_pkg_state=${user_conf%/conf}
if [ -e "$system_pkg_state" ] || [ -L "$system_pkg_state" ] ||
   [ -e "$user_pkg_state" ] || [ -L "$user_pkg_state" ]
then
  skip 'Java package state already exists in the supplied target'
fi

printf '%s\n' "$TEST_ID: installing current catalog-selected Eclipse Temurin Java for $osarch" >&2
run_pkg install java > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.out" >&2
  cat "$tmp/install.err" >&2
  fail 'pkg install java failed'
}
installed=1

identity=$(run_pkg default java 2> "$tmp/default.err") || {
  cat "$tmp/default.err" >&2
  fail 'installed Java has no queryable current default'
}
[ -n "$identity" ] || fail 'Java current identity is empty'

versions=$(run_pkg versions java 2> "$tmp/versions.err") || fail 'pkg versions java failed'
printf '%s\n' "$versions" | grep -Fx "$identity" >/dev/null 2>&1 ||
  fail 'current Java identity is absent from pkg versions output'

concrete="$root/pkg/$identity"
[ -d "$concrete/root" ] && [ ! -L "$concrete/root" ] ||
  fail 'Java concrete root is missing'
[ -f "$concrete/facility" ] && [ ! -L "$concrete/facility" ] ||
  fail 'Java facility declaration was not materialized'
[ "$(cat "$concrete/facility")" = 'java 25' ] ||
  fail 'Java facility declaration is not java 25'

case $osarch in
  windows-x86_64) java_bin="$concrete/root/bin/java.exe";;
  *) java_bin="$concrete/root/bin/java";;
esac
[ -x "$java_bin" ] || fail 'normalized Java runtime executable is missing'
"$java_bin" --version > "$tmp/version.out" 2> "$tmp/version.err" || {
  cat "$tmp/version.out" >&2
  cat "$tmp/version.err" >&2
  fail 'installed Java runtime failed'
}
cat "$tmp/version.out" "$tmp/version.err" > "$tmp/version.combined" ||
  error 'cannot combine Java version output'
[ -s "$tmp/version.combined" ] || fail 'Java --version produced no output'
grep -E '(^|[^0-9])25([. +]|$)' "$tmp/version.combined" >/dev/null 2>&1 ||
  fail 'installed Java runtime does not report feature version 25'

printf 'installed=%s\n' "$identity"
printf 'osarch=%s\n' "$osarch"
printf 'facility=java-25\n'
printf 'runtime=ok\n'

exit 0
