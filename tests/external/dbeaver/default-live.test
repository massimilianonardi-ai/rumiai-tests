#!/bin/sh

TEST_ID="external/dbeaver/default-live.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

# Reference implementations copied from:
# massimilianonardi-ai/rumiai-tests@20541774bab0d0a7d64bd9cd06833b14196bbdf9:lib/rumiai-os-target.lib
# massimilianonardi-ai/rumiai-tests@20541774bab0d0a7d64bd9cd06833b14196bbdf9:lib/rumiai-os-fixture.lib
# Copied inline intentionally to preserve test independence.
rumiai_test_target_have() { command -v "$1" >/dev/null 2>&1; }
rumiai_test_target_rumiai_os_origin_ok()
{
  candidate="$1"
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git) return 0 ;;
  esac
  return 1
}
rumiai_test_target_rumiai_os_validate()
{
  candidate="$1"
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/m" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  [ -f "$candidate/rumiai-os-sh" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/m" ] || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  [ -f "$target_root/rumiai-os-sh" ] || return 1
  printf -- '%s\n' "$target_root"
}
rumiai_test_target_rumiai_os_find()
{
  start="$1"
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]; then rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2; return 0; fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :; do
    if rumiai_test_target_rumiai_os_validate "$candidate"; then return 0; fi
    [ "$candidate" != / ] || break
    parent="${candidate%/*}"; [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate="$parent"
  done
  return 1
}
rumiai_test_fixture_rumiai_os_create()
{
  [ "$#" -eq 2 ] || return 3
  source_root="$1"; fixture_root="$2"
  [ -n "$source_root" ] && [ -n "$fixture_root" ] || return 3
  for required in m rumiai-os rumiai-os-sh product-name product-version; do [ -f "$source_root/$required" ] || return 1; done
  for required in bin lib lang state; do [ -d "$source_root/$required" ] || return 1; done
  [ ! -e "$fixture_root" ] || return 2
  mkdir -p "$fixture_root/pkg" "$fixture_root/src" || return 2
  for fixture_file in m rumiai-os rumiai-os-sh product-name product-version; do cp "$source_root/$fixture_file" "$fixture_root/$fixture_file" || { rm -rf "$fixture_root"; return 2; }; done
  for fixture_dir in bin lib lang state; do cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir" || { rm -rf "$fixture_root"; return 2; }; done
  chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh" || { rm -rf "$fixture_root"; return 2; }
}
resolve_test_dir()
{
  self="$0"; case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"
test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
dbeaver_group="${test_dir%/*}"; external_group="${dbeaver_group%/*}"; tests_dir="${external_group%/*}"; suite_root="${tests_dir%/*}"
source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status="$?"
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

tmp="${TMPDIR:-/tmp}/rumiai-dbeaver-default-live-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"
status="$?"
case "$status" in 0) : ;; 1) fail "source checkout lacks required runtime material" ;; 2) error "cannot materialize isolated fixture" ;; *) error "fixture primitive returned unexpected status $status" ;; esac
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

runtime_probe="$tmp/runtime-probe"
cat > "$runtime_probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$runtime_probe" || error "cannot make runtime probe executable"
PATH="$fixture/bin/sys:$PATH"; export PATH
osarch="$($runtime_probe)" || fail "cannot obtain RumiAI osarch from isolated root"
[ -n "$osarch" ] || error "RumiAI osarch probe returned empty output"
case "$osarch" in linux-arm64|linux-x86_64|macos-arm64|macos-x86_64) : ;; *) skip "DBeaver live default is not defined for reference target $osarch" ;; esac

pkg_command="$fixture/bin/sys/pkg"
[ -x "$pkg_command" ] || fail "isolated pkg command is missing"
stdout="$tmp/pkg.stdout"; stderr="$tmp/pkg.stderr"
"$pkg_command" install dbeaver > "$stdout" 2> "$stderr"
status="$?"
if [ "$status" -ne 0 ]; then cat "$stdout" >&2; cat "$stderr" >&2; fail "pkg install dbeaver failed with status $status"; fi

concrete=""; concrete_count=0
for candidate in "$fixture/pkg"/dbeaver@*"!$osarch"; do [ -e "$candidate" ] || [ -L "$candidate" ] || continue; concrete_count=$((concrete_count + 1)); concrete="$candidate"; done
[ "$concrete_count" -eq 1 ] || fail "expected one target-specific DBeaver concrete version, found $concrete_count"
[ -d "$concrete" ] && [ ! -L "$concrete" ] || fail "DBeaver concrete version is not a real directory"
identity="${concrete##*/}"; version_osarch="${identity#dbeaver@}"; version="${version_osarch%"!$osarch"}"
[ -n "$version" ] && [ "$version" != "$version_osarch" ] || fail "cannot derive installed DBeaver version from $identity"

selector="$fixture/pkg/dbeaver!$osarch"; public_binding="$fixture/bin/ext-$osarch/dbeaver"
[ ! -e "$selector" ] && [ ! -L "$selector" ] || fail "pkg install selected a target default unexpectedly"
[ ! -e "$public_binding" ] && [ ! -L "$public_binding" ] || fail "pkg install exposed a public DBeaver command unexpectedly"

default_probe="$tmp/default-probe"
cat > "$default_probe" <<'EOF_DEFAULT'
#!/usr/bin/env m
[ "$#" -eq 3 ] || exit 2
. "$m_LIB_DIR/sys/sh/pkg-integration.lib.sh"
pkg_default "$1" "$2" "$3"
EOF_DEFAULT
chmod 700 "$default_probe" || error "cannot make default probe executable"
"$default_probe" dbeaver "$version" "$osarch" || fail "pkg_default dbeaver failed"

expected_selector_target="dbeaver@$version!$osarch"
[ -L "$selector" ] || fail "target current selector was not created"
[ "$(readlink "$selector")" = "$expected_selector_target" ] || fail "target current selector is incorrect"
[ -d "$selector" ] || fail "target current selector does not resolve to the concrete package"
expected_public_target="../../pkg/dbeaver!$osarch/cmd/dbeaver"
[ -L "$public_binding" ] || fail "target public DBeaver binding was not created"
[ "$(readlink "$public_binding")" = "$expected_public_target" ] || fail "target public DBeaver binding is incorrect"
resolved_public="$(command -p -- realpath -- "$public_binding" 2>/dev/null)" || fail "cannot resolve public DBeaver binding"
[ "$resolved_public" = "$concrete/cmd/dbeaver" ] || fail "public DBeaver binding does not resolve through current to the installed command"
[ -f "$resolved_public" ] && [ -x "$resolved_public" ] || fail "public DBeaver binding does not resolve to an executable command"
[ ! -e "$fixture/pkg/dbeaver" ] && [ ! -L "$fixture/pkg/dbeaver" ] || fail "generic DBeaver selector was created for a target-specific package"
[ ! -e "$fixture/bin/ext/dbeaver" ] && [ ! -L "$fixture/bin/ext/dbeaver" ] || fail "generic public DBeaver binding was created for a target-specific package"

printf -- 'default=%s\n' "$identity"
printf -- 'selector-target=%s\n' "$(readlink "$selector")"
printf -- 'binding-target=%s\n' "$(readlink "$public_binding")"
exit 0
