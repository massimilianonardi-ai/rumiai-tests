#!/bin/sh

TEST_ID=external/dbeaver/launch-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

launch_pid=
terminate_launch()
{
  [ -n "$launch_pid" ] || return 0
  if kill -s 0 "$launch_pid" 2>/dev/null
  then
    kill -s TERM "$launch_pid" 2>/dev/null || :
    wait_count=0
    while kill -s 0 "$launch_pid" 2>/dev/null && [ "$wait_count" -lt 10 ]
    do
      sleep 1
      wait_count=$((wait_count + 1))
    done
    if kill -s 0 "$launch_pid" 2>/dev/null
    then
      kill -s KILL "$launch_pid" 2>/dev/null || :
    fi
  fi
  wait "$launch_pid" 2>/dev/null || :
  launch_pid=
}

cleanup()
{
  trap - 0 HUP INT TERM
  terminate_launch

  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall dbeaver >/dev/null 2>&1 || :
  fi
  [ -z "${user_pkg_state-}" ] || rm -rf "$user_pkg_state" 2>/dev/null || :
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

confirm_gui_visible()
{
  ( : < /dev/tty > /dev/tty ) 2>/dev/null || return 2
  printf '%s' 'DBeaver window visible? Press Enter to confirm, or type n then Enter if it did not appear: ' > /dev/tty || return 3
  reply=
  IFS= read -r reply < /dev/tty || return 3
  case $reply in
    ''|y|Y|yes|YES|Yes) return 0;;
    n|N|no|NO|No) return 1;;
    *) return 1;;
  esac
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
dbeaver_group=${test_dir%/*}
external_group=${dbeaver_group%/*}
suite_root=${external_group%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

( : < /dev/tty > /dev/tty ) 2>/dev/null ||
  skip 'interactive graphical confirmation requires /dev/tty'

tmp=${TMPDIR:-/tmp}/rumiai-dbeaver-launch-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'

case $osarch in
  linux-arm64|linux-x86_64)
    [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ] ||
      skip 'graphical session is unavailable'
    ;;
  macos-arm64|macos-x86_64)
    command -v launchctl >/dev/null 2>&1 || skip 'launchctl is unavailable'
    command -v id >/dev/null 2>&1 || skip 'id is unavailable'
    uid=$(id -u) || error 'cannot determine current user id'
    launchctl print "gui/$uid" >/dev/null 2>&1 ||
      skip 'graphical login session is unavailable'
    ;;
  *) skip "DBeaver live launch is not defined for $osarch";;
esac

run_pkg versions dbeaver > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
status=$?
case $status in
  0) skip 'DBeaver is already installed in the supplied target';;
  1) :;;
  *)
    cat "$tmp/preexisting.err" >&2
    fail "cannot determine pre-existing DBeaver installation state (status $status)"
    ;;
esac

user_home=$("$root/m" "$root/bin/sys/state-path" user pkg dbeaver home) ||
  error 'cannot resolve DBeaver HOME state'
user_conf=$("$root/m" "$root/bin/sys/state-path" user pkg dbeaver conf) ||
  error 'cannot resolve DBeaver configuration state'
user_pkg_state=${user_home%/home}
if [ -e "$user_pkg_state" ] || [ -L "$user_pkg_state" ]
then
  skip 'DBeaver user state already exists in the supplied target'
fi

run_pkg install dbeaver > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.err" >&2
  fail 'pkg install dbeaver failed'
}
installed=1

identity=$(run_pkg default dbeaver 2> "$tmp/default.err") ||
  fail 'installed DBeaver has no current default'
public=$root/bin/ext-$osarch/dbeaver
[ -x "$public" ] || fail 'DBeaver public command is unavailable'

configuration=$user_conf/configuration
workspace_metadata=$user_home/.workspace/.metadata
[ ! -e "$configuration" ] && [ ! -L "$configuration" ] ||
  fail 'DBeaver configuration exists before launch'
[ ! -e "$workspace_metadata" ] && [ ! -L "$workspace_metadata" ] ||
  fail 'DBeaver workspace metadata exists before launch'

"$public" -newInstance -nosplash > "$tmp/launch.out" 2> "$tmp/launch.err" &
launch_pid=$!

ready=0
count=0
while [ "$count" -lt 60 ]
do
  if [ -d "$configuration" ] && [ -d "$workspace_metadata" ]
  then
    ready=1
    break
  fi
  if ! kill -s 0 "$launch_pid" 2>/dev/null
  then
    wait "$launch_pid"
    status=$?
    launch_pid=
    cat "$tmp/launch.out" >&2
    cat "$tmp/launch.err" >&2
    fail "DBeaver exited before creating runtime state: $status"
  fi
  sleep 1
  count=$((count + 1))
done

[ "$ready" -eq 1 ] || {
  cat "$tmp/launch.out" >&2
  cat "$tmp/launch.err" >&2
  fail 'DBeaver did not create expected runtime state'
}

confirm_gui_visible
confirmation=$?
case $confirmation in
  0) :;;
  2) skip 'interactive graphical confirmation became unavailable';;
  *) fail 'DBeaver window was not positively confirmed';;
esac

terminate_launch

[ -d "$user_home" ] && [ ! -L "$user_home" ] ||
  fail 'DBeaver package HOME was not materialized through state-path'

printf 'launched=%s\n' "$identity"
printf 'configuration=created\n'
printf 'workspace=created\n'
printf 'gui-visible=confirmed\n'

exit 0
