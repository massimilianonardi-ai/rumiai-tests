#!/bin/sh

TEST_ID=external/dbeaver/install-live.test
fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

run_pkg()
{
  "$root/m" "$root/bin/sys/pkg" "$@"
}

cleanup()
{
  trap - 0 HUP INT TERM
  if [ "${installed-0}" -eq 1 ] && [ -n "${root-}" ]
  then
    run_pkg uninstall dbeaver >/dev/null 2>&1 || :
  fi
  [ -z "${tmp-}" ] || rm -rf "$tmp"
}
trap cleanup 0 HUP INT TERM

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
dbeaver_group=${test_dir%/*}
external_group=${dbeaver_group%/*}
suite_root=${external_group%/*}

. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot load target discovery'
root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

command -v git >/dev/null 2>&1 || skip 'git is unavailable'
[ -x "$root/m" ] || fail 'm bootstrap is missing'
[ -x "$root/bin/sys/pkg" ] || fail 'pkg command is missing'

tmp=${TMPDIR:-/tmp}/rumiai-dbeaver-install-live-$$
umask 077
mkdir "$tmp" || error 'cannot create temporary directory'

PATH="$root/bin/sys:$PATH"
export PATH
probe=$tmp/osarch
cat > "$probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$probe" || error 'cannot prepare osarch probe'
osarch=$("$root/m" "$probe") || fail 'cannot determine RumiAI osarch'
case $osarch in
  linux-arm64|linux-x86_64|macos-arm64|macos-x86_64) :;;
  *) skip "DBeaver is not declared for $osarch";;
esac

if run_pkg versions dbeaver > "$tmp/preexisting.out" 2> "$tmp/preexisting.err"
then
  skip 'DBeaver is already installed in the supplied target'
fi
[ "$?" -eq 1 ] || fail 'cannot determine pre-existing DBeaver installation state'

printf '%s\n' "$TEST_ID: installing current catalog-selected DBeaver for $osarch" >&2
run_pkg install dbeaver > "$tmp/install.out" 2> "$tmp/install.err" || {
  cat "$tmp/install.out" >&2
  cat "$tmp/install.err" >&2
  fail 'pkg install dbeaver failed'
}
installed=1

identity=$(run_pkg default dbeaver 2> "$tmp/default.err") || {
  cat "$tmp/default.err" >&2
  fail 'installed DBeaver has no queryable current default'
}
[ -n "$identity" ] || fail 'pkg default dbeaver returned an empty identity'

versions=$(run_pkg versions dbeaver 2> "$tmp/versions.err") || fail 'pkg versions dbeaver failed'
printf '%s\n' "$versions" | grep -Fx "$identity" >/dev/null 2>&1 ||
  fail 'current DBeaver identity is absent from pkg versions output'

public=$root/bin/ext-$osarch/dbeaver
[ -e "$public" ] || [ -L "$public" ] || fail 'DBeaver public command binding is missing'
[ -x "$public" ] || fail 'DBeaver public command binding is not executable'

printf 'installed=%s\n' "$identity"
printf 'osarch=%s\n' "$osarch"
printf 'public-command=available\n'

exit 0
