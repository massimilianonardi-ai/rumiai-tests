#!/bin/sh

TEST_ID="external/dbeaver/install-live.test"

fail()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 1
}

error()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 3
}

skip()
{
  printf -- '%s\n' "$TEST_ID: $*" >&2
  exit 2
}

rumiai_test_target_have()
{
  command -v "$1" >/dev/null 2>&1
}

rumiai_test_target_rumiai_os_origin_ok()
{
  candidate=$1
  origin="$(git -C "$candidate" config --get remote.origin.url 2>/dev/null)" || return 1
  case "$origin" in
    https://github.com/massimilianonardi-ai/rumiai-os.git|git@github.com:massimilianonardi-ai/rumiai-os.git|ssh://git@github.com/massimilianonardi-ai/rumiai-os.git)
      return 0
      ;;
  esac
  return 1
}

rumiai_test_target_rumiai_os_validate()
{
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -f "$candidate/rumiai-os" ] || return 1
  rumiai_test_target_rumiai_os_origin_ok "$candidate" || return 1
  target_root="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  [ -f "$target_root/rumiai-os" ] || return 1
  printf -- '%s\n' "$target_root"
}

rumiai_test_target_rumiai_os_find()
{
  start=$1
  rumiai_test_target_have git || return 3
  if [ -n "${RUMIAI_TEST_RUMIAI_OS_ROOT-}" ]
  then
    rumiai_test_target_rumiai_os_validate "$RUMIAI_TEST_RUMIAI_OS_ROOT" || return 2
    return 0
  fi
  candidate="$(CDPATH= cd -- "$start" 2>/dev/null && pwd -P)" || return 3
  while :
  do
    if rumiai_test_target_rumiai_os_validate "$candidate"
    then
      return 0
    fi
    [ "$candidate" != / ] || break
    parent=${candidate%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" != "$candidate" ] || break
    candidate=$parent
  done
  return 1
}

rumiai_test_fixture_rumiai_os_create()
{
  [ "$#" -eq 2 ] || return 3
  source_root=$1
  fixture_root=$2
  [ -n "$source_root" ] || return 3
  [ -n "$fixture_root" ] || return 3
  [ -f "$source_root/rumiai-os" ] || return 1
  [ -d "$source_root/bin" ] || return 1
  [ -d "$source_root/lib" ] || return 1
  [ -d "$source_root/lang" ] || return 1
  [ ! -e "$fixture_root" ] || return 2
  mkdir -p "$fixture_root/conf/bootstrap" || return 2
  cp "$source_root/rumiai-os" "$fixture_root/rumiai-os" || {
    rm -rf "$fixture_root"
    return 2
  }
  cp -R "$source_root/bin" "$fixture_root/bin" || {
    rm -rf "$fixture_root"
    return 2
  }
  cp -R "$source_root/lib" "$fixture_root/lib" || {
    rm -rf "$fixture_root"
    return 2
  }
  cp -R "$source_root/lang" "$fixture_root/lang" || {
    rm -rf "$fixture_root"
    return 2
  }
  chmod u+x "$fixture_root/rumiai-os" || {
    rm -rf "$fixture_root"
    return 2
  }
  return 0
}

resolve_test_dir()
{
  self=$0
  case "$self" in
    */*) : ;;
    *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;;
  esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"
test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
dbeaver_group=${test_dir%/*}
external_group=${dbeaver_group%/*}
tests_dir=${external_group%/*}
suite_root=${tests_dir%/*}
source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"
status=$?
case "$status" in
  0) : ;;
  1) skip "rumiai-os target checkout not found" ;;
  2) fail "invalid explicit rumiai-os target" ;;
  *) error "target discovery failed" ;;
esac

tmp="${TMPDIR:-/tmp}/rumiai-dbeaver-install-live-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture="$tmp/root"

rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture"
status=$?
case "$status" in
  0) : ;;
  1) fail "source checkout lacks required runtime material" ;;
  2) error "cannot materialize isolated fixture" ;;
  *) error "fixture primitive returned unexpected status $status" ;;
esac
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"
mkdir -p \
  "$fixture/pkg" \
  "$fixture/src" \
  "$fixture/data" \
  "$fixture/home" \
  "$fixture/cache" \
  "$fixture/log" \
  "$fixture/run" \
  "$fixture/tmp" || error "cannot create isolated semantic roots"

runtime_probe="$tmp/runtime-probe"
cat > "$runtime_probe" <<'EOF_PROBE'
#!/usr/bin/env rumiai-os
printf -- '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$runtime_probe" || error "cannot make runtime probe executable"

PATH="$fixture/bin/sys:/usr/bin:/bin"
export PATH
osarch="$($runtime_probe)" || fail "cannot obtain RumiAI osarch from isolated root"
case "$osarch" in
  linux-arm64|linux-x86_64|macos-arm64|macos-x86_64) : ;;
  *) skip "DBeaver live install is not defined for reference target $osarch" ;;
esac

pkg_command="$fixture/bin/sys/pkg"
[ -x "$pkg_command" ] || fail "isolated pkg command is missing"

stdout="$tmp/pkg.stdout"
stderr="$tmp/pkg.stderr"
"$pkg_command" install dbeaver > "$stdout" 2> "$stderr"
status=$?
if [ "$status" -ne 0 ]
then
  cat "$stdout" >&2
  cat "$stderr" >&2
  fail "pkg install dbeaver failed with status $status"
fi

concrete=
concrete_count=0
for candidate in "$fixture/pkg"/dbeaver@*"!$osarch"
do
  [ -e "$candidate" ] || [ -L "$candidate" ] || continue
  concrete_count=$((concrete_count + 1))
  concrete=$candidate
done
[ "$concrete_count" -eq 1 ] || fail "expected one target-specific DBeaver concrete version, found $concrete_count"
[ -d "$concrete" ] && [ ! -L "$concrete" ] || fail "DBeaver concrete version is not a real directory"

identity=${concrete##*/}
version_osarch=${identity#dbeaver@}
version=${version_osarch%"!$osarch"}
[ -n "$version" ] && [ "$version" != "$version_osarch" ] || fail "cannot derive installed DBeaver version from $identity"

[ -d "$concrete/root" ] && [ ! -L "$concrete/root" ] || fail "DBeaver root is missing"
[ -f "$concrete/cmd/dbeaver" ] && [ ! -L "$concrete/cmd/dbeaver" ] && [ -x "$concrete/cmd/dbeaver" ] || fail "DBeaver command entry is missing or not executable"
[ -L "$concrete/link/dbeaver" ] || fail "DBeaver direct-link is missing"
resolved_target="$(command -p -- realpath -- "$concrete/link/dbeaver" 2>/dev/null)" || fail "cannot resolve DBeaver direct-link"
case "$resolved_target" in
  "$concrete/root"/*) : ;;
  *) fail "DBeaver direct-link escapes concrete root: $resolved_target" ;;
esac
[ -f "$resolved_target" ] && [ -x "$resolved_target" ] || fail "resolved DBeaver upstream target is not executable"

if ! LC_ALL=C command -p -- grep -F '. "$m_LIB_DIR/sh/pkg-launch.lib.sh"' "$concrete/cmd/dbeaver" >/dev/null 2>&1
then
  fail "installed DBeaver command does not load pkg-launch.lib.sh"
fi

for unexpected in \
  "$fixture/pkg/dbeaver" \
  "$fixture/pkg/dbeaver!$osarch" \
  "$fixture/bin/ext/dbeaver" \
  "$fixture/bin/ext-$osarch/dbeaver"
do
  if [ -e "$unexpected" ] || [ -L "$unexpected" ]
  then
    fail "pkg install selected a default unexpectedly: $unexpected"
  fi
done

catalog="$fixture/cache/sys/pkg/pkg-catalog"
[ -d "$catalog/.git" ] && [ ! -L "$catalog/.git" ] || fail "live pkg-catalog cache was not materialized"
catalog_origin="$(git -C "$catalog" remote get-url origin 2>/dev/null)" || fail "cannot read cached catalog origin"
[ "$catalog_origin" = "https://github.com/massimilianonardi-ai/pkg-catalog.git" ] || fail "unexpected cached catalog origin: $catalog_origin"
catalog_head="$(git -C "$catalog" rev-parse --verify HEAD 2>/dev/null)" || fail "cannot read cached catalog HEAD"
case "$catalog_head" in
  "" | *[!0-9a-f]*) fail "invalid cached catalog HEAD: $catalog_head" ;;
esac

printf -- 'installed=%s\n' "$identity"
printf -- 'catalog-head=%s\n' "$catalog_head"
printf -- 'upstream-target=%s\n' "${resolved_target#"$concrete/root/"}"

exit 0
