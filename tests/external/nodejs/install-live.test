#!/bin/sh

TEST_ID="external/nodejs/install-live.test"

fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self="$0"; case "$self" in */*) : ;; *) self="$(command -v "$self" 2>/dev/null)" || return 1 ;; esac
  self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir="."; CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

command -v git >/dev/null 2>&1 || skip "git is unavailable"
test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
nodejs_group="${test_dir%/*}"; external_group="${nodejs_group%/*}"; tests_dir="${external_group%/*}"; suite_root="${tests_dir%/*}"

target_library="$suite_root/lib/rumiai-os-target.lib"
fixture_library="$suite_root/lib/rumiai-os-fixture.lib"
[ -f "$target_library" ] || error "rumiai-os target helper is unavailable"
[ -f "$fixture_library" ] || error "rumiai-os fixture helper is unavailable"
. "$target_library" || error "cannot source rumiai-os target helper"
. "$fixture_library" || error "cannot source rumiai-os fixture helper"

source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status="$?"
case "$status" in 0) : ;; 1) skip "rumiai-os target checkout not found" ;; 2) fail "invalid explicit rumiai-os target" ;; *) error "target discovery failed" ;; esac

tmp="${TMPDIR:-/tmp}/rumiai-nodejs-install-live-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture" || error "cannot materialize isolated fixture"
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

runtime_probe="$tmp/runtime-probe"
cat > "$runtime_probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$runtime_probe" || error "cannot make runtime probe executable"
PATH="$fixture/bin/sys:$PATH"; export PATH
osarch="$($runtime_probe)" || fail "cannot obtain RumiAI osarch from isolated root"
case "$osarch" in
  linux-arm64|linux-x86_64|macos-arm64|macos-x86_64|windows-arm64|windows-x86_64) : ;;
  *) skip "Node.js package is not declared for $osarch" ;;
esac

pkg_command="$fixture/bin/sys/pkg"
[ -x "$pkg_command" ] || fail "isolated pkg command is missing"
printf -- '%s\n' "$TEST_ID: live install started; this test downloads the official Node.js prebuilt archive" >&2
"$pkg_command" install nodejs || fail "pkg install nodejs failed"

concrete=""; concrete_count="0"
for candidate in "$fixture/pkg"/nodejs@*"!$osarch"; do
  [ -e "$candidate" ] || [ -L "$candidate" ] || continue
  concrete_count="$((concrete_count + 1))"; concrete="$candidate"
done
[ "$concrete_count" -eq 1 ] || fail "expected one target-specific Node.js concrete version, found $concrete_count"
[ -d "$concrete" ] && [ ! -L "$concrete" ] || fail "Node.js concrete version is not a real directory"
identity="${concrete##*/}"; version_osarch="${identity#nodejs@}"; version="${version_osarch%"!$osarch"}"
[ -n "$version" ] && [ "$version" != "$version_osarch" ] || fail "cannot derive installed Node.js version"

for command_name in node npm npx; do
  [ -f "$concrete/cmd/$command_name" ] && [ ! -L "$concrete/cmd/$command_name" ] && [ -x "$concrete/cmd/$command_name" ] || fail "$command_name command entry is missing"
  [ -L "$concrete/link/$command_name" ] || fail "$command_name direct-link is missing"
done
[ -f "$concrete/env" ] && [ ! -L "$concrete/env" ] && [ ! -x "$concrete/env" ] || fail "Node.js package env is missing or invalid"

case "$osarch" in
  windows-*)
    expected_node_link="../root/node.exe"
    expected_npm_link="../root/npm"
    expected_npx_link="../root/npx"
    ;;
  *)
    expected_node_link="../root/bin/node"
    expected_npm_link="../root/bin/npm"
    expected_npx_link="../root/bin/npx"
    ;;
esac
[ "$(readlink "$concrete/link/node")" = "$expected_node_link" ] || fail "node direct-link target is incorrect"
[ "$(readlink "$concrete/link/npm")" = "$expected_npm_link" ] || fail "npm direct-link target is incorrect"
[ "$(readlink "$concrete/link/npx")" = "$expected_npx_link" ] || fail "npx direct-link target is incorrect"

node_version="$($concrete/cmd/node --version)" || fail "installed node command failed"
[ "$node_version" = "$version" ] || fail "node --version returned $node_version, expected $version"
npm_version="$($concrete/cmd/npm --version)" || fail "installed npm command failed"
case "$npm_version" in ""|*[!0-9.]*) fail "npm --version returned unexpected value: $npm_version" ;; esac
npx_version="$($concrete/cmd/npx --version)" || fail "installed npx command failed"
case "$npx_version" in ""|*[!0-9.]*) fail "npx --version returned unexpected value: $npx_version" ;; esac

for unexpected in "$fixture/pkg/nodejs" "$fixture/pkg/nodejs!$osarch" "$fixture/bin/ext/node" "$fixture/bin/ext/npm" "$fixture/bin/ext/npx" "$fixture/bin/ext-$osarch/node" "$fixture/bin/ext-$osarch/npm" "$fixture/bin/ext-$osarch/npx"; do
  if [ -e "$unexpected" ] || [ -L "$unexpected" ]; then fail "pkg install selected a default/public binding unexpectedly: $unexpected"; fi
done

pkg_cache="$("$fixture/m" "$fixture/bin/sys/state-path" system sys pkg cache)" || fail "cannot resolve system pkg cache state"
catalog="$pkg_cache/pkg-catalog"
[ -d "$catalog/.git" ] && [ ! -L "$catalog/.git" ] || fail "live pkg-catalog cache was not materialized"
catalog_head="$(git -C "$catalog" rev-parse --verify HEAD 2>/dev/null)" || fail "cannot read cached catalog HEAD"
stream="$catalog/nodejs/catalog-$osarch"
range="$stream/n0001=v26.8.2"
[ -f "$stream/repository/type" ] && [ "$(cat "$stream/repository/type")" = "nodejs" ] || fail "cached Node.js repository type is incorrect"
[ -f "$stream/repository/owner" ] && [ "$(cat "$stream/repository/owner")" = "nodejs" ] || fail "cached Node.js GitHub owner is incorrect"
[ -f "$stream/repository/repository" ] && [ "$(cat "$stream/repository/repository")" = "node" ] || fail "cached Node.js GitHub repository is incorrect"
[ -f "$range/digest_type" ] && [ "$(cat "$range/digest_type")" = "sha256" ] || fail "cached Node.js range lacks required SHA-256 policy"
[ -f "$range/env" ] && [ ! -x "$range/env" ] || fail "cached Node.js range lacks package env"

printf -- 'installed=%s\n' "$identity"
printf -- 'catalog-head=%s\n' "$catalog_head"
printf -- 'node=%s\n' "$node_version"
printf -- 'npm=%s\n' "$npm_version"
printf -- 'npx=%s\n' "$npx_version"
exit 0
