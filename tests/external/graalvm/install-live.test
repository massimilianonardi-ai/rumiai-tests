#!/bin/sh

TEST_ID="external/graalvm/install-live.test"
fail() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf -- '%s\n' "$TEST_ID: $*" >&2; exit 2; }
resolve_test_dir()
{
  self="$0"
  case "$self" in */*) :;; *) self="$(command -v "$self" 2>/dev/null)" || return 1;; esac
  self_dir="${self%/*}"; [ "$self_dir" != "$self" ] || self_dir="."
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir="$(resolve_test_dir)" || error "cannot resolve test directory"
package_group="${test_dir%/*}"; external_group="${package_group%/*}"; suite_root="${external_group%/*}"
. "$suite_root/lib/rumiai-os-target.lib" || error "cannot source target discovery"
. "$suite_root/lib/rumiai-os-fixture.lib" || error "cannot source fixture helper"
source_root="$(rumiai_test_target_rumiai_os_find "$suite_root")"; status=$?
case "$status" in 0) :;; 1) skip "rumiai-os target checkout not found";; 2) fail "invalid explicit rumiai-os target";; *) error "target discovery failed";; esac

tmp="${TMPDIR:-/tmp}/rumiai-graalvm-install-live-$$"
umask 077
mkdir "$tmp" || error "cannot create temporary directory"
trap 'rm -rf "$tmp"' 0 HUP INT TERM
fixture="$tmp/root"
rumiai_test_fixture_rumiai_os_create "$source_root" "$fixture" || error "cannot materialize isolated fixture"
fixture="$(CDPATH= cd -- "$fixture" 2>/dev/null && pwd -P)" || error "cannot canonicalize fixture root"

runtime_probe="$tmp/runtime-probe"
cat > "$runtime_probe" <<'EOF_PROBE'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_PROBE
chmod 700 "$runtime_probe" || error "cannot make runtime probe executable"
PATH="$fixture/bin/sys:$PATH"; export PATH
osarch="$($runtime_probe)" || fail "cannot obtain RumiAI osarch from isolated root"
case "$osarch" in
  linux-arm64|linux-x86_64|macos-arm64|windows-x86_64) :;;
  *) skip "GraalVM package is not declared for $osarch";;
esac

pkg_command="$fixture/bin/sys/pkg"
[ -x "$pkg_command" ] || fail "isolated pkg command is missing"
printf -- '%s\n' "$TEST_ID: live install started; this test downloads the official GraalVM Community JDK archive" >&2
"$pkg_command" install graalvm || fail "pkg install graalvm failed"

concrete=""; concrete_count=0
for candidate in "$fixture/pkg"/graalvm@*"!$osarch"
do
  [ -e "$candidate" ] || [ -L "$candidate" ] || continue
  concrete_count=$((concrete_count + 1)); concrete="$candidate"
done
[ "$concrete_count" -eq 1 ] || fail "expected one target-specific GraalVM concrete version, found $concrete_count"
[ -d "$concrete" ] && [ ! -L "$concrete" ] || fail "GraalVM concrete version is not a real directory"
identity="${concrete##*/}"
version_osarch="${identity#graalvm@}"
version="${version_osarch%"!$osarch"}"
[ -n "$version" ] && [ "$version" != "$version_osarch" ] || fail "cannot derive installed GraalVM version"

[ -f "$concrete/facility" ] && [ ! -L "$concrete/facility" ] || fail "GraalVM facility declaration is missing"
[ "$(cat "$concrete/facility")" = 'java 25' ] || fail "GraalVM facility declaration is incorrect"

case "$osarch" in
  windows-*) java_bin="$concrete/root/bin/java.exe"; javac_bin="$concrete/root/bin/javac.exe";;
  *) java_bin="$concrete/root/bin/java"; javac_bin="$concrete/root/bin/javac";;
esac
[ -f "$java_bin" ] && [ ! -L "$java_bin" ] || fail "JAVA_HOME root does not contain java"
[ -f "$javac_bin" ] && [ ! -L "$javac_bin" ] || fail "JAVA_HOME root does not contain javac"
"$java_bin" -version >/dev/null 2>&1 || fail "installed GraalVM java failed"
"$javac_bin" -version >/dev/null 2>&1 || fail "installed GraalVM javac failed"

for unexpected in \
  "$fixture/pkg/graalvm" \
  "$fixture/pkg/graalvm!$osarch" \
  "$fixture/bin/ext/java" \
  "$fixture/bin/ext/native-image" \
  "$fixture/bin/ext-$osarch/java" \
  "$fixture/bin/ext-$osarch/native-image"
do
  if [ -e "$unexpected" ] || [ -L "$unexpected" ]; then fail "pkg install selected a default/public binding unexpectedly: $unexpected"; fi
done

pkg_cache="$("$fixture/m" "$fixture/bin/sys/state-path" system sys pkg cache)" || fail "cannot resolve system pkg cache state"
catalog="$pkg_cache/pkg-catalog"
[ -d "$catalog/.git" ] && [ ! -L "$catalog/.git" ] || fail "live pkg-catalog cache was not materialized"
catalog_head="$(git -C "$catalog" rev-parse --verify HEAD 2>/dev/null)" || fail "cannot read cached catalog HEAD"
stream="$catalog/graalvm/catalog-$osarch"
range="$stream/n0001=25.3.4.1"
[ -f "$stream/repository/type" ] && [ "$(cat "$stream/repository/type")" = graalvm ] || fail "cached GraalVM repository type is incorrect"
[ -f "$stream/repository/owner" ] && [ "$(cat "$stream/repository/owner")" = graalvm ] || fail "cached GraalVM GitHub owner is incorrect"
[ -f "$stream/repository/repository" ] && [ "$(cat "$stream/repository/repository")" = graalvm-ce-builds ] || fail "cached GraalVM GitHub repository is incorrect"
[ -f "$range/digest_type" ] && [ "$(cat "$range/digest_type")" = sha256 ] || fail "cached GraalVM range lacks required SHA-256 policy"
[ -f "$range/facility" ] && [ "$(cat "$range/facility")" = 'java 25' ] || fail "cached GraalVM range lacks java 25 facility"

printf -- 'installed=%s\n' "$identity"
printf -- 'catalog-head=%s\n' "$catalog_head"
printf -- 'java=ok\n'
printf -- 'javac=ok\n'
exit 0
