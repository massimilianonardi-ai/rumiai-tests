#!/bin/sh

TEST_ID=external/geoserver/repository-live.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

library=$root/lib/sys/sh/pkg/repository/pkg-repository-geoserver.lib.sh
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] ||
  fail 'GeoServer repository adapter missing'
[ -x "$root/bin/sys/http-fetch" ] || fail 'http-fetch command missing'

tmp=${TMPDIR:-/tmp}/rumiai-geoserver-repository-live-$$
umask 077
command -p -- mkdir "$tmp" "$tmp/repository" "$tmp/range" || error 'cannot prepare test input'
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

printf '%s\n' geoserver > "$tmp/repository/type" || error 'cannot prepare repository descriptor'
printf '%s\n' '^geoserver-[A-Za-z0-9][A-Za-z0-9._+~-]*-bin\\.zip$' > "$tmp/range/archive_regex" ||
  error 'cannot prepare archive selector'
printf '%s\n' md5 > "$tmp/range/digest_type" || error 'cannot prepare digest selector'

PATH="$root/bin/sys:$PATH"
m_LIB_DIR=$root/lib
export PATH m_LIB_DIR
. "$library" || error 'cannot source GeoServer repository adapter'

version=3.0.1
resolved=$(pkg_repository_resolve_version "$tmp/repository" "$version") ||
  fail 'live GeoServer exact-version resolution failed'
[ "$resolved" = "$version" ] ||
  fail "GeoServer exact-version resolution returned $resolved instead of $version"

artifact=$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" "$version") ||
  fail 'live GeoServer artifact resolution failed'
expected='name=geoserver-3.0.1-bin.zip
url=https://sourceforge.net/projects/geoserver/files/GeoServer/3.0.1/geoserver-3.0.1-bin.zip/download
size=126971831
digest=md5:1b8b60c512dd983f7996074d69119566'
[ "$artifact" = "$expected" ] || fail 'live GeoServer artifact metadata differs from the expected upstream release'

printf 'version=%s\n' "$version"
printf 'repository-live=ok\n'
exit 0
