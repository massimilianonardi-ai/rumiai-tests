#!/bin/sh

TEST_ID=external/geoserver/repository-live.test

fail() { printf '%s\n' "$TEST_ID: $*" >&2; exit 1; }
error() { printf '%s\n' "$TEST_ID: $*" >&2; exit 3; }
skip() { printf '%s\n' "$TEST_ID: $*" >&2; exit 2; }

resolve_test_dir()
{
  self=$0
  case $self in */*) :;; *) self=$(command -v "$self" 2>/dev/null) || return 1;; esac
  self_dir=${self%/*}
  [ "$self_dir" != "$self" ] || self_dir=.
  CDPATH= cd -- "$self_dir" 2>/dev/null && pwd -P
}

raw_probe()
{
  probe_label=$1
  shift
  probe_file=$tmp/$probe_label.body
  if "$root/m" "$root/bin/sys/http-fetch" "$@" > "$probe_file" 2> "$tmp/$probe_label.err"
  then
    probe_bytes=$(command -p -- wc -c < "$probe_file" | command -p -- tr -d ' ')
    probe_first=$(LC_ALL=C command -p -- awk '{
      line=$0
      sub(/^[[:space:]]+/, "", line)
      if (line != "") { print substr(line,1,1); exit }
    }' "$probe_file")
    printf '%s\n' "$TEST_ID: probe $probe_label status=0 bytes=$probe_bytes first=$probe_first" >&2
  else
    probe_status=$?
    printf '%s\n' "$TEST_ID: probe $probe_label status=$probe_status" >&2
    [ ! -s "$tmp/$probe_label.err" ] || command -p -- cat "$tmp/$probe_label.err" >&2
  fi
}

test_dir=$(resolve_test_dir) || error 'cannot resolve test directory'
package_group=${test_dir%/*}
external_group=${package_group%/*}
suite_root=${external_group%/*}
. "$suite_root/lib/rumiai-os-target.lib" || error 'cannot source target discovery'

root=$(rumiai_test_target_rumiai_os_find "$suite_root")
status=$?
case $status in
  0) :;;
  1) skip 'rumiai-os target checkout not found';;
  2) fail 'invalid explicit rumiai-os target';;
  *) error 'target discovery failed';;
esac

library=$root/lib/sys/sh/pkg/repository/pkg-repository-geoserver.lib.sh
[ -f "$library" ] && [ ! -L "$library" ] && [ -r "$library" ] && [ ! -x "$library" ] ||
  fail 'GeoServer repository adapter missing'
[ -x "$root/bin/sys/http-fetch" ] || fail 'http-fetch command missing'

tmp=${TMPDIR:-/tmp}/rumiai-geoserver-repository-live-$$
umask 077
command -p -- mkdir "$tmp" "$tmp/repository" "$tmp/range" || error 'cannot prepare test input'
trap 'command -p -- rm -rf -- "$tmp"' 0 HUP INT TERM

printf '%s\n' geoserver > "$tmp/repository/type" || error 'cannot prepare repository descriptor'
printf '%s\n' '^geoserver-[A-Za-z0-9][A-Za-z0-9._+~-]*-bin\\.zip$' > "$tmp/range/archive_regex" ||
  error 'cannot prepare archive selector'
printf '%s\n' md5 > "$tmp/range/digest_type" || error 'cannot prepare digest selector'

PATH="$root/bin/sys:$PATH"
m_LIB_DIR=$root/lib
export PATH m_LIB_DIR
. "$library" || error 'cannot source GeoServer repository adapter'

version=3.0.1
resolved=$(pkg_repository_resolve_version "$tmp/repository" "$version" 2> "$tmp/version.err")
status=$?
if [ "$status" -ne 0 ]
then
  [ ! -s "$tmp/version.err" ] || command -p -- cat "$tmp/version.err" >&2
  raw_probe root-current -- 'https://sourceforge.net/projects/geoserver/files/GeoServer/?format=json'
  raw_probe root-accept -H 'Accept: application/json' -- 'https://sourceforge.net/projects/geoserver/files/GeoServer/?format=json'
  raw_probe root-rest -H 'Accept: application/json' -- 'https://sourceforge.net/projects/geoserver/files/GeoServer/'
  raw_probe file-resource -H 'Accept: application/json' -- "https://sourceforge.net/projects/geoserver/files/GeoServer/$version/geoserver-$version-bin.zip"
  fail "live GeoServer exact-version resolution failed with status $status"
fi
[ "$resolved" = "$version" ] ||
  fail "GeoServer exact-version resolution returned $resolved instead of $version"

artifact=$(pkg_repository_resolve_artifact "$tmp/repository" "$tmp/range" "$version" 2> "$tmp/artifact.err")
status=$?
if [ "$status" -ne 0 ]
then
  [ ! -s "$tmp/artifact.err" ] || command -p -- cat "$tmp/artifact.err" >&2
  raw_probe folder-current -- "https://sourceforge.net/projects/geoserver/files/GeoServer/$version/?format=json"
  raw_probe folder-accept -H 'Accept: application/json' -- "https://sourceforge.net/projects/geoserver/files/GeoServer/$version/?format=json"
  raw_probe folder-rest -H 'Accept: application/json' -- "https://sourceforge.net/projects/geoserver/files/GeoServer/$version/"
  fail "live GeoServer artifact resolution failed with status $status"
fi

printf '%s\n' "$artifact" | command -p -- grep -Fx "name=geoserver-$version-bin.zip" >/dev/null 2>&1 ||
  fail 'live GeoServer artifact descriptor has wrong name'
printf '%s\n' "$artifact" | command -p -- grep -F 'url=https://sourceforge.net/projects/geoserver/files/GeoServer/' >/dev/null 2>&1 ||
  fail 'live GeoServer artifact descriptor has wrong URL'
printf '%s\n' "$artifact" | command -p -- grep -E '^size=[1-9][0-9]*$' >/dev/null 2>&1 ||
  fail 'live GeoServer artifact descriptor has invalid size'
printf '%s\n' "$artifact" | command -p -- grep -E '^digest=md5:[0-9a-f]{32}$' >/dev/null 2>&1 ||
  fail 'live GeoServer artifact descriptor has invalid MD5'

printf 'version=%s\n' "$version"
printf 'repository-live=ok\n'
exit 0
