#!/bin/sh

fail() {
    printf '%s\n' "git-identity.test: $*" >&2
    exit 1
}

error() {
    printf '%s\n' "git-identity.test: $*" >&2
    exit 3
}

skip() {
    printf '%s\n' "git-identity.test: $*" >&2
    exit 2
}

have() {
    command -v "$1" >/dev/null 2>&1
}

have git || error 'git is unavailable'
have curl || skip 'curl is unavailable'
have script || skip 'script(1) is unavailable'
have grep || error 'grep is unavailable'
have uname || error 'uname is unavailable'

system=$(uname -s 2>/dev/null) || error 'cannot determine operating system'
case $system in
    Darwin|Linux) : ;;
    *) skip "PTY automation is not implemented for $system" ;;
esac

SETUP_DEV_REF=328dc50343da513e022f94d496ff97ba81bc5924
SETUP_DEV_URL=https://raw.githubusercontent.com/massimilianonardi-ai/rumiai-dev/$SETUP_DEV_REF/setup-dev.sh

tmp_base=${TMPDIR:-/tmp}/rumiai-tests-setup-dev-git-identity-$$
umask 077
mkdir "$tmp_base" || error 'cannot create temporary directory'
trap 'rm -rf "$tmp_base"' 0 HUP INT TERM

wrapper=$tmp_base/run-setup
cat > "$wrapper" <<'EOT'
#!/bin/sh
HOME=$CASE_HOME
export HOME
curl -fsSL "$SETUP_DEV_URL" | sh -s -- "$CASE_ROOT"
status=$?
printf '%s\n' "$status" > "$CASE_STATUS"
exit "$status"
EOT
chmod +x "$wrapper" || error 'cannot make PTY wrapper executable'

run_case() {
    case_name=$1
    input_file=$2

    case_dir=$tmp_base/$case_name
    CASE_HOME=$case_dir/home
    CASE_ROOT=$case_dir/rumiai-os
    CASE_STATUS=$case_dir/status
    SETUP_DEV_URL=$SETUP_DEV_URL
    export CASE_HOME CASE_ROOT CASE_STATUS SETUP_DEV_URL

    mkdir -p "$CASE_HOME" || error "cannot create $case_name HOME"
    output=$case_dir/output

    case $system in
        Darwin)
            script -q /dev/null "$wrapper" < "$input_file" > "$output" 2>&1
            ;;
        Linux)
            script -q -c "$wrapper" /dev/null < "$input_file" > "$output" 2>&1
            ;;
    esac

    [ -f "$CASE_STATUS" ] || error "$case_name did not persist child exit status"
    CASE_RESULT=$(cat "$CASE_STATUS") || error "cannot read $case_name exit status"
    case $CASE_RESULT in
        0|1|2|3) : ;;
        *) error "$case_name returned invalid setup status '$CASE_RESULT'" ;;
    esac
    CASE_DIR=$case_dir
    CASE_OUTPUT=$output
}

invalid_input=$tmp_base/invalid.input
printf '%s\n' \
    'massimilianonardi-ai' \
    'not-an-email' > "$invalid_input" || error 'cannot prepare invalid identity input'

run_case invalid "$invalid_input"
[ "$CASE_RESULT" -eq 1 ] || fail "invalid email returned $CASE_RESULT instead of 1"
grep -F 'Git user.email must have the form local@domain' "$CASE_OUTPUT" >/dev/null 2>&1 ||
    fail 'invalid email was not rejected explicitly'
[ ! -e "$CASE_ROOT" ] || fail 'invalid identity created the workspace'
HOME="$CASE_HOME" git config --global --get user.name >/dev/null 2>&1 &&
    fail 'invalid identity persisted user.name'
HOME="$CASE_HOME" git config --global --get user.email >/dev/null 2>&1 &&
    fail 'invalid identity persisted user.email'

cancel_input=$tmp_base/cancel.input
printf '%s\n' \
    'massimilianonardi-ai' \
    'massimiliano.nardi.ai@gmail.com' \
    'n' > "$cancel_input" || error 'cannot prepare cancellation input'

run_case cancel "$cancel_input"
[ "$CASE_RESULT" -eq 1 ] || fail "identity cancellation returned $CASE_RESULT instead of 1"
grep -F 'Git identity configuration cancelled' "$CASE_OUTPUT" >/dev/null 2>&1 ||
    fail 'identity cancellation was not reported'
[ ! -e "$CASE_ROOT" ] || fail 'cancelled identity created the workspace'
HOME="$CASE_HOME" git config --global --get user.name >/dev/null 2>&1 &&
    fail 'cancelled identity persisted user.name'
HOME="$CASE_HOME" git config --global --get user.email >/dev/null 2>&1 &&
    fail 'cancelled identity persisted user.email'

positive_input=$tmp_base/positive.input
printf '%s\n' \
    'massimilianonardi-ai' \
    'massimiliano.nardi.ai@gmail.com' \
    'y' \
    'n' > "$positive_input" || error 'cannot prepare positive identity input'

run_case positive "$positive_input"
[ "$CASE_RESULT" -eq 0 ] || {
    cat "$CASE_OUTPUT" >&2
    fail "positive setup returned $CASE_RESULT instead of 0"
}

name=$(HOME="$CASE_HOME" git config --global --get user.name 2>/dev/null) ||
    fail 'positive setup did not persist user.name'
email=$(HOME="$CASE_HOME" git config --global --get user.email 2>/dev/null) ||
    fail 'positive setup did not persist user.email'
use_config_only=$(HOME="$CASE_HOME" git config --global --get user.useConfigOnly 2>/dev/null) ||
    fail 'positive setup did not persist user.useConfigOnly'

[ "$name" = 'massimilianonardi-ai' ] || fail "unexpected user.name '$name'"
[ "$email" = 'massimiliano.nardi.ai@gmail.com' ] || fail "unexpected user.email '$email'"
[ "$use_config_only" = true ] || fail "user.useConfigOnly is '$use_config_only' instead of true"

HOME="$CASE_HOME" git var GIT_AUTHOR_IDENT >/dev/null 2>&1 ||
    fail 'Git cannot construct author identity'
HOME="$CASE_HOME" git var GIT_COMMITTER_IDENT >/dev/null 2>&1 ||
    fail 'Git cannot construct committer identity'

probe=$CASE_DIR/commit-probe
mkdir "$probe" || error 'cannot create commit probe'
HOME="$CASE_HOME" git -C "$probe" init -q || fail 'cannot initialize commit probe'
printf '%s\n' probe > "$probe/probe" || error 'cannot create commit probe file'
HOME="$CASE_HOME" git -C "$probe" add -- probe || fail 'cannot stage commit probe'
HOME="$CASE_HOME" git -C "$probe" commit -qm 'Git identity probe' || fail 'real commit probe failed'
identity=$(HOME="$CASE_HOME" git -C "$probe" show -s --format='%an <%ae>|%cn <%ce>') ||
    fail 'cannot inspect commit identity'
expected='massimilianonardi-ai <massimiliano.nardi.ai@gmail.com>|massimilianonardi-ai <massimiliano.nardi.ai@gmail.com>'
[ "$identity" = "$expected" ] || fail "real commit used unexpected identity '$identity'"

check_origin() {
    repo_dir=$1
    expected=$2
    actual=$(git -C "$repo_dir" remote get-url origin 2>/dev/null) ||
        fail "cannot read origin for $repo_dir"
    [ "$actual" = "$expected" ] || fail "unexpected origin '$actual' for $repo_dir"
}

check_origin "$CASE_ROOT" \
    'https://github.com/massimilianonardi-ai/rumiai-os.git'
check_origin "$CASE_ROOT/.dev/rumiai-tests" \
    'https://github.com/massimilianonardi-ai/rumiai-tests.git'
check_origin "$CASE_ROOT/.dev/rumiai-dev-PoCs" \
    'https://github.com/massimilianonardi-ai/rumiai-dev-PoCs.git'

exit 0
