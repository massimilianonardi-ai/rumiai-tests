# Shared release validation for package definitions.
#
# The helper exercises the supplied RumiAI target through public package
# commands and public command bindings. It intentionally avoids assumptions
# about concrete package layout, catalog-cache layout or pkg-analyze internals.

rumiai_test_package_release_fail()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 1
}

rumiai_test_package_release_error()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 3
}

rumiai_test_package_release_skip()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 2
}

rumiai_test_package_release_supported()
{
  [ "$#" -eq 2 ] || return 2
  rumiai_test_package_release_wanted=$1
  rumiai_test_package_release_list=$2

  for rumiai_test_package_release_item in $rumiai_test_package_release_list
  do
    [ "$rumiai_test_package_release_item" = "$rumiai_test_package_release_wanted" ] &&
      return 0
  done
  return 1
}

rumiai_test_package_release_gui_require()
{
  [ "$#" -eq 1 ] || return 3
  [ -r /dev/tty ] && [ -w /dev/tty ] || return 2

  case "$1" in
    linux-*)
      [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ] || return 2
      ;;
    macos-*)
      command -v launchctl >/dev/null 2>&1 || return 2
      command -v id >/dev/null 2>&1 || return 2
      rumiai_test_package_release_gui_uid=$(id -u) || return 3
      launchctl print "gui/$rumiai_test_package_release_gui_uid" >/dev/null 2>&1 ||
        return 2
      ;;
    windows-*)
      :
      ;;
    *)
      return 2
      ;;
  esac
}

rumiai_test_package_release_cleanup()
{
  if [ -n "${rumiai_test_package_release_gui_pid-}" ] &&
     kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null
  then
    kill -s TERM "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
    rumiai_test_package_release_cleanup_wait=0
    while kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null &&
          [ "$rumiai_test_package_release_cleanup_wait" -lt 10 ]
    do
      command -p -- sleep 1
      rumiai_test_package_release_cleanup_wait=$((rumiai_test_package_release_cleanup_wait + 1))
    done
    if kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null
    then
      kill -s KILL "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
    fi
    wait "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
  fi
  rumiai_test_package_release_gui_pid=

  if [ "${rumiai_test_package_release_cleanup_enabled-0}" -eq 1 ] &&
     [ -n "${rumiai_test_package_release_target-}" ]
  then
    "$rumiai_test_package_release_target/m"       "$rumiai_test_package_release_target/bin/sys/pkg"       uninstall "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" >/dev/null 2>&1 || :

    [ -z "${rumiai_test_package_release_system_pkg_state-}" ] ||
      command -p -- rm -rf -- "$rumiai_test_package_release_system_pkg_state" 2>/dev/null || :
    [ -z "${rumiai_test_package_release_user_pkg_state-}" ] ||
      command -p -- rm -rf -- "$rumiai_test_package_release_user_pkg_state" 2>/dev/null || :
  fi

  if [ -n "${rumiai_test_package_release_tmp-}" ]
  then
    command -p -- rm -rf -- "$rumiai_test_package_release_tmp" 2>/dev/null || :
  fi
}

rumiai_test_package_release_gui_launch()
{
  [ "$#" -eq 3 ] || return 2
  rumiai_test_package_release_gui_command=$1
  rumiai_test_package_release_gui_log=$2
  rumiai_test_package_release_gui_name=$3

  [ -r /dev/tty ] && [ -w /dev/tty ] || return 2

  printf -- '%s\n'     "$TEST_ID: launching $rumiai_test_package_release_gui_name through its RumiAI command."     >/dev/tty
  printf -- '%s\n'     "$TEST_ID: verify that the application opens correctly and then close it."     >/dev/tty

  "$rumiai_test_package_release_gui_command"     > "$rumiai_test_package_release_gui_log" 2>&1 &
  rumiai_test_package_release_gui_pid=$!

  printf -- '%s'     "$TEST_ID: did the application open correctly and close cleanly? [y/N] "     >/dev/tty
  IFS= read -r rumiai_test_package_release_gui_reply </dev/tty || return 1

  case "$rumiai_test_package_release_gui_reply" in
    y|Y|yes|YES|Yes) :;;
    *) return 1;;
  esac

  wait "$rumiai_test_package_release_gui_pid"
  rumiai_test_package_release_gui_status=$?
  rumiai_test_package_release_gui_pid=
  return "$rumiai_test_package_release_gui_status"
}

rumiai_test_package_release_public_command()
{
  [ "$#" -eq 1 ] || return 2
  rumiai_test_package_release_public_name=$1

  for rumiai_test_package_release_public_path in     "$rumiai_test_package_release_target/bin/ext-$rumiai_test_package_release_osarch/$rumiai_test_package_release_public_name"     "$rumiai_test_package_release_target/bin/ext/$rumiai_test_package_release_public_name"
  do
    [ -e "$rumiai_test_package_release_public_path" ] ||
      [ -L "$rumiai_test_package_release_public_path" ] || continue
    [ -x "$rumiai_test_package_release_public_path" ] || return 1
    printf -- '%s\n' "$rumiai_test_package_release_public_path"
    return 0
  done
  return 1
}

rumiai_test_package_release_installed_identity()
{
  [ "$#" -eq 0 ] || return 2

  rumiai_test_package_release_versions=$(
    "$rumiai_test_package_release_target/m"       "$rumiai_test_package_release_target/bin/sys/pkg"       versions "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE!$rumiai_test_package_release_osarch"       2> "$rumiai_test_package_release_tmp/versions-target.err"
  )
  rumiai_test_package_release_status=$?

  if [ "$rumiai_test_package_release_status" -eq 1 ]
  then
    rumiai_test_package_release_versions=$(
      "$rumiai_test_package_release_target/m"         "$rumiai_test_package_release_target/bin/sys/pkg"         versions "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"         2> "$rumiai_test_package_release_tmp/versions-generic.err"
    )
    rumiai_test_package_release_status=$?
  fi

  [ "$rumiai_test_package_release_status" -eq 0 ] || return 1

  case "$rumiai_test_package_release_versions" in
    "" | *'
'*) return 1;;
  esac

  printf -- '%s\n' "$rumiai_test_package_release_versions"
}

rumiai_test_package_release_run()
{
  [ "$#" -eq 1 ] ||
    rumiai_test_package_release_error "invalid shared helper invocation"
  rumiai_test_package_release_suite_root=$1

  for rumiai_test_package_release_required in     RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE     RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS     RUMIAI_TEST_PACKAGE_RELEASE_TARGETS     RUMIAI_TEST_PACKAGE_RELEASE_MODE
  do
    eval "rumiai_test_package_release_value=\${$rumiai_test_package_release_required-}"
    [ -n "$rumiai_test_package_release_value" ] ||
      rumiai_test_package_release_error         "missing configuration: $rumiai_test_package_release_required"
  done

  . "$rumiai_test_package_release_suite_root/lib/rumiai-os-target.lib" ||
    rumiai_test_package_release_error "cannot load target helper"

  rumiai_test_package_release_source_root=$(
    rumiai_test_target_rumiai_os_find "$rumiai_test_package_release_suite_root"
  )
  rumiai_test_package_release_status=$?
  case "$rumiai_test_package_release_status" in
    0) :;;
    1) rumiai_test_package_release_skip "rumiai-os target checkout not found";;
    2) rumiai_test_package_release_fail "invalid explicit rumiai-os target";;
    *) rumiai_test_package_release_error "target discovery failed";;
  esac

  rumiai_test_package_release_tmp="${TMPDIR:-/tmp}/rumiai-package-release-${RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE}-$$"
  umask 077
  command -p -- mkdir -- "$rumiai_test_package_release_tmp" ||
    rumiai_test_package_release_error "cannot create temporary directory"

  rumiai_test_package_release_gui_pid=
  trap 'rumiai_test_package_release_cleanup' 0
  trap 'rumiai_test_package_release_cleanup; exit 3' HUP INT TERM

  rumiai_test_package_release_target=$(
    CDPATH= cd -- "$rumiai_test_package_release_source_root" 2>/dev/null && pwd -P
  ) || rumiai_test_package_release_error "cannot canonicalize supplied target root"

  PATH="$rumiai_test_package_release_target/bin/sys:$PATH"
  export PATH

  rumiai_test_package_release_runtime_probe="$rumiai_test_package_release_tmp/osarch"
  cat > "$rumiai_test_package_release_runtime_probe" <<'EOF_OSARCH'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_OSARCH
  command -p -- chmod 700 "$rumiai_test_package_release_runtime_probe" ||
    rumiai_test_package_release_error "cannot make osarch probe executable"

  rumiai_test_package_release_osarch=$(
    "$rumiai_test_package_release_target/m" "$rumiai_test_package_release_runtime_probe"
  ) || rumiai_test_package_release_fail "cannot resolve RumiAI osarch"

  rumiai_test_package_release_supported     "$rumiai_test_package_release_osarch"     "$RUMIAI_TEST_PACKAGE_RELEASE_TARGETS" ||
    rumiai_test_package_release_skip       "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE is not declared for $rumiai_test_package_release_osarch"

  if [ "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" = gui ]
  then
    rumiai_test_package_release_gui_require "$rumiai_test_package_release_osarch"
    rumiai_test_package_release_status=$?
    case "$rumiai_test_package_release_status" in
      0) :;;
      2)
        rumiai_test_package_release_skip           "graphical interactive session is unavailable for $rumiai_test_package_release_osarch"
        ;;
      *)
        rumiai_test_package_release_error           "cannot determine graphical session availability"
        ;;
    esac
  fi

  rumiai_test_package_release_system_conf=$(
    "$rumiai_test_package_release_target/m"       "$rumiai_test_package_release_target/bin/sys/state-path"       system pkg "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" conf
  ) || rumiai_test_package_release_error "cannot resolve package system state"

  rumiai_test_package_release_user_conf=$(
    "$rumiai_test_package_release_target/m"       "$rumiai_test_package_release_target/bin/sys/state-path"       user pkg "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" conf
  ) || rumiai_test_package_release_error "cannot resolve package user state"

  rumiai_test_package_release_system_pkg_state=${rumiai_test_package_release_system_conf%/conf}
  rumiai_test_package_release_user_pkg_state=${rumiai_test_package_release_user_conf%/conf}

  if [ -e "$rumiai_test_package_release_system_pkg_state" ] ||
     [ -L "$rumiai_test_package_release_system_pkg_state" ] ||
     [ -e "$rumiai_test_package_release_user_pkg_state" ] ||
     [ -L "$rumiai_test_package_release_user_pkg_state" ]
  then
    rumiai_test_package_release_skip       "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE state already exists in the supplied target"
  fi

  if "$rumiai_test_package_release_target/m"        "$rumiai_test_package_release_target/bin/sys/pkg"        versions "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"        > "$rumiai_test_package_release_tmp/preexisting.out"        2> "$rumiai_test_package_release_tmp/preexisting.err"
  then
    rumiai_test_package_release_skip       "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE is already installed in the supplied target"
  else
    rumiai_test_package_release_status=$?
    [ "$rumiai_test_package_release_status" -eq 1 ] ||
      rumiai_test_package_release_error         "cannot determine pre-existing package state"
  fi

  rumiai_test_package_release_cleanup_enabled=1
  printf -- '%s\n'     "$TEST_ID: live install of $RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE for $rumiai_test_package_release_osarch"     >&2

  "$rumiai_test_package_release_target/m"     "$rumiai_test_package_release_target/bin/sys/pkg"     install "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" ||
    rumiai_test_package_release_fail       "pkg install $RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE failed"

  rumiai_test_package_release_identity=$(
    rumiai_test_package_release_installed_identity
  ) || rumiai_test_package_release_fail     "cannot identify the single installed package through pkg versions"

  "$rumiai_test_package_release_target/m"     "$rumiai_test_package_release_target/bin/sys/pkg"     default "$rumiai_test_package_release_identity"     > "$rumiai_test_package_release_tmp/default.out"     2> "$rumiai_test_package_release_tmp/default.err" || {
      command -p -- cat "$rumiai_test_package_release_tmp/default.err" >&2
      rumiai_test_package_release_fail         "cannot select installed package for public runtime validation"
    }

  case "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" in
    cli)
      for rumiai_test_package_release_command in $RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS
      do
        rumiai_test_package_release_command_log="$rumiai_test_package_release_tmp/command-$rumiai_test_package_release_command.log"
        rumiai_test_package_release_public=$(
          rumiai_test_package_release_public_command             "$rumiai_test_package_release_command"
        ) || rumiai_test_package_release_fail           "public command binding is unavailable: $rumiai_test_package_release_command"

        "$rumiai_test_package_release_public" --version           > "$rumiai_test_package_release_command_log" 2>&1 || {
            command -p -- cat "$rumiai_test_package_release_command_log" >&2
            rumiai_test_package_release_fail               "$rumiai_test_package_release_command --version failed"
          }

        [ -s "$rumiai_test_package_release_command_log" ] ||
          rumiai_test_package_release_fail             "$rumiai_test_package_release_command --version produced no evidence"
      done
      ;;
    gui)
      rumiai_test_package_release_gui_log="$rumiai_test_package_release_tmp/gui-launch.log"
      rumiai_test_package_release_public=$(
        rumiai_test_package_release_public_command           "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"
      ) || rumiai_test_package_release_fail         "public GUI command binding is unavailable: $RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"

      rumiai_test_package_release_gui_launch         "$rumiai_test_package_release_public"         "$rumiai_test_package_release_gui_log"         "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"
      rumiai_test_package_release_status=$?

      case "$rumiai_test_package_release_status" in
        0) :;;
        2)
          rumiai_test_package_release_skip             "GUI release validation requires an interactive TTY"
          ;;
        *)
          command -p -- cat "$rumiai_test_package_release_gui_log" >&2 2>/dev/null || :
          rumiai_test_package_release_fail "RumiAI GUI launch failed"
          ;;
      esac
      ;;
    *)
      rumiai_test_package_release_error         "invalid release mode: $RUMIAI_TEST_PACKAGE_RELEASE_MODE"
      ;;
  esac

  rumiai_test_package_release_package_home=$(
    "$rumiai_test_package_release_target/m"       "$rumiai_test_package_release_target/bin/sys/state-path"       user pkg "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" home
  ) || rumiai_test_package_release_fail "cannot resolve package HOME state"

  [ -d "$rumiai_test_package_release_package_home" ] &&
  [ ! -L "$rumiai_test_package_release_package_home" ] ||
    rumiai_test_package_release_fail       "RumiAI package HOME state was not materialized"

  printf -- 'package=%s\n' "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"
  printf -- 'installed=%s\n' "$rumiai_test_package_release_identity"
  printf -- 'osarch=%s\n' "$rumiai_test_package_release_osarch"
  printf -- 'public-runtime=ok\n'
  printf -- 'package-home=materialized\n'
  return 0
}
