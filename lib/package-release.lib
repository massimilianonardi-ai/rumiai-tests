# Shared physical release validation for package definitions.
#
# This helper complements pkg-analyze candidate discovery with a content/mode/symlink
# inventory of the concrete package root materialized by pkg. CLI validations also
# use pkg-analyze dynamic probing; GUI validations reserve the single interactive
# launch for the normal integrated RumiAI command.

rumiai_test_package_release_fail()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 1
}

rumiai_test_package_release_error()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 3
}

rumiai_test_package_release_skip()
{
  printf -- '%s: %s\n' "$TEST_ID" "$*" >&2
  exit 2
}

rumiai_test_package_release_supported()
{
  [ "$#" -eq 2 ] || return 2
  rumiai_test_package_release_wanted=$1
  rumiai_test_package_release_list=$2
  for rumiai_test_package_release_item in $rumiai_test_package_release_list
  do
    [ "$rumiai_test_package_release_item" = "$rumiai_test_package_release_wanted" ] && return 0
  done
  return 1
}

rumiai_test_package_release_stat_style()
{
  [ "$#" -eq 1 ] || return 2
  if command -v stat >/dev/null 2>&1 && stat -c '%a' "$1" >/dev/null 2>&1
  then
    printf -- '%s\n' gnu
    return 0
  fi
  if command -v stat >/dev/null 2>&1 && stat -f '%Lp' "$1" >/dev/null 2>&1
  then
    printf -- '%s\n' bsd
    return 0
  fi
  return 1
}

rumiai_test_package_release_inventory()
{
  [ "$#" -eq 3 ] || return 2
  rumiai_test_package_release_inventory_root=$1
  rumiai_test_package_release_inventory_output=$2
  rumiai_test_package_release_inventory_stat_style=$3
  rumiai_test_package_release_inventory_unsorted="$rumiai_test_package_release_inventory_output.unsorted"

  : > "$rumiai_test_package_release_inventory_unsorted" || return 1
  [ -d "$rumiai_test_package_release_inventory_root" ] && [ ! -L "$rumiai_test_package_release_inventory_root" ] || return 1

  command -p -- find "$rumiai_test_package_release_inventory_root" -exec sh -c '
root=$1
out=$2
stat_style=$3
runtime=$4
digest=$5
shift 5
tab=$(printf "\tX"); tab=${tab%X}
cr=$(printf "\rX"); cr=${cr%X}
lf="
"
for path
do
  case "$path" in
    *"$tab"*|*"$cr"*|*"$lf"*) exit 91;;
  esac

  if [ "$path" = "$root" ]
  then
    relative=.
  else
    case "$path" in
      "$root"/*) relative=${path#"$root"/};;
      *) exit 92;;
    esac
  fi

  if [ "$stat_style" = gnu ]
  then
    mode=$(stat -c "%a" "$path" 2>/dev/null) || exit 93
  else
    mode=$(stat -f "%Lp" "$path" 2>/dev/null) || exit 93
  fi

  type=O
  target=
  digest_value=
  if [ -L "$path" ]
  then
    type=L
    target=$(readlink "$path" 2>/dev/null) || exit 94
    case "$target" in *"$tab"*|*"$cr"*|*"$lf"*) exit 91;; esac
  elif [ -f "$path" ]
  then
    type=F
    digest_value=$("$runtime" "$digest" -a sha256 -- "$path") || exit 95
  elif [ -d "$path" ]
  then
    type=D
  elif [ -p "$path" ]
  then
    type=P
  elif [ -b "$path" ]
  then
    type=B
  elif [ -c "$path" ]
  then
    type=C
  fi

  printf "%s\t%s\t%s\t%s\t%s\n" "$relative" "$type" "$mode" "$target" "$digest_value" >> "$out" || exit 96
done
' sh "$rumiai_test_package_release_inventory_root" "$rumiai_test_package_release_inventory_unsorted" "$rumiai_test_package_release_inventory_stat_style" "$rumiai_test_package_release_fixture/m" "$rumiai_test_package_release_fixture/bin/sys/digest" {} + || return 1

  LC_ALL=C command -p -- sort "$rumiai_test_package_release_inventory_unsorted" > "$rumiai_test_package_release_inventory_output" || return 1
  command -p -- rm -f -- "$rumiai_test_package_release_inventory_unsorted" || return 1
}

rumiai_test_package_release_delta_empty()
{
  [ "$#" -eq 2 ] || return 2
  rumiai_test_package_release_delta_file=$1
  rumiai_test_package_release_delta_label=$2
  LC_ALL=C command -p -- awk -v wanted="$rumiai_test_package_release_delta_label" '
length($0) >= length(wanted) && substr($0, length($0) - length(wanted) + 1) == wanted {
  found=1
  if ((getline added) <= 0 || added != "  added:") { malformed=1; exit }
  if ((getline added_value) <= 0) { malformed=1; exit }
  if (added_value != "    (none)") { nonempty=1; exit }
  if ((getline removed) <= 0 || removed != "  removed:") { malformed=1; exit }
  if ((getline removed_value) <= 0) { malformed=1; exit }
  if (removed_value != "    (none)") { nonempty=1; exit }
  empty=1
  exit
}
END {
  if (!found || malformed) exit 2
  if (nonempty) exit 1
  if (empty) exit 0
  exit 2
}
' "$rumiai_test_package_release_delta_file"
}

rumiai_test_package_release_candidate_id()
{
  [ "$#" -eq 2 ] || return 2
  rumiai_test_package_release_candidate_file=$1
  rumiai_test_package_release_candidate_relative=$2
  LC_ALL=C command -p -- awk -F '\t' -v wanted="$rumiai_test_package_release_candidate_relative" '
NF == 3 && $1 ~ /^[0-9]+$/ && $3 == wanted { print $1; count++ }
END { if (count != 1) exit 1 }
' "$rumiai_test_package_release_candidate_file"
}

rumiai_test_package_release_setuid_path()
{
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    linux-arm64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_LINUX_ARM64-}";;
    linux-x86_64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_LINUX_X86_64-}";;
    macos-arm64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_MACOS_ARM64-}";;
    macos-x86_64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_MACOS_X86_64-}";;
    windows-arm64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_WINDOWS_ARM64-}";;
    windows-x86_64) printf -- '%s' "${RUMIAI_TEST_PACKAGE_RELEASE_SETUID_WINDOWS_X86_64-}";;
    *) return 1;;
  esac
}

rumiai_test_package_release_check_setuid()
{
  [ "$#" -eq 3 ] || return 2
  rumiai_test_package_release_setuid_root=$1
  rumiai_test_package_release_setuid_relative=$2
  rumiai_test_package_release_setuid_stat_style=$3
  [ -n "$rumiai_test_package_release_setuid_relative" ] || return 0
  rumiai_test_package_release_setuid_target="$rumiai_test_package_release_setuid_root/$rumiai_test_package_release_setuid_relative"
  [ -f "$rumiai_test_package_release_setuid_target" ] && [ ! -L "$rumiai_test_package_release_setuid_target" ] || return 1
  [ -u "$rumiai_test_package_release_setuid_target" ] || return 1
  if [ "$rumiai_test_package_release_setuid_stat_style" = gnu ]
  then
    rumiai_test_package_release_setuid_uid=$(stat -c '%u' "$rumiai_test_package_release_setuid_target" 2>/dev/null) || return 1
  else
    rumiai_test_package_release_setuid_uid=$(stat -f '%u' "$rumiai_test_package_release_setuid_target" 2>/dev/null) || return 1
  fi
  [ "$rumiai_test_package_release_setuid_uid" = 0 ]
}

rumiai_test_package_release_gui_require()
{
  [ "$#" -eq 1 ] || return 3
  [ -r /dev/tty ] && [ -w /dev/tty ] || return 2
  case "$1" in
    linux-*)
      [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ] || return 2
      ;;
    macos-*)
      command -v launchctl >/dev/null 2>&1 || return 2
      command -v id >/dev/null 2>&1 || return 2
      rumiai_test_package_release_gui_uid=$(id -u) || return 3
      launchctl print "gui/$rumiai_test_package_release_gui_uid" >/dev/null 2>&1 || return 2
      ;;
    windows-*)
      :
      ;;
    *)
      return 2
      ;;
  esac
}

rumiai_test_package_release_cleanup()
{
  if [ -n "${rumiai_test_package_release_gui_pid-}" ] && kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null
  then
    kill -s TERM "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
    rumiai_test_package_release_cleanup_wait=0
    while kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null && [ "$rumiai_test_package_release_cleanup_wait" -lt 10 ]
    do
      command -p -- sleep 1
      rumiai_test_package_release_cleanup_wait=$((rumiai_test_package_release_cleanup_wait + 1))
    done
    if kill -s 0 "$rumiai_test_package_release_gui_pid" 2>/dev/null
    then
      kill -s KILL "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
    fi
    wait "$rumiai_test_package_release_gui_pid" 2>/dev/null || :
  fi
  rumiai_test_package_release_gui_pid=
  if [ -n "${rumiai_test_package_release_tmp-}" ]
  then
    command -p -- rm -rf -- "$rumiai_test_package_release_tmp" 2>/dev/null || :
  fi
}

rumiai_test_package_release_gui_launch()
{
  [ "$#" -eq 3 ] || return 2
  rumiai_test_package_release_gui_command=$1
  rumiai_test_package_release_gui_log=$2
  rumiai_test_package_release_gui_name=$3
  [ -r /dev/tty ] && [ -w /dev/tty ] || return 2

  printf -- '%s\n' "$TEST_ID: launching $rumiai_test_package_release_gui_name through its RumiAI command." >/dev/tty
  printf -- '%s\n' "$TEST_ID: verify that the application opens correctly and then close it." >/dev/tty
  "$rumiai_test_package_release_gui_command" > "$rumiai_test_package_release_gui_log" 2>&1 &
  rumiai_test_package_release_gui_pid=$!
  printf -- '%s' "$TEST_ID: did the application open correctly and close cleanly? [y/N] " >/dev/tty
  IFS= read -r rumiai_test_package_release_gui_reply </dev/tty || return 1
  case "$rumiai_test_package_release_gui_reply" in
    y|Y|yes|YES|Yes) :;;
    *) return 1;;
  esac
  wait "$rumiai_test_package_release_gui_pid"
  rumiai_test_package_release_gui_status=$?
  rumiai_test_package_release_gui_pid=
  return "$rumiai_test_package_release_gui_status"
}

rumiai_test_package_release_inventory_equal()
{
  [ "$#" -eq 3 ] || return 2
  rumiai_test_package_release_inventory_before=$1
  rumiai_test_package_release_inventory_after=$2
  rumiai_test_package_release_inventory_label=$3
  if command -p -- cmp -s "$rumiai_test_package_release_inventory_before" "$rumiai_test_package_release_inventory_after"
  then
    return 0
  fi
  printf -- '%s: package root changed %s:\n' "$TEST_ID" "$rumiai_test_package_release_inventory_label" >&2
  command -p -- diff "$rumiai_test_package_release_inventory_before" "$rumiai_test_package_release_inventory_after" >&2 2>/dev/null || :
  return 1
}

rumiai_test_package_release_run()
{
  [ "$#" -eq 1 ] || rumiai_test_package_release_error "invalid shared helper invocation"
  rumiai_test_package_release_suite_root=$1

  for rumiai_test_package_release_required in \
    RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE \
    RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS \
    RUMIAI_TEST_PACKAGE_RELEASE_ANALYZE_COMMAND \
    RUMIAI_TEST_PACKAGE_RELEASE_TARGETS \
    RUMIAI_TEST_PACKAGE_RELEASE_MODE \
    RUMIAI_TEST_PACKAGE_RELEASE_CATALOG_TREE
  do
    eval "rumiai_test_package_release_value=\${$rumiai_test_package_release_required-}"
    [ -n "$rumiai_test_package_release_value" ] || rumiai_test_package_release_error "missing configuration: $rumiai_test_package_release_required"
  done

  . "$rumiai_test_package_release_suite_root/lib/rumiai-os-target.lib" || rumiai_test_package_release_error "cannot load target helper"
  . "$rumiai_test_package_release_suite_root/lib/rumiai-os-fixture.lib" || rumiai_test_package_release_error "cannot load fixture helper"

  command -v git >/dev/null 2>&1 || rumiai_test_package_release_skip "git is unavailable"
  command -v cmp >/dev/null 2>&1 || rumiai_test_package_release_error "cmp is unavailable"
  command -v awk >/dev/null 2>&1 || rumiai_test_package_release_error "awk is unavailable"
  command -v sort >/dev/null 2>&1 || rumiai_test_package_release_error "sort is unavailable"

  rumiai_test_package_release_source_root=$(rumiai_test_target_rumiai_os_find "$rumiai_test_package_release_suite_root")
  rumiai_test_package_release_status=$?
  case "$rumiai_test_package_release_status" in
    0) :;;
    1) rumiai_test_package_release_skip "rumiai-os target checkout not found";;
    2) rumiai_test_package_release_fail "invalid explicit rumiai-os target";;
    *) rumiai_test_package_release_error "target discovery failed";;
  esac

  rumiai_test_package_release_tmp="${TMPDIR:-/tmp}/rumiai-package-release-${RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE}-$$"
  umask 077
  command -p -- mkdir -- "$rumiai_test_package_release_tmp" || rumiai_test_package_release_error "cannot create temporary directory"
  rumiai_test_package_release_gui_pid=
  trap 'rumiai_test_package_release_cleanup' 0
  trap 'rumiai_test_package_release_cleanup; exit 3' HUP INT TERM

  rumiai_test_package_release_fixture="$rumiai_test_package_release_tmp/root"
  rumiai_test_fixture_rumiai_os_create "$rumiai_test_package_release_source_root" "$rumiai_test_package_release_fixture" || rumiai_test_package_release_error "cannot materialize isolated fixture"
  rumiai_test_package_release_fixture=$(CDPATH= cd -- "$rumiai_test_package_release_fixture" 2>/dev/null && pwd -P) || rumiai_test_package_release_error "cannot canonicalize fixture root"
  PATH="$rumiai_test_package_release_fixture/bin/sys:$PATH"
  export PATH

  rumiai_test_package_release_runtime_probe="$rumiai_test_package_release_tmp/osarch"
  cat > "$rumiai_test_package_release_runtime_probe" <<'EOF_OSARCH'
#!/usr/bin/env m
. "$m_LIB_DIR/sys/sh/osarch.lib.sh"
printf -- '%s\n' "$m_OSARCH"
EOF_OSARCH
  command -p -- chmod 700 "$rumiai_test_package_release_runtime_probe" || rumiai_test_package_release_error "cannot make osarch probe executable"
  rumiai_test_package_release_osarch=$($rumiai_test_package_release_runtime_probe) || rumiai_test_package_release_fail "cannot resolve RumiAI osarch"
  rumiai_test_package_release_supported "$rumiai_test_package_release_osarch" "$RUMIAI_TEST_PACKAGE_RELEASE_TARGETS" || rumiai_test_package_release_skip "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE is not declared for $rumiai_test_package_release_osarch"
  if [ "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" = gui ]
  then
    rumiai_test_package_release_gui_require "$rumiai_test_package_release_osarch"
    rumiai_test_package_release_status=$?
    case "$rumiai_test_package_release_status" in
      0) :;;
      2) rumiai_test_package_release_skip "graphical interactive session is unavailable for $rumiai_test_package_release_osarch";;
      *) rumiai_test_package_release_error "cannot determine graphical session availability";;
    esac
  fi

  printf -- '%s\n' "$TEST_ID: live install of $RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE for $rumiai_test_package_release_osarch" >&2
  "$rumiai_test_package_release_fixture/bin/sys/pkg" install "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" || rumiai_test_package_release_fail "pkg install $RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE failed"

  rumiai_test_package_release_concrete=
  rumiai_test_package_release_concrete_count=0
  for rumiai_test_package_release_candidate in "$rumiai_test_package_release_fixture/pkg/$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE@"*"!$rumiai_test_package_release_osarch"
  do
    [ -e "$rumiai_test_package_release_candidate" ] || [ -L "$rumiai_test_package_release_candidate" ] || continue
    rumiai_test_package_release_concrete_count=$((rumiai_test_package_release_concrete_count + 1))
    rumiai_test_package_release_concrete=$rumiai_test_package_release_candidate
  done
  [ "$rumiai_test_package_release_concrete_count" -eq 1 ] || rumiai_test_package_release_fail "expected one concrete package, found $rumiai_test_package_release_concrete_count"
  [ -d "$rumiai_test_package_release_concrete" ] && [ ! -L "$rumiai_test_package_release_concrete" ] || rumiai_test_package_release_fail "concrete package is not a real directory"
  rumiai_test_package_release_identity=${rumiai_test_package_release_concrete##*/}
  rumiai_test_package_release_root="$rumiai_test_package_release_concrete/root"
  [ -d "$rumiai_test_package_release_root" ] && [ ! -L "$rumiai_test_package_release_root" ] || rumiai_test_package_release_fail "concrete package root is invalid"

  for rumiai_test_package_release_command in $RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS
  do
    [ -f "$rumiai_test_package_release_concrete/cmd/$rumiai_test_package_release_command" ] && \
    [ ! -L "$rumiai_test_package_release_concrete/cmd/$rumiai_test_package_release_command" ] && \
    [ -x "$rumiai_test_package_release_concrete/cmd/$rumiai_test_package_release_command" ] || \
      rumiai_test_package_release_fail "missing concrete command $rumiai_test_package_release_command"
    [ -L "$rumiai_test_package_release_concrete/link/$rumiai_test_package_release_command" ] || \
      rumiai_test_package_release_fail "missing direct link $rumiai_test_package_release_command"
  done

  rumiai_test_package_release_cache=$("$rumiai_test_package_release_fixture/m" "$rumiai_test_package_release_fixture/bin/sys/state-path" system sys pkg cache) || rumiai_test_package_release_fail "cannot resolve pkg cache state"
  rumiai_test_package_release_catalog="$rumiai_test_package_release_cache/pkg-catalog"
  [ -d "$rumiai_test_package_release_catalog/.git" ] || rumiai_test_package_release_fail "live catalog cache missing"
  rumiai_test_package_release_catalog_head=$(git -C "$rumiai_test_package_release_catalog" rev-parse --verify HEAD 2>/dev/null) || rumiai_test_package_release_fail "cannot read catalog HEAD"
  rumiai_test_package_release_catalog_tree=$(git -C "$rumiai_test_package_release_catalog" rev-parse --verify "HEAD:$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" 2>/dev/null) || rumiai_test_package_release_fail "cannot read package catalog tree"
  [ "$rumiai_test_package_release_catalog_tree" = "$RUMIAI_TEST_PACKAGE_RELEASE_CATALOG_TREE" ] || rumiai_test_package_release_fail "catalog tree drift: got $rumiai_test_package_release_catalog_tree expected $RUMIAI_TEST_PACKAGE_RELEASE_CATALOG_TREE"

  rumiai_test_package_release_stat_style=$(rumiai_test_package_release_stat_style "$rumiai_test_package_release_root") || rumiai_test_package_release_error "supported stat implementation unavailable"
  rumiai_test_package_release_setuid=$(rumiai_test_package_release_setuid_path "$rumiai_test_package_release_osarch") || rumiai_test_package_release_error "cannot resolve setuid expectation"
  rumiai_test_package_release_check_setuid "$rumiai_test_package_release_root" "$rumiai_test_package_release_setuid" "$rumiai_test_package_release_stat_style" || rumiai_test_package_release_fail "setuid-root contract failed for $rumiai_test_package_release_setuid"

  rumiai_test_package_release_link=$(command -p -- readlink "$rumiai_test_package_release_concrete/link/$RUMIAI_TEST_PACKAGE_RELEASE_ANALYZE_COMMAND") || rumiai_test_package_release_fail "cannot read analyze-command direct link"
  case "$rumiai_test_package_release_link" in
    ../root/*) rumiai_test_package_release_analyze_relative=${rumiai_test_package_release_link#../root/};;
    *) rumiai_test_package_release_fail "analyze-command direct link is not rooted in concrete root: $rumiai_test_package_release_link";;
  esac

  rumiai_test_package_release_before="$rumiai_test_package_release_tmp/root.before"
  rumiai_test_package_release_after="$rumiai_test_package_release_tmp/root.after"
  rumiai_test_package_release_inventory "$rumiai_test_package_release_root" "$rumiai_test_package_release_before" "$rumiai_test_package_release_stat_style" || rumiai_test_package_release_error "cannot inventory package root before runtime"

  rumiai_test_package_release_analysis_home="$rumiai_test_package_release_tmp/analyzer-home"
  command -p -- mkdir -- "$rumiai_test_package_release_analysis_home" || rumiai_test_package_release_error "cannot create analyzer HOME"
  rumiai_test_package_release_discovery="$rumiai_test_package_release_tmp/pkg-analyze.discovery"
  printf -- '\n' | HOME="$rumiai_test_package_release_analysis_home" "$rumiai_test_package_release_fixture/bin/sys/pkg-analyze" "$rumiai_test_package_release_root" > "$rumiai_test_package_release_discovery" 2>&1 || rumiai_test_package_release_fail "pkg-analyze candidate discovery failed"
  rumiai_test_package_release_candidate_id=$(rumiai_test_package_release_candidate_id "$rumiai_test_package_release_discovery" "$rumiai_test_package_release_analyze_relative") || {
    command -p -- cat "$rumiai_test_package_release_discovery" >&2
    rumiai_test_package_release_fail "expected pkg-analyze candidate not found: $rumiai_test_package_release_analyze_relative"
  }

  rumiai_test_package_release_analysis="$rumiai_test_package_release_tmp/pkg-analyze.report"
  case "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" in
    cli)
      printf -- '%s\ny\n\n' "$rumiai_test_package_release_candidate_id" | \
        HOME="$rumiai_test_package_release_analysis_home" "$rumiai_test_package_release_fixture/bin/sys/pkg-analyze" "$rumiai_test_package_release_root" > "$rumiai_test_package_release_analysis" 2>&1
      rumiai_test_package_release_analysis_status=$?
      ;;
    gui)
      command -p -- cp "$rumiai_test_package_release_discovery" "$rumiai_test_package_release_analysis" || rumiai_test_package_release_error "cannot preserve pkg-analyze GUI discovery report"
      rumiai_test_package_release_analysis_status=0
      ;;
    *) rumiai_test_package_release_error "invalid release mode: $RUMIAI_TEST_PACKAGE_RELEASE_MODE";;
  esac

  printf -- 'pkg-analyze-report-begin\n'
  command -p -- cat "$rumiai_test_package_release_analysis"
  printf -- 'pkg-analyze-report-end\n'

  [ "$rumiai_test_package_release_analysis_status" -eq 0 ] || rumiai_test_package_release_fail "pkg-analyze dynamic probe failed with status $rumiai_test_package_release_analysis_status"

  if [ "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" = cli ]
  then
    command -p -- grep -F -- "Probe $rumiai_test_package_release_candidate_id: $rumiai_test_package_release_analyze_relative" "$rumiai_test_package_release_analysis" >/dev/null 2>&1 || rumiai_test_package_release_fail "expected pkg-analyze candidate was not probed: $rumiai_test_package_release_analyze_relative"
    command -p -- grep -F -- '  exit-status: 0' "$rumiai_test_package_release_analysis" >/dev/null 2>&1 || rumiai_test_package_release_fail "pkg-analyze candidate did not exit successfully"

    rumiai_test_package_release_delta_empty "$rumiai_test_package_release_analysis" '  package-root path delta:'
    rumiai_test_package_release_status=$?
    case "$rumiai_test_package_release_status" in
      0) :;;
      1) rumiai_test_package_release_fail "pkg-analyze reported package-root pathname/type changes";;
      *) rumiai_test_package_release_fail "pkg-analyze package-root delta evidence missing or malformed";;
    esac

    rumiai_test_package_release_delta_empty "$rumiai_test_package_release_analysis" '  original-HOME path delta:'
    rumiai_test_package_release_status=$?
    case "$rumiai_test_package_release_status" in
      0) :;;
      1) rumiai_test_package_release_fail "pkg-analyze reported writes to original HOME";;
      *) rumiai_test_package_release_fail "pkg-analyze original-HOME delta evidence missing or malformed";;
    esac

    command -p -- grep -F -- '  redirected-environment path delta:' "$rumiai_test_package_release_analysis" >/dev/null 2>&1 || rumiai_test_package_release_fail "pkg-analyze redirected-environment evidence missing"
  else
    printf -- '%s\n' "$TEST_ID: GUI mode uses pkg-analyze for candidate discovery only; runtime GUI validation is performed once through the integrated RumiAI command." >&2
  fi

  rumiai_test_package_release_after_analyze="$rumiai_test_package_release_tmp/root.after-analyze"
  rumiai_test_package_release_inventory "$rumiai_test_package_release_root" "$rumiai_test_package_release_after_analyze" "$rumiai_test_package_release_stat_style" || rumiai_test_package_release_error "cannot inventory package root after pkg-analyze"
  rumiai_test_package_release_inventory_equal "$rumiai_test_package_release_before" "$rumiai_test_package_release_after_analyze" 'during pkg-analyze' || rumiai_test_package_release_fail "package root is not immutable during pkg-analyze"

  rumiai_test_package_release_launch_home="$rumiai_test_package_release_tmp/launcher-home"
  command -p -- mkdir -- "$rumiai_test_package_release_launch_home" || rumiai_test_package_release_error "cannot create launcher HOME"
  case "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" in
    cli)
      for rumiai_test_package_release_command in $RUMIAI_TEST_PACKAGE_RELEASE_COMMANDS
      do
        rumiai_test_package_release_command_log="$rumiai_test_package_release_tmp/command-$rumiai_test_package_release_command.log"
        HOME="$rumiai_test_package_release_launch_home" "$rumiai_test_package_release_concrete/cmd/$rumiai_test_package_release_command" --version > "$rumiai_test_package_release_command_log" 2>&1 || {
          command -p -- cat "$rumiai_test_package_release_command_log" >&2
          rumiai_test_package_release_fail "$rumiai_test_package_release_command --version failed"
        }
        [ -s "$rumiai_test_package_release_command_log" ] || rumiai_test_package_release_fail "$rumiai_test_package_release_command --version produced no evidence"
      done
      ;;
    gui)
      rumiai_test_package_release_gui_log="$rumiai_test_package_release_tmp/gui-launch.log"
      HOME="$rumiai_test_package_release_launch_home" rumiai_test_package_release_gui_launch "$rumiai_test_package_release_concrete/cmd/$RUMIAI_TEST_PACKAGE_RELEASE_ANALYZE_COMMAND" "$rumiai_test_package_release_gui_log" "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"
      rumiai_test_package_release_status=$?
      case "$rumiai_test_package_release_status" in
        0) :;;
        2) rumiai_test_package_release_skip "GUI release validation requires an interactive TTY";;
        *)
          command -p -- cat "$rumiai_test_package_release_gui_log" >&2 2>/dev/null || :
          rumiai_test_package_release_fail "RumiAI GUI launch failed"
          ;;
      esac
      ;;
  esac

  rumiai_test_package_release_package_home=$(HOME="$rumiai_test_package_release_launch_home" "$rumiai_test_package_release_fixture/m" "$rumiai_test_package_release_fixture/bin/sys/state-path" user pkg "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE" home) || rumiai_test_package_release_fail "cannot resolve package HOME state"
  [ -d "$rumiai_test_package_release_package_home" ] && [ ! -L "$rumiai_test_package_release_package_home" ] || rumiai_test_package_release_fail "RumiAI package HOME state was not materialized"

  rumiai_test_package_release_inventory "$rumiai_test_package_release_root" "$rumiai_test_package_release_after" "$rumiai_test_package_release_stat_style" || rumiai_test_package_release_error "cannot inventory package root after runtime"
  rumiai_test_package_release_inventory_equal "$rumiai_test_package_release_before" "$rumiai_test_package_release_after" 'across integrated runtime launch' || rumiai_test_package_release_fail "package root is not runtime-immutable"

  printf -- 'package=%s\n' "$RUMIAI_TEST_PACKAGE_RELEASE_PACKAGE"
  printf -- 'installed=%s\n' "$rumiai_test_package_release_identity"
  printf -- 'osarch=%s\n' "$rumiai_test_package_release_osarch"
  printf -- 'catalog-head=%s\n' "$rumiai_test_package_release_catalog_head"
  printf -- 'package-tree=%s\n' "$rumiai_test_package_release_catalog_tree"
  printf -- 'analyzed-candidate=%s\n' "$rumiai_test_package_release_analyze_relative"
  if [ "$RUMIAI_TEST_PACKAGE_RELEASE_MODE" = gui ]
  then
    printf -- 'analysis=discovery-only\n'
  else
    printf -- 'analysis=dynamic-probe\n'
  fi
  printf -- 'package-root=runtime-immutable\n'
  return 0
}
