# RumiAI test authoring reference: create an isolated runnable rumiai-os root.
#
# This file is a reference implementation for test authors. Permanent tests that need
# historical independence should copy the required functions inline and record the
# immutable Git commit and pathname of the copied version.
#
# The fixture copies product runtime material but intentionally creates a fresh empty
# conf/bootstrap directory so tests may control bootstrap preferences without modifying
# the checkout under test.

rumiai_test_fixture_rumiai_os_create() {
    [ "$#" -eq 2 ] || return 3

    source_root=$1
    fixture_root=$2

    [ -n "$source_root" ] || return 3
    [ -n "$fixture_root" ] || return 3
    [ -f "$source_root/rumiai-os" ] || return 1
    [ -d "$source_root/bin" ] || return 1
    [ -d "$source_root/lib" ] || return 1
    [ -d "$source_root/lang" ] || return 1

    [ ! -e "$fixture_root" ] || return 2

    if ! mkdir -p "$fixture_root/conf/bootstrap"
    then
        return 2
    fi

    if ! cp "$source_root/rumiai-os" "$fixture_root/rumiai-os"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    if ! cp -R "$source_root/bin" "$fixture_root/bin"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    if ! cp -R "$source_root/lib" "$fixture_root/lib"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    if ! cp -R "$source_root/lang" "$fixture_root/lang"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    if ! chmod u+x "$fixture_root/rumiai-os"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    return 0
}
