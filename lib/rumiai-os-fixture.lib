# RumiAI test authoring reference: create an isolated runnable rumiai-os root.
#
# This library is a deliberate same-suite-revision dependency for permanent tests.
# Tests should source it when this fixture contract matches their needs instead of
# copying the implementation inline solely for historical independence.
#
# The fixture copies the current runtime/product material and its tracked initial
# system profile. Runtime package/user state is intentionally created fresh inside the
# fixture and never copied from the checkout under test.

rumiai_test_fixture_rumiai_os_create() {
    [ "$#" -eq 2 ] || return 3

    source_root=$1
    fixture_root=$2

    [ -n "$source_root" ] || return 3
    [ -n "$fixture_root" ] || return 3
    [ -f "$source_root/m" ] || return 1
    [ -f "$source_root/rumiai-os" ] || return 1
    [ -f "$source_root/rumiai-os-sh" ] || return 1
    [ -d "$source_root/bin" ] || return 1
    [ -d "$source_root/lib" ] || return 1
    [ -d "$source_root/res" ] || return 1
    [ -d "$source_root/state" ] || return 1
    [ -f "$source_root/product-name" ] || return 1
    [ -f "$source_root/product-version" ] || return 1

    [ ! -e "$fixture_root" ] || return 2

    if ! mkdir -p "$fixture_root/pkg" "$fixture_root/src"
    then
        return 2
    fi

    for fixture_file in m rumiai-os rumiai-os-sh product-name product-version
    do
        if ! cp "$source_root/$fixture_file" "$fixture_root/$fixture_file"
        then
            rm -rf "$fixture_root"
            return 2
        fi
    done

    for fixture_dir in bin lib res state
    do
        if ! cp -R "$source_root/$fixture_dir" "$fixture_root/$fixture_dir"
        then
            rm -rf "$fixture_root"
            return 2
        fi
    done

    if ! chmod u+x "$fixture_root/m" "$fixture_root/rumiai-os" "$fixture_root/rumiai-os-sh"
    then
        rm -rf "$fixture_root"
        return 2
    fi

    return 0
}
